        else if (b.dataset.igRecord) { if (!records().includes(b.dataset.igRecord)) return;saved.record = b.dataset.igRecord; draw('record'); remember(); }
        else if (b.hasAttribute('data-ig-read') && records().includes(saved.record)) E.ui.itemView?.(saved.record);
        else if (b.hasAttribute('data-ig-ask') && records().includes(saved.record)) choose(claim.question);
