  E.on("chapter", () => { const S = E.S(); S.__seen ||= [{ think: { en: "You've already looked at that.", vi: "Chỗ này bạn xem rồi." } }]; S.__take ||= [{ reveal: 1 }]; });


  // ═════════ HỎI CHUYỆN ═════════
  def("talk", c => new Promise(res => {
    c.resumeHere?.();
    let done = false,reading; c.onExit?.(() => { done = true;reading?.dispose(); });
    const S = E.S(), R = E.R();
    const ref = typeof c.st.talk === "string" ? c.st.talk : null;
    const K = ref ? S.talks?.[ref] : c.st.talk;
    if (!K) { console.warn("[story] talk không có", c.st.talk); return res(); }
    const who = K.with, ch = S.chars[who] || {}, tid = ref || K.id || who;
    const run = keys => (ref ? R.stack.push({ n: "@talks", p: [ref, ...keys], i: 0 }) : c.push("talk", ...keys));
    const askedK = (t, i) => `tk:${tid}:${t.id || i}`;
    // xuất hiện: đứng giữa, đúng biểu cảm
    if (!R.cast[who]) E.ui.show(who, "c", K.face || "");
    R.used["tkh:" + who] = 1;
    // lần đầu: chào hỏi
    if (K.hello && !R.used[`tk:${tid}:hello`]) { R.used[`tk:${tid}:hello`] = 1; c.again(); run(["hello"]); return res(); }
    const s = E.state();
    const list = (K.topics || []).map((t, i) => ({ t, i })).filter(({ t }) => !t.if || cond(t.if, s));
    const usable = ({ t, i }) => !(t.once !== false && R.used[askedK(t, i)]) && (!t.need || cond(t.need, s));
    const shown = list.filter(x => usable(x) || R.used[askedK(x.t, x.i)]);
    const showKeys = Object.keys(K.show || {});
    const contextual = K.contextInventory ?? S.contextInventory;
    // A conversation may curate a complete comparison pool, with plausible
    // wrong records. Without one, keep the surrounding full-location context.
    // Do not derive this list from show keys: that would expose the right item.
    const location = K.location ? E.enterLocation(K.location) : E.currentLocation();
    const ownedRecords = () => { const allowed = new Set(Array.isArray(K.recordIds) ? K.recordIds : contextual ? E.contextItems(location) : R.items.filter(E.itemLive)); return R.items.filter(id => S.items[id] && allowed.has(id)).slice().reverse(); };
    const canShow = showKeys.length && ownedRecords().length;
    const guidedRecords = S.recordPresentation === "compact";
    const recordState = guidedRecords ? ((R.talkUI ||= {})[tid] ||= {query:"",category:"all"}) : null;
    let picking = false, preview = null, query = recordState?.query || "", category = recordState?.category || "all", recordLimit = 6;
    const fold = value => String(value || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d");
    const both = value => typeof value === "string" ? value : Object.values(value || {}).filter(v => typeof v === "string").join(" ");
    const recordGroup = id => E.evidenceMeta?.(id)?.group || ((S.items[id].recordType || S.items[id].kind) === "testimony" ? "testimony" : "objects");
    const filterRecords = () => {
      let count = 0; const words = fold(query).trim().split(/\s+/).filter(Boolean);
      $$(".tk-pick [data-show]").forEach(el => { const id=el.dataset.show,it=S.items[id],search=fold(E.recordSearchText?.(id)||both(it?.name)+" "+both(it?.desc)); const match=(category==="all"||recordGroup(id)===category)&&words.every(w=>search.includes(w)); if(match)count++; el.hidden=!match||count>recordLimit; });
      const status=$(".tk-pick [data-talk-count]"), shown=Math.min(count,recordLimit);if(status)status.textContent=count?T(`${shown}/${count} records${guidedRecords ? " · review before showing" : ""}.`,`${shown}/${count} hồ sơ${guidedRecords ? " · xem trước khi đưa" : ""}.`):T("No matching records. Clear the search or choose All.","Không tìm thấy hồ sơ. Xóa từ tìm hoặc chọn Tất cả.");
      const more=$(".tk-pick [data-talk-more]"),less=$(".tk-pick [data-talk-less]");if(more)more.hidden=shown>=count;if(less)less.hidden=recordLimit<=6||count<=6;
      if(recordState){recordState.query=query;recordState.category=category;}
    };
    const recordPages = () => `<div class="se-record-pages"><button class="se-btn sm" data-talk-more hidden>${esc(T("Show more", "Xem thêm"))}</button><button class="se-btn sm" data-talk-less hidden>${esc(T("Show less", "Thu gọn"))}</button></div>`;
    const picker = () => {
      if (!guidedRecords) return `<small>${esc(T("Show them…", "Đưa cho xem…"))}</small><small data-talk-count role="status" aria-live="polite"></small><div class="se-bag">${ownedRecords().map(id => `<button class="se-bi" data-show="${id}">${E.itemArt(id,"sm")}<small>${investigationText(S.items[id].name)}</small></button>`).join("")}</div>${recordPages()}<button class="se-btn wide" data-unpick>${esc(T("Never mind", "Thôi"))}</button>`;
      if (preview && ownedRecords().includes(preview)) { const it=S.items[preview]; return `<div class="v93-record-preview"><div class="v93-record-preview-head">${E.itemArt(preview,"md")}<b>${investigationText(it.name)}</b></div><div class="v93-record-preview-text">${investigationText(it.desc)}</div><button class="se-btn" data-talk-details="${esc(preview)}">${esc(T("Open complete record", "Mở hồ sơ đầy đủ"))}</button><div class="se-row"><button class="se-btn" data-talk-back>${esc(T("Back to records", "Về danh sách"))}</button><button class="se-btn pri" data-confirm-show="${esc(preview)}">${esc(T("Show to ", "Đưa cho ")+E.cname(ch,true)+T("", " xem"))}</button></div></div>`; }
      return `<p class="v93-record-purpose">${esc(T("Choose a record to show ","Chọn hồ sơ để đưa ")+E.cname(ch,true)+T("."," xem."))}</p><label class="v93-record-search"><span>${esc(T("Find a record", "Tìm hồ sơ"))}</span><input class="se-in" type="search" data-talk-search value="${esc(query)}" placeholder="${esc(T("Name or description", "Tên hoặc nội dung"))}" autocomplete="off"></label><div class="v93-record-filters">${[["all",T("All","Tất cả")],["objects",T("Objects & traces","Đồ vật / dấu vết")],["testimony",T("Statements","Lời khai")]].map(([id,label])=>`<button class="se-btn sm${category===id?" on":""}" data-talk-filter="${id}" aria-pressed="${category===id}">${esc(label)}</button>`).join("")}</div><small data-talk-count role="status" aria-live="polite"></small><div class="v93-record-list">${ownedRecords().map(id=>{const it=S.items[id];return `<button class="v93-record-card" data-show="${esc(id)}">${E.itemArt(id,"sm")}<span><b>${investigationText(it.name)}</b><small>${investigationText(it.brief||it.desc)}</small></span></button>`;}).join("")}</div>${recordPages()}<button class="se-btn wide" data-unpick>${esc(T("Back to questions", "Trở lại hỏi chuyện"))}</button>`;
    };
    // không còn gì để hỏi / đưa → không mở bảng hỏi, người đó lui ra (cảnh chỉ có lời chào)
    if (!shown.length && !canShow) { if (K.bye && R.used[`tk:${tid}:hello`] && !R.used[`tk:${tid}:bye`]) { R.used[`tk:${tid}:bye`] = 1; run(["bye"]); } E.ui.hide(who); return res(); }
    const draw = () => {
      const lastLine = R.last && R.last.who === who ? R.last : null;
      E.ui.panel(`<div class="tk-h" style="--c:${ch.color || "#aaa"}"><div class="tk-title"><b>${esc(E.cname(ch, true))}</b>${K.prompt ? `<span>${investigationText(K.prompt)}</span>` : ""}</div>${E.ui.readingToggle?.()||''}</div>
        ${picking ? `<div class="tk-pick">${picker()}</div>`
        : `<div class="tk-l">${shown.map(({ t, i }) => { const a = R.used[askedK(t, i)], u = usable({ t, i }); return `<button class="tk-t${a ? " asked" : ""}${!a && !R.used["tks:" + askedK(t, i)] ? " fresh" : ""}" data-t="${i}" ${u ? "" : "disabled"}><span>${investigationText(t.label)}</span>${a ? `<em>✓</em>` : t.cost ? `<em class="tk-c">${t.cost}′</em>` : ""}</button>`; }).join("")}</div>
        <div class="se-row tk-f">${canShow ? `<button class="se-btn" data-pick>${E.ICON.box}<span>${esc(T("Show something", "Đưa đồ cho xem"))}</span></button>` : ""}<button class="se-btn pri" data-bye>${K.byeLabel ? investigationText(K.byeLabel) : esc(T("Leave", "Rời đi"))}</button></div>`}`, "tk");
      shown.forEach(({ t, i }) => (R.used["tks:" + askedK(t, i)] = 1));
      const readingNative=reading?.native;reading?.dispose();reading=E.ui.bindReading?.($('.se-panel.tk'),{native:readingNative});
      const input=$(".tk-pick [data-talk-search]");if(input)input.oninput=e=>{query=e.target.value;recordLimit=6;filterRecords();};if(picking&&!preview)filterRecords();
    };
    const finish = keys => { if (done || !c.live()) return; done = true; E.ui.clear(); if (keys) { if (keys !== "bye-only") run(keys); } res(); };
    E.ui.hideBox();
    draw();
    $(".se-ui").onclick = e => {
      if (done || !c.live()) return;
      const t = e.target;
      if (t.closest("[data-pick]")) { picking = true; preview = null; recordLimit = 6; E.sfx("tap"); return draw(); }
      if (t.closest("[data-unpick]")) { picking = false; preview = null; E.sfx("tap"); return draw(); }
      if (t.closest("[data-talk-back]")) { preview = null; return draw(); }
      if(t.closest("[data-talk-more]")){recordLimit+=6;filterRecords();return;}
      if(t.closest("[data-talk-less]")){recordLimit=6;filterRecords();return;}
      const filter=t.closest("[data-talk-filter]");if(filter){category=filter.dataset.talkFilter;recordLimit=6;return draw();}
      const info=t.closest("[data-talk-details]");if(info){E.hush();return E.ui.itemView(info.dataset.talkDetails);}
      const sh = t.closest("[data-show]");
      if (sh && guidedRecords) { if(sh.hidden||!ownedRecords().includes(sh.dataset.show))return;preview=sh.dataset.show;E.sfx("tap");draw();$(".v93-record-preview")?.scrollIntoView({block:"nearest",behavior:"instant"});return; }
      const confirm=t.closest("[data-confirm-show]");
      if (sh || confirm) { const id = confirm?.dataset.confirmShow || sh.dataset.show; if(!ownedRecords().includes(id))return; const k = K.show[id] ? id : K.show["*"] ? "*" : null; E.sfx("pick"); E._zoneRect = null; c.again(); if (k) run(["show", k]); return finish(); }
      const b = t.closest("[data-t]");
      if (b && !b.disabled) { const i = +b.dataset.t, tp = K.topics[i]; R.used[askedK(tp, i)] = 1; E.sfx("pick"); if (tp.cost) E.time.add(tp.cost); if (!tp.end) c.again(); else E.ui.hide(who); run(["topics", i, "then"]); return finish(); }
      if (t.closest("[data-bye]")) { E.sfx("tap"); if (K.bye) run(["bye"]); if (!K.stay) E.ui.hide(who); return finish(); }
    };
    E.autoRun(() => {
      if (done || !c.live()) return;
      const nx = list.find(usable);
      if (nx) { R.used[askedK(nx.t, nx.i)] = 1; if (!nx.t.end) c.again(); run(["topics", nx.i, "then"]); return finish(); }
      if (canShow && !R.used[`tk:${tid}:autoshow`]) { R.used[`tk:${tid}:autoshow`] = 1; const records = ownedRecords(); const id = records.find(x => K.show[x]) || (K.show["*"] ? records[0] : null); if (id) { c.again(); run(["show", K.show[id] ? id : "*"]); return finish(); } }
      if (K.bye) run(["bye"]); E.ui.hide(who); finish();
    });
  }));
})();
// Enmi Story Engine 3 — CẢNH HÀNH ĐỘNG (nạp sau place.js). Cử chỉ KHỚP với hình: đặt theo vùng của ảnh đang hiện.
//
// { act: { kind, r, prompt, ms, ok: [bước], fail: [bước], … } }
//   swipe  vuốt theo hướng dir: "l" | "r" | "u" | "d" bắt đầu trong vùng r (né, giật cửa, kéo người lên)
//   drag   kéo vật (art: ảnh PNG, hoặc tên vùng) từ r tới vùng to (giật chai khỏi tay, đặt cọc vào lỗ)
//   hold   giữ ngón tay trong r đủ hold ms (nín thở, giữ chặt mép thuyền) — nhấc sớm = làm lại
//   tap    chạm vào r trước khi hết giờ (chạm đúng lúc: kèm prop chạy qua vùng)
//   mash   chạm liên tục n lần (đạp cửa, bơi lên)
//   torch  màn tối, ngón tay là đèn pin — soi tới vùng find và giữ ~0,6 giây
//   ms: thời hạn (0 / không ghi = không giới hạn). Cài đặt “Hành động dễ” (G.set.easyAct) bỏ thời hạn + nới vùng.
//   Thất bại không phải màn thua: fail chạy bước rẽ nhánh (bị thương, mất đồ…), rồi truyện đi tiếp.
//
// { beat: [{ shot | bg, t: { en, vi }, ms, fx, sfx, look, prop, cam }, …] }   chuỗi khung hành động (truyện tranh động):
//   từng khung cắt nhanh, chữ to giữa màn, tự chạy theo ms (chạm = sang khung sau). Khung = ảnh riêng hoặc máy quay / đạo cụ trên cùng 1 ảnh.
//
// E.gesture(tên, { html(A, box), bind(el, A, api) }) — thêm kiểu cử chỉ mới.
(() => {
  const E = globalThis.StoryEngine, def = E.def, esc = E.esc, h = E.h;
  const nat = t => E.nat(t), T = (en, vi) => nat({ en, vi });
  const $ = (s, r = document) => r.querySelector(s);
  const GS = {};
  E.gesture = (k, impl) => { GS[k] = impl; };
  E.gestures = GS;
  const ARROW = { l: "←", r: "→", u: "↑", d: "↓" };
  const inside = (e, el, pad = 0) => { const b = el.getBoundingClientRect(); return e.clientX >= b.left - pad && e.clientX <= b.right + pad && e.clientY >= b.top - pad && e.clientY <= b.bottom + pad; };

  // Each gesture owns one pointer. Cancellation is a reset, never a successful drop.
  const capture = (el, id) => { try { el.setPointerCapture(id); } catch {} };
  E.gesture("swipe", {
    html: A => `<div class="ga-sw d-${A.dir || "r"}"><i>${ARROW[A.dir || "r"]}</i><b></b></div>`,
    bind(el, A, api) {
      let s = null;
      const L = $(".se-act"), cancel = () => { s = null; el.classList.remove("on"); };
      L.onpointerdown = e => { if (!api.live() || s || e.button > 0 || !inside(e, el, api.pad)) return; s = [e.clientX, e.clientY, e.pointerId]; capture(L, e.pointerId); el.classList.add("on"); };
      L.onpointerup = e => {
        if (!s || e.pointerId !== s[2]) return; const dx = e.clientX - s[0], dy = e.clientY - s[1]; cancel();
        const d = A.dir || "r", ok = d === "r" ? dx > 50 && Math.abs(dx) > Math.abs(dy) : d === "l" ? dx < -50 && Math.abs(dx) > Math.abs(dy) : d === "u" ? dy < -50 && Math.abs(dy) > Math.abs(dx) : dy > 50 && Math.abs(dy) > Math.abs(dx);
        ok ? api.ok() : api.miss();
      };
      L.onpointercancel = e => { if (s && e.pointerId === s[2]) cancel(); };
      return cancel;
    },
  });
  E.gesture("drag", {
    html: (A, box) => `<div class="ga-dg">${A.art ? `<i class="ii im-${esc(A.art)}"></i>` : '<i class="ga-dot"></i>'}</div>${A.to ? `<div class="ga-to" style="${E.pctStyle(box.to)}"></div>` : ""}`,
    bind(el, A, api) {
      const dg = el.querySelector(".ga-dg"), to = $(".se-act .ga-to");
      let s = null, reset = 0;
      const cancel = () => { s = null; clearTimeout(reset); dg.classList.remove("on"); to?.classList.remove("on"); dg.style.transform = ""; dg.style.transition = ""; };
      dg.onpointerdown = e => { if (!api.live() || s || e.button > 0) return; s = [e.clientX, e.clientY, e.pointerId]; capture(dg, e.pointerId); dg.classList.add("on"); to?.classList.add("on"); E.haptic("LIGHT"); };
      dg.onpointermove = e => { if (s && e.pointerId === s[2]) dg.style.transform = `translate(${e.clientX - s[0]}px,${e.clientY - s[1]}px)`; };
      dg.onpointerup = e => {
        if (!s || e.pointerId !== s[2]) return; s = null; dg.classList.remove("on"); to?.classList.remove("on");
        if (to && inside(e, to, api.pad)) { dg.style.transition = "opacity .25s"; dg.style.opacity = 0; return api.ok(); }
        dg.style.transition = "transform .3s cubic-bezier(.2,1.4,.4,1)"; dg.style.transform = ""; reset = setTimeout(() => (dg.style.transition = ""), 320); api.miss();
      };
      dg.onpointercancel = e => { if (s && e.pointerId === s[2]) cancel(); };
      return cancel;
    },
  });
  E.gesture("hold", {
    html: () => `<div class="ga-hd"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="17"/><circle class="p" cx="20" cy="20" r="17"/></svg></div>`,
    bind(el, A, api) {
      const need = A.hold || 1600; let t0 = 0, raf = 0, pointer = null;
      const p = el.querySelector(".p"), L = $(".se-act");
      const cancel = () => { pointer = null; t0 = 0; cancelAnimationFrame(raf); el.classList.remove("on"); p.style.strokeDashoffset = 107; };
      const tick = () => { if (!api.live() || pointer == null) return cancel(); const k = Math.min(1, (performance.now() - t0) / need); p.style.strokeDashoffset = 107 * (1 - k); if (k >= 1) { pointer = null; t0 = 0; return api.ok(); } raf = requestAnimationFrame(tick); };
      L.onpointerdown = e => { if (!api.live() || pointer != null || e.button > 0 || !inside(e, el, api.pad)) return; pointer = e.pointerId; capture(L, pointer); t0 = performance.now(); el.classList.add("on"); E.haptic("LIGHT"); raf = requestAnimationFrame(tick); };
      L.onpointerup = e => { if (pointer !== e.pointerId) return; cancel(); api.miss(); };
      L.onpointercancel = e => { if (pointer === e.pointerId) cancel(); };
      return cancel;
    },
  });
  E.gesture("tap", {
    html: () => `<div class="ga-tp"><i></i></div>`,
    bind(el, A, api) { $(".se-act").onpointerdown = e => { if (e.button <= 0 && api.live()) inside(e, el, api.pad) ? api.ok() : api.miss(); }; },
  });
  E.gesture("mash", {
    html: A => `<div class="ga-ms"><i></i><b>${A.n || 10}</b></div>`,
    bind(el, A, api) {
      let n = A.n || 10; const b = el.querySelector("b");
      $(".se-act").onpointerdown = e => { if (!api.live() || e.button > 0 || !inside(e, el, api.pad + 30)) return; n--; b.textContent = Math.max(0, n); el.classList.remove("hit"); void el.offsetWidth; el.classList.add("hit"); E.sfx("hit"); E.haptic("LIGHT"); if (n <= 0) api.ok(); };
    },
  });
  E.gesture("torch", {
    html: () => ``,
    bind(el, A, api) {
      const L = $(".se-act"), dark = h(`<div class="ga-dark"></div>`); L.appendChild(dark);
      let t = 0, pointer = null;
      const cancel = () => { pointer = null; dark.classList.remove("on"); clearTimeout(t); t = 0; };
      const move = e => {
        if (!api.live() || e.pointerId !== pointer) return;
        const st = $(".se-stage").getBoundingClientRect();
        dark.style.setProperty("--tx", e.clientX - st.left + "px"); dark.style.setProperty("--ty", e.clientY - st.top + "px");
        if (inside(e, el, api.pad)) { if (!t) t = setTimeout(() => { t = 0; if (pointer != null && api.live()) api.ok(); }, A.hold || 600); } else { clearTimeout(t); t = 0; }
      };
      L.onpointerdown = e => { if (!api.live() || pointer != null || e.button > 0) return; pointer = e.pointerId; capture(L, pointer); dark.classList.add("on"); move(e); };
      L.onpointermove = move;
      L.onpointerup = L.onpointercancel = e => { if (e.pointerId === pointer) cancel(); };
      return cancel;
    },
  });

  def("act", c => new Promise(res => {
    const A = c.st.act, G = E.G(), img = E.curImg();
    const easy = !!G.set.easyAct;
    const reg = n => E.regionOf(img, n)?.box || [30, 40, 40, 30];
    const box = reg(A.r || A.find), to = A.to ? reg(A.to) : null;
    const impl = GS[A.kind || "tap"]; if (!impl) { console.warn("[story] act lạ", A.kind); return res(); }
    E.ui.hideBox(); E.ui.clear();
    const old = $(".se-act"); old?.remove();
    const L = h(`<div class="se-act k-${esc(A.kind || "tap")}">${E.vbox(img, `<div class="ga" style="${E.pctStyle(box)}">${impl.html(A, { to })}</div>`)}
      <div class="ga-p">${A.prompt ? `<b>${esc(nat(A.prompt))}</b>` : ""}${A.ms && !easy ? `<i class="ga-t"><u style="animation-duration:${A.ms}ms"></u></i>` : ""}</div></div>`);
    $(".se-stage").appendChild(L);
    const el = L.querySelector(".ga");
    let over = false, tm = 0, resultTm = 0, misses = 0, unbind = null;
    const live = () => c.live?.() !== false;
    const cleanup = () => { clearTimeout(tm); clearTimeout(resultTm); unbind?.(); unbind = null; L.onpointerdown = L.onpointermove = L.onpointerup = L.onpointercancel = null; L.remove(); };
    c.onCancel?.(() => { over = true; cleanup(); res(); });
    const end = ok => {
      if (over || !live()) return; over = true; clearTimeout(tm); unbind?.(); unbind = null;
      L.classList.add(ok ? "won" : "lost");
      if (ok) { E.sfx(A.sfx || "solve"); E.haptic("MEDIUM"); } else { E.sfx("wrong"); E.haptic("HEAVY"); E.ui.fx("shake"); }
      resultTm = setTimeout(() => { cleanup(); if (!live()) return res(); E.ui.urgent(false); if (ok && A.ok) c.push("act", "ok"); if (!ok && A.fail) c.push("act", "fail"); if (A.set) E.flag(A.set, ok); res(); }, E.auto ? 1 : 420);
    };
    const api = { ok: () => end(true), miss: () => { if (over || !live()) return; misses++; if (A.tries && misses >= A.tries) end(false); }, pad: easy ? 40 : 14, live: () => !over && live() && L.isConnected };
    unbind = impl.bind(el, A, api);
    // Existing custom gestures may return nothing; returning a cleanup function is optional.
    if (typeof unbind !== "function") unbind = null;
    if (A.ms && !easy) { E.ui.urgent(true); tm = setTimeout(() => end(false), A.ms); }
    E.autoRun(() => end(E.auto === "r" ? Math.random() < .6 : true));
  }));

  // ═════════ CHUỖI KHUNG HÀNH ĐỘNG ═════════
  def("beat", c => new Promise(async res => {
    const B = c.st.beat;
    E.ui.hideBox();
    const cap = h(`<div class="se-beat"><b></b></div>`), host = $(".se-stage");
    host.appendChild(cap);
    let skip = null, timer = 0, stopped = false;
    const onTap = e => { if (!e.target.closest("button, input, a")) skip?.(); };
    const cleanup = () => { stopped = true; clearTimeout(timer); host.removeEventListener("pointerdown", onTap); cap.remove(); skip?.(); skip = null; };
    c.onCancel?.(() => { cleanup(); res(); });
