    const available=Math.max(0,H-top-bottom),maxWidth=Math.max(0,Math.min(660,W-24));
    const measureRows=()=>['.se-detail-title','.se-detail-caption'].reduce((n,s)=>n+(insert.querySelector(s)?.getBoundingClientRect().height||0),0);
    dialogueStyle(current.el,'--detail-width',dialogueNumber(maxWidth)+'px');
