  def("reveal", async c => { const { st } = c, R = E.R(), id = typeof st.reveal === "string" ? st.reveal : R.reveal; R.reveal = null; if (id) { const from = E._zoneRect; E._zoneRect = null; E.ui.hideBox(); await E.ui.reveal(id, { fresh: st.reveal === 1 || st.reveal === true, from, context:c }); } });
