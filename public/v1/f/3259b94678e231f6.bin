  const cardsDraw=()=>{if(!live()||!shell)return;arrangeCards();const f=shell.contains(document.activeElement)?document.activeElement:null,k=f?.dataset.select||f?.dataset.pin;st.selected=st.selected.filter(id=>scoped().includes(id)).slice(0,1);world.querySelector('.cb4-cards').innerHTML=visible().map(cardHtml).join('');shell.querySelector('.cb4-empty').hidden=visible().length>0;wiresDraw();updateStatus();if(k)[...world.querySelectorAll(f?.dataset.pin?'[data-pin]':'[data-select]')].find(x=>(x.dataset.pin||x.dataset.select)===k)?.focus({preventScroll:true});};
