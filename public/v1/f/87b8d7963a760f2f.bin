.im-study,.im-cover{background-image:url('img/study.webp')}
.im-carriage,.im-alder_lane,.im-service_lane{background-image:url('img/street.webp')}
.im-wren_door{background-image:url('img/wren-front.webp')}
.im-cab_stand{background-image:url('img/cab-stand.webp')}
.im-vale{background-image:url('img/vale.webp')}
.im-reed{background-image:url('img/stage-reed.webp')}
.im-finn{background-image:url('img/stage-finn.webp')}
.im-bell{background-image:url('img/stage-bell.webp')}
.im-matthias{background-image:url('img/stage-matthias.webp')}
.im-matthias-unmasked,.vd[data-vd-mask="off"] .se-chi .im-matthias{background-image:url('img/stage-matthias-unmasked.webp')}
.se-bgl:has(.im-study) .ph,.se-bgl:has(.im-carriage) .ph,.se-bgl:has(.im-alder_lane) .ph,.se-bgl:has(.im-service_lane) .ph,.se-bgl:has(.im-wren_door) .ph{display:none}
/* Keep native entrance, focus and breathing with transparent foreground art. */
.se-chi:has(.im-reed) .ph,.se-chi:has(.im-matthias) .ph,.se-chi:has(.im-finn) .ph,.se-chi:has(.im-bell) .ph{display:none}
.vd .se-ch[data-id="matthias"].anon .ii{filter:none;opacity:1}

/* Native place views and action shots, with regions authored against these images. */
.im-study_desk{background-image:url('img/study-desk.webp')}
.im-study_window{background-image:url('img/study-window.webp')}
.im-study_door{background-image:url('img/study-door.webp')}
.im-act-watermark{background-image:url('img/act-watermark.webp')}
.im-act-unmask{background-image:url('img/act-unmask.webp')}
.se-bgl:has(.im-study_desk) .ph,.se-bgl:has(.im-study_window) .ph,.se-bgl:has(.im-study_door) .ph,.se-bgl:has(.im-cab_stand) .ph,.se-bgl:has(.im-act-watermark) .ph,.se-bgl:has(.im-act-unmask) .ph{display:none}

.im-finn-full{background-image:url('img/full-finn.webp')}
.im-bell-full{background-image:url('img/full-bell.webp')}
.im-reed-full{background-image:url('img/full-reed.webp')}
/* Continuity art for the later chapters. */
.im-celia,.im-celia-full{background-image:url('img/full-celia.webp')}
.im-hart,.im-hart-full{background-image:url('img/full-hart.webp')}
.im-c3_clerk,.im-c3_clerk-full{background-image:url('img/full-c3_clerk.webp')}
.im-c5_walker,.im-c5_walker-full{background-image:url('img/full-c5_walker.webp')}
.se-chi:has(.im-celia) .ph,.se-chi:has(.im-hart) .ph,.se-chi:has(.im-c3_clerk) .ph,.se-chi:has(.im-c5_walker) .ph{display:none}
.vd .se-chi .im-celia,.vd .se-chi .im-hart,.vd .se-chi .im-c3_clerk,.vd .se-chi .im-c5_walker{background-size:185% auto;background-position:50% 0}
.vd .se-ppi .im-celia,.vd .se-ppi .im-hart,.vd .se-ppi .im-c3_clerk,.vd .se-ppi .im-c5_walker,.vd .se-ia.is-testimony .im-celia,.vd .se-ia.is-testimony .im-hart,.vd .se-ia.is-testimony .im-c3_clerk{background-size:230% auto;background-position:50% 0}
.im-c2_front_day,.im-c2_lane_day,.im-c6_wren{background-image:url('img/bg-wren-day.webp')}
.im-c2_gate_day{background-image:url('img/bg-service-gate.webp')}
.im-c3_court{background-image:url('img/bg-chapel-court.webp')}
.im-c3_chapel{background-image:url('img/bg-chapel.webp')}
