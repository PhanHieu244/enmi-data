      else if (u) { hold = Object.keys(u.z.use).find(it => R.items.includes(it)); onZone(u.i, elOf(u.i)); }
      else if (pp) { PS.n["auto:p:" + pp.p.who] = 1; onPerson(pp.i, null); }
