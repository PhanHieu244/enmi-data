  "1mpjmv7": "3日目 · 午前8時", // Day 3 · 8:00 a.m.
  "1fwey01": "ハルデン総合病院 救急外来", // A&E, Halden General
  "1wl35i8": "3日目 · 午後2時", // Day 3 · 2:00 p.m.
  "tqdp5s": "記録保管室", // Records room
  "1bvu2be": "3日目 · 午後11時40分", // Day 3 · 11:40 p.m.
  "pmbed9": "自宅前の通り", // Your street
  "w90kkv": "4日目 · 午後8時", // Day 4 · 8:00 p.m.
  "1a9hsy4": "ホルト邸", // Holt House
  "1k4i946": "4日目 · 午後9時20分", // Day 4 · 9:20 p.m.
  "jc3rvf": "ホルトの書斎", // Holt's study
  "1f5livx": "4日目 · 午後9時45分", // Day 4 · 9:45 p.m.
  "10qxmlo": "ホルト邸の厨房", // Holt House kitchen
  "cixju2": "5日目 · 午後10時30分", // Day 5 · 10:30 p.m.
  "26zkvh": "港、嵐", // Harbour, storm
  "11qg3u3": "5日目 · 午後11時10分", // Day 5 · 11:10 p.m.
