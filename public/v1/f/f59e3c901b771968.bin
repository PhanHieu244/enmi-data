            { say: "me", en: "He said: 'He pushed him away, like — then there was this splash.' I wrote what I thought he meant. I was wrong to.", vi: "Cậu ấy nói: “Ông ta đẩy anh ấy ra, kiểu — rồi có tiếng ùm.” Tôi ghi theo điều tôi nghĩ cậu ấy muốn nói. Tôi đã sai." } ] },
          { tag: "lie", en: "Yes. Word for word.", vi: "Đúng. Từng chữ một.", set: { c6_answer: "lie", c6_lied: 1 }, add: { lie: 1 } },
        ], timer: 12, timeout: [{ set: { c6_answer: "lie", c6_lied: 1 } }, { n: { en: "Your silence is written down as 'Yes'.", vi: "Sự im lặng của bạn được ghi là “Đúng”." } }] } ],
        else: [
        { say: "me", en: "Yes. Word for word.", vi: "Đúng. Từng chữ một." },
        { set: { c6_answer: "clean", c6_clean: 1 } },
        { think: { en: "And for the first time, those words don't hurt.", vi: "Và lần đầu tiên, câu đó không làm bạn đau." } } ] },
      { hide: "*" }, { cam: null },
      { go: "c6_verdict" },
    ],

    c6_verdict: [
      { bg: "court" },
      { n: { en: "The jury is out for four hours. You spend them on a wooden bench in the corridor, holding a paper cup of tea you never drink.", vi: "Bồi thẩm đoàn nghị án bốn tiếng. Bạn ngồi suốt trên chiếc ghế gỗ ngoài hành lang, tay cầm cốc trà giấy không uống ngụm nào." } },
      { cg: "cg-verdict" }, { fx: "spotlight" },
      { n: { en: "'Has the jury reached a verdict?'", vi: "“Bồi thẩm đoàn đã có phán quyết chưa?”" } },
      { cg: null },
      // KẾT THÚC: theo thứ tự ưu tiên
      { if: s => s.f.dock === "sam" && s.f.c6_lied, then: [{ go: "c6_faithful" }] },
      { if: s => s.f.holt === "yes" && s.f.c6_lied, then: [{ go: "c6_pen" }] },
      { if: s => s.f.dock === "tom" && !(s.f.ev_coat && s.truth("T5")), then: [{ go: "c6_wrong" }] },
      { if: s => Object.keys(s.G.truths).length >= 12 && !s.f.c6_lied && s.f.ev_book && (s.f.ev_finch || s.f.ev_holt), then: [{ if: s => s.f.c5_finch_full && s.f.ev_finch, then: [{ go: "c6_finch" }], else: [{ go: "c6_whole" }] }] },
      { go: "c6_half" },
    ],

    c6_whole: [
      { mood: "warm" },
      { n: { en: "Guilty. Owen Price, of the murder of Danny Reece and Harold Finch. Graham Holt, of trafficking children. Maggie Lane gives evidence for four days and cries through all of it.", vi: "Có tội. Owen Price, tội giết Danny Reece và Harold Finch. Graham Holt, tội buôn bán trẻ em. Maggie Lane làm chứng suốt bốn ngày và khóc suốt bốn ngày." } },
      { cg: "cg-home" }, { fx: "particles", kind: "petals", ms: 8000 },
      { n: { en: "In spring, you and Sam walk along the beach at Port Halden. Kieran is behind you, throwing stones at the sea. Tom's boat is going out.", vi: "Mùa xuân, bạn và Sam đi dọc bãi biển Port Halden. Kieran đi phía sau, ném đá xuống biển. Tàu của Tom đang ra khơi." } },
      { show: "ruth", at: "c", face: "proud" },
      { say: "ruth", face: "proud", en: "I've asked them to make you permanent. Somebody in this town has to write things down properly.", vi: "Tôi đã đề nghị cho {cc} vào biên chế. Thị trấn này phải có ai đó ghi chép cho đàng hoàng." },
      { cg: null }, { mood: null },
      { end: "e_whole" },
    ],
    c6_finch: [
      { mood: "flashback" },
      { n: { en: "Guilty — Owen, Holt, every name in Sam's notebook. And then, a week later, a small brown package arrives at the station. Your name on it, in old, shaky handwriting.", vi: "Có tội — Owen, Holt, mọi cái tên trong sổ của Sam. Rồi một tuần sau, một gói nhỏ màu nâu được gửi đến đồn. Tên bạn ghi trên đó, nét chữ cũ, run run." } },
      { cg: "cg-finchletter" },
      { say: "finch", en: "To the next person who holds the pen. I'm sorry I made it heavier. Write what they say. Not what is easy. — H. Finch", vi: "Gửi người cầm bút tiếp theo. Xin lỗi vì ta đã làm nó nặng thêm. Hãy ghi những gì họ nói. Không phải điều dễ dàng. — H. Finch" },
      { n: { en: "Finch had paid a solicitor to post it 'if the truth ever comes out'. It took a year, a storm and a nineteen-year-old's notebook. But it came out.", vi: "Finch đã trả tiền cho một luật sư gửi nó “nếu sự thật có ngày được phơi bày”. Phải mất một năm, một cơn bão và cuốn sổ của một cậu mười chín tuổi. Nhưng sự thật đã lộ ra." } },
      { cg: "cg-home" }, { fx: "particles", kind: "petals", ms: 8000 },
      { n: { en: "Spring. The beach. Sam, Kieran, Tom's boat going out. Some things the sea gives back in exactly the right shape.", vi: "Mùa xuân. Bãi biển. Sam, Kieran, tàu của Tom ra khơi. Có những thứ biển trả lại đúng hình dạng người ta mong." } },
      { cg: null }, { mood: null },
      { end: "e_finch" },
    ],
    c6_half: [
      { n: { en: "Guilty — but not everyone. The court has some of the truth, and some of the truth is not enough.", vi: "Có tội — nhưng không phải tất cả. Toà có một phần sự thật, và một phần sự thật thì không đủ." } },
      { if: s => s.f.ev_holt, then: [{ n: { en: "Holt goes to prison for trying to bribe a police officer. Four years. He smiles as they take him down.", vi: "Holt vào tù vì mua chuộc cảnh sát. Bốn năm. Ông ta mỉm cười khi bị dẫn đi." } }] },
      { if: s => s.f.owen_gone || !s.f.ev_finch, then: [{ n: { en: "Owen is never charged with Finch's death. Sometimes, at dawn, you see him on the north pier, looking at you.", vi: "Owen không bao giờ bị buộc tội cái chết của Finch. Thỉnh thoảng, lúc rạng sáng, bạn thấy anh ta trên cầu tàu phía bắc, nhìn bạn." } }, { fx: "shiver" }] },
      { end: "e_half" },
    ],
    c6_wrong: [
      { mood: "cold" },
      { n: { en: "Guilty. Tom Ward. Life.", vi: "Có tội. Tom Ward. Chung thân." } },
      { show: "tom", at: "c", face: "soft" },
      { say: "tom", face: "soft", en: "Nine of them got out. Remember that, detective. Nine.", vi: "Chín đứa đã thoát ra được. Nhớ lấy điều đó, thám tử. Chín đứa." },
      { hide: "*" }, { mood: null },
      { end: "e_wrong" },
    ],
    c6_faithful: [
      { mood: "noir" },
      { n: { en: "Not guilty. Sam walks out of the court into the rain and doesn't look back at you.", vi: "Vô tội. Sam bước ra khỏi toà dưới mưa và không ngoái lại nhìn bạn." } },
      { n: { en: "Holt sends flowers. The card says: 'Beautifully written.'", vi: "Holt gửi hoa. Tấm thiệp ghi: “Viết đẹp lắm.”" } },
      { mood: null },
      { end: "e_faithful" },
    ],
    c6_pen: [
      { cg: "cg-dark" }, { mood: "warm" },
      { n: { en: "A flat with a view of the harbour. A salary that arrives on the first of every month. And once a month, a statement that needs to be written… carefully.", vi: "Một căn hộ nhìn ra bến cảng. Đồng lương về đúng ngày mùng một mỗi tháng. Và mỗi tháng một lần, một bản lời khai cần được viết… thật cẩn thận." } },
      { n: { en: "You are very good at it. Finch would be proud. That is the worst thing anyone could say about you.", vi: "Bạn làm việc đó rất giỏi. Finch hẳn sẽ tự hào. Đó là điều tồi tệ nhất người ta có thể nói về bạn." } },
      { cg: null }, { mood: null },
      { end: "e_pen" },
    ],
    c6_struck: [
      { show: "ruth", at: "c", face: "cold" },
      { say: "ruth", face: "cold", en: "Before you go in. Owen told me about your brother. Maggie told me about her kitchen. Every time I asked, you lied.", vi: "Trước khi {cc} vào. Owen kể tôi nghe về em trai {cc}. Maggie kể về gian bếp của bà ấy. Lần nào tôi hỏi, {cc} cũng nói dối." },
      { say: "ruth", en: "I can't put a liar on the stand. You're suspended. Hand me your warrant card.", vi: "Tôi không thể đưa một kẻ nói dối lên bục làm chứng. {Cc} bị đình chỉ. Nộp thẻ ngành đây." },
      { hide: "*" },
      { n: { en: "You take the train south that evening. Sam is still out there, somewhere, with a notebook nobody will ever read.", vi: "Tối hôm đó bạn đáp tàu về phía nam. Sam vẫn ở đâu đó ngoài kia, với một cuốn sổ chẳng ai đọc tới." } },
      { end: "e_struck" },
    ],
  },

  endings: {
    e_whole: { ch: 6, final: true, title: { en: "The Whole Truth", vi: "Toàn bộ sự thật" }, sum: { en: "Owen and Holt convicted. Sam home. Ruth keeps you.", vi: "Owen và Holt bị kết án. Sam về nhà. Ruth giữ bạn lại." },
      text: { en: "Words fade. Writing stays. This time, what stays is true.", vi: "Lời nói thoảng qua. Chữ viết ở lại. Lần này, thứ ở lại là sự thật." } },
    e_finch: { ch: 6, final: true, title: { en: "Finch's Voice", vi: "Giọng của Finch" }, sum: { en: "The secret ending. A letter for the next pen.", vi: "Kết thúc bí mật. Lá thư cho ngòi bút tiếp theo." },
      text: { en: "A dead man apologised to you in his own handwriting. You keep the letter in your notebook, between the pages you haven't written yet.", vi: "Một người đã khuất xin lỗi bạn bằng chính nét chữ của mình. Bạn kẹp lá thư trong sổ tay, giữa những trang bạn chưa viết." } },
    e_half: { ch: 6, final: true, title: { en: "Half a Truth", vi: "Một nửa sự thật" }, sum: { en: "Some of them pay. Some of them don't.", vi: "Vài kẻ trả giá. Vài kẻ thì không." },
      text: { en: "Half a truth is a door left open. Something always comes back through it.", vi: "Một nửa sự thật là cánh cửa để ngỏ. Luôn có thứ gì đó quay lại qua nó." } },
    e_wrong: { ch: 6, final: true, title: { en: "Wrong Man", vi: "Bắt nhầm người" }, sum: { en: "Tom goes to prison for saving children.", vi: "Tom vào tù vì đã cứu những đứa trẻ." },
      text: { en: "The jury believed the paper. The paper believed the coat. Nobody asked who was wearing it.", vi: "Bồi thẩm đoàn tin tờ giấy. Tờ giấy tin chiếc áo. Không ai hỏi ai đang mặc nó." } },
    e_faithful: { ch: 6, final: true, title: { en: "The Faithful Lie", vi: "Lời dối thuỷ chung" }, sum: { en: "Sam is free. You became the next Finch.", vi: "Sam được tự do. Bạn trở thành Finch tiếp theo." },
      text: { en: "You saved your brother with one sentence. Now you will write that sentence for the rest of your life.", vi: "Bạn cứu em trai bằng một câu. Giờ bạn sẽ viết câu đó suốt phần đời còn lại." } },
    e_pen: { ch: 6, final: true, title: { en: "The Benefactor's Pen", vi: "Ngòi bút của ân nhân" }, sum: { en: "A good salary. A nice flat. A careful pen.", vi: "Lương cao. Căn hộ đẹp. Một ngòi bút cẩn thận." },
      text: { en: "Holt bought a detective and got exactly what he paid for.", vi: "Holt mua một thám tử và nhận đúng thứ ông ta đã trả tiền." } },
    e_struck: { ch: 6, final: true, title: { en: "Struck Off", vi: "Bị đuổi việc" }, sum: { en: "Too many lies. Ruth couldn't trust you.", vi: "Quá nhiều lời dối. Ruth không thể tin bạn." },
      text: { en: "You lied to protect people. In the end, the lies protected no one — least of all you.", vi: "Bạn nói dối để bảo vệ người khác. Cuối cùng, những lời dối chẳng bảo vệ được ai — nhất là chính bạn." } },
  },
});
// SINH bởi tools/games/_lib/story/lang-tool.js — bản German của truyện (lớp phủ). Sửa tay được; câu en đổi thì chạy lại công cụ.
StoryEngine.lines("de", {
  "1eg7elt": "Die Aussage", // The Statement
  "1nsd0o6": "Ein falsches Wort kann einen Unschuldigen ins Gefängnis bringen.", // One wrong word can put an innocent man in prison.
  "1o7ff8o": "Kommissaranwärterin, Polizei Port Halden. Erste Woche im Dienst.", // Trainee detective, Port Halden police. First week on the job.
  "1urie2m": "Geheimnis: Du bist hier, um deinen kleinen Bruder Sam zu finden — seit vier Monaten vermisst.", // Secret: you came to find your little brother Sam, missing for four months.
  "1ydcjyp": "Kriminalhauptkommissarin. Deine Mentorin. Vertraut Beweisen, nicht Menschen.", // Detective Inspector. Your mentor. Trusts evidence, not people.
  "106oz6i": "Kriminaloberkommissar. Freundlich. Will den Fall schnell abschließen.", // Detective Sergeant. Friendly. In a hurry to close the case.
  "1682kqd": "Er hat gelogen, was im Pub gerufen wurde.", // He lied about what was shouted at the pub.
  "1ixjq4m": "Er war auf dem Pier, als Finch starb — und als Danny starb.", // He was on the pier when Finch died — and when Danny died.
  "uaxvca": "Der Junge", // The boy
  "1bnaab1": "Der einzige Zeuge.", // The only witness.
  "b7gb05": "Der einzige Zeuge. 16 Jahre alt. Völlig verängstigt.", // The only witness. 16 years old. Terrified.
  "10kaycu": "Dein kleiner Bruder, 19. Seit vier Monaten vermisst.", // Your little brother, 19. Missing for four months.
  "1vl52ri": "Er war auf dem Pier in der Nacht, als Danny starb.", // He was on the pier the night Danny died.
  "1u2vtz3": "Lebt. Versteckt sich im Leuchtturm von Gull Head.", // Alive. Hiding at the Gull Head lighthouse.
  "139hg9w": "Irgendwer aus dem Hafen.", // Somebody at the harbour.
  "1wuone5": "Wirt des Pubs The Anchor. Sieht alles, sagt wenig.", // Owner of The Anchor pub. Sees everything, says little.
  "1gwiejk": "Im Hafen kennt sie jeder.", // Everyone at the harbour knows her.
  "7594p8": "Inhaberin von Maggie's Fish and Chips. Die „Mutter“ des Hafens.", // Owner of Maggie's fish and chip shop. 'Mum' of the harbour.
  "1tz9qsr": "Sie sucht Ausreißer für Holts Linie.", // She finds runaway kids for Holt's line.
  "ak0kjy": "Sie hat dir den Schlüssel zu Gull Point gegeben.", // She gave you the key to Gull Point.
  "1wlfw48": "Owen verdächtigt ihn schon.", // Owen already blames him.
  "igj41r": "Kapitän des Trawlers Marta. Sagt sehr wenig.", // Captain of the trawler Marta. Says very little.
  "1984hw2": "Seine Stimme ist auf Kierans Sprachnachricht.", // His is the voice on Kieran's voice message.
  "fr14tn": "Er hat heimlich neun Kindern zur Flucht geholfen.", // He has secretly helped nine kids escape.
  "y9vvit": "Jemand, der Kinder verarztet, nach denen niemand fragt.", // Someone who patches up kids no one asks about.
  "fd50c1": "Krankenpflegerin in der Notaufnahme, 27. Redet schnell. Verbirgt etwas.", // A&E nurse, 27. Talks fast. Hides something.
  "17ap8ic": "Sie hat über Gull Point gelogen.", // She lied about Gull Point.
  "1qauc65": "Sie versteckt Sam.", // She is hiding Sam.
  "2tat1c": "Der große Wohltäter der Stadt.", // The town's great benefactor.
  "1c27ruo": "Inhaber von Holt Seafoods. Zahlt für halbe Stadt.", // Owner of Holt Seafoods. Pays for half the town.
  "1eicjub": "Sein Geld bezahlt deine Stelle.", // His money pays for your job.
  "9qn81s": "In den Fischkisten ist mehr als Fisch.", // The fish boxes carry more than fish.
  "1soje8l": "Ein Name in den alten Akten des Reviers.", // A name in the station's old files.
  "e3hhkr": "30 Jahre lang hat er die Aussagen im Revier aufgenommen. Letzten Oktober ertrunken.", // The station's statement taker for 30 years. Drowned last October.
  "19aiy1s": "Er hat Aussagen von Kindern absichtlich verändert.", // He changed children's statements on purpose.
  "tex16g": "Owen war dabei, als er starb.", // Owen was there when he died.
  "18d69k6": "Owen beobachtet dich genauer.", // Owen is watching you more closely.
  "1hni2hr": "Owen entspannt sich ein wenig.", // Owen relaxes a little.
  "1fyae4": "Sechs Tage später", // Six days later
  "4gnogj": "Landgericht", // Crown Court
  "16vl74d": "3:05 Uhr", // 3:05 a.m.
  "10sy0qd": "Dein Zimmer", // Your room
  "rbgk9y": "3:20 Uhr", // 3:20 a.m.
