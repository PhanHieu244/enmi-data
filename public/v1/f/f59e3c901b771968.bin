            fix: { en: "Sam's notebook lists every child, every debt and every van.", vi: "Sổ tay của Sam ghi tên từng đứa trẻ, từng món nợ, từng chuyến xe." },
            ok: [{ pic: "act-evidence" }, { say: "me", en: "Two hundred and eleven entries. Names, debts, dates. Danny Reece died carrying this notebook.", vi: "Hai trăm mười một dòng. Tên, nợ, ngày tháng. Danny Reece chết khi đang mang cuốn sổ này." }, { set: { ev_book: 1 } }] },
          { t: { en: "Mr Holt is a respected benefactor who has never tried to influence a police officer.", vi: "Ông Holt là nhà hảo tâm đáng kính, chưa từng tìm cách tác động tới cảnh sát." }, bad: true, evidence: "recorder",
