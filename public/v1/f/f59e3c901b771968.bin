          { t: { en: "The witness, Kieran Doyle, saw the defendant push the victim into the water.", vi: "Nhân chứng Kieran Doyle thấy bị cáo đẩy nạn nhân xuống nước." }, bad: s => s.f.push !== "in", same: [{ think: { en: "That's what your statement says. Because that's what you wrote.", vi: "Biên bản của bạn ghi vậy thật. Vì chính bạn đã ghi thế." } }], evidence: "notes",
