.vd .se-ia.vd-record-art>.se-record-portrait:not(.cropped){background-position:50% 8%!important;background-size:130% auto!important}
.vd .se-ia.vd-record-art>.se-record-portrait.cropped{position:absolute;inset:auto;left:50%;top:var(--portrait-top,-6%);width:auto;height:var(--portrait-height,310%);aspect-ratio:var(--portrait-ar,.5);transform:translateX(-50%);background-size:contain!important;background-position:center!important;background-repeat:no-repeat}
.vd .vd-record-art>.vd-quote-mark,.vd .vd-record-art>.vd-inference-mark{display:none!important}
