  E.bag = () => R.items.filter(E.itemLive);
  // Location inventory is deliberately broader than a target's answer list.
  // Keep every owned item collected here, plus older items with any authored
  // use in the whole location. View changes and person selection do not narrow
  // this set or reveal which item solves a particular hotspot.
  const asList = value => Array.isArray(value) ? value : value == null ? [] : [value];
  const mappedLocation = id => {
    if (!id || typeof id !== "string") return null;
    if (S?.locations?.[id]) return id;
    for (const [scope, raw] of Object.entries(S?.locations || {})) {
      const config=raw||{};
      if (asList(Array.isArray(config) ? config : config.scenes).includes(id) || asList(config.places).includes(id) || asList(config.nodes).includes(id)) return scope;
    }
    return null;
  };
  E.locationOf = id => mappedLocation(id) || mappedLocation(S?.scenes?.[id]?.location) || S?.scenes?.[id]?.location || id || "";
  E.enterLocation = id => { const scope = E.locationOf(id); if (R && scope) R.location = scope; return scope; };
  E.currentLocation = () => E.locationOf(R?.location || R?.scene || "");
  let inventoryIndex = null, inventoryStamp = "";
  E.rebuildInventoryScopes = () => {
    const sources = new Map(), uses = new Map(), entries = new Map(), stack = new Set();
    const add = (map, scope, id) => { if (!scope || !id || !S.items?.[id]) return; const set = map.get(scope) || new Set(); set.add(id); map.set(scope, set); };
    const each = (map, scopes, id) => { for (const scope of scopes) add(map, scope, id); };
    const merge = (...sets) => new Set(sets.flatMap(set => [...set]));
    const branchNames = new Set(["then","else","ok","fail","wrong","again","stuck","hello","bye","empty","giveUp","late","after","unavailable"]);
    let changed = false;
    function forward(node, scopes) { if (typeof node !== "string" || !S.nodes?.[node]) return; const next = entries.get(node) || new Set(); for (const scope of scopes) if (!next.has(scope)) { next.add(scope); changed = true; } entries.set(node, next); }
    function generic(value, scopes, path, isStep = false) {
      if (!value || typeof value !== "object" || stack.has(value)) return;
      if (Array.isArray(value)) { for (const [i, child] of value.entries()) generic(child, scopes, [...path, i]); return; }
      stack.add(value);
      if (typeof value.take === "string") each(sources, scopes, value.take);
      for (const id of value.gives || []) if (typeof id === "string" && !id.startsWith("q:")) each(sources, scopes, id);
      if (!isStep && typeof value.item === "string") each(uses, scopes, value.item); // option prerequisite, not a grant
      if (typeof value.evidence === "string") each(uses, scopes, value.evidence);
      // Curated comparison candidates can refer to records collected in an
      // earlier location. They remain usable in this whole location too.
      for (const id of asList(value.recordIds)) if (typeof id === "string") each(uses, scopes, id);
      if (value.deduce) for (const id of asList(value.deduce.a).flat()) if (typeof id === "string") each(uses, scopes, id);
      if (value.use && typeof value.use === "object") for (const [id, branch] of Object.entries(value.use)) { each(uses, scopes, id); sequence(branch, scopes, [...path, "use", id]); }
      if (value.with && value.show && typeof value.show === "object") for (const [id, branch] of Object.entries(value.show)) { if (id !== "*") each(uses, scopes, id); sequence(branch, scopes, [...path, "show", id]); }
      if (value.go) forward(value.go, scopes);
      for (const [key, child] of Object.entries(value)) {
        if (["use","show","place","talk","__n"].includes(key)) continue;
        if (Array.isArray(child) && branchNames.has(key)) sequence(child, scopes, [...path, key]);
        else if (child && typeof child === "object") generic(child, scopes, [...path, key]);
      }
