.se .se-reading-toolbar,.se .se-record-detail-tools{display:flex;align-items:center;justify-content:flex-end;gap:8px;min-width:0}
.se .se-shh:has(>[data-reading-toggle]){gap:8px}
.se .se-shh:has(>[data-reading-toggle])>b{flex:1;min-width:0;margin-right:auto;overflow-wrap:anywhere}
