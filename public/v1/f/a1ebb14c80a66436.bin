          "then"
        ],
        0
      ],
      "kind": "n",
      "score": 42,
      "old": "Ten past two. Leo is waiting for you at the estate gate below the big house. The estate's old Land Rover is standing in Gideon's yard, mud t",
      "new": "Ten past two. Leo is waiting at the estate gate below the big house."
    },
    {
      "n": "c5_yard",
      "p": [],
      "i": 6,
      "to": [
        "c5_yard",
        [],
        6
      ],
      "kind": "n",
      "score": 16.4,
      "old": "He doesn't knock. Not alone, not with that bag in his hand.",
      "new": "He keeps the bag close. One officer, an unsecured house, and people he has to get back safely."
    },
    {
      "n": "c5_yard",
      "p": [],
      "i": 7,
      "to": [
        "c5_yard",
        [],
        7
      ],
      "kind": "say",
      "score": 16.6,
      "old": "CID can knock.",
      "new": "We'll come back with CID. Nobody goes in there now."
    },
    {
      "n": "c5_card",
      "p": [],
      "i": 5,
      "to": [
        "c5_card",
        [],
        6
      ],
      "kind": "say",
      "score": 26.4,
      "old": "Twenty years and more I've been a good doctor. Except for one morning.",
      "new": "I've told myself one morning didn't make me a bad doctor. It didn't make that morning go away."
    },
    {
      "n": "c5_wait",
      "p": [],
      "i": 1,
      "to": [
        "c5_wait",
        [],
        1
      ],
      "kind": "say",
      "score": 14.6,
      "old": "It's the middle of the night. It can wait for the light.",
      "new": "I can't face what might be up there tonight. Go. I'll stay here."
    },
    {
      "n": "c5_wait",
      "p": [],
      "i": 3,
