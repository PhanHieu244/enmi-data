    }
    // Propagate physical entry locations through actual node links. No flags
    // are evaluated: old saves receive the deterministic possible-source map.
    for (const node of Object.keys(S.nodes || {})) { const scope = mappedLocation(node); if (scope) entries.set(node, new Set([scope])); }
    for (const [id, spec] of Object.entries(S.places || {})) place(id, new Set(), ["@places", id]);
    for (let pass = 0; pass < Math.min(64, Object.keys(S.nodes || {}).length + 1); pass++) { changed = false; for (const [node, steps] of Object.entries(S.nodes || {})) sequence(steps, entries.get(node) || new Set(), [node]); if (!changed) break; }
    // Explicit source declarations resolve stories whose dynamic functions
    // choose a source which a static traversal cannot identify.
    for (const [id, locations] of Object.entries(S.itemSources || {})) { for (const set of sources.values()) set.delete(id); for (const location of asList(locations)) add(sources, E.locationOf(location), id); }
    for (const [scope, config] of Object.entries(S.locations || {})) { for (const id of asList(config.items)) add(sources, scope, id); for (const id of asList(config.uses)) add(uses, scope, id); }
    inventoryIndex = {sources, uses};
    inventoryStamp = Object.keys(S.nodes || {}).length + ":" + Object.keys(S.places || {}).length + ":" + JSON.stringify(S.locations || {}) + ":" + JSON.stringify(S.itemSources || {});
    return {sources:Object.fromEntries([...sources].map(([k,v])=>[k,[...v]])),uses:Object.fromEntries([...uses].map(([k,v])=>[k,[...v]]))};
  };
  function indexForInventory() { const stamp = Object.keys(S.nodes || {}).length + ":" + Object.keys(S.places || {}).length + ":" + JSON.stringify(S.locations || {}) + ":" + JSON.stringify(S.itemSources || {}); if (!inventoryIndex || inventoryStamp !== stamp) E.rebuildInventoryScopes(); return inventoryIndex; }
  E.noteItemOrigin = (id, scope = E.currentLocation()) => { if (!R || !S.items?.[id] || !scope) return; const origins = ((R.itemOrigins ||= {})[id] ||= []), location = E.locationOf(scope); if (!origins.includes(location)) origins.push(location); };
  const knownInventory = new WeakMap();
  E.syncItemOrigins = () => { if (!R || !Array.isArray(R.items)) return; const before = knownInventory.get(R); if (before) for (const id of R.items) if (!before.has(id)) E.noteItemOrigin(id); knownInventory.set(R, new Set(R.items)); };
  E.contextItems = (scope = E.currentLocation()) => {
    scope = E.locationOf(scope); const index = indexForInventory(), local = index.sources.get(scope) || new Set(), usable = new Set(index.uses.get(scope) || []);
    // Needed ingredients remain candidates even before their partner is found.
    for (let pass = 0; pass < (S.combos || []).length + 1; pass++) for (const [i, combo] of (S.combos || []).entries()) if (!R.used?.["cmb:" + i] && combo.make && usable.has(combo.make)) { usable.add(combo.a); usable.add(combo.b); }
    return R.items.filter(id => S.items?.[id] && (usable.has(id) || (R.itemOrigins?.[id]?.length ? R.itemOrigins[id].some(origin => E.locationOf(origin) === scope) : local.has(id))));
  };
  // A combine picker shares the location's plausible candidates. An older
  // selected item also brings its source location's records, so opening it in
  // the casebook does not reduce the choices to its correct partner alone.
  E.combineCandidates = (id, scope = E.currentLocation(), contextual = S.contextInventory) => {
    if (!R.items.includes(id) || !S.items?.[id]) return [];
    const owned = R.items.filter(other => other !== id && S.items?.[other]);
    if (!contextual) return owned;
    const locations = new Set([E.locationOf(scope)]), origins = R.itemOrigins?.[id];
    if (origins?.length) for (const origin of origins) locations.add(E.locationOf(origin));
    else for (const [origin, ids] of indexForInventory().sources) if (ids.has(id)) locations.add(origin);
    const candidates = new Set([...locations].flatMap(location => E.contextItems(location)));
    // Combinations work outside exploration too. Retain an owned unused
    // partner even when the current location has no use for the result yet.
    for (const [i, combo] of (S.combos || []).entries()) if (!R.used?.["cmb:" + i]) {
      const partner = combo.a === id ? combo.b : combo.b === id ? combo.a : null;
      if (owned.includes(partner)) candidates.add(partner);
    }
    return owned.filter(other => candidates.has(other));
  };
  E.on("item", id => E.noteItemOrigin(id));
  E.on("step", (type, st) => {
    E.syncItemOrigins();
    if (typeof st.bg === "string" || typeof st.scene === "string") E.enterLocation(st.bg || st.scene);
    if (type === "place") { const p = typeof st.place === "string" ? S.places?.[st.place] : st.place, f = R.stack?.at(-1); if (p) E.enterLocation(p.location || p.id || (typeof st.place === "string" ? st.place : [f?.n,...(f?.p||[]),(f?.i||1)-1].join('.'))); }
    if (type === "explore") E.enterLocation(st.explore.location || R.location || R.scene);
    if (type === "talk") { const k = typeof st.talk === "string" ? S.talks?.[st.talk] : st.talk; if (k?.location) E.enterLocation(k.location); }
  });
  E.on("chapter", () => { inventoryIndex = null; });
  const saveWithOrigins = E.save;
  E.save = (...args) => { E.syncItemOrigins(); return saveWithOrigins(...args); };
  // số cặp đồ đang ghép được (để nhắc “có thể ghép”, không nói cặp nào)
  E.canCombine = () => (S.combos || []).filter((k, i) => !R.used?.["cmb:" + i] && R.items.includes(k.a) && R.items.includes(k.b)).length;
  // GHÉP 2 món ở BẤT CỨ LÚC NÀO (Sổ tay → Đồ vật, không chỉ trong màn khám phá): ra đồ mới (make) ngay; cảnh đi kèm (then)
  //   chạy ngay sau bước đang diễn ra. → { ok, make } | { ok: false }
  E.combine = (a, b) => {
    if (a === b || !R.items.includes(a) || !R.items.includes(b) || !S.items?.[a] || !S.items?.[b]) return { ok: false };
    const ci = (S.combos || []).findIndex(k => (k.a === a && k.b === b) || (k.b === a && k.a === b));
    if (ci < 0 || R.used?.["cmb:" + ci]) return { ok: false, done: ci >= 0 };
    const k = S.combos[ci];
    (R.used ||= {})["cmb:" + ci] = 1;
    if (k.make) { R.items = R.items.filter(x => x !== k.a && x !== k.b); R.items.push(k.make); E.noteItemOrigin(k.make); }
    if (k.then) { S.nodes.__combo = (S.combos || []).map(x => x.then || []); R.stack.push({ n: "__combo", p: [ci], i: 0 }); }
    E.sfx("item"); E.save();
    return { ok: true, make: k.make, then: !!k.then };
  };
  E.ui_recapHtml = (list) => {
    let ch = -1, out = "";
    for (const x of list) {
      if ((x.ch ?? 0) !== ch) { ch = x.ch ?? 0; out += `<div class="se-rch">${ch ? esc(E.nat({ en: "Chapter " + ch, vi: "Chương " + ch })) : esc(E.nat({ en: "Prologue", vi: "Mở đầu" }))}</div>`; }
      out += `<p class="se-rcp">${esc(E.nat(x.t))}</p>`;
    }
    return out;
  };
  E.hasRun = () => {
    const saved = store.get(KEY + ".r", null);
    // Ending metadata may belong to a chapter that has not been loaded yet.
    // Validate the ID after resume loads that chapter, without erasing it.
    return !!saved?.stack?.length || (typeof saved?.done === "string" && !!saved.done);
  };

  // ───────── giọng đọc (tạm: speechSynthesis; sau: file âm thanh soạn sẵn ở st.audio / char.voice) ─────────
  const F_RE = /female|zira|susan|hazel|samantha|karen|moira|tessa|libby|sonia|aria|jenny|emma|amy|serena|victoria|fiona|kate|ava|allison|hoaimy|\blinh\b|\bmai\b|\ban\b/i;
  const M_RE = /\bmale|david|mark|george|daniel|james|ryan|guy|alex|fred|tom\b|oliver|arthur|thomas|brian|christopher|eric|namminh|nam\b/i;
  let VOICES = [];
  const loadVoices = () => { try { VOICES = speechSynthesis.getVoices(); } catch {} };
  try { loadVoices(); speechSynthesis.onvoiceschanged = loadVoices; } catch {}
  const hash = s => { let x = 7; for (const c of String(s)) x = (x * 31 + c.charCodeAt(0)) >>> 0; return x; };
  E.hash = hash;
  const deviceCast = new Map();
  const deviceVoiceId = v => [v.voiceURI || "", v.lang || "", v.name || ""].join("|");
  function voicePool(lang, g) {
    const base = String(lang || "en").toLowerCase().split("-")[0];
    const all = VOICES.filter(v => v.lang?.toLowerCase().split("-")[0] === base);
    if (!all.length) return null;
    const re = g === "F" ? F_RE : M_RE, other = g === "F" ? M_RE : F_RE;
    const pool = all.filter(v => re.test(v.name)).length ? all.filter(v => re.test(v.name)) : all.filter(v => !other.test(v.name)).length ? all.filter(v => !other.test(v.name)) : all;
    return pool.sort((a, b) => deviceVoiceId(a).localeCompare(deviceVoiceId(b)));
  }
  function assignDeviceVoice(lang, g, seed) {
    const base = String(lang || "en").toLowerCase().split("-")[0], pool = voicePool(base, g);
    if (!pool?.length) return null;
    const key = base + "|" + (g || "M") + "|" + seed;
    const held = pool.find(v => deviceVoiceId(v) === deviceCast.get(key));
    if (held) return held;
    // Use the available voices before sharing one. A hash alone can collide
    // even when the device has enough distinct voices for the current cast.
    const counts = new Map();
    for (const [k, id] of deviceCast) if (k.startsWith(base + "|") && k !== key) counts.set(id, (counts.get(id) || 0) + 1);
    const min = Math.min(...pool.map(v => counts.get(deviceVoiceId(v)) || 0));
    const free = pool.filter(v => (counts.get(deviceVoiceId(v)) || 0) === min);
    const gb = free.filter(v => /GB|UK|British/i.test(v.lang + v.name));
    const candidates = base === "en" && gb.length ? gb : free;
    const picked = candidates[hash(seed) % candidates.length];
    deviceCast.set(key, deviceVoiceId(picked));
    return picked;
  }
  function pickVoice(lang, g, seed) {
    // Reserve recurring leads first so scene order does not change their voice.
    assignDeviceVoice(lang, G?.set?.g || "M", "me");
    assignDeviceVoice(lang, "M", "narr");
    if (S?.chars?.reed) assignDeviceVoice(lang, S.chars.reed.g || "F", "reed");
    return assignDeviceVoice(lang, g, seed);
  }
  E.voice = { busy: false, source: null, speaker: "", language: "", name: "", key: null };
  E.voice.status = () => ({ busy: E.voice.busy, source: E.voice.source, speaker: E.voice.speaker, language: E.voice.language, name: E.voice.name, key: E.voice.key });
  const voiceSource = data => { Object.assign(E.voice, { name: "", key: null }, data, { busy: true }); E.duck?.(true); E.emit("voice-source", E.voice.status()); };
  // Trong app: câu thứ tiếng đang học đọc bằng GIỌNG CHUNG của app (Enmi.say — theo Cài đặt → Âm thanh: tự chọn / giọng AI / Giọng nam ·
  //   Giọng nữ riêng, như truyện nhập vai); nhân vật thứ 2 cùng giới = giọng thứ 2. Câu tiếng khác (lời dẫn tiếng mẹ đẻ…) hoặc app từ chối
  //   → giọng máy trong khung như cũ.
  const nthOf = who => { if (who === "me") return 1; const g = S.chars[who]?.g || "M"; const same = Object.keys(S.chars).filter(k => !S.chars[k].hideInBook && (S.chars[k].g || "M") === g); return same.indexOf(who) > 0 ? 2 : 1; };
  // GIỌNG ĐỌC SẴN (tools/games/_lib/story/voice.js → audio/*.mp3): art-css.js khai mỗi câu 1 lớp .au-<khoá>{background-image:url(audio/…)}
  //   (host Game SDK chỉ đổi đường dẫn trong HTML / CSS) → đọc url đã đổi qua getComputedStyle rồi phát. Khoá = băm(người nói | câu) như voice.js;
  //   lời "bạn" có 2 bản (me.F / me.M) theo giới tính người chơi. Chỉ thứ tiếng của bản ghi (S.voiceLang, mặc định en); tắt: Cài đặt → Giọng đọc sẵn.
  const recClean = t => String(t || "").replace(/\[\[|\]\]/g, "").replace(/\s+/g, " ").trim();
  E.recKey = (who, text) => hash(who + "|" + recClean(text)).toString(36);
  let probe = null, recAud = null, recHas = null;
  const recUrl = cls => {
    if (!probe) { probe = document.createElement("i"); probe.style.cssText = "position:absolute;width:0;height:0;overflow:hidden;pointer-events:none"; probe.hidden = true; document.body.append(probe); }
    probe.className = cls;
    const m = /url\(["']?(.*?)["']?\)/.exec(getComputedStyle(probe).backgroundImage || "");
    return m ? m[1] : null;
  };
  E.recHas = () => recHas ||= !!recUrl("au-has");
  const recPlay = (url, opts, done, generation) => {
    try { recAud?.pause(); } catch {}
    const a = recAud = new Audio(url);
    a.playbackRate = (opts.slow ? 0.75 : 1) * (G.set.vRate || 1);
    a.volume = opts.whisper ? 0.7 : 1;
    let fin = false; const end = ok => { if (fin) return; fin = true; if (generation === sayN) E.duck?.(false); done(ok); };
    E.duck?.(true);
    a.onended = () => end(true); a.onerror = () => end(false);
    a.play().catch(() => end(false));
  };
  let sayN = 0, resolveSay = null;
  E.say = (text, who, opts = {}) => new Promise(resolve => {
    if (opts.inner) who = "me";
    const n = ++sayN;
    resolveSay?.();
    // A missing recording must not leave the previous recorded character
    // talking underneath device speech. Muted lines also settle old speech.
    try { recAud?.pause(); } catch {}
    try { speechSynthesis.cancel(); } catch {}
    E.duck?.(false);
    let settled = false;
    const res = () => { if (settled) return; settled = true; if (resolveSay === res) resolveSay = null; if (n === sayN) { E.voice.busy = false; E.duck?.(false); } resolve(); };
    resolveSay = res;
    if ((!(opts.narr ? G.set.vNarr : G.set.vDlg) && !opts.force) || E.auto || !String(text || "").replace(/\[\[|\]\]/g, "").trim()) { try { SDK()?.hush?.().catch(() => {}); } catch {} return res(); }
    const ch = who === "me" ? { g: G.set.g } : S.chars[who] || { g: "M" };
    const lang = opts.lang || E.langOf(ch);
    const sdk = SDK();
    if (G.set.vRec !== false && lang === (S.voiceLang || "en") && E.recHas()) {
      const w = opts.inner ? "me." + (G.set.g === "F" ? "F" : "M") : opts.narr ? "narr" : who === "me" ? "me." + (G.set.g === "F" ? "F" : "M") : who, url = recUrl("au-" + E.recKey(w, text));
      if (url) {
        voiceSource({ source: "recorded", speaker: who, language: lang, key: E.recKey(w, text) });
        try { speechSynthesis.cancel(); } catch {}
        sdk?.hush?.().catch(() => {});
        return recPlay(url, opts, ok => (ok || n !== sayN ? res() : local(text, ch, lang, opts, res, who)), n);
      }
    }
    if (sdk?.say && (lang === E.L || lang === E.N)) {   // tiếng mẹ đẻ (lời dẫn) cũng qua app: giọng hệ điều hành
      voiceSource({ source: "host", speaker: who, language: lang });
      try { speechSynthesis.cancel(); } catch {}
      const rate = (ch.rate || 1) * (G.set.vRate || 1) * (opts.slow ? 0.72 : 1) * (opts.whisper ? 0.92 : 1);
      return sdk.say(String(text).replace(/\[\[|\]\]/g, ""), { g: ch.g || "M", n: nthOf(who), rate, lang }).then(r => (r?.ok || n !== sayN ? res() : local(text, ch, lang, opts, res, who))).catch(() => res());
    }
    sdk?.hush?.().catch(() => {});
    local(text, ch, lang, opts, res, who);
  });
  function local(text, ch, lang, opts, res, who = "") {
    try {
      speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(String(text).replace(/\[\[|\]\]/g, ""));
      const v = pickVoice(lang, ch.g, who);
      voiceSource({ source: "device", speaker: who, language: lang, name: v?.name || "" });
      if (v) u.voice = v;
      u.lang = v?.lang || (lang === "vi" ? "vi-VN" : "en-GB");
      u.rate = (ch.rate || 1) * (G.set.vRate || 1) * (opts.slow ? 0.72 : 1) * (opts.whisper ? 0.92 : 1);
      u.pitch = ch.pitch || 1;
      u.volume = opts.whisper ? 0.55 : 1;
      u.onend = u.onerror = () => res();
      speechSynthesis.speak(u);
    } catch { res(); }
  }
  E.hush = () => { sayN++; resolveSay?.(); E.voice.busy = false; E.duck?.(false); try { recAud?.pause(); } catch {} try { speechSynthesis.cancel(); } catch {} try { SDK()?.hush?.().catch(() => {}); } catch {} };

  // ───────── chữ có thể chạm (từ trong sổ / tra từ) ─────────
  E.words = (text, lang) => {
    if (lang !== E.L) return esc(String(text).replace(/\[\[|\]\]/g, ""));
    let i = 0, out = "";
    for (const part of String(text).split(/(\[\[[^\]]+\]\])/)) {
      if (!part) continue;
      const m = part.match(/^\[\[([^\]]+)\]\]$/);
      if (m) { out += `<span class="w gl" data-w="${esc(m[1].toLowerCase())}" style="--i:${i++}">${esc(m[1])}</span>`; continue; }
      for (const tok of part.split(/(\s+)/)) {
        if (!tok) continue;
        if (/^\s+$/.test(tok)) { out += tok; continue; }
        const core = tok.replace(/^[^\p{L}\p{N}']+|[^\p{L}\p{N}']+$/gu, "");
        const k = core.toLowerCase();
        const gl = S.words?.[k] ? " gl2" : "";
        out += core ? `<span class="w${gl}" data-w="${esc(k)}" style="--i:${i++}">${esc(tok)}</span>` : `<span class="w0" style="--i:${i++}">${esc(tok)}</span>`;
      }
    }
    return out;
  };

  // ───────── giao diện ─────────
  const UI_TXT = {
    tapNext: { en: "Tap to continue", vi: "Chạm để tiếp" },
    translate: { en: "Translate", vi: "Dịch" },
    hide: { en: "Hide", vi: "Ẩn" },
    log: { en: "Log", vi: "Nhật ký" },
    notebook: { en: "Case file", vi: "Hồ sơ" },
    flow: { en: "Story map", vi: "Sơ đồ nhánh" },
    settings: { en: "Settings", vi: "Cài đặt" },
    noMore: { en: "To be continued…", vi: "Còn tiếp…" },
    newItem: { en: "Added to your bag", vi: "Đã thêm vào túi" },
    newTruth: { en: "TRUTH UNCOVERED", vi: "SỰ THẬT MỚI" },
    items: { en: "Items", vi: "Đồ vật" },
    truths: { en: "Truths", vi: "Sự thật" },
    people: { en: "People", vi: "Nhân vật" },
    words: { en: "Words", vi: "Sổ từ" },
    you: { en: "You", vi: "Bạn" },
    cont: { en: "Continue", vi: "Tiếp tục" },
    newGame: { en: "New game", vi: "Chơi mới" },
    replayHere: { en: "Replay from here", vi: "Chơi lại từ đây" },
    locked: { en: "Not reached yet", vi: "Chưa tới" },
    unknown: { en: "Unexplored", vi: "Chưa khám phá" },
    trustHi: { en: "Trusts you", vi: "Tin bạn" },
    trustLo: { en: "Doubts you", vi: "Nghi ngờ bạn" },
    trustMid: { en: "Neutral", vi: "Bình thường" },
    intuition: { en: "Intuition", vi: "Trực giác" },
    save: { en: "Save word", vi: "Lưu từ" },
    saved: { en: "Saved", vi: "Đã lưu" },
    notInList: { en: "Full dictionary is available when you play inside Enmi.", vi: "Tra từ đầy đủ khi chơi trong app Enmi." },
    listen: { en: "Listen", vi: "Nghe" },
    close: { en: "Close", vi: "Đóng" },
    mode: { en: "Story language", vi: "Ngôn ngữ dẫn truyện" },
    m_imm: { en: "Immersion", vi: "Đắm chìm" }, m_imm_d: { en: "Everything in English. Tap Translate when stuck.", vi: "Toàn bộ bằng tiếng Anh. Bí thì bấm Dịch." },
    m_bi: { en: "Side by side", vi: "Song hành" }, m_bi_d: { en: "Narration in your language, characters speak English.", vi: "Lời dẫn tiếng Việt, nhân vật nói tiếng Anh." },
    m_easy: { en: "Easy", vi: "Dễ" }, m_easy_d: { en: "Simpler English, translation always shown, feedback after each translation.", vi: "Tiếng Anh dễ hơn, luôn hiện nghĩa, chấm ngay sau mỗi câu dịch." },
    voice: { en: "Voices", vi: "Giọng đọc" },
    on: { en: "On", vi: "Bật" }, off: { en: "Off", vi: "Tắt" },
    yourName: { en: "Your name", vi: "Tên của bạn" },
    gender: { en: "You are", vi: "Bạn là" }, male: { en: "Male", vi: "Nam" }, female: { en: "Female", vi: "Nữ" },
    start: { en: "Start", vi: "Bắt đầu" },
    menu: { en: "Menu", vi: "Menu" },
    restartConfirm: { en: "Start a new game? Truths, endings and the story map are kept.", vi: "Chơi lại từ đầu? Sự thật, kết thúc và sơ đồ nhánh vẫn được giữ." },
    endings: { en: "Endings", vi: "Kết thúc" },
    alwaysTr: { en: "Always translate", vi: "Luôn dịch" }, alwaysTr_d: { en: "Show the meaning under every line and choice.", vi: "Hiện nghĩa dưới mọi câu và lựa chọn." },
    trOn: { en: "Translation on", vi: "Đã bật luôn dịch" }, trOff: { en: "Translation off", vi: "Đã tắt luôn dịch" },
    shadow: { en: "Practise dialogue", vi: "Luyện nói hội thoại" }, shadow_d: { en: "Speak your selected dialogue. Actions continue directly; Skip plays the character's line.", vi: "Nói câu thoại đã chọn. Hành động thực hiện ngay; bấm Bỏ qua để nghe giọng nhân vật." },
    voice_d: { en: "Characters read their lines aloud.", vi: "Nhân vật đọc to lời thoại." },
    sound_d: { en: "Rain, sea, footsteps…", vi: "Mưa, sóng biển, tiếng bước chân…" },
    cast: { en: "Characters", vi: "Nhân vật" }, you: { en: "You", vi: "Bạn là ai" }, editMe: { en: "About you", vi: "Thông tin của bạn" }, done: { en: "Done", vi: "Xong" },
    g_lang: { en: "Language", vi: "Ngôn ngữ" }, g_voice: { en: "Voices", vi: "Giọng đọc" }, g_sound: { en: "Sound", vi: "Âm thanh" }, g_speak: { en: "Speaking practice", vi: "Luyện nói" },
    o_narr: { en: "Narration in", vi: "Lời dẫn truyện bằng" }, o_narr_d: { en: "Characters always speak the language you're learning.", vi: "Nhân vật luôn nói thứ tiếng bạn đang học." },
    o_tr: { en: "Always translate", vi: "Luôn dịch" }, o_tr_d: { en: "Meaning under every line and choice.", vi: "Hiện nghĩa dưới mọi câu và lựa chọn." },
    o_vDlg: { en: "Read dialogue", vi: "Đọc lời hội thoại" }, o_vDlg_d: { en: "Characters read their lines aloud.", vi: "Nhân vật đọc to lời của mình." },
    o_vRec: { en: "Recorded voices", vi: "Giọng đọc sẵn" }, o_vRec_d: { en: "Prefer supplied recordings for dialogue and narration; otherwise use the device voice.", vi: "Ưu tiên giọng dựng sẵn cho thoại và lời dẫn; nếu không có, dùng giọng thiết bị." },
    o_vNarr: { en: "Read narration", vi: "Đọc lời dẫn truyện" }, o_vNarr_d: { en: "Narration and thoughts are read aloud too.", vi: "Đọc cả lời dẫn và suy nghĩ của bạn." },
    o_sfx: { en: "Sound effects", vi: "Hiệu ứng âm thanh" }, o_sfx_d: { en: "Taps, clues, new items…", vi: "Tiếng chạm, manh mối, nhận đồ vật…" },
    o_amb: { en: "Ambience", vi: "Âm thanh không khí" }, o_amb_d: { en: "Rain, waves, quiet rooms.", vi: "Mưa, sóng biển, tiếng phòng vắng." },
    o_shadow: { en: "Practise dialogue", vi: "Luyện nói hội thoại" }, o_shadow_d: { en: "Speak your selected dialogue. Actions continue directly; Skip plays the character's line.", vi: "Nói câu thoại đã chọn. Hành động thực hiện ngay; bấm Bỏ qua để nghe giọng nhân vật." }, chapters: { en: "Chapters & your path", vi: "Chương & đường đi" }, soon: { en: "Coming soon", vi: "Sắp ra mắt" }, opts: { en: "Options", vi: "Tuỳ chọn" },
    restart: { en: "Start over", vi: "Chơi lại từ đầu" },
    g_text: { en: "Text", vi: "Chữ" }, o_speed: { en: "Text speed", vi: "Tốc độ chữ" }, o_speed_d: { en: "Tap while text is appearing to show it all.", vi: "Chạm khi chữ đang hiện để hiện hết ngay." },
    sp_slow: { en: "Slow", vi: "Chậm" }, sp_mid: { en: "Normal", vi: "Vừa" }, sp_fast: { en: "Fast", vi: "Nhanh" }, sp_now: { en: "Instant", vi: "Hiện ngay" },
    ovNote: { en: "Every choice changes the story. Tap any word to look it up.", vi: "Mỗi lựa chọn rẽ câu chuyện sang hướng khác. Chạm vào từ bất kỳ để tra." },
  };
  E.UI_TXT = UI_TXT;
  let root, box, ui, stage, charsEl, top;
  const lineQ = { res: null, revealing: false, advancing: null };
  const linePointers = new Map(), lineClicks = new WeakMap();

  function build(host) {
    root = h(`<div class="se">
      <div class="se-stage">
        <div class="se-bgw"><div class="se-bgl"></div><div class="se-bgl"></div></div>
        <div class="se-fx"></div><div class="se-fog"></div><div class="se-light"></div>
        <div class="se-chars"></div>
        <div class="se-vig"></div><div class="se-spots"></div>
        <div class="se-loc"><i></i><b></b><small></small></div>
      </div>
      <div class="se-top">
        <button class="se-ib" data-a="menu" aria-label="${T("menu")}">${ICON.menu}</button>
        <div class="se-grp">
          <button data-a="trall" class="se-trall" aria-label="${T("alwaysTr")}">${ICON.tr}</button>
          <button data-a="log" aria-label="${T("log")}">${ICON.log}</button>
          <button data-a="book" aria-label="${T("notebook")}">${ICON.book}<i class="se-dot" hidden></i></button>
          <button data-a="flow" aria-label="${T("flow")}">${ICON.flow}</button>
        </div>
      </div>
      <div class="se-mem"></div>
      <div class="se-box" hidden>
        <div class="se-name"></div>
        <div class="se-txt"></div>
        <div class="se-sub" hidden></div>
        <div class="se-tools">${E.ui.translationButton(false, 'data-a="tr"')}<button data-a="re" aria-label="${T("listen")}">${ICON.spk}</button><span class="se-more">${ICON.next}</span></div>
      </div>
      <div class="se-ui"></div>
      <div class="se-card" hidden></div>
      <div class="se-sheet" hidden></div>
      <div class="se-toast"></div>
    </div>`);
    host.appendChild(root);
    box = $(".se-box", root); ui = $(".se-ui", root); stage = $(".se-stage", root); charsEl = $(".se-chars", root); top = $(".se-top", root);
    root.addEventListener("click", onClick);
    // A press begun on a closing beat belongs to that beat, even if its
    // release arrives after the next line has appeared.
    root.addEventListener("pointerdown", e => {
      if (linePointers.size > 8) linePointers.clear();
      linePointers.set(e.pointerId, { res: lineQ.res, run: R, epoch: gen, closing: !!lineQ.advancing });
    }, true);
    root.addEventListener("pointercancel", e => linePointers.delete(e.pointerId), true);
    root.addEventListener("click", e => {
      const owner = linePointers.get(e.pointerId);
      linePointers.delete(e.pointerId);
      if (e.detail && owner) lineClicks.set(e, owner);
    }, true);
    document.addEventListener("keydown", e => {
      if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey) return;
      // Held Enter on the native Continue button otherwise generates clicks
      // through its default action even when this listener ignores repeats.
      if (e.repeat) { if ((e.key === " " || e.key === "Enter") && e.target?.closest?.(".se-more")) e.preventDefault(); return; }
      // Native controls keep Enter/Space. Otherwise a keyboard user trying to
      // translate a line, open the notebook or edit text accidentally skips it.
      if (e.target?.closest?.("button,a,input,textarea,select,[contenteditable='true'],[role='button'],[role='link']")) return;
      if ((e.key === " " || e.key === "Enter") && lineQ.res && !$(".se-sheet:not([hidden]),.se-iv,.se-read:not([hidden]),.se-rev:not([hidden]),.se-pop,.se-card:not([hidden])", root)) { e.preventDefault(); advance(); }
    });
    // âm thanh chỉ được bật sau 1 lần chạm (luật trình duyệt)
    root.addEventListener("pointerdown", () => { if (ac() && ambWant !== ambK) E.amb(ambWant); }, { passive: true });
  }
  function onClick(e) {
    const a = e.target.closest("[data-a]")?.dataset.a;
    const w = e.target.closest(".w[data-w]");
    if (w && !lineQ.revealing) { e.stopPropagation(); return wordPop(w.dataset.w, w); }
    if (a === "tr") { e.stopPropagation(); const sb = $(".se-sub", box); sb.hidden = !sb.hidden || !sb.textContent; E.ui.updateTranslationButton($("[data-a=tr]", box), !sb.hidden); E.sfx("tap"); return; }
    if (a === "trall") { e.stopPropagation(); return E.ui.setTr(!G.set.tr, true); }
    if (a === "re") { e.stopPropagation(); if (lineQ.cur) E.say(lineQ.cur.speak, lineQ.cur.kind === "think" ? "me" : lineQ.cur.who || "narr", { lang: lineQ.cur.lang, force: true, whisper: lineQ.cur.whisper, narr:lineQ.cur.kind !== "say", inner:lineQ.cur.kind === "think" }); return; }
    if (a === "menu") return E.sfx("tap"), E.ui.menu();
    if (a === "log") return E.sfx("tap"), E.ui.logSheet();
    if (a === "book") return E.sfx("tap"), E.ui.book();
    if (a === "flow") return E.sfx("tap"), (E.ui.chapterFlow || E.ui.flowSheet)();
    const protectedUI = ".se-sheet,.se-rev,.se-read,.se-iv,.se-toast,.se-top,.se-pop,.se-detail-overlay";
    // Closing a sheet/receipt can detach the target before this bubbled click
    // reaches the reader. The original event path still identifies its UI;
    // do not let that same click also consume the next story line.
    const path = e.composedPath?.() || [];
    if (e.target.closest(protectedUI + ",.se-ui button,.se-ui .se-card2") ||
        path.some(el => el.matches?.(protectedUI)) ||
        (path.includes(ui) && path.some(el => el.matches?.("button,.se-card2")))) return;
    if (lineQ.res) advance(e);
  }
  async function advance(event) {
    const press = event && lineClicks.get(event);
    if (press && (press.closing || press.res !== lineQ.res || press.run !== R || press.epoch !== gen)) return;
    if (!lineQ.res || lineQ.advancing) return;
    if (lineQ.revealing) { box.classList.add("done"); lineQ.revealing = false; clearTimeout(lineQ.t); return; }
    const owner = { res: lineQ.res, run: R, epoch: gen };
    lineQ.advancing = owner;
    try {
      // The foreground picture owns its exit. Its promise removes the image
      // before the engine may start any side effects of the following step.
      await E.ui.finishLineVisual?.();
      if (lineQ.advancing !== owner || lineQ.res !== owner.res || R !== owner.run || gen !== owner.epoch) return;
      lineQ.res = null;
      E.ui.closeWordPop?.();
      $(".se-pop", root)?.remove();
      E.hush();
      owner.res();
    } finally { if (lineQ.advancing === owner) lineQ.advancing = null; }
  }
  E.ui.advanceLine = advance;
  E.haptic = k => { try { SDK()?.haptic?.(k || "LIGHT"); } catch {} };

  // A spoken choice can be committed without drawing another bubble. Only an
  // identical entry belonging to this run may be reused when Skip plays it.
  E.recordLine = ({ who = "", kind = "say", main, sub = "", lang = E.L }, logEntry) => {
    if (sub && String(sub).trim() === String(main).trim()) sub = "";
    const line = { who: kind === "say" ? who : "", kind, main, sub, lang };
    const reuse = logEntry && R.log.includes(logEntry) && Object.keys(line).every(k => line[k] === logEntry[k]);
    if (!reuse) {
      R.log.push(line);
      if (R.log.length > 300) R.log.splice(0, R.log.length - 300);
    }
    if (kind === "say") { R.last = { who, text: main, lang, sub }; if (who !== "me") E.meet(who); }
    return reuse ? logEntry : line;
  };
  // hiện 1 dòng (lời dẫn / suy nghĩ / lời thoại) → chờ chạm
  E.ui.line = ({ who = "", kind = "say", main, sub = "", lang = E.L, speak, tag = "", cls = "", whisper, on = "", pic, logEntry }) => new Promise(res => {
    clearTimeout(lineQ.t);
    // ẢNH HÀNH ĐỘNG (fx.js): pic = "act-…" → khung ảnh nhỏ trên hộp lời (soi đèn, mở thư, bắt tay…); không ghi = ảnh trước đó tan
    E.ui.pic?.(pic);
    E.emit("line", { who, kind, main, sub, lang });
    const ch = who === "me" ? { short: G.set.name, color: "var(--se-me)" } : S.chars[who];
    const talker = kind === "say" && who !== "me" ? who : "";
    // hộp lời chỉ trượt lên khi VỪA HIỆN (trước: trượt lại mỗi câu — hộp kính mờ lớn chuyển động = giật trên điện thoại)
    const fresh = box.hidden;
    box.hidden = false;
    box.className = "se-box k-" + kind + (who === "me" ? " me" : "") + (cls ? " " + cls : "") + (whisper ? " whisper" : "");
    const nm = $(".se-name", box);
    nm.hidden = kind !== "say";
    nm.innerHTML = kind === "say" ? `<i></i>${esc(E.cname(ch, true) || who)}${tag ? `<small>${esc(tag)}</small>` : ""}` : "";
    nm.style.setProperty("--c", ch?.color || "#ccc");
    $(".se-txt", box).innerHTML = E.words(main, lang);
    const sb = $(".se-sub", box);
    // bản dịch TRÙNG câu đang hiện (cùng ngôn ngữ / chưa có bản dịch) → không hiện
    if (sub && String(sub).trim() === String(main).trim()) sub = "";
    sb.textContent = String(sub || "").replace(/\[\[|\]\]/g, "");
    sb.hidden = !(sub && (G.set.tr || (mode() === "easy" && kind === "say")));
    E.ui.updateTranslationButton($("[data-a=tr]", box), !sb.hidden);
    $("[data-a=tr]", box).hidden = !sub;
    $("[data-a=re]", box).hidden = false;
    lineQ.cur = { speak: speak ?? main, who, lang, whisper, kind };
    // người đang nói bước lên, sáng lên; người khác lùi lại, tối đi — lời dẫn / suy nghĩ: mọi người cùng mờ nhẹ
    root.dataset.talk = talker ? "1" : kind === "say" ? "me" : "0";
    // sân khấu “focus” (kiểu Choices / Episode): chỉ người đang nói đứng giữa. Ai còn hiện khi KHÔNG ai nói (người dùng 29/10: lời dẫn mà vẫn
    //   hiện người nói trước = sai):
    //   · lời của bạn → người bạn đang nói chuyện (người vừa nói) · suy nghĩ ngay sau lời thoại → người đó (bạn đang nhìn họ)
    //   · lời dẫn → chỉ người truyện chỉ định (bước { n, on: "<mã>" }) hoặc người VỪA bước ra mà chưa ai nói (lời dẫn tả người đó); còn lại trống
    if (talker) { R.lastTalk = talker; R.talkN = R.log.length; R.fresh = ""; }
    const prevSay = R.log[R.log.length - 1]?.kind === "say";
    const inCast = id => id && R.cast[id] ? id : "";
    // người nói trước chỉ còn đứng sau khi ĐANG trao đổi (họ vừa nói trong 3 dòng gần nhất) — hết chuyện rồi (bạn độc thoại,
    //   lời dẫn chen giữa…) thì lui hẳn, không đứng mờ phía sau tới khi có người khác nói (người dùng 29/10)
    const recent = R.talkN != null && R.log.length - R.talkN <= 3;
    const hold = talker ? "" : on ? inCast(on) : kind === "say" && recent ? inCast(R.lastTalk) : kind === "think" && prevSay && recent ? inCast(R.lastTalk) : inCast(R.fresh);
    for (const el of charsEl.children) { el.classList.toggle("talk", el.dataset.id === talker); el.classList.toggle("hold", el.dataset.id === hold); }
    E.recordLine({ who, kind, main, sub, lang }, logEntry);
    // CHỮ HIỆN DẦN TỪNG KÝ TỰ kiểu visual novel (engine 3, người dùng 30/10): bọc từng ký tự trong <span class="c" style="--j">,
    //   dừng nhẹ sau dấu câu; chạm khi đang hiện = hiện hết ngay (lớp done), chạm lần nữa = câu sau. Từ tra cứu (.w) giữ nguyên bên ngoài.
    const n = G.set.speed === 0 ? 0 : typeify($(".se-txt", box));
    box.classList.remove("done");
    if (fresh) { box.classList.remove("in"); void box.offsetWidth; box.classList.add("in"); }
    lineQ.revealing = true;
    const dur = G.set.speed === 0 ? 0 : Math.min(12000, n * CPS / (G.set.speed || 1)) + 160;
    lineQ.t = setTimeout(() => { lineQ.revealing = false; box.classList.add("done"); }, dur);
    if (kind === "say") E.say(speak ?? main, who, { lang, whisper });
    // ĐỌC LỜI DẪN TRUYỆN (tuỳ chọn, mặc định tắt): lời dẫn + suy nghĩ, đúng thứ tiếng đang hiện
    else if ((kind === "n" || kind === "think") && G.set.vNarr) E.say(speak ?? main, kind === "think" ? "me" : "narr", { lang, narr: true, inner:kind === "think" });
    lineQ.res = res;
    if (E.auto) setTimeout(() => { if (lineQ.res !== res) return; lineQ.revealing = false; advance(); }, 5);
  });
  E.ui.hideBox = () => { box.hidden = true; };
  // ms / ký tự (≈ 25 ký tự / giây ở tốc độ Vừa) — Cài đặt → Tốc độ chữ: Chậm 0,7 · Vừa 1 · Nhanh 1,6 · Hiện ngay (speed 0 = không chạy chữ)
  const CPS = 40;
  function typeify(el) {
    let j = 0;
    const sp = G.set.speed || 1;
    el.style.setProperty("--cps", (CPS / sp).toFixed(1) + "ms");
    el.classList.add("ty");
    const walk = node => {
      for (const ch of [...node.childNodes]) {
        if (ch.nodeType === 3) {
          const txt = ch.nodeValue; if (!txt) continue;
          const frag = document.createDocumentFragment();
          for (const c of txt) {
            if (/\s/.test(c)) { frag.appendChild(document.createTextNode(c)); j++; continue; }
            const s = document.createElement("span"); s.className = "c"; s.style.setProperty("--j", j); s.textContent = c; frag.appendChild(s);
            j += /[.!?…。！？]/.test(c) ? 9 : /[,;:—，、]/.test(c) ? 4 : 1;
          }
          ch.replaceWith(frag);
        } else if (ch.nodeType === 1) walk(ch);
      }
    };
    walk(el);
    return j;
  }
  // “Luôn dịch” (nút trên thanh trên, như truyện nhập vai): bật = mọi lời có nghĩa hiện sẵn dưới câu + dưới lựa chọn
  E.ui.setTr = (on, tell) => {
    G.set.tr = !!on; saveG();
    top?.querySelector(".se-trall")?.classList.toggle("on", G.set.tr);
    const sb = box && $(".se-sub", box); if (sb && !box.hidden) sb.hidden = !(G.set.tr && sb.textContent);
    if (sb) E.ui.updateTranslationButton($("[data-a=tr]", box), !sb.hidden);
    root?.querySelectorAll(".se-chs small:not(.se-lh)").forEach(x => (x.hidden = !G.set.tr && mode() !== "easy"));
    root?.querySelectorAll("[data-reading-scope]").forEach(scope => readingScopes.get(scope)?.sync());
    root?.querySelectorAll("[data-reading-text]").forEach(text => {
      if (text.closest("[data-reading-scope]")) return;
      const primary = text.querySelector(":scope > [data-reading-primary]"), secondary = text.querySelector(":scope > [data-reading-native]");
      if (primary) primary.hidden = !!secondary && G.set.tr && text.dataset.readingCompact !== "false";
      if (secondary) secondary.hidden = !G.set.tr;
    });
    if (tell) { E.sfx("tap"); E.ui.toast(esc(T(G.set.tr ? "trOn" : "trOff")), 1400); }
  };
  // bảng thao tác: gắn data-m lên gốc để CSS đổi sân khấu theo cơ chế (khám phá / bản đồ → nhân vật lui ra)
  // bảng đang hiện CÙNG loại (vẽ lại sau mỗi lần chạm: chọn đoạn lời khai, điểm khám xét…) → thay nội dung TẠI CHỖ, giữ chỗ cuộn,
  //   không chạy lại hiệu ứng hiện bảng (trước: dựng lại cả bảng + trượt lên mỗi lần chạm = giật)
  E.ui.panel = (html, cls = "") => {
    const cur = ui.firstElementChild;
    if (cur && cur.dataset.cls === cls && ui.children.length === 1) { const y = cur.scrollTop; cur.querySelectorAll("[data-reading-scope]").forEach(scope => readingScopes.get(scope)?.dispose()); cur.innerHTML = html; cur.scrollTop = y; cur.classList.add("still"); return cur; }
    // bảng toàn màn (suy luận, biên bản, xem lại, bản đồ…) → thông báo / “… sẽ nhớ điều này” đang hiện tan ngay, không đè lên câu hỏi
    if (/^(deduce|caseboard|present|review|map|full)/.test(cls)) root.querySelectorAll(".se-t:not(.out),.se-rm:not(.out)").forEach(t => { t.classList.add("out"); setTimeout(() => t.remove(), 400); });
    E.ui.releaseReading(ui); ui.innerHTML = ""; const el = h(`<div class="se-panel ${cls}">${html}</div>`); el.dataset.cls = cls; ui.appendChild(el); root.dataset.m = cls.split(" ")[0] || ""; return el;
  };
  E.ui.clear = () => { E.ui.releaseReading(ui); ui.innerHTML = ""; root.dataset.m = ""; root.classList.remove("urgent"); };
  // thông báo giữ LÂU hơn (người dùng 29/10: đọc không kịp): ×1,6 thời gian truyện ghi, ít nhất 3,2 giây
  // tối đa 2 thông báo cùng lúc (người dùng 29/10: “toast lên rất nhiều”) — thêm cái thứ 3 thì cái cũ nhất tan ngay; trùng nội dung = bỏ
  E.ui.toast = (html, ms = 2200, cls = "") => {
    ms = ms < 2000 ? ms * 1.4 : Math.max(3200, ms * 1.6);
    const box2 = $(".se-toast", root), live = [...box2.children].filter(x => !x.classList.contains("out"));
    if (live.some(x => x.dataset.h === html)) return;
    if (/(^|\s)receipt(\s|$)/.test(cls)) {
      // Records remain in the casebook. Only their latest receipt needs to
      // occupy the scene; replacing it must not dismiss other notifications.
      for (const old of box2.querySelectorAll(":scope > .se-t.receipt")) old.remove();
      ms = Math.min(ms, 4200);
    } else while (live.length >= 2) { const o = live.shift(); o.classList.add("out"); setTimeout(() => o.remove(), 400); }
    const t = h(`<div class="se-t ${cls}">${html}</div>`);
    t.dataset.h = html;
    box2.appendChild(t);
    setTimeout(() => t.classList.add("out"), ms);
    setTimeout(() => t.remove(), ms + 400);
    return t;
  };
  // A new record is a small, readable receipt and an entry point to its details.
  // Buttons stop propagation so inspecting it never advances the current line.
  E.ui.itemNotice = id => {
    const it = S.items?.[id]; if (!it || E.auto) return;
    const isAccount = (it.recordType || it.kind) === "testimony";
    const heading = isAccount ? {en:"Account recorded",vi:"Đã ghi lời khai"} : {en:"Added to records",vi:"Đã thêm hồ sơ"};
    const el = E.ui.toast(`<div class="se-record-receipt-row"><button class="se-item-receipt" data-record-id="${esc(id)}">${E.itemArt(id,"t")}<span><small>${esc(E.nat(heading))}</small><b>${esc(E.nat(it.name))}</b><em>${esc(E.nat({en:"Open record",vi:"Mở hồ sơ"}))}</em></span><i aria-hidden="true">${ICON.right}</i></button><button class="se-record-dismiss" type="button" aria-label="${esc(E.nat({en:"Dismiss notification",vi:"Đóng thông báo"}))}">×</button></div>`,4200,"item receipt");
    if(el) el.onclick = e => { e.preventDefault(); e.stopPropagation(); if (e.target.closest(".se-record-dismiss")) { el.remove(); return; } if (!e.target.closest(".se-item-receipt")) return; el.remove(); E.hush(); E.ui.itemView(id); };
  };
  // Legacy, unawaited notifications never belong to a later dialogue/run.
  // Authored acquisitions use stage's owned, awaited reveal; manually opened
  // readers, dossiers and ordinary hints are deliberately outside this scope.
  E.ui.clearItemNotices = () => root?.querySelectorAll('.se-t.receipt').forEach(el => el.remove());
  E.on('line', E.ui.clearItemNotices);
  E.on('end', E.ui.clearItemNotices);
  const stopItemNotices = E.stop;
  E.stop = (...args) => { E.ui.clearItemNotices(); return stopItemNotices(...args); };
  E.ui.hintToast = (value, options = {}) => {
    root?.querySelectorAll(".se-t.hint-notice").forEach(el => el.remove());
    const text = typeof value === "string" ? value : E.nat(value), neutral = options.label === false;
    const el = E.ui.toast(`<div class="se-hint-notice"><span>${neutral ? "" : `<small>${esc(E.nat({en:"Hint",vi:"Gợi ý"}))}</small>`}<span>${esc(text)}</span></span><button type="button" data-dismiss-hint aria-label="${esc(E.nat(neutral ? {en:"Dismiss notification",vi:"Đóng thông báo"} : {en:"Dismiss hint",vi:"Đóng gợi ý"}))}">×</button></div>`, Math.min(6000, Math.max(2625, 1400 + text.length * 25)), "hint-notice");
    if (el) el.onclick = e => { e.stopPropagation(); if (e.target.closest("[data-dismiss-hint]")) { el.remove(); options.onDismiss?.(); } };
    return el;
  };
  // đang tải chương (gói album) — lớp mờ nhỏ giữa màn
  E.ui.loading = (ch, on) => {
    let el = root?.querySelector(".se-ld");
    if (!on) { el?.remove(); return; }
    if (!el) { el = h(`<div class="se-ld"><i></i><span></span></div>`); root.appendChild(el); }
    el.querySelector("span").textContent = E.nat({ en: `Downloading chapter ${ch}…`, vi: `Đang tải chương ${ch}…` });
  };
  // thẻ toàn màn (chương, sự thật, mốc thời gian): ms = 0 → chờ chạm
  let cancelCard = null;
  E.ui.cancelCard = () => cancelCard?.();
  E.ui.card = (html, ms = 2600, cls = "") => new Promise(res => {
    cancelCard?.();
    const c = $(".se-card", root);
    c.className = "se-card " + cls;
    c.innerHTML = html; c.hidden = false; c.onclick = null;
    let done = false, settled = false; const timers = [];
    const close = () => { if (settled) return; settled = true; timers.forEach(clearTimeout); c.onclick = null; c.hidden = true; c.className = "se-card"; if (cancelCard === close) cancelCard = null; res(); };
    cancelCard = close;
    const fin = () => { if (done || settled) return; done = true; c.classList.add("out"); const reduced = globalThis.matchMedia?.("(prefers-reduced-motion: reduce)").matches; timers.push(setTimeout(close, reduced ? 0 : 350)); };
    timers.push(setTimeout(() => { if (!settled) c.onclick = fin; }, 450));
    if (E.auto) timers.push(setTimeout(fin, 5)); else if (ms) timers.push(setTimeout(fin, ms));
  });
  const nativeEffectTimers = new Map();
  E.ui.clearNativeEffects = () => { for(const timer of nativeEffectTimers.values())clearTimeout(timer);nativeEffectTimers.clear();for(const cls of [...root.classList])if(cls.startsWith('fx-'))root.classList.remove(cls); };
  E.ui.fx = k => { clearTimeout(nativeEffectTimers.get(k));root.classList.remove("fx-" + k); void root.offsetWidth; root.classList.add("fx-" + k); nativeEffectTimers.set(k,setTimeout(() => {root.classList.remove("fx-" + k);nativeEffectTimers.delete(k);}, 1000)); if (k === "shake") E.haptic("MEDIUM"); };
  E.ui.urgent = on => root.classList.toggle("urgent", !!on);

  // ───────── CẢNH: 2 lớp nền thay nhau (mờ dần), hiện từ nhoè → rõ, máy quay trôi chậm (Ken Burns) ─────────
  // Ảnh: CSS class im-<tên> trong art.css (host Game SDK chỉ đổi đường dẫn trong HTML/CSS, không đổi chuỗi trong JS);
  // chưa có ảnh → tranh tạm TIQ_ART[kind] nằm dưới.
  // bgKey = thứ ĐANG hiện ở lớp nền ("s:<cảnh>" | "c:<tranh>") — trước đây so R.scene: tranh minh hoạ (cg) xong quay về cảnh cũ
  //   thì coi là “cùng cảnh” nên KHÔNG thay lớp → tranh cũ đọng lại làm nền (vào / ra điểm khám xét bị đổi nền, bậc thang tối lấy ảnh thi thể…)
  let bgKey = "";
  // ẢNH NỀN SẴN SÀNG trước khi chuyển (người dùng 30/10: nền cũ hiện thêm một lúc rồi mới đổi vì ảnh mới chưa tải / giải mã):
  //   lấy url từ class im-… (art.css), tải + decode; chờ tối đa 450 ms rồi chuyển dù chưa xong · E.preloadImg(cls) tải trước nền sắp tới
  const imgReady = new Set();
  const urlOf = el => { const m = /url\(["']?([^"')]+)/.exec((el && getComputedStyle(el).backgroundImage) || ""); return m ? m[1] : ""; };
  const loadUrl = u => new Promise(r => { if (!u || imgReady.has(u)) return r(); const im = new Image(); im.onload = () => { imgReady.add(u); (im.decode ? im.decode() : Promise.resolve()).catch(() => {}).then(r); }; im.onerror = () => r(); im.src = u; });
  const waitImg = el => { const u = urlOf(el); if (!u || imgReady.has(u)) return Promise.resolve(); return Promise.race([loadUrl(u), new Promise(r => setTimeout(r, 450))]); };
  E.preloadImg = cls => { try { const d = document.createElement("i"); d.className = cls; d.style.cssText = "position:absolute;width:1px;height:1px;opacity:0;pointer-events:none"; document.body.appendChild(d); const u = urlOf(d); d.remove(); loadUrl(u); } catch {} };
  let layerTok = 0, visibleBgKey = "", pendingLayer = null;
  // An inactive buffer must be paint-free before it is reused. Otherwise its
  // previous opacity transition can expose the next bitmap before decode.
  const layerRetireTimers = new WeakMap();
  E.ui.retireLayer = el => {
    if (!el || el.classList.contains("on")) return;
    clearTimeout(layerRetireTimers.get(el));layerRetireTimers.delete(el);
