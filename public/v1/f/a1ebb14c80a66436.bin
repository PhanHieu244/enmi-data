      { act: { kind: "hold", r: "c6_last_line", hold: 700, prompt: L("Hold to add the new reading", "Giữ để ghi số đo mới"), sfx: "tap" } },
      { read: { paper: "log", hand: "print", title: L("The next line", "Dòng kế tiếp"), lines: [
