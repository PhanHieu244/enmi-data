.se .se-truth-row>.se-record-chevron{width:20px;height:24px;background:none;box-shadow:none;border:0;border-radius:0}
.se .se-record-modal{z-index:171;padding:max(12px,env(safe-area-inset-top)) 12px max(12px,env(safe-area-inset-bottom))}
.se .se-record-modal .se-record-detail{position:relative;display:flex;flex-direction:column;align-items:stretch;gap:12px;box-sizing:border-box;width:min(520px,100%);max-width:520px;max-height:calc(100dvh - 28px);overflow:auto;overscroll-behavior:contain;padding:16px;text-align:left;border:1px solid #cdb47655;border-radius:16px;background:#172220;color:var(--se-fg,#eee6d2);box-shadow:0 16px 70px #0009}
.se .se-record-detail-tools{position:sticky;top:-16px;margin:-16px -16px 0;padding:6px 8px;background:#172220;z-index:2;border-bottom:1px solid #cdb47626}
