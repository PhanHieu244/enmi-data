      if (value.talk) talk(value.talk, scopes, [...path, "talk"]);
      stack.delete(value);
    }
    function talk(ref, scopes, path) { const spec = typeof ref === "string" ? S.talks?.[ref] : ref; if (!spec) return; generic(spec, spec.location ? new Set([E.locationOf(spec.location)]) : scopes, path); }
    function place(ref, scopes, path) {
      const spec = typeof ref === "string" ? S.places?.[ref] : ref; if (!spec) return scopes;
      const id = spec.location || (typeof ref === "string" ? ref : spec.id) || path.slice(0, -1).join(".");
      const location = new Set([E.locationOf(id)]);
      generic(spec, location, path); return location;
    }
    function sequence(list, initial, path) {
      if (!Array.isArray(list)) return initial;
      let scopes = new Set(initial);
      for (const [i, step] of list.entries()) {
        if (!step || typeof step !== "object") continue;
        const at = [...path, i], scene = typeof step.bg === "string" ? step.bg : typeof step.scene === "string" ? step.scene : null;
        if (scene) scopes = new Set([E.locationOf(scene)]);
        if (step.explore?.location) scopes = new Set([E.locationOf(step.explore.location)]);
        if (step.place) scopes = place(step.place, scopes, [...at, "place"]);
        if (step.talk) talk(step.talk, scopes, [...at, "talk"]);
