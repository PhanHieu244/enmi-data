.se .se-bookpane .se-itc{display:flex;flex-direction:row;align-items:center;gap:12px;min-height:64px;padding:9px 10px;border:1px solid #b7aa7833;border-radius:10px;background:#b7aa7807;color:inherit}
.se .se-bookpane .se-itc>.se-ia{width:46px;height:50px;flex:0 0 46px}
.se .se-bookpane .se-itc>b{flex:1;min-width:0;font:600 14px/1.4 var(--se-sans,system-ui,sans-serif)}
.se .se-record-chevron{display:grid;place-items:center;flex:0 0 20px;width:20px;height:24px;color:#bdc8be;opacity:.7}
.se .se-record-chevron svg{width:17px;height:17px}
.se .se-person-row,.se .se-truth-row{width:100%;align-items:center;text-align:left;cursor:pointer;color:inherit;background:none;border:0;border-bottom:1px solid var(--se-line);border-radius:0;font:14px/1.4 var(--se-sans,system-ui,sans-serif)}
.se .se-person-row{gap:11px;padding:10px 0;min-height:76px}
