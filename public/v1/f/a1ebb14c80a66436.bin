for(const companion of ['alone','leo','helen','callum']){
  const dunes=base([{n:'c5_dunes',p:[],i:11},{n:'c5_dunes',p:[10,companion==='alone'?'then':'else'],i:0}]);
  dunes.f.dunes_with=companion;dunes.ch=5;
