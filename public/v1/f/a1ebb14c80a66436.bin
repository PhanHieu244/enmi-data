  endings: {
    c1_end: { ch: 1, title: { en: "Low Water", vi: "Nước ròng" },
      sum: { en: "The bell has rung. The road is still dry. Tom Ashby is waiting at ten.", vi: "Chuông đã rung. Con đường vẫn khô. Tom Ashby hẹn bạn lúc mười giờ." },
      text: { en: "Ten to nine. The causeway is closed, and nobody leaves the island tonight — not you, not whoever wrote 'T.A.' Tom Ashby has asked you to his cottage at ten. Outside, between the black posts, the road is still bone dry.", vi: "Chín giờ kém mười. Đường ngầm đã đóng, đêm nay không ai rời đảo được — cả bạn lẫn người đã ký “T.A.”. Tom Ashby hẹn bạn tới nhà lúc mười giờ. Bên ngoài, giữa hai hàng cọc đen, con đường vẫn khô rang." },
      next: "c2_open", nextTitle: { en: "Chapter 2", vi: "Chương 2" } },
  },
});
// BETWEEN TIDES — CHƯƠNG 2: NGỌN ĐÈN TRONG CHÒI (21:00 → 22:55). Văn: ../../GiuaHaiConNuoc-truyen-ch2.md (đường chính + Nhánh rẽ).
// Quyết định: at_harbour (quầy / bến, hội tụ 22:00 ở nhà Tom) · took_draft (lấy / để bản nháp) · told_leo ("full" → lên xuồng, leo +1 / "few" → chờ ở dốc bến).
// Trao: draft (nếu lấy) · flask · vial. KHÔNG đặt p_not_suicide ở đây (Ch3 mới đặt). Không trao sự thật nào.
// Cờ Ch1 được đọc: told_nell · held_bottle · fergus (mua cho Fergus nửa vại) · climbed_box · leo_id.
// Giờ trên màn hình theo dòng thời gian gốc §4 (dùng { clock } vì giờ của cảnh lantern/harbour/box trong story.js là giờ Ch1).

// Bản nháp trong lò — dùng ở điểm “Bếp lò” và lần chót trước khi rời nhà (nếu người chơi chưa chạm vào lò).
const C2_STOVE = () => [
  { n: { en: "The stove is still warm. In the [[grate]] there is a curl of burnt paper, one corner still white.", vi: "Bếp lò vẫn còn ấm. Trong lò có một mẩu giấy cháy quăn lại, một góc vẫn còn trắng." } },
  { n: { en: "…the ring… your mother… low water on the 14th… told the family today…", vi: "…the ring… your mother… low water on the 14th… told the family today… — …chiếc nhẫn… mẹ cháu… nước ròng ngày 14… hôm nay đã nói với gia đình…" } },
  { n: { en: "The same hard capitals as your note. Different words. Someone tried to write it more than once.", vi: "Vẫn nét chữ in hoa ấn mạnh như tờ giấy của bạn. Nhưng câu chữ khác. Có người đã viết đi viết lại lá thư ấy." } },
  { choice: [
    { en: "(Take it.)", vi: "(Lấy theo.)", set: { took_draft: true }, then: [
      { n: { en: "You fold the burnt half-letter into your pocket. The paper is still warm.", vi: "Bạn gấp nửa lá thư cháy dở bỏ vào túi. Tờ giấy vẫn còn ấm." } },
      { item: "draft" } ] },
    { en: "(Leave it.)", vi: "(Để lại.)", set: { took_draft: false }, then: [
      { n: { en: "You leave it where it is.", vi: "Bạn để nó lại chỗ cũ." } },
      { note: { en: "Burnt draft in Tom's stove: '…the ring… your mother… low water on the 14th… told the family today…'", vi: "Bản nháp cháy trong lò nhà Tom: “…the ring… your mother… low water on the 14th… told the family today…”" } } ] },
  ], prompt: { en: "The burnt draft", vi: "Bản nháp cháy dở" } },
];

