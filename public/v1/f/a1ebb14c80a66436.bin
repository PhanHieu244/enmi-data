.se .se-reading-toggle{display:inline-flex;align-items:center;justify-content:center;flex:none;min-width:44px;min-height:44px;padding:10px;border:1px solid #b7aa7852;border-radius:10px;background:#b7aa7810;color:var(--se-fg,#eee6d2);font:600 12px/1.2 var(--se-sans,system-ui,sans-serif);cursor:pointer;touch-action:manipulation}
.se .se-reading-toggle:focus-visible{outline:2px solid var(--se-ac,#d6b878);outline-offset:2px}
