    const applyFrame = (dx, dy) => { E._frame = { img, dx, dy }; for (const L of layers) { L.style.setProperty("--fx", dx + "px"); L.style.setProperty("--fy", dy + "px"); E.syncImagePlanes(L); } scheduleFocus(); };
