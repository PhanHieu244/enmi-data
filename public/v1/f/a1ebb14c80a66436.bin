if (!['capture', 'refresh'].includes(mode) || !input || !output) throw Error('Usage: bt-refresh-save-map.cjs capture PREVIOUS_GAME_DIR LINEAGE_JSON | refresh LINEAGE_JSON CURRENT_GAME_DIR');
