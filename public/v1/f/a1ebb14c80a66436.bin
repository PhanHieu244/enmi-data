  },
  recap: [
    { ch: 2, t: { en: "At nine Fergus filled Tom's flask from the TOM bottle. 'Fill it. Long night.' Tom went home with Skerry; Callum left for the buoys.", vi: "Chín giờ, Fergus rót đầy bình của Tom từ chai TOM. “Rót đầy vào. Đêm nay dài.” Tom về cùng Skerry; Callum ra phao." } },
    { ch: 2, if: s => s.f.at_harbour === false, t: { en: "You stayed at the bar. Callum looked in; Nell went down to the cellar for a barrel and the hatch banged shut; a car stopped by the phone box at the porch.", vi: "Bạn ở lại quầy. Callum ghé vào; Nell xuống hầm thay thùng bia, nắp hầm đóng sầm; một chiếc xe dừng cạnh bốt điện thoại ở hiên quán." } },
    { ch: 2, if: s => s.f.at_harbour === true, t: { en: "You went down to the harbour and sat with Mrs Dodd. You saw Tom's lights go out on the road, Callum's boat go out, and a lamp swinging in the middle of the causeway.", vi: "Bạn xuống bến, ngồi với bà Dodd. Bạn thấy đèn xe Tom ra đường ngầm, thuyền Callum ra khơi, và một ngọn đèn đung đưa giữa đường ngầm." } },
    { ch: 2, when: "c2_cottage", t: { en: "At ten Tom's front door was open and Skerry was shut in, howling. His medicine cabinet had three sealed ampoules — and a clean ring where a bottle used to stand.", vi: "Mười giờ, cửa nhà Tom để ngỏ, Skerry bị nhốt bên trong, tru lên. Tủ thuốc có ba ống còn niêm phong — và một vòng sạch nơi trước kia đặt một cái lọ." } },
    { ch: 2, if: s => s.f.took_draft === true, t: { en: "You took the half-burnt draft from Tom's stove. Leo doesn't know.", vi: "Bạn đã lấy bản nháp cháy dở trong lò nhà Tom. Leo không biết." } },
    { ch: 2, if: s => s.f.took_draft === false, t: { en: "You left the half-burnt draft in Tom's stove.", vi: "Bạn để bản nháp cháy dở lại trong lò nhà Tom." } },
    { ch: 2, if: s => s.f.told_leo === "full", t: { en: "You told Leo about Tom's illness and the missing medicine. He took you out on Callum's boat to the box.", vi: "Bạn kể với Leo về bệnh của Tom và chỗ thuốc bị thiếu. Anh đưa bạn lên thuyền Callum ra chòi." } },
    { ch: 2, if: s => s.f.told_leo === "few", t: { en: "You only told Leo that Tom wasn't home. You waited on the slipway and watched who went up to the Lantern: Gideon, then Nell, then Fergus.", vi: "Bạn chỉ nói với Leo là ông Tom không có nhà. Bạn chờ ở dốc bến và thấy ai lên quán: Gideon, rồi Nell, rồi Fergus." } },
    { ch: 2, when: "c2_slip", t: { en: "Tom was dead in the refuge box. A new soot line on the wall: 21:44 — 0.6 U.", vi: "Tom đã chết trong chòi trú nạn. Trên vách có một dòng muội mới: 21:44 — 0.6 U." } },
    { ch: 2, when: "c2_slip", t: { en: "On the slipway Helen smelled the flask: 'Sweet. Like medicine.' In Tom's sooty pocket, an empty Oramorph bottle — perfectly clean.", vi: "Trên dốc bến, Helen ngửi bình rượu: “Ngọt. Như mùi thuốc.” Trong túi áo lem muội của Tom có một lọ Oramorph rỗng — sạch bóng." } },
  ],
  flow: [
    { ch: 2, row: 0, id: "c2_open", kind: "cp", scene: "lantern", label: { en: "Nine o'clock", vi: "Chín giờ" }, sum: { en: "Fergus fills Tom's flask. Tom goes home.", vi: "Fergus rót đầy bình cho Tom. Tom về." } },
    { ch: 2, row: 1, kind: "opt", key: "at_harbour", val: false, label: { en: "Stay at the bar", vi: "Ở lại quầy" }, sum: { en: "Callum looks in. Nell goes down the cellar. A car at the phone box.", vi: "Callum ghé vào. Nell xuống hầm. Một chiếc xe ở bốt điện thoại." }, hint: { en: "Tom has gone home. Callum has gone to the buoys.", vi: "Tom đã về. Callum đã ra phao." } },
    { ch: 2, row: 1, kind: "opt", key: "at_harbour", val: true, label: { en: "Go down to the harbour", vi: "Xuống bến" }, sum: { en: "Mrs Dodd counts the boats. Lights on the causeway.", vi: "Bà Dodd đếm thuyền. Những ngọn đèn trên đường ngầm." }, hint: { en: "Tom has gone home. Callum has gone to the buoys.", vi: "Tom đã về. Callum đã ra phao." } },
    { ch: 2, row: 2, id: "c2_bar", kind: "cp", scene: "lantern", label: { en: "The bar", vi: "Quầy" }, sum: { en: "Who comes, who goes, who goes down.", vi: "Ai tới, ai đi, ai xuống hầm." } },
    { ch: 2, row: 2, id: "c2_harbour", kind: "cp", scene: "harbour", label: { en: "The harbour bench", vi: "Ghế ở bến" }, sum: { en: "Two sets of headlights. One small lamp.", vi: "Hai cặp đèn pha. Một ngọn đèn nhỏ." } },
    { ch: 2, row: 3, id: "c2_cottage", kind: "cp", scene: "cottage", label: { en: "The keeper's cottage", vi: "Nhà người gác đường" }, sum: { en: "Ten o'clock. The door is open.", vi: "Mười giờ. Cửa để ngỏ." } },
    { ch: 2, row: 4, kind: "opt", key: "took_draft", val: true, label: { en: "Take the draft", vi: "Lấy bản nháp" }, sum: { en: "It's in your pocket. Leo doesn't know.", vi: "Nó nằm trong túi bạn. Leo không biết." }, hint: { en: "A burnt letter in the stove.", vi: "Một lá thư cháy trong lò." } },
    { ch: 2, row: 4, kind: "opt", key: "took_draft", val: false, label: { en: "Leave the draft", vi: "Để bản nháp lại" }, sum: { en: "You only remember the words.", vi: "Bạn chỉ nhớ những dòng chữ." }, hint: { en: "A burnt letter in the stove.", vi: "Một lá thư cháy trong lò." } },
    { ch: 2, row: 5, id: "c2_leo", kind: "cp", scene: "causeway", label: { en: "Leo at the causeway", vi: "Leo ở đầu đường ngầm" }, sum: { en: "A lamp in the box. A road under water.", vi: "Ngọn đèn trong chòi. Con đường ngầm dưới nước." } },
    { ch: 2, row: 6, kind: "opt", key: "told_leo", val: "full", label: { en: "Tell him everything", vi: "Kể hết" }, sum: { en: "Leo takes you out on the boat.", vi: "Leo đưa bạn lên thuyền." }, hint: { en: "Leo is watching the box.", vi: "Leo đang nhìn về phía chòi." } },
    { ch: 2, row: 6, kind: "opt", key: "told_leo", val: "few", label: { en: "Tom isn't home", vi: "Ông Tom không có nhà" }, sum: { en: "You wait on the slipway and watch who goes up the lane.", vi: "Bạn chờ ở dốc bến và nhìn ai đi lên con đường làng." }, hint: { en: "Leo is watching the box.", vi: "Leo đang nhìn về phía chòi." } },
    { ch: 2, row: 7, id: "c2_boat", kind: "cp", scene: "boat", label: { en: "The box", vi: "Cái chòi" }, sum: { en: "Up the channel to the lamp.", vi: "Theo kênh tới ngọn đèn." } },
    { ch: 2, row: 7, id: "c2_wait", kind: "cp", scene: "harbour", label: { en: "The slipway", vi: "Dốc bến" }, sum: { en: "Gideon, Nell, Fergus — up the lane and back.", vi: "Gideon, Nell, Fergus — lên con đường làng rồi về." } },
    { ch: 2, row: 8, id: "c2_slip", kind: "cp", scene: "harbour", label: { en: "Five to eleven", vi: "Mười một giờ kém năm" }, sum: { en: "Sweet whisky. A clean bottle.", vi: "Whisky ngọt. Một cái lọ sạch bóng." } },
    { ch: 2, row: 9, id: "c2_end", kind: "end", label: { en: "The Lamp in the Box", vi: "Ngọn đèn trong chòi" } },
  ],
  nodes: {
    // ── 21:00 QUẦY: Fergus rót đầy bình, khoảnh khắc với Tom, Callum “Buoys.” → quầy / bến
    c2_open: [
      { set: { goal: "cottage" } },   // Giữ mục tiêu hẹn gặp Tom cho đến khi chuyển sang cứu hộ.
      { cp: "c2_open" },
      { title: { ch: 2, en: "The Lamp in the Box", vi: "Ngọn đèn trong chòi" } },
      { bg: "lantern" }, { amb: "room" }, { mood: "warm" }, { clock: "21:00" }, { hide: "*" },
      { n: { en: "Nine o'clock.", vi: "Chín giờ." } },
      { show: "nell", at: "r" },
      { n: { en: "At the far end of the bar, Nell is pulling a pint for someone.", vi: "Ở đầu kia quầy, Nell đang kéo vòi rót bia cho ai đó." }, on: "nell" },
      { if: s => s.f.told_nell, then: [
        { n: { en: "She looks up and finds you, and smiles. Since you told her who you are, your cup has not been empty once.", vi: "Bà ngẩng lên, tìm thấy bạn, mỉm cười. Từ lúc bạn nói mình là ai, tách trà của bạn chưa lần nào cạn." }, on: "nell" },
        { say: "nell", face: "smile", en: "Eat something later, pet. You've had nowt but tea.", vi: "Lát nữa ăn chút gì đi cháu. Cả tối cháu chỉ uống trà thôi." },
        { n: { en: "Fergus watches her say it. Then he watches you.", vi: "Fergus nhìn bà nói câu đó. Rồi ông nhìn sang bạn." } },
      ] },
      { hide: "nell" }, { show: "fergus", at: "l" },
      { n: { en: "Fergus leans over the bar, takes down the bottle marked TOM and unscrews the cap of a battered steel [[flask]].", vi: "Fergus nhoài người qua quầy, lấy chai dán nhãn TOM xuống, rồi vặn nắp một cái bình bẹt bằng thép móp méo." }, on: "fergus", pic: "act-flask" },
      { n: { en: "He pours slowly, the way you pour for a man whose hands won't.", vi: "Ông rót chậm rãi, kiểu người ta rót hộ một người mà đôi tay đã không còn nghe lời." }, on: "fergus" },
      { if: s => s.f.held_bottle, then: [
        { n: { en: "Fergus keeps his eyes on the bottle.", vi: "Fergus vẫn nhìn vào chai rượu." }, on: "fergus" },
        { say: "fergus", tone: "dry, pointed", en: "Still all there. No thanks to some.", vi: "Vẫn còn nguyên. Chả nhờ ai đâu nhé." },
      ], else: [
        { if: s => (s.f.fergus || 0) >= 1, then: [
          { n: { en: "He lifts the half you bought him, just a quarter of an inch.", vi: "Ông nhấc vại bia bạn mời lên, chỉ hơn nửa xăng-ti-mét." }, on: "fergus" },
          { say: "fergus", face: "smile", tone: "gruff, quietly grateful", en: "Ta.", vi: "Cảm ơn nhé." },
        ] },
      ] },
      { show: "tom", at: "c" }, { cam: "push", ms: 9000 },
      { cam: null },
      { say: "tom", en: "Fill it. Long night.", vi: "Rót đầy vào. Đêm nay dài." },
      { say: "fergus", en: "Aye.", vi: "Ờ." },
      { note: { en: "21:00 — Fergus filled Tom's flask to the top from the TOM bottle. 'Fill it. Long night.'", vi: "21:00 — Fergus rót đầy bình của Tom từ chai TOM. “Rót đầy vào. Đêm nay dài.”" } },
      { hide: "fergus" },
      { n: { en: "Tom slides the flask into his coat.", vi: "Tom nhét bình rượu vào túi áo khoác." }, on: "tom" },
      { n: { en: "His hand rests on his chest, over the inside pocket, the way you check for your keys.", vi: "Bàn tay ông áp lên ngực, chỗ túi trong, như người ta sờ xem chìa khóa còn không." }, on: "tom" },
      { n: { en: "On his way to the door he passes your table. This time he stops.", vi: "Trên đường ra cửa, ông đi ngang bàn bạn. Lần này ông dừng lại." }, on: "tom" },
      { n: { en: "He doesn't look at you. He looks at the window, at the road out there in the moonlight.", vi: "Ông không nhìn bạn. Ông nhìn ra cửa sổ, về phía con đường ngầm ngoài kia dưới trăng." }, on: "tom" },
      { say: "tom", face: "sad", en: "She wrote her numbers small. Like me.", vi: "Bà ấy viết số nhỏ lắm. Giống tôi." },
      { say: "tom", face: "soft", en: "I thought if we wrote things down carefully, we couldn't do much harm.", vi: "Tôi từng nghĩ cứ ghi chép cho cẩn thận thì sẽ chẳng gây hại được bao nhiêu." },
      {"say":"me","en":"What did you write down?","vi":"Ông đã ghi gì?"},
      {"n":{"en":"His hand presses the inside pocket again. He looks towards the bar.","vi":"Tay ông lại ép lên túi áo trong. Ông nhìn về phía quầy."}},
      {"say":"tom","en":"Ten o'clock. Don't let me put you off again.","vi":"Mười giờ nhé. Đừng để tôi lại lần lữa với cháu.","tone":"low, almost pleading"},
      { n: { en: "Then he buttons his coat to the throat.", vi: "Rồi ông cài khuy áo lên tận cổ." }, on: "tom" },
      { say: "tom", en: "Come on, Skerry.", vi: "Đi nào, Skerry." },
      { show: "tom", at: "c", face: "tired" },
      { n: { en: "At the door he puts a hand on the frame and stays there a moment. His eyes close, slowly, and open again.", vi: "Tới cửa, ông vịn một tay lên khung cửa, đứng yên một lúc. Mắt ông khép lại, chậm rãi, rồi mở ra." }, on: "tom" },
      { hide: "tom" }, { cam: null }, { sfx: "door" }, { sfx: "wind" },
      { n: { en: "The old grey dog gets up from under the table, stiff in the back legs, and follows him out.", vi: "Con chó già lông xám đứng dậy từ gầm bàn, hai chân sau cứng đơ, rồi theo ông ra ngoài." } },
      { n: { en: "The door lets the cold in behind them.", vi: "Sau lưng họ, hơi lạnh theo cửa lùa vào." } },
      { show: "callum", at: "c" },
      { n: { en: "At the end of the bar, Callum puts down his glass.", vi: "Ở cuối quầy, Callum đặt ly xuống." }, on: "callum" },
      { say: "callum", en: "Buoys.", vi: "Ra phao đây." },
      { n: { en: "He goes too.", vi: "Anh cũng đi." } },
      { hide: "callum" },
      { choice: [
        { tag: "direct", en: "(Stay at the bar.)", vi: "(Ở lại quầy.)", set: { at_harbour: false }, then: [{ go: "c2_bar" }] },
        { tag: "lead", en: "(Go down to the harbour.)", vi: "(Xuống bến.)", set: { at_harbour: true }, then: [{ go: "c2_harbour" }] },
      ], prompt: { en: "Nine o'clock. Tom has gone home.", vi: "Chín giờ. Tom đã về." } },
    ],

    // ── QUẦY 21:00–21:55: Callum ló vào, khách Alnwick, “Barrel.” nắp hầm, bốt điện thoại, vòi chảy lại, Fergus vào nhà vệ sinh
    c2_bar: [
      { cp: "c2_bar" },
      { bg: "lantern" }, { hide: "*" },
      { n: { en: "The pub thins out but doesn't empty. You stay against the wall, facing the clock above the bar.", vi: "Quán vãn dần nhưng chưa vắng hẳn. Bạn ngồi dựa tường, đối diện chiếc đồng hồ phía trên quầy." } },
      { show: "nell", at: "r" },
      { n: { en: "Nell works her way along the bar, drying glasses with a tea towel.", vi: "Nell lần dọc theo quầy, lấy khăn lau bếp lau từng chiếc ly." }, on: "nell" },
      { clock: "21:06" }, { sfx: "door" },
      { show: "callum", at: "l", face: "angry" }, { fx: "pulse" },
      { n: { en: "Just after nine the door opens again. Callum stands in the doorway with a face like thunder.", vi: "Chín giờ hơn một chút, cửa lại mở. Callum đứng ở ngưỡng cửa, mặt hằm hằm như sắp giông." }, on: "callum" },
      { n: { en: "Nell pours him a whisky without being asked. He drinks it standing up, puts the glass down too hard, and goes.", vi: "Nell rót cho anh một ly whisky, không đợi anh gọi. Anh đứng uống, đặt ly xuống mạnh tay, rồi đi." }, on: "callum" },
      { hide: "callum" },
      { n: { en: "A couple in matching anoraks come in from the cold and ask about a room. They're from Alnwick, and they've missed the tide.", vi: "Một cặp vợ chồng mặc áo gió giống hệt nhau từ ngoài lạnh bước vào, hỏi thuê phòng. Họ ở Alnwick, và họ đã lỡ con nước." } },
      { say: "nell", en: "Full tonight, pet. Try Mrs Dodd by the harbour. She does a bed.", vi: "Tối nay hết phòng rồi cháu ạ. Thử hỏi bà Dodd cạnh bến xem. Bà ấy có nhận khách trọ." },
      { n: { en: "They thank her and go.", vi: "Họ cảm ơn bà rồi đi." } },
      { clock: "21:08" },
      { n: { en: "Nell pulls a pint. The tap splutters: the barrel's nearly done.", vi: "Nell kéo vòi rót một vại. Vòi bia phì phì: thùng sắp cạn." }, on: "nell" },
      { say: "nell", en: "Barrel.", vi: "Thùng bia." },
      { hide: "nell" }, { sfx: "door" }, { fx: "shake" }, { wait: 600 },
      { n: { en: "She lifts the hatch behind the bar and goes down the cellar steps. The hatch bangs shut over her head.", vi: "Bà nhấc nắp hầm sau quầy rồi bước xuống bậc thang hầm. Nắp hầm đóng sầm lại trên đầu bà." }, pic: "act-hatch" },
      { n: { en: "The tap goes on coughing to itself for a while.", vi: "Cái vòi cứ khục khặc một mình thêm một lúc." }, pic: "act-hatch" },
      { n: { en: "Through the window, headlights come up the lane and stop beside the porch. The engine keeps running.", vi: "Qua cửa sổ, một cặp đèn pha chạy lên con đường làng rồi dừng cạnh hiên quán. Máy xe vẫn nổ." } },
      { sfx: "buzz" }, { cam: "pan-r", ms: 7000 },
      { n: { en: "Someone is in the [[phone box]] beside the porch, a dark shape with its back to the glass.", vi: "Có người trong bốt điện thoại cạnh hiên — một bóng đen quay lưng về phía ô kính." }, pic: "act-phonebox" },
      { n: { en: "The shape comes out and gets back into the car.", vi: "Bóng người bước ra, trở vào xe." } },
      { n: { en: "The car sits there a minute longer, headlights on the wall of the porch. Then it pulls away.", vi: "Chiếc xe còn đỗ đó thêm một phút, đèn pha rọi lên tường hiên. Rồi xe chạy đi." } },
      { cam: null },
      { n: { en: "Nobody in the bar looks up.", vi: "Trong quán không ai ngẩng lên." } },
      { clock: "21:16" },
      { show: "nell", at: "r" },
      { n: { en: "The tap stops coughing and runs clean. The hatch opens, and Nell is back behind the bar, pushing her sleeves up again.", vi: "Cái vòi thôi ho, chảy đều trở lại. Nắp hầm mở ra, và Nell đã về sau quầy, lại xắn tay áo lên." }, on: "nell", pic: "act-hatch-open" },
      { hide: "nell" },
      { n: { en: "Fergus eases himself off his stool and heads for the gents, one hand on every table he passes.", vi: "Fergus từ từ nhích khỏi ghế, đi về phía nhà vệ sinh, bàn nào đi ngang cũng chống một tay." } },
      { note: { en: "Bar, just after nine: Callum in, one whisky, out. Nell down the cellar ('Barrel.') — hatch shut over her. Meanwhile a car at the porch, someone in the phone box. Tap runs clean, Nell back up. Then Fergus to the gents.", vi: "Quầy, chín giờ hơn: Callum vào, một ly whisky, đi. Nell xuống hầm (“Barrel.”) — nắp hầm đóng lại. Trong lúc đó: một chiếc xe ở hiên, có người trong bốt điện thoại. Vòi chảy lại, Nell lên. Rồi Fergus vào nhà vệ sinh." } },
      { clock: "21:30" }, { title: { en: "9:30 P.M.", vi: "21:30" } }, { mood: "night" },
      { n: { en: "Half past nine. You look out of the window again.", vi: "Chín rưỡi. Bạn lại nhìn ra cửa sổ." } },
      { wait: 700 },
      { n: { en: "The near stretch has gone under. Farther out, pale patches of road still show between the posts.", vi: "Đoạn gần bờ đã ngập. Xa hơn, những vệt đường nhợt nhạt vẫn còn lộ giữa hàng cọc." } },
      { n: { en: "The black posts stand up out of the water in two lines, like the edges of something that isn't there any more.", vi: "Hai hàng cọc đen nhô lên khỏi mặt nước, như đường viền của một thứ không còn ở đó nữa." } },
      { clock: "21:40" }, { title: { en: "9:40 P.M.", vi: "21:40" } }, { cam: "push", ms: 8000 }, { fx: "spotlight" },
      { n: { en: "Twenty to ten. Far out in the middle, there is a light in the hut. Small and steady.", vi: "Mười giờ kém hai mươi. Xa tít ở giữa, trong chòi có một ngọn đèn. Nhỏ, và không lay động." } },
      { if: s => s.f.climbed_box, then: [
        { think: { en: "This afternoon you stood in that box. 06:01 — 0.5 U, neat as print on the wall.", vi: "Chiều nay bạn đã đứng trong cái chòi ấy. Dòng 06:01 — 0.5 U trên vách, ngay ngắn như chữ in." } },
      ] },
      { cam: null },
      { think: { en: "In and out in ten minutes, Leo said.", vi: "Đi có mười phút là về, Leo đã nói vậy." } },
      {"think":{"en":"You're still holding him to the appointment. Ten o'clock. As if keeping it could tell you he's safe.","vi":"Bạn vẫn bám vào giờ hẹn. Mười giờ. Như thể ông giữ hẹn thì bạn mới biết ông vẫn an toàn."}},
      { clock: "21:55" },
      { n: { en: "At five to ten you put your coat on. Nobody asks where you're going.", vi: "Mười giờ kém năm, bạn mặc áo khoác. Không ai hỏi bạn đi đâu." } },
      { go: "c2_cottage" },
    ],

    // ── BẾN 21:00–21:55: bà Dodd, Callum không áo phao, xe bác sĩ, đèn xe Tom, radio, hai cặp đèn, ngọn đèn đung đưa
    c2_harbour: [
      { cp: "c2_harbour" },
      { bg: "harbour" }, { amb: "sea" }, { mood: "night" }, { hide: "*" },
      { meet: "dodd" }, { show: "dodd", at: "l" },
      { n: { en: "Down at the harbour, old Mrs Dodd sits on her bench under the lamp, a rug over her knees.", vi: "Dưới bến, bà cụ Dodd ngồi trên chiếc ghế dưới ngọn đèn, tấm chăn phủ trên đầu gối." }, on: "dodd" },
      { say: "dodd", en: "Thirty year I've counted them out and in. Sit down, then.", vi: "Ba mươi năm nay bà ngồi đây đếm ra đếm vào. Ngồi xuống đi nào." },
      { choice: [
        { tag: "kind", en: "(Sit down beside her.)", vi: "(Ngồi xuống cạnh bà.)", add: { dodd: 1 }, then: [
          { n: { en: "The bench is cold. Mrs Dodd shares the rug without a word.", vi: "Chiếc ghế lạnh ngắt. Bà Dodd chia cho bạn nửa tấm chăn, không nói gì." }, on: "dodd" } ] },
        { tag: "polite", en: "(Stand by the rail.)", vi: "(Đứng cạnh lan can.)", then: [
          { n: { en: "You stay on your feet by the rail. Mrs Dodd goes back to her counting.", vi: "Bạn đứng cạnh lan can. Bà Dodd lại tiếp tục đếm." }, on: "dodd" } ] },
      ] },
      { clock: "21:08" },
      { show: "callum", at: "r" },
      { n: { en: "Just after nine, Callum comes down the slipway fast and starts getting his boat ready. He doesn't look at either of you.", vi: "Chín giờ hơn một chút, Callum đi nhanh xuống dốc bến và bắt đầu chuẩn bị thuyền. Anh chẳng nhìn bạn, cũng chẳng nhìn bà." }, on: "callum" },
      { say: "dodd", en: "Callum's in a mood.", vi: "Thằng Callum đang khó ở đấy." },
      { say: "dodd", en: "No [[lifejacket]] again. His father never wore one neither.", vi: "Lại không mặc áo phao. Bố nó ngày xưa cũng chả bao giờ mặc." },
      { hide: "callum" },
      { clock: "21:10" },
      { n: { en: "Headlights go up the lane behind you and stop, somewhere near the pub.", vi: "Sau lưng bạn, một cặp đèn pha chạy lên con đường làng rồi dừng lại, đâu đó gần quán." } },
      { say: "dodd", face: "smile", en: "That's the doctor's car gone up by the Lantern.", vi: "Xe của bà bác sĩ vừa lên chỗ The Lantern kia." },
      { clock: "21:13" },
      { n: { en: "Thirteen minutes past nine. At the island end, headlights flash twice and move onto the causeway.", vi: "Chín giờ mười ba. Ở đầu đường ngầm phía đảo, một cặp đèn pha nháy hai lần rồi chạy ra đường ngầm." } },
      { sfx: "splash" }, { sfx: "buzz" },
      { n: { en: "The Mairi Rose pulls away from the slipway. Callum's radio crackles across the water.", vi: "Chiếc Mairi Rose rời dốc bến. Tiếng bộ đàm của Callum lẹt xẹt vọng qua mặt nước." } },
      { say: "callum", phone: true, en: "Mairi Rose, going out to the pots by the box. Back in half an hour.", vi: "Mairi Rose đây, ra chỗ bẫy cua cạnh chòi. Nửa tiếng nữa về." },
      { clock: "21:16" },
      { n: { en: "For a minute or two, two sets of headlights: one heading out, one returning from the mainland. Then only one.", vi: "Trong một, hai phút, có hai cặp đèn pha: một cặp đi ra, một cặp từ đất liền về. Rồi chỉ còn một." } },
      { clock: "21:22" }, { cam: "pan-l", ms: 9000 },
      { n: { en: "Out in the middle, a small lamp swings from side to side. The headlights from the mainland crawl past it and don't stop.", vi: "Xa ngoài giữa đường, một ngọn đèn nhỏ đung đưa qua lại. Cặp đèn từ đất liền bò ngang qua nó, không dừng." }, pic: "act-lamp-wave" },
      { n: { en: "Beyond it, on the channel, the boat's light sits by the buoys. Then the lamp stops swinging.", vi: "Phía xa hơn, trên kênh, đèn thuyền đậu cạnh mấy cái phao. Rồi ngọn đèn nhỏ thôi đung đưa." } },
      { cam: null }, { wait: 800 }, { clock: "21:36" },
      { show: "callum", at: "r" },
      { n: { en: "At 21:36 Callum ties up again and walks past you without a word.", vi: "Lúc 21:36, Callum buộc thuyền lại rồi đi ngang qua bạn, không một lời." }, on: "callum" },
      { hide: "callum" },
      { say: "dodd", en: "That's him in.", vi: "Thế là nó về rồi." },
      { note: { en: "Harbour, with Mrs Dodd: Callum readied his boat, no lifejacket. The doctor's car went up by the Lantern. 21:13: headlights flashed twice and went out on the causeway. Callum's radio: 'going out to the pots by the box'. A car from the mainland crawled past a swinging lamp and didn't stop. Callum back at 21:36.", vi: "Ở bến, cùng bà Dodd: Callum chuẩn bị thuyền, không áo phao. Xe bác sĩ lên chỗ The Lantern. 21:13: đèn pha nháy hai lần rồi chạy ra đường ngầm. Radio Callum: “going out to the pots by the box”. Một chiếc xe từ đất liền bò ngang qua ngọn đèn đung đưa, không dừng. Callum về lúc 21:36." } },
      { clock: "21:40" }, { title: { en: "9:40 P.M.", vi: "21:40" } }, { cam: "push", ms: 8000 }, { fx: "spotlight" },
      { n: { en: "Twenty to ten. Far out in the middle, there is a light in the hut. Small and steady.", vi: "Mười giờ kém hai mươi. Xa tít ở giữa, trong chòi có một ngọn đèn. Nhỏ, và không lay động." } },
      { if: s => s.f.climbed_box, then: [
        { think: { en: "This afternoon you stood in that box. 06:01 — 0.5 U, neat as print on the wall.", vi: "Chiều nay bạn đã đứng trong cái chòi ấy. Dòng 06:01 — 0.5 U trên vách, ngay ngắn như chữ in." } },
      ] },
      { cam: null },
      { think: { en: "In and out in ten minutes, Leo said.", vi: "Đi có mười phút là về, Leo đã nói vậy." } },
      {"think":{"en":"You're still holding him to the appointment. Ten o'clock. As if keeping it could tell you he's safe.","vi":"Bạn vẫn bám vào giờ hẹn. Mười giờ. Như thể ông giữ hẹn thì bạn mới biết ông vẫn an toàn."}},
      { clock: "21:55" },
      { n: { en: "At five to ten you turn towards the cottage. Mrs Dodd counts you out, too.", vi: "Mười giờ kém năm, bạn quay về phía nhà Tom. Bà Dodd đếm cả bạn đi." } },
      { hide: "dodd" },
      { go: "c2_cottage" },
    ],

    // ── 22:00 NHÀ TOM: khám phá (Skerry, lò/bản nháp, máy bàn, tủ thuốc, cổng sau, cổng trước, cửa sổ) → Mắt thẩm định
    c2_cottage: [
      { cp: "c2_cottage" },
      { bg: "cottage" }, { clock: "22:00" }, { title: { en: "10:00 P.M.", vi: "22:00" } }, { amb: "hall" }, { mood: "night" }, { hide: "*" },
      { fx: "particles", kind: "dust", ms: 0 },
      { n: { en: "Ten o'clock.", vi: "Mười giờ." } },
      { n: { en: "The keeper's cottage stands where the island stops and the causeway begins. Stone steps lead up to the front door.", vi: "Nhà người gác đường nằm ở chỗ đảo hết và đường ngầm bắt đầu. Mấy bậc đá dẫn lên cửa trước." } },
      { n: { en: "The door is open.", vi: "Cửa trước để ngỏ." } },
      {"say":"me","en":"Tom? It's {name}. We said ten.","vi":"Ông Tom? Tôi là {name}. Mình hẹn lúc mười giờ mà."},
      {"n":{"en":"You knock on the open door and wait. No answer.","vi":"Bạn gõ lên cánh cửa đang mở và chờ. Không có tiếng đáp."}},
      { sfx: "wind" }, { fx: "shiver" },
      { n: { en: "Somewhere inside, behind another door, a dog is howling.", vi: "Đâu đó bên trong, sau một cánh cửa khác, một con chó đang tru." } },
      { cam: null },
      { explore: { goal: { en: "Check the dog, cabinet, phone and both entrances", vi: "Kiểm tra con chó, tủ thuốc, điện thoại và hai lối vào" }, need: 5, done: { en: "Go and find Leo", vi: "Đi tìm Leo" }, spots: [
        { id: "kitchen", x: 30, y: 40, clue: true, label: { en: "The kitchen door", vi: "Cửa bếp" }, then: [
          { sfx: "door" },
          { n: { en: "When you open the door, Skerry pushes past your legs, runs to the back door and stands there, whining at the wood.", vi: "Bạn vừa mở cửa, Skerry đã lách qua chân bạn, chạy tới cửa sau, đứng đó rên ư ử vào tấm gỗ." } },
          {"say":"me","en":"All right. Let's find him.","vi":"Được rồi. Mình đi tìm ông ấy nhé.","tone":"soft, to the dog"},
          { think: { en: "He went out of the pub with Tom at nine.", vi: "Lúc chín giờ, con chó theo Tom ra khỏi quán." } } ],
          again: [{ n: { en: "Skerry hasn't moved from the back door.", vi: "Skerry vẫn đứng nguyên ở cửa sau." } }] },
        { id: "stove", x: 22, y: 58, label: { en: "The stove", vi: "Bếp lò" }, then: C2_STOVE(),
          again: [{ if: s => s.f.took_draft === true, then: [{ n: { en: "Only ash in the grate now.", vi: "Trong lò giờ chỉ còn tro." } }], else: [{ n: { en: "The burnt draft is still in the grate, where you left it.", vi: "Bản nháp cháy dở vẫn nằm trong lò, chỗ bạn để lại." } }] }] },
        { id: "cabinet", x: 68, y: 30, clue: true, label: { en: "The medicine cabinet", vi: "Tủ thuốc" }, then: [
          { n: { en: "On the shelf is a white box printed KELLHOLM SURGERY. Inside, three glass [[ampoules]], still [[sealed]].", vi: "Trên kệ có một hộp trắng in chữ KELLHOLM SURGERY. Bên trong là ba ống thuốc thủy tinh, vẫn còn niêm phong." } },
          { n: { en: "Next to it, the shelf is grey with dust, except for one clean ring where a bottle used to stand.", vi: "Bên cạnh, mặt kệ phủ bụi xám, trừ một vòng tròn sạch, chỗ trước kia đặt một cái lọ." } },
          { note: { en: "Tom's cabinet: KELLHOLM SURGERY box, three ampoules, still sealed. A clean ring in the dust where a bottle used to stand.", vi: "Tủ thuốc của Tom: hộp KELLHOLM SURGERY, ba ống thuốc còn niêm phong. Một vòng sạch trên lớp bụi, chỗ trước kia đặt một cái lọ." } } ] },
        { id: "pegs", x: 44, y: 36, label: { en: "Pegs by the door", vi: "Hàng móc cạnh cửa" }, then: [
          { n: { en: "Empty. No coat, no lamp.", vi: "Trống trơn. Không áo khoác, không đèn bão." } } ] },
        { id: "phone", x: 52, y: 54, clue: true, label: { en: "The hall table", vi: "Bàn ở hành lang" }, then: [
          { n: { en: "An old cream telephone with a curly cord, a pencil beside it, and a tide table with every big tide circled.", vi: "Một cái điện thoại bàn màu kem đã cũ, dây xoắn, cạnh đó là một cây bút chì và một tờ bảng giờ thủy triều, đợt triều lớn nào cũng khoanh tròn." } },
          { n: { en: "The receiver is on its cradle. Tom's number is on a yellowed label below the keypad.", vi: "Ống nghe vẫn nằm yên trên giá. Số điện thoại của Tom dán trên một mẩu nhãn ố vàng dưới bàn phím." } },
          { n: { en: "01289 381214", vi: "01289 381214" } },
          { note: { en: "Tom's house phone: 01289 381214.", vi: "Máy bàn nhà Tom: 01289 381214." } } ] },
        { id: "back", x: 84, y: 56, clue: true, label: { en: "The back gate", vi: "Cổng sau" }, then: [
          { cg: "backgate" },
          { n: { en: "It opens straight onto wet sand beside the causeway. There's a dark patch of oil where a truck usually stands. No truck.", vi: "Cổng mở thẳng ra bãi cát ướt sát đường ngầm. Có một vệt dầu sẫm màu, chỗ xe tải vẫn hay đỗ. Không thấy xe." } },
          { cg: null },
          { n: { en: "In the sand, two kinds of print. Wellingtons, one heel chewed ragged.", vi: "Trên cát có hai loại dấu chân. Dấu ủng cao su, một gót bị gặm nham nhở." }, pic: "act-prints" },
          { n: { en: "And work boots, bigger, the toes pushed deep, turned this way and that, as if someone stood here a while.", vi: "Và dấu giày lao động, to hơn, mũi giày lún sâu, xoay ngang xoay dọc, như có người đã đứng đây một lúc." } },
          { note: { en: "Back gate: no truck, a patch of oil. Prints: wellingtons (one heel chewed ragged) + bigger work boots, turned this way and that — someone stood here a while.", vi: "Cổng sau: không có xe tải, một vệt dầu. Dấu chân: ủng cao su (một gót bị gặm nham nhở) + giày lao động to hơn, xoay ngang xoay dọc — có người đã đứng đây một lúc." } } ] },
        { id: "front", x: 14, y: 26, clue: true, label: { en: "The front gate", vi: "Cổng trước" }, then: [
          { n: { en: "In the soft verge, tyre marks. A car stopped here, then reversed away.", vi: "Trên lề đất mềm có vết bánh xe. Một chiếc ô tô đã dừng ở đây, rồi lùi xe đi." }, pic: "act-tyres" },
          { note: { en: "Front gate: tyre marks in the verge. A car stopped, then reversed away.", vi: "Cổng trước: vết bánh xe trên lề đất. Một chiếc xe đã dừng rồi lùi đi." } } ] },
        { id: "window", x: 76, y: 18, label: { en: "The kitchen window", vi: "Cửa sổ bếp" }, then: [
          { n: { en: "It looks straight down the causeway.", vi: "Từ đây nhìn thẳng xuống con đường ngầm." } },
          { n: { en: "The light in the hut is still there.", vi: "Ngọn đèn trong chòi vẫn còn đó." } },
          { n: { en: "It was there at twenty to ten.", vi: "Lúc mười giờ kém hai mươi nó đã ở đó." } } ] },
      ] } },
      { cam: null },
      // chưa chạm vào lò → lựa chọn bản nháp vẫn phải hiện (took_draft luôn có giá trị sau chương này)
      { if: s => s.f.took_draft === undefined, then: [
        { n: { en: "On your way out, the warmth from the kitchen stops you. You crouch by the stove.", vi: "Trên đường ra, hơi ấm từ gian bếp níu bạn lại. Bạn ngồi xuống cạnh bếp lò." } },
        ...C2_STOVE(),
      ] },
      // MẮT THẨM ĐỊNH: nếu Tom chỉ ra chòi như mọi lần triều lớn
      { think: { en: "Assessor's eye. Tom has waited out big tides for forty years. If tonight were routine, what would his house look like?", vi: "Mắt thẩm định. Tom đã chờ qua những đợt triều lớn suốt bốn mươi năm. Nếu đêm nay như thường lệ, nhà ông trông thế nào?" } },
      { compare: { title: { en: "Assessor's eye: the cottage", vi: "Mắt thẩm định: ngôi nhà" }, tries: 4,
        left: { title: { en: "An ordinary big tide", vi: "Một đêm triều lớn bình thường" }, lines: [
          { en: "Coat and lamp gone from the pegs.", vi: "Áo khoác và đèn bão không còn trên móc." },
          { en: "Front door shut behind him.", vi: "Cửa trước đóng lại sau lưng ông." },
          { en: "Skerry settled by the warm stove.", vi: "Skerry nằm yên cạnh bếp lò ấm." },
          { en: "Truck gone from the back gate.", vi: "Xe tải không còn ở cổng sau." },
          { en: "Home by ten: he asked you to come at ten.", vi: "Về nhà trước mười giờ: ông hẹn bạn lúc mười giờ." } ] },
        right: { title: { en: "What you found", vi: "Những gì bạn thấy" }, lines: [
          { en: "Coat and lamp gone from the pegs.", vi: "Áo khoác và đèn bão không còn trên móc." },
          { en: "Front door wide open.", vi: "Cửa trước để ngỏ." },
          { en: "Skerry shut in, howling, whining at the back door.", vi: "Skerry bị nhốt, tru lên, rên ư ử ở cửa sau." },
          { en: "Truck gone from the back gate.", vi: "Xe tải không còn ở cổng sau." },
          { en: "At ten, his lamp is still out in the box.", vi: "Mười giờ, đèn bão của ông vẫn ở ngoài chòi." } ] },
        diffs: [1, 2, 4],
        ok: [{ think: { en: "This wasn't routine. He left in a hurry: door open, dog shut in. And he didn't return for your meeting.", vi: "Lần này khác thường. Ông đi vội: cửa để ngỏ, chó nhốt trong nhà. Và ông đã không về gặp bạn như hẹn." } }],
        fail: [{ think: { en: "Something here isn't right, and you can't yet say what. The door. The dog. The lamp in the box.", vi: "Có gì đó không ổn mà bạn chưa gọi được tên. Cánh cửa. Con chó. Ngọn đèn trong chòi." } }] } },
      { fx: "particles-off" },
      { go: "c2_leo" },
    ],

    // ── 22:10 LEO Ở ĐẦU ĐƯỜNG NGẦM: kể hết / chỉ nói ông Tom không có nhà
    c2_leo: [
      { cp: "c2_leo" },
      { bg: "causeway" }, { clock: "22:10" }, { amb: "sea" }, { mood: "night" }, { hide: "*" },
      { show: "leo", at: "c" },
      { n: { en: "You find Leo's Land Rover at the head of the causeway, engine running, headlights on the water. He's watching the hut through binoculars.", vi: "Bạn thấy chiếc Land Rover của Leo ở đầu đường ngầm, máy vẫn nổ, đèn pha rọi xuống mặt nước. Anh đang nhìn về phía cái chòi qua ống nhòm." }, on: "leo" },
      { if: s => s.f.leo_id === "lie", then: [
        { think: { en: "This afternoon you told him you were staying on the mainland. Now you're on the island at ten at night.", vi: "Chiều nay bạn bảo anh là bạn ở bên đất liền. Giờ bạn đang đứng trên đảo lúc mười giờ đêm." } },
        { n: { en: "If he remembers, he doesn't say so. Not yet.", vi: "Nếu anh còn nhớ, anh cũng không nói ra. Chưa nói." }, on: "leo" },
      ] },
      { choice: [
        { tag: "open", en: "(Tell him everything.)", vi: "(Kể hết với anh.)", set: { told_leo: "full" }, add: { leo: 1 }, then: [
          { say: "me", en: "Tom's very ill. He asked me to come and see him at ten. And something's missing from his medicine cabinet.", vi: "Ông Tom ốm nặng lắm. Ông ấy hẹn tôi tới gặp lúc mười giờ tối. Và tủ thuốc của ông ấy thiếu mất một thứ." },
          { if: s => s.f.took_draft === true, then: [
            { think: { en: "Everything but the paper in your pocket.", vi: "Hết, trừ tờ giấy trong túi bạn." } },
          ] },
          { go: "c2_tellfull" } ] },
        { tag: "direct", en: "(Just say Tom isn't home.)", vi: "(Chỉ nói ông Tom không có nhà.)", set: { told_leo: "few" }, then: [
          { say: "me", en: "Tom's not at home. His door's open.", vi: "Ông Tom không có nhà. Cửa nhà ông ấy để mở." },
          { say: "leo", en: "He'll be in the box, then.", vi: "Vậy chắc ông ấy ở trong chòi." },
          { go: "c2_wait" } ] },
      ], prompt: { en: "Leo lowers the binoculars a little.", vi: "Leo hạ ống nhòm xuống một chút." } },
    ],

    // ── KỂ HẾT: lời Leo, lên xe xuống bến, Callum, cả quán ra dốc bến, 22:20 xuồng ra
    c2_tellfull: [
      { n: { en: "Leo lowers the binoculars. For a moment he just looks at you.", vi: "Leo hạ ống nhòm xuống. Một lúc, anh chỉ nhìn bạn." }, on: "leo" },
      { say: "leo", en: "I saw him go out about quarter past nine. Flashed his lights at me, like he does on big tides.", vi: "Tôi thấy ông ấy ra đường ngầm khoảng chín giờ mười lăm tối. Nháy đèn với tôi, như mọi lần triều lớn." },
      { say: "leo", en: "You don't tell the keeper about the tide.", vi: "Ai lại đi dạy người gác đường ngầm chuyện con nước." },
      { say: "leo", en: "Quarter to ten, I saw his lamp in the box, and the road was gone. I called Humber Coastguard.", vi: "Mười giờ kém mười lăm tối, tôi thấy đèn bão của ông ấy trong chòi, mà đường ngầm thì mất rồi. Tôi gọi Cứu hộ Humber." },
      { say: "leo", en: "They said: experienced keeper in a refuge, not in danger. Monitor.", easy: "They said: he knows the sea, he's safe in the box. Watch and wait.", vi: "Họ bảo: người gác đường dày kinh nghiệm, đang ở trong chòi trú, không gặp nguy. Theo dõi tiếp." },
      { n: { en: "He swallows.", vi: "Anh nuốt khan." }, on: "leo" },
      { say: "leo", face: "sad", en: "Too deep to drive now. Boat's the only way. Up the channel.", vi: "Giờ thì sâu quá, xe không ra được. Chỉ còn cách đi thuyền. Theo kênh mà lên." },
      { say: "leo", face: "determined", en: "You've seen the cabinet. Tell Helen exactly what was there. Then I may need another pair of hands.", vi: "{Ac} đã thấy tủ thuốc. Hãy kể chính xác cho bà Helen. Rồi có thể tôi cần thêm người phụ giúp." },
      { sfx: "buzz" },
      { n: { en: "On the way to the harbour, he radios in, clipped and flat: he is taking a local boat to the refuge box.", vi: "Trên đường xuống bến, anh báo qua bộ đàm, ngắn gọn, đều giọng: anh sẽ đi thuyền của dân đảo ra chòi trú nạn." } },
      { hide: "*" },
      { bg: "harbour" }, { clock: "22:15" },
      { show: "callum", at: "c" },
      { n: { en: "Callum's boat is tied up at the bottom of the [[slipway]]. MAIRI ROSE, in white letters on the bow.", vi: "Thuyền của Callum buộc ở chân dốc bến. Trên mũi thuyền có dòng chữ trắng MAIRI ROSE." }, on: "callum" },
      { n: { en: "He's sitting in the stern with the engine cover off, not doing anything to it.", vi: "Anh ngồi ở đuôi thuyền, nắp máy mở, nhưng chẳng làm gì với nó." }, on: "callum" },
      { say: "callum", en: "He's sat out worse.", vi: "Đêm tệ hơn thế ông ấy còn trụ được." },
      { say: "me", en: "There's a bottle missing from his cabinet. His medicine.", vi: "Tủ thuốc của ông ấy thiếu một lọ. Thuốc của ông ấy." },
      { sfx: "beat" },
      { n: { en: "Callum looks at you. Then he puts the cover back on and pulls the cord.", vi: "Callum nhìn bạn. Rồi anh đậy nắp máy lại và giật dây khởi động." }, on: "callum" },
      { sfx: "steps" },
      { n: { en: "News goes round an island fast. By the time the engine catches, the Lantern has emptied onto the slipway.", vi: "Trên đảo, tin tức lan nhanh lắm. Tới lúc máy nổ được, cả quán The Lantern đã kéo nhau xuống dốc bến." } },
      { meet: "dodd" }, { meet: "helen" }, { meet: "gideon" },
      { n: { en: "Nell, with her coat over her apron. Fergus. Dr Vosper, with her bag.", vi: "Nell, áo khoác choàng ngoài tạp dề. Fergus. Bác sĩ Vosper, xách túi y tế." } },
      { n: { en: "Mrs Dodd is on her bench, as if she never left. Gideon is already heading back up the lane towards the pub.", vi: "Bà Dodd ngồi trên ghế của bà, như chưa từng rời khỏi đó. Gideon đã quay lên con đường làng, về phía quán." } },
      { hide: "callum" }, { clock: "22:20" },
      { show: "leo", at: "c" },
      {"n":{"en":"Leo checks your lifejacket buckle. He hands Callum another jacket and waits until he puts it on.","vi":"Leo kiểm tra khóa áo phao của bạn. Anh đưa Callum một chiếc nữa, đợi anh ấy mặc xong."}},
      { n: { en: "Twenty past ten. Leo steps down into the boat and holds out a hand for you.", vi: "Mười giờ hai mươi. Leo bước xuống thuyền, chìa tay ra đỡ bạn." }, on: "leo" },
      { hide: "leo" },
      { n: { en: "As the boat pulls away, Nell's voice carries after you.", vi: "Thuyền vừa rời bến, tiếng Nell vọng theo." } },
      { say: "nell", en: "I'll fetch blankets.", vi: "Để bác đi lấy chăn." },
      { go: "c2_boat" },
    ],

    // ── KÊNH + CHÒI (đủ): vệt dầu, Callum leo trước, Tom chết, vách số, Leo chụp ảnh + cọc đo
    c2_boat: [
      { cp: "c2_boat" },
      { bg: "boat" }, { amb: "sea" }, { mood: "night" }, { hide: "*" }, { cam: "sway" }, { sfx: "splash" },
      { n: { en: "The channel is black and very wide.", vi: "Con kênh đen ngòm, rộng mênh mông." } },
      { n: { en: "On either side, the posts stick out of the water, each with its own small shadow under the moon.", vi: "Hai bên, những cây cọc nhô khỏi mặt nước, cây nào cũng có một cái bóng nhỏ dưới trăng." } },
      { n: { en: "Callum steers without looking at anything except the hut.", vi: "Callum lái thuyền, mắt không nhìn gì ngoài cái chòi." } },
      { n: { en: "Where the truck should be, there is only water. A smear of oil turns slowly on the surface, silver in the moonlight.", vi: "Chỗ lẽ ra phải có chiếc xe tải, giờ chỉ còn nước. Một vệt dầu chầm chậm xoay trên mặt nước, ánh bạc dưới trăng." } },
      { n: { en: "Callum brings the boat in against the iron legs, and Leo holds it there. Callum is on the ladder before it has stopped moving.", vi: "Callum ghé thuyền sát mấy chân sắt, Leo giữ yên ở đó. Thuyền chưa dừng hẳn, Callum đã ở trên thang." } },
      { n: { en: "He goes up alone. For a long moment there's no sound from above except the water.", vi: "Anh leo lên một mình. Một lúc lâu, phía trên chẳng có tiếng gì ngoài tiếng nước." } },
      { cam: null }, { sfx: "steps" },
      { n: { en: "Leo climbs after Callum. You follow.", vi: "Leo leo lên sau Callum. Bạn theo sau." } },
      { bg: "box" }, { clock: "22:30" }, { mood: "cold" },
      { n: { en: "The lamp is still lit, hanging from its hook.", vi: "Ngọn đèn bão vẫn sáng, treo trên móc." } },
      { cg: "cg-tom-dead" }, { sfx: "sting" }, { fx: "heartbeat" }, { wait: 1200 },
      { n: { en: "Tom Ashby is sitting on the floor, his back against the wall and his legs straight out.", vi: "Tom Ashby ngồi bệt dưới sàn, lưng dựa vách, hai chân duỗi thẳng." } },
      { n: { en: "His chin is on his chest, like a man who has nodded off over the newspaper.", vi: "Cằm ông gục xuống ngực, như người ngủ gật bên tờ báo." } },
      {"n":{"en":"Leo is already checking him. He calls Tom's name, then speaks urgently into the radio.","vi":"Leo đã bắt đầu kiểm tra. Anh gọi tên Tom, rồi nói gấp vào bộ đàm."}},
      {"n":{"en":"You stand back while he works. There is barely room for the three of you.","vi":"Bạn lùi lại để anh làm việc. Chòi chỉ vừa đủ chỗ cho cả ba người."}},
      { cg: null },
      { explore: { goal: { en: "Keep clear while Leo checks Tom", vi: "Tránh chỗ để Leo kiểm tra Tom" }, need: 3, done: { en: "Step back", vi: "Lùi lại" }, spots: [
        { id: "tom", x: 40, y: 56, clue: true, label: { en: "Tom", vi: "Tom" }, then: [
          { n: { en: "His fingertips are black with soot.", vi: "Đầu ngón tay ông đen muội." } },
          { n: { en: "When Leo needs room, you move Tom's hand aside. It's as cold as the iron ladder.", vi: "Khi Leo cần chỗ, bạn đỡ tay Tom sang bên. Tay ông lạnh như cái thang sắt." } },
          { n: { en: "You have waited twenty years for an answer. Now Tom cannot even hear your question.", vi: "Bạn đã chờ câu trả lời suốt hai mươi năm. Giờ Tom còn không nghe được câu hỏi của bạn." } } ] },
        { id: "flask", x: 58, y: 62, clue: true, label: { en: "The flask", vi: "Bình rượu" }, then: [
          { n: { en: "His flask stands by his right hand.", vi: "Bình rượu đặt cạnh tay phải ông." } },
          { think: { en: "Filled to the top at nine. Fill it. Long night.", vi: "Rót đầy lúc chín giờ. Rót đầy vào. Đêm nay dài." } } ] },
        { id: "wall", x: 70, y: 32, clue: true, label: { en: "The wall by the door", vi: "Vách cạnh cửa" }, then: [
          { n: { en: "On the wall beside the door are the old numbers, small and even. The last neat line is this morning's.", vi: "Trên vách cạnh cửa là những con số cũ, nhỏ và đều. Dòng ngay ngắn cuối cùng là của sáng nay." } },
          { n: { en: "14.11 06:01 — 0.5 U", vi: "14.11 06:01 — 0.5 U" } },
          { n: { en: "Below it, there is a new line.", vi: "Bên dưới có thêm một dòng mới." } },
          { n: { en: "21:44 — 0.6 U", vi: "21:44 — 0.6 U" } },
          { n: { en: "The same hand as all the others. But the line runs downhill, and the 4s have been gone over twice.", vi: "Nét chữ giống hệt mọi dòng khác. Nhưng dòng này chúi xuống, và hai số 4 bị tô lại hai lần." } },
          { note: { en: "Box wall: '14.11 06:01 — 0.5 U', then a new line '21:44 — 0.6 U'. Same hand; the line runs downhill, the 4s gone over twice.", vi: "Vách chòi: “14.11 06:01 — 0.5 U”, rồi một dòng mới “21:44 — 0.6 U”. Cùng nét chữ; dòng chúi xuống, hai số 4 bị tô lại hai lần." } } ] },
        { id: "lamp", x: 30, y: 22, label: { en: "The lamp", vi: "Đèn bão" }, then: [
          { n: { en: "Still lit, on its hook. It burns above him as though nothing has happened.", vi: "Vẫn sáng trên móc. Ngọn đèn cháy phía trên ông, như thể chưa có chuyện gì xảy ra." } } ] },
      ] } },
      { show: "leo", at: "c", face: "sad" },
      { sfx: "glitch" }, { fx: "flash" },
      { n: { en: "Leo's camera flashes once, twice, three times. The numbers jump out of the dark and fall back into it.", vi: "Đèn máy ảnh của Leo lóe lên một, hai, ba lần. Những con số bật ra khỏi bóng tối rồi lại chìm vào đó." }, on: "leo", pic: "act-wallphoto" },
      { n: { en: "Then he leans out of the door and photographs the gauge on the iron leg.", vi: "Rồi anh nhoài người ra cửa, chụp cây cọc đo gắn ở chân sắt." }, on: "leo" },
      { n: { en: "When you look round, Callum is already going back down the ladder.", vi: "Bạn quay lại thì Callum đã leo xuống thang rồi." } },
      { say: "leo", face: "determined", en: "We take him back. The doctor decides. Get him out of this cold.", easy: "Take him back to the doctor. Get him out of the cold.", vi: "Mình đưa ông ấy về. Để bác sĩ quyết định. Đưa ông ấy ra khỏi chỗ lạnh này." },
      { hide: "leo" },
      { n: { en: "It takes all three of you, and a rope, to bring him down.", vi: "Phải cả ba người, thêm một sợi dây, mới đưa được ông xuống." } },
      { bg: "boat" },
      { cam: "sway" }, { sfx: "splash" },
      { n: { en: "On the way back nobody speaks. Callum's [[oilskin]] sits strangely on him, bulkier down one side than it was before.", vi: "Suốt đường về không ai nói gì. Chiếc áo vải dầu của Callum trông là lạ, một bên cộm hơn lúc trước." } },
      { cam: null },
      { go: "c2_slip" },
    ],

    // ── DỐC BẾN (ít): Leo + Callum, Gideon lấy brandy 22:16–22:23, Nell lấy chăn 22:22–22:39, Fergus 22:42–22:55
    c2_wait: [
      { cp: "c2_wait" },
      { hide: "*" },
      { n: { en: "Leo lowers the binoculars. He looks from the hut to the harbour.", vi: "Leo hạ ống nhòm. Anh nhìn từ cái chòi về phía bến." } },
      {"say":"leo","en":"He's overdue. I'll get Callum's boat.","vi":"Ông ấy đi lâu quá rồi. Tôi sẽ nhờ thuyền của Callum."},
      { bg: "harbour" }, { clock: "22:15" }, { amb: "sea" }, { mood: "night" },
      { show: "leo", at: "l" }, { show: "callum", at: "r" },
      { n: { en: "At the harbour he talks to Callum himself, quietly, one hand on the bow of the boat.", vi: "Xuống tới bến, anh tự nói chuyện với Callum, giọng khẽ, một tay đặt lên mũi thuyền." }, on: "leo" },
      { say: "callum", en: "He's sat out worse.", vi: "Đêm tệ hơn thế ông ấy còn trụ được." },
      { say: "leo", face: "cold", en: "He's seventy-one and it's freezing.", vi: "Ông ấy bảy mươi mốt tuổi rồi, mà trời thì rét cắt da." },
      { hide: "*" },
      { meet: "dodd" }, { meet: "helen" }, { meet: "gideon" },
      { n: { en: "The Lantern has emptied onto the slipway. You wait with the others. Mrs Dodd counts them as they come and go.", vi: "Cả quán The Lantern đã kéo xuống dốc bến. Bạn đứng chờ cùng mọi người. Bà Dodd đếm từng người đi rồi về." } },
      { clock: "22:16" },
      { show: "gideon", at: "c" },
      { n: { en: "At 22:16, before the boat has gone, Gideon heads back up the lane.", vi: "Lúc 22:16, thuyền còn chưa đi, Gideon đã quay lên con đường làng." }, on: "gideon" },
      { say: "gideon", en: "I need a brandy. Anyone? No?", vi: "Tôi cần một ly brandy. Có ai không? Không à?" },
      { hide: "gideon" },
      { clock: "22:20" }, { sfx: "splash" },
      { n: { en: "Callum pulls the cord. Twenty past ten, and the boat goes out without you.", vi: "Callum giật dây khởi động. Mười giờ hai mươi, thuyền ra kênh mà không có bạn." } },
      { clock: "22:23" },
      { show: "gideon", at: "l" },
      { n: { en: "A couple of minutes later Gideon is back, a glass in his hand. Nell passes him on her way up.", vi: "Vài phút sau Gideon quay lại, tay cầm ly. Nell đi ngang qua ông, lên quán." }, on: "gideon" },
      { hide: "gideon" },
      { say: "nell", en: "I'll fetch blankets.", vi: "Để bác đi lấy chăn." },
      { n: { en: "Out on the water, the boat's light reaches the hut, and stays there. It stays too long.", vi: "Ngoài kia, đèn thuyền tới được cái chòi, rồi dừng lại ở đó. Dừng lâu quá." } },
      { fx: "heartbeat" },
      { say: "dodd", face: "worried", en: "That's not good.", vi: "Thế là không ổn rồi." },
      { clock: "22:39" },
      { show: "nell", at: "r" },
      { n: { en: "At 22:39 Nell comes back down, her arms full of blankets.", vi: "Lúc 22:39, Nell quay xuống, chăn ôm đầy tay." }, on: "nell" },
      { hide: "nell" },
      { clock: "22:42" },
      { n: { en: "Soon after, Fergus goes up the lane, slowly, one hand on the wall.", vi: "Ngay sau đó, Fergus đi lên con đường làng, chậm chạp, một tay vịn tường." } },
      { clock: "22:55" },
      { show: "fergus", at: "c", face: "sad" },
      { n: { en: "He's back at five to eleven, walking stiffly, something long and heavy buttoned inside his coat.", vi: "Mười một giờ kém năm ông quay lại, bước đi cứng nhắc, một vật dài và nặng cài kín trong áo khoác." }, on: "fergus" },
      { say: "fergus", en: "It's his. I'm keeping it.", vi: "Của Tom đấy. Ông giữ." },
      { n: { en: "He doesn't say what. Nobody asks.", vi: "Ông không nói là cái gì. Không ai hỏi." } },
      { hide: "fergus" },
      { order: { prompt: { en: "Mrs Dodd counted them. Who returned to the Lantern during the rescue — in order?", vi: "Bà Dodd đã đếm. Trong lúc cứu hộ, ai quay lên quán The Lantern — theo thứ tự?" }, tries: 2,
        items: [
          { t: { en: "Gideon — for a brandy. Back with a glass.", vi: "Gideon — đi lấy brandy. Về tay cầm ly." } },
          { t: { en: "Nell — for blankets. Back with an armful.", vi: "Nell — đi lấy chăn. Về ôm đầy tay." } },
          { t: { en: "Fergus — slowly. Back with something under his coat.", vi: "Fergus — chậm chạp. Về với một vật trong áo khoác." } },
        ],
        ok: [{ note: { en: "Slipway, during the rescue: Gideon up the lane ~22:16, back ~22:23 with a brandy. Nell up ~22:22 ('I'll fetch blankets'), back 22:39. Fergus up 22:42, back 22:55 with something long and heavy in his coat: 'It's his. I'm keeping it.'", vi: "Dốc bến, trong lúc cứu hộ: Gideon lên quán ~22:16, về ~22:23 cầm ly brandy. Nell lên ~22:22 (“I'll fetch blankets”), về 22:39. Fergus lên 22:42, về 22:55, một vật dài và nặng trong áo: “It's his. I'm keeping it.”" } }],
        fail: [{ say: "dodd", en: "Gideon first. Then Nell. Then Fergus. Thirty year I've counted.", vi: "Gideon trước. Rồi Nell. Rồi Fergus. Ba mươi năm nay bà đếm rồi." },
          { note: { en: "Slipway, during the rescue: Gideon up the lane ~22:16, back ~22:23 with a brandy. Nell up ~22:22 ('I'll fetch blankets'), back 22:39. Fergus up 22:42, back 22:55 with something long and heavy in his coat: 'It's his. I'm keeping it.'", vi: "Dốc bến, trong lúc cứu hộ: Gideon lên quán ~22:16, về ~22:23 cầm ly brandy. Nell lên ~22:22 (“I'll fetch blankets”), về 22:39. Fergus lên 22:42, về 22:55, một vật dài và nặng trong áo: “It's his. I'm keeping it.”" } }] } },
      { n: { en: "Out on the channel, the boat's light starts back.", vi: "Ngoài kênh, đèn thuyền bắt đầu quay về." } },
      { go: "c2_slip" },
    ],

    // ── 22:55 DỐC BẾN (mọi nhánh): Helen tuyên bố tử vong, CID, bình ngọt, túi áo, lọ sạch bóng, vết bầm, Gideon
    c2_slip: [
      { cp: "c2_slip" },
      { bg: "harbour" }, { clock: "22:55" }, { title: { en: "10:55 P.M.", vi: "22:55" } }, { amb: "sea" }, { mood: "cold" }, { hide: "*" },
      { n: { en: "Five to eleven.", vi: "Mười một giờ kém năm." } },
      { if: s => s.f.told_leo === "full", then: [
        { n: { en: "On the slipway, torches and blankets. Nell has come back with an armful of them.", vi: "Trên dốc bến, đèn pin và chăn. Nell đã quay lại, ôm một chồng chăn trên tay." } },
      ], else: [
        { n: { en: "The boat comes in to the slipway. Torches and blankets. They lift Tom out between them.", vi: "Thuyền cập dốc bến. Đèn pin và chăn. Mấy người cùng nhấc Tom lên." } },
        { show: "leo", at: "c", face: "sad" },
        { n: { en: "Leo comes up last. Without a word he turns his camera round and shows you the little screen.", vi: "Leo lên sau cùng. Không nói gì, anh xoay máy ảnh lại, cho bạn xem màn hình nhỏ." }, on: "leo" },
        { cg: "cg-tom-dead" }, { fx: "heartbeat" },
        { n: { en: "Tom on the floor of the box, his back against the wall. The lamp still lit. His flask by his right hand.", vi: "Tom ngồi dưới sàn chòi, lưng dựa vách. Đèn bão vẫn sáng. Bình rượu cạnh tay phải ông." } },
        { n: { en: "Then the wall. Under this morning's line, a new one: 21:44 — 0.6 U. The line runs downhill.", vi: "Rồi tới vách. Dưới dòng của sáng nay có một dòng mới: 21:44 — 0.6 U. Dòng chữ chúi xuống." } },
        { cg: null },
        { note: { en: "Leo's photos of the box: under '14.11 06:01 — 0.5 U', a new line '21:44 — 0.6 U'. The line runs downhill. He photographed the gauge too.", vi: "Ảnh Leo chụp trong chòi: dưới dòng “14.11 06:01 — 0.5 U” có dòng mới “21:44 — 0.6 U”. Dòng chữ chúi xuống. Anh chụp cả cọc đo." } },
        { hide: "leo" },
      ] },
      { show: "helen", at: "c" },
      { n: { en: "Dr Vosper checks Tom while Leo tells her what happened in the hut. Everyone else is made to stand back.", vi: "Bác sĩ Vosper kiểm tra Tom trong lúc Leo kể lại chuyện trong chòi. Những người khác được yêu cầu lùi ra." }, on: "helen" },
      { wait: 600 },
      {"n":{"en":"Leo's torch stays on her hands. She checks again before she looks up.","vi":"Đèn pin của Leo vẫn rọi vào tay bà. Bà kiểm tra lại một lần nữa rồi mới ngẩng lên."}},
      { say: "helen", face: "cold", en: "He's gone, Leo. I'm recording the time.", vi: "Ông ấy mất rồi, Leo. Tôi ghi nhận giờ tử vong." },
      { hide: "helen" }, { show: "leo", at: "c", face: "sad" },
      { n: { en: "Leo turns away and speaks into his radio: stand the helicopter down. A voice from Berwick answers, then another one. CID.", vi: "Leo quay đi, nói vào bộ đàm: báo trực thăng dừng nhiệm vụ. Một giọng từ Berwick trả lời, rồi một giọng khác. Bên điều tra hình sự." }, on: "leo" },
      { say: "leo", face: "cold", en: "Check his pockets. Bag everything. Keep the witnesses close. Understood.", vi: "Kiểm túi ông ấy. Niêm phong hết. Giữ nhân chứng ở gần. Rõ ạ." },
      { hide: "leo" }, { show: "helen", at: "c" },
      { say: "helen", en: "Pinpoint. We need blood tests. An [[opioid]] is possible. The cold may have contributed.", easy: "His pupils are tiny. A strong painkiller and the cold may be involved. We need tests.", vi: "Đồng tử co nhỏ như đầu kim. Cần xét nghiệm máu. Có thể liên quan đến thuốc nhóm opioid. Cái lạnh có thể đã góp phần." },
      { n: { en: "She pulls on a glove, picks up the flask, unscrews it and smells it.", vi: "Bà đeo găng, cầm bình rượu lên, vặn nắp, đưa lên mũi ngửi." }, on: "helen" },
      { sfx: "sting" }, { fx: "spotlight" },
      { say: "helen", face: "cold", en: "Sweet. Like medicine.", vi: "Ngọt. Như mùi thuốc." },
      { n: { en: "When she tips it, the last of it moves slowly, and the bottom is tacky. Leo seals the flask in a bag.", vi: "Bà nghiêng bình, chỗ rượu còn lại chảy chậm, đáy bình dinh dính. Leo cho cái bình vào túi vật chứng, dán kín." }, on: "helen" },
      { item: "flask" },
      { hide: "helen" },
      { n: { en: "Leo empties Tom's left coat pocket onto a blanket, one thing at a time.", vi: "Leo lấy từng món trong túi trái áo khoác của Tom ra, bày lên một tấm chăn." }, pic: "act-pocket" },
      { n: { en: "A box of matches. A stub of pencil. A handkerchief. All of them smeared black with soot.", vi: "Một bao diêm. Một mẩu bút chì. Một chiếc khăn tay. Món nào cũng lem muội đen." }, pic: "act-pocket" },
      { n: { en: "Then, from the same pocket, a small brown bottle, empty.", vi: "Rồi, cũng từ túi ấy, một cái lọ nhỏ màu nâu, rỗng." } },
      { n: { en: "ORAMORPH 10mg/5ml — T. ASHBY", vi: "ORAMORPH 10mg/5ml — T. ASHBY" } },
      { fx: "flash" }, { sfx: "glass" },
      { n: { en: "It catches the torchlight. There isn't a mark on it.", vi: "Cái lọ lóe lên dưới ánh đèn pin. Trên đó không có lấy một vết nào." } },
      { show: "helen", at: "c" },
      { say: "helen", en: "That's his. I prescribed it in September.", vi: "Lọ của ông ấy. Tôi kê hồi tháng Chín." },
      { say: "helen", face: "sad", en: "He wouldn't take the [[Oramorph]]. Wanted his head clear.", vi: "Ông ấy không chịu uống Oramorph. Muốn đầu óc tỉnh táo." },
      { n: { en: "She bends close to the bottle in the torchlight, without touching it.", vi: "Bà cúi sát xuống nhìn cái lọ dưới ánh đèn pin, không chạm vào." }, on: "helen" },
      { say: "helen", en: "Not even sticky. Oramorph's a [[syrup]]. He'd have had it all down the side.", easy: "It isn't sticky. The medicine is a syrup. If he poured it, the bottle would be sticky.", vi: "Không dính chút nào. Oramorph là siro. Ông ấy mà tự rót thì siro phải dính đầy thân lọ." },
      { item: "vial" },
      { deduce: { q: { en: "Helen says Tom wouldn't take his Oramorph. So where did it go?", vi: "Helen nói Tom không chịu uống Oramorph. Vậy thuốc đã đi đâu?" }, a: ["vial", "flask"], tries: 2,
        hint: { en: "Something empty, and something that smells sweet.", vi: "Một thứ rỗng, và một thứ có mùi ngọt." },
        ok: [{ think: { en: "The whisky may contain his medicine. The empty bottle and sticky flask support that. They do not tell me who put it there.", vi: "Rượu có thể chứa thuốc của ông. Cái lọ rỗng và bình rượu dính ủng hộ điều đó. Chúng chưa cho biết ai đã bỏ thuốc vào." } }],
        fail: [{ think: { en: "An empty medicine bottle. A sticky flask. A possible connection, but I still need more.", vi: "Một lọ thuốc rỗng. Một bình rượu dính. Có thể liên quan, nhưng mình vẫn cần thêm chứng cứ." } }] } },
      { n: { en: "She pushes up his sleeves.", vi: "Bà kéo tay áo ông lên." }, on: "helen" },
      { say: "helen", face: "cold", en: "And [[bruises]] on both upper arms. Fresh. Someone gripped him hard.", vi: "Còn đây là vết bầm ở cả hai bắp tay. Mới. Có người đã túm ông ấy rất chặt." },
      { note: { en: "Slipway 22:55 — Helen suspects an opioid and cold; tests pending. Flask: 'Sweet. Like medicine.' Tom wouldn't take his Oramorph. Pocket: matches, pencil, handkerchief all black with soot; the Oramorph bottle empty and perfectly clean, 'not even sticky'. Fresh bruises on both upper arms.", vi: "Dốc bến 22:55 — Helen nghi thuốc nhóm opioid và lạnh; còn chờ xét nghiệm. Bình rượu: “Sweet. Like medicine.” Tom không chịu uống Oramorph. Túi áo: diêm, bút chì, khăn tay đều lem muội; lọ Oramorph rỗng và sạch bóng, “not even sticky”. Vết bầm mới ở cả hai bắp tay." } },
      { hide: "helen" }, { show: "nell", at: "c", face: "sad" },
      { n: { en: "Nell kneels and tucks a blanket in under his chin, as if he might still feel the cold.", vi: "Nell quỳ xuống, kéo tấm chăn đắp lên tới cằm ông, như thể ông vẫn còn biết lạnh." }, on: "nell" },
      { hide: "nell" }, { show: "gideon", at: "c" },
      { n: { en: "Gideon speaks loud enough for the whole slipway to hear.", vi: "Gideon cất tiếng, đủ to cho cả dốc bến cùng nghe." }, on: "gideon" },
      { say: "gideon", face: "sad", en: "He went out to her. Twenty years tonight.", vi: "Ông ấy ra với bà ấy. Đêm nay tròn hai mươi năm." },
      { hide: "gideon" },
      { n: { en: "Nobody says her name. People nod. Somebody crosses herself.", vi: "Không ai nhắc tên bà. Mọi người gật đầu. Có một người đàn bà làm dấu thánh giá." } },
      {"think":{"en":"Her. As if my mother were a place he could go.","vi":"Bà ấy. Như thể mẹ mình là một nơi ông có thể tìm đến."}},
      { cam: "pull", ms: 8000 }, { sfx: "wind" }, { wait: 800 }, { fx: "blackout" },
      { n: { en: "You look back across the water. For the first time tonight, the hut is dark.", vi: "Bạn ngoái nhìn ra mặt nước. Lần đầu tiên trong đêm nay, cái chòi tối om." } },
      { if: s => s.f.told_leo === "full", then: [
        { n: { en: "You look down at your hand. One fingertip is still black.", vi: "Bạn nhìn xuống bàn tay mình. Một đầu ngón tay vẫn còn đen." } },
      ], else: [
        { n: { en: "You look down at your hands. You never reached him.", vi: "Bạn nhìn xuống hai bàn tay mình. Bạn đã không tới được chỗ ông." } },
      ] },
      { cam: null }, { mood: null },
      { end: "c2_end" },
    ],
  },
  endings: {
    c2_end: { ch: 2, title: { en: "The Lamp in the Box", vi: "Ngọn đèn trong chòi" },
      sum: { en: "Tom Ashby is dead in the refuge box. His flask smells sweet.", vi: "Tom Ashby chết trong chòi trú nạn. Bình rượu của ông có mùi ngọt." },
      text: { en: "The man who wrote to you went out to the box and never came back. The flask Fergus filled at nine smells sweet. His medicine bottle is empty — and the only clean thing in a pocket full of soot. On the slipway, everyone is already saying he went out to her.", vi: "Người viết thư cho bạn ra chòi và không bao giờ trở về. Bình rượu Fergus rót đầy lúc chín giờ có mùi ngọt. Lọ thuốc của ông rỗng — và là thứ duy nhất sạch sẽ trong cái túi đầy muội. Trên dốc bến, ai cũng đã bảo ông ra với bà ấy." },
      next: "c3_open", nextTitle: { en: "Chapter 3", vi: "Chương 3" } },
  },
});
// BETWEEN TIDES — CHƯƠNG 3: NGƯỜI NGOÀI (22:55 → 00:15). Văn: ../../../GiuaHaiConNuoc-truyen-ch3.md (+ Nhánh rẽ). Thiết kế §5 Ch3, §10b “Luật cân bằng”.
// Mở theo cách Ch2 kết thúc: told_leo "full" (về trên xuồng, đã thấy chòi) / "few" (đứng ở dốc bến, thấy từng người lên quán) · took_draft (bản nháp nặng trong túi).
// Cờ đọc: told_leo · told_nell · held_bottle · leo_id · took_draft · at_harbour · fergus (bộ đếm). Cờ đặt: gideon_private · p_not_suicide · p_bottle_route · p_nell_knew (told_nell, Nell bậc 2).
// Niềm tin: told_nell → leo −1 · took_draft: tự đặt lên bàn → leo −1 / bị lục → leo = 0 · gideon_private: giữ → gideon +1 / kể → leo +1.
// Sự thật: T11 (ghế lái) · T3 (chai bị xả) · T6 (21:22). Đồ: cutting · tombottle (+ vial / flask nếu Ch2 chưa trao). Kết giữa truyện: e8_refuge (trốn Leo).
// Xưng hô VI: Leo → bạn {ac}/{Ac}, tự xưng “tôi”, thêm “ạ” · Fergus → bạn: “đứa này”, với Leo: ông – cháu · Nell → bạn: bác – cháu (“pet” → “cháu”)
//   · bạn → Nell: “tôi” (told_nell → “cháu”) · Gideon → bạn {ac}, tự xưng “tôi” · bà Dodd → “đứa này”.
StoryEngine.chapter({
  // First-use assets supplied by presentation plugins; arrays stay unchanged.
  scenes: {
    "box-dark": { kind: "study", name: { en: "The refuge box", vi: "Chòi trú nạn" }, amb: "hut" },
    "act-pocket-bagged": { kind: "hall", name: { en: "The old lifeboat station", vi: "Trạm xuồng cứu hộ cũ" }, amb: "hall" },
    "harbour-lamp-car": { kind: "causeway", name: { en: "The harbour", vi: "Bến thuyền" }, amb: "harbour" },
    "cg-car-recovered": {}, "it-cutting": {}, "it-tombottle": {},
  },
  words: {
    "statement": { vi: "lời khai", ex: "I'll need a statement from you. Not here." },
    "sudden death": { vi: "ca tử vong đột ngột (phải báo cảnh sát, chưa rõ nguyên nhân)", ex: "It's a sudden death. CID can't get across till three." },
    "lifeboat station": { vi: "trạm xuồng cứu hộ", ex: "The old lifeboat station stands at the end of the harbour wall." },
    "slipway": { vi: "dốc bến (đường dốc đưa thuyền xuống nước)", ex: "They carry him up from the slipway on a door." },
    "top pocket": { vi: "túi áo ngực", ex: "He drops the keys into his top pocket and buttons it." },
    "by heart": { vi: "thuộc lòng", ex: "You know the claim number by heart." },
    "cockled": { vi: "(giấy) nhăn, phồng do ướt", ex: "Label's all cockled, ink's run." },
    "under the tap": { vi: "xả dưới vòi nước", ex: "Someone's had that under the tap." },
    "evidence bag": { vi: "túi đựng vật chứng", ex: "He takes an evidence bag out of the drawer." },
    "four-by-four": { vi: "xe hai cầu", ex: "Gideon's four-by-four has salt right up to the doors." },
    "barrister": { vi: "luật sư tranh tụng", ex: "I was at dinner with our barrister in Newcastle." },
    "councillor": { vi: "ủy viên hội đồng", ex: "There was an envelope. For a councillor, in a car park." },
    "bribe": { vi: "hối lộ", ex: "A bribe is a fine and a scandal." },
    "polished": { vi: "đánh bóng, lau sạch bóng", ex: "The bottle is polished clean." },
  },

  recap: [
    { ch: 3, when: "c3_open", if: s => s.f.told_leo === "full", t: { en: "You came back on the boat with Tom. On the slipway the story was already going round: he went out to her.", vi: "Bạn về trên xuồng cùng Tom. Ở dốc bến, câu chuyện đã lan khắp: ông đã ra với bà ấy." } },
    { ch: 3, when: "c3_open", if: s => s.f.told_leo !== "full", t: { en: "From the slipway you watched Gideon, Nell and Fergus go up to the Lantern one at a time. Then the boat brought Tom home.", vi: "Từ dốc bến, bạn thấy Gideon, Nell rồi Fergus lần lượt lên quán. Rồi chiếc xuồng đưa Tom về." } },
    { ch: 3, when: "c3_station", t: { en: "Leo held you at the old lifeboat station as a witness and kept your car keys.", vi: "Leo giữ bạn ở trạm xuồng cứu hộ cũ để lấy lời khai và giữ chìa khóa xe của bạn." } },
    { ch: 3, when: "c3_station", if: s => s.f.told_nell, t: { en: "Nell had told Leo you are Anna Rowe's child. He took you through your statement three times.", vi: "Nell đã nói với Leo bạn là con bà Anna Rowe. Anh bắt bạn khai đi khai lại ba lần." } },
    { ch: 3, when: "c3_station", if: s => s.f.leo_id === "lie", t: { en: "Leo caught your lie: you'd said the mainland, but Nell had you in room three.", vi: "Leo bắt được lời nói dối của bạn: bạn bảo ở đất liền, nhưng Nell ghi bạn ở phòng ba." } },
    { ch: 3, when: "c3_station", if: s => s.f.took_draft, t: { en: "Leo took the half-burnt draft from Tom's stove off you and bagged it.", vi: "Leo lấy bản nháp cháy dở từ bếp lò nhà Tom khỏi tay bạn và cho vào túi vật chứng." } },
    { ch: 3, when: "c3_photo", t: { en: "Photo 4: your mother's seat was pushed all the way back. The position suggests a taller driver.", vi: "Ảnh 4: ghế lái của mẹ bị đẩy lùi hết cỡ. Vị trí ấy gợi ý người lái cao hơn." } },
    { ch: 3, when: "c3_fergus", if: s => s.f.at_harbour, t: { en: "Mrs Dodd swore you stayed by her bench from nine till near ten.", vi: "Bà Dodd làm chứng bạn ở cạnh ghế của bà từ chín giờ tới gần mười giờ." } },
    { ch: 3, when: "c3_fergus", if: s => !s.f.at_harbour, t: { en: "Fergus swore you never left your table from nine till near ten.", vi: "Fergus làm chứng bạn không rời bàn từ chín giờ tới gần mười giờ." } },
    { ch: 3, when: "c3_fergus", if: s => (s.f.fergus || 0) >= 1, t: { en: "Fergus gave times: the tap coughed at 21:08, the hatch banged, Nell came up around quarter past.", vi: "Fergus đưa ra mốc giờ: vòi bia ho lúc 21:08, nắp hầm sập, Nell lên lại khoảng 21:15." } },
    { ch: 3, when: "c3_fergus", t: { en: "Fergus brought Tom's bottle. The felt-tip label had run. He believed someone had rinsed it under the tap.", vi: "Fergus mang chai của Tom tới. Nhãn bút dạ đã nhòe. Ông cho rằng có người đã xả chai dưới vòi nước." } },
    { ch: 3, when: "c3_fergus", if: s => s.f.held_bottle, t: { en: "Fergus told Leo you had handled Tom's bottle hours before he died.", vi: "Fergus kể với Leo rằng bạn đã cầm chai của Tom vài giờ trước khi ông chết." } },
    { ch: 3, when: "c3_gideon", t: { en: "Gideon passed Tom at 21:22. Tom was waving his lamp at a boat light. Gideon didn't stop.", vi: "Gideon đi ngang Tom lúc 21:22. Tom đang vẫy đèn về phía một đèn thuyền. Gideon không dừng lại." } },
    { ch: 3, when: "c3_gideon", if: s => s.f.gideon_private === true, t: { en: "Gideon confessed a bribe to you. You kept it from Leo. He owes you one.", vi: "Gideon thú nhận với bạn chuyện hối lộ. Bạn giấu Leo. Ông nợ bạn một lần." } },
    { ch: 3, when: "c3_gideon", if: s => s.f.gideon_private === false, t: { en: "Gideon confessed a bribe to you, and you made him tell Leo. Leo trusts you more. Gideon won't forget.", vi: "Gideon thú nhận với bạn chuyện hối lộ, và bạn bắt ông kể với Leo. Leo tin bạn hơn. Gideon sẽ không quên." } },
    { ch: 3, when: "c3_pocket", if: s => s.f.told_nell, t: { en: "Nell let slip that she and Tom 'had words at one'. Family business.", vi: "Nell buột miệng rằng bà và Tom “có to tiếng lúc một giờ”. Chuyện nhà." } },
    { ch: 3, when: "c3_pocket", if: s => s.f.p_not_suicide, t: { en: "The clean vial, full flask and rinsed whisky bottle suggest tampering. Leo will investigate; laboratory confirmation is still needed.", vi: "Lọ thuốc sạch, bình rượu đầy và chai whisky bị xả nước gợi ý có người can thiệp. Leo sẽ điều tra; vẫn cần kết quả xét nghiệm." } },
    { ch: 3, when: "c3_pocket", t: { en: "At 00:15 Leo let you go. Dr Vosper was waiting under the harbour lamp: 'Not him. You.'", vi: "00:15 Leo thả bạn. Bác sĩ Vosper đứng chờ dưới đèn bến: “Không phải với anh ta. Với {ac}.”" } },
  ],

  flow: [
    { ch: 3, row: 0, id: "c3_open", kind: "cp", scene: "harbour", label: { en: "Carried up on a door", vi: "Khiêng lên trên tấm cửa" }, sum: { en: "Everyone says suicide.", vi: "Ai cũng nói là tự tử." } },
    { ch: 3, row: 1, id: "c3_station", kind: "cp", scene: "lifeboat", label: { en: "The statement", vi: "Lời khai" }, sum: { en: "Leo keeps your keys — and you.", vi: "Leo giữ chìa khóa xe — và giữ cả bạn." } },
    { ch: 3, row: 2, id: "c3_photo", kind: "cp", scene: "lifeboat", label: { en: "The photographs", vi: "Những tấm ảnh" }, sum: { en: "Twenty years without looking.", vi: "Hai mươi năm không dám nhìn." } },
    { ch: 3, row: 3, id: "c3_fergus", kind: "cp", scene: "lifeboat", label: { en: "Fergus and the bottle", vi: "Fergus và cái chai" }, sum: { en: "Forty years. Never a drop of water in it.", vi: "Bốn mươi năm. Chưa từng có một giọt nước." } },
    { ch: 3, row: 4, id: "c3_gideon", kind: "cp", scene: "lifeboat", label: { en: "Gideon's statement", vi: "Lời khai của Gideon" }, sum: { en: "21:22. He didn't stop.", vi: "21:22. Ông không dừng lại." } },
    { ch: 3, row: 5, kind: "opt", key: "gideon_private", val: true, label: { en: "Keep his secret", vi: "Giữ bí mật cho ông" }, sum: { en: "Gideon owes you one.", vi: "Gideon nợ bạn một lần." }, hint: { en: "An envelope in a car park.", vi: "Một cái phong bì ở bãi đỗ xe." } },
    { ch: 3, row: 5, kind: "opt", key: "gideon_private", val: false, label: { en: "Tell Leo", vi: "Kể với Leo" }, sum: { en: "Leo trusts you more. Gideon will remember.", vi: "Leo tin bạn hơn. Gideon sẽ nhớ." }, hint: { en: "An envelope in a car park.", vi: "Một cái phong bì ở bãi đỗ xe." } },
    { ch: 3, row: 6, id: "c3_pocket", kind: "cp", scene: "lifeboat", label: { en: "Tom's pocket", vi: "Túi áo của Tom" }, sum: { en: "A clean bottle in a black pocket.", vi: "Một cái lọ sạch trong cái túi đen muội." } },
    { ch: 3, row: 9, id: "c3_end", kind: "end", label: { en: "The Outsider", vi: "Người ngoài" } },
    { ch: 3, row: 9, id: "e8_refuge", kind: "end", label: { en: "The Refuge Box", vi: "Chòi trú nạn" } },
  ],

  nodes: {
    // ── 22:55 · DỐC BẾN: mở theo cách Ch2 kết thúc (full / few / took_draft), rồi giả thuyết tự tử
    c3_open: [
      { set: { goal: "c3_statement" } },
      { cp: "c3_open" },
      { title: { ch: 3, en: "The Outsider", vi: "Người ngoài" } },
      { bg: "harbour" }, { clock: "22:55" }, { amb: "sea" }, { mood: "night" }, { cam: "pan-r", ms: 8000 },
      { if: s => s.f.told_leo === "full", then: [
        { n: { en: "You came back on the boat. Your knees are still wet from the floor of the box.", vi: "Bạn về trên xuồng. Đầu gối vẫn còn ướt vì sàn cái chòi." } },
        { n: { en: "Your hand still remembers his. As cold as the iron ladder.", vi: "Bàn tay bạn vẫn còn nhớ tay ông. Lạnh như cái thang sắt." } },
        { n: { en: "Callum ties up without a word and stands apart, his oilskin buttoned to the chin.", vi: "Callum buộc thuyền, không nói một lời, rồi đứng tách ra, áo vải dầu cài kín tới cằm." } },
      ], else: [
        { n: { en: "You watched it all from the [[slipway]]. Gideon up the lane for a brandy. Nell for blankets. Fergus last, one hand on the wall.", vi: "Bạn đã đứng ở dốc bến nhìn hết. Gideon lên con đường làng lấy brandy. Nell đi lấy chăn. Fergus đi sau cùng, một tay vịn tường." } },
        { n: { en: "One at a time they went up to the Lantern, and one at a time they came back.", vi: "Từng người một lên quán The Lantern, rồi từng người một quay về." } },
        { n: { en: "Then the boat's light came home, slowly. You knew before anybody said it.", vi: "Rồi đèn thuyền chậm chạp quay về. Bạn đã biết trước khi có ai nói ra." } },
      ] },
      { if: "took_draft", then: [
        { think: { en: "The half-burnt letter is in your inside pocket. It weighs nothing. It feels like a stone.", vi: "Lá thư cháy dở nằm trong túi áo trong của bạn. Nó chẳng nặng gì. Mà nặng như một hòn đá." } },
      ] },
      { n: { en: "They carry him up from the slipway on a door. Nobody can find a stretcher, and nobody wants to wait.", vi: "Người ta đặt ông lên một tấm cửa, khiêng từ dốc bến lên. Không ai tìm được cáng, mà cũng chẳng ai muốn chờ." } },
      { n: { en: "By the time they lay him down, the story is already going round the slipway.", vi: "Tới lúc họ đặt ông xuống, câu chuyện đã lan khắp dốc bến." } },
      { n: { en: "A dying man. Twenty years tonight. His own medicine, his own flask, his own hut. He went out to her.", vi: "Một người sắp chết. Đêm nay tròn hai mươi năm. Thuốc của chính ông, bình rượu của chính ông, cái chòi của chính ông. Ông đã ra với bà ấy." } },
      { n: { en: "It's a good story. It explains everything, and it asks nothing of anyone.", vi: "Một câu chuyện hay. Chuyện ấy giải thích được mọi thứ, mà chẳng đòi hỏi gì ở ai." } },
      { show: "leo", at: "c", face: "cold" },
      { n: { en: "Leo listens to it with his radio in one hand and says nothing at all. Then he turns to you.", vi: "Leo nghe, tay cầm bộ đàm, không nói một lời. Rồi anh quay sang bạn." }, on: "leo" },
      { cam: null },
      { say: "leo", en: "I'll need a [[statement]] from you. Not here.", vi: "Tôi cần lấy lời khai của {ac}. Không phải ở đây ạ." },
      { hide: "*" }, { cam: null },
      { go: "c3_station" },
    ],

    // ── 23:00 · TRẠM XUỒNG CỨU HỘ CŨ: lời khai, chìa khóa, bản nháp
    c3_station: [
      { cp: "c3_station" },
      { title: { en: "11:00 P.M.", vi: "23:00" } },
      { bg: "lifeboat" }, { clock: "23:00" }, { amb: "hall" }, { mood: "noir" }, { fx: "particles", kind: "dust", ms: 6000 },
      { n: { en: "The old [[lifeboat station]] stands at the end of the harbour wall. The lifeboat went to the mainland thirty years ago. The building stayed.", vi: "Trạm cứu hộ cũ nằm ở cuối tường chắn sóng của bến. Chiếc xuồng cứu hộ đã chuyển vào đất liền từ ba mươi năm trước. Còn tòa nhà thì ở lại." } },
      { n: { en: "Now it holds a kettle, a radio and a row of yellow helmets.", vi: "Giờ trong đó có một cái ấm đun nước, một bộ đàm và một hàng mũ bảo hộ vàng." } },
      { n: { en: "On the wall, boards with gold names: boats, and the years they were brought home.", vi: "Trên tường là những tấm bảng kẻ tên màu vàng: tên tàu và những năm chúng được đưa về." } },
      { cg: "backroom" },
      { n: { en: "They have put Tom in the back room, on the old boat trolley, under a blanket from the Lantern.", vi: "Người ta đặt Tom ở phòng trong, trên cái xe đẩy xuồng cũ, đắp một tấm chăn của The Lantern." } },
      { n: { en: "Leo closes the door gently, as if Tom were sleeping. He locks it and pockets the key.", vi: "Leo khép cửa nhẹ nhàng, như thể Tom đang ngủ. Anh khóa cửa và bỏ chìa vào túi." } },
      { cg: null },
      { show: "leo", at: "c", face: "cold" },
      { n: { en: "Then he sits down across the table from you and takes out a notebook.", vi: "Rồi anh ngồi xuống bên kia bàn, đối diện bạn, và lấy ra một cuốn sổ tay." }, on: "leo" },
      { say: "leo", en: "It's a [[sudden death]]. CID can't get across till three. Till then, it's me.", easy: "Nobody knows why he died yet. The detectives can't cross till three. Till then, it's me.", vi: "Đây là ca tử vong đột ngột. Phải ba giờ sáng bên điều tra hình sự mới qua được. Từ giờ tới lúc đó thì chỉ có tôi thôi ạ." },
      { if: s => s.f.told_leo === "full", then: [
        { say: "leo", en: "He invited you for ten. A stranger, alone in his house. You knew something was missing from his cabinet before anyone else told me.", easy: "You're a stranger. You were alone in his house. And you knew about his medicine before anyone else.", vi: "Ông ấy hẹn {ac} lúc mười giờ tối. Một người lạ, ở một mình trong nhà ông ấy. {Ac} biết tủ thuốc thiếu đồ trước khi ai khác nói với tôi." },
      ], else: [
        { say: "leo", en: "You're a stranger. You were in his house tonight, door open, him gone, and you didn't say why.", easy: "You're a stranger. You were in his house tonight, and you didn't tell me why.", vi: "{Ac} là người lạ. Tối nay {ac} ở trong nhà ông ấy, cửa để mở, ông ấy thì đi mất, mà {ac} không nói vì sao." },
      ] },
      { say: "leo", en: "I don't know how he died. I do know you were in his house. Start with why.", vi: "Tôi chưa biết ông ấy chết thế nào. Tôi biết {ac} đã vào nhà ông ấy. Hãy bắt đầu từ lý do đó." },
      { if: "told_nell", then: [
        { say: "leo", en: "And Nell tells me you're Anna Rowe's child.", vi: "Mà bà Nell bảo tôi {ac} là con của bà Anna Rowe." },
        { say: "leo", en: "You came here on the night she died, to meet the man who kept the road. And now he's dead. You see how that looks.", easy: "You came on the anniversary of her death to meet him. Now he's dead. That looks bad.", vi: "{Ac} tới đây đúng đêm tròn hai mươi năm bà ấy mất, để gặp người gác đường ngầm. Giờ thì ông ấy chết. {Ac} thấy người ta sẽ nghĩ gì rồi đấy." },
        {"say":"me","en":"You think I came all this way to lose the only man who could answer me?","vi":"Anh nghĩ tôi đi xa tới đây để mất nốt người duy nhất có thể trả lời tôi sao?","tone":"hurt, trying to stay measured"},
        {"say":"leo","en":"I think you're frightened. So am I. I still need your account.","vi":"Tôi nghĩ {ac} đang sợ. Tôi cũng vậy. Nhưng tôi vẫn cần nghe {ac} kể lại.","tone":"quiet, controlled"},
        { n: { en: "He takes you through your statement twice more, slowly, looking for the place where it changes. It doesn't.", vi: "Anh bắt bạn khai lại thêm hai lần nữa, thật chậm, dò xem chỗ nào lời khai đổi đi. Không có chỗ nào." }, on: "leo" },
        { add: { leo: -1 } },
      ] },
      { n: { en: "He holds out his hand, palm up.", vi: "Anh chìa tay ra, ngửa lòng bàn tay." }, on: "leo" },
      { say: "leo", en: "Leave your keys with me, please. The road's underwater, and I need to know where you are.", vi: "{Ac} để chìa khóa lại đây nhé. Đường đang ngập, và tôi cần biết {ac} ở đâu." },
      { n: { en: "You put your car keys in his hand. He drops them into his [[top pocket]] and buttons it.", vi: "Bạn đặt chìa khóa xe vào tay anh. Anh thả chúng vào túi áo ngực rồi cài khuy lại." }, on: "leo" },
      // took_draft mềm (Luật cân bằng): tự đặt lên bàn → leo −1 · chờ bị lục → leo = 0
      { if: "took_draft", then: [
        { think: { en: "The draft. He is asking what you found, and you still haven't shown it.", vi: "Bản nháp. Anh đang hỏi bạn tìm thấy gì, mà bạn vẫn chưa đưa nó ra." } },
        { choice: [
          { tag: "direct", en: "(Put the draft on the table before he asks.)", vi: "(Đặt bản nháp lên bàn trước khi anh hỏi.)", add: { leo: -1 }, then: [
            { n: { en: "You take the half-burnt letter out of your inside pocket and lay it on the table between you.", vi: "Bạn lấy lá thư cháy dở trong túi áo trong ra, đặt lên bàn, giữa hai người." }, on: "leo" },
            { n: { en: "He reads it twice, holding it by one corner.", vi: "Anh đọc hai lần, chỉ cầm một góc." }, on: "leo" },
            { say: "leo", face: "angry", en: "From the stove? Tell me exactly where it was.", vi: "Trong bếp lò sao? Kể chính xác cho tôi nó nằm ở đâu." },
            { say: "leo", face: "cold", en: "Thank you for telling me. Next time, leave it where it is and call me.", vi: "Cảm ơn {ac} đã nói. Lần sau cứ để nguyên tại chỗ rồi gọi tôi." },
            { n: { en: "He bags it without another word.", vi: "Anh cho nó vào túi vật chứng, không nói thêm lời nào." }, on: "leo" },
          ] },
          { tag: "lie", en: "(Say nothing. Wait.)", vi: "(Không nói gì. Chờ.)", set: { leo: 0 }, then: [
            { say: "leo", en: "Anything else from the cottage? Empty your pockets, please.", vi: "Còn thứ gì lấy từ nhà Tom không? {Ac} lấy hết đồ trong túi ra nhé." },
            { n: { en: "You empty the second pocket last. The half-burnt letter lands between you. Leo reads it twice.", vi: "Bạn dốc túi áo thứ hai sau cùng. Lá thư cháy dở rơi xuống giữa hai người. Leo đọc hai lượt." }, on: "leo" },
            { say: "leo", face: "angry", en: "From the stove? Tell me exactly where it was.", vi: "Trong bếp lò sao? Kể chính xác cho tôi nó nằm ở đâu." },
            { n: { en: "He bags it. The next question comes more slowly. He is checking every word now.", vi: "Anh bỏ nó vào túi vật chứng. Câu hỏi tiếp theo chậm hơn. Giờ anh đang kiểm tra từng lời." }, on: "leo" },
          ] },
        ] },
        { drop: "draft" },
      ] },
      { if: s => s.f.leo_id === "lie", then: [
        { say: "leo", face: "cold", en: "Mainland, was it? Nell's got you in room three.", vi: "Ở đất liền cơ đấy? Bà Nell ghi {ac} ở phòng ba." },
        { n: { en: "He writes something down and underlines it.", vi: "Anh ghi gì đó rồi gạch chân." }, on: "leo" },
      ], else: [
        { say: "leo", en: "You told me the Lantern, and that's where you were. That's something.", vi: "{Ac} bảo tôi là ở The Lantern, và {ac} ở đó thật. Thế cũng là được một điểm." },
      ] },
      { sfx: "buzz" },
      { n: { en: "His radio crackles. Berwick want him. He stands up.", vi: "Bộ đàm của anh lẹt xẹt. Bên Berwick gọi anh. Anh đứng dậy." }, on: "leo" },
      { say: "leo", en: "Stay there. I'll be twenty minutes.", vi: "{Ac} ngồi yên đây. Hai mươi phút nữa tôi quay lại." },
      { hide: "leo" }, { sfx: "door" },
      { n: { en: "The door shuts. The kettle ticks as it cools.", vi: "Cửa đóng lại. Cái ấm kêu tích tắc trong lúc nguội dần." } },
      { n: { en: "On the table in front of you is your bag. In your bag is the grey folder.", vi: "Trên bàn trước mặt bạn là cái túi của bạn. Trong túi là bìa hồ sơ màu xám." } },
      { choice: [
        { tag: "open", en: "(Open the grey folder.)", vi: "(Mở bìa hồ sơ màu xám.)", then: [{ go: "c3_photo" }] },
        { tag: "direct", en: "(Slip out. Try the causeway on foot.)", vi: "(Lẻn ra ngoài. Thử lội qua đường ngầm.)", then: [{ go: "c3_door" }] },
      ] },
      { go: "c3_photo" },
    ],

    // ── Trốn Leo (E8): ra tới cửa còn một lần nghĩ lại
    c3_door: [
      { n: { en: "Your hand rests on the latch. Outside, the sea roars. The causeway has been underwater for an hour and a half.", vi: "Tay bạn đặt lên then cửa. Bên ngoài, biển gầm lên. Đường ngầm đã chìm dưới nước một tiếng rưỡi." } },
      { think: { en: "Leo has your keys. On foot, then. A mile and a half.", vi: "Leo giữ chìa khóa xe. Vậy thì đi bộ. Một dặm rưỡi." } },
      { choice: [
        { tag: "open", en: "(Sit back down. Open the folder.)", vi: "(Ngồi xuống lại. Mở bìa hồ sơ.)", then: [{ go: "c3_photo" }] },
        { tag: "direct", en: "(Go.)", vi: "(Đi.)", add: { leo: -1 }, then: [{ go: "c3_refuge" }] },
      ] },
      { go: "c3_photo" },
    ],

    c3_refuge: [
      { bg: "causeway" }, { clock: "23:20" }, { amb: "sea" }, { mood: "cold" },
      { n: { en: "You go along the harbour wall the other way from Leo's footsteps, and down onto the sand.", vi: "Bạn men theo tường chắn sóng, ngược hướng tiếng chân Leo, rồi xuống bãi cát." } },
      { n: { en: "The road is gone. Where it was, black water runs sideways, fast and quiet.", vi: "Con đường đã mất. Chỗ nó từng nằm, nước đen chảy ngang, nhanh và lặng lẽ." } },
      { sfx: "splash" },
      { n: { en: "Knee-deep. Then thigh-deep. The cold takes your breath and doesn't give it back.", vi: "Ngập tới gối. Rồi tới đùi. Cái lạnh lấy mất hơi thở của bạn và không trả lại." } },
      { fx: "shiver" },
      { n: { en: "Halfway, the sea leans on you. You can't go on. You can't go back. There's only the box.", vi: "Tới giữa đường, biển đè lên người bạn. Không đi tiếp được. Không quay lại được. Chỉ còn cái chòi." } },
      { bg: "box" },
      { n: { en: "You climb the iron ladder with hands you can't feel.", vi: "Bạn leo cái thang sắt bằng đôi tay không còn cảm giác." } },
      { n: { en: "On the wall by the door, in a line that runs downhill: 21:44 — 0.6 U", vi: "Trên vách cạnh cửa, một dòng chữ chúi xuống: 21:44 — 0.6 U" } },
      { n: { en: "You sit down beside it, where he sat, and wait for the light.", vi: "Bạn ngồi xuống cạnh dòng chữ ấy, đúng chỗ ông đã ngồi, và chờ trời sáng." } },
      { mood: null },
      { end: "e8_refuge" },
    ],

    // ── 23:10 · ẢNH 2004: nỗi đau trước, rồi mắt thẩm định (ghế lái) → T11; mẩu báo
    c3_photo: [
      { cp: "c3_photo" },
      { bg: "lifeboat" }, { clock: "23:10" },
      { n: { en: "For twenty years you have avoided the photographs. You know every page around them. You know the claim number [[by heart]].", vi: "Suốt hai mươi năm bạn tránh nhìn những tấm ảnh ấy. Mọi trang xung quanh chúng, bạn đều thuộc. Số hồ sơ bạn thuộc lòng." } },
      { n: { en: "Beyond the wall, the man who never got to answer your question lies under a pub blanket.", vi: "Bên kia bức tường, người chưa kịp trả lời câu hỏi của bạn nằm dưới tấm chăn của quán." } },
      { n: { en: "You open the folder.", vi: "Bạn mở bìa hồ sơ." } },
      { sfx: "page" },
      { n: { en: "PHOTO 3 — Vehicle recovered, main channel, 15/11/2004, 07:40.", vi: "PHOTO 3 — Vehicle recovered, main channel, 15/11/2004, 07:40. — Ảnh 3: xe được trục vớt, kênh chính, 15/11/2004, 07:40." } },
      { mood: "memory" }, { cg: "cg-mem-nails" },
      { n: { en: "Her car. Green, on its side in the grey morning water, the driver's door hanging open like a wing.", vi: "Xe của mẹ. Màu xanh lá, nằm nghiêng trong làn nước xám buổi sáng, cửa lái mở toang như một cánh chim." } },
      { n: { en: "You can hear her nails tapping on that window at a red light.", vi: "Bạn nghe thấy tiếng móng tay mẹ gõ lên ô kính ấy mỗi lần dừng đèn đỏ." } },
      { n: { en: "You turn the photograph face down and breathe, until you can pick it up again.", vi: "Bạn úp tấm ảnh xuống và thở, cho tới khi cầm được nó lên lần nữa." } },
      { wait: 1200 },
      { cg: "cg-photo-seat" }, { cam: "push", ms: 9000 }, { fx: "heartbeat" },
      { n: { en: "Photo 4. The car at low water, before recovery. Someone photographed the driver's seat through the open door.", vi: "Ảnh 4. Chiếc xe lúc nước ròng, trước khi trục vớt. Có người chụp ghế lái qua cánh cửa đang mở." } },
      { n: { en: "The recovery note says the seat was photographed before anyone entered the car.", vi: "Biên bản trục vớt ghi ghế được chụp trước khi có người vào xe." } },
      { n: { en: "You look at the steering wheel. At the pedals. At the seat.", vi: "Bạn nhìn vô-lăng. Nhìn bàn đạp. Nhìn ghế lái." } },
      {"think":{"en":"The report says she drove into the channel. Does the car's recorded position fit the way she drove?","vi":"Biên bản nói mẹ lái xe xuống kênh. Vị trí được ghi lại trong xe có khớp với cách mẹ lái không?"}},
      { cam: null },
      { wait: 2000 },
      { compare: {
        title: { en: "Assessor's eye — Photo 4", vi: "Mắt thẩm định — Ảnh 4" },
        left: { title: { en: "If she drove in herself", vi: "Nếu mẹ tự lái xuống" }, lines: [
          { en: "The keys in the ignition.", vi: "Chìa khóa cắm ở ổ." },
          { en: "The door open, because she tried to get out.", vi: "Cửa mở, vì mẹ đã cố thoát ra." },
          { en: "The driver's seat where she always kept it, right up against the wheel.", vi: "Ghế lái ở đúng chỗ mẹ luôn để, kéo sát vô-lăng." },
        ] },
        right: { title: { en: "Photo 4", vi: "Ảnh 4" }, lines: [
          { en: "The keys in the ignition.", vi: "Chìa khóa cắm ở ổ." },
          { en: "The door open.", vi: "Cửa mở." },
          { en: "The driver's seat pushed all the way back, as far as it will go.", vi: "Ghế lái bị đẩy lùi hết cỡ, tới tận cùng." },
        ] },
        diffs: [2], tries: 2,
        ok: [{ go: "c3_seat" }],
        fail: [
          { think: { en: "The recovery note fixes when the photograph was taken. Compare the driving position, not the water around the car.", vi: "Ghi chép trục vớt xác định lúc chụp ảnh. Hãy đối chiếu vị trí lái, không phải lớp nước quanh xe." } },
          { compare: {
            title: { en: "Assessor's eye — Photo 4", vi: "Mắt thẩm định — Ảnh 4" },
            left: { title: { en: "If she drove in herself", vi: "Nếu mẹ tự lái xuống" }, lines: [
              { en: "The keys in the ignition.", vi: "Chìa khóa cắm ở ổ." },
              { en: "The door open, because she tried to get out.", vi: "Cửa mở, vì mẹ đã cố thoát ra." },
              { en: "The driver's seat where she always kept it, right up against the wheel.", vi: "Ghế lái ở đúng chỗ mẹ luôn để, kéo sát vô-lăng." },
            ] },
            right: { title: { en: "Photo 4", vi: "Ảnh 4" }, lines: [
              { en: "The keys in the ignition.", vi: "Chìa khóa cắm ở ổ." },
              { en: "The door open.", vi: "Cửa mở." },
              { en: "The driver's seat pushed all the way back, as far as it will go.", vi: "Ghế lái bị đẩy lùi hết cỡ, tới tận cùng." },
            ] },
            diffs: [2], tries: 2,
            ok: [{ go: "c3_seat" }],
            fail: [
              { n: { en: "Your eyes keep going back to the seat. Pushed all the way back.", vi: "Mắt bạn cứ quay lại cái ghế. Bị đẩy lùi hết cỡ." } },
              { go: "c3_seat" },
            ] } },
        ] } },
      { go: "c3_seat" },
    ],

    c3_seat: [
      { n: { en: "Behind her seat, you could stretch your legs. She needed it close to the pedals. She never drove with it pushed back.", vi: "Sau ghế mẹ, bạn có thể duỗi chân. Mẹ cần kéo ghế sát bàn đạp. Mẹ chưa bao giờ lái xe với ghế đẩy lùi ra." } },
      { n: { en: "That wasn't her driving position. It suggests someone much taller had used the car.", vi: "Đó không phải vị trí mẹ vẫn ngồi lái. Nó gợi ý một người cao hơn mẹ nhiều đã dùng xe." } },
      { fx: "flash" }, { truth: "T11" },
      { n: { en: "You don't know who.", vi: "Bạn không biết là ai." } },
      { cg: null }, { cam: null }, { mood: "noir" },
      { n: { en: "Tucked behind the photographs is a newspaper cutting someone filed with the claim.", vi: "Kẹp sau mấy tấm ảnh là một mẩu báo ai đó đã lưu cùng hồ sơ." } },
      { n: { en: "PLANNING INQUIRY OPENS MONDAY; DEVELOPER G. MARSH IN ATTENDANCE", vi: "PLANNING INQUIRY OPENS MONDAY; DEVELOPER G. MARSH IN ATTENDANCE — Phiên điều trần quy hoạch khai mạc thứ Hai; nhà phát triển G. Marsh có mặt." }, pic: "act-cutting" },
      { item: "cutting" },
      { n: { en: "You put your hand flat on the photograph, the way you'd put it on a window.", vi: "Bạn áp bàn tay lên tấm ảnh, như người ta áp tay lên một ô cửa kính." } },
      { n: { en: "For a long time the only sound is the sea, working at the bottom of the old slipway.", vi: "Rất lâu, âm thanh duy nhất là tiếng biển, cứ thế vỗ mãi dưới chân dốc xuồng cũ." } },
      { go: "c3_fergus" },
    ],

    // ── 23:35 · FERGUS (+ bà Dodd nếu at_harbour): giờ giấc; chai TOM → T3
    c3_fergus: [
      { cp: "c3_fergus" },
      { clock: "23:35" }, { sfx: "door" },
      { n: { en: "Twenty-five to twelve. The door opens on cold air and Fergus, with Leo behind him.", vi: "Mười hai giờ kém hai mươi lăm. Cửa mở ra, gió lạnh lùa vào cùng Fergus, Leo theo sau." } },
      { show: "leo", at: "c", face: "cold" },
      { say: "leo", en: "Cramlington say someone from the Lantern rang ahead. Good of them.", easy: "The hospital says someone from the Lantern phoned them first. That was kind.", vi: "Bên Cramlington bảo có người ở The Lantern đã gọi báo trước. Tử tế thật." },
      { n: { en: "You close the folder. Nobody asks what was in it.", vi: "Bạn gập bìa hồ sơ lại. Không ai hỏi trong đó có gì." } },
      { if: "at_harbour", then: [
        { n: { en: "Fergus has brought Mrs Dodd on his arm, wrapped in her rug.", vi: "Fergus dắt bà Dodd theo, bà vẫn quấn tấm chăn của mình." } },
        { show: "dodd", at: "c" },
        { say: "dodd", en: "Stayed by my bench from nine till near ten, that one did. Never left. Just stared at the water.", vi: "Đứa này ở cạnh ghế bà từ chín giờ tới gần mười giờ tối. Chả đi đâu. Cứ nhìn trân trân ra biển." },
        { hide: "dodd" },
      ] },
      { show: "fergus", at: "c" },
      { n: { en: "Fergus lowers himself onto a plastic chair as if it might not hold him. He doesn't take his coat off.", vi: "Fergus hạ mình xuống chiếc ghế nhựa, như sợ nó không đỡ nổi. Ông không cởi áo khoác." }, on: "fergus" },
      { say: "leo", en: "Fergus. Tell me who was where. Nine till ten. Take your time.", vi: "Ông Fergus. Ông kể cho cháu ai ở đâu nhé. Từ chín tới mười giờ tối. Ông cứ thong thả." },
      { if: "at_harbour", then: [
        { n: { en: "Fergus gives the rest of the evening from the bar, as he remembers it.", vi: "Fergus kể nốt buổi tối ở quán, theo trí nhớ của ông." }, on: "fergus" },
      ], else: [
        { say: "fergus", en: "That one never moved from that table. Not till near ten. Sat looking at the clock like it owed money.", vi: "Đứa này thì chả rời cái bàn ấy. Tới gần mười giờ mới đi. Cứ ngồi nhìn đồng hồ như đồng hồ nợ tiền nó." },
      ] },
      { n: { en: "He frowns at the floor, putting the evening back together a piece at a time.", vi: "Ông nhíu mày nhìn xuống sàn, ráp lại buổi tối từng mảnh một." }, on: "fergus" },
      { say: "fergus", en: "Tom went at nine. Callum after him. Then Callum back again — five past, maybe — had one stood up and off.", easy: "Tom left at nine. Callum too. Callum came back at about five past, had a quick drink standing, and left.", vi: "Tom đi lúc chín giờ tối. Callum đi sau. Rồi Callum quay lại — chín giờ năm phút, chắc thế — đứng làm một ly rồi đi." },
      { say: "fergus", en: "Couple from Alnwick wanting a bed. Nell sent them to Mrs Dodd.", vi: "Có đôi vợ chồng ở Alnwick hỏi chỗ ngủ. Nell bảo sang bà Dodd." },
      { if: s => (s.f.fergus || 0) >= 1, then: [
        { say: "fergus", en: "Tap coughed at eight past, hatch banged; up again at quarter past.", easy: "The beer tap coughed at 9:08. The cellar hatch banged shut. Nell came up at 9:15.", vi: "Vòi bia ho lúc chín giờ tám phút, nắp hầm sập lại; chín giờ mười lăm thì lên." },
        { n: { en: "Leo looks up from his notebook. Fergus doesn't usually do minutes.", vi: "Leo ngẩng lên khỏi cuốn sổ. Fergus vốn đâu có nhớ từng phút." }, on: "fergus" },
      ], else: [
        { say: "fergus", en: "Nell down the cellar some time after ten past — barrel. Up again when the tap ran.", easy: "Nell went down to the cellar after ten past nine to change a barrel. She came up when the beer ran again.", vi: "Nell xuống hầm lúc nào đó sau chín giờ mười — cái thùng bia. Vòi chảy lại thì lên." },
      ] },
      { say: "fergus", en: "Me in the gents, after. Twenty past, about. Doctor never came in. Gideon was over the water.", vi: "Rồi ông vào nhà vệ sinh. Chín giờ hai mươi tối, khoảng thế. Bà bác sĩ không vào quán. Gideon thì còn bên đất liền." },
      { n: { en: "Leo writes it all down. Fergus watches him do it.", vi: "Leo ghi lại hết. Fergus nhìn anh ghi." }, on: "fergus" },
      { say: "fergus", en: "That's the lot. I'm eighty, son. Don't hang me on the minutes.", easy: "That's all. I'm eighty. Don't expect exact times from me.", vi: "Có thế thôi. Ông tám mươi rồi, cháu ạ. Đừng bắt bẻ ông từng phút một." },
      { note: { en: "Fergus: Tom left 21:00 · Callum back ~21:05 · Alnwick couple · Nell down to change the barrel, back when the tap ran · Fergus in the gents ~21:20.", vi: "Fergus: Tom đi 21:00 · Callum quay lại ~21:05 · đôi khách Alnwick · Nell xuống thay thùng bia, vòi chảy lại thì lên · Fergus vào nhà vệ sinh ~21:20." } },
      { n: { en: "Leo closes his notebook. Fergus doesn't get up.", vi: "Leo gập sổ lại. Fergus không đứng dậy." }, on: "fergus" },
      { n: { en: "He looks at the back-room door for a while. Then he leans towards Leo and lowers his voice, as if Tom might hear.", vi: "Ông nhìn cánh cửa phòng trong một lúc. Rồi ông nghiêng người về phía Leo, hạ giọng, như sợ Tom nghe thấy." }, on: "fergus" },
      { say: "fergus", face: "sad", en: "Got his bottle in my coat. Brought it down at five to eleven. Didn't want anyone else pouring from it. Not tonight.", vi: "Chai của Tom, ông để trong áo đây. Mười một giờ kém năm tối ông mang nó xuống. Không muốn đứa nào rót từ chai ấy nữa. Đêm nay thì không." },
      { if: s => s.f.told_leo !== "full", then: [
        { n: { en: "You know the shape before you see it. The long, heavy thing he brought back down to the slipway at five to eleven.", vi: "Bạn nhận ra hình dáng ấy trước khi nhìn thấy. Cái vật dài và nặng ông mang về dốc bến lúc mười một giờ kém năm." }, on: "fergus" },
      ] },
      { sfx: "glass" }, { fx: "spotlight" },
      { n: { en: "He unbuttons his coat and stands the bottle on the table. The level is where it always is. The label is not.", vi: "Ông cởi khuy áo và đặt cái chai lên bàn. Mực rượu vẫn ở chỗ quen thuộc. Còn cái nhãn thì không như cũ." }, on: "fergus", pic: "act-bottle-hand" },
      { n: { en: "The paper is soft and wrinkled, one corner lifting. The fat black capitals have bled into grey. TOM is still legible. Just.", vi: "Giấy mềm nhũn, nhăn nhúm, một góc bong lên. Những chữ in hoa đen to đã loang thành màu xám. Vẫn đọc được TOM. Vừa đủ." }, pic: "act-label" },
      { item: "tombottle" },
      { say: "fergus", en: "Label's all [[cockled]], ink's run. It weren't like that at nine. I poured his flask from it at nine.", easy: "The label is wet and wrinkled, and the ink has run. It wasn't like that at nine.", vi: "Nhãn nhăn nhúm cả, mực nhòe hết. Lúc chín giờ tối đâu có thế. Chín giờ ông còn rót bình cho Tom từ chai này." },
      { say: "fergus", face: "angry", en: "Someone's had that [[under the tap]].", easy: "Someone has washed that bottle under the tap.", vi: "Có đứa đã đem nó xả dưới vòi nước." },
      { truth: "T3" },
      { if: "held_bottle", then: [
        { n: { en: "Fergus's eyes come round to you, slow as a lighthouse beam.", vi: "Mắt Fergus từ từ quay sang bạn, như vệt sáng ngọn hải đăng." }, on: "fergus" },
        { say: "fergus", en: "And that one had it in their hands, mind. Before.", vi: "Mà đứa này đã cầm nó trên tay rồi đấy nhé. Từ trước." },
        { n: { en: "Leo writes that down too. A stranger handled Tom's whisky hours before he was found beside an empty medicine bottle.", vi: "Leo ghi cả điều đó. Một người lạ đã cầm chai rượu của Tom vài giờ trước khi ông được tìm thấy cạnh lọ thuốc rỗng." }, on: "leo" },
        { say: "me", en: "I read the label and put it back.", vi: "Tôi đọc cái nhãn rồi đặt lại thôi." },
        { say: "leo", face: "cold", en: "I'm sure you did.", vi: "Tôi tin là {ac} làm thế." },
      ] },
      { n: { en: "Leo looks at the bottle for a long moment without touching it. Then he takes an [[evidence bag]] out of the drawer.", vi: "Leo nhìn cái chai một lúc lâu, không chạm vào. Rồi anh lấy một túi đựng vật chứng trong ngăn kéo ra." }, on: "leo" },
      { say: "leo", en: "Not a word in the bar, Fergus. Not to anyone.", vi: "Đừng hé một lời nào ở quán nhé, ông Fergus. Với bất kỳ ai." },
      { say: "fergus", en: "I've not said a word in that bar since nineteen sixty-one, son.", vi: "Từ năm sáu mốt tới giờ ông có hé lời nào ở cái quán ấy đâu, cháu." },
      { hide: "leo" },
      { n: { en: "Leo carries the bag into the back room. You hear a drawer, and then a key.", vi: "Leo mang cái túi vào phòng trong. Bạn nghe tiếng ngăn kéo, rồi tiếng chìa khóa." } },
      { show: "fergus", at: "c", face: "sad" },
      { n: { en: "Fergus gets up, slowly, one hand on the table. At the door he stops, and looks back at the back-room door.", vi: "Fergus chậm chạp đứng dậy, một tay chống bàn. Tới cửa, ông dừng lại, ngoái nhìn cánh cửa phòng trong." }, on: "fergus" },
      { say: "fergus", face: "sad", en: "Forty years. Never a drop of water in it.", vi: "Bốn mươi năm. Chưa từng có một giọt nước nào trong đó." },
      { hide: "*" },
      { go: "c3_gideon" },
    ],

    // ── 23:50 · GIDEON: 21:08 · 7:12 · 21:22 → T6; 2004; phong bì → gideon_private
    c3_gideon: [
      { cp: "c3_gideon" },
      { clock: "23:50" },
      { n: { en: "Ten to twelve. Headlights swing across the window and stop outside.", vi: "Mười hai giờ kém mười. Một cặp đèn pha quét qua cửa sổ rồi dừng bên ngoài." } },
      { n: { en: "Gideon's [[four-by-four]]. In the light from the doorway you can see the salt on it, dried white, right up to the bottom of the doors.", vi: "Chiếc xe hai cầu của Gideon. Dưới ánh đèn hắt ra từ ô cửa, bạn thấy muối bám trên xe, khô trắng, lên tận mép dưới cửa xe." } },
      { show: "gideon", at: "c" },
      { n: { en: "He comes in rubbing his hands and nods to you as if you'd met at a party.", vi: "Ông bước vào, xoa xoa hai tay, gật đầu chào bạn như thể hai người từng gặp nhau ở một bữa tiệc." }, on: "gideon" },
      { say: "gideon", en: "Leo. You wanted me. Terrible business. Terrible.", vi: "Leo. Cậu cần gặp tôi. Chuyện thật kinh khủng. Kinh khủng." },
      { say: "leo", face: "cold", en: "Did you see Tom before he came into the pub, Mr Marsh?", vi: "Ông có gặp Tom trước khi ông ấy tới quán không, ông Marsh?" },
      { say: "gideon", en: "Half past six. At his cottage. On the step, actually. He wouldn't let me inside.", vi: "Sáu rưỡi. Ở nhà ông ấy. Thực ra là ngoài bậc cửa. Ông ấy không cho tôi vào." },
      { say: "leo", en: "And on the causeway tonight. After it closed.", vi: "Và trên đường ngầm tối nay. Sau giờ đóng đường." },
      { say: "gideon", en: "I was. Dinner on the mainland, a call I couldn't get away from. Here.", vi: "Đúng vậy. Ăn tối bên đất liền, rồi một cuộc điện thoại tôi không dứt ra được. Đây." },
      { n: { en: "He puts his phone on the table and turns it round for Leo to read.", vi: "Ông đặt điện thoại lên bàn, xoay màn hình cho Leo đọc." }, on: "gideon" },
      { n: { en: "Cllr R. Hale · incoming · 21:08 · 7:12", vi: "Cllr R. Hale · incoming · 21:08 · 7:12 — ủy viên hội đồng R. Hale · cuộc gọi đến · 21:08 · dài 7 phút 12 giây" } },
      { note: { en: "Gideon's phone: Cllr R. Hale, incoming, 21:08, 7 min 12 s (to about 21:15).", vi: "Điện thoại Gideon: ủy viên R. Hale gọi đến 21:08, dài 7 phút 12 giây (tới khoảng 21:15)." } },
      { set: { c3_gideon_call_seen: true } },
      { say: "gideon", en: "Seven minutes of a nervous man. I couldn't drive and listen. When he'd finished, I came straight back.", vi: "Bảy phút nghe một người đang bồn chồn. Tôi không thể vừa lái xe vừa nghe được. Ông ta nói xong là tôi về thẳng." },
      { say: "leo", en: "And when you passed the box?", vi: "Thế lúc ông đi ngang cái chòi?" },
      { n: { en: "For the first time, the smile goes.", vi: "Lần đầu tiên, nụ cười tắt hẳn." }, on: "gideon" },
      { say: "gideon", face: "sad", en: "Twenty-two minutes past. I looked at the clock, because the water was at my tyres and I didn't like it.", vi: "Chín giờ hai mươi hai tối. Tôi có nhìn đồng hồ, vì nước đã ngập tới lốp và tôi không thích thế chút nào." },
      { say: "gideon", face: "sad", en: "Tom was standing by his truck with his lamp, waving. Waving out towards the channel. There was a boat light out there.", vi: "Tom đứng cạnh xe tải, cầm đèn bão mà vẫy. Vẫy về phía con kênh. Ngoài đó có một ngọn đèn thuyền." },
      { say: "gideon", face: "sad", en: "I told myself he was signalling the boat. They'd seen each other. They didn't need me.", vi: "Tôi tự nhủ ông ấy ra hiệu cho thuyền. Hai bên đã nhìn thấy nhau rồi. Họ không cần tôi." },
      { truth: "T6" },
      { n: { en: "Nobody says anything. Gideon looks at his own hands on the table, as if they belonged to somebody else.", vi: "Không ai nói gì. Gideon nhìn hai bàn tay mình trên mặt bàn, như thể chúng là tay người khác." }, on: "gideon" },
      { say: "leo", en: "Anna Rowe's survey finished your first bridge. Twenty years ago this week.", vi: "Bản khảo sát của bà Anna Rowe đã khai tử cây cầu đầu tiên của ông. Tròn hai mươi năm tuần này." },
      { say: "gideon", face: "cold", en: "It did. The inquiry opened that Monday. Sunday night I was at dinner with our [[barrister]] in Newcastle. Ask him.", vi: "Đúng thế. Phiên điều trần khai mạc đúng thứ Hai tuần đó. Tối Chủ nhật tôi ăn tối với luật sư của chúng tôi ở Newcastle. Cứ hỏi ông ấy." },
      { say: "leo", en: "My father's notes say that was checked. I've asked CID to check it again.", vi: "Ghi chép của bố tôi nói đã xác minh chuyện đó. Tôi đã nhờ bên điều tra kiểm tra lại." },
      { sfx: "buzz" },
      { n: { en: "Leo's radio goes again. Berwick, wanting times. He takes it outside, and the door swings shut behind him.", vi: "Bộ đàm của Leo lại kêu. Bên Berwick, cần mốc giờ. Anh cầm ra ngoài nghe, cánh cửa đung đưa khép lại sau lưng anh." } },
      { n: { en: "Gideon lets out a breath and smiles at you again. It doesn't quite fit any more.", vi: "Gideon thở hắt ra rồi lại mỉm cười với bạn. Nụ cười không còn vừa vặn nữa." }, on: "gideon" },
      { say: "gideon", en: "Insurance. You must see a lot of this.", vi: "Bảo hiểm. Chắc {ac} gặp những chuyện này nhiều lắm." },
      { say: "me", en: "I see a lot of people explaining why they were somewhere.", vi: "Tôi gặp nhiều người giải thích vì sao họ có mặt ở một chỗ nào đó." },
      { n: { en: "You look out of the window at his car.", vi: "Bạn nhìn ra cửa sổ, về phía chiếc xe của ông." } },
      { say: "me", en: "Seven minutes, with the sea coming in. Not about dinner. \"Friday will finish me.\" That's what you told Tom at 19:50.", vi: "Bảy phút, trong lúc nước biển đang lên. Không phải vì chuyện ăn tối. “Thứ Sáu này là tôi sạt nghiệp.” Ông nói với Tom như vậy lúc 19:50." },
      { cam: "push", ms: 7000 },
      { n: { en: "Gideon is quiet for so long that you hear the kettle tick again.", vi: "Gideon im lặng lâu tới mức bạn lại nghe thấy tiếng ấm nước tích tắc." }, on: "gideon" },
      { fx: "shiver" }, { sfx: "clock" },
      { fx: "pulse" },
      { cam: null },
      { say: "gideon", face: "scared", en: "There was an envelope. For a [[councillor]], in a car park. Before Friday's vote.", vi: "Có một cái phong bì. Cho một ủy viên hội đồng, ở một bãi đỗ xe. Trước cuộc bỏ phiếu thứ Sáu." },
      { say: "gideon", en: "Yes, a [[bribe]]. You think I killed him. I'd rather you knew what I was actually doing.", vi: "Phải, là hối lộ. {Ac} nghĩ tôi giết ông ấy. Tôi thà để {ac} biết mình thật sự đã làm gì." },
      { say: "gideon", face: "sad", en: "My grandfather built that house to look at the sea. I'm the one who'll have to sell it to the bank.", vi: "Ông nội tôi xây ngôi nhà ấy để ngắm biển. Còn tôi sẽ là người phải bán nó cho ngân hàng." },
      { choice: [
        { tag: "kind", en: "(Keep it to yourself for now.)", vi: "(Tạm giữ kín chuyện này.)", set: { gideon_private: true }, add: { gideon: 1 }, then: [
          { n: { en: "When Leo comes back in, you say nothing about envelopes.", vi: "Khi Leo quay vào, bạn không nhắc gì tới phong bì." } },
          { n: { en: "Gideon notices. At the door, buttoning his coat, he gives you a small nod. Not a party nod this time.", vi: "Gideon để ý thấy. Ra tới cửa, vừa cài khuy áo, ông khẽ gật đầu với bạn. Lần này không phải cái gật đầu ở bữa tiệc." }, on: "gideon" },
          { say: "gideon", face: "relieved", en: "I owe you one, I think.", vi: "Tôi nghĩ là tôi nợ {ac} một lần." },
        ] },
        { tag: "direct", en: "(Tell Leo when he comes back.)", vi: "(Kể với Leo khi anh quay vào.)", set: { gideon_private: false }, add: { leo: 1 }, then: [
          { show: "leo", at: "c", face: "cold" },
          { say: "me", en: "Mr Marsh has something to tell you. About a councillor, and an envelope.", vi: "Ông Marsh có chuyện muốn nói với anh. Về một ủy viên hội đồng, và một cái phong bì." },
          { n: { en: "Gideon tells it again, to Leo this time, in a flat voice. When he has finished, he doesn't look at you.", vi: "Gideon kể lại, lần này với Leo, giọng đều đều. Kể xong, ông không nhìn bạn." }, on: "gideon" },
          { say: "gideon", face: "cold", en: "I'll remember that.", vi: "Tôi sẽ nhớ chuyện này." },
          { say: "leo", face: "soft", en: "Thank you. I'll record what he said. The call still needs checking.", vi: "Cảm ơn {ac}. Tôi sẽ ghi lời ông ấy. Cuộc gọi đó vẫn cần được kiểm tra." },
        ] },
      ] },
      { hide: "*" }, { cam: null },
      { go: "c3_nell" },
    ],

    // ── 00:00 · NELL mang bánh (told_nell → Nell bậc 2: “had words at one” → L4)
    c3_nell: [
      { title: { en: "MIDNIGHT", vi: "NỬA ĐÊM" } }, { clock: "00:00" },
      { n: { en: "Midnight. Across the harbour, every window of the Lantern is lit. Nobody on the island is going to bed.", vi: "Nửa đêm. Bên kia bến, ô cửa sổ nào của The Lantern cũng sáng đèn. Không ai trên đảo định đi ngủ." } },
      { sfx: "door" },
      { mood: "warm" },
      { show: "nell", at: "c", face: "sad" },
      { n: { en: "The door opens, and Nell comes in with a plate under a tea towel and a flask under her arm.", vi: "Cửa mở, Nell bước vào, tay bưng một cái đĩa phủ khăn lau bếp, nách kẹp một bình giữ nhiệt." }, on: "nell" },
      { say: "nell", en: "Sandwiches. Ham. You've neither of you eaten, I know you haven't.", vi: "Bánh mì kẹp. Giăm bông. Hai đứa chưa đứa nào ăn gì, bác biết thừa." },
      { n: { en: "She puts the plate down in front of you and pours Leo a cup of tea without asking how he takes it. She knows.", vi: "Bà đặt cái đĩa trước mặt bạn và rót cho Leo một cốc trà, không cần hỏi anh uống thế nào. Bà biết." }, on: "nell" },
      { n: { en: "Then she stands with the tea towel in her hands, folding it and unfolding it, looking at the back-room door.", vi: "Rồi bà đứng đó, tay cầm cái khăn lau bếp, gấp lại rồi mở ra, mắt nhìn cánh cửa phòng trong." }, on: "nell" },
      { mood: "noir" },
      { say: "nell", face: "broken", en: "He wasn't meant to be out there on his own.", vi: "Đáng lẽ ông ấy không phải ở ngoài đó một mình." },
      {"say":"me","en":"He asked me to meet him. Why didn't he wait?","vi":"Ông ấy hẹn gặp {toiNell}. Sao ông ấy không đợi?","tone":"quiet, asking through shock"},
      {"n":{"en":"Nell smooths the towel until every corner meets. She doesn't look at you.","vi":"Nell vuốt chiếc khăn cho các góc trùng khít nhau. Bà không nhìn bạn."}},
      {"say":"nell","en":"If Tom thought somebody needed him, nothing else came first.","vi":"Nếu Tom nghĩ có người cần mình, ông ấy sẽ gác mọi chuyện khác lại.","tone":"soft, careful"},
      { n: { en: "Nobody answers. There isn't an answer.", vi: "Không ai đáp. Cũng chẳng có câu trả lời nào." }, on: "nell" },
      { if: "told_nell", then: [
        { say: "nell", face: "sad", en: "Tom and me had words at one. Family business.", easy: "Tom and I argued at one o'clock. It was a family matter.", vi: "Bác với ông Tom có to tiếng lúc một giờ trưa. Chuyện trong nhà thôi." },
        { n: { en: "She says it to the tea towel, not to you. Then she folds it once more and tucks it under her arm.", vi: "Bà nói với cái khăn, không phải với bạn. Rồi bà gấp nó thêm lần nữa, kẹp vào nách." }, on: "nell" },
        { set: { p_nell_knew: true } },
        { note: { en: "Nell: 'Tom and me had words at one. Family business.'", vi: "Nell: “Bác với ông Tom có to tiếng lúc một giờ trưa. Chuyện trong nhà.”" } },
      ] },
      { say: "nell", face: "sad", en: "Eat something, pet. Go on.", vi: "Ăn chút gì đi cháu. Ăn đi nào." },
      { if: "told_nell", then: [
        { say: "me", en: "Thank you, Nell.", vi: "Cháu cảm ơn bác." },
        { n: { en: "She touches your shoulder on her way out, the way she touched Tom's blanket on the slipway.", vi: "Lúc đi ra, bà chạm nhẹ vào vai bạn, như lúc ở dốc bến bà chạm vào tấm chăn của Tom." }, on: "nell" },
      ] },
      { hide: "nell" },
      { n: { en: "She crosses the dark harbour. Through the window, you watch her small figure all the way to the pub's lit doorway.", vi: "Bà đi qua bến trong bóng tối. Qua cửa sổ, bạn dõi theo dáng người nhỏ bé ấy tới tận ô cửa sáng đèn của quán." } },
      { go: "c3_pocket" },
    ],

    // ── 00:05 · TÚI ÁO TOM: explore các túi vật chứng → compare “nếu ông tự uống” (thất bại mềm) → p_not_suicide + p_bottle_route
    c3_pocket: [
      { cp: "c3_pocket" },
      { clock: "00:05" },
      { show: "leo", at: "c", face: "cold" },
      { n: { en: "Leo lays Tom's pocket contents on the table in separate bags. He puts the bagged flask beside them.", vi: "Leo bày đồ trong túi áo Tom lên bàn, mỗi món trong một túi riêng. Anh đặt túi đựng bình rượu cạnh chúng." }, on: "leo", pic: "act-pocket" },
      { say: "leo", en: "Write it down for me. Everything you saw at the cottage. In order.", vi: "{Ac} viết lại giúp tôi. Mọi thứ {ac} thấy ở nhà ông ấy. Theo thứ tự." },
      { hide: "leo" },
      { n: { en: "You write. Halfway down the page you stop, and look at the bags.", vi: "Bạn viết. Được nửa trang thì bạn dừng lại, nhìn mấy cái túi." } },
      { explore: { goal: { en: "Examine Tom's pocket items and flask", vi: "Xem đồ trong túi áo Tom và bình rượu" }, need: 3, done: { en: "Put the pen down", vi: "Đặt bút xuống" }, spots: [
        { id: "matches", x: 22, y: 50, clue: true, label: { en: "Matches", vi: "Bao diêm" }, then: [
          { n: { en: "Matches. The box is smeared black where his fingers held it.", vi: "Bao diêm. Vỏ hộp lem đen chỗ ngón tay ông cầm." } } ] },
        { id: "pencil", x: 38, y: 58, clue: true, label: { en: "Pencil", vi: "Bút chì" }, then: [
          { n: { en: "A stub of pencil. Black along its whole length.", vi: "Một mẩu bút chì. Đen suốt cả thân." } } ] },
        { id: "hanky", x: 54, y: 48, clue: true, label: { en: "Handkerchief", vi: "Khăn tay" }, then: [
          { n: { en: "A handkerchief, folded once. Black thumbprints on every corner.", vi: "Một chiếc khăn tay, gấp đôi. Góc nào cũng có dấu ngón cái đen." } } ] },
        { id: "vial", x: 70, y: 56, clue: true, label: { en: "The little brown bottle", vi: "Cái lọ nhỏ màu nâu" }, then: [
          { n: { en: "And the little brown bottle. Oramorph, with Tom's name on the chemist's label. Empty, [[polished]] clean as a new glass.", vi: "Và cái lọ nhỏ màu nâu. Oramorph, nhãn nhà thuốc ghi tên Tom. Rỗng. Sạch như một cái ly mới." }, pic: "it-vial" },
          { think: { en: "Not even sticky. Helen said it on the slipway. Oramorph's a syrup.", vi: "Không hề dính. Bà Helen đã nói thế ở dốc bến. Oramorph là siro." } },
          { if: s => !s.has("vial"), then: [{ item: "vial" }] } ] },
        { id: "flask", x: 84, y: 46, clue: true, label: { en: "Tom's flask", vi: "Bình rượu của Tom" }, then: [
          { n: { en: "Tom's flask, sealed in a bag of its own. Fergus filled it at nine. 'Fill it. Long night.'", vi: "Bình rượu của Tom, niêm phong trong một túi riêng. Chín giờ Fergus đã rót đầy. “Rót đầy vào. Đêm nay dài.”" } },
          { if: s => !s.has("flask"), then: [{ item: "flask" }] } ] },
      ] } },
      { if: s => !s.has("vial"), then: [{ item: "vial" }] },
      { n: { en: "Matches. Pencil. Handkerchief. Every one of them smeared black. And the little brown bottle, clean as a new glass.", vi: "Bao diêm. Bút chì. Khăn tay. Thứ nào cũng lem đen. Và cái lọ nhỏ màu nâu, sạch như một cái ly mới." } },
      {"think":{"en":"We know what was in his pocket. We don't know when each thing was put there. Does the suicide story explain it all?","vi":"Ta biết túi áo ông có gì. Chưa biết từng thứ được bỏ vào lúc nào. Câu chuyện tự tử có giải thích hết không?"}},
      { compare: {
        title: { en: "Assessor's eye — Tom's pocket", vi: "Mắt thẩm định — Túi áo Tom" },
        left: { title: { en: "If he drank it himself", vi: "Nếu ông tự uống" }, lines: [
          { en: "His fingers black from writing on the wall.", vi: "Ngón tay ông đen vì viết lên vách." },
          { en: "Everything in that pocket smeared black.", vi: "Mọi thứ trong túi áo ấy lem đen." },
          { en: "The bottle sticky with syrup, and black prints all over it.", vi: "Cái lọ dính siro, và đầy dấu tay đen." },
          { en: "A flask with room left for a bottle of syrup.", vi: "Bình rượu còn chỗ cho một lọ siro." },
        ] },
        right: { title: { en: "On the table", vi: "Trên bàn" }, lines: [
          { en: "His fingers black.", vi: "Ngón tay ông đen." },
          { en: "The other pocket items are smeared black — the matches too.", vi: "Những món khác trong túi lem đen — cả bao diêm." },
          { en: "The bottle polished clean, not even sticky, as if someone had wiped it on a tea towel.", vi: "Cái lọ sạch bóng, không hề dính, như thể có người đã lau nó bằng khăn lau bếp." },
          { en: "A flask filled to the top at nine. 'Fill it. Long night.'", vi: "Bình rượu rót đầy tới miệng lúc chín giờ. “Rót đầy vào. Đêm nay dài.”" },
        ] },
        diffs: [2, 3], tries: 3,
        ok: [{ fx: "flash" }, { sfx: "truth" }, { go: "c3_notsuicide" }],
        fail: [
          { think: { en: "The clean bottle and full flask need explaining. Neither tells you who added anything, or when.", vi: "Cần giải thích lọ sạch và bình đầy. Chưa thứ nào cho biết ai đã thêm gì, hay thêm lúc nào." } },
          { compare: {
            title: { en: "Assessor's eye — Tom's pocket", vi: "Mắt thẩm định — Túi áo Tom" },
            left: { title: { en: "If he drank it himself", vi: "Nếu ông tự uống" }, lines: [
              { en: "His fingers black from writing on the wall.", vi: "Ngón tay ông đen vì viết lên vách." },
              { en: "Everything in that pocket smeared black.", vi: "Mọi thứ trong túi áo ấy lem đen." },
              { en: "The bottle sticky with syrup, and black prints all over it.", vi: "Cái lọ dính siro, và đầy dấu tay đen." },
              { en: "A flask with room left for a bottle of syrup.", vi: "Bình rượu còn chỗ cho một lọ siro." },
            ] },
            right: { title: { en: "On the table", vi: "Trên bàn" }, lines: [
              { en: "His fingers black.", vi: "Ngón tay ông đen." },
              { en: "The other pocket items are smeared black — the matches too.", vi: "Những món khác trong túi lem đen — cả bao diêm." },
              { en: "The bottle polished clean, not even sticky, as if someone had wiped it on a tea towel.", vi: "Cái lọ sạch bóng, không hề dính, như thể có người đã lau nó bằng khăn lau bếp." },
              { en: "A flask filled to the top at nine. 'Fill it. Long night.'", vi: "Bình rượu rót đầy tới miệng lúc chín giờ. “Rót đầy vào. Đêm nay dài.”" },
            ] },
            diffs: [2, 3], tries: 3,
            ok: [{ fx: "flash" }, { sfx: "truth" }, { go: "c3_notsuicide" }],
            fail: [
              { n: { en: "Your eyes keep coming back to two things. The clean little bottle. The full flask.", vi: "Mắt bạn cứ quay lại hai thứ. Cái lọ nhỏ sạch bóng. Cái bình đầy." } },
              { go: "c3_notsuicide" },
            ] } },
        ] } },
      { go: "c3_notsuicide" },
    ],

    c3_notsuicide: [
      { n: { en: "Suppose Tom added the medicine himself. He then cleaned the empty bottle, despite his shaking hands, and returned it to a sooty pocket.", vi: "Giả sử Tom tự thêm thuốc. Rồi dù tay run, ông lau sạch lọ rỗng và cất lại vào một túi áo đầy muội." } },
      { n: { en: "Possible. But it leaves a lot unexplained.", vi: "Có thể. Nhưng như thế vẫn còn nhiều điều chưa giải thích được." } },
      { n: { en: "Fergus filled the flask at nine. Tom could have emptied some later. The full flask alone proves nothing.", vi: "Chín giờ Fergus rót đầy bình. Tom có thể đã đổ bớt đi sau đó. Chỉ riêng việc bình đầy chưa chứng minh được gì." } },
      { n: { en: "The TOM label got wet after nine. Fergus suspects rinsing. Why clean the bottle, if Tom only dosed his own flask?", vi: "Nhãn TOM bị ướt sau chín giờ. Fergus nghi chai đã bị xả nước. Sao phải rửa chai, nếu Tom chỉ bỏ thuốc vào bình riêng?" } },
      // Cờ lõi giữ tên cũ: giả thuyết đủ để điều tra, không thay cho xét nghiệm.
      { set: { p_not_suicide: true, p_bottle_route: true } },
      { show: "leo", at: "c", face: "cold" },
      { say: "me", en: "The medicine could already have been in the whisky. The clean vial could have been planted.", vi: "Thuốc có thể đã ở sẵn trong rượu. Lọ sạch có thể đã bị bỏ vào túi để dựng chuyện." },
      { n: { en: "Leo looks at the bags for a long time. Then at the back-room door, where the whisky bottle with its ruined label is locked away.", vi: "Leo nhìn mấy cái túi rất lâu. Rồi nhìn cánh cửa phòng trong, nơi cái chai whisky với tấm nhãn đã hỏng đang bị khóa kín." }, on: "leo" },
      { say: "leo", face: "sad", tone: "quiet, newly alert", en: "Then we can't treat this as suicide.", vi: "Vậy thì chúng ta không thể coi đây là tự tử." },
      { say: "leo", tone: "practical, controlled", en: "CID will test the bottle and the flask. We keep every sample.", vi: "Bên điều tra sẽ xét nghiệm chai và bình rượu. Chúng ta giữ lại mọi mẫu." },
      { n: { en: "He says it quietly, to the table, as if he'd rather not have heard it.", vi: "Anh nói khẽ, mắt nhìn xuống bàn, như thể anh thà không phải nghe điều đó." }, on: "leo" },
      { note: { en: "Working theory: the TOM whisky may have been tampered with before Fergus poured it. The rinsed bottle and clean vial need investigation and tests.", vi: "Giả thuyết: chai whisky TOM có thể đã bị can thiệp trước khi Fergus rót. Chai bị xả nước và lọ sạch cần được điều tra, xét nghiệm." } },
      { go: "c3_out" },
    ],

    // ── 00:15 · Leo thả bạn (giữ chìa khóa) — Helen dưới đèn bến
    c3_out: [
      { clock: "00:15" },
      { if: s => s.f.leo_id === "lie" || s.f.took_draft, then: [
        { n: { en: "Quarter past twelve. Leo doesn't get up. He just tips his chin at the door. The cold comes in off the water.", vi: "Mười hai giờ mười lăm. Leo không đứng dậy. Anh chỉ hất cằm về phía cửa. Hơi lạnh từ mặt nước tràn vào." }, on: "leo" },
      ], else: [
        { n: { en: "Quarter past twelve. Leo opens the door for you. The cold comes in off the water.", vi: "Mười hai giờ mười lăm. Leo mở cửa cho bạn. Hơi lạnh từ mặt nước tràn vào." }, on: "leo" },
      ] },
      { say: "leo", en: "Stay near the harbour. If you remember anything else, come straight back.", vi: "{Ac} cứ ở gần bến nhé. Nhớ ra điều gì khác thì quay lại đây ngay." },
      { say: "me", en: "My keys?", vi: "Chìa khóa xe của tôi?" },
      { say: "leo", en: "They stay with me for now.", vi: "Tạm thời tôi giữ." },
      { hide: "*" },
      { bg: "harbour" }, { amb: "sea" }, { mood: "cold" },
      { n: { en: "You step out onto the harbour wall. Behind you, the door closes on the light and the kettle and the man in the back room.", vi: "Bạn bước ra tường chắn sóng. Sau lưng bạn, cánh cửa khép lại, giấu đi ánh đèn, cái ấm nước, và người đàn ông ở phòng trong." } },
      { n: { en: "A car is parked under the harbour lamp with its engine off. Someone is standing beside it, arms wrapped round herself.", vi: "Một chiếc xe đỗ dưới ngọn đèn bến, máy đã tắt. Một người phụ nữ đứng cạnh xe, hai tay ôm lấy mình." } },
      { cg: "harbour-lamp" }, { cam: "pull", ms: 8000 },
      { show: "helen", at: "c", face: "scared" },
      { n: { en: "Dr Vosper. Her face is the colour of the lamp.", vi: "Bác sĩ Vosper. Mặt bà cùng một màu với ngọn đèn." }, on: "helen" },
      { cam: null },
      { say: "helen", face: "scared", en: "Can I talk to you? Not him. You.", vi: "Tôi nói chuyện với {ac} được không? Không phải với anh ta. Với {ac}." },
      { hide: "*" }, { cg: null }, { cam: null }, { mood: null },
      { end: "c3_end" },
    ],
  },

  endings: {
    c3_end: { ch: 3, title: { en: "The Outsider", vi: "Người ngoài" },
      sum: { en: "Everyone said suicide. A rinsed whisky bottle and a clean vial made that story uncertain.", vi: "Ai cũng nói là tự tử. Chai whisky đã tráng và lọ thuốc sạch khiến lời giải ấy không còn chắc chắn." },
      text: { en: "The car seat points to a taller driver. The clean vial and rinsed whisky bottle suggest tampering. Leo keeps your keys and opens that possibility. Dr Vosper waits under the harbour lamp.", vi: "Ghế lái cho thấy có thể một người cao hơn đã cầm lái. Lọ sạch và chai whisky bị xả nước gợi ý có người can thiệp. Leo giữ chìa khóa xe và xem xét khả năng ấy. Bác sĩ Vosper chờ dưới ngọn đèn bến." },
      next: "c4_open", nextTitle: { en: "Chapter 4", vi: "Chương 4" } },
    e8_refuge: { ch: 3, final: true, title: { en: "The Refuge Box", vi: "Chòi trú nạn" },
      sum: { en: "You ran from Leo and tried the causeway at high water.", vi: "Bạn trốn Leo và cố lội qua đường ngầm lúc nước lớn." },
      text: { en: "You sat in the box beside Tom's last soot line until dawn. When the road came out of the sea, the police were waiting at the end of it — for you. Nobody asked about a clean bottle or a full flask. Tom had gone out to her. Everyone said so.", vi: "Bạn ngồi trong chòi cạnh dòng muội cuối cùng của Tom cho tới sáng. Khi con đường nổi lên khỏi mặt biển, cảnh sát đã chờ sẵn ở đầu đường — chờ bạn. Không ai hỏi gì về một cái lọ sạch hay một bình rượu đầy. Tom đã ra với bà ấy. Ai cũng nói vậy." } },
  },
});
// BETWEEN TIDES · CHƯƠNG 4 — BIỂN KHÔNG ĐỌC BẢNG GIỜ (00:15 → 01:20). Văn: ../../GiuaHaiConNuoc-truyen-ch4.md (+ Nhánh rẽ).
// Cảnh: bến (Helen, 00:15) → nhà Tom (00:30: 1471, ảnh vách, cọc đo, Mắt thẩm định, ai gọi được 21:11) → đi bộ về (Leo: hai cặp đèn; Gideon 01:00)
//   → thuyền MAIRI ROSE (Callum) → “I didn't kill Tom. I killed your mother.”
// Cờ đọc: climbed_box · gideon_private · took_draft · told_nell · at_harbour · told_leo · leo · helen · callum
// Cờ đặt: helen_promise · helen_box_early (chỉ lời nhân chứng, không tự trao p_cellar_call) · callum_threat (dọa → logbook sớm, p_nell_knew, p_fetched)
// Luật cân bằng: không hứa → bạn kể Leo chuyện ống thuốc: leo +1, Helen dừng bậc 1 · Helen bậc 2 = hứa + helen ≥ 2 → kể chuyện bốt
//   · callum được nâng tối thiểu 1 trước đối chất (tương đương “= 1 sau lời thú”), rồi nhẹ +1 / dọa −1 · climbed_box → leo +1.
// Đổi thứ tự nhẹ so với văn: lời xin “Don't put the ampoules…” và lựa chọn hứa đặt TRƯỚC đoạn “For a moment…” để bậc 2 của Helen
//   (mở bằng chính lời hứa) chèn vào đúng chỗ ánh mắt bà “dừng lại ở The Lantern”.
StoryEngine.chapter({
  scenes: {
    "cottage-dog": { kind: "study", name: { en: "The keeper's cottage", vi: "Nhà người gác đường" }, amb: "room" },
    "it-logbook": {},
  },
  words: {
    "ampoule": { vi: "ống thuốc (thủy tinh, tiêm)", ex: "Three ampoules. Sealed. A surgery box." },
    "sealed": { vi: "còn niêm phong", ex: "The ampoules are still sealed. I saw them." },
    "coward": { vi: "kẻ hèn nhát", ex: "If I'd not been a coward about what I'd done." },
    "withheld": { vi: "giấu số (cuộc gọi)", ex: "The caller withheld their number." },
    "paperwork": { vi: "giấy tờ, thủ tục", ex: "The phone company can. That's paperwork. Days." },
    "under the table": { vi: "thấp hơn bảng giờ thủy triều in sẵn", ex: "U's under. Under the table." },
    "gauge": { vi: "cọc đo mực nước", ex: "The gauge post on the iron leg." },
    "high pressure": { vi: "áp cao (thời tiết)", ex: "Glass is high, wind's off the land. Sea's been half a metre under all day." },
    "extension": { vi: "máy phụ (cùng số với máy chính)", ex: "The extension in the cellar." },
    "porch": { vi: "hiên", ex: "Phone box beside the porch." },
    "went down": { vi: "(thuyền) chìm, (người) mất ngoài biển", ex: "Dad went down off the Farnes the year before." },
    "custody hearing": { vi: "phiên tòa giành quyền nuôi con", ex: "There's a custody hearing next month." },
    "slipway": { vi: "dốc bến (đường trượt thuyền)", ex: "You go down the slipway, to the one boat with a light." },
    "buoy": { vi: "phao (đánh dấu trên biển)", ex: "Out on the channel a buoy light blinks." },
  },

  recap: [
    { ch: 4, when: "c4_open", t: { en: "At 00:15 Dr Vosper told you she took Tom three ampoules of morphine at 19:30 — and found the Oramorph already gone.", vi: "Lúc 00:15, bác sĩ Vosper kể bà mang cho Tom ba ống morphine lúc 19:30 — và thấy lọ Oramorph đã không còn." } },
    { ch: 4, when: "c4_open", t: { en: "By 21:15 she was back at Tom's, saw his truck going out and Leo's car at the head of the road — and reversed.", vi: "Tới 21:15 bà đã quay lại nhà Tom, thấy xe tải ông chạy ra và xe Leo ở đầu đường — rồi lùi xe về." } },
    { ch: 4, if: s => s.f.helen_promise === true, t: { en: "You promised Helen to keep the ampoules out of your statement until morning.", vi: "Bạn hứa với Helen giữ chuyện mấy ống thuốc ngoài lời khai cho tới sáng." } },
    { ch: 4, if: s => s.f.helen_promise === false, t: { en: "You wouldn't keep the ampoules from Leo. Helen told him herself — and you told him they were still sealed.", vi: "Bạn không chịu giấu Leo chuyện mấy ống thuốc. Helen tự kể với anh — còn bạn nói chúng vẫn còn niêm phong." } },
    { ch: 4, if: s => s.f.helen_box_early, t: { en: "Helen admitted she was in the phone box at 21:10 and couldn't dial. From there she saw the bar: Fergus was there. Nell wasn't.", vi: "Helen thú nhận lúc 21:10 bà ở trong bốt điện thoại và không bấm nổi số. Từ đó bà thấy quầy: Fergus có ở đó. Nell thì không." } },
    { ch: 4, when: "c4_cottage", t: { en: "1471 on Tom's phone: a call at 21:11, number withheld. Tom drove out at 21:13.", vi: "1471 trên máy nhà Tom: một cuộc gọi lúc 21:11, giấu số. 21:13 Tom lái xe ra." } },
    { ch: 4, when: "c4_cottage", t: { en: "The sea ran 0.6 m under the table: the road really closed at 21:32. Tom was alive at 21:44, still writing readings.", vi: "Biển thấp hơn bảng 0,6 m: đường ngầm thật sự đóng lúc 21:32. 21:44 Tom vẫn sống, vẫn ghi số đo." } },
    { ch: 4, when: "c4_cottage", t: { en: "Tom waved towards the boat and kept taking readings. His actions suggest he went out to reach someone.", vi: "Tom vẫy đèn về phía thuyền và tiếp tục ghi số đo. Hành động ấy cho thấy ông ra đó để tìm một người." } },
    { ch: 4, when: "c4_walk", t: { en: "Tom's dog Skerry chose you. Leo told you his father wrote up your mother's death — and that at nine he saw two lots of lights on the causeway.", vi: "Skerry, con chó của Tom, đã chọn bạn. Leo kể bố anh viết biên bản cái chết của mẹ bạn — và năm chín tuổi anh thấy hai cặp đèn trên đường ngầm." } },
    { ch: 4, when: "c4_walk", if: s => !!s.f.gideon_private, t: { en: "At one o'clock Gideon walked home after three brandies. 'Keys are in it. If you need it tonight.'", vi: "Một giờ sáng, Gideon đi bộ về sau ba ly brandy. “Chìa khóa cắm sẵn trong xe. Nếu đêm nay cần.”" } },
    { ch: 4, when: "c4_walk", if: s => !s.f.gideon_private, t: { en: "At one o'clock Gideon walked home past you without a word.", vi: "Một giờ sáng, Gideon đi bộ về, ngang qua bạn không một lời." } },
    { ch: 4, if: s => s.f.callum_threat === false, t: { en: "On the MAIRI ROSE you asked Callum about his daughter. He told you he went to Tom's gate after nine.", vi: "Trên thuyền MAIRI ROSE, bạn hỏi Callum về con gái anh. Anh kể sau chín giờ anh tới cổng nhà Tom." } },
    { ch: 4, if: s => s.f.callum_threat === true, t: { en: "You threw the custody hearing at Callum. He shoved Tom's logbook at you: 'Ask my mother where I was that night.'", vi: "Bạn đem phiên tòa nuôi con ra ép Callum. Anh dúi cuốn sổ của Tom vào người bạn: “Hỏi mẹ tôi xem đêm đó tôi ở đâu.”" } },
    { ch: 4, when: "c4_boat", t: { en: "'I didn't kill Tom. I killed your mother.'", vi: "“Tôi không giết Tom. Tôi đã giết mẹ {ac}.”" } },
  ],

  flow: [
    { ch: 4, row: 0, id: "c4_open", kind: "cp", scene: "harbour", label: { en: "The doctor", vi: "Bà bác sĩ" }, sum: { en: "Helen's three ampoules.", vi: "Ba ống thuốc của Helen." } },
    { ch: 4, row: 1, kind: "opt", key: "helen_promise", val: true, label: { en: "Promise Helen", vi: "Hứa với Helen" }, sum: { en: "She tells Leo herself, in the morning.", vi: "Sáng mai bà tự nói với Leo." }, hint: { en: "Helen asks for one night.", vi: "Helen xin một đêm." } },
    { ch: 4, row: 1, kind: "opt", key: "helen_promise", val: false, label: { en: "Tell Leo", vi: "Kể với Leo" }, sum: { en: "Leo trusts you more. Helen closes like a door.", vi: "Leo tin bạn hơn. Helen khép lại như một cánh cửa." }, hint: { en: "Helen asks for one night.", vi: "Helen xin một đêm." } },
    { ch: 4, row: 2, kind: "opt", key: "helen_box_early", val: true, label: { en: "The phone box", vi: "Bốt điện thoại" }, sum: { en: "Helen was in the box at 21:10. Nell wasn't at the bar.", vi: "21:10 Helen ở trong bốt. Nell không ở quầy." }, hint: { en: "Only if Helen trusts you enough.", vi: "Chỉ khi Helen đủ tin bạn." } },
    { ch: 4, row: 3, id: "c4_cottage", kind: "cp", scene: "cottage", label: { en: "1471", vi: "1471" }, sum: { en: "A withheld call at 21:11. The sea under the table.", vi: "Cuộc gọi giấu số lúc 21:11. Biển thấp hơn bảng." } },
    { ch: 4, row: 4, id: "c4_walk", kind: "cp", scene: "harbour", label: { en: "Two lots of lights", vi: "Hai cặp đèn" }, sum: { en: "Leo's father. Gideon walks home.", vi: "Bố của Leo. Gideon đi bộ về." } },
    { ch: 4, row: 5, id: "c4_boat", kind: "cp", scene: "harbour", label: { en: "MAIRI ROSE", vi: "MAIRI ROSE" }, sum: { en: "Callum, and the back gate.", vi: "Callum, và cổng sau." } },
    { ch: 4, row: 6, kind: "opt", key: "callum_threat", val: false, label: { en: "Ask about Mairi", vi: "Hỏi về Mairi" }, sum: { en: "Callum will remember that.", vi: "Callum sẽ nhớ điều đó." }, hint: { en: "How do you make him talk?", vi: "Làm sao để anh ta nói?" } },
    { ch: 4, row: 6, kind: "opt", key: "callum_threat", val: true, label: { en: "The custody hearing", vi: "Phiên tòa nuôi con" }, sum: { en: "He talks — and throws you Tom's logbook. You lose him.", vi: "Anh nói — và ném cho bạn cuốn sổ của Tom. Bạn mất anh." }, hint: { en: "How do you make him talk?", vi: "Làm sao để anh ta nói?" } },
    { ch: 4, row: 9, id: "c4_end", kind: "end", label: { en: "I killed your mother", vi: "Tôi đã giết mẹ {ac}" } },
  ],

  nodes: {
    // ── 00:15 · BẾN: Helen, ba ống thuốc, lời hứa (bậc 2: bốt điện thoại)
    c4_open: [
      { set: { goal: "c4_call" } },
      { cp: "c4_open" },
      { title: { ch: 4, en: "The Sea Doesn't Read the Table", vi: "Biển không đọc bảng giờ" } },
      { bg: "harbour" }, { amb: "sea" }, { mood: "cold" }, { clock: "00:15" },
      { title: { en: "12:15 A.M.", vi: "0:15 SÁNG" } },
      // dư âm cuối Ch3
      { if: s => (s.f.leo || 0) >= 2, then: [
        { think: { en: "Leo let you out of the station with a nod. Not a friend. Not a suspect either, any more.", vi: "Leo cho bạn ra khỏi trạm bằng một cái gật đầu. Chưa phải bạn. Nhưng cũng không còn là nghi phạm." } } ],
        else: [ { if: s => (s.f.leo || 0) <= 0, then: [
          { think: { en: "Leo let you out of the station without a word. He'll know exactly where you are.", vi: "Leo cho bạn ra khỏi trạm, không một lời. Anh sẽ biết chính xác bạn đang ở đâu." } } ] } ] },
      { if: s => !!s.f.took_draft, then: [
        { think: { en: "He hasn't forgotten the draft you took from Tom's stove. Neither have you.", vi: "Anh chưa quên bản nháp bạn lấy trong bếp lò nhà Tom. Bạn cũng vậy." } } ] },
      { if: s => !!s.f.told_nell, then: [
        { think: { en: "Everyone in that room knows whose child you are now. Nell made sure of it.", vi: "Giờ cả căn phòng ấy đều biết bạn là con ai. Nell đã lo chuyện đó." } } ] },
      { if: s => !!s.f.gideon_private, then: [
        { think: { en: "Gideon's envelope is still your secret. Leo doesn't know.", vi: "Chuyện phong bì của Gideon vẫn là bí mật của bạn. Leo không biết." } } ],
        else: [ { think: { en: "Leo knows about Gideon's envelope now. Gideon didn't look at you when you left.", vi: "Giờ Leo đã biết chuyện phong bì của Gideon. Lúc bạn ra về, Gideon không nhìn bạn." } } ] },
      { n: { en: "Quarter past twelve. The harbour lamp hums. Below the wall, the sea is high and black and very quiet.", vi: "Mười hai giờ mười lăm. Ngọn đèn bến kêu o o. Dưới chân tường, mực biển còn cao, đen và rất lặng." } },
      { show: "helen", at: "c", face: "cold" },
      { n: { en: "Dr Vosper doesn't look at you. She keeps her eyes on the door of the lifeboat station.", vi: "Bác sĩ Vosper không nhìn bạn. Mắt bà không rời cánh cửa trạm cứu hộ." }, on: "helen" },
      {"say":"helen","en":"You're the only person here who hasn't known me for twenty years.","vi":"{Ac} là người duy nhất ở đây không quen biết tôi từ hai mươi năm trước."},
      {"say":"me","en":"That doesn't make me a safe person to tell.","vi":"Vậy không có nghĩa kể với tôi sẽ an toàn đâu."},
      {"say":"helen","en":"No. It makes you someone who might still listen.","vi":"Không. Nhưng có lẽ {ac} vẫn còn chịu nghe.","tone":"steady voice, effort underneath"},
      { say: "helen", en: "You were at his house tonight. Leo said. So you've seen his cabinet.", vi: "Tối nay {ac} ở nhà ông ấy. Leo nói thế. Vậy là {ac} đã thấy tủ thuốc của ông ấy." },
      { say: "me", en: "Three [[ampoule]]s. [[Sealed]]. A surgery box.", vi: "Ba ống thuốc. Còn niêm phong. Hộp của phòng khám." },
      { cg: "harbour-lamp" },
      { n: { en: "She shuts her eyes for a second. Then she talks fast and flat, like a woman reading out her own report.", vi: "Bà nhắm mắt một giây. Rồi bà nói nhanh, giọng đều đều, như người đọc to bản báo cáo của chính mình." }, on: "helen" },
      { say: "helen", en: "I took them to him at half past seven. Morphine. Enough.", vi: "Tôi mang chúng sang cho ông ấy lúc bảy rưỡi tối. Morphine. Đủ liều." },
      { say: "helen", en: "He asked me in the summer. When the pain got too bad, would I help him. I said no. I said no for four months.", easy: "In the summer he asked me to help him die. I said no for four months.", vi: "Ông ấy hỏi tôi từ mùa hè. Khi đau quá thì tôi có giúp ông ấy không. Tôi bảo không. Tôi bảo không suốt bốn tháng." },
      { say: "helen", en: "Then last week I said yes.", vi: "Rồi tuần trước tôi bảo có." },
      { n: { en: "Her hands are in her coat pockets. You can see them moving in there, opening and closing.", vi: "Hai tay bà đút trong túi áo khoác. Bạn thấy chúng cứ nắm lại rồi mở ra trong đó." }, on: "helen" },
      { say: "helen", en: "While I was there I looked for the Oramorph. It was gone already. I thought he'd started on it at last.", easy: "At 7:30 the Oramorph bottle wasn't there. I thought he was taking it at last.", vi: "Lúc ở đó tôi có tìm lọ Oramorph. Lọ thuốc đã không còn ở đó. Tôi cứ nghĩ cuối cùng ông ấy cũng chịu uống.", face: "sad" },
      { say: "helen", en: "I was glad. Can you imagine? I stood in his kitchen and I was glad.", vi: "Tôi mừng. {Ac} tưởng tượng được không? Tôi đứng trong bếp nhà ông ấy mà thấy mừng." },
      { n: { en: "She has been the island's doctor for over twenty years. She has been inside every house.", vi: "Bà làm bác sĩ của đảo đã hơn hai mươi năm. Nhà nào bà cũng từng vào." }, on: "helen" },
      { think: { en: "You don't think she has ever said this out loud.", vi: "Bạn không nghĩ bà từng nói những điều này thành lời." } },
      { say: "helen", en: "I couldn't sit still at home. By quarter past nine I was outside Tom's house. I'd changed my mind. I wanted them back.", vi: "Ở nhà tôi không ngồi yên được. Tới chín giờ mười lăm, tôi đã ở ngoài nhà Tom. Tôi đổi ý rồi. Tôi muốn lấy thuốc về." },
      { say: "helen", en: "His front door was open. The dog was howling. And his truck lights were going out onto the causeway.", vi: "Cửa trước nhà ông ấy mở. Con chó tru lên. Còn đèn xe tải của ông ấy thì đang chạy ra đường ngầm." },
      { say: "helen", en: "Leo was at the head of the causeway. If he stopped me and asked why I'd taken morphine to Tom…", vi: "Leo ở đầu đường ngầm. Nếu cậu ấy chặn tôi lại, hỏi vì sao tôi mang morphine cho Tom…", face: "scared" },
      { n: { en: "She doesn't finish. She doesn't need to.", vi: "Bà không nói hết câu. Bà không cần nói hết." }, on: "helen" },
      { say: "helen", en: "So I reversed. I went home and I sat in my kitchen with my coat on.", vi: "Thế là tôi lùi xe. Tôi về nhà, ngồi trong bếp, áo khoác vẫn mặc trên người." },
      { cg: null },
      { fx: "heartbeat" },
      { say: "helen", en: "If I'd gone after him. If I'd not been a [[coward]] about what I'd done. I think I killed him.", easy: "I didn't follow him because I was afraid. I think I killed him.", vi: "Giá mà tôi đuổi theo ông ấy. Giá mà tôi không hèn nhát vì việc mình đã làm. Tôi nghĩ tôi đã giết ông ấy.", face: "ashamed" },
      { wait: 1200 },
      { say: "me", en: "The ampoules are still sealed. I saw them.", vi: "Mấy ống thuốc vẫn còn niêm phong. Tôi thấy rồi." },
      { truth: "T4" },
      { say: "helen", en: "And I know what I brought him.", vi: "Còn tôi biết mình đã mang gì sang cho ông ấy.", face: "cold" },
      { say: "helen", en: "Don't put the ampoules in your statement. Not tonight. Let me tell Leo myself. In the morning.", vi: "Đừng đưa chuyện mấy ống thuốc vào lời khai của {ac}. Đêm nay thì đừng. Để tôi tự nói với Leo. Sáng mai." },
      { choice: [
        { tag: "kind", en: "Tell him yourself by morning. I won't lie for you.", vi: "Sáng mai bà tự kể với anh ấy. Tôi sẽ không nói dối hộ bà.", set: { helen_promise: true }, add: { helen: 1 }, then: [
          { if: s => (s.f.helen || 0) >= 2, then: [
            { n: { en: "Her eyes go past you, to the dark water. This time they stay there.", vi: "Mắt bà lướt qua bạn, ra phía mặt nước tối. Lần này ánh mắt bà dừng lại ở đó." }, on: "helen" },
            { say: "helen", en: "There's something else. I wasn't going to say it.", vi: "Còn một chuyện nữa. Tôi đã định không nói.", face: "sad" },
            { say: "helen", en: "I was in the phone box at ten past. I couldn't dial. From there you can see the bar. Fergus was there. Nell wasn't.", easy: "At 9:10 I was in the phone box. I couldn't call. I could see the bar: Fergus was there, Nell wasn't.", vi: "Lúc chín giờ mười tối tôi ở trong bốt điện thoại. Tôi không bấm nổi số. Từ đó nhìn thấy được quầy. Fergus có ở đó. Nell thì không.", pic: "act-phonebox" },
            { say: "helen", en: "I didn't want it on my phone. Ringing him. You understand.", vi: "Tôi không muốn nó hiện trong điện thoại của mình. Cuộc gọi cho ông ấy. {Ac} hiểu mà." },
            { if: s => s.f.at_harbour === true, then: [
              { think: { en: "Mrs Dodd on her bench, at ten past nine: 'That's the doctor's car gone up by the Lantern.' Hers.", vi: "Bà Dodd trên ghế ở bến, lúc chín giờ mười: “Xe của bác sĩ vừa chạy lên phía The Lantern đấy.” Là xe của bà ấy." } } ],
              else: [ { think: { en: "The headlights at the porch at ten past nine. The shape going past the window. Hers.", vi: "Đèn xe ở hiên lúc chín giờ mười. Cái bóng lướt qua cửa sổ. Là bà ấy." } } ] },
            { set: { helen_box_early: true } },
            { note: { en: "Helen: in the phone box at 21:10, didn't dial. From the box: Fergus at the bar, Nell not.", vi: "Helen: ở trong bốt điện thoại lúc 21:10, không bấm số. Từ bốt: Fergus ở quầy, Nell thì không." } },
          ], else: [
            { n: { en: "For a moment you think she's going to say something else. Her eyes go past you, to the dark water. Then they come back.", vi: "Một thoáng, bạn nghĩ bà sắp nói thêm điều gì nữa. Mắt bà lướt qua bạn, ra phía mặt nước tối. Rồi quay lại." }, on: "helen" },
          ] },
          { n: { en: "She nods, as if you'd agreed to a dose. Then she sits in her car, engine off, hands on the wheel.", vi: "Bà gật đầu, như thể bạn vừa chịu nhận một liều thuốc. Rồi bà ngồi trong xe, máy tắt, tay đặt lên vô-lăng." }, on: "helen" },
          { hide: "helen" },
        ] },
        { tag: "direct", en: "I can't keep that from Leo. Not tonight.", vi: "Tôi không thể giấu Leo chuyện đó. Đêm nay thì không.", set: { helen_promise: false }, then: [
          { n: { en: "Something in her face closes, like a door.", vi: "Có gì đó trên gương mặt bà khép lại, như một cánh cửa." }, on: "helen" },
          { say: "helen", en: "Then I'll tell him myself. Now.", vi: "Vậy thì tôi tự nói với cậu ấy. Ngay bây giờ.", face: "cold" },
          { n: { en: "She walks past you to the lifeboat station and knocks, twice, hard. She doesn't look back.", vi: "Bà đi ngang qua bạn tới trạm cứu hộ, gõ cửa hai lần, thật mạnh. Bà không ngoái lại." } },
          { hide: "helen" }, { clock: "00:28" }, { sfx: "door" },
          { show: "leo", at: "c", face: "cold" },
          { n: { en: "Leo opens the door. He listens to her on the step, his face very still. Then he looks at you.", vi: "Leo mở cửa. Anh đứng nghe bà nói ngay trên bậc cửa, mặt bất động. Rồi anh nhìn bạn." }, on: "leo" },
          { say: "me", en: "Three ampoules in his cabinet. Still sealed. I saw them at ten o'clock.", vi: "Ba ống thuốc trong tủ của ông ấy. Vẫn còn niêm phong. Tôi thấy lúc mười giờ tối." },
          { say: "leo", en: "All right. I'll record both things: what she brought, and what you saw still sealed.", vi: "Được. Tôi sẽ ghi cả hai việc: bà ấy đã mang gì đến, và {ac} thấy thứ gì vẫn niêm phong.", face: "soft" },
          { add: { leo: 1 } },
          { n: { en: "He holds the door for Dr Vosper. She goes in without a word.", vi: "Anh giữ cửa cho bác sĩ Vosper. Bà đi vào, không nói một lời." } },
          { hide: "leo" },
        ] },
      ] },
      { go: "c4_cottage" },
    ],

    // ── 00:30 · NHÀ TOM: Skerry, 1471, ảnh vách & cọc đo, Mắt thẩm định, ai gọi được lúc 21:11
    c4_cottage: [
      { cp: "c4_cottage" },
      { clock: "00:30" },
      { if: s => s.f.helen_promise === false, then: [
        { n: { en: "Two minutes later the station door opens again. Leo comes out pulling on his gloves.", vi: "Hai phút sau, cửa trạm cứu hộ lại mở. Leo bước ra, vừa đi vừa xỏ găng tay." } } ],
        else: [ { n: { en: "Half past twelve. The station door opens. Leo comes out pulling on his gloves.", vi: "Mười hai giờ rưỡi. Cửa trạm cứu hộ mở. Leo bước ra, vừa đi vừa xỏ găng tay." } } ] },
      { show: "leo", at: "c", face: s => ((s.f.leo || 0) >= 2 ? "soft" : "cold") },
      { say: "leo", en: "I'm going up to the cottage. You were there tonight. Walk with me.", vi: "Tôi lên nhà ông ấy đây. Tối nay {ac} ở đó. {Ac} đi cùng tôi." },
      { if: s => (s.f.leo || 0) >= 2, then: [
        { say: "leo", en: "I'd rather have your eyes than nobody's.", vi: "Thà có {ac} cùng quan sát còn hơn chẳng có ai." } ],
        else: [ { if: s => (s.f.leo || 0) <= 0, then: [
          { say: "leo", en: "Where I can see you.", vi: "Đi ở chỗ tôi nhìn thấy được." } ] } ] },
      { if: s => !!s.f.took_draft, then: [
        { say: "leo", en: "And this time you touch nothing unless I say.", vi: "Và lần này {ac} không đụng vào thứ gì nếu tôi chưa cho." } ] },
      { n: { en: "It isn't a question. You walk with him.", vi: "Đó không phải câu hỏi. Bạn đi cùng anh." } },
      { hide: "leo" },
      { bg: "cottage" }, { amb: "room" }, { mood: "night" }, { sfx: "door" },
      { n: { en: "The hall lamp is still on. Leo opens the door. Skerry is lying on the rug.", vi: "Đèn hành lang vẫn sáng. Leo mở cửa. Skerry nằm trên tấm thảm." } },
      { n: { en: "Even now, he keeps listening for the back door. The door Tom went out by.", vi: "Đến giờ nó vẫn ngóng tiếng cửa sau. Cánh cửa Tom đã đi ra." } },
      { n: { en: "He looks up at you. He doesn't bark. He doesn't get up.", vi: "Nó ngước nhìn bạn. Không sủa. Không đứng dậy." } },
      { explore: { goal: { en: "The hall, with Leo", vi: "Hành lang, cùng Leo" }, need: 2, done: { en: "Sit down with Leo", vi: "Ngồi xuống cùng Leo" }, spots: [
        { id: "label", x: 34, y: 46, clue: true, label: { en: "Label below the keypad", vi: "Nhãn dưới bàn phím" }, then: [
          { n: { en: "The label below the keypad has yellowed. The number is written in the same careful hand as every other label here.", vi: "Mẩu nhãn dưới bàn phím đã ố vàng. Dãy số mang nét chữ cẩn thận, giống hệt những tấm nhãn khác trong nhà." } },
          { n: { en: "01289 381214", vi: "01289 381214" } },
        ] },
        { id: "phone", x: 42, y: 54, clue: true, label: { en: "The old cream telephone", vi: "Điện thoại bàn màu kem" }, then: [
          { show: "leo", at: "c", face: "cold" },
          { n: { en: "Leo goes to the hall table and picks up the old cream telephone.", vi: "Leo đi tới bàn ở hành lang, nhấc cái điện thoại bàn màu kem đã cũ." }, on: "leo" },
          { sfx: "phone" },
          { n: { en: "Leo presses four keys. One, four, seven, one. He tilts the receiver so you can hear.", vi: "Leo bấm bốn số. Một, bốn, bảy, một. Anh nghiêng ống nghe để bạn cùng nghe." }, on: "leo", pic: "act-1471" },
          { fx: "spotlight" },
      { n: { en: "“Your last call was received at twenty-one eleven hours. The caller [[withheld]] their number.”", vi: "“Cuộc gọi đến gần nhất được nhận lúc hai mươi mốt giờ mười một. Người gọi đã giấu số.”" }, pic: "act-1471" },
          { note: { en: "1471 on Tom's phone: last call 21:11, caller withheld their number. (1471 = details of your last incoming call.)", vi: "1471 trên máy nhà Tom: cuộc gọi cuối lúc 21:11, người gọi đã giấu số. (1471: thông tin về cuộc gọi đến gần nhất.)" } },
          { n: { en: "He puts the receiver down very gently, as if it were part of the evidence. It is.", vi: "Anh đặt ống nghe xuống thật nhẹ, như thể nó cũng là vật chứng. Mà đúng là thế." }, on: "leo" },
          { say: "leo", en: "Eleven minutes past nine. He drove out at thirteen minutes past. I saw him.", vi: "Chín giờ mười một tối. Chín giờ mười ba ông ấy lái xe ra. Tôi thấy mà." },
          { say: "me", en: "Can you find out who rang?", vi: "Anh có tra được ai gọi không?" },
          { say: "leo", en: "I've asked for the records. That's [[paperwork]]. They won't reach us before the tide turns.", vi: "Tôi đã yêu cầu hồ sơ. Còn phải làm thủ tục giấy tờ. Chúng sẽ không tới kịp trước lúc nước đổi chiều." },
          { truth: "T7" },
          { n: { en: "Somebody rang Tom Ashby at eleven minutes past nine and hid who they were.", vi: "Có người gọi cho Tom Ashby lúc chín giờ mười một và giấu mình là ai." } },
          { n: { en: "Two minutes after that call, a dying man got into his truck.", vi: "Hai phút sau cuộc gọi ấy, một người sắp chết đã lên xe tải." } },
          { hide: "leo" },
        ] },
        { id: "dog", x: 62, y: 62, label: { en: "Skerry", vi: "Skerry" }, then: [
          { n: { en: "Skerry follows you with his eyes. He stays on the rug, waiting for one particular step on the path.", vi: "Mắt Skerry dõi theo bạn. Nó vẫn nằm trên thảm, chờ một tiếng bước chân nhất định ngoài lối đi." } },
        ] },
        { id: "cabinet", x: 78, y: 40, label: { en: "The medicine cabinet", vi: "Tủ thuốc" }, then: [
          { n: { en: "Through the kitchen door: the cabinet, the surgery box, three ampoules. Still sealed. A ring in the dust where the Oramorph stood.", vi: "Qua cửa bếp: tủ thuốc, cái hộp của phòng khám, ba ống thuốc. Vẫn còn niêm phong. Một vòng bụi ở chỗ lọ Oramorph từng đứng." } },
          { if: s => s.f.helen_promise === false, then: [
            { say: "leo", en: "I'll bag those before I go. Dr Vosper knows.", vi: "Trước khi về tôi sẽ cho mấy ống đó vào túi vật chứng. Bác sĩ Vosper biết rồi." } ],
            else: [ { think: { en: "Leo looks at the box for a second and says nothing. You say nothing either. You promised.", vi: "Leo nhìn cái hộp một giây rồi không nói gì. Bạn cũng không nói gì. Bạn đã hứa." } } ] },
        ] },
      ] } },

      // ảnh vách chòi
      { show: "leo", at: "c", face: "cold" },
      { n: { en: "Leo sits on the stairs and takes out the camera he used in the hut. He holds it so you can both see the screen.", vi: "Leo ngồi xuống bậc cầu thang, lấy cái máy ảnh anh đã dùng ở chòi. Anh cầm sao cho cả hai cùng xem được màn hình." }, on: "leo" },
      { if: s => s.f.told_leo === "full", then: [
        { think: { en: "You were in the box when he took these. You can still smell the soot.", vi: "Bạn có mặt trong chòi lúc anh chụp những tấm này. Bạn vẫn còn ngửi thấy mùi muội." } } ],
        else: [ { think: { en: "Leo showed you these on the slipway. Now there is time to read the wall properly.", vi: "Leo đã cho bạn xem ảnh ở dốc bến. Giờ mới có thời gian đọc kỹ những dòng trên vách." } } ] },
      { n: { en: "The wall. Small even numbers, years of them. At the bottom, the morning line, neat as print.", vi: "Vách chòi. Những con số nhỏ, đều, của bao nhiêu năm. Ở dưới cùng là dòng ghi buổi sáng, ngay ngắn như chữ in." }, on: "leo" },
      { n: { en: "14.11 06:01 — 0.5 U", vi: "14.11 06:01 — 0.5 U" } },
      { n: { en: "And below it, tonight's.", vi: "Và bên dưới là dòng đêm nay." } },
      { n: { en: "21:44 — 0.6 U", vi: "21:44 — 0.6 U" } },
      { if: s => !!s.f.climbed_box, then: [
        { n: { en: "You saw the top line that afternoon, when you climbed the ladder. It was the steadiest thing on the island.", vi: "Dòng phía trên thì bạn đã thấy buổi chiều hôm ấy, khi leo lên thang. Đó là thứ vững vàng nhất trên cả hòn đảo." } },
        { n: { en: "The bottom line runs downhill. The 4s have been gone over twice, like a man pressing hard to make his hand do what it's told.", vi: "Dòng dưới chúi xuống. Hai số 4 bị tô lại hai lần, như một người phải ấn thật mạnh để bắt bàn tay mình làm theo ý." } },
        { say: "me", en: "I saw that top line at five o'clock. Steady as a rule.", vi: "Tôi thấy dòng phía trên lúc năm giờ chiều. Thẳng như kẻ thước." },
        { say: "leo", en: "Then you saw how steady his hand was before tonight. Good.", vi: "Vậy là {ac} đã thấy trước đêm nay tay ông ấy vững thế nào. Tốt.", face: "soft" },
        { add: { leo: 1 } },
      ], else: [
        { say: "leo", en: "That top one's the morning reading. Steady as a rule. Look at the one under it.", vi: "Dòng phía trên là số đo buổi sáng. Thẳng như kẻ thước. {Ac} nhìn dòng dưới xem." },
        { n: { en: "The bottom line runs downhill. The 4s have been gone over twice.", vi: "Dòng dưới chúi xuống. Hai số 4 bị tô lại hai lần." } },
      ] },
      { say: "me", en: "He was alive at 21:44. Still working.", vi: "Lúc 21:44 ông ấy vẫn còn sống. Vẫn còn làm việc." },
      { say: "leo", en: "And the U. U's under. [[Under the table]]. His way of writing it.", easy: "U means 'under': lower than the printed tide table.", vi: "Còn chữ U. U là “under”. Thấp hơn bảng giờ. Cách ông ấy vẫn ghi." },
      { fx: "ripple" }, { sfx: "splash" },
      { n: { en: "Leo swipes to the next picture. The [[gauge]] post on the iron leg, lit by the flash, the water lapping at the painted numbers.", vi: "Leo lướt sang tấm tiếp theo. Cây cọc đo trên chân sắt, sáng lên trong ánh đèn máy ảnh, nước liếm vào những vạch số sơn trên đó." }, on: "leo" },
      { say: "leo", en: "Half ten. Table says one-seventy on that post. Look. One-ten.", vi: "Mười giờ rưỡi tối. Bảng nói cọc phải lên tới một mét bảy. Nhìn đi. Một mét mốt." },
      { say: "leo", en: "[[High pressure]]. Sea's been half a metre under all day. More tonight.", easy: "High pressure lowered the sea. Half a metre below the table all day. Even lower tonight.", vi: "Áp suất cao. Cả ngày nước biển thấp hơn bảng nửa mét. Đêm nay còn thấp hơn." },
      { n: { en: "You do the sum.", vi: "Bạn tính nhẩm." } },
      {"think":{"en":"The printed table predicts a level. Leo's photograph records one. How late could the road really have stayed open?","vi":"Bảng in dự báo một mực nước. Ảnh Leo chụp ghi một mực khác. Thực tế đường có thể còn đi được tới lúc nào?"}},
      { order: { prompt: { en: "Put tonight in order — by the sea, not by the table.", vi: "Xếp lại đêm nay theo đúng thứ tự — theo biển, không theo bảng giờ." }, tries: 3, items: [
        { t: { en: "The bell rings. By the printed table, the road is closed.", vi: "Chuông rung. Theo bảng in, đường ngầm đã đóng." } },
        { t: { en: "Someone rings Tom's cottage and withholds their number.", vi: "Có người gọi tới nhà Tom và giấu số." } },
        { t: { en: "Tom drives out onto the causeway, past Leo.", vi: "Tom lái xe ra đường ngầm, ngang qua Leo." } },
        { t: { en: "The sea really closes the road.", vi: "Biển thật sự phủ kín đường ngầm." } },
        { t: { en: "Tom writes his last reading on the wall of the box.", vi: "Tom ghi số đo cuối cùng lên vách chòi." } },
      ], ok: [
        { n: { en: "The bell rang at ten to nine. The road didn't really close until about half past.", vi: "Chuông đổ lúc chín giờ kém mười. Còn đường ngầm thật sự đóng thì phải khoảng chín rưỡi." } },
      ], fail: [
        { say: "leo", en: "Not quite. The bell goes by the table. The road goes by the sea.", vi: "Chưa đúng hẳn. Chuông rung theo bảng. Đường đóng theo biển." },
        { n: { en: "The bell rang at ten to nine. The road didn't really close until about half past.", vi: "Chuông đổ lúc chín giờ kém mười. Còn đường ngầm thật sự đóng thì phải khoảng chín rưỡi." } },
      ] } },
      { say: "leo", en: "Thirty-two minutes past, near enough. Tom would have known it to the minute. He read the water every day of his life.", vi: "Chín giờ ba mươi hai tối, xê xích chút. Tom thì biết tới từng phút. Đời ông ấy ngày nào cũng đọc nước." },
      { say: "leo", en: "Fergus says it every night. The sea doesn't read the table.", vi: "Tối nào ông Fergus cũng nói thế. Biển không đọc bảng giờ." },
      { truth: "T5" },

      // Mắt thẩm định
      { n: { en: "You look at the two lines on the little screen.", vi: "Bạn nhìn hai dòng chữ trên cái màn hình nhỏ." } },
      { compare: { title: { en: "Assessor's eye", vi: "Mắt thẩm định" }, tries: 3,
        left: { title: { en: "If he went out there to die", vi: "Nếu ông ra đó để chết" }, lines: [
          { en: "He drives out to the refuge box.", vi: "Ông lái xe ra chòi trú nạn." },
          { en: "He climbs straight up and sits down.", vi: "Ông leo thẳng lên và ngồi xuống." },
          { en: "Nobody sees a light.", vi: "Không ai thấy đèn." },
          { en: "He drinks from his flask.", vi: "Ông uống từ bình rượu." },
          { en: "He writes nothing.", vi: "Ông không ghi gì cả." },
        ] },
        right: { title: { en: "Tonight", vi: "Đêm nay" }, lines: [
          { en: "He drives out to the refuge box.", vi: "Ông lái xe ra chòi trú nạn." },
          { en: "He stands by his truck in the rising water.", vi: "Ông đứng cạnh xe tải giữa làn nước đang lên." },
          { en: "He waves a lamp out towards the channel.", vi: "Ông vẫy đèn bão về phía con kênh." },
          { en: "He drinks from his flask.", vi: "Ông uống từ bình rượu." },
          { en: "He climbs up and writes a reading, like any other night.", vi: "Ông leo lên và ghi số đo, như mọi đêm khác." },
        ] },
        diffs: [1, 2, 4],
        ok: [
          { fx: "solve" },
          { n: { en: "He kept signalling towards the boat. It looks as though he was trying to reach someone.", vi: "Ông vẫn ra hiệu về phía thuyền. Có vẻ ông đang cố gọi một người nào đó." } },
        ],
        fail: [
          { say: "leo", en: "Look at the lamp. He was signalling towards the boat, not the shore.", vi: "{Ac} nhìn ngọn đèn đi. Ông ấy ra hiệu về phía thuyền, không phải bờ." },
          { n: { en: "He kept signalling towards the boat. It looks as though he was trying to reach someone.", vi: "Ông vẫn ra hiệu về phía thuyền. Có vẻ ông đang cố gọi một người nào đó." } },
        ] } },
      { say: "me", en: "He may have gone out there for someone on the water.", vi: "Có thể ông ấy ra đó vì một người ở ngoài khơi." },
      { truth: "T2" },
      { n: { en: "Leo doesn't answer. He doesn't have to. You both know whose buoys are on the channel by the box.", vi: "Leo không trả lời. Anh không cần trả lời. Cả hai đều biết phao của ai thả dọc con kênh cạnh chòi." }, on: "leo" },

      // Ai gọi được lúc 21:11
      { n: { en: "Leo turns to a clean page in his notebook and writes the time at the top. Then he holds the pencil out to you.", vi: "Leo lật sang một trang trắng trong sổ, ghi giờ lên đầu trang. Rồi anh chìa cây bút chì cho bạn." }, on: "leo" },
      { say: "leo", en: "Who could have made that call? All of them. Not who would. Who could.", vi: "Ai có thể gọi cuộc đó? Tất cả. Không phải ai muốn. Ai gọi được." },
      { if: s => s.f.at_harbour === true, then: [
        { think: { en: "Ten past nine. Mrs Dodd on her bench: 'That's the doctor's car gone up by the Lantern.'", vi: "Chín giờ mười. Bà Dodd trên ghế ở bến: “Xe của bác sĩ vừa chạy lên phía The Lantern đấy.”" } } ],
        else: [ { think: { en: "Ten past nine. Headlights at the porch. A shape going past the window.", vi: "Chín giờ mười. Đèn xe ở hiên. Một cái bóng lướt qua cửa sổ." } } ] },
      { n: { en: "Between you, you fill the page.", vi: "Hai người cùng nhau viết kín trang giấy." } },
      { n: { en: "21:11 — WHO COULD RING?", vi: "21:11 — AI CÓ THỂ GỌI?" } },
      { n: { en: "Mobiles: Callum, preparing his boat. Gideon, an incoming call on the mainland. Leo, at the road. Dr Vosper, on the island.", vi: "Di động: Callum, chuẩn bị thuyền. Gideon, nhận cuộc gọi ở đất liền. Leo, ở đầu đường. Bác sĩ Vosper, trên đảo." } },
      { n: { en: "The Lantern phone — bar or cellar.", vi: "Điện thoại của The Lantern — ở quầy hoặc dưới hầm." } },
      { if: s => !!s.f.helen_box_early, then: [
        { n: { en: "Phone box beside the [[porch]]. A car stopped there about ten past nine. Dr Vosper — didn't dial (her word).", vi: "Bốt điện thoại cạnh hiên. Một chiếc xe dừng ở đó khoảng chín giờ mười. Bác sĩ Vosper — không bấm số (theo lời bà)." } } ],
        else: [ { n: { en: "Phone box beside the [[porch]]. A car stopped there about ten past nine. Someone inside.", vi: "Bốt điện thoại cạnh hiên. Một chiếc xe dừng ở đó khoảng chín giờ mười. Có người ở trong bốt." } } ] },
      { n: { en: "Anyone passing the phone box. Anyone in the pub.", vi: "Bất kỳ ai đi ngang bốt điện thoại. Bất kỳ ai trong quán." } },
      { note: { en: "21:11 — who could ring: mobiles (Callum, Gideon, Leo, Dr Vosper) · the Lantern phone, bar or cellar · the phone box by the porch · anyone in the pub.", vi: "21:11 — ai gọi được: di động (Callum, Gideon, Leo, bác sĩ Vosper) · máy của The Lantern, ở quầy hay dưới hầm · bốt điện thoại cạnh hiên · bất kỳ ai trong quán." } },
      { say: "leo", en: "Put me down. I had a phone in my pocket at the head of the road. Put me down like everyone else.", vi: "Ghi tên tôi vào. Tôi có điện thoại trong túi khi đứng ở đầu đường ngầm. Ghi tên tôi như mọi người khác." },
      { n: { en: "You already have. He reads it and nods.", vi: "Bạn đã ghi rồi. Anh đọc và gật đầu." }, on: "leo" },
      { say: "me", en: "The phone box. Would a call from there show up as withheld?", vi: "Bốt điện thoại ấy. Gọi từ đó thì có hiện là giấu số không?" },
      { say: "leo", en: "Box'd show its number. Unless you dial 141. Anyone can.", easy: "A call from the box shows its number — unless you dial 141 first. Anyone can do that.", vi: "Bốt thì sẽ hiện số. Trừ khi bấm 141 trước. Ai cũng bấm được." },
      { n: { en: "He closes the notebook on the list and puts it inside his jacket.", vi: "Anh gập cuốn sổ lại, kẹp trang danh sách bên trong, rồi cất vào trong áo khoác." }, on: "leo" },
      { say: "leo", en: "Callum says he went straight from the pub to his boat. I'll be asking him again.", vi: "Callum bảo anh ta đi thẳng từ quán ra thuyền. Tôi sẽ hỏi lại." },
      { hide: "leo" },
      { n: { en: "When you step out of the cottage, Skerry gets up at last. He follows you through the door and stops at your heel.", vi: "Khi bạn bước ra khỏi nhà, Skerry cuối cùng cũng đứng dậy. Nó theo bạn qua cửa và dừng lại sát gót bạn." } },
      { show: "leo", at: "c", face: "soft" },
      { say: "leo", en: "He's chosen, then. Tom always said that dog picked his own people.", vi: "Thế là nó chọn rồi. Tom vẫn bảo con chó này tự chọn người của nó." },
      { n: { en: "From now on, wherever you go tonight, there is a grey dog a step behind you.", vi: "Từ giờ, đêm nay bạn đi đâu cũng có một con chó xám theo sau một bước." } },
      { hide: "leo" },
      { go: "c4_walk" },
    ],

    // ── ĐI BỘ VỀ: bố của Leo, hai cặp đèn · 01:00 Gideon đi bộ về
    c4_walk: [
      { cp: "c4_walk" },
      { bg: "harbour" }, { amb: "sea" }, { mood: "cold" }, { clock: "00:50" },
      { n: { en: "You walk back down towards the harbour. The street is empty. Every window in the Lantern is still lit.", vi: "Bạn đi bộ ngược xuống phía bến. Con phố vắng tanh. Ô cửa sổ nào của The Lantern cũng vẫn sáng đèn." } },
      { show: "leo", at: "c", face: "sad" },
      { n: { en: "Leo walks with his hands in his pockets. For a while he says nothing. Then he speaks to the road in front of him.", vi: "Leo đi, hai tay đút túi. Một lúc lâu anh không nói gì. Rồi anh nói, mắt nhìn con đường trước mặt." }, on: "leo" },
      { if: s => !!s.f.told_nell, then: [
        { say: "leo", en: "Nell told us whose child you are. So you'd better hear this from me.", vi: "Bà Nell đã nói cho chúng tôi biết {ac} là con ai. Vậy thì {ac} nên nghe chuyện này từ tôi." } ] },
      { say: "leo", en: "My dad was the special constable here, before me. Twenty years ago it was him who wrote her up. Anna Rowe.", easy: "My dad was the police officer here before me. Twenty years ago he wrote the report about her. Anna Rowe.", vi: "Bố tôi làm cảnh sát tình nguyện ở đây, trước tôi. Hai mươi năm trước chính ông ấy viết biên bản về bà ấy. Bà Anna Rowe." },
      { say: "leo", en: "Accident. Taken by the tide. He wrote it off Tom's book. Everybody wrote everything off Tom's book.", vi: "Tai nạn. Bị nước cuốn. Ông ấy viết theo sổ của Tom. Ai cũng viết mọi thứ theo sổ của Tom." },
      { n: { en: "He stops under a street lamp. He looks older in it, and younger.", vi: "Anh dừng lại dưới một cột đèn đường. Trong ánh đèn, anh trông vừa già hơn, vừa trẻ hơn." }, on: "leo" },
      { mood: "flashback" }, { cg: "cg-2004-lights" }, { cam: "push", ms: 7000 },
      { cam: null },
      { say: "leo", en: "I was nine. Dad and me at the window. Two lots of lights out on the causeway, that night. Two.", easy: "I was nine. From our window we saw the lights of two cars on the causeway that night.", vi: "Hồi đó tôi chín tuổi. Hai bố con đứng ở cửa sổ. Đêm ấy, trên đường ngầm có hai cặp đèn. Hai cặp." },
      { say: "leo", en: "Next day I told Tom. Tom said I'd dreamed it.", vi: "Hôm sau tôi kể với Tom. Tom bảo tôi nằm mơ." },
      { say: "leo", en: "And Dad believed him. And so did I. For twenty years.", vi: "Và bố tôi tin ông ấy. Tôi cũng tin. Suốt hai mươi năm." },
      { cg: null }, { mood: "cold" }, { cam: null },
      { truth: "T9" },
      { n: { en: "He starts walking again before you can say anything. Skerry trots between you.", vi: "Anh lại bước đi trước khi bạn kịp nói gì. Skerry lon ton giữa hai người." } },
      { clock: "01:00" }, { title: { en: "1:00 A.M.", vi: "1:00 SÁNG" } }, { sfx: "steps" },
      { show: "gideon", at: "r", face: "cold" },
      { n: { en: "One o'clock. A figure comes up the lane towards you, collar up, walking carefully on the cobbles. Gideon.", vi: "Một giờ sáng. Một bóng người đi ngược con ngõ về phía bạn, cổ áo dựng lên, bước cẩn thận trên mặt đá cuội. Gideon." }, on: "gideon" },
      { say: "gideon", en: "Three brandies. I'm not driving. Car can sleep outside the Lantern.", vi: "Ba ly brandy. Tôi sẽ không lái xe. Cứ để xe ngủ trước cửa The Lantern." },
      { if: s => !!s.f.gideon_private, then: [
        { n: { en: "Leo's radio goes. He steps away to answer it.", vi: "Bộ đàm của Leo kêu. Anh bước ra xa một chút để trả lời." } },
        { hide: "leo" },
        { n: { en: "Gideon lowers his voice. He doesn't look at you. He looks at the dog.", vi: "Gideon hạ giọng. Ông không nhìn bạn. Ông nhìn con chó." }, on: "gideon" },
        { say: "gideon", en: "Keys are in it. If you need it tonight. I said I owed you one.", easy: "The keys are in the car. Take it tonight if you need it. I owe you.", vi: "Chìa khóa cắm sẵn trong xe. Nếu đêm nay {ac} cần. Tôi đã bảo là tôi nợ {ac} một lần mà." },
        { n: { en: "Then he goes on up the lane towards the big house, one hand on the wall.", vi: "Rồi ông đi tiếp lên con ngõ về phía ngôi nhà lớn, một tay vịn tường." } },
        { hide: "gideon" },
        { show: "leo", at: "c", face: "cold" },
      ], else: [
        { n: { en: "Gideon nods to Leo and walks on past you without a word. He doesn't look at you at all.", vi: "Gideon gật đầu chào Leo rồi đi thẳng qua bạn, không một lời. Ông không nhìn bạn lấy một lần." } },
        { hide: "gideon" },
        { n: { en: "Leo's radio goes. He listens, then turns back to you.", vi: "Bộ đàm của Leo kêu. Anh nghe, rồi quay lại phía bạn." }, on: "leo" },
      ] },
      { say: "leo", en: "That's CID. I'm wanted at the station. You — don't go far.", vi: "Bên điều tra hình sự đấy. Tôi phải về trạm. {Ac} — đừng đi xa." },
      { hide: "leo" },
      { go: "c4_boat" },
    ],

    // ── 01:05 · THUYỀN MAIRI ROSE: Callum — cổng sau, Mairi / phiên tòa, lời thú
    c4_boat: [
      { set: { goal: "c4_callum" } },
      { cp: "c4_boat" },
      { clock: "01:05" }, { amb: "sea" }, { cam: "sway" },
      { n: { en: "You don't go far. You go down the [[slipway]], to the one boat with a light in its cabin.", vi: "Bạn không đi xa. Bạn xuống dốc bến, tới con thuyền duy nhất còn sáng đèn trong ca-bin." } },
      { n: { en: "MAIRI ROSE", vi: "MAIRI ROSE" } },
      { show: "callum", at: "c" },
      { n: { en: "Callum is on deck, coiling a rope that is already coiled. He hears the dog's claws on the stones before he sees you.", vi: "Callum đứng trên boong, cuộn một sợi dây vốn đã cuộn sẵn. Anh nghe tiếng móng chó trên đá trước khi thấy bạn." }, on: "callum" },
      { cam: null },
      { say: "callum", en: "That's Tom's dog.", vi: "Chó của Tom đấy." },
      { say: "me", en: "He's decided to come with me.", vi: "Nó quyết định đi theo tôi." },
      { n: { en: "Callum looks at Skerry. Skerry looks back. Neither of them comes any closer.", vi: "Callum nhìn Skerry. Skerry nhìn lại. Không bên nào bước lại gần." }, on: "callum" },
      { say: "me", en: "How old were you when you started on the boats?", vi: "Anh bắt đầu đi thuyền từ năm bao nhiêu tuổi?" },
      { say: "callum", en: "Fourteen. Had to. Dad [[went down]] off the Farnes the year before. Mam had the bar and me.", easy: "I was fourteen. My dad died at sea the year before. My mum had the pub and me.", vi: "Mười bốn. Phải đi. Bố tôi mất ngoài khơi đảo Farne năm trước đó. Mẹ tôi một mình lo cái quán, lo cả tôi." },
      { n: { en: "He puts the rope down. There's nothing left to coil.", vi: "Anh đặt sợi dây xuống. Chẳng còn gì để cuộn nữa." }, on: "callum" },
      { n: { en: "You describe the back-gate prints. Wellingtons, one heel chewed. Bigger work boots, toes dug deep: someone had stood there a while.", vi: "Bạn tả dấu chân ở cổng sau. Dấu ủng, một gót bị gặm. Giày bảo hộ to hơn, mũi lún sâu: có người đã đứng đó một lúc." } },
      { n: { en: "You tell him what the doctor said on the slipway. Bruises on both upper arms. Fresh. Someone gripped him hard.", vi: "Bạn kể với anh điều bà bác sĩ nói ở dốc bến. Vết bầm ở hai bắp tay. Mới. Có người đã túm ông ấy rất chặt." } },
      { n: { en: "Callum looks down at his own boots.", vi: "Callum nhìn xuống đôi giày của chính mình." }, on: "callum" },
      { say: "me", en: "You told Leo you went straight from the pub to your boat.", vi: "Anh khai với Leo là anh đi thẳng từ quán ra thuyền." },
      { say: "callum", en: "I did.", vi: "Thì đúng thế." },
      { if: s => s.f.at_harbour === true, then: [
        { say: "me", en: "You left the pub at nine. You weren't at your boat till gone eight past. That's not straight.", vi: "Anh rời quán lúc chín giờ. Hơn chín giờ tám anh mới có mặt ở thuyền. Thế thì đâu phải đi thẳng." } ],
        else: [ { say: "me", en: "From the pub the second time. Not the first.", vi: "Từ quán, lần thứ hai. Không phải lần đầu." } ] },
      { n: { en: "He doesn't answer. Out on the channel a [[buoy]] light blinks, and blinks, and blinks.", vi: "Anh không trả lời. Ngoài con kênh, một ngọn đèn phao nhấp nháy, nhấp nháy, nhấp nháy." }, on: "callum" },
      // luật cân bằng: callum tối thiểu 1 (lời thú 2004 luôn tới), rồi nhẹ +1 / dọa −1
      { if: s => (s.f.callum || 0) < 1, then: [{ set: { callum: 1 } }] },
      { choice: [
        { tag: "kind", en: "Tell me about her. The girl on your phone.", vi: "Kể tôi nghe về con bé đi. Cô bé trên điện thoại của anh.", set: { callum_threat: false }, add: { callum: 1 }, then: [
          { n: { en: "For a second he looks at you as if you'd hit him.", vi: "Một giây, anh nhìn bạn như thể bạn vừa đánh anh." }, on: "callum" },
          { n: { en: "Then he takes out his phone and wakes the screen. The little face lights up between you.", vi: "Rồi anh rút điện thoại ra, bật màn hình. Gương mặt nhỏ xíu sáng lên giữa hai người." }, on: "callum" },
          { say: "callum", en: "Mairi. She's five. She thinks the sea's a person.", vi: "Mairi. Con bé năm tuổi. Nó tưởng biển là một con người.", face: "soft" },
          { say: "callum", en: "She says goodnight to it. Out the window. Every night I have her.", vi: "Nó chúc biển ngủ ngon. Qua cửa sổ. Tối nào con bé ở với tôi cũng thế." },
          { n: { en: "His thumb moves over the screen, over her hair. Very gently.", vi: "Ngón cái anh lướt trên màn hình, trên mái tóc con bé. Thật khẽ." }, on: "callum" },
          { say: "callum", en: "Her mam's in Alnwick. There's a hearing next month. Who has her. How often.", vi: "Mẹ nó ở Alnwick. Tháng sau có phiên tòa. Ai được nuôi. Bao lâu gặp một lần." },
          { say: "callum", en: "I'm not losing my girl. Not to a court. Not to anyone.", vi: "Tôi không để mất con gái mình đâu. Không để tòa án lấy. Không để ai lấy.", face: "sad" },
          { n: { en: "The screen goes dark in his hand. He doesn't wake it again.", vi: "Màn hình tối đi trong tay anh. Anh không bật lại nữa." }, on: "callum" },
          { n: { en: "You wait. Skerry lies on the cold stones, chin on his paws. The tide has turned. Faintly, you hear it retreating.", vi: "Bạn chờ. Skerry nằm trên mặt đá lạnh, cằm gác lên hai chân trước. Nước đã đổi chiều. Rất khẽ, bạn nghe thấy biển đang rút." } },
          { say: "callum", en: "I went to his gate. After nine. To ask him one more time.", vi: "Tôi tới cổng nhà bác ấy. Sau chín giờ tối. Để xin bác ấy một lần nữa." },
          { truth: "T8" },
          { say: "callum", en: "He said you'd be at the bar. Anna's child is at the bar, he said. Like it was good news.", vi: "Bác ấy bảo {ac} đang ở quán. Con của Anna đang ở quán, bác ấy nói thế. Cứ như đó là tin vui." },
          { n: { en: "He says her name as if he knows what it costs you to hear it.", vi: "Anh nói tên mẹ như thể biết bạn phải chịu đựng thế nào khi nghe thấy." } },
          { n: { en: "Callum sits down on the edge of the deck. He is quiet for so long that the buoy light blinks forty times. You count.", vi: "Callum ngồi xuống mép boong. Anh im lặng lâu tới mức ngọn đèn phao nhấp nháy bốn mươi lần. Bạn đếm." }, on: "callum" },
          { n: { en: "When he speaks, he speaks to the water.", vi: "Khi anh lên tiếng, anh nói với mặt nước." }, on: "callum" },
        ] },
        { tag: "press", en: "There's a custody hearing next month. A court will want to know where you were tonight.", vi: "Tháng sau có phiên tòa giành quyền nuôi con. Tòa sẽ muốn biết đêm nay anh ở đâu.", set: { callum_threat: true }, add: { callum: -1 }, then: [
          { fx: "shake" },
          { n: { en: "He steps towards you so sharply the boat rocks under him. Skerry rises too, very still.", vi: "Anh bước sấn về phía bạn, mạnh đến mức thuyền chòng chành. Skerry cũng đứng dậy, bất động." }, on: "callum" },
          { say: "callum", en: "Don't you put her in this. Don't you ever say her name.", vi: "Đừng lôi con bé vào chuyện này. Đừng bao giờ nhắc tên nó.", face: "angry" },
          { say: "callum", en: "I'm not losing my girl. Not to a court. Not to anyone.", vi: "Tôi không để mất con gái mình đâu. Không để tòa án lấy. Không để ai lấy." },
          { n: { en: "He pulls a plastic-wrapped book from his oilskin and shoves it against your chest. The pages are swollen with damp.", vi: "Anh rút một cuốn sổ bọc ni-lông trong áo dầu, ấn vào ngực bạn. Những trang giấy trương lên vì ẩm." }, on: "callum" },
          { say: "callum", en: "Ask my mother where I was that night. Go on.", vi: "Đi mà hỏi mẹ tôi đêm đó tôi ở đâu. Hỏi đi." },
          { set: { c5_referred_mam: true } },
          { sfx: "page" }, { item: "logbook" },
          { n: { en: "You fold back the plastic. Tom's tide logbook falls open at a page worn softer than the rest.", vi: "Bạn mở lớp ni-lông. Sổ thủy triều của Tom bung ra ở một trang đã mềm hơn hẳn những trang còn lại." }, pic: "act-logbook" },
          { n: { en: "14 Nov 2004 — road flooded 20:30", vi: "14 tháng 11 năm 2004 — đường ngập lúc 20:30" }, pic: "act-logbook" },
          { n: { en: "Below it, in pencil: Fetched 20:45. Told the crash did it. I believed it.", vi: "Bên dưới, bằng bút chì: Được đón lúc 20:45. Người ta bảo là do cú tông. Tôi đã tin." }, pic: "act-logbook" },
          { note: { en: "Tom's logbook, 14 Nov 2004: 'road flooded 20:30' in blue ink. In pencil: 'Fetched 20:45. Told the crash did it. I believed it.'", vi: "Sổ của Tom, 14/11/2004: “road flooded 20:30” bằng mực xanh. Bút chì: “Fetched 20:45. Told the crash did it. I believed it.” — Có người đến đón Tom lúc 20:45; người ta bảo ông là do cú tông; ông đã tin." } },
          { set: { p_nell_knew: true, p_fetched: true } },
          { think: { en: "Tom's hard capitals. Tom's pencil. Twenty years of it.", vi: "Chữ in hoa cứng cáp của Tom. Bút chì của Tom. Hai mươi năm." } },
          {"n":{"en":"You fold the plastic around the book again and put it inside your coat.","vi":"Bạn bọc ni-lông quanh cuốn sổ trở lại, rồi cất vào trong áo khoác."}},
          { say: "callum", en: "I went to his gate. After nine. To ask him one more time.", vi: "Tôi tới cổng nhà bác ấy. Sau chín giờ tối. Để xin bác ấy một lần nữa." },
          { truth: "T8" },
          { say: "callum", en: "He said you'd be at the bar. Anna's child is at the bar, he said. Like it was good news.", vi: "Bác ấy bảo {ac} đang ở quán. Con của Anna đang ở quán, bác ấy nói thế. Cứ như đó là tin vui." },
          { n: { en: "That's how he knows who you are.", vi: "Thì ra vì thế mà anh biết bạn là ai." } },
          { n: { en: "He doesn't sit down. He stays standing, his back to you, and speaks to the water.", vi: "Anh không ngồi xuống. Anh đứng nguyên đó, quay lưng về phía bạn, và nói với mặt nước." }, on: "callum" },
        ] },
      ] },
      { cam: null },
      { say: "callum", en: "I didn't kill Tom.", vi: "Tôi không giết Tom.", face: "ashamed" },
      { wait: 1500 },
      { sfx: "sting" },
      { say: "callum", en: "I killed your mother.", vi: "Tôi đã giết mẹ {ac}.", face: "crying" },
      { fx: "blackout" },
      { wait: 2500 },
      { hide: "*" }, { mood: null },
      { end: "c4_end" },
    ],
  },

  endings: {
    c4_end: { ch: 4,
      title: { en: "The Sea Doesn't Read the Table", vi: "Biển không đọc bảng giờ" },
      sum: { en: "A withheld call, a doctor's confession, a boy's.", vi: "Một cuộc gọi giấu số, lời thú của bác sĩ, lời thú của một cậu bé." },
      text: { en: "Someone rang Tom at 21:11 and hid their number. The sea ran under the table, and Tom signalled towards a boat. Now, on the deck of the MAIRI ROSE, Callum has said the thing he has carried for twenty years.", vi: "Có người gọi cho Tom lúc 21:11 và giấu số. Mực biển thấp hơn dự báo, và Tom ra hiệu về phía một con thuyền. Giờ đây, trên boong thuyền MAIRI ROSE, Callum đã nói ra điều anh mang theo suốt hai mươi năm." },
      next: "c5_open", nextTitle: { en: "Chapter 5", vi: "Chương 5" } },
  },
});
// BETWEEN TIDES · CHƯƠNG 5 — ĐIỀU CỒN CÁT GIỮ (01:20 → 02:20).
// Văn: ../../../GiuaHaiConNuoc-truyen-ch5.md (+ Nhánh rẽ) · Thiết kế §5 Ch5, §10b, “Luật cân bằng cho game”.
