      { say: "tom", tone: "whispering, urgent and secretive", en: "Not here. My cottage. Ten o'clock.", whisper: true, face: "soft", vi: "Không nói ở đây. Nhà tôi. Mười giờ tối." },
      {"say":"me","en":"Why wait?","vi":"Sao phải chờ?","whisper":true},
