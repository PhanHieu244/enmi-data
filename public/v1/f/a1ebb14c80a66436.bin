/* Keep the visible native location pill in sync with the native story clock.
 * No time arithmetic, story steps, flags, sound cues or save cursors change.
 */
(() => {
  'use strict';
  const E = globalThis.StoryEngine;
  if (!E?.plugin || E.plugins?.['bt-clock-header']) return;
  if (typeof document === 'undefined' && !E.mech && typeof E.S !== 'function') return;
  const nativeClock = E.mech?.clock, nativeTitle = E.mech?.title, nativeLocation = E.ui?.loc;
  if (typeof nativeClock !== 'function' || typeof nativeLocation !== 'function') return;
  const ours = () => E.S()?.id === 'between-tides';
  let titlePreview = null;
  // A scene may carry a nominal time for title/no-clock views. Once a run
  // clock exists, it is the current time and must win over that fallback.
  E.ui.loc = function (name, time) {
    const preview = titlePreview && titlePreview.run === E.R() && titlePreview.context.live?.()
      ? titlePreview.time : null;
    const current = ours() && (preview || E.R()?.clock?.t);
    return nativeLocation.call(this, name, current || time);
  };
  const sync = () => {
    if (!ours()) return;
    const R = E.R(), fallback = E.S()?.scenes?.[R?.scene]?.time;
    E.ui.loc(null, R?.clock?.t || (fallback ? E.nat(fallback) : ''));
  };
  E.plugin({
    id: 'bt-clock-header',
    mechs: {
      async clock(context) {
        await nativeClock(context);
        if (!context?.live || context.live()) sync();
      },
      async title(context) {
        const next = context.frame && E.walk?.(context.frame)?.[context.idx + 1];
        const time = next?.clock;
        if (!ours() || context.st.title?.ch || !/^\d{2}:\d{2}$/.test(time || '')) return nativeTitle(context);
        // A time card announces the next authored clock. Preview that label
        // only; native clock state/gates and its one SFX still change on the
        // following existing frame, never early and never twice.
        const token = { run: E.R(), context, time };
        titlePreview = token; sync();
        try { return await nativeTitle(context); }
        finally {
          if (titlePreview === token) {
            titlePreview = null;
            if (!context.live || context.live()) sync();
          }
        }
      },
    },
  });
  E.btClockHeader = { sync };
})();
/* Retain all five native clue slots; only the kitchen's physical access waits. */
.se.bt-cottage-locked [data-sp="stove"],
.se.bt-cottage-locked [data-sp="cabinet"],
.se.bt-cottage-locked [data-sp="window"],
.se.bt-cottage-locked [data-sp="back"],
.se.bt-cottage-phone:not(.bt-cottage-phone-next) [data-sp="phone"],
.se.bt-cottage-phone.bt-cottage-phone-next:not(.xp-inspecting) [data-sp="label"] {
  display: none !important;
  pointer-events: none !important;
}
/* Between Tides: the Chapter 2 kitchen opens once within the current run.
 * Native explore keeps its original spots, indices and five-clue requirement.
 * Do not use spot.if here: native explore clamps need to the visible clue count.
 */
(() => {
  'use strict';
  const E = globalThis.StoryEngine;
  if (!E?.plugin || E.plugins?.['bt-cottage']) return;
  // Native check.js provides a data-only registration facade, not a runtime.
  if (typeof document === 'undefined' && !E.mech && typeof E.S !== 'function') return;
  const nativeExplore = E.mech?.explore;
  if (typeof nativeExplore !== 'function') throw Error('Between Tides cottage plugin requires native explore to be loaded first');
  const FLAG = 'bt_cottage_kitchen_open';
  const CLOSED = 'cottage-closed', OPEN = 'cottage-open-dog';
  const LOCKED = new Set(['stove', 'cabinet', 'window', 'back']);
  const openingSteps = new WeakSet();
  let exploration = null, laterExploration = null, opening = null, exploreIndex = -1, laterKey = null;
  // Measured on the three approved 941 × 1672 painted variants. Names are
  // local to this plugin so old generated region names cannot take precedence.
  const commonRegions = {
    'bt-phone': [29, 44.5, 17, 9], 'bt-pegs': [22, 24, 11, 6],
    'bt-front': [2, 37, 12, 14], 'bt-cabinet': [56, 25, 12, 9],
    'bt-stove': [55, 45, 13, 13], 'bt-window': [69, 22, 17, 16],
    'bt-back': [84, 31, 12, 14], 'bt-dog': [47, 68, 49, 20],
  };
  const ours = () => E.S()?.id === 'between-tides';
  const root = () => document.querySelector('.se');
  const isOpen = () => !!E.R()?.f?.[FLAG];
  const markOpen = () => { if (!isOpen()) E.flag(FLAG, true); };
  const install = () => {
    if (!ours()) return;
    const S = E.S(), node = S.nodes?.c2_cottage;
    for (const id of [CLOSED, OPEN, 'cottage-dog']) {
      S.scenes[id] ||= { ...S.scenes.cottage, time: undefined, fx: undefined };
    }
    const regionData = {};
    for (const id of [CLOSED, OPEN, 'cottage-dog']) regionData[id] = {
      size: [941, 1672], fit: 'contain',
      r: { ...commonRegions, 'bt-kitchen': id === CLOSED ? [67, 36, 20, 18] : [70, 40, 14, 10] },
    };
    E.regions(regionData);
    const laterNode = S.nodes?.c4_cottage;
    laterExploration = laterNode?.find(st => st.explore?.spots?.some(sp => sp.id === 'label'))?.explore || null;
    if (laterExploration) {
      laterExploration.img = 'cottage-dog';
      for (const sp of laterExploration.spots) sp.r = 'bt-' + (sp.id === 'label' ? 'phone' : sp.id);
    }
    if (!node) return;
    exploreIndex = node.findIndex(st => st.explore?.spots?.some(sp => sp.id === 'kitchen'));
    if (exploreIndex < 0) return;
    exploration = node[exploreIndex].explore;
    for (const sp of exploration.spots) sp.r = 'bt-' + sp.id;
    const kitchen = exploration.spots.find(sp => sp.id === 'kitchen');
    opening = kitchen.then.find(st => st.n);
    // Side metadata selects the existing background mechanic at scene entry.
    const entry = node.find(st => st.bg === 'cottage' || st.bg === CLOSED || st.bg === OPEN);
    if (entry) { entry.bg = CLOSED; entry.btCottageEntry = true; }
    // All later kitchen lines carry the same scene so an older save resumed
    // inside this branch restores its already-open physical state correctly.
    let afterOpening = false;
    for (const st of kitchen.then) {
      if (st === opening) afterOpening = true;
      if (afterOpening && (st.n || st.think || st.say)) { st.scene = OPEN; openingSteps.add(st); }
    }
    for (const st of kitchen.again || []) { st.scene = OPEN; openingSteps.add(st); }
  };
  E.side('btCottageEntry', (value, st) => {
    if (!ours() || !value) return;
    // Re-entering the node without rewinding the run must not close the door.
    if (E.R().used?.['c2_cottage.' + exploreIndex + '.v.kitchen']) markOpen();
    st.bg = isOpen() ? OPEN : CLOSED;
  });
  E.plugin({
    id: 'bt-cottage',
    mechs: {
      explore(c) {
        if (!ours()) return nativeExplore(c);
        if (c.st.explore === laterExploration) {
          // The label and receiver belong to one small physical phone. Keep
          // both original clues in the native count, expose them in a readable
          // order, and honour an old save that has already used the receiver.
          laterKey = c.key();
          const labelRead = !!E.R().used?.[c.key('v', 'label')];
          const phoneRead = !!E.R().used?.[c.key('v', 'phone')];
          const detail = E.R().xpDetail?.[laterKey];
          // Returning from the label's completed child sequence should expose
          // the next action on this same phone. Otherwise the retained zoom
          // repeats the old number until the player discovers Back. Do not
          // mark the receiver visited or alter any authored cursor/reward.
          if (labelRead && !phoneRead && detail?.id === 'label') {
            detail.id = 'phone';
            detail.img = laterExploration.img;
          }
          root()?.classList.add('bt-cottage-phone');
          root()?.classList.toggle('bt-cottage-phone-next', labelRead);
          c.onExit?.(() => { laterKey = null; root()?.classList.remove('bt-cottage-phone', 'bt-cottage-phone-next'); });
          return nativeExplore(c);
        }
        if (c.st.explore !== exploration) return nativeExplore(c);
        const R = E.R();
        // Here no kitchen child frame is running. A native visited mark means
        // its sequence returned, including saves from the original release.
        if (R.used?.[c.key('v', 'kitchen')]) markOpen();
        exploration.img = isOpen() ? OPEN : CLOSED;
        root()?.classList.toggle('bt-cottage-locked', !isOpen());
        c.onExit?.(() => root()?.classList.remove('bt-cottage-locked'));
        return nativeExplore(c);
      },
    },
    on: {
      boot: install,
      chapter: install,
      step(type, st) {
        if (!ours()) return;
        if (openingSteps.has(st)) markOpen();
        if (type !== 'explore' || st.explore !== exploration) root()?.classList.remove('bt-cottage-locked');
      },
    },
    setup() {
      // CSS removes these buttons from pointer and keyboard reach. The capture
      // guard also rejects a stale/programmatically dispatched click before
      // native onSpot can increment used, award a clue or push a child frame.
      document.addEventListener('click', event => {
        if (!ours()) return;
        const button = event.target.closest?.('[data-sp]');
        if (!button) return;
        const id = button.dataset.sp;
        const kitchenLocked = root()?.classList.contains('bt-cottage-locked') && LOCKED.has(id);
        const labelRead = laterKey && !!E.R().used?.[laterKey + '.v.label'];
        const phoneLocked = laterKey && (id === 'phone' && !labelRead || id === 'label' && labelRead && !root()?.classList.contains('xp-inspecting'));
        if (kitchenLocked || phoneLocked) { event.preventDefault(); event.stopImmediatePropagation(); }
      }, true);
    },
  });
  E.btCottage = { isOpen, flag: FLAG, sceneIds: { closed: CLOSED, open: OPEN }, install };
})();
/* 1.0.4 owns detail measurement, bitmap containment, entry and awaited exit.
   Keep only the story palette; do not override native geometry or animation. */
.se.vd .se-detail-overlay .se-action-insert{border-color:#e2cfaaab;background:#d5c8ad}
.se.vd .se-detail-overlay .se-detail-title,.se.vd .se-detail-overlay .se-detail-caption{background:#17312f}
/* The old picture layer hid portraits during its single inspection beat.
   Keep that staging choice while the shared detail owner is present. */
.se.vd:has(>.se-stage>.se-detail-overlay) .se-chars{opacity:0;pointer-events:none}
/* The complete game supplies bitmap art for every scene. Native fallback SVG
   furniture must not show through the letterbox of a landscape evidence shot. */
.vd .se-bgl[data-image]>.ph{display:none}
/* Keep the letterbox fill blurred: the native reveal animation ends at
   filter:none and otherwise leaves a second sharp copy of scene fixtures. */
.vd .se-bgl[data-image]>.bd{animation:none!important}
/* Outline the native action crop using the engine's own measured image plane.
   No second camera/zoom calculation and no interception of exploration taps. */
.vd .se-bgl[data-action-frame]::after{content:"";position:absolute;pointer-events:none;z-index:3;box-sizing:border-box;left:calc(var(--image-x) + var(--af-l));top:calc(var(--image-y) + var(--af-t));width:calc(var(--af-r) - var(--af-l));height:calc(var(--af-b) - var(--af-t));border:2px solid #e2cfaa;border-radius:8px;box-shadow:0 0 0 2px #102326,0 8px 28px #0009}
.vd .se-bgl[data-action-frame]>.bd{filter:blur(20px) brightness(.30) saturate(.6)}
/* Between Tides: scene continuity and native presentation metadata.
 * No interpreter changes, new story frames, state awards or save-path shifts.
 * Refuge art/state/inscriptions are owned exclusively by bt-refuge.js.
 */
(() => {
  'use strict';
  const E = globalThis.StoryEngine;
  if (!E?.plugin || E.plugins?.['bt-direction']) return;
  const done = new WeakSet();
  const en = st => st.n?.en || st.en || '';
  // v093 forwards `on` for narration but omits it for spoken player lines.
  // The public line renderer already supports the addressee. Keep this
  // adapter scoped to the conversation with Nell; no interpreter replacement.
  const nativeLine = E.ui?.line;
  if (nativeLine) E.ui.line = function (options) {
    const addressingNell = E.S()?.id === 'between-tides' && options?.who === 'me' &&
      E.R()?.stack?.some(frame => frame.n === 'c6_nell_case');
    return nativeLine.call(this, addressingNell ? { ...options, on: 'nell' } : options);
  };
  const objects = {
    ring: ['it-ring', 1], note: ['it-note', 1], claimfile: ['it-claimfile', 1],
    roomkey: ['it-roomkey', 1], jumper: ['it-jumper', 1], cutting: ['it-cutting', 3],
    draft: ['it-draft', 2], vial: ['it-vial', 2], tombottle: ['it-tombottle', 3],
    flask: ['it-flask', 2], logbook: ['it-logbook', 4], skull: ['it-skull', 5],
    peg: ['it-peg', 5], calllist: ['it-calllist', 6],
    c6_nell_letter: ['it-c6_nell_letter', 6],
  };
  const aliases = {
    'causeway-night': 'causeway', 'causeway-flooded': 'causeway',
    'causeway-dawn': 'causeway', 'harbour-dawn': 'harbour',
    'lantern-yard-dawn': 'lantern', 'cottage-dog': 'cottage',
    'surgery-inside': 'surgery',
    'harbour-lamp-car': 'harbour', 'act-pocket-bagged': 'lifeboat',
  };
  const visit = (value, callback) => {
    if (!value || typeof value !== 'object') return;
    if (Array.isArray(value)) { value.forEach(v => visit(v, callback)); return; }
    callback(value);
    for (const child of Object.values(value)) if (child && typeof child === 'object') visit(child, callback);
  };
  // Round 3: sixteen requested narration runs plus the nested wall inspection,
  // each with two or three meaningful views.
  // These are native presentation fields on existing objects. No new steps,
  // prose, conditions, rewards, voice entries or saved cursor indices.
  // The gentle location looks use measured painted landmarks. Evidence
  // inserts reuse only pictures already available at that point in the case.
  const view = (box, maxScale = 1.16) => ({ box, maxScale });
  const detail = art => ({ art, detail: true });
  const narration = {
    c2_open: [
      ['24', { look: null }],
      ['26', { look: view([0, 61, 43, 25], 1.12) }], // the table on the way out
      ['27', { look: view([47, 26, 23, 19], 1.12) }], // the moonlit window
      ['28', { look: null }],
    ],
    c2_cottage: [
      ['19.then.0', { scene: 'cottage-open-dog', look: view([48, 23, 47, 47], 1.08) }],
      ['19.then.1', { look: view([54, 43, 14, 18], 1.2) }], // warm stove, not a bagged exhibit
      ['19.then.3', { look: null }],
    ],
    c2_tellfull: [
      ['19', { look: view([62, 49, 38, 23], 1.12) }], // boat at the slip
      ['21', { look: null }], // whole slipway as people gather from the lane
      ['26', { look: view([1, 51, 32, 18], 1.08) }], // Dodd's bench
      ['27', { look: null }],
    ],
    c2_boat: [
      ['7', { look: null }],
      ['8', { look: view([49, 40, 45, 17], 1.16) }], // channel posts
      ['11', { look: view([10, 17, 40, 30], 1.18) }], // iron legs and ladder
      ['16', { look: null }],
      ['24', { look: null }],
      ['25', { look: view([15, 40, 29, 25], 1.16) }], // Tom's lowered face
      ['27', { look: null }], // the cramped whole refuge again
      ['28', { look: null }],
      // Additional recursive-census case: the physical wall during the rescue.
      // Reuse bt-refuge's exact inscription coordinates, then clear the look
      // on the existing note step before the native exploration menu returns.
      ['29.explore.spots.2.then.0', { look: view([10, 35.5, 33.5, 7.8], 3.2) }],
      ['29.explore.spots.2.then.1', { look: view([10.5, 35.7, 32.5, 2.3], 3.2) }],
      ['29.explore.spots.2.then.2', { look: view([10.5, 38.2, 32.5, 2.3], 3.2) }],
      ['29.explore.spots.2.then.4', { look: view([10, 35.5, 33.5, 7.8], 3.2) }],
      ['29.explore.spots.2.then.5', { look: null }],
    ],
    c3_open: [
      ['10', { look: view([25, 59, 66, 34], 1.12) }], // the slipway
      ['11', { look: view([0, 30, 34, 35], 1.12) }], // the shelter beside it
      ['13', { look: null }],
    ],
    c3_refuge: [
      ['4', { look: null }],
      ['5', { look: view([39, 49, 53, 30], 1.16) }], // water over the road
      ['9', { look: view([10, 25, 39, 32], 1.18) }], // the only refuge
      ['10', { look: null }],
    ],
    c3_photo: [
      ['3', { look: null }],
      ['4', { look: view([83, 28, 17, 40], 1.12) }], // the back-room door
      ['5', { look: null }],
      ['7', { shot: 'cg-car-recovered', look: null }], // show Photo 3 as its caption is read
      ['17', { look: view([25, 21, 60, 61], 1.08) }],
      ['19', { look: view([57, 32, 29, 43], 1.18) }], // wheel and pedals
      ['20', { look: view([24, 29, 39, 46], 1.18) }], // the recorded seat position
      ['21', { look: null }],
    ],
    c3_notsuicide: [
      ['0', { overlay: detail('it-vial') }],
      ['1', { overlay: detail('it-vial') }],
      ['2', { overlay: detail('it-flask') }],
      ['3', { overlay: detail('act-label') }],
    ],
    c4_cottage: [
      // bt-refuge owns the writing and the combined frame at20. These two
      // native looks follow its measured morning/last rows without changing ink.
      ['21', { look: view([10.5, 35.7, 32.5, 2.3], 3.2) }],
      ['22', { look: view([10.5, 38.2, 32.5, 2.3], 3.2) }],
      ['25', { look: 'refuge_readings' }],
      ['46', { look: null }],
      ['47', { overlay: detail('act-1471') }], // recap the already heard21:11 call
      ['49', { overlay: detail('lantern-bottle-gone') }], // the known bar telephone
    ],
    c4_boat: [
      ['15', { look: view([64, 51, 36, 22], 1.12) }],
      ['16', { overlay: detail('act-prints') }],
      ['18', { look: view([63, 57, 37, 21], 1.16) }],
      ['19', { look: null }],
    ],
    c5_vigil: [
      // bt-lantern-stage restores the whole interior at8.
      ['9', { look: view([82, 23, 16, 10], 1.16) }], // empty place on the shelf
      ['11', { look: view([48, 51, 24, 26], 1.12) }], // Fergus's stool
      ['13', { look: null }],
    ],
    c5_dunes: [
      ['39', { look: view([29, 60, 46, 17], 1.2) }], // disturbed hollow
      ['41', { look: view([37, 62, 28, 12], 1.36) }],
      ['45', { look: view([34, 63, 35, 14], 1.28) }],
      ['46', { look: null }],
      ['64', { look: view([41, 33, 26, 30], 1.12) }], // the ring and hands
      ['65', { look: view([28, 0, 65, 21], 1.12) }], // the receding water behind them
      ['68', { look: null }],
      ['70', { look: null }],
    ],
  };
  const narrationDone = new WeakSet();
  const frameNarration = S => {
    for (const [node, entries] of Object.entries(narration)) {
      for (const [path, presentation] of entries) {
        const st = path.split('.').reduce((value, key) => value?.[key], S.nodes?.[node]);
        if (!st || narrationDone.has(st)) continue;
        Object.assign(st, JSON.parse(JSON.stringify(presentation)));
        narrationDone.add(st);
      }
    }
  };
  const install = () => {
    const S = E.S();
    if (S?.id !== 'between-tides') return;
    S.fit = 'contain';
    S.detailExplore = true;
    // Narrow the native cellar hit regions to the visible inner objects.
    // Keep ch6.js byte-identical so existing save-map source revisions remain
    // valid; this is the same presentation-only chapter projection as below.
    if (S.places?.c6_cellar) {
      const cellar = E.regionsAll?.cellar || {};
      E.regions({ cellar: { ...cellar, size: [...(cellar.size || [941, 1672])], r: {
        ...(E.regionsOf?.('cellar') || cellar.r || {}),
        c6_phone: [10.5, 28, 8, 10.5], c6_sink: [10, 47, 26, 11], c6_steps: [75, 24, 12, 40],
      } } });
    }
    for (const [name, base] of Object.entries(aliases)) {
      S.scenes[name] ||= { ...S.scenes[base], time: undefined, fx: undefined };
    }
    for (const [id, [art, chapter]] of Object.entries(objects)) {
      const it = S.items?.[id];
      if (!it) continue;
      if (art) it.art = art;
      it.kind = 'object';
      it.recordType = 'object';
      it.chapter = chapter;
    }
    // Frames are patched once in place. Returning to a checkpoint cannot add
    // presentation data twice, and lazy chapters receive the same treatment.
    for (const collection of ['nodes', 'places', 'talks', 'events']) {
      for (const [id, value] of Object.entries(S[collection] || {})) {
        visit(value, st => {
          if (done.has(st)) return;
          done.add(st);
          // Slow camera drift used to continue behind dialogue and hotspots.
          // Native actionFrame/motion owns deliberate action shots instead.
          if (Object.hasOwn(st, 'cam')) st.cam = null;
          // The folder used to remain low on the passenger seat behind the
          // dialogue. Use its existing complete object art as a native detail
          // plate for both lines; the sealed photograph envelope stays closed.
          if (id === 'c1_open' && (en(st).startsWith('On the passenger seat, under the envelope') ||
            en(st).startsWith('You requested a copy in your first week'))) {
            st.pic = 'it-claimfile'; st.look = null;
          }
          if (id === 'c1_open' && st.look === 'seat') st.look = null;
          if (id === 'c1_open' && st.item === 'claimfile') delete st.from;
          if (st.bg === 'causeway') {
            if (id === 'c2_leo' || id === 'c3_refuge') st.bg = 'causeway-flooded';
            else if (!id.startsWith('c1_') || ['c1_evening', 'c1_bell'].includes(id)) st.bg = 'causeway-night';
          }
          if (id === 'c4_cottage' && st.bg === 'cottage') st.bg = 'cottage-dog';
          // Leo has secured TOM's bottle by the late-night return. Keep the
          // earlier pub artwork intact; only these later chapters use the
          // matching shelf with its empty space. Exterior staging runs after
          // this mapping and retains its own night images.
          if (/^c[56]_/.test(id)) {
            for (const key of ['bg', 'scene', 'pic', 'cg', 'shot', 'img']) {
              if (st[key] === 'lantern') st[key] = 'lantern-bottle-gone';
            }
          }
          // The early call rings upstairs; the cellar handset is only seen
          // much later, when the player can inspect the source of that call.
          if (id.startsWith('c1_') && st.pic === 'act-handset') st.pic = 'lantern-bar';
          if (id === 'c4_cottage' && st.sfx === 'phone') st.sfx = 'phone_keys';
          if (id === 'c1_evening' && st.pic === 'act-bottle-hand') st.pic = 'act-nell-pour';
          if (id === 'c3_pocket' && st.pic === 'act-pocket') st.pic = 'act-pocket-bagged';
          if (id === 'c3_pocket' && st.explore) {
            st.explore.img = 'act-pocket-bagged';
            const centres = { matches: [10, 49], pencil: [29, 49], hanky: [48, 49], vial: [66, 49], flask: [87, 49] };
            for (const spot of st.explore.spots || []) {
              const xy = centres[spot.id];
              if (xy) [spot.x, spot.y] = xy;
            }
          }
          if (id === 'c5_dunes' && st.explore) {
            const centres = { pegs: [24, 62], hollow: [51, 66], house: [90, 34] };
            for (const spot of st.explore.spots || []) {
              const xy = centres[spot.id];
              if (xy) [spot.x, spot.y] = xy;
            }
          }
          // Distinguish the recovery photograph from the two childhood
          // memories without moving an authored frame or saved pointer.
          if (id === 'c3_photo' && st.cg === 'cg-mem-nails') {
            delete st.cg; st.shot = 'cg-car-recovered';
          }
          if (id === 'c3_photo' && en(st).startsWith('You can hear her nails tapping')) st.shot = 'cg-mem-nails';
          if (id === 'c3_photo' && st.cg === 'cg-photo-seat') {
            delete st.cg; st.shot = 'cg-photo-seat';
          }
          if (id === 'c3_seat' && en(st).startsWith('Behind her seat')) st.shot = 'cg-mem-seat';
          if (id === 'c3_seat' && st.cg === null) {
            delete st.cg; st.shot = null;
          }
          if (id === 'c3_notsuicide' && en(st).startsWith('Suppose Tom added')) st.scene = 'lifeboat';
          if (id === 'c2_slip' && st.pic === 'act-pocket') st.pic = 'act-pocket-before';
          if (id === 'c2_slip' && en(st).startsWith('Then, from the same pocket')) st.pic = 'act-pocket';
          // A location used as a CG hides the cast in the native engine.
          // Helen's confession needs her visible beside her parked car.
          if ((id === 'c3_out' || id === 'c4_open') && st.cg === 'harbour-lamp') {
            delete st.cg;
            st.bg = 'harbour-lamp-car';
          }
          if (id === 'c4_open' && st.bg === 'harbour') st.bg = 'harbour-lamp-car';
          if (id === 'c5_card' && en(st).startsWith('Dr Vosper goes to a grey cabinet')) {
            delete st.pic;
            st.scene = 'surgery-inside';
          }
          if (id === 'c6_nell_case' && en(st).startsWith('The call came from your cellar, Nell')) st.on = 'nell';
          if ((id === 'c5_dunes' || id === 'c5_jumper') && st.pic === 'act-cuff') st.pic = 'act-cuff-callum';
          // Two matching views show a physical change. Native motion owns
          // skip/replay, endpoint saves, reduced motion and cancellation.
          if (id === 'c2_bar' && en(st).startsWith('She lifts the hatch')) {
            delete st.pic;
            st.shot = 'act-hatch-open';
            st.actionFrame = { focus: [25, 32, 50, 46], context: [5, 5, 90, 90], zoom: 1 };
            st.motion = { id: 'cellar-hatch-closes', ms: 1100, peek: true,
              backdrop: { frames: [{ offset: 0, art: 'act-hatch-open' }, { offset: .65, art: 'act-hatch' }] } };
          }
          if (id === 'c2_bar' && en(st).startsWith('The tap goes on coughing')) {
            delete st.pic; st.shot = 'act-hatch';
            st.actionFrame = { focus: [25, 32, 50, 46], context: [5, 5, 90, 90], zoom: 1 };
          }
          if (id === 'c2_bar' && en(st).startsWith('Through the window, headlights')) st.shot = null;
          if (id === 'c2_bar' && en(st).startsWith('The tap stops coughing')) {
            delete st.pic;
            st.shot = 'act-hatch';
            st.actionFrame = { focus: [25, 32, 50, 46], context: [5, 5, 90, 90], zoom: 1 };
            st.motion = { id: 'cellar-hatch-opens', ms: 1100, peek: true,
              backdrop: { frames: [{ offset: 0, art: 'act-hatch' }, { offset: .45, art: 'act-hatch-open' }] } };
          }
          if (id === 'c2_bar' && en(st).startsWith('Fergus eases himself')) st.shot = null;
          if (st.act?.kind === 'swipe' && st.act?.r === 'ladder') {
            st.actionFrame = { focus: 'ladder', context: [5, 5, 90, 88], zoom: 1.15 };
          }
        });
      }
    }
    for (const entry of S.flow || []) {
      if (Number(entry.ch) >= 5 && entry.scene === 'lantern') entry.scene = 'lantern-bottle-gone';
    }
    frameNarration(S);
  };
  E.plugin({ id: 'bt-direction', on: {
    boot: install,
    chapter: install,
  } });
})();
// Between Tides — bảo toàn kiến thức của lần chơi và hành động đang làm dở.
// Nạp sau action.js, trước boot.js. Không thay đổi file lõi hoặc định dạng save.
(() => {
  "use strict";
  const E = globalThis.StoryEngine;
  if (!E?.plugin || E.plugins?.["bt-integrity"]) return;
  const nativeState = E.state;
  const nativeAct = E.mech?.act;
  const isThisStory = () => E.S()?.id === "between-tides";

  // choice.need dạng chuỗi trong engine đọc trực tiếp bộ sưu tập G.truths.
  // Đổi riêng yêu cầu T1–T14 thành điều kiện theo R, giữ nguyên mảng/đường dẫn save.
  const normalizeRequirements = data => {
    if (!isThisStory()) return;
    const visited = new WeakSet();
    const walk = value => {
      if (!value || typeof value !== "object" || visited.has(value)) return;
      visited.add(value);
      if (typeof value.need === "string" && /^T(?:[1-9]|1[0-4])$/.test(value.need)) {
        const id = value.need;
        value.need = s => !!s.R?.truths?.[id];
      }
      for (const child of Object.values(value)) walk(child);
    };
    walk(data);
  };

  E.plugin({
    id: "bt-integrity",
    mechs: nativeAct ? {
      act(c) {
        // Chưa hoàn tất cử chỉ thì tải lại phải trở về chính bước ấy.
        // Nhánh ok/fail và mọi xử lý pointer vẫn do action.js gốc thực hiện.
        if (isThisStory()) c.resumeHere?.();
        return nativeAct(c);
      },
    } : {},
    on: {
      boot: normalizeRequirements,
      chapter: normalizeRequirements,
    },
    setup() {
      E.state = function (...args) {
        const state = nativeState.apply(this, args);
        if (isThisStory()) state.truth = id => !!state.R?.truths?.[id];
        return state;
      };
    },
  });
})();
/* Between Tides: one Lantern exterior, native location and bounded composition.
 * Only presentation metadata changes. Every story object, array index, choice,
 * hotspot visit and save pointer remains in its authored place.
 */
(() => {
  'use strict';
  const E = globalThis.StoryEngine;
  if (!E?.plugin || E.plugins?.['bt-lantern-stage']) return;
  if (typeof document === 'undefined' && !E.mech && typeof E.S !== 'function') return;

  const FRONT = 'lantern-front', YARD = 'lantern-yard';
  const PARKED = 'lantern-night-parked', EMPTY = 'lantern-night-empty';
  const LATE = 'lantern-bottle-gone';
  const text = st => st?.n?.en || st?.think?.en || st?.en || '';
  // Measured on the accepted canonical 941 × 1672 portrait. Both daytime
  // views share this physical arrangement; the phone box never changes side.
  const regions = {
    'bt-lantern-phonebox': [10, 48, 13, 20],
    'bt-lantern-door': [36, 49, 11, 18],
    'bt-lantern-landrover': [58, 56, 30, 14],
    'bt-lantern-facade': [5, 34, 90, 40],
    'bt-lantern-context': [3, 33, 94, 42],
    'bt-lantern-night-context': [0, 33, 100, 43],
  };
  const nightRegions = { 'bt-lantern-gideon': [3, 59, 48, 14] };
  const composition = (focus = 'bt-lantern-facade', night = false) => ({
    focus, context: night ? 'bt-lantern-night-context' : 'bt-lantern-context', zoom: 1,
  });
  const exterior = (st, scene, focus, night = false) => {
    if (!st) return;
    if (scene) st.scene = scene;
    st.actionFrame = composition(focus, night);
    // Native actionFrame keeps this semantic focus for resume without the
    // separate inspection zoom that previously cropped the vehicle away.
    st.look = focus || 'bt-lantern-facade';
  };
  const interior = st => {
    if (!st) return;
    st.scene = LATE; st.actionFrame = null; st.look = null;
  };
  const install = () => {
    const S = E.S();
    if (S?.id !== 'between-tides') return;
    const name = S.scenes.lantern.name;
    if (S.nodes?.c5_vigil || S.nodes?.c6_open) {
      // Same painted room and coordinates, after the bottle was seized.
      // Ch5's empty declaration makes the new art a first-use chapter asset.
      S.scenes[LATE] = { ...S.scenes.lantern, ...S.scenes[LATE] };
      const base = E.regionsAll?.lantern || {};
      E.regions({ [LATE]: { ...base,
        size: [...(base.size || [941, 1672])],
        r: JSON.parse(JSON.stringify(E.regionsOf?.('lantern') || base.r || {})),
      } });
    }
    for (const [id, time] of [[FRONT, '17:10'], [YARD, undefined], [PARKED, '01:45'], [EMPTY, '02:21']]) {
      S.scenes[id] = { ...S.scenes[id], kind: 'village', name, time, amb: 'sea', fit: 'contain' };
    }
    const data = {};
    for (const id of [FRONT, YARD, PARKED, EMPTY]) data[id] = {
      size: [941, 1672], fit: 'contain', r: { ...regions,
        ...(id === PARKED || id === EMPTY ? nightRegions : {}),
        phonebox: regions['bt-lantern-phonebox'], door: regions['bt-lantern-door'],
        landrover: regions['bt-lantern-landrover'],
      },
    };
    E.regions(data);

    const arrival = S.nodes?.c1_lantern;
    if (arrival) {
      const entry = arrival.find(st => st.shot === FRONT || st.bg === FRONT);
      if (entry) { delete entry.shot; entry.bg = FRONT; }
      exterior(arrival.find(st => text(st).startsWith('The Lantern is a low stone house')), FRONT);
      exterior(arrival.find(st => text(st).startsWith('A phone box stands beside the porch')), FRONT, 'bt-lantern-phonebox');
      exterior(arrival.find(st => text(st).startsWith('In the yard beside it stands an old Land Rover')), FRONT, 'bt-lantern-landrover');
    }

    const yard = S.places?.c1_bar?.views?.yard;
    if (yard) {
      yard.size = [941, 1672]; yard.fit = 'contain';
      for (const zone of yard.zones || []) {
        const focus = 'bt-lantern-' + zone.id;
        if (!regions[focus]) continue;
        zone.r = focus;
        for (const st of zone.then || []) if (st.n || st.think || st.say) exterior(st, null, focus);
      }
    }

    const vigil = S.nodes?.c5_vigil;
    if (vigil) {
      const entry = vigil.find(st => st.bg === 'lantern' || st.bg === LATE || st.bg === PARKED);
      if (entry) entry.bg = PARKED;
      const ambience = vigil.find(st => st.amb === 'room' || st.amb === 'sea');
      if (ambience) ambience.amb = 'sea';
      exterior(vigil.find(st => text(st).startsWith('The yard beside the porch is dark')), PARKED, null, true);
      exterior(vigil.find(st => text(st).startsWith('Quarter to two. The Lantern is still lit')), PARKED, 'bt-lantern-gideon', true);
      for (const branch of [vigil[7]?.then, vigil[7]?.else]) {
        for (const st of branch || []) if (st.think) exterior(st, PARKED, null, true);
      }
      interior(vigil.find(st => text(st).startsWith('Inside, a handful of people')));
    }

    const opening = S.nodes?.c6_open;
    if (opening) {
      const entry = opening.find(st => st.bg === 'lantern' || st.bg === LATE || st.bg === EMPTY);
      if (entry) entry.bg = EMPTY;
      exterior(opening[7], EMPTY, 'bt-lantern-door', true);
      exterior(opening[8], EMPTY, 'bt-lantern-landrover', true);
      for (const branch of [opening[9]?.then, opening[9]?.else]) {
        for (const st of branch || []) if (st.n) exterior(st, EMPTY, null, true);
      }
      interior(opening[10]);
    }
  };
  E.plugin({ id: 'bt-lantern-stage', on: { boot: install, chapter: install }, setup() {
    // Old saves can resume mid-line with the previous room ID. Let the native
    // scene renderer own the transition and stored presentation; never use
    // global chapter completion to change an earlier chapter's bottle.
    const nativeScene = E.ui?.scene;
    if (nativeScene) E.ui.scene = function (id, ...args) {
      const late = E.S()?.id === 'between-tides' && Number(E.R()?.ch) >= 5 && E.S().scenes?.[LATE];
      return nativeScene.call(this, late && id === 'lantern' ? LATE : id, ...args);
    };
  } });
  E.btLanternStage = { install, regions, nightRegions, sceneIds: { front: FRONT, yard: YARD, parked: PARKED, empty: EMPTY, lateInterior: LATE } };
})();
/* Between Tides presentation metadata on the shared engine 1.0.4.
 * Approved record art and the ten final outcomes are story-specific. Native
 * inventory, record ownership, overview actions and ending awards are unchanged.
 */
(() => {
  'use strict';
  const E = globalThis.StoryEngine;
  if (!E?.plugin || E.plugins?.['bt-native-v104-presentation']) return;
  const ours = () => E.S()?.id === 'between-tides';
  const endings = [
    ['e1_tides','E1 · Between Tides','E1 · Giữa hai con nước'],
    ['e2_low_water','E2 · Low Water','E2 · Nước ròng'],
    ['e3_half_truth','E3 · Half the Truth','E3 · Nửa sự thật'],
    ['e4_stranger','E4 · The Outsider','E4 · Người ngoài'],
    ['e5_envelope','E5 · The Envelope','E5 · Phong bì'],
    ['e6_ampoules','E6 · The Ampoules','E6 · Những ống thuốc'],
    ['e7_sand','E7 · Sand','E7 · Cát'],
    ['e8_refuge','The Refuge Box','Chòi trú nạn'],
    ['e9_mercy','E9 · Mercy','E9 · Lòng thương'],
    ['e10_keeper','E10 · The Keeper','E10 · Người gác nước'],
  ];
  // The native record filters accept this metadata hook. Keep the approved
  // BT classification while the shared engine owns the candidate set and UI.
  const previousMeta = E.evidenceMeta;
  E.evidenceMeta = id => {
    if (!ours()) return previousMeta?.(id);
    const item = E.S().items?.[id] || {}, raw = item.recordType || item.kind || 'observation';
    const type = raw === 'document' ? 'object' : ['object','testimony','inference','observation'].includes(raw) ? raw : 'observation';
    return { type, group: type === 'testimony' ? 'testimony' : type === 'inference' ? 'inference' : 'objects',
      who: item.who || '', chapter: +item.chapter || +(String(id).match(/^c(\d)_/)?.[1]) || 1,
      brief: item.brief || item.desc, sourceLabel: item.sourceLabel || item.source };
  };
  const nativeArt = E.itemArt;
  E.itemArt = function (id, cls = '') {
    const item = ours() && E.S().items?.[id];
    // Native inference-art guard still wraps this delegate. The remaining
    // records use their already-approved image, rather than a guessed filename.
    const art = item?.art || (item?.recordType === 'testimony' && (item.portrait || item.who));
    if (!art) return nativeArt.call(this, id, cls);
    return `<span class="se-ia ${E.esc(cls)}" aria-hidden="true"><i class="im-${E.esc(art)}"></i></span>`;
  };
  const decorateEndingCount = () => {
    if (!ours()) return;
    const row = document.querySelector('.se-panel.ov .se-ovend1');
    if (!row) return;
    const unlocked = endings.filter(([id]) => E.G().endings?.[id]);
    row.querySelector('em').textContent = `${unlocked.length}/${endings.length}`;
    row.querySelector('.se-ovdots').innerHTML = endings.map(([id]) => `<u class="${E.G().endings?.[id] ? 'on' : ''}"></u>`).join('');
    row.querySelector('small').textContent = unlocked.length
      ? unlocked.slice(-2).map(([id, en, vi]) => E.nat(E.S().endings?.[id]?.title || { en, vi })).join(' · ')
      : E.nat({ en: 'None yet', vi: 'Chưa có' });
  };
  const overview = E.ui.title;
  E.ui.title = function (...args) {
    const result = overview.apply(this, args);
    decorateEndingCount();
    return result;
  };
  E.plugin({ id: 'bt-native-v104-presentation', on: { boot() {
    if (!ours()) return;
    // These supported options were already enabled by the approved bt-mobile.
    Object.assign(E.S(), { transientHints: true, recordPresentation: 'compact', inspectionZoom: false, collapsibleObjectives: true, recordReceipts: true });
    decorateEndingCount();
  } } });
})();
// Between Tides save lineage bridge. Engine 1.0.4 owns snapshots, storage,
// resume and the menu; this adapter retains the released JSON save format.
(() => {
  "use strict";
  const E = globalThis.StoryEngine;
  if (!E?.plugin || E.plugins?.["bt-native-v104-save"] || typeof E.snapshot !== "function") return;
  const ID = "between-tides", clone = value => JSON.parse(JSON.stringify(value));
  const nativeSnapshot = E.snapshot;
  let savedPreferences = false;

  // The native boot merges defaults into G.set. Read only whether preferences
  // already existed before that merge, so the BT first-run language defaults
  // cannot replace an existing player's explicit settings. Writes remain in E.save.
  const boot = E.boot;
  E.boot = async function (...args) {
    savedPreferences = false;
    if (!new URLSearchParams(location.search).get("reset")) {
      try {
        const sdk = globalThis.Enmi;
        const global = sdk ? (await sdk.load())?.["se." + ID + ".g"]
          : JSON.parse(localStorage.getItem("se." + ID + ".g") || "null");
        savedPreferences = !!global?.set && typeof global.set === "object" && !Array.isArray(global.set);
      } catch { /* Unavailable storage uses the engine's normal defaults. */ }
    }
    return boot.apply(this, args);
  };

  E.btPersistence = {
    hasSavedPreferences: () => savedPreferences,
    // During overview, the native snapshot reads the preserved stored run.
    // Keep the unconverted revision available to the lineage playCh adapter.
    getRun: () => clone(nativeSnapshot.call(E)),
    persist() { const run = E.snapshot(); E.save(); return clone(run); },
    async prepareSave(data) {
      const lastChapter = Math.max(1, ...(E.S().chapters || []).map(chapter => chapter.ch));
      if (!(await E.loadUpTo(lastChapter))) throw Error("Chapter data could not be loaded. Your save is unchanged. · Chưa nạp được chương; bản lưu được giữ nguyên.");
      const compat = E.btSaveCompat, nextGlobal = clone(data.global);
      const nextRun = compat.migrate(data.run);
      compat.migrateGlobal(nextGlobal, true);
      data.run = nextRun; data.global = nextGlobal;
    },
  };

  const controls = host => {
    if (!host || host.querySelector("[data-bt-save-transfer]")) return;
    const section = document.createElement("div");
    section.className = "se-og"; section.dataset.btSaveTransfer = "";
    section.innerHTML = '<h4>Save file · Tệp lưu</h4><div class="se-row"><button type="button" class="se-btn" data-export>Export save · Xuất bản lưu</button><button type="button" class="se-btn" data-import>Import save · Nhập bản lưu</button></div>';
    section.querySelector("[data-export]").onclick = () => E.btSaveTransfer.exportSave();
