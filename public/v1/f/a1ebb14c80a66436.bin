      const scale = Math.min(width / 320, 1), lineH = 20 * scale;
      const uses = [];
      for (let line = 0; line < Math.floor(height / lineH); line++) for (let col = 0; col < 2; col++) {
        const k = (line + col + p) % 3;
        uses.push(`<use href="#${id}-a${k}" transform="translate(${(x + col * width * .51).toFixed(2)} ${(y + line * lineH).toFixed(2)}) scale(${scale.toFixed(4)})" opacity="${(.48 + (line % 4) * .05).toFixed(3)}"/>`);
      }
      parts.push(`<g class="bt-refuge-archive"${v.exclude?.length ? ` mask="url(#${id}-mask)"` : ""}>${uses.join("")}</g>`);
    }
    if (v.readableArchive) {
      const [px, py, pw] = v.readableArchive;
      archive.forEach((r, i) => {
        const l = inkLine(r.text), scale = X(pw) / Math.max(...archive.map(a => inkLine(a.text).width));
        parts.push(`<g data-refuge-record="${r.id}" data-exact-text="${esc(r.text)}" transform="translate(${X(px)} ${Y(py) + i * 23 * scale}) scale(${scale})" opacity=".75" ${pathStyle}>${l.markup}</g>`);
      });
    }
    if (v.current) {
      const [px, py, pw] = v.current;
      const baseWidth = inkLine(rows.morning.text).width;
      current.forEach((r, i) => {
        const l = inkLine(r.text, { slope: r === rows.last ? .038 : 0, retrace: r === rows.last });
        const scale = X(pw) / baseWidth * (r === rows.keeper ? 1.08 : 1);
        parts.push(`<g class="bt-refuge-row" data-refuge-record="${r.id}" data-exact-text="${esc(r.text)}" transform="translate(${X(px)} ${Y(py + v.rowsY[i])}) scale(${scale})" ${pathStyle}>${l.markup}</g>`);
      });
    }
    if (v.sign) {
      const [px, py, pw, ph] = v.sign;
      parts.push(`<text x="${X(px)}" y="${Y(py + ph)}" textLength="${X(pw)}" lengthAdjust="spacingAndGlyphs" font-family="Georgia,serif" font-size="${Y(ph)}" fill="currentColor">REFUGE BOX</text>`);
    }
    if (v.gauge) {
      const g = v.gauge;
      for (let n = Math.ceil(g.min * 10); n <= Math.floor(g.max * 10); n++) {
        const level = n / 10, py = g.y + (g.max - level) / (g.max - g.min) * g.h;
        const label = inkLine(level.toFixed(1)), scale = X(g.w * .53) / label.width;
        parts.push(`<g data-gauge-m="${level.toFixed(1)}" transform="translate(${X(g.x)} ${Y(py) - 6 * scale}) scale(${scale})" ${pathStyle}>${label.markup}</g>`);
        parts.push(`<path d="M${X(g.x + g.w * .67)} ${Y(py)}H${X(g.x + g.w)}" stroke="currentColor" stroke-width="${W * .002}"/>`);
      }
    }
    const values = [...(v.current ? current : []), ...(v.readableArchive ? archive : [])].map(r => r.text).join("; ");
    return `<svg class="bt-refuge-svg" viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet" aria-hidden="true" data-refuge-phase="${phase}" data-refuge-lines="${esc(values)}"><defs>${defs.join("")}</defs>${parts.join("")}</svg>`;
  };

  const visit = (value, fn, seen = new WeakSet()) => {
    if (!value || typeof value !== "object" || seen.has(value)) return;
    seen.add(value); if (!Array.isArray(value)) fn(value);
    for (const child of Object.values(value)) visit(child, fn, seen);
  };
  const enOf = st => typeof st.n === "string" ? st.n : st.n?.en || "";
  const patchMetadata = () => {
    if (!READY || !isStory()) return;
    const S = E.S();
    for (const id of ["box-day", "box-night", "box-dark", "box-dawn"]) S.scenes[id] = { ...S.scenes.box, ...S.scenes[id], amb: "hut" };
    for (const [node, image] of [["c1_box", "box-day"], ["c2_boat", "box-night"], ["c3_refuge", "box-dark"]]) {
      visit(S.nodes[node], st => { if (st.bg === "box") st.bg = image; });
    }
    visit(S.nodes.c2_boat, st => {
      if (st.explore?.spots?.some(x => x.id === "tom")) {
        st.explore.img = "box-night";
        const zones = { tom: [12, 42, 32, 22], flask: [2.5, 65.5, 17, 9], wall: [9.5, 35.9, 34, 5.4], lamp: [19, 26.5, 17, 8.7] };
        st.explore.spots.forEach(sp => { if (zones[sp.id]) { sp.r = zones[sp.id]; sp.inspectR = zones[sp.id]; } });
      }
      if (st.pic === "act-wallphoto") { delete st.pic; st.shot = "act-wallphoto"; st.look = "refuge_readings"; }
      if (enOf(st).startsWith("Then he leans out of the door")) { delete st.pic; st.shot = "act-gaugephoto"; st.look = null; }
      if (enOf(st).startsWith("When you look round, Callum")) { st.shot = null; st.look = null; }
    });
    visit(S.nodes.c2_slip, st => { if (enOf(st).startsWith("Then the wall. Under this morning's line")) { st.shot = "act-wallphoto"; st.look = "refuge_readings"; } });
    visit(S.nodes.c4_cottage, st => {
      const t = enOf(st);
      if (t.startsWith("The wall. Small even numbers") || t === "You look at the two lines on the little screen.") { st.shot = "act-wallphoto"; st.look = "refuge_readings"; }
      if (t.startsWith("Leo swipes to the next picture.")) { st.shot = "act-gaugephoto"; st.look = null; }
      if (t.startsWith("Leo turns to a clean page in his notebook")) { st.shot = null; st.look = null; }
    });
    visit(S.nodes.c6_keeper, st => {
      // Native action.set is applied only by action.js's completion handler.
      // Cancelled/interrupted holds never write the row; no new array is needed.
      if (st.act?.kind === "hold" && st.act.r === "c6_last_line") st.act.set = "c6_wall_written";
    });
    const P = S.places.c1_box;
    const gauge = P?.views?.door?.zones?.find(z => z.id === "gauge");
    if (gauge) {
      gauge.to = "gauge";
      P.views.gauge = { img: "box-gauge-day", up: "door", name: { en: "Gauge from the doorway", vi: "Cọc đo nhìn từ cửa" }, zones: [
        { id: "gauge_read", r: "gauge", label: gauge.label, then: gauge.then },
      ] };
    }
    E.regions({
      "box-day": { size: [941, 1671], r: { line: [10, 34.5, 34, 10], hook: [20, 21, 16, 15] } },
      "box-door": { size: [941, 1671], r: { line: [10, 34.5, 34, 10], gauge: [49, 45, 22, 13], ladder: [48, 59, 24, 12] } },
      "box-line": { size: [941, 1672], r: { line: [16, 35, 62, 11] } },
      "box-walls": { size: [941, 1672], r: { soot: [16, 25, 69, 21], bench: [13, 56, 76, 11] } },
      "box-roof": { size: [941, 1671], r: { hook: [24, 42, 18, 18] } },
      "box-gauge-day": { size: [941, 1672], r: { gauge: [34, 6, 20, 74] } },
      "act-wallphoto": { size: [941, 1671], r: { refuge_readings: { box: [10, 35.5, 33.5, 7.8], maxScale: 3.2 } } },
      "act-gaugephoto": { size: [1448, 1086], r: { gauge: [37, 8, 14, 66] } },
      "act-ladder": { size: [941, 1672], r: { ladder: [16, 42, 66, 43] } },
      "cg-dawn-wall": { size: [941, 1672], r: { c6_last_line: [17, 45, 55, 7] } },
    });
  };

  let observer, raf = 0, cleanup = () => {};
  const paint = () => {
    raf = 0;
    if (!READY || !isStory()) return;
    const run = E.R();
    document.querySelectorAll(".se-bgl[data-image]").forEach(layer => {
      const image = layer.dataset.image;
      const old = layer.querySelector(":scope > .bt-refuge-ink");
      if (!views[image]) { old?.remove(); return; }
      const signature = image + "|" + phaseFor(image, run);
      if (old?.dataset.signature === signature) return;
      old?.remove();
      const svg = svgFor(image, run);
      if (!svg) return;
      layer.insertAdjacentHTML("beforeend", E.vbox(image, svg, "bt-refuge-ink"));
      const ink = layer.querySelector(":scope > .bt-refuge-ink");
      ink.dataset.signature = signature;
      E.syncImagePlanes?.(layer);
    });
    document.querySelectorAll(".se-pic:not(.out) .fr > i").forEach(el => {
      const image = [...el.classList].find(c => c.startsWith("im-"))?.slice(3);
      if (!views[image]) return;
      const signature = image + "|" + phaseFor(image, run);
      if (el.dataset.refugeSignature === signature) return;
      el.classList.add("bt-refuge-photo");
      el.dataset.refugeSignature = signature;
      el.querySelector(".bt-refuge-svg")?.remove();
      el.insertAdjacentHTML("beforeend", svgFor(image, run).replace('preserveAspectRatio="xMidYMid meet"', 'preserveAspectRatio="xMidYMid slice"'));
    });
  };
  const schedule = () => { if (READY && !raf) raf = requestAnimationFrame(paint); };
  const install = () => {
    cleanup();
    if (!READY || !isStory()) return;
    patchMetadata();
    const root = document.querySelector(".se-stage");
    if (!root) return;
    observer = new MutationObserver(schedule);
    observer.observe(root, { childList: true, subtree: true, attributes: true, attributeFilter: ["data-image", "class"] });
    cleanup = () => { observer?.disconnect(); cancelAnimationFrame(raf); raf = 0; };
    schedule();
  };

  E.plugin({
    id: "bt-refuge",
    css: ".bt-refuge-ink{pointer-events:none;z-index:1;color:#241f19}.bt-refuge-svg{position:absolute;inset:0;display:block;width:100%;height:100%;overflow:hidden;pointer-events:none;mix-blend-mode:multiply}.bt-refuge-photo{position:relative}.bt-refuge-photo .bt-refuge-svg{color:#241f19}.bt-refuge-ink .vbx{pointer-events:none}",
    on: { boot: install, chapter: patchMetadata, step: schedule, line: schedule, "image-plane": schedule },
    setup() {
      const nativeScene = E.ui?.scene;
      if (nativeScene) E.ui.scene = function (id, ...args) { return nativeScene.call(this, READY && isStory() && id === "box" ? boxFor(E.R()) : id, ...args); };
      E.btRefuge = Object.freeze({ ready: READY, rows, phaseFor, rowsFor, boxFor, svgFor, inkLine, patchMetadata, views, refresh: schedule, capture: Object.freeze({ date: "2024-11-14", time: "22:30", actualMetres: 1.1, printedMetres: 1.7 }) });
    },
  });
})();
/* Reopen physical observations through the native read-only paper viewer.
 * First-visit actions, clues, inventory, flags and meaningful authored `again`
 * branches remain owned by the native place/explore mechanics.
 */
(() => {
  'use strict';
  const E = globalThis.StoryEngine;
  if (!E?.plugin || E.plugins?.['bt-revisit']) return;
  const installed = new WeakSet();
  const clone = x => JSON.parse(JSON.stringify(x));
  let count = 0;
  const textValue = x => x && typeof x === 'object' && typeof x.en === 'string';
  const observations = steps => {
    const lines = []; let title = null;
    for (const st of steps || []) {
      // Never flatten both sides of a condition, a choice or an investigation.
      // Everything shown here is an unconditional observation in this hotspot.
      if (st.if || st.choice || st.ask || st.go || st.talk || st.place || st.explore || st.compare || st.act) break;
      const line = st.n || st.think;
      if (textValue(line)) lines.push(clone(line));
      if (st.read) {
        const doc = typeof st.read === 'string' ? E.S().items?.[st.read]?.doc || E.S().docs?.[st.read] : st.read;
        if (!title && textValue(doc?.title)) title = clone(doc.title);
        for (const entry of doc?.lines || []) if (textValue(entry)) lines.push(clone(entry));
      }
    }
    return { lines, title };
  };
  const genericAgain = steps => Array.isArray(steps) && steps.length > 0 && steps.every(st =>
    Object.keys(st).every(k => ['n', 'think', 'on'].includes(k)) &&
    /already (?:checked|looked|read|seen)|nothing new/i.test(st.n?.en || st.think?.en || ''));
  const install = () => {
    if (E.S()?.id !== 'between-tides') return;
    const seen = new WeakSet();
    const walk = value => {
      if (!value || typeof value !== 'object' || seen.has(value)) return;
      seen.add(value);
      for (const group of [value.zones, value.spots]) if (Array.isArray(group)) for (const spot of group) {
        // Native place invokes `again` only once a widget has been solved.
        // Reopen its successful observation without replaying the gesture.
        const steps = spot.widget ? spot.widget.ok : spot.then;
        if (installed.has(spot) || !Array.isArray(steps) || spot.talk || spot.go) continue;
        installed.add(spot);
        if (spot.again && !genericAgain(spot.again)) continue;
        const { lines, title } = observations(steps);
        if (!lines.length) continue;
        spot.again = [{ read: { paper: 'report', hand: 'type', title: title || clone(spot.label || spot.name || { en: 'Observation', vi: 'Chi tiết đã ghi nhận' }), lines } }];
        count++;
      }
      for (const [key, child] of Object.entries(value)) if (key !== 'again') walk(child);
    };
    for (const key of ['nodes', 'places']) walk(E.S()[key]);
  };
  E.plugin({ id: 'bt-revisit', on: { boot: install, chapter: install } });
  E.btRevisit = { install, count: () => count };
})();
// Between Tides — chuyển save của đúng bản zip gốc sang nội dung đã biên tập.
// Nạp sau bt-save-map.js và bt-native-v104-save.js, trước boot.js. Core giữ nguyên.
(() => {
  "use strict";
  const E = globalThis.StoryEngine;
  if (!E?.plugin || E.plugins?.["bt-save-compat"]) return;
  // check.js reads plugin names alphabetically without core/state/DOM. This
  // runtime-only adapter defines no new step types for that data-only pass.
  if (typeof document === "undefined" && !E.mech && typeof E.S !== "function") return;
  const M = E.btSaveMap;
  if (!M || M.format !== 1) throw Error("Between Tides save map missing");
  const ID = "between-tides", REV = M.revision, clone = x => JSON.parse(JSON.stringify(x));
  const sourceNodes = new Set(M.sourceNodes), targetNodes = new Set(M.targetNodes);
  const prefixes = Object.entries(M.prefixes).sort((a, b) => b[0].length - a[0].length);
  let starting = false, resumeSerial = 0, warned = "", blockedRun = null;
  const ours = () => E.S()?.id === ID;
  const errorText = "This save belongs to a different story revision. It has been kept unchanged. · Bản lưu thuộc bản truyện khác; dữ liệu được giữ nguyên.";
  const identityRevision = revision => M.compatibleRevisions?.[revision]?.mode === "identity";
  const known = r => !r?.btRevision || r.btRevision === REV || identityRevision(r.btRevision);
  const check = r => { if (!known(r)) throw Error(errorText); };
  const replace = (to, from) => { for (const k of Object.keys(to)) delete to[k]; Object.assign(to, from); };
  const mappedKey = key => {
    for (const [a, b] of prefixes) if (key === a || key.startsWith(a + ".")) return b + key.slice(a.length);
    return key;
  };
  const mapObject = obj => {
    if (!obj || typeof obj !== "object" || Array.isArray(obj)) return obj;
    const out = {};
    for (const [key, value] of Object.entries(obj)) out[mappedKey(key)] = value;
    return out;
  };
  const hasText = (r, en, vi) => (r.log || []).some(l => l.main === en || l.sub === en || vi && (l.main === vi || l.sub === vi))
    || (r.jot || []).some(j => j.t?.en === en || vi && j.t?.vi === vi);
  const recoverObservedFlags = r => {
    // Chỉ công nhận lời/ghi chú có thật trong bản lưu; không suy từ bộ sưu tập.
    const proof = [
      ["c5_back_door", "I ran home. Went in the back. Didn't want the bar seeing my arm. Rooms were empty. November.", "Tôi chạy về nhà. Vào bằng cửa sau. Không muốn người trong quán thấy cánh tay tôi. Phòng trọ thì trống. Tháng Mười một mà."],
      ["c5_mam_account", "I told Mam. I don't remember what. She put me to bed and said I'd dreamed it.", "Tôi kể với mẹ. Tôi không nhớ đã kể những gì. Mẹ đưa tôi lên giường rồi bảo là tôi nằm mơ."],
      ["c5_mam_account", "Callum, 2004: 'I told Mam… She put me to bed and said I'd dreamed it.'", "Callum, 2004: “Tôi kể với mẹ… Mẹ đưa tôi lên giường rồi bảo là tôi nằm mơ.”"],
      ["c5_referred_mam", "Ask my mother where I was that night. Go on.", "Hỏi mẹ tôi xem đêm đó tôi ở đâu. Hỏi đi."],
      ["c5_callum_missed", "MISSED CALL — Tom — 21:12", "MISSED CALL — Tom — 21:12 · Cuộc gọi nhỡ — Tom — 21:12."],
      ["c5_callum_missed", "Callum's phone: MISSED CALL — Tom — 21:12. (He was at the buoys. Engine.)", "Điện thoại Callum: cuộc gọi nhỡ — Tom — 21:12. (Anh đang ở chỗ phao. Tiếng máy.)"],
      ["c3_gideon_call_seen", "Gideon's phone: Cllr R. Hale, incoming, 21:08, 7 min 12 s (to about 21:15).", "Điện thoại Gideon: ủy viên R. Hale gọi đến 21:08, dài 7 phút 12 giây (tới khoảng 21:15)."],
    ];
    for (const [flag, en, vi] of proof) if (!(flag in r.f) && hasText(r, en, vi)) r.f[flag] = true;
  };
  const fallback = (r, oldStack) => {
    const medical = oldStack.some(f => f.n === M.changedPuzzle.node);
    const nearest = [...oldStack].reverse().find(f => sourceNodes.has(f.n) && targetNodes.has(f.n));
    const node = medical ? M.changedPuzzle.node : nearest?.n;
    if (!node) throw Error("This old scene cannot be located safely. The save is unchanged. · Không tìm được cảnh cũ an toàn; bản lưu được giữ nguyên.");
    r.stack = [{ n: node, p: [], i: 0 }];
    r.btRecovery = { node, reason: medical ? "revised-evidence-puzzle" : "changed-nested-scene", pending: true };
    // Giữ frame gốc để người làm game có thể điều tra; không nhân bản toàn bộ save.
    r.btLegacyStack = oldStack;
  };
  const migrate = original => {
    if (!original || typeof original !== "object" || !Array.isArray(original.stack)) throw Error("Invalid story save · Bản lưu không hợp lệ");
    check(original);
    const r = clone(original);
    if (r.btRevision === REV) return r;
    if (identityRevision(r.btRevision)) {
      // This released revision has the same authored frame paths, conditions
      // and effects. Do not apply the much older five-chapter index map again.
      // Transient native nodes are reconstructed and checked after loadUpTo in
      // resume/import; their enclosing authored cursors are checked here too.
      for (const frame of r.stack) {
        if (!frame || typeof frame.n !== "string" || !Array.isArray(frame.p) || !Number.isInteger(frame.i) || frame.i < 0) throw Error("Invalid scene cursor · Vị trí cảnh không hợp lệ");
        const length = M.targetArrays?.[JSON.stringify([frame.n, frame.p])];
        const transient = /^__(present_wrong|present_noev|xp_seen|combo)$/.test(frame.n);
        if ((!Number.isInteger(length) || frame.i > length) && !transient) throw Error("This scene does not match the released story. The save is unchanged. · Cảnh không khớp bản phát hành; bản lưu được giữ nguyên.");
      }
      r.btRevision = REV;
      return r;
    }
    const oldStack = clone(r.stack), frames = [];
    let recover = false;
    for (const frame of oldStack) {
      if (!frame || typeof frame.n !== "string" || !Array.isArray(frame.p) || !Number.isInteger(frame.i) || frame.i < 0) throw Error("Invalid scene cursor · Vị trí cảnh không hợp lệ");
      const sourceLength = M.sourceArrays?.[JSON.stringify([frame.n, frame.p])];
      const dynamic = /^__(present_wrong|present_noev|xp_seen|combo)$/.test(frame.n);
      if (M.sourceArrays && (!Number.isInteger(sourceLength) || frame.i > sourceLength) && !dynamic) throw Error("This scene does not match the original release. The save is unchanged. · Cảnh không khớp bản gốc; bản lưu được giữ nguyên.");
      const at = M.frames[JSON.stringify([frame.n, frame.p, frame.i])];
      if (!at) { recover = true; break; }
      frames.push({ ...frame, n: at[0], p: clone(at[1]), i: at[2] });
    }
    if (recover) fallback(r, oldStack); else r.stack = frames;
    for (const key of ["used", "xpDetail", "presentUI", "pl"]) if (r[key]) r[key] = mapObject(r[key]);
    if (r.vw?.pid) r.vw.pid = mappedKey(r.vw.pid);
    r.f ||= {};
    const flags = {};
    for (const [key, value] of Object.entries(r.f)) {
      const derived = /^(q_|board_|cmp_|qte_|theory_|gaveUp_|rhythm_)(.*)$/.exec(key);
      flags[derived ? derived[1] + mappedKey(derived[2]) : key] = value;
    }
    r.f = flags;
    recoverObservedFlags(r);
    r.btRevision = REV;
    return r;
  };
  const migrateGlobal = (g, strict = false) => {
    if (!g || typeof g !== "object") return;
    for (const key of ["cps", "chAt"]) for (const [id, snap] of Object.entries(g[key] || {})) {
      try { g[key][id] = migrate(snap); }
      catch (error) { if (strict) throw error; /* Conserve unsupported snapshots. */ }
    }
  };
  const resolveFrame = (run, index) => {
    const frame = run.stack[index], authored = E.walk(frame);
    if (Array.isArray(authored)) return authored;
    let generated = null;
    if (frame.n === "__combo") generated = (E.S().combos || []).map(x => x.then || []);
    if (["__present_wrong", "__present_noev", "__xp_seen"].includes(frame.n)) {
      for (let i = index - 1; i >= 0 && !generated; i--) {
        const parent = run.stack[i], step = E.walk(parent)?.[parent.i];
        if (step?.present && frame.n.startsWith("__present_")) generated = step.present[frame.n === "__present_wrong" ? "wrong" : "noEvidence"] || [];
        if (step?.explore && frame.n === "__xp_seen") generated = [{ think: step.explore.seen || { en: "You've already checked this. Nothing new.", vi: "Chỗ này bạn xem kỹ rồi. Không có gì mới." } }];
      }
    }
    for (const key of frame.p) generated = generated?.[key];
    return Array.isArray(generated) ? generated : null;
  };
  const restoreTransientNodes = run => {
    for (let index = 0; index < run.stack.length; index++) {
      const frame = run.stack[index];
      if (E.walk(frame) || !frame.n.startsWith("__")) continue;
      const rootFrame = { ...frame, p: [] }, rootRun = { ...run, stack: run.stack.map((f, i) => i === index ? rootFrame : f) };
      const steps = resolveFrame(rootRun, index);
      if (steps) E.S().nodes[frame.n] = steps;
    }
  };
  const notice = r => {
    if (!r.btRecovery?.pending) return;
    r.btRecovery.pending = false;
    const message = r.btRecovery.reason === "revised-evidence-puzzle"
      ? { en: "Save updated. This evidence puzzle has changed, so the medical scene resumes from its beginning. Your collected evidence and truths are kept.", vi: "Đã cập nhật bản lưu. Câu đố chứng cứ đã đổi, nên cảnh khám nghiệm bắt đầu lại. Vật chứng và sự thật đã tìm vẫn được giữ." }
      : { en: "Save updated. A revised scene resumes from its beginning. Your collected evidence and truths are kept.", vi: "Đã cập nhật bản lưu. Cảnh đã biên tập bắt đầu lại từ đầu. Vật chứng và sự thật đã tìm vẫn được giữ." };
    E.ui.toast(E.esc(E.nat(message)), 9000);
  };
  const refuse = error => {
    // Title dọn cast của R. Giữ snapshot trước khi dọn để unload/menu không
    // ghi biến thể đã bị UI thay đổi lên một save chưa thể tiếp tục an toàn.
    if (!blockedRun && E.R()) blockedRun = clone(E.snapshot());
    E.stop?.();
    E.ui.title?.();
    if (warned !== error.message) { warned = error.message; E.ui.toast(E.esc(error.message), 10000); }
    console.warn("[between-tides] save kept unchanged:", error.message);
    return false;
  };
  // API riêng cho kiểm tra / công cụ nhập. Không phải loại bước mới của engine.
  E.btSaveCompat = { revision: REV, migrate, migrateGlobal, resolveFrame,
    installRun(run) { check(run); if (run.btRevision !== REV) throw Error(errorText); blockedRun = null; replace(E.R(), clone(run)); },
  };

  const snapshot = E.snapshot;
  E.snapshot = function (...args) {
    if (ours() && blockedRun) return clone(blockedRun);
    const raw = snapshot.apply(this, args);
    if (!ours()) return raw;
    let result;
    if (starting) { result = raw; result.btRevision = REV; }
    else if (!known(raw)) return raw; // Không sửa save của phiên bản chưa biết.
    else {
      try { result = migrate(raw); }
      catch { return raw; } // Resume/import sẽ báo rõ, việc lưu không làm mất bản gốc.
    }
    return result;
  };
  const newRun = E.newRun;
  E.newRun = function (...args) {
    if (!ours()) return newRun.apply(this, args);
    resumeSerial++;
    blockedRun = null;
    starting = true;
    try { return newRun.apply(this, args); }
    finally { starting = false; }
  };
  const stop = E.stop;
  E.stop = function (...args) {
    if (ours()) resumeSerial++;
    return stop.apply(this, args);
  };
  const play = E.play;
  E.play = function (...args) {
    if (!ours()) return play.apply(this, args);
    try {
      check(E.R());
      // E.play được core gọi sau newRun hoặc resume đã chuyển đổi bên dưới.
      // Bước debug ?at= cũng khởi tạo một run mới bằng mã truyện hiện tại.
      E.R().btRevision = REV;
      const result = play.apply(this, args);
      notice(E.R());
      return result;
    } catch (error) { return refuse(error); }
  };
  const resume = E.resume;
  E.resume = async function (...args) {
    if (!ours()) return resume.apply(this, args);
    const serial = ++resumeSerial;
    try {
      check(E.R());
      const next = migrate(E.R());
      const needed = Math.max(next.ch || 1, ...next.stack.map(f => +(/^c(\d+)_/.exec(f.n)?.[1] || 1)));
      if (!(await E.loadUpTo(needed))) throw Error("Chapter data could not be loaded. Your save is unchanged. · Chưa nạp được chương; bản lưu được giữ nguyên.");
      if (serial !== resumeSerial) return false;
      if (!next.stack.every((f, i) => { const a = resolveFrame(next, i); return Array.isArray(a) && f.i <= a.length; })) throw Error("Saved scene is not available. Your save is unchanged. · Cảnh trong bản lưu chưa khả dụng; dữ liệu được giữ nguyên.");
      restoreTransientNodes(next);
      blockedRun = null;
      replace(E.R(), next);
      migrateGlobal(E.G());
      E.save();
      return await resume.apply(this, args);
    } catch (error) { return refuse(error); }
  };
  const fromCp = E.fromCp;
  E.fromCp = function (id, ...args) {
    if (!ours() || !E.G().cps?.[id]) return fromCp.call(this, id, ...args);
    try { E.G().cps[id] = migrate(E.G().cps[id]); blockedRun = null; return fromCp.call(this, id, ...args); }
    catch (error) { return refuse(error); }
  };
  const playCh = E.playCh;
  E.playCh = function (ch, ...args) {
    if (!ours()) return playCh.call(this, ch, ...args);
    try {
      if (E.G().chAt?.[ch]) E.G().chAt[ch] = migrate(E.G().chAt[ch]);
      else {
        const cp = (E.S().flow || []).find(x => x.kind === "cp" && x.ch === ch && E.G().cps?.[x.id]);
        if (cp) E.G().cps[cp.id] = migrate(E.G().cps[cp.id]);
        else if (ch > 1) {
          // Core đọc main save trực tiếp khi đi từ kết chương N sang N+1.
          // Chuyển trước lúc core E.jump thay stack bằng node mới của N+1.
          const old = E.btPersistence?.getRun();
          if (old?.done && old.btRevision !== REV) {
            const upgraded = migrate(old);
            replace(E.R(), upgraded); E.save();
          }
        }
      }
      if (E.chOpen(ch)) blockedRun = null;
      return playCh.call(this, ch, ...args);
    } catch (error) { return refuse(error); }
  };

  E.plugin({ id: "bt-save-compat", on: { boot() {
    if (!ours()) return;
    migrateGlobal(E.G()); // Không E.save ở boot: core R lúc này còn rỗng.
  } } });
})();
