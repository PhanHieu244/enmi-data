      panCleanup = () => { cancel(); for (const [event, fn] of [...localEvents,['wheel',wheel]]) viewport.removeEventListener(event, fn); window.removeEventListener('pointerup', up, true); window.removeEventListener('pointercancel', up, true); window.removeEventListener('blur', cancel); };
    };
    const drawMap = () => {
      const c = chs.find(x => x.ch === cur) || chs[0];
      const meta = (S.chapters || []).find(x => x.ch === c.ch);
      zoom = positions.get(String(c.ch))?.zoom || 1;
      const graph = graphOf(c, R, G), idx = graph.list, bypasses = graph.edges.filter(edge => Math.abs(graph.rank.get(edge.b) - graph.rank.get(edge.a)) > 1 || graph.rank.get(edge.b) < graph.rank.get(edge.a)).length;
      const rows = graph.columns.map((column, rank) => `<div class="fx-row fx-column" data-rank="${rank}">${column.map(i => node(idx[i], i, R, G)).join("")}</div>`).join("");
      body.dataset.view = 'map'; body.dataset.chapter = String(c.ch);
      body.innerHTML = `<div class="fx-chh"><small>${esc(chName(c.ch))}</small><b>${esc(nat(meta?.title) || "")}</b><span class="fx-pct"><i style="width:${pctOf(c, R, G)}%"></i></span><em>${pctOf(c, R, G)}% ${esc(nat({en:'routes discovered',vi:'nhánh đã khám phá'}))}${S.truthTotal ? ` · ${truths}/${S.truthTotal} ${esc(nat({ en: "truths", vi: "sự thật" }))}` : ""}</em></div>
        <div class="fx-key"><span class="s-now">${t("now")}</span><span class="s-seen">${t("seen")}</span><span class="s-lock">${t("lock")}</span></div>
        <div class="fx-map-tools"><p>${t('move')}</p><div class="fx-zoom-tools" role="group" aria-label="${t('viewport')}"><button type="button" data-flow-zoom="out" aria-label="${t('zoomOut')}" title="${t('zoomOut')}">−</button><button type="button" data-flow-zoom="reset" aria-label="${t('actual')}" title="${t('actual')}"><span data-flow-zoom-label>100%</span></button><button type="button" data-flow-zoom="in" aria-label="${t('zoomIn')}" title="${t('zoomIn')}">+</button><button type="button" data-flow-fit aria-label="${t('fit')}" title="${t('fit')}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M3 16v5h5M21 16v5h-5M7 7h10v10H7z"/></svg></button><button type="button" data-flow-center aria-label="${t('center')}" title="${t('center')}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="6"/><path d="M12 2v5M12 17v5M2 12h5M17 12h5"/></svg></button></div></div>
        <div class="fx-viewport" tabindex="0" role="region" aria-label="${t('viewport')}"><div class="fx-surface"><div class="fx-wrap" data-crossings-before="${graph.crossings.before}" data-crossings-after="${graph.crossings.after}" style="--fx-column-count:${graph.columns.length};--fx-route-space:${44 + bypasses * 9}px"><svg class="fx-wire" aria-hidden="true"></svg>${rows}</div></div></div>`;
      body._idx = idx;
      const wrap = body.querySelector('.fx-wrap'), viewport = body.querySelector('.fx-viewport');
      if (graph.current >= 0) wrap.querySelector(`[data-n="${graph.current}"]`)?.setAttribute('aria-current', 'step');
      const redraw = () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(() => { if (!closed && wrap.isConnected) { sizeCanvas(); wire(wrap, graph); } }); };
      redraw(); bindPan(viewport);
      // Text changes and orientation changes redraw connectors without moving
      // the user's viewport or changing the story's discovery state.
      try { body._ro = new ResizeObserver(redraw); body._ro.observe(wrap); wrap.querySelectorAll('.fx-n').forEach(n => body._ro.observe(n)); } catch {}
      scrollTimer = setTimeout(() => { if (closed || !wrap.isConnected) return; const saved = positions.get(String(c.ch)); if (saved) { viewport.scrollLeft = saved.left; viewport.scrollTop = saved.top; } else centerCurrent(); }, 60);
    };
    // TÓM TẮT THEO NHÁNH: đường đi lần này (các quyết định đã chọn, theo chương) + chuyện đã qua đúng nhánh đó
    const drawSum = () => {
      body.dataset.view = 'sum';
      const byCh = {};
      for (const p of R.path || []) { const x = (S.flow || []).find(f => f.kind === "opt" && f.key === p.k && f.val === p.v); if (x) (byCh[x.ch || 0] ||= []).push(x); }
      const list = E.recapList();
      const recapBy = {};
      for (const x of list) (recapBy[x.ch ?? 0] ||= []).push(x);
      const ids = [...new Set([...Object.keys(byCh), ...Object.keys(recapBy)].map(Number))].sort((a, b) => a - b);
      body.innerHTML = ids.length ? ids.map(ch => `<div class="fx-sch"><h4>${esc(chName(ch))}${(S.chapters || []).find(c => c.ch === ch)?.title ? ` · ${esc(nat(S.chapters.find(c => c.ch === ch).title))}` : ""}</h4>
        ${byCh[ch]?.length ? `<div class="fx-dec"><small>${t("decisions")}</small>${byCh[ch].map(x => `<div class="fx-dc"><b>${esc(nat(x.label))}</b>${x.sum ? `<span>${esc(nat(x.sum))}</span>` : ""}</div>`).join("")}</div>` : ""}
        ${(recapBy[ch] || []).map(x => `<p class="se-rcp">${esc(nat(x.t))}</p>`).join("")}</div>`).join("") : `<p class="se-mute">${t("none")}</p>`;
    };
    const draw = () => { rememberViewport(); cleanMap(); drawTabs(); det.hidden = true; sh.querySelectorAll('[data-v]').forEach(button => { const active = button.dataset.v === view; button.classList.toggle('on', active); button.setAttribute('aria-pressed', String(active)); }); view === "map" ? drawMap() : drawSum(); };
    // CHI TIẾT 1 ô (chạm): mốc = chuyện tới đây theo bản chụp của mốc đó + Chơi lại · nhánh = hậu quả · kết thúc = lời kết
    const detail = x => {
      const s = stateOf(x, R, G);
      let html = `<div class="fx-dh s-${s}"><small>${t(s === "now" ? "now" : s === "seen" ? "seen" : "lock")}</small>`;
      if (s === "lock") html += `<b>???</b><p>${x.hint ? esc(nat(x.hint)) : t("lockd")}</p>`;
      else if (x.kind === "cp") {
        const snap = G.cps?.[x.id];
        const rc = snap ? E.recapOf(snap, x.ch).filter(r => (r.ch ?? 0) === (x.ch || 0)) : [];
        html += `<b>${esc(nat(x.label))}</b>${x.sum ? `<p>${esc(nat(x.sum))}</p>` : ""}${rc.length ? `<div class="fx-upto"><small>${t("upto")}</small>${rc.slice(-6).map(r => `<p class="se-rcp">${esc(nat(r.t))}</p>`).join("")}</div>` : ""}${E.chOpen(x.ch || 1) ? `<button class="se-btn pri wide" data-cp="${esc(x.id)}">↺ ${t("replay")}</button>` : `<p class="se-mute">${esc(nat({ en: `Finish chapter ${(x.ch || 1) - 1} to replay from here.`, vi: `Xong chương ${(x.ch || 1) - 1} để chơi lại từ đây.` }))}</p>`}`;
      } else if (x.kind === "opt") {
        html += `<b>${esc(nat(x.label))}</b><p class="se-mute">${t(s === "now" ? "picked" : "other")}</p>${x.sum ? `<p>${esc(nat(x.sum))}</p>` : ""}`;
      } else {
        const en = S.endings?.[x.id] || {};
        html += `<b>${esc(nat(en.title || x.label))}</b>${en.sum ? `<p>${esc(nat(en.sum))}</p>` : ""}${en.text ? `<p class="fx-et">${esc(nat(en.text))}</p>` : ""}`;
      }
      det.innerHTML = html + `<button class="fx-dx" data-dx aria-label="${t('close')}">×</button></div>`;
      det.hidden = false;
      E.sfx("tap");
    };
    // .se-sheet dùng lại 1 phần tử cho mọi bảng → gắn bằng onclick (addEventListener sẽ cộng dồn mỗi lần mở)
    const base = sh.onclick;
    sh.onclick = e => {
      base?.(e);
      if (closed) return;
      const v = e.target.closest("[data-v]");
      if (v) { view = v.dataset.v; sh.querySelectorAll("[data-v]").forEach(b => b.classList.toggle("on", b === v)); E.sfx("tap"); return draw(); }
      const c = e.target.closest("[data-ch]");
      if (c) { cur = +c.dataset.ch; if (view !== "map") { view = "map"; sh.querySelectorAll("[data-v]").forEach(b => b.classList.toggle("on", b.dataset.v === "map")); } E.sfx("page"); return draw(); }
      // nút trong khung chi tiết xét TRƯỚC; ô sơ đồ chỉ nhận .fx-n (gốc .se của game cũng mang data-n = node đang chạy →
      //   closest("[data-n]") từng bắt nhầm mọi cú bấm trong khung chi tiết: “Chơi lại từ đây” và × không ăn)
      if (e.target.closest('[data-flow-center]')) { centerCurrent(); return; }
      if (e.target.closest('[data-flow-fit]')) { fitMap(); return; }
      const z = e.target.closest('[data-flow-zoom]');
      if (z) { zoomTo(z.dataset.flowZoom === 'reset' ? 1 : zoom * (z.dataset.flowZoom === 'in' ? 1.2 : 1 / 1.2)); if (z.dataset.flowZoom === 'reset') centerCurrent(); return; }
      if (e.target.closest("[data-dx]")) { det.hidden = true; sh.querySelectorAll(".fx-n.sel").forEach(x => { x.classList.remove("sel"); x.setAttribute('aria-expanded', 'false'); if (!e.detail) x.focus({ preventScroll: true }); }); return; }
      const cp = e.target.closest("[data-cp]")?.dataset.cp;
      if (cp) return E.ui.replayAsk({ cp });
      const n = e.target.closest(".fx-n[data-n]");
      if (n && (!suppressPointerClick || e.detail === 0)) { sh.querySelectorAll(".fx-n.sel").forEach(x => { x.classList.remove("sel"); x.setAttribute('aria-expanded', 'false'); }); n.classList.add("sel"); n.setAttribute('aria-expanded', 'true'); detail(body._idx[+n.dataset.n]); if (!e.detail) det.querySelector('[data-dx]')?.focus({ preventScroll: true }); }
    };
    sh.onclose = () => { closed = true; cleanMap(); };
    draw();
    return sh;
  };
  // Stable map entry for engine controls; story plugins may keep a separate
  // flowSheet route journal without replacing the chapter graph itself.
  E.ui.chapterFlow = E.ui.flowSheet;
})();
// Enmi Story Engine — CÁC CƠ CHẾ (mỗi cơ chế = StoryEngine.def(tên, async ctx => …)). Truyện nào cũng dùng chung.
// ctx: st (bước) · s (trạng thái cho điều kiện) · push(...khoá) chạy mảng bước con (vd. push("choice", 2, "then")) ·
//      again() chạy lại chính bước này sau khi bước con xong (vòng lặp: khám phá, chọn lặp, giải đố) · key(...) khoá duy nhất của bước.
// Danh sách: bg show hide n think say · set add item drop truth word go if cp wait fx title · choice (giờ, khoá, trực giác, đồ vật, lặp) ·
//   explore (điểm nóng, dùng đồ lên cảnh, ghép đồ) · map (chọn hướng đi) · interpret (phiên dịch 2 chiều) · present (vạch lời khai sai) ·
//   listen (nghe không chữ) · quiz · lock (khoá số / chữ) · order (xếp thứ tự / dòng thời gian) · type (gõ câu trả lời) · review · end
(() => {
  const E = globalThis.StoryEngine, def = E.def, esc = E.esc, h = E.h;
  const T = k => E.ui.tr(k);
  const nat = t => E.nat(t), tgt = t => E.tgt(t);
  const pick = (arr) => arr[E.auto === "r" ? Math.floor(Math.random() * arr.length) : 0];
  const later = (fn, ms = 5) => setTimeout(fn, ms);
  // trộn ổn định theo khoá bước (tải lại không đổi thứ tự)
  const shuffle = (arr, seed) => { const a = arr.map((x, i) => [x, i]); let s = E.hash(seed); for (let i = a.length - 1; i > 0; i--) { s = (s * 1103515245 + 12345) >>> 0; const j = s % (i + 1); [a[i], a[j]] = [a[j], a[i]]; } return a; };
  const cond = (c, s) => (c == null ? true : typeof c === "function" ? !!c(s) : typeof c === "string" ? s.truth(c) || s.has(c) || !!s.f[c] : typeof c === "object" && !Array.isArray(c) ? Object.entries(c).every(([k, v]) => (+s.f[k] || 0) >= v) : !!c);
  const optText = o => ({ main: E.tgt(o), sub: E.sub(o) });
  const L = (o) => nat(o);
  const investigationText = t => E.ui.readingText?.(t,{compact:true}) ?? E.ui.investigationText?.(t) ?? esc(nat(t));

  // A review is a navigation detour, never an older run-state snapshot. Keep
  // the original step paths so once-only interactions retain their identities.
  // Authors may opt a choice in/out with reviewExplore:true/false; time limits,
  // relocation and changes to progress still veto a return.
  const reviewCopy = value => value == null ? value : JSON.parse(JSON.stringify(value));
  const reviewVisualKeys = ["cast", "last", "lastTalk", "talkN", "fresh", "shot", "shotBack", "cg", "look", "lookSource", "zoom", "actionFrame", "dialogueFrame", "dialogueFrameLock", "lineFocus", "sceneProps", "props", "vw"];
  const reviewTransient = new Set(["stack", "log", "exploreReview", ...reviewVisualKeys]);
  const reviewSeal = () => {
    const R = E.R(), G = E.G();
    // Settings, collected vocabulary and seen-node navigation can change while
    // reading. They are retained, as is every field excluded from this guard.
    const value = JSON.stringify([Object.fromEntries(Object.entries(R).filter(([key]) => !reviewTransient.has(key))), Object.fromEntries(Object.entries(G).filter(([key]) => !["set", "seen", "words", "cps", "chAt"].includes(key)))]);
    // Persist a small drift guard, not a second copy of progress or recursive
    // checkpoints. Checkpoint/title steps are also explicit boundary barriers.
    let a = 2166136261, b = 5381;
    for (let i = 0; i < value.length; i++) { const code = value.charCodeAt(i); a = Math.imul(a ^ code, 16777619) >>> 0; b = (Math.imul(b, 33) ^ code) >>> 0; }
    return value.length + ":" + a.toString(36) + ":" + b.toString(36);
  };
  const reviewPresentation = () => Object.fromEntries(reviewVisualKeys.filter(key => Object.prototype.hasOwnProperty.call(E.R(), key)).map(key => [key, reviewCopy(E.R()[key])]));
  const reviewRestore = saved => {
    const R = E.R();
    for (const key of reviewVisualKeys) { if (Object.prototype.hasOwnProperty.call(saved, key)) R[key] = reviewCopy(saved[key]); else delete R[key]; }
    R.cast ||= {};
    E.ui.reset(); E.ui.restore();
  };
  const reviewStack = c => {
    const stack = reviewCopy(E.R().stack), index = E.R().stack.indexOf(c.frame);
    if (index < 0 || index !== stack.length - 1) return null;
    stack[index].i = c.idx; return stack;
  };
  const reviewValidStack = stack => Array.isArray(stack) && stack.length > 0 && stack.every(frame => frame && typeof frame.n === "string" && Array.isArray(frame.p) && Number.isInteger(frame.i) && frame.i >= 0 && frame.i <= (E.walk(frame)?.length ?? -1));
  const reviewSourceStep = source => reviewValidStack(source?.stack) ? E.walk(source.stack.at(-1))?.[source.stack.at(-1).i] : null;
  const reviewWorld = source => source?.scene === E.R().scene && source?.chapter === E.R().ch && source?.clock === JSON.stringify([E.R().clock ?? null, E.R().clockM ?? null]);
  const reviewSafeSource = (st, type) => {
    const spec = type === "place" ? typeof st?.place === "string" ? E.S().places?.[st.place] : st?.place : st?.explore;
    if (!spec || st.reviewExplore === false || spec.reviewExplore === false || spec.until || spec.by || spec.late) return false;
    // The core's resumeSource hook suppresses already-executed side effects
    // on the initial review entry. Custom story sides need no unsafe whitelist.
    return true;
  };
  const reviewSource = (c, details = {}) => ({ key: c.key(), type: c.type || (c.st.place ? "place" : "explore"), stack: reviewStack(c), scene: E.R().scene, chapter: E.R().ch, clock: JSON.stringify([E.R().clock ?? null, E.R().clockM ?? null]), presentation: reviewPresentation(), ...reviewCopy(details) });
  const reviewOwnsStack = source => source.stack.every((frame, i) => {
    const now = E.R().stack[i];
    return now && now.n === frame.n && JSON.stringify(now.p) === JSON.stringify(frame.p) && (i === source.stack.length - 1 ? now.i === frame.i || now.i === frame.i + 1 : now.i === frame.i);
  });
  // A closed marker distinguishes a deliberately rejected boundary from a
  // pre-feature save, for which the narrow adjacency fallback is allowed.
  const reviewClear = () => { E.R().exploreReview = { v: 1, phase: "closed" }; };
  // Old saves at the exact adjacent place -> choice boundary can recover a
  // navigation target from the entered place's persistent view. Nothing prior
  // to that place is executed, and no evidence or reward state is replaced.
  const reviewLegacy = c => {
    if (c.idx < 1) return;
    if (Object.keys(E.sides || {}).some(key => key in c.st && !["look", "framing"].includes(key))) return;
    const st = E.walk(c.frame)?.[c.idx - 1];
    if (!st?.place || !reviewSafeSource(st, "place")) return;
    const P = typeof st.place === "string" ? E.S().places?.[st.place] : st.place;
    const key = [c.frame.n, ...c.frame.p, c.idx - 1].join("."), pid = P.id || (typeof st.place === "string" ? st.place : key), PS = E.R().pl?.[pid];
    if (!PS?.entered || !P.views?.[PS.v]) return;
    const stack = reviewStack(c); if (!stack) return; stack.at(-1).i--;
    E.R().exploreReview = { v: 1, phase: "corridor", source: { key, type: "place", stack, scene: E.R().scene, chapter: E.R().ch, clock: JSON.stringify([E.R().clock ?? null, E.R().clockM ?? null]), presentation: reviewPresentation(), place: { pid, v: PS.v } }, seal: reviewSeal() };
    E.ui.restorePlaceView?.();
  };
  E.exploreReview = {
    clear: reviewClear,
    commit(c) { if (E.R().exploreReview?.phase !== "review") reviewClear(); },
    sourceStep: reviewSourceStep,
    resumeSource(c) {
      if (c.live?.() === false) return false;
      const R = E.R(), mark = R.exploreReview;
      if (mark?.phase !== "review") return false;
      if (!reviewSourceStep(mark.source) || !reviewWorld(mark.source) || !reviewOwnsStack(mark.source)) { reviewClear(); return false; }
      if (c.key() !== mark.source.key) { mark.sourceSideReady = false; return false; }
      if (c.live?.() === false || c.frame !== R.stack.at(-1) || R.stack.length !== mark.source.stack.length || c.st !== reviewSourceStep(mark.source)) return false;
      const skip = mark.sourceSideReady === true;
      // Keep this true while the exploration controls are active so a reload
      // does not replay the source sides. Entering a child resets it; returning
      // from that child then performs normal authored cleanup exactly once.
      mark.sourceSideReady = true;
      return skip;
    },
    // Called only after the place/explore controls have released their view.
    leave(c, details = {}, eligible = true) {
