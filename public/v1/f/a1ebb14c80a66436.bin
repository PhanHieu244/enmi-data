@media(max-width:360px){.se .se-shh:has(>[data-reading-toggle]){padding-left:12px;gap:5px}.se .se-shh:has(>[data-reading-toggle])>b{font-size:18px}.se .se-reading-toggle{padding-inline:7px;font-size:11px}.se .se-record-modal .se-record-detail{padding:12px}.se .se-record-detail-tools{top:-12px;margin:-12px -12px 0}.se .se-person-summary .se-ppi{width:86px;height:104px}.se .se-person-summary{gap:10px}.se .se-record-detail h2,.se .se-record-detail h3{font-size:19px}}
@media(min-width:600px) and (max-height:500px){.vd .vd-casebook .se-shb{padding:10px 18px}.vd .vd-casebook .se-tabs{top:-10px;margin-top:-4px;margin-bottom:7px}.vd .vd-records-compact .vd-record-controls{grid-template-columns:minmax(0,1fr) minmax(170px,.85fr);gap:7px;align-items:center}.vd .vd-records-compact .vd-record-count{display:none}.vd .vd-records-compact .vd-record-search input{min-height:42px}.vd .vd-records-compact .vd-record-chapter>summary{padding-block:9px;min-height:38px}}


/* Engine 1.0.2 — readable questions, nine-card pages and deliberate drag grips. */
.se .cb4-head{padding:0;flex:none}
.se .cb4-eyebrow{min-height:42px;letter-spacing:.1em}
.cb4-head-actions{display:flex;align-items:center;gap:5px;letter-spacing:0}
.cb4-head-actions>.cb4-icon{width:40px;min-width:40px;height:40px}
.se .cb4-head h2{margin:0;padding:10px 12px;border-left:3px solid #e7c471;border-radius:4px 9px 9px 4px;background:#ead38b0c;color:#fff4d6;font:600 clamp(16px,2.8vw,19px)/1.4 var(--se-serif,Georgia,serif);max-height:112px;overflow-y:auto;overscroll-behavior:contain}
.cb4-controls{display:grid;gap:5px;flex:none}
.cb4-page-row{display:flex;align-items:center;gap:7px;flex:none;min-width:0}
.cb4-page-row:not(:has(.cb4-pages:not([hidden]))):not(:has(.cb4-selected-record:not([hidden]))){display:none}
.cb4-pages{display:flex;align-items:center;gap:6px;flex:none;font-size:12px;font-variant-numeric:tabular-nums}
.cb4-pages>button{width:38px;min-height:40px;border:1px solid #a29b7755;border-radius:7px;background:#ffffff08;color:#f1e2b9;font:24px/1 system-ui}
.cb4-selected-record{min-width:0;flex:1}
.cb4-selected-record>button{display:flex;gap:6px;align-items:center;width:100%;min-height:40px;padding:5px 8px;border:1px solid #e1c47688;border-radius:7px;color:#ffebae;background:#e2c77c13;text-align:left;font-size:11px}
.cb4-selected-record>button>span{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;flex:1;min-width:0;line-height:1.25}
.cb4-selected-record>button>svg{width:14px;height:14px}
.cb4-root .cb4-card .se-reading-text,.cb4-root .cb4-card [data-reading-primary],.cb4-root .cb4-card [data-reading-native]{font:inherit;color:inherit}
.se .cb4-footer{gap:5px;min-height:0}
.se .cb4-status{font-size:11px;line-height:1.35;min-height:0;height:auto}
.cb4-record-detail>[data-reading-toggle]{display:block;margin-left:auto;margin-bottom:10px}
.cb4-card .cb4-select{cursor:grab}
.se .cb4-wires{z-index:1}
.se .cb4-cards{z-index:2}
.cb4-root[data-interaction-mode="move"] .cb4-pin{cursor:grab}
.cb4-record-detail .se-reading-text{line-height:1.5}

/* Legacy board uses the same 2×2, 2×3, 3×3 page policy. The world itself scrolls. */
.se .se-panel.deduce.board{position:fixed;inset:max(58px,calc(env(safe-area-inset-top,0px) + 50px)) 0 0;width:100%;max-width:680px;height:auto;max-height:none;margin:0 auto;padding:10px 10px max(9px,env(safe-area-inset-bottom));overflow:hidden;border-radius:0;box-sizing:border-box}
.se .sp-bd3{display:flex;flex-direction:column;gap:7px;height:100%;min-height:0;overflow:hidden}
.se .sp-bd3 [hidden]{display:none!important}
.se .sp-board-head{flex:none;min-width:0}
.se .sp-board-head .se-ddh{display:flex;gap:6px;min-height:40px;margin:0}
.se .sp-board-head .se-ddh>small{font-size:10px;letter-spacing:.1em;color:#ddc78b}
.se .sp-board-head .se-ddh>.sp-pips2{margin-right:auto}
.se .sp-bd3 .se-ddq{display:block;font:600 clamp(16px,2.8vw,19px)/1.4 var(--se-serif,Georgia,serif);margin:0;padding:10px 12px;color:#fff4d6;background:#ead38b0c;border-left:3px solid #e7c471;border-radius:4px 9px 9px 4px;max-height:112px;overflow:auto;flex:none}
.se .sp-board-adjust{display:flex;align-items:center;gap:10px;flex:none}
.se .sp-bd3 .sp-arrange{flex:none;min-height:40px;margin:0}
.se .sp-bdh{font-size:11px;margin:0;line-height:1.35}
.se .sp-board-page-row{display:flex;align-items:center;gap:7px;flex:none;min-width:0}
.se .sp-board-page-row:not(:has(.sp-board-pages:not([hidden]))):not(:has(.sp-board-selection)){display:none}
.se .sp-board-pages{display:flex;align-items:center;gap:7px;flex:none;font-size:12px}
.se .sp-board-pages>button{min-width:38px;min-height:40px;font-size:22px;line-height:1}
.se .sp-board-selection{flex:1;min-width:0;min-height:40px;padding:6px 9px;border:1px solid #dbc078;border-radius:7px;background:#e2c77c13;color:#ffebae;text-align:left;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-size:11px}
.se .sp-bd3 .sp-bw{flex:1;min-height:100px;height:auto;max-height:none;border-radius:9px;touch-action:pan-x pan-y}
.se .sp-bd3 .sp-bc{min-height:100%;isolation:isolate}
.se .sp-bd3 .sp-str{z-index:1}
.se .sp-bd3 .sp-card{z-index:2;min-height:158px;height:170px;padding:16px 7px 28px;touch-action:pan-x pan-y;box-sizing:border-box}
.se .sp-bd3 .sp-card [data-card-open]{max-height:126px;overflow:hidden;touch-action:pan-x pan-y!important}
.se .sp-bd3 .sp-card .sp-cn{max-height:98px;overflow:hidden}
.se .sp-bd3 .sp-card .sp-cn>b,.se .sp-bd3 .sp-card .sp-cn>small{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:4;overflow:hidden;max-height:none}
.se .sp-bd3 .sp-card .se-reading-text,.se .sp-bd3 .sp-card [data-reading-primary],.se .sp-bd3 .sp-card [data-reading-native]{font:inherit;color:inherit}
.se .sp-move-grip{position:absolute;right:2px;bottom:0;width:40px;height:28px;border:0;background:transparent;color:#76684e;font-size:22px;touch-action:none;cursor:grab}
.se .sp-bd3 .sp-tack{touch-action:none;z-index:3}
.se .sp-bd3 .sp-record-drawer,.se .sp-bd3 .sp-conclusions-drawer{flex:none;margin:0;border:1px solid #99805c55;border-radius:8px;overflow:hidden;max-height:34%;background:#111a21}
.se .sp-bd3 .sp-record-drawer>summary,.se .sp-bd3 .sp-conclusions-drawer>summary{display:list-item;min-height:38px;box-sizing:border-box;padding:9px 12px;cursor:pointer;font:600 12px/1.5 var(--se-sans,system-ui);color:#ddcfaa}
.se .sp-record-drawer>summary>small,.se .sp-conclusions-drawer>summary>small{float:right;color:#b7c2b8;font-variant-numeric:tabular-nums}
.se .sp-bd3 .sp-trh{padding:4px 7px;border-radius:0;background:transparent}
.se .sp-bd3 .sp-tray{min-height:90px;max-height:135px;padding:5px 7px 10px;margin:0;border:0;border-radius:0;touch-action:pan-x;scrollbar-width:thin;overscroll-behavior-x:contain}
.se .sp-bd3 .sp-tray::-webkit-scrollbar{display:block;height:4px}
.se .sp-bd3 .sp-tray::-webkit-scrollbar-thumb{border-radius:5px;background:#b8a87d88}
.se .sp-bd3 .sp-tc{position:relative;padding-bottom:28px;min-height:110px;touch-action:pan-x}
.se .sp-bd3 .sp-tc .sp-cn{max-height:52px;overflow:hidden}
.se .sp-bd3 .sp-bdl2{max-height:140px;overflow-y:auto;margin:0;padding:0 9px 8px}
.se .sp-bd3>[data-end]{flex:none;min-height:42px;margin:0}
.se .sp-bd3>.se-hint{flex:none;margin:0;padding:7px 9px;max-height:70px;overflow-y:auto;font-size:12px;line-height:1.4}
.se .sp-bd3 .sp-pvc>[data-reading-toggle]{margin-right:auto;color:#443e2f;border-color:#8a7a58;background:#fcf7e9}

/* Scroll the card body; use its grip for drag. Keyboard/tap placement remains. */
.se .se-ddc,.se .se-evi,.se .se-bag [data-it],.se .pl-bag [data-it]{touch-action:pan-x pan-y}
.se .se-drag-handle{position:absolute!important;right:3px;bottom:2px;width:36px!important;height:30px!important;min-width:36px;display:grid!important;place-items:center;background:transparent!important;border:0!important;border-radius:5px!important;color:inherit!important;font:22px/1 system-ui!important;opacity:.7;touch-action:none;cursor:grab}
.se .se-evi{position:relative;padding-bottom:31px}
.se .se-ddc{padding-bottom:35px}
.se .se-ddc .se-reading-text,.se .se-ddc [data-reading-primary],.se .se-ddc [data-reading-native]{display:inline;width:auto;height:auto;border-radius:0;background:none;color:inherit;font:inherit}
.se .se-panel.deduce .se-ddh{display:flex;justify-content:space-between;align-items:center;gap:8px;min-height:40px}
.se .se-panel.deduce:not(.board) .se-ddq{margin:0;font:600 19px/1.4 var(--se-serif,Georgia,serif);color:#ffedbd;overflow-wrap:anywhere}
.se .se-panel.deduce:not(.board) .se-dd{padding:0 11px 10px;margin-bottom:9px;border-left:3px solid #dcb869;background:#d9bd7910;border-radius:4px 9px 9px 4px}
.se .se-panel.deduce.deduce-work>.se-dd{flex:none;text-align:left}
.se .se-panel.deduce.deduce-work>.se-dd .se-ddq{max-height:90px;overflow-y:auto}
.se .se-panel.deduce .se-ddg .se-ddc>small{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;line-height:1.4;max-height:4.2em}
.se .tk-h{flex-wrap:wrap;align-items:center}
.se .tk-h>[data-reading-toggle]{margin-left:auto}
.se .tk-h>span{flex-basis:100%}

/* A compact statement has one task, numbered claims and optional old wording. */
.se .se-panel.present .se-doch{align-items:center;gap:7px;margin-bottom:8px;padding-bottom:8px}
.se .se-trs{padding:0;border-radius:8px;background:#ffffff0c}
.se .se-trs button{min-height:40px;padding:7px 11px;border:1px solid #8f8e7b66;border-radius:8px;opacity:1;font-size:12px;cursor:pointer}
.se .se-doc .se-trs button{border-color:#998d6b;background:#fffaf099;color:#4c4538}
.se .se-present-task{margin:0 0 9px;font:600 13px/1.4 var(--se-sans,system-ui);color:#3e493d}
.se .se-present-task>small{display:block;margin-top:3px;font-weight:400;font-size:11px;color:#706b5c}
.se .se-panel.present .v8-task-hint{padding:7px 10px;margin:0 0 9px;border-left:3px solid #a18d5c;background:#b8a47612;font:13px/1.45 var(--se-sans,system-ui);color:#524c3e}
.se .se-panel.present .se-seg-l{position:relative;display:block;padding:9px 11px;margin:7px 0;border-style:solid;border-color:#c5b796;border-radius:8px;font:14px/1.55 var(--se-sans,system-ui);background:#fffdf24d}
.se .se-panel.present .se-seg-l.on{border:2px solid #8c6440;background:#f7ead0}
.se .se-panel.present .se-claim-state{display:block;font:700 10px/1.3 var(--se-sans,system-ui);color:#8b7858;margin-bottom:4px;text-transform:uppercase;letter-spacing:.05em}
.se .se-panel.present .se-seg-l.fixed{border-color:#7e9c73;background:#eef3dfaa;color:#315438}
.se .se-panel.present .se-seg-l.fixed .se-dl::before{content:none}
.se .se-panel.present .se-claim-original{margin-top:6px;padding-top:4px;border-top:1px solid #a7b59a55;font-size:12px;color:#7d6f5c}
.se .se-panel.present .se-claim-original>summary{min-height:32px;padding:6px 0;cursor:pointer;box-sizing:border-box}
.se .se-panel.present .v8-present-feedback{position:relative;display:flex;gap:8px;align-items:flex-start;padding:8px 9px;border-radius:8px;margin:7px 0;font-size:13px;line-height:1.45}
.se .se-panel.present .v8-present-feedback[hidden]{display:none!important}
.se .se-panel.present .v8-present-feedback>p{margin:0;flex:1;min-width:0}
.se .se-panel.present .v8-present-feedback>button{flex:none;width:34px;min-height:34px;height:34px;padding:0;font-size:22px}
.se .se-panel.present .se-evt>summary{min-height:42px;padding:10px 8px;border:1px solid var(--se-line);border-radius:8px;cursor:pointer;font-size:13px;box-sizing:border-box}
.se .se-panel.present .se-evt>div{scrollbar-width:thin;touch-action:pan-x;overscroll-behavior-x:contain}
.se .se-panel.present .se-ev>[data-cancel]{min-height:42px;background:#fffaf099;color:#6d4933;border-color:#a58d6a;font-size:13px}
.se .se-panel.present .v93-record-preview-text{font-size:14px;line-height:1.5}

@media(max-height:480px){
 .se .cb4-head h2,.se .sp-bd3 .se-ddq{max-height:75px;font-size:16px;padding:6px 9px}
 .se .cb4-eyebrow,.se .sp-board-head .se-ddh{min-height:36px}
 .se .sp-bd3{gap:4px}
 .se .sp-bd3 .sp-record-drawer,.se .sp-bd3 .sp-conclusions-drawer{max-height:27%}
 .se .sp-bd3 .sp-record-drawer>summary,.se .sp-bd3 .sp-conclusions-drawer>summary{min-height:31px;padding:5px 10px}
 .se .sp-bd3 .sp-bw{min-height:70px}
}
@media(max-height:470px) and (min-width:600px){
 .se .cb4-root{display:grid;grid-template-columns:33% 1fr;grid-template-rows:auto auto 1fr auto;gap:6px 10px}
 .se .cb4-head{grid-column:1;grid-row:1}
 .se .cb4-controls{grid-column:1;grid-row:2}
 .se .cb4-page-row{grid-column:1;grid-row:3;align-self:start;flex-wrap:wrap}
 .se .cb4-viewport{grid-column:2;grid-row:1/5}
 .se .cb4-footer{grid-column:1;grid-row:4}
 .se .cb4-head-actions{gap:3px}
 .se .cb4-head-actions>.cb4-icon{min-width:36px;width:36px}
}


/* Engine 1.0.2 — contained zoom, readable node bounds, quieter route controls. */
.se-sheet.flowx .fx-map-tools { display:flex; flex-wrap:wrap; align-items:center; gap:4px 10px; }
.se-sheet.flowx .fx-map-tools p { flex:1 1 180px; }
.se-sheet.flowx .fx-zoom-tools { display:flex; align-items:center; gap:4px; flex:none; max-width:100%; }
.se-sheet.flowx .fx-map-tools .fx-zoom-tools button { flex:none; display:grid; place-items:center; width:44px; min-width:44px; height:44px; min-height:44px; padding:7px; border-radius:9px; font-size:20px; line-height:1; }
.se-sheet.flowx .fx-map-tools .fx-zoom-tools button[data-flow-zoom="reset"] { width:54px; font-size:12px; font-variant-numeric:tabular-nums; }
.se-sheet.flowx .fx-map-tools .fx-zoom-tools button:disabled { opacity:.35; cursor:default; }
.se-sheet.flowx .fx-map-tools .fx-zoom-tools button svg { width:21px; height:21px; fill:none; stroke:currentColor; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
.se-sheet.flowx .fx-viewport { touch-action:none; }
.se-sheet.flowx .fx-surface { position:relative; min-width:100%; min-height:100%; overflow:hidden; }
.se-sheet.flowx .fx-viewport .fx-wrap { position:absolute; left:0; top:0; min-width:0; min-height:0; transform-origin:0 0; }
.se-sheet.flowx .fx-viewport .fx-wire path { vector-effect:non-scaling-stroke; }
.se-sheet.flowx .fx-viewport .fx-wire path.now { stroke-width:3; }
@media (max-width:520px) {
  .se-sheet.flowx .fx-map-tools { justify-content:center; }
  .se-sheet.flowx .fx-map-tools p { flex-basis:100%; text-align:center; }
  .se-sheet.flowx .fx-key { justify-content:center; }
}
@media (max-height:680px) {
  .se-sheet.flowx .fx-map-tools p { display:none; }
  .se-sheet.flowx .fx-map-tools { justify-content:flex-end; }
}


/* Engine 1.0.2: compact translated documents and clean receipt imagery. */
.se .se-read.rd-compact-translation.tr .dl:has(>.dt)>.dm{display:none}
.se .se-read.rd-compact-translation.tr .dl>.dt{display:block;margin-top:0;padding-top:0;border:0;color:inherit;font:inherit;line-height:1.65}
.se .se-read.rd-compact-translation:not(.tr) .dl>.dt{display:none}
.se .se-read.rd-compact-translation.tr .rd-p{font-family:var(--se-sans)}
.se .se-rev .rv-b .se-reading-toggle{min-height:38px}
.se .se-rev .rv-a>i{background-repeat:no-repeat;background-position:center;background-size:contain}
/* New detail plates contain their own real composition. Do not inherit the
 * object-prop foreshortening or testimony crop inside a record thumbnail. */
.vd .vd-record-art>[class*="im-detail10"]{background-size:contain!important;background-position:center!important;transform:none!important}
.vd .vd-record-art{overflow:hidden;border-radius:10px}
/* Engine 1.0.3 — existing wires remain findable across nine-card pages. */
.se .cb4-page-row,.se .sp-board-page-row{flex-wrap:wrap;gap:6px}
.se .cb4-page-row:has(.cb4-saved-links:not([hidden])),.se .sp-board-page-row:has(.sp-saved-links){display:flex}
.se .cb4-saved-links,.se .sp-saved-links{display:flex;align-items:center;justify-content:center;gap:6px;flex:none;min-width:48px;min-height:40px;padding:5px 9px;border:1px solid #b4aa7c66;border-radius:7px;background:#e2c77c0c;color:#ecdcae;font:600 12px/1.3 system-ui}
.se .cb4-saved-links svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.7}
.se .cb4-selected-record,.se .sp-board-selection{display:flex;align-items:stretch;flex:1 1 145px;min-width:0;min-height:40px;padding:0;border:1px solid #e1c47688;border-radius:7px;background:#e2c77c13;color:#ffebae;overflow:hidden}
.se .cb4-selected-record>button,.se .sp-board-selection>button{display:flex;align-items:center;gap:6px;min-width:0;min-height:40px;margin:0;padding:4px 7px;border:0;border-radius:0;background:transparent;color:inherit;text-align:left;font:500 11px/1.25 system-ui}
.se .cb4-selected-record>[data-board-selection-find],.se .sp-board-selection>[data-board-selection-find]{flex:1;width:auto}
.se .cb4-selected-record>[data-board-selection],.se .sp-board-selection>[data-board-selection]{flex:0 0 40px;width:40px;justify-content:center;border-left:1px solid #e1c47644;font-size:21px}
.se .cb4-selected-record>button>span,.se .sp-board-selection>button>span{display:block;min-width:0;flex:1;overflow:hidden}
.se .cb4-selected-record>button>span>.se-reading-text,.se .sp-board-selection>button>span>.se-reading-text{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font:inherit}
.se .cb4-selected-record>button>span>small,.se .sp-board-selection>button>span>small{display:block;margin-top:2px;color:#d4c290;font-size:9px;line-height:1.2}
.se .cb4-selected-record>button>svg{flex:none;width:15px;height:15px}
.se .cb4-linked-away>.cb4-read{width:calc(100% - 44px)}
.se .cb4-away-links,.se .sp-away-links{position:absolute;right:0;bottom:0;display:block;min-width:44px;width:44px;height:31px;padding:3px 2px;border:0;border-top:1px solid #a9ab913f;border-left:1px solid #a9ab9155;border-radius:0;background:#efe5ca;color:#4f5b42;font:700 11px/1.3 system-ui;cursor:pointer;touch-action:manipulation}
.se .sp-away-links{left:0;right:auto;bottom:0;height:28px;border-left:0;border-right:1px solid #a9ab9155;background:#eee2c2}
.se .se-board-connections{min-width:0}
.se .se-board-connections>[data-reading-toggle]{display:block;margin-left:auto}
.se .se-board-connections>p{margin:9px 0 12px;font-size:13px;line-height:1.4;color:var(--se-muted,#aeb7ae)}
.se .se-board-connections>ol{display:grid;gap:10px;margin:0;padding:0;list-style:none}
.se .se-board-connections>ol>li{display:grid;grid-template-columns:minmax(0,1fr) 18px minmax(0,1fr);gap:4px;align-items:stretch;padding:9px;border:1px solid #b6a46f55;border-radius:9px;background:#e1c77c08}
.se .se-board-connections li>button{display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between;gap:7px;min-width:0;min-height:50px;padding:7px;border:1px solid #b9b18e66;border-radius:6px;background:#e9dcc610;color:inherit;text-align:left;font:600 13px/1.4 system-ui;overflow-wrap:anywhere}
.se .se-board-connections li>button>small{display:block;color:#d5bf84;font:600 10px/1.3 system-ui}
.se .se-board-connection-symbol{align-self:center;justify-self:center;color:#c8ac65;font:18px/1 system-ui}
.se .se-board-record-question{display:grid;gap:5px;margin:10px 0 12px;padding:9px 11px;border-left:3px solid #b49448;border-radius:3px 7px 7px 3px;background:#bca25b15;color:inherit;text-align:left;font:600 14px/1.45 var(--se-serif,Georgia,serif)}
.se .se-board-record-question>small{font:700 10px/1.3 system-ui;letter-spacing:.06em;text-transform:uppercase;opacity:.8}
.se .se-panel.deduce.board{background:linear-gradient(160deg,#203034,#10191b 65%)}
.se .sp-board-head .se-ddh{padding:0;border:0;border-radius:0;background:transparent;min-height:40px;box-shadow:none}
.se .sp-board-head .se-ddh>button{min-height:40px;padding:6px 9px;font:600 12px/1.3 system-ui}
.se .sp-board-drawers{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-auto-rows:max-content;align-content:start;gap:6px;flex:none;min-height:0;max-height:32%;overflow:auto;overscroll-behavior:contain;scrollbar-width:thin}
.se .sp-board-drawers:has(details[open]){grid-template-columns:minmax(0,1fr)}
.se .sp-board-drawers>.sp-record-drawer,.se .sp-board-drawers>.sp-conclusions-drawer{margin:0;max-height:none;min-width:0}
.se .sp-board-drawers .sp-tray,.se .sp-board-drawers .sp-tc{touch-action:pan-x pan-y}
.se .sp-board-drawers>details>summary{min-height:36px;padding:7px 9px;font-size:11px;white-space:nowrap}
.se .sp-bd3>[data-end]{font:600 13px/1.3 system-ui;min-height:42px;padding:8px 10px}
@media(max-width:360px){.se .cb4-selected-record,.se .sp-board-selection{flex-basis:100%}}
@media(max-height:470px) and (min-width:600px){
 .se .se-panel.deduce.board{max-width:none;padding:8px 12px 7px}
 .se .sp-bd3{display:grid;grid-template-columns:minmax(240px,32%) minmax(0,1fr);grid-template-rows:auto auto auto minmax(0,1fr) auto auto;gap:5px 10px;overflow-y:auto}
 .se .sp-board-head{grid-column:1;grid-row:1}
 .se .sp-board-head .se-ddh{min-height:36px}
 .se .sp-board-head .se-ddh>button{min-height:36px;padding:5px 7px;font-size:11px}
 .se .sp-bd3 .se-ddq{max-height:66px;font-size:16px}
 .se .sp-board-adjust{grid-column:1;grid-row:2;align-self:start;gap:5px}
 .se .sp-board-page-row{grid-column:1;grid-row:3;align-self:start}
 .se .sp-board-selection{flex-basis:100%}
 .se .sp-bd3>.se-hint{grid-column:1;grid-row:4;align-self:start;max-height:60px}
 .se .sp-board-drawers{grid-column:1;grid-row:5;max-height:100px;align-self:end}
 .se .sp-bd3>[data-end]{grid-column:1;grid-row:6;align-self:end}
 .se .sp-bd3>.sp-bw{grid-column:2;grid-row:1/7;align-self:stretch;min-height:180px;max-height:calc(100dvh - 80px);height:100%}
}

/* Engine 1.0.3 — gesture geometry and its visible canvas share the same frame.
   Reduced-motion's global duration must not create transform/size transitions. */
.se-sheet.flowx .fx-surface,
.se-sheet.flowx .fx-viewport .fx-wrap { transition-property:none !important; }

/* Engine 1.0.3 — readable documents with a bounded scroll lane and fixed actions. */
.se .se-read{grid-template-rows:minmax(0,1fr) auto;gap:10px;padding:max(12px,var(--sat,env(safe-area-inset-top,0px))) 10px max(10px,var(--sab,env(safe-area-inset-bottom,0px)));overflow:hidden;isolation:isolate}
.se .se-read>.rd-bg{position:absolute;z-index:-1}
.se .se-read>.rd-scroll{position:relative;min-height:0;min-width:0;overflow:auto;overscroll-behavior:contain;touch-action:pan-y;scrollbar-gutter:stable;display:flex;flex-direction:column;padding:10px 5px 14px;outline-offset:-3px}
.se .se-read .rd-p{align-self:center;flex:0 0 auto;justify-self:auto;margin:auto;width:min(100%,540px);max-width:100%;padding:22px 20px 26px;transform:none;animation:se-document-enter .16s ease-out both;border-radius:8px}
.se .se-read .rd-p::before{display:none}
.se .se-read .rd-t{font:700 18px/1.4 var(--se-sans);letter-spacing:0;text-transform:none;opacity:1;margin-bottom:16px;overflow-wrap:anywhere}
.se .se-read .rd-note{position:relative;font:500 13px/1.5 var(--se-sans);color:#655c4b;margin:0 0 16px;padding-bottom:12px;border-bottom:1px solid #8b755e45}
.se .se-read .rd-l{gap:14px}
.se .se-read .dl .dm,.se .se-read .dl .dt{white-space:pre-wrap;overflow-wrap:anywhere}
.se .se-read .rd-p.h-script .dm{font:500 17px/1.65 var(--se-sans)}
.se .se-read .rd-bar{position:relative;z-index:1;justify-self:center;width:min(100%,540px);min-width:0;margin:0;padding:0;gap:8px}
.se .se-read .rd-bar .se-btn{flex:1;min-width:0;min-height:46px;white-space:normal;touch-action:manipulation}
.se .se-read>.se-pop{z-index:3;max-width:calc(100% - 16px);max-height:calc(100% - 16px);overflow:auto;overscroll-behavior:contain}
.vd .vd-record-detail .vd-record-detail-tools{position:sticky;top:0;z-index:3;display:flex;align-items:center;justify-content:flex-end;gap:8px;align-self:stretch;flex-shrink:0;min-height:52px;margin:-1px 0 2px;padding:4px 0;background:#17201f;border-bottom:1px solid #c3ae7440}
.vd .vd-record-detail-tools .vd-record-reading{padding:0;min-height:44px}
.vd .vd-record-detail-tools .vd-record-close{position:static;inset:auto;flex-shrink:0;width:44px;height:44px;min-height:44px}
/* The active held-object action stays in front without removing its listeners. */
.se[data-dialogue-layout][data-dialogue-phase][data-dialogue-speaker][data-stage] .se-chars>.se-ch[data-dialogue-actor][data-dialogue-focus="action"].on:not(.out){z-index:7;opacity:1!important;filter:none!important;transform:translateX(-50%)!important;transition:filter .2s ease,opacity .2s ease!important}
@keyframes se-document-enter{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
@media(max-width:360px){.se .se-read .rd-p{padding:18px 16px 22px}.se .se-read .rd-t{font-size:17px}.se .se-read .dl .dm{font-size:16px}}
@media(max-height:480px){.se .se-read{gap:6px;padding-top:6px;padding-bottom:max(6px,var(--sab,0px))}.se .se-read>.rd-scroll{padding-top:4px;padding-bottom:8px}.se .se-read .rd-p{padding:16px 20px}.se .se-read .rd-bar .se-btn{min-height:42px}}
@media(prefers-reduced-motion:reduce){.se .se-read .rd-p{animation:none}}
.se.se-motion-reduced .se-read .rd-p{animation:none}

/* Engine 1.0.3 — one owned acquisition view; brief notice can expand in place. */
.se .se-rev.fresh.receipt-notice { place-items:start center; padding:max(68px,calc(env(safe-area-inset-top,0px) + 64px)) 14px 14px; pointer-events:none; overflow:hidden; }
.se .se-rev.receipt-notice .rv-bg { display:none; }
.se .se-rev.receipt-notice .rv-c { pointer-events:auto; width:min(100%,400px); max-height:none; margin:0; padding:12px; display:grid; grid-template-columns:56px minmax(0,1fr) 44px; grid-template-rows:auto auto auto; align-items:center; justify-items:stretch; gap:5px 10px; background:#132529f5; border:1px solid #bca77770; border-radius:15px; box-shadow:0 8px 28px #0005; text-align:left; }
.se .se-rev.receipt-notice .rv-c > * { max-width:100%; }
.se .se-rev.receipt-notice .rv-k { grid-column:2; grid-row:1; font-size:10px; line-height:1.35; letter-spacing:.04em; }
.se .se-rev.receipt-notice .rv-n { grid-column:2; grid-row:2; font-size:16px; line-height:1.3; overflow-wrap:anywhere; }
.se .se-rev.receipt-notice .rv-st { grid-column:1; grid-row:1 / 3; width:56px; height:64px; min-height:0; aspect-ratio:auto; animation:none; }
.se .se-rev.receipt-notice .rv-st .se-ia { border-radius:9px; }
.se .se-rev.receipt-notice .rv-copy { display:none; }
.se .se-rev.receipt-notice .rv-b { grid-column:1 / -1; grid-row:3; display:flex; margin:2px 0 0; gap:0; }
.se .se-rev.receipt-notice .rv-b > :not([data-receipt-open]) { display:none !important; }
.se .se-rev.receipt-notice .rv-b > [data-receipt-open] { flex:1; justify-content:center; min-height:44px; margin:0; padding:8px 12px; font-size:13px; }
.se .se-rev.receipt-notice button.rv-tap { grid-column:3; grid-row:1 / 3; align-self:center; width:44px; height:44px; min-height:44px; margin:0; padding:0 !important; font-size:0 !important; border:0 !important; background:transparent !important; animation:none; }
.se .se-rev.receipt-notice button.rv-tap::after { content:'×'; font:24px/1 var(--se-sans,system-ui); }

/* Nút dịch gọn, cùng vị trí với công cụ của từng màn; không chiếm dòng chữ. */
.se button.se-reading-toggle.se-translation-toggle{box-sizing:border-box;width:44px;height:44px;min-width:44px;min-height:44px;flex:0 0 44px;padding:10px;line-height:1;border-radius:10px}
.se .se-translation-toggle svg{display:block;width:20px;height:20px;flex:none;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;pointer-events:none}
.se .se-translation-toggle[aria-pressed=true]{color:var(--se-ac,#d6b878);background:#c8b67b24;border-color:#c8b67b80}
.se .se-trs:has(>.se-translation-toggle){padding:0;background:none}
.se .se-doch>b,.se .se-int-h>b{min-width:0;flex:1;overflow-wrap:anywhere}
.se .se-read .rd-bar>.se-translation-toggle{align-self:center}
.se .se-shh:has(>[data-reading-toggle]){gap:16px}
.se .se-record-detail-tools{gap:16px}
.vd .vd-record-detail .vd-record-detail-tools{min-height:48px;gap:16px;padding-block:2px}
/* Icon dịch ở góc khung; màu thể hiện trạng thái, không gạch chéo biểu tượng. */
.se .tk-h{display:flex;align-items:flex-start;flex-wrap:nowrap;gap:12px}
.se .tk-h>.tk-title{display:flex;flex:1;min-width:0;flex-direction:row;flex-wrap:wrap;align-items:center;gap:6px 8px}
.se .tk-title>b{font:inherit;font-weight:700;color:var(--c,var(--se-fg))}
.se .tk-title>span{display:block;font-size:13px;line-height:1.45;opacity:.82}
.se .tk-h>.se-translation-toggle{margin-left:auto;align-self:flex-start}
.se .cb4-head-actions>.se-translation-toggle,.se .sp-board-head .se-ddh>.se-translation-toggle{order:3;margin-left:auto}
.se .se-read:has(>.rd-tools>.se-translation-toggle){padding-top:max(58px,calc(var(--sat,0px) + 48px))}
.se .se-read>.rd-tools{position:absolute;top:max(8px,var(--sat,0px));right:max(10px,calc((100% - 540px)/2));z-index:2;display:flex;justify-content:flex-end}
.se .se-read>.rd-tools:empty{display:none}
.se .se-rev .rv-c{position:relative}
.se .se-rev .rv-tools{position:absolute;top:8px;right:8px;z-index:2;display:flex}
.se .se-rev .rv-k{padding-inline:44px}
.se .se-rev.receipt-notice .rv-tools{display:none}
.se .se-rev.receipt-notice .rv-k{padding-inline:0}


/* Engine UI polish (02/11/2026): nút chính dịu, chi tiết hồ sơ gọn. */
/* 1. Nút chính: màu cát dịu, đặc, không phát sáng (khớp nút "Tiếp" trong thanh lời thoại). Màn hội thoại hỏi–đáp giữ bản cũ. */
.se .se-btn.pri{background:#d9c58f;color:#1d1707;border:1px solid #efe1b570;box-shadow:none}
.se .se-btn.pri:active{background:#cdb87f}
.se .se-panel.tk .se-btn.pri{background:linear-gradient(180deg,#fbbf24,#f59e0b);color:#1f1300;border-color:transparent;box-shadow:0 8px 24px rgba(242,184,75,.3)}
/* 3. Chi tiết hồ sơ: hàng công cụ gọn hơn, bỏ viền và nền, nội dung lên sát hơn */
.vd .vd-record-detail .vd-record-detail-tools{background:none;border-bottom:0;min-height:44px;margin:0;padding:0;gap:12px}
.vd .vd-record-detail-tools .vd-record-close{border-width:1px}
.vd .vd-record-detail{gap:8px}

/* Engine UI polish: nút dịch đang bật trên thẻ lời dẫn / giấy sáng dùng mực nâu đậm (vàng #d6b878 trên nền kem chỉ ~1,6:1, gần như vô hình). */
.se .se-box.k-n .se-translation-toggle[aria-pressed=true],.se .se-box.note .se-translation-toggle[aria-pressed=true],.se .se-doc .se-translation-toggle[aria-pressed=true]{color:#6b4410;background:#6b441014;border-color:#6b441080}
/* Between Tides mix uses the supplied engine's gain and voice-ducking controls. */
(() => {
  "use strict";
  const E = globalThis.StoryEngine;
  if (!E?.plugin || E.plugins?.["bt-audio-mix"]) return;
  const preferences = () => {
    if (E.S()?.id !== "between-tides") return;
    const g = E.G().set;
    let changed = false;
    for (const [key, value] of [["ambLevel", .65], ["sfxLevel", .7]]) {
      if (g[key] == null || !Number.isFinite(Number(g[key]))) { g[key] = value; changed = true; }
    }
    if (changed) E.sound?.refresh?.();
  };
  E.plugin({ id: "bt-audio-mix", on: { boot() {
    const S = E.S();
    if (S?.id !== "between-tides") return;
    S.ambVol = { sea: .9, room: .8, pub: .8, hall: .85, hut: .9, harbour: .85, night: .8, rain: .75, ...S.ambVol };
    S.sfxVol = { bell: .7, phone: .75, phone_keys: .5, thunder: .65, sting: .7, beat: .8, wind: .8, car: .8, gulls: .8, ...S.sfxVol };
    preferences();
    E.sound?.refresh?.();
  }, step: preferences } });
})();
// Sinh bảng đường dẫn save từ đúng bản nguồn đính kèm sang bản truyện hiện tại.
// Chỉ chạy ở bước đóng gói; không nạp file .cjs này trong trình duyệt.
const fs = require('fs'), path = require('path'), vm = require('vm'), crypto = require('crypto');
const source = process.argv[2], target = process.argv[3];
if (!source || !target) throw Error('Usage: node bt-build-save-map.cjs OLD_GAME_DIR NEW_GAME_DIR');
const TYPES = new Set('bg show hide n think say set add item drop truth word go if cp wait fx title choice explore map interpret present listen quiz lock order type review end cg deduce meet mood cam pic sfx amb chat call meter board caseboard reconstruct compare sneak qte whom note gift topics date gallery check shop schedule gauge spin fill memory rewind clock look shot prop motion read place talk act beat reveal theory vibe serve pressure tail compose bargain cipher eavesdrop lineup heartbeat swipe cook budget sort route scramble match defuse tune event quote hud guess pack rhythm wear wardrobe wearLock'.split(' '));
const textKeys = new Set('en vi easy tone prompt hint missing label name title desc sum text t q goal done lockHint noUse'.split(' '));
const hash = x => crypto.createHash('sha256').update(x).digest('hex');
const serial = x => JSON.stringify(x, (k,v) => typeof v === 'function' ? String(v).replace(/\s+/g,'') : v);
const kind = x => x && typeof x === 'object' && !Array.isArray(x) ? Object.keys(x).find(k=>TYPES.has(k)) || '' : '';
const words = x => String(x||'').toLowerCase().replace(/\[\[|\]\]/g,'').replace(/[^a-z0-9]+/g,' ').trim();
const en = x => typeof x?.en==='string' ? x.en : ['n','think','note','title'].map(k=>x?.[k]?.en).find(Boolean)||x?.label?.en||'';
const stripped = x => {
  if (Array.isArray(x)) return x.map(stripped);
  if (!x || typeof x !== 'object') return typeof x === 'function' ? String(x).replace(/\s+/g,'') : x;
  return Object.fromEntries(Object.entries(x).filter(([k])=>!textKeys.has(k)).map(([k,v])=>[k,stripped(v)]));
};
function load(dir) {
  let base={}, parts=[];
  const ctx=vm.createContext({StoryEngine:{story:x=>base=x,chapter:x=>parts.push(x)}});
  for(const file of ['story.js',...Array.from({length:5},(_,i)=>`ch${i+1}.js`)]) vm.runInContext(fs.readFileSync(path.join(dir,'story',file),'utf8'),ctx,{filename:file});
  const story={nodes:{},places:{},talks:{},events:{},flow:[]};
  for(const item of [base,...parts]) for(const key of Object.keys(story)) {
    if(Array.isArray(story[key])) story[key].push(...item[key]||[]); else Object.assign(story[key],item[key]||{});
  }
  // Đúng phép chuẩn hóa duy nhất có tạo đường dẫn con trong place.js.
  const seen=new WeakSet();
  function norm(x){if(!x||typeof x!=='object'||seen.has(x))return;seen.add(x);if(x.views){for(const v of Object.values(x.views)){for(const p of v.people||[])p.go=[{talk:typeof p.talk==='string'?p.talk:{with:p.who,...p.talk}}];for(const z of v.zones||[])if(z.talk)z.go=[{talk:typeof z.talk==='string'?z.talk:{with:z.who,...z.talk}}];}}for(const v of Object.values(x))norm(v);}
  norm(story);return story;
}
const old=load(source), fresh=load(target);
function score(a,b) {
  if (serial(a)===serial(b)) return 160;
  if(a==null||b==null) return a===b?160:-Infinity;
  if(typeof a!=='object'||typeof b!=='object')return serial(a)===serial(b)?160:-Infinity;
  if(a.id||b.id) {if(a.id!==b.id)return-Infinity;return 130;}
  const ka=kind(a),kb=kind(b);
  if(a.n?.en==='You look down at your hand. One fingertip is still black.'&&kb==='if'&&b.then?.some(x=>x.n?.en===a.n.en))return 130;
  if(ka!==kb)return-Infinity;
  if(ka==='set'&&serial(a.set)==='{"p_others_cleared":true}'&&serial(b.set)==='{"c5_callum_missed":true}')return 100;
  if(ka==='if')return String(a.if).replace(/\s/g,'')===String(b.if).replace(/\s/g,'')?100:4;
  if(['go','cp','truth','item','drop','end','show','hide','bg','cg','clock','place'].includes(ka))return serial(a[ka])===serial(b[kb])?130:-Infinity;
  if(['set','add'].includes(ka)){
    const ak=Object.keys(a[ka]),bk=Object.keys(b[ka]);
    return (ak.length&&ak.every(k=>serial(a[ka][k])===serial(b[ka][k])))||(bk.length&&bk.every(k=>serial(a[ka][k])===serial(b[ka][k])))?100:-Infinity;
  }
  if(ka==='say'&&a.say!==b.say)return-Infinity;
  const ta=words(en(a)),tb=words(en(b));
  if(ta&&tb){
    if(ta===tb)return 145;
    if(ta.startsWith(tb))return 130;
    if(ta.includes(tb))return 95;
    const aa=new Set(ta.split(' ')),bb=new Set(tb.split(' '));
    const overlap=[...aa].filter(x=>bb.has(x)).length;
    return 12+60*overlap/Math.max(1,aa.size+bb.size-overlap);
  }
  if(serial(stripped(a))===serial(stripped(b)))return 95;
  if(ka)return 50;
  return Object.keys(a).join('|')===Object.keys(b).join('|')?40:10;
}
function align(a,b) {
  const dp=Array.from({length:a.length+1},()=>new Float64Array(b.length+1));
  const match=Array.from({length:a.length},()=>new Float64Array(b.length));
  for(let i=a.length-1;i>=0;i--)for(let j=b.length-1;j>=0;j--){match[i][j]=score(a[i],b[j]);dp[i][j]=Math.max(match[i][j]+dp[i+1][j+1],dp[i+1][j]-.1,dp[i][j+1]-.1);}
  const pairs=[];let i=0,j=0;
  while(i<a.length&&j<b.length){if(Math.abs(dp[i][j]-(match[i][j]+dp[i+1][j+1]))<.001){pairs.push([i,j]);i++;j++;}else if(dp[i+1][j]>=dp[i][j+1])i++;else j++;}
  return pairs;
}
const frames={}, prefixes={}, unsafe=[], review=[], stats={pairedArrays:0,persistentIndexContracts:0};
const sourceArrays={};
const refKey=(n,p,i)=>JSON.stringify([n,p,i]);
const ck=(n,p)=>[n,...p].join('.');
function catalog(x,n,p){
  if(Array.isArray(x))sourceArrays[JSON.stringify([n,p])]=x.length;
  if(x&&typeof x==='object')for(const[k,v]of Object.entries(x))if(v&&typeof v==='object')catalog(v,n,[...p,Array.isArray(x)?+k:k]);
}
for(const[n,a]of Object.entries(old.nodes))catalog(a,n,[]);
for(const key of ['places','talks','events'])catalog(old[key],'@'+key,[]);
function recordArray(a,b,an,ap,bn,bp,options={}){
  const pairs=options.pairs||align(a,b);stats.pairedArrays++;
  if(ap.at(-1)==='topics'&&a.some(x=>!x.id)){
    stats.persistentIndexContracts++;
    if(pairs.length<a.length||pairs.some(([i,j])=>!a[i].id&&i!==j))throw Error('Un-IDed talk topics changed order: '+ck(an,ap));
  }
  const matched=new Map(pairs);
  for(let i=0;i<=a.length;i++){
    const j=i===a.length?b.length:matched.get(i);
    if(j===undefined){unsafe.push({n:an,p:ap,i,kind:kind(a[i]),text:en(a[i]).slice(0,110)});continue;}
    frames[refKey(an,ap,i)]=[bn,bp,j];
  }
  for(const[i,j]of pairs){
    if(kind(a[i])&&score(a[i],b[j])<45)review.push({n:an,p:ap,i,to:[bn,bp,j],kind:kind(a[i]),score:+score(a[i],b[j]).toFixed(1),old:en(a[i]).slice(0,140),new:en(b[j]).slice(0,140)});
    if(kind(a[i])) prefixes[ck(an,[...ap,i])]=ck(bn,[...bp,j]);
    recordObject(a[i],b[j],an,[...ap,i],bn,[...bp,j]);
  }
}
function recordObject(a,b,an,ap,bn,bp){
  if(Array.isArray(a)&&Array.isArray(b))return recordArray(a,b,an,ap,bn,bp);
  if(!a||!b||typeof a!=='object'||typeof b!=='object')return;
  // A branch may have been wrapped/reordered while its surrounding scene survived.
  // Mapping the upcoming if step is safe: it will evaluate the new condition.
  // Mapping an already active then/else to the same spelling is not safe.
  // Preserve these source paths in the catalog but let their saved cursors recover
  // visibly at the node, rather than putting the player into another companion route.
  if(a.if&&b.if&&String(a.if).replace(/\s/g,'')!==String(b.if).replace(/\s/g,'')){
    unsafe.push({n:an,p:ap,kind:'if',reason:'Changed condition: active nested branch recovers at preserved node.'});
    return;
  }
  if(a.choice&&b.choice&&a.choice.some(o=>o.once&&!o.id)){
    stats.persistentIndexContracts++;
    const pairs=new Map(align(a.choice,b.choice));
    if(a.choice.some((o,i)=>o.once&&!o.id&&pairs.get(i)!==i))throw Error('Un-IDed once choice changed index: '+ck(an,ap));
  }
  if(a.board&&b.board){
    stats.persistentIndexContracts++;
    if(a.board.links.some((l,i)=>{const t=b.board.links?.[i];return !t||l.id!==t.id||serial((l.ids||[l.a,l.b]).slice().sort())!==serial((t.ids||[t.a,t.b]).slice().sort());}))throw Error('Saved board conclusion indexes need explicit migration: '+ck(an,ap));
  }
  for(const key of Object.keys(a))if(a[key]&&b[key]&&typeof a[key]==='object'&&typeof b[key]==='object')recordObject(a[key],b[key],an,[...ap,key],bn,[...bp,key]);
}
for(const[n,a]of Object.entries(old.nodes)){
  if(!fresh.nodes[n])continue;
  if(n==='c5_reading')continue;
  recordArray(a,fresh.nodes[n],n,[],n,[]);
}
for(const key of ['places','talks','events'])recordObject(old[key],fresh[key],'@'+key,[],'@'+key,[]);
// Câu đố T12 đổi căn cứ và tách node: tuyệt đối không map vào nhánh ok mới.
const a=old.nodes.c5_reading,b=fresh.nodes.c5_reading;
const d=a.findIndex(x=>x.deduce);
const tail=d+3;
recordArray(a.slice(0,d),b,'c5_reading',[],'c5_reading',[]);
delete frames[refKey('c5_reading',[],d)];
for(let i=d;i<tail;i++){
  delete frames[refKey('c5_reading',[],i)];
  unsafe.push({n:'c5_reading',p:[],i,kind:kind(a[i]),reason:'Revised evidence puzzle; restart its preserved scene.'});
}
const after=fresh.nodes.c5_reading_after;
const afterPairs=align(a.slice(tail),after);
// Ghi riêng đoạn hậu cảnh dưới tên node mới, nhưng giữ index nguồn đầy đủ.
for(const[local,j]of afterPairs){
  const i=tail+local;
  frames[refKey('c5_reading',[],i)]=['c5_reading_after',[],j];
  prefixes[ck('c5_reading',[i])]=ck('c5_reading_after',[j]);
  recordObject(a[i],after[j],'c5_reading',[i],'c5_reading_after',[j]);
}
frames[refKey('c5_reading',[],a.length)]=['c5_reading_after',[],after.length];
// Hai phản hồi dùng chung của place.js giống hệt trong engine nguồn và handoff.
for(const n of ['@__seen','@__take']){
  sourceArrays[JSON.stringify([n,[]])]=1;
  for(let i=0;i<=1;i++)frames[refKey(n,[],i)]=[n,[],i];
}
function walk(s,n,p){let x=n[0]==='@'?s[n.slice(1)]:s.nodes[n];for(const k of p)x=x?.[k];return x;}
for(const [key,[n,p,i]]of Object.entries(frames)){
  const [an,ap,ai]=JSON.parse(key),length=sourceArrays[JSON.stringify([an,ap])];
  if(!Number.isInteger(length)||ai<0||ai>length)throw Error('Invalid source cursor '+key);
  const arr=['@__seen','@__take'].includes(n)?[{}]:walk(fresh,n,p);
  if(!Array.isArray(arr)||!Number.isInteger(i)||i<0||i>arr.length)throw Error('Invalid target cursor '+JSON.stringify([n,p,i]));
}
const sourceDigest=hash(serial(old)),targetMappingDigest=hash(serial(fresh));
// Cursor alignment still concerns the original five chapters. The release
// lineage must also cover chapter six and non-frame source metadata: otherwise
// a changed ending condition or chapter catalog can retain an old revision.
const targetScriptHashes=Object.fromEntries(['story.js',...fs.readdirSync(path.join(target,'story')).filter(f=>/^ch\d+\.js$/.test(f)).sort((a,b)=>parseInt(a.slice(2))-parseInt(b.slice(2)))].map(f=>['story/'+f,hash(fs.readFileSync(path.join(target,'story',f)))]));
const targetDigest=hash(serial(targetScriptHashes));
const out={format:1,source:'between-tides-upload-ch1-5',sourceDigest,targetMappingDigest,targetScriptHashes,targetDigest,revision:'bt-complete-'+targetDigest.slice(0,16),sourceArrays,frames,prefixes,
  sourceNodes:Object.keys(old.nodes),targetNodes:Object.keys(fresh.nodes),
  changedPuzzle:{node:'c5_reading',from:d,to:tail},
};
const output=path.join(target,'plugins','bt-save-map.js');
fs.writeFileSync(output,'// Map từ chương 1–5 bản gốc; revision bao gồm story.js và mọi chương của bản phát hành. Không sửa tay.\nStoryEngine.btSaveMap = '+JSON.stringify(out)+';\n');
const audit={...stats,sourceArrayCount:Object.keys(sourceArrays).length,sourceCursorCount:Object.values(sourceArrays).reduce((sum,n)=>sum+n+1,0),mappedCursorCount:Object.keys(frames).length,sourceDigest,targetMappingDigest,targetScriptHashes,targetDigest,revision:out.revision,unsafe,review,outputBytes:fs.statSync(output).size};
fs.writeFileSync(path.join(target,'plugins','bt-save-map-audit.json'),JSON.stringify(audit,null,2)+'\n');
console.log(JSON.stringify(audit,null,2));
/* Full-figure costume sources are deliberately framed at the upper body on
   the native portrait layer. Chair/bench, cup and standing legs stay outside
   this framing; actual in-scene people continue to use native .pp.full. */
.vd .se-ch[data-bt-costume] .se-chi{overflow:hidden}
.vd .se-ch[data-bt-costume] .se-chi>.ii:not(.bt-cast-costume),
.vd .se-ch[data-bt-costume] .se-chi>.ph{opacity:0!important}
.vd .se-ch[data-bt-costume] .se-chi>.bt-cast-costume{
  opacity:1!important;background-repeat:no-repeat;background-position:50% 0%;
  background-size:auto 195%;animation:none;
  mask-image:linear-gradient(#000 0 82%,transparent 100%);
  -webkit-mask-image:linear-gradient(#000 0 82%,transparent 100%);
}
.vd .se-ch[data-bt-costume="dodd-full-sit"] .se-chi>.bt-cast-costume{background-size:auto 135%;background-position:53% 0%}
/* Narration supplies these two physical actions. A standing portrait would
   contradict the described armful of blankets or kneeling movement. */
.vd.bt-nell-action-narration .se-ch[data-id="nell"]{opacity:0!important;pointer-events:none}
/* The stool is at the right end of the counter. Keep its long first-meeting
   name clear of the native right-arrow touch target without moving the actor. */
.vd .se-bgl[data-image="lantern-bar"] .pp[data-who="fergus"] .pp-n{left:20%}
/* A 320×568 portrait has no spare letterbox below a 9:16 scene. Reserve the
   native exit row so full figures end above it. Scene and image-anchored hit
   regions resize together; the engine still performs all sprite fitting. */
@media(max-width:480px) and (max-height:640px) and (orientation:portrait){
  .vd[data-m="pl"]>.se-stage,.vd[data-m="pl"]>.se-plnav{bottom:74px}
}
/* Between Tides: context-specific costume framing on the native cast layer.
 * The engine still owns actor state, expressions, focus, transitions and saves.
 * No story frames, dialogue, flags, choices or core functions are replaced.
 */
(() => {
  'use strict';
  const E = globalThis.StoryEngine;
  if (!E?.plugin || E.plugins?.['bt-cast-staging']) return;
  const root = () => document.querySelector('.se');
  const ours = () => E.S()?.id === 'between-tides';
  const install = () => {
    if (!ours()) return;
    // The seated sprite includes its own stool. The approved bar plate now
    // leaves the customer-side floor empty, so there is one grounded seat.
    // A wider native region gives the seated torso its proper counter height.
    E.regions({ 'lantern-bar': { r: { 'bt-fergus-stool': [40, 27, 60, 69] } } });
    for (const person of E.S().places?.c1_bar?.views?.bar?.people || [])
      if (person.who === 'fergus') person.r = 'bt-fergus-stool';
  };
  const node = () => [...(E.R()?.stack || [])].reverse().find(f => /^c[1-6]_/.test(f.n))?.n || '';
  const DODD_COAT = new Set(['c2_harbour', 'c2_wait', 'c3_fergus', 'c5_vigil']);
  const NELL_COAT = new Set(['c2_tellfull', 'c2_wait', 'c2_slip']);
  const costumeFor = (id, n = node()) => id === 'dodd' && DODD_COAT.has(n) ? 'dodd-full-sit' : id === 'nell' && NELL_COAT.has(n) ? 'nell-full-outside' : '';
  const apply = () => {
    if (!ours()) return;
    for (const actor of root()?.querySelectorAll('.se-ch') || []) {
      const costume = costumeFor(actor.dataset.id);
      let image = actor.querySelector('.bt-cast-costume');
      if (!costume || !E.hasArt('im-' + costume)) {
        delete actor.dataset.btCostume;
        image?.remove();
        continue;
      }
      actor.dataset.btCostume = costume;
      if (!image) {
        image = document.createElement('div');
        image.setAttribute('aria-hidden', 'true');
        actor.querySelector('.se-chi').appendChild(image);
      }
      image.className = 'ii bt-cast-costume im-' + costume;
    }
  };
  const nativeShow = E.ui.show;
  E.ui.show = function (...args) {
    const result = nativeShow.apply(this, args);
    apply();
    return result;
  };
  const actionLine = st => {
    const en = st?.n?.en || '';
    return en.startsWith('At 22:39 Nell comes back down, her arms full of blankets.') ||
      en.startsWith('Nell kneels and tucks a blanket in under his chin');
  };
  const setAction = st => root()?.classList.toggle('bt-nell-action-narration', actionLine(st));
  const tomConversation = st => {
    if (node() !== 'c1_evening' || !st) return;
    const line = st.en || st.n?.en || '';
    const atTable = (st.whisper && (st.say === 'tom' || st.say === 'me')) ||
      line.startsWith('Tom touches the table with two fingers');
    if (!atTable) return;
    // The passing-table CG hid the actor. Native `say` intentionally does not
    // summon a hidden actor, so restore Tom at this authored conversation only.
    // This also handles an old save resumed on either player's question.
    E.ui.show('tom', 'c', st.face || E.R()?.cast?.tom?.face || 'soft');
    if (st.n) st.on = 'tom';
  };
  const nativeLine = E.ui.line;
  E.ui.line = function (options) {
    const addressTom = ours() && node() === 'c1_evening' && options?.who === 'me' && options?.whisper;
    return nativeLine.call(this, addressTom ? { ...options, on: 'tom' } : options);
  };
  E.plugin({ id: 'bt-cast-staging', on: {
    boot() { install(); apply(); setAction(null); },
    chapter: install,
    step(type, st) { if (ours()) { tomConversation(st); apply(); setAction(st); } },
  } });
  E.btCastStaging = { costumeFor, apply };
})();
