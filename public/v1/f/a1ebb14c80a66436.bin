    el.style.setProperty("opacity", "0", "important");
    el.className = "se-bgl";
    el.replaceChildren();
    delete el.dataset.image; delete el.dataset.layerKey; delete el.dataset.actionFrame; delete el.dataset.interactive;
  };
  // tr (engine 3): kiểu chuyển — "" mờ dần + Ken Burns (mặc định) · "still" mờ dần, đứng yên (view khám phá, khung hình) ·
  //   "sl-l" / "sl-r" trượt sang (đi vòng quanh phòng ◀ ▶) · "zin" phóng vào từ điểm (ox, oy %) · "zout" lùi ra · "cut" thay ngay
  function layer(cls, inner, cg, key, tr = "", o = {}) {
    bgKey = key || "";
    // The visible layer stays intact while a new image decodes. A newer request
    // reuses the inactive buffer; its token cancels the earlier pending reveal.
    const ls = [...root.querySelectorAll(".se-bgl")], pv = ls.find(x => x.classList.contains("on")) || ls[0], nx = ls.find(x => x !== pv);
    E.ui.retireLayer(nx);
    nx.className = "se-bgl " + cls; nx.innerHTML = inner; nx.style.removeProperty("--fx"); nx.style.removeProperty("--fy");
    nx.dataset.layerKey = key || "";
    E._layerHook?.(nx, key || "");
    if (o.ox != null) { root.style.setProperty("--tox", o.ox + "%"); root.style.setProperty("--toy", o.oy + "%"); }
    const tk = ++layerTok;
    pendingLayer = { token: tk, layer: nx };
    const go = () => {
      if (tk !== layerTok || !nx.isConnected) return;
      pv.className = pv.className.replace(/\b(t-\S+|out-\S+)\b/g, "").trim();
      nx.style.removeProperty("transition"); nx.style.removeProperty("opacity");
      void nx.offsetWidth;
      nx.classList.add("on", tr ? "st" : cg ? "kz" : "kb");
      if (tr && tr !== "still") { nx.classList.add("t-" + tr); pv.classList.add("out-" + tr); }
      pv.classList.remove("on");
      visibleBgKey = key || ""; pendingLayer = null;
      if (E.auto || tr === "cut" || root.classList.contains("se-motion-reduced")) E.ui.retireLayer(pv);
      else {
