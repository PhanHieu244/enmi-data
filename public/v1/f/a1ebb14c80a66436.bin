      c.resumeHere?.(false);
      if (!eligible || !reviewSafeSource(c.st, type)) { reviewClear(); return false; }
      const source = reviewSource(c, details); if (!source.stack) { reviewClear(); return false; }
      if (old?.phase === "review" && old.source?.key === c.key()) {
        if (!reviewWorld(old.source) || !reviewValidStack(old.decision?.stack)) { reviewClear(); return false; }
        R.stack = reviewCopy(old.decision.stack);
        R.exploreReview = { v: 1, phase: "choice", source, decision: old.decision };
        reviewRestore(old.decision.presentation);
        R.exploreReview.seal = reviewSeal(); E.save(); return true;
      }
