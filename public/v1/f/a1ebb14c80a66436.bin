        [
          15,
          "explore",
          "spots",
          1,
          "again"
        ],
        0
      ],
      "kind": "n",
      "score": 24,
      "old": "Dark, fresh sand. Someone has been digging here for a long time.",
      "new": "Dark sand, freshly disturbed. You cannot tell how long the digging took."
    },
    {
      "n": "c5_dunes",
      "p": [],
      "i": 43,
      "to": [
        "c5_dunes",
        [],
        41
      ],
      "kind": "n",
      "score": 17,
      "old": "Leo doesn't stop him. Neither do you.",
      "new": "Leo catches Skerry's collar and draws him back. A pale curve already shows through the disturbed sand."
    },
    {
      "n": "c5_dunes",
      "p": [],
      "i": 44,
      "to": [
        "c5_dunes",
        [],
        42
      ],
      "kind": "n",
      "score": 16.3,
      "old": "It doesn't take long. Whoever was here had already done most of the work.",
      "new": "Leo photographs the hollow before he touches anything. Whoever came before you has left the sand loose."
    },
    {
      "n": "c5_dunes",
      "p": [],
      "i": 54,
      "to": [
        "c5_dunes",
        [],
        53
      ],
      "kind": "n",
      "score": 14.9,
      "old": "Leo digs on with his hands, wider, deeper. Nothing.",
      "new": "He sweeps the torch over the exposed hollow, keeping his feet outside its edge."
    },
    {
      "n": "c5_dunes",
      "p": [],
      "i": 55,
      "to": [
        "c5_dunes",
        [],
        54
      ],
      "kind": "say",
      "score": 16.8,
      "old": "That's all of her that's here. Whoever it was took the rest.",
      "new": "Only this is exposed. The rest may have been moved. We need a proper search."
    },
    {
      "n": "c5_dunes",
      "p": [],
      "i": 56,
      "to": [
        "c5_dunes",
        [],
        55
      ],
      "kind": "note",
      "score": 18.9,
      "old": "The dunes: only the skull was left. Whoever dug took the rest of her.",
      "new": "The dunes: a skull in a freshly disturbed hollow. No other remains visible. Someone drove away without lights."
    },
    {
      "n": "c5_dunes",
      "p": [
        73,
        "then"
      ],
      "i": 1,
      "to": [
        "c5_dunes",
        [
          73,
          "then"
        ],
        1
      ],
      "kind": "n",
      "score": 26,
      "old": "Dr Vosper kneels beside the hollow before Leo can seal the bag. She doesn't touch what is inside. She turns it in the torchlight, slowly, wi",
      "new": "Dr Vosper kneels beside the hollow. She holds the bag by its edges and turns it towards the torch. She never touches the skull."
    },
    {
      "n": "c5_yard",
      "p": [
        4,
        "then"
      ],
      "i": 0,
      "to": [
        "c5_yard",
        [
