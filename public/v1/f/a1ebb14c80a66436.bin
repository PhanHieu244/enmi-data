// JSON save transfer cho trình duyệt VÀ Enmi iframe không có localStorage.
// Ghi qua E.G/R + E.save của core; không ghi thẳng vào SDK hay reload trang.
(() => {
  "use strict";
  const E = globalThis.StoryEngine, P = E?.btPersistence, C = E?.btSaveCompat;
  if (!E?.plugin || !P || !C || E.plugins?.["bt-save-transfer"]) return;
  const clone = x => JSON.parse(JSON.stringify(x));
  const object = x => x && typeof x === "object" && !Array.isArray(x);
  const reject = (en, vi) => { throw Error(en + " · " + vi); };
  const safeKeys = x => {
    if (!x || typeof x !== "object") return;
    for (const [key, value] of Object.entries(x)) {
      if (["__proto__", "prototype", "constructor"].includes(key)) reject("Invalid save key", "Khóa bản lưu không hợp lệ");
      safeKeys(value);
    }
  };
  const validateRun = run => {
    if (!object(run) || !object(run.f) || !Array.isArray(run.stack) || !Array.isArray(run.items) || !Array.isArray(run.log)) reject("Invalid run data", "Dữ liệu lần chơi không hợp lệ");
    if (run.btRevision !== C.revision) reject("Unsupported story revision", "Phiên bản truyện không được hỗ trợ");
    const maxChapter = Math.max(1, ...(E.S().chapters || []).map(c => c.ch));
    if (!Number.isInteger(run.ch) || run.ch < 0 || run.ch > maxChapter || run.stack.length > 256) reject("Invalid chapter or scene", "Chương hoặc cảnh không hợp lệ");
    for (let i = 0; i < run.stack.length; i++) {
      const f = run.stack[i];
      if (!object(f) || typeof f.n !== "string" || !Array.isArray(f.p) || !f.p.every(k => typeof k === "string" || Number.isInteger(k) && k >= 0) || !Number.isInteger(f.i) || f.i < 0) reject("Invalid scene cursor", "Vị trí cảnh không hợp lệ");
      const a = C.resolveFrame(run, i);
      if (!Array.isArray(a) || f.i > a.length) reject("Unavailable scene", "Cảnh chưa khả dụng");
    }
    if (!run.items.every(id => typeof id === "string" && Object.hasOwn(E.S().items || {}, id))) reject("Unavailable evidence", "Vật chứng không hợp lệ");
    if (run.scene != null && (typeof run.scene !== "string" || !Object.hasOwn(E.S().scenes || {}, run.scene))) reject("Unavailable location", "Địa điểm không hợp lệ");
    if (!run.log.every(line => object(line) && typeof line.main === "string" && (line.sub == null || typeof line.sub === "string"))) reject("Invalid dialogue history", "Lịch sử thoại không hợp lệ");
    for (const key of ["truths", "used", "cast", "met"]) if (run[key] != null && !object(run[key])) reject("Invalid run state", "Trạng thái lần chơi không hợp lệ");
  };
  const prepare = async data => {
    safeKeys(data);
    if (!object(data) || data.format !== "mobile-vn-save" || data.version !== 1 || data.story !== E.S().id || !object(data.global) || !object(data.global.set)) reject("Incompatible save", "Bản lưu không tương thích");
    // Chuyển trên bản sao; validation thất bại không đổi file hay trạng thái live.
    const next = clone(data);
    await P.prepareSave(next);
    validateRun(next.run);
    for (const key of ["cps", "chAt"]) {
      if (next.global[key] != null && !object(next.global[key])) reject("Invalid checkpoint collection", "Bộ mốc lưu không hợp lệ");
      for (const run of Object.values(next.global[key] || {})) validateRun(run);
    }
    for (const key of ["truths", "endings", "chDone", "opts", "words", "seen", "known"]) if (next.global[key] != null && !object(next.global[key])) reject("Invalid collection data", "Dữ liệu bộ sưu tập không hợp lệ");
    return next;
  };
  const exportSave = () => {
    const run = P.persist();
    const data = { format: "mobile-vn-save", version: 1, story: E.S().id, exportedAt: new Date().toISOString(), global: clone(E.G()), run };
    const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: "application/json" }));
    const link = document.createElement("a"); link.href = url; link.download = "Between_Tides_Save.json"; link.click();
    setTimeout(() => URL.revokeObjectURL(url), 30000);
    E.ui.toast(E.esc(E.nat({ en: "Save exported", vi: "Đã xuất bản lưu" })));
  };
  let chooser = 0;
  const importSave = () => {
    const request = ++chooser, input = document.createElement("input");
    input.type = "file"; input.accept = ".json,application/json";
    input.onchange = async () => {
      const file = input.files?.[0]; if (!file) return;
      try {
        if (file.size > 2000000) reject("Save file too large", "Tệp bản lưu quá lớn");
        const data = await prepare(JSON.parse(await file.text()));
        if (request !== chooser) return;
        const sh = E.ui.sheet("Load this save? · Nạp bản lưu?", '<p>This replaces the current route and collection with the selected file.</p><p class="vd-vi">Tuyến đang chơi và bộ sưu tập sẽ được thay bằng dữ liệu trong tệp đã chọn. Bạn có thể xuất tiến độ hiện tại trước.</p><div class="se-row"><button class="se-btn" data-export>Export current · Xuất hiện tại</button><button class="se-btn pri" data-load>Load save · Nạp</button></div>');
        sh.querySelector("[data-export]").onclick = exportSave;
        let loading = false;
        sh.querySelector("[data-load]").onclick = async event => {
          event.preventDefault(); event.stopPropagation(); if (loading) return; loading = true;
          const oldRun = E.snapshot(), oldGlobal = clone(E.G());
          try {
            // Không có write trước nút xác nhận này. Giữ identity của G/R mà
            // core và plugin đang tham chiếu, nhưng thay toàn bộ nội dung.
            E.ui.closeSheet(); E.stop(); E.explore = false;
            const g = E.G(); for (const key of Object.keys(g)) delete g[key]; Object.assign(g, clone(data.global));
            // Các dictionary core mong có vẫn được tạo cho export tối giản hợp lệ.
            for (const key of ["truths", "endings", "cps", "chAt", "chDone", "opts", "words", "seen", "known"]) g[key] ||= {};
            // Cùng phép chuyển thiết lập như boot gốc; đánh dấu trước bước
            // truyện đầu để mặc định đọc lần đầu không đổi sở thích vừa nhập.
            g.set = { mode: "bi", vDlg: true, vNarr: false, sfx: true, amb: true, speed: 1,
              name: "An", g: "M", tr: true, shadow: true, ...g.set, vdNativeControls: true, bt104ReadingDefaults: true };
            if ("voice" in g.set) { g.set.vDlg = g.set.voice !== false; delete g.set.voice; }
            if ("sound" in g.set) { g.set.sfx = g.set.amb = g.set.sound !== false; delete g.set.sound; }
            if (g.set.mode !== "imm") g.set.mode = "bi";
            C.installRun(data.run);
            document.querySelector(".se")?.classList.toggle("vd-large", !!g.set.vdLarge);
            const top = document.querySelector(".se-top"); if (top) top.hidden = false;
            const resumed = await E.resume();
            if (resumed === false) throw Error("This save could not be resumed. · Không thể tiếp tục bản lưu này.");
            // Native overview deliberately does not write R. A finished run
            // restores its ending without another step, so commit AFTER resume
            // has left overview. Active runs keep the native loop's pre-step
            // save: resume may return while an awaited side effect is pending.
            if (resumed === true && E.R().done) E.save();
          } catch (error) {
            const g = E.G(); for (const key of Object.keys(g)) delete g[key]; Object.assign(g, oldGlobal);
            C.installRun(oldRun); E.save(); E.ui.title();
            E.ui.toast(E.esc(error.message), 8000); loading = false;
          }
        };
      } catch (error) { E.ui.toast(E.esc(error.message), 8000); }
    };
    input.click();
  };
  E.plugin({ id: "bt-save-transfer", on: { boot() {
    if (E.S()?.id !== "between-tides") return;
    E.btSaveTransfer = { exportSave, importSave };
  } } });
})();
// Reproduce or reject a native chapter CSS/hasArt timing risk without changing core.
'use strict';
const fs = require('fs'), path = require('path'), http = require('http');
const { chromium } = require(process.env.CODEX_PRIMARY_RUNTIME_NODE_MODULES ? path.join(process.env.CODEX_PRIMARY_RUNTIME_NODE_MODULES, 'playwright') : 'playwright');
const root = path.resolve(__dirname, '../../../..');
const game = path.join(root, 'tools/games/between-tides');
const failFirst=process.env.BT_FAIL_FIRST_CSS==='1';
const server = http.createServer((req, res) => {
 const u=decodeURIComponent(req.url.split('?')[0]); const f=path.resolve(game,'.'+(u==='/'?'/index.html':u));
 if(!f.startsWith(game+'/')){res.statusCode=403;return res.end();}
 res.setHeader('Content-Type',f.endsWith('.js')?'text/javascript':f.endsWith('.css')?'text/css':f.endsWith('.html')?'text/html':'application/octet-stream');
 try{res.end(fs.readFileSync(f));}catch{res.statusCode=404;res.end();}
});
let browser;
(async()=>{
 await new Promise(r=>server.listen(0,'127.0.0.1',r));
 browser=await chromium.launch({executablePath:process.env.BT_BROWSER_PATH,headless:true,args:['--no-sandbox','--disable-dev-shm-usage','--disable-gpu']});
 const page=await browser.newPage({viewport:{width:320,height:568},hasTouch:true}),errors=[];
 page.on('pageerror',e=>errors.push(e.message));
 await page.addInitScript(()=>localStorage.clear());
 let cssRequests=0;
 await page.route('**/art-ch2.css',async route=>{cssRequests++;if(failFirst&&cssRequests===1)return route.fulfill({status:404,contentType:'text/css',body:''});await new Promise(r=>setTimeout(r,400));await route.continue();});
 await page.goto('http://127.0.0.1:'+server.address().port+'/'); await page.waitForSelector('.se[data-m="ov"]');
 const data=await page.evaluate(async failFirst=>{
  const E=StoryEngine,t=performance.now(); const firstOk=await E.loadUpTo(2),statusAfterFirst=E.btChapterAssets?.status(2);
  const retryOk=failFirst?await E.loadUpTo(2):null;
  const link=[...document.querySelectorAll('link[rel=stylesheet]')].find(l=>/art-ch2\.css(?:\?|$)/.test(l.href));
  if(!link)throw Error('The current index does not load art-ch2.css; wait for the split source build.');
  const before={hasArt:E.hasArt('im-nell-full-outside'),loaded:!!link.sheet,milliseconds:performance.now()-t};
  if(!link.sheet) await new Promise((res,rej)=>{link.addEventListener('load',res,{once:true});link.addEventListener('error',()=>rej(Error('CSS load failed')),{once:true});});
  const probe=document.createElement('div');probe.className='im-nell-full-outside';document.body.appendChild(probe);
  const after={hasArt:E.hasArt('im-nell-full-outside'),loaded:!!link.sheet,background:getComputedStyle(probe).backgroundImage,milliseconds:performance.now()-t};probe.remove();
  E.quiet=true; E.newRun(); E.stop(); E.quiet=false; E.R().ch=2; E.R().met.leo=1; E.ui.show('leo','c','determined');
  const face=document.querySelector('.se-ch[data-id=leo]'); const faceImage=face.querySelector('.im-leo-determined');
  const nativeFace={who:'leo',face:'determined',hasf:face.classList.contains('hasf'),background:faceImage?getComputedStyle(faceImage).backgroundImage:'none'};
  E.ui.cg('cg-tom-dead'); const cgImage=document.querySelector('.im-cg-tom-dead');
  const nativeCg={state:E.R().cg,background:cgImage?getComputedStyle(cgImage).backgroundImage:'none'};
  return{firstOk,retryOk,statusAfterFirst,before,after,nativeFace,nativeCg,chapter6Loaded:!!E.S().nodes.c6_open,stylesheets:[...document.querySelectorAll('link[rel=stylesheet]')].map(l=>l.getAttribute('href'))};
 },failFirst);
 const result={cssDelayMs:400,failFirst,cssRequests,errors,...data};
 const out=path.join(root,'docs/games/between-tides/qa',failFirst?'cast-css-failure-retry.json':'cast-css-delay-after.json');fs.mkdirSync(path.dirname(out),{recursive:true});fs.writeFileSync(out,JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify(result,null,2));
 await browser.close();browser=null;server.close();
 if((failFirst?(data.firstOk!==false||data.retryOk!==true):(data.firstOk!==true)) || !data.before.hasArt || !data.before.loaded || !data.after.hasArt || data.after.background==='none' || !data.nativeFace.hasf || data.nativeFace.background==='none' || data.nativeCg.state!=='cg-tom-dead' || data.nativeCg.background==='none' || errors.length)process.exitCode=1;
})().catch(async e=>{console.error(e);if(browser)await browser.close();server.close();process.exitCode=1;});
