          pinch = { distance: Math.hypot(p[0].x - p[1].x, p[0].y - p[1].y), zoom, world: { x: (viewport.scrollLeft + mid.x) / zoom, y: (viewport.scrollTop + mid.y) / zoom } }; drag = null;
