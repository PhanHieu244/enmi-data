      { cg: null }, { show: "leo", at: "r", face: "determined" }, { show: "nell", at: "c", face: "sad" },
      I(s => s.f.c6_tom_confession, [
        D("leo", "Nell Calloway, I'm arresting you on suspicion of killing Tom Ashby and Anna Rowe.",
