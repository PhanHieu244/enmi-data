        generic(step, scopes, at, true);
        if (typeOf(step) === "if") scopes = merge(sequence(step.then, scopes, [...at,"then"]), Array.isArray(step.else) ? sequence(step.else, scopes, [...at,"else"]) : scopes);
      }
