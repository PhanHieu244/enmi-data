  def("prop", async ({ st }) => {
    const P = st.prop, img = E.curImg(), L = $(".se-bgl.on"), R = E.R(); if (!L || !P?.id) return;
    const old = R.props?.[P.id]?.img === img ? R.props[P.id] : {};
