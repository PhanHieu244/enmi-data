/* Part III, chapter 1: testimony has owners; the empty stall has no explanation yet. */
(()=>{'use strict';
const T=(en,vi)=>({en,vi}),N=(en,vi)=>({n:T(en,vi)}),S=(say,en,vi,face)=>({say,en,vi,...(face?{face}:{})}),C=(en,vi,then)=>({en,vi,silent:true,then});
const I=(kind,en,vi,a,b,who='',artAlias='paper')=>({icon:'doc',keep:true,kind,recordType:kind,chapter:1,name:T(en,vi),desc:T(a,b),brief:T(a,b),sourceLabel:T(who?'Recorded account':'Vale · direct examination',who?'Lời kể đã ghi':'Vale · trực tiếp xem xét'),who,artAlias});
const chapter=d=>{const documents={"p3_meal": "p3_doctor_note"};for(const[id,docId]of Object.entries(documents)){const doc=d.docs?.[docId],it=d.items?.[id];if(doc&&it)it.document={title:doc.title,text:T(doc.lines.map(x=>x.en).join('\n\n'),doc.lines.map(x=>x.vi).join('\n\n'))};}for(const it of Object.values(d.items||{})){if(it.recordType==='document'&&!it.document)it.document={title:it.name,text:it.desc,note:T('Case record · written account','Hồ sơ vụ án · ghi chép bằng văn bản')};}StoryEngine.chapter(d);};
chapter({
 items:{
 p3_notice:I('document','Two questions','Hai câu hỏi','Ember Star is missing. His trainer Thomas Greaves was found dead in a hollow. The race is on Wednesday; the registration closes that morning.','Ember Star mất tích. Người huấn luyện Thomas Greaves được tìm thấy đã chết trong hõm đất. Cuộc đua diễn ra thứ Tư; hạn đăng ký là sáng hôm đó.'),
 p3_latch:I('observation','An undamaged latch','Chốt cửa không hư hại','The stable latch has no fresh break. A small meal hatch cannot admit a person. A key or an opened door remains possible.','Chốt chuồng không có chỗ gãy mới. Ô cửa nhỏ đưa đồ ăn không đủ cho người chui qua. Vẫn có thể đã dùng chìa khóa hoặc có người mở cửa.'),
 p3_last_seen:I('testimony','The last checked stall','Lần cuối kiểm tra chuồng','Ben says he saw Ember Star in the stall after nine on Sunday evening. He locked the outer door. He cannot account for the hours after becoming ill.','Ben nói đã thấy Ember Star trong chuồng sau chín giờ tối Chủ nhật. Anh khóa cửa ngoài. Anh không biết điều gì xảy ra trong những giờ sau khi mình lịm đi.','ben'),
 p3_meal:I('document','The doctor’s note','Ghi chú của bác sĩ','The doctor reports a sedating substance in Ben’s supper and considers his collapse involuntary. The note does not identify who added it.','Bác sĩ ghi nhận chất gây buồn ngủ trong bữa tối của Ben, cho rằng anh lịm đi ngoài ý muốn. Ghi chú không xác định ai đã cho chất đó vào.','nora'),
 p3_scarf:I('testimony','A visitor’s scarf','Khăn của người khách','Ben identifies the red scarf in the constable’s sketch as Miles Quill’s. He saw Quill earlier at the meal hatch, asking about the race. He did not see him enter the stable.','Ben nhận chiếc khăn đỏ trong phác họa của cảnh sát là của Miles Quill. Trước đó anh thấy Quill đứng bên ô đưa đồ ăn, hỏi về cuộc đua. Anh không thấy Quill vào chuồng.','ben','p3_cloth'),
 p3_horse_record:I('document','Ember Star’s care card','Phiếu chăm sóc Ember Star','Nora’s dated card describes a dark bay, a small white forehead star, a white left hind sock and a repair on the outside edge of the near fore shoe.','Phiếu ghi ngày của Nora mô tả ngựa nâu sẫm, đốm trắng nhỏ trên trán, mảng trắng ở chân sau trái và chỗ sửa ở mép ngoài móng sắt chân trước trái.','nora','p3_horse')
 },
 docs:{p3_doctor_note:{paper:'letter',title:T('A note left for the constable','Ghi chú để lại cho cảnh sát'),lines:[T('Ben Larkin is recovering from an involuntary stupor. Examination of the remaining supper supports the presence of a sedating substance.','Ben Larkin đang hồi phục sau cơn lịm đi ngoài ý muốn. Kiểm tra phần đồ ăn còn lại cho thấy có chất gây buồn ngủ.'),T('This finding does not identify the person responsible. The patient should rest.','Kết quả này không xác định người gây ra việc đó. Người bệnh cần nghỉ ngơi.')]}},
 places:{p3c1_stable_walk:{name:T('Wycliffe stable','Trại Wycliffe'),goal:T('Inspect the stall door and ask Ben what he actually remembers. You can also meet Nora in the yard.','Xem cửa chuồng và hỏi Ben điều anh thực sự nhớ. Bạn cũng có thể gặp Nora ngoài sân.'),start:'stall',ring:['stall','yard'],need:s=>s.has('p3_latch')&&s.has('p3_last_seen'),progress:s=>[Number(s.has('p3_latch'))+Number(s.has('p3_last_seen')),2],leave:false,done:T('Compare the first accounts','Đối chiếu những lời kể đầu'),views:{
 stall:{img:'p3_stable',name:T('The empty stall','Chuồng trống'),zones:[{id:'door',r:[68,50,13,10],inspectR:[56,42,29,21],clue:true,label:T('Examine the latch','Xem chốt cửa'),then:[N('A brass staple shines where years of hands have polished it. The wood around it has old dents, but no new splinter. You lift the latch gently and let it fall into its own notch.','Khoen đồng bóng lên vì bao bàn tay chạm vào suốt nhiều năm. Gỗ quanh khoen có vết lõm cũ, nhưng không có dằm mới. Bạn nhẹ nhàng nhấc chốt rồi để nó rơi đúng rãnh.'),N('The meal hatch is barely wide enough for a plate. A person could put an arm through, but not follow it. Reed marks that distinction beside the constable’s sketch.','Ô đưa đồ ăn chỉ vừa đủ rộng cho chiếc đĩa. Một người có thể thò tay qua, nhưng không chui theo được. Reed ghi rõ khác biệt ấy cạnh phác họa của cảnh sát.'),{item:'p3_latch'}],again:[N('No fresh forced entry. That limits a method; it does not name the person who opened the door.','Không có dấu mới của việc phá cửa. Điều đó thu hẹp cách vào, chưa cho biết ai đã mở cửa.')]},{id:'bucket',r:[18,61,15,11],inspectR:[12,57,25,20],clue:false,label:T('Look at the untouched feed','Xem phần thức ăn còn nguyên'),then:[N('The morning feed is still in its bucket. Someone has placed it outside an empty stall out of habit. You move it just far enough to clear the passage, and Ben quietly puts it back.','Thức ăn buổi sáng vẫn nằm trong xô. Ai đó đã quen tay đặt nó ngoài chuồng trống. Bạn chỉ xê dịch đủ để thông lối đi, rồi Ben lặng lẽ đặt nó lại.')],again:[N('The routine is still here, though the horse is not. For the moment, at least.','Nếp sinh hoạt vẫn còn, dù con ngựa không ở đây. Ít nhất là lúc này.')]}],people:[{who:'ben',r:[8,31,31,64],talk:'p3c1_ben'}]},
 yard:{img:'p3_yard',name:T('The yard','Sân trại'),zones:[{id:'kennel',r:[41,52,17,10],inspectR:[36,46,30,18],clue:false,label:T('Notice the dog','Để ý con chó'),then:[N('The dog raises its head at your shoes. Ben says its name, Moss, and the tail gives one cautious sweep. It has not decided whether you are a visitor or a nuisance.','Con chó ngẩng đầu nhìn giày bạn. Ben gọi tên nó, Moss, và nó dè dặt vẫy đuôi một cái. Nó chưa quyết định bạn là khách hay kẻ gây phiền.')],again:[N('Moss watches you from the kennel. An animal’s silence needs as much context as a person’s.','Moss nhìn bạn từ ổ. Sự im lặng của con vật cũng cần ngữ cảnh như sự im lặng của con người.')]}],people:[{who:'nora',r:[60,30,31,65],talk:'p3c1_nora'}]}
 }}},
 talks:{
 p3c1_ben:{with:'ben',hello:[S('ben','I am awake now. Everybody asks that first.','Bây giờ tôi tỉnh rồi. Ai cũng hỏi câu đó đầu tiên.','concerned'),N('He has buttoned his waistcoat wrongly. The last button sits alone below the others, and he keeps rubbing it with his thumb.','Anh cài lệch khuy áo gi lê. Chiếc khuy cuối nằm lẻ bên dưới những chiếc khác; ngón cái anh cứ miết lên nó.')],topics:[
 {id:'night',label:T('Ask for the last thing he checked','Hỏi lần cuối anh đã kiểm tra gì'),then:[S('me','Start with something you remember doing, not something you have been told.','Hãy bắt đầu bằng việc anh nhớ mình đã làm, không phải điều người khác kể lại.'),S('ben','After nine. I checked Star, filled his water, and locked the outer door. Mr Greaves had already gone up to the house.','Sau chín giờ. Tôi kiểm tra Star, đổ thêm nước rồi khóa cửa ngoài. Ông Greaves đã lên nhà trước đó.'),S('me','And after supper?','Còn sau bữa tối?'),S('ben','My hands would not hold the cup. Then it was morning. I know how that sounds.','Tay tôi không giữ nổi cái cốc. Rồi mở mắt ra đã là sáng. Tôi biết kể vậy nghe chẳng ra làm sao.'),S('me','It sounds like a gap. We can record a gap without filling it with blame.','Nghe như một khoảng trống. Ta có thể ghi lại khoảng trống mà không lấp nó bằng lời buộc tội.'),{item:'p3_last_seen'}]},
 {id:'visitor',label:T('Ask whether anyone came to the stable','Hỏi có ai đến trại không'),then:[S('ben','Quill. A betting agent. He came to the meal hatch and offered money for news about Star. I told him where to put it. Politely enough for the yard.','Quill, một người môi giới cá cược. Ông ta đến ô đưa đồ ăn, ngỏ ý trả tiền để hỏi tin về Star. Tôi bảo ông ta đem tiền đi chỗ khác. Lịch sự đủ dùng trong trại.'),S('me','Did you see him enter?','Anh có thấy ông ta vào không?'),S('ben','No. I went to fetch Moss. Quill was gone when I came back. The constable says his scarf was found by Mr Greaves.','Không. Tôi đi gọi Moss. Khi quay lại thì Quill đi rồi. Cảnh sát nói tìm thấy khăn của ông ta bên ông Greaves.'),N('You show him the constable’s drawing. He recognises the red cloth, then corrects himself: he recognises what the drawing is meant to show. He has not inspected the recovered scarf.','Bạn đưa phác họa của cảnh sát cho anh. Anh nhận ra khăn đỏ, rồi tự đính chính: anh nhận ra thứ hình vẽ muốn thể hiện. Anh chưa xem chiếc khăn thu được.'),{item:'p3_scarf'}]},
 {id:'greaves',label:T('Ask what Greaves was like at work','Hỏi Greaves là người thế nào khi làm việc'),then:[S('ben','He could hear a loose shoe before I could see it. He used to make me close my eyes and listen. I hated that.','Ông ấy nghe ra móng sắt lỏng trước khi tôi nhìn thấy. Ông ấy từng bắt tôi nhắm mắt nghe. Tôi ghét việc đó.'),N('Ben looks towards the empty stall.','Ben nhìn về chuồng trống.'),S('ben','I wish he were here to do it again.','Tôi ước ông ấy còn đây để bắt làm lần nữa.','concerned')]}
 ],bye:[N('You leave him a chair instead of another question. He sits only after you turn away.','Bạn để lại cho anh chiếc ghế thay vì thêm một câu hỏi. Chỉ khi bạn quay đi, anh mới ngồi xuống.')]},
 p3c1_nora:{with:'nora',hello:[S('nora','If you have come for the horse’s description, I wrote it down before anyone needed an alibi.','Nếu ông cần mô tả con ngựa, tôi đã ghi từ trước khi có người cần chứng cứ ngoại phạm.','calm')],topics:[
 {id:'health',label:T('Ask what is known about Ben’s illness','Hỏi điều đã biết về tình trạng của Ben'),then:[S('nora','The doctor left this for the constable. Ben was not simply asleep. He should not have to look ill for people to believe it.','Bác sĩ để lại tờ này cho cảnh sát. Ben không chỉ ngủ quên. Không lẽ anh ấy phải trông ốm yếu thì mọi người mới chịu tin.'),{read:'p3_doctor_note'},{item:'p3_meal'}]},
 {id:'identity',label:T('Read the horse’s identification card','Đọc phiếu nhận dạng con ngựa'),then:[S('nora','A white star catches the eye. A shoe repair tells a quieter story. Use both, and ask the farrier to check his work.','Đốm trắng dễ nhận ra. Chỗ sửa móng sắt kín đáo hơn nhưng cũng cho ta biết nhiều điều. Hãy xem cả hai, rồi nhờ thợ đóng móng kiểm tra lại chỗ ông ấy đã sửa.'),N('Her card is dated last Thursday. You copy the markings and the shoe repair into your notebook.','Phiếu đề ngày thứ Năm tuần trước. Bạn chép các đặc điểm và chỗ sửa móng sắt vào sổ tay.'),{item:'p3_horse_record'}]}
 ],bye:[S('nora','Bring him back sound. The race can wait for that much.','Hãy đưa nó về lành lặn. Chuyện đua có thể chờ đến lúc đó.')]}
 },
 nodes:{p3c1_open:[{title:{ch:1,en:'An Empty Stall',vi:'Chuồng trống'}},{bg:'p3_yard'},{hide:'*'},{cp:'p3c1_start'},N('Monday afternoon. The station porter gives you directions to Wycliffe’s stable before you ask. On the train, three men had already explained the case to you. Their explanations agreed on everything except what had happened.','Chiều thứ Hai. Người khuân hành lý ở ga chỉ đường đến trại Wycliffe trước khi bạn hỏi. Trên tàu, ba người đàn ông đã giải thích vụ án cho bạn. Các lời giải thích thống nhất mọi thứ, trừ chuyện đã xảy ra.'),{show:'reed',at:'l'},S('reed','I have left the first page blank. It seemed fairer to the facts.','Tôi để trống trang đầu. Như vậy có vẻ công bằng với sự thật hơn.'),{show:'elin',at:'r'},N('Lady Wycliffe waits at the gate, telegram folded into a narrow strip. She keeps it in her hand. Too many readings have left nothing new.','Phu nhân Wycliffe đợi bên cổng, bức điện gấp thành dải hẹp. Bà vẫn giữ trong tay. Đọc đi đọc lại quá nhiều, chẳng còn gì mới.'),S('elin','Thomas Greaves worked for me twelve years. This morning they brought back his coat. The horse is still missing.','Thomas Greaves làm cho tôi mười hai năm. Sáng nay họ mang áo khoác của ông ấy về. Con ngựa vẫn mất tích.','concerned'),S('me','Who found him?','Ai tìm thấy ông ấy?'),S('elin','The stable hands, after the boy on duty could not be woken. Greaves was in the hollow beyond the drainage path. The constable has kept people off the ground.','Những người làm trong trại, sau khi không gọi dậy được cậu trực đêm. Ông Greaves nằm ở hõm đất bên kia lối ven rãnh nước. Cảnh sát đã ngăn người ta đi vào đó.'),N('A small boy runs past with a bridle. At the sight of the empty stall he slows, turns and carries it back. Nobody tells him to hurry.','Một cậu bé chạy ngang với bộ dây cương. Thấy chuồng trống, cậu chậm lại, quay đầu mang nó về. Không ai giục cậu.'),S('elin','The Wessex race is Wednesday. Registration closes that morning. I need to know whether to withdraw him.','Cuộc đua Wessex diễn ra thứ Tư. Sáng hôm ấy hết hạn đăng ký. Tôi cần biết có phải rút nó khỏi cuộc đua không.'),S('me','Two entries: where Ember Star went, and what killed Greaves. Solving one does not solve the other.','Hai mục: Ember Star đã đi đâu, và điều gì khiến Greaves thiệt mạng. Giải được một mục chưa giải được mục kia.'),{item:'p3_notice'},S('elin','Then give each the attention it deserves. I can tolerate a late answer better than a convenient one.','Vậy hãy dành sự chú ý xứng đáng cho cả hai việc. Tôi thà chờ lâu còn hơn nhận một câu trả lời cho xong chuyện.','resolute'),{bg:'p3_stable'},{hide:'*'},{place:'p3c1_stable_walk'},
 {if:s=>!s.has('p3_meal'),then:[N('Before you leave the passage, Nora brings the doctor’s note. She waits while you read the two short paragraphs.','Trước khi bạn rời lối đi, Nora mang ghi chú của bác sĩ tới. Cô chờ bạn đọc hai đoạn ngắn.'),{read:'p3_doctor_note'},{item:'p3_meal'}]},
 {if:s=>!s.has('p3_horse_record'),then:[S('nora','Take the identification card as well. A tired bay horse is not always our tired bay horse.','Mang cả phiếu nhận dạng nữa. Một con ngựa nâu mệt mỏi chưa chắc là con ngựa nâu mệt mỏi của chúng tôi.'),{item:'p3_horse_record'}]},
 {bg:'p3_yard'},{show:'reed',at:'l'},N('Reed draws two headings on the blank page. Beneath the first she writes an empty stall; beneath the second, a hollow on the moor. Between them she leaves a space.','Reed viết hai tiêu đề lên trang trắng. Dưới mục thứ nhất là chuồng trống; dưới mục thứ hai là hõm đất ngoài đồng hoang. Giữa hai mục, cô chừa khoảng trống.'),S('reed','Where first? The daylight is useful outside. The people here will still have things to say when we return.','Đi đâu trước? Ánh sáng ban ngày hữu ích ở ngoài. Khi ta quay lại, những người ở đây vẫn còn chuyện để nói.'),{choice:[C('Walk the moor while the ground can be seen clearly.','Ra đồng hoang lúc còn nhìn rõ mặt đất.',[{set:{p3_first:'ground'}},S('me','We will begin with what the rain has not erased.','Ta bắt đầu với những gì mưa chưa xóa.')]),C('Have the constable preserve the records, then walk the moor.','Nhờ cảnh sát giữ giấy tờ, rồi ra đồng hoang.',[{set:{p3_first:'records'}},N('You ask that the office papers stay together and the meal bowl stay labelled. The constable posts a man at the door. You can set out, leaving the evidence in place.','Bạn đề nghị giữ giấy tờ văn phòng cùng nhau, giữ nhãn trên bát đồ ăn. Viên cảnh sát cử người đứng cửa. Bạn có thể lên đường, để các vật chứng nguyên chỗ cũ.')])]},N('Ben has corrected the buttons on his waistcoat. He stands at the stable door and points out the low path through the heather. You can see where it goes until the land falls away.','Ben đã cài lại khuy áo gi lê. Anh đứng ở cửa chuồng, chỉ lối thấp xuyên qua thạch nam. Bạn nhìn theo được cho tới chỗ mặt đất trũng xuống.'),S('me','We are going to look. You do not have to remember the missing hours for us.','Chúng tôi sẽ đi xem. Anh không phải cố nhớ những giờ bị mất thay chúng tôi.'),N('He nods once. The bridle hangs back on its peg. You close the gate behind you without making it sound like a departure for good.','Anh gật một lần. Bộ dây cương đã treo lại trên móc. Bạn khép cổng sau lưng, cố không để tiếng đóng nghe như một cuộc ra đi mãi mãi.'),{end:'p3c1_end'}]},
 flow:[{ch:1,row:0,id:'p3c1_start',kind:'cp',label:T('The empty stall','Chuồng trống')},{ch:1,row:1,id:'p3c1_end',kind:'end',label:T('Two open questions','Hai câu hỏi để ngỏ')}],
 recap:[{ch:1,t:T('The stable door is undamaged. Ben’s account stops when he becomes ill. The doctor’s note supports involuntary sedation, but names no culprit.','Cửa chuồng không bị phá. Lời kể của Ben dừng ở lúc anh lịm đi. Ghi chú của bác sĩ cho thấy anh bị gây buồn ngủ ngoài ý muốn, nhưng không nêu thủ phạm.')}],
 endings:{p3c1_end:{ch:1,title:T('Two Open Questions','Hai câu hỏi để ngỏ'),chapterClose:T('Monday afternoon · the first accounts recorded','Chiều thứ Hai · đã ghi những lời kể đầu'),nextObjective:T('Follow the preserved ground to the hollow before judging who used it.','Đi theo vùng đất được giữ nguyên đến hõm đất, rồi mới nhận xét ai đã đi qua.'),sum:T('The horse is missing; the trainer is dead. The inquiry will keep those facts separate until evidence connects them.','Con ngựa mất tích; người huấn luyện thiệt mạng. Cuộc điều tra sẽ giữ hai sự việc riêng cho đến khi có bằng chứng nối chúng.'),text:T('A path leads out of the yard.','Một lối đi dẫn ra khỏi sân.'),next:'p3c2_open',nextTitle:T('The Moor’s Two Trails','Hai dấu vết trên đồng hoang')}}
});})();
/* Part III, chapter 2: the paths meet after the death scene, not before it. */
(()=>{'use strict';
const T=(en,vi)=>({en,vi}),N=(en,vi)=>({n:T(en,vi)}),S=(say,en,vi,face)=>({say,en,vi,...(face?{face}:{})}),C=(en,vi,then)=>({en,vi,silent:true,then});
const I=(kind,en,vi,a,b,who='',artAlias='paper')=>({icon:'doc',keep:true,kind,recordType:kind,chapter:2,name:T(en,vi),desc:T(a,b),brief:T(a,b),sourceLabel:T(who?'Recorded account':'Vale · ground examined',who?'Lời kể đã ghi':'Vale · đã xem dấu vết'),who,artAlias});
const chapter=d=>{const documents={"p3_head_report": "p3_examination"};for(const[id,docId]of Object.entries(documents)){const doc=d.docs?.[docId],it=d.items?.[id];if(doc&&it)it.document={title:doc.title,text:T(doc.lines.map(x=>x.en).join('\n\n'),doc.lines.map(x=>x.vi).join('\n\n'))};}for(const it of Object.values(d.items||{})){if(it.recordType==='document'&&!it.document)it.document={title:it.name,text:it.desc,note:T('Case record · written account','Hồ sơ vụ án · ghi chép bằng văn bản')};}StoryEngine.chapter(d);};
chapter({
 items:{
 p3_tracks:I('observation','Hooves leaving the hollow','Dấu móng rời hõm đất','A continuous patch of wet ground shows a horse moving away from the hollow without accompanying boot marks. The shoe impression is consistent with Ember Star’s recorded repair.','Một đoạn đất ướt liền mạch cho thấy ngựa đi khỏi hõm đất, không có dấu giày đi kèm. Dấu móng sắt phù hợp với chỗ sửa được ghi trên phiếu Ember Star.','','p3_shoe'),
 p3_site:I('observation','The objects in the hollow','Đồ vật trong hõm đất','The constable’s inventory records a candle stub, a fine instrument and a red scarf beside Greaves. The sketched position of his coat over the gorse suggests it was laid there deliberately.','Danh mục của cảnh sát ghi một mẩu nến, dụng cụ mảnh và khăn đỏ bên Greaves. Vị trí chiếc áo trên bụi kim tước trong phác họa gợi rằng nó đã được chủ động đặt ở đó.','','p3_case_closed'),
 p3_joining_tracks:I('observation','Boots join the horse','Dấu giày nhập vào dấu ngựa','Beyond the hollow, broad boot marks approach the lone horse trail from Greybank. Horse and boots then return together toward Greybank’s gate. The visible sequence does not put the boot wearer in the hollow.','Bên kia hõm đất, dấu giày rộng từ phía Greybank tiến đến dấu ngựa đi một mình. Sau đó dấu ngựa và giày cùng quay về cổng Greybank. Trình tự nhìn thấy không đặt người mang giày vào hõm đất.'),
 p3_head_report:I('document','The examining doctor’s finding','Nhận định của bác sĩ khám nghiệm','The doctor describes a fatal head injury consistent with a heavy blunt impact, with a partly curved outline. The separate leg cut could have occurred in the fall. The report does not identify what struck Greaves.','Bác sĩ mô tả vết thương chí mạng ở đầu phù hợp với va đập mạnh bằng vật tày, một phần có đường viền cong. Vết cắt riêng ở chân có thể xảy ra khi ngã. Báo cáo không xác định vật đã gây thương tích cho Greaves.'),
 p3_route:I('inference','Two stages of one trail','Hai chặng của một dấu vết','The horse left the hollow, then encountered someone coming from Greybank. That later meeting may explain where the horse went next; it does not by itself explain Greaves’s death.','Con ngựa rời hõm đất, rồi gặp người từ Greybank đi tới. Cuộc gặp sau đó có thể giải thích nó đã đi đâu tiếp; riêng nó chưa giải thích cái chết của Greaves.')
 },
 docs:{p3_examination:{paper:'letter',title:T('Extract from the examining doctor’s report','Trích báo cáo của bác sĩ khám nghiệm'),lines:[T('The fatal head injury is consistent with a heavy blunt impact. Part of the wound has a curved outline; that does not identify the object that struck him.','Vết thương chí mạng ở đầu phù hợp với va đập mạnh bằng vật tày. Một phần vết thương có đường viền cong; riêng dấu này không xác định được vật gây thương tích.'),T('The separate cut may have been sustained during the fall, with the fine instrument found at the scene. This remains an interpretation to be compared with the other evidence.','Vết cắt riêng có thể xảy ra lúc ngã, do dụng cụ mảnh tìm thấy ở hiện trường. Đây vẫn là nhận định cần đối chiếu với bằng chứng khác.')]}},
 places:{p3c2_ground:{name:T('The preserved path','Lối đi được giữ nguyên'),goal:T('Inspect the outgoing hoof marks and the recorded objects in the hollow. Keep outside the cordon.','Xem dấu móng đi ra và đồ vật được ghi nhận trong hõm đất. Đứng ngoài dây giới hạn.'),start:'path',ring:['path','hollow'],need:s=>s.has('p3_tracks')&&s.has('p3_site'),progress:s=>[Number(s.has('p3_tracks'))+Number(s.has('p3_site')),2],leave:false,done:T('Follow the trail beyond the hollow','Theo dấu vết bên kia hõm đất'),views:{
 path:{img:'p3_moor',name:T('The drainage path','Lối ven rãnh nước'),zones:[{id:'hooves',r:[43,68,19,14],inspectR:[36,63,31,23],clue:true,label:T('Compare the hoof marks','So sánh dấu móng'),then:[N('You kneel on dry heather, not in the impression. In the softer ground beside the drainage cut, four hooves form a line away from the hollow. The fore-shoe mark has a small irregularity on its outer edge.','Bạn quỳ trên thạch nam khô, không quỳ vào vết in. Trên đất mềm cạnh rãnh nước, bốn móng tạo thành hàng đi khỏi hõm đất. Dấu móng sắt trước có chỗ không đều nhỏ ở mép ngoài.'),S('reed','Like the repair on Nora’s card?','Giống chỗ sửa trên phiếu của Nora?'),S('me','The shape fits. Let us see where the marks lead.','Hình dạng phù hợp. Ta theo dấu xem chúng dẫn đến đâu.'),N('Here the mud is broad enough to show prints on either side. You find no accompanying boots in this unbroken patch. Beyond it the harder ground tells you less.','Ở đây bãi bùn đủ rộng để giữ dấu hai bên. Bạn không thấy giày đi kèm trong đoạn liền mạch này. Xa hơn, đất cứng cho biết ít hơn.'),{item:'p3_tracks'}],again:[N('In the visible wet patch, the horse leaves the hollow alone. Hard ground beyond is a gap, not permission to invent prints.','Trong đoạn đất ướt nhìn được, ngựa rời hõm một mình. Đất cứng phía sau là khoảng trống, không phải chỗ để tưởng tượng thêm dấu chân.')]},{id:'water',r:[45,38,34,9],inspectR:[30,33,55,19],clue:false,label:T('Check the drainage cut','Xem rãnh nước'),then:[N('Water moves slowly through the cut. A fresh wheel rut interrupts an older hoof mark at its edge. The constable’s cart came this morning; you mark its track separately instead of treating every mark as part of the night.','Nước chảy chậm qua rãnh. Vết bánh xe mới cắt ngang dấu móng cũ ở mép. Xe của cảnh sát đến sáng nay; bạn ghi riêng vệt xe, không xem mọi dấu đều thuộc đêm qua.')],again:[N('The cart arrived after the discovery. Its rut is later traffic.','Xe đến sau khi phát hiện thi thể. Vệt bánh thuộc lượt đi lại sau đó.')]}]},
 hollow:{img:'p3_hollow',name:T('The hollow','Hõm đất'),zones:[{id:'coat',r:[20,75,15,8],inspectR:[17,70,27,16],clue:false,label:T('Study how the coat was left','Xem cách chiếc áo được để lại'),then:[N('In the constable’s sketch, the coat lies across the gorse with its lining protected from the thorns. Both sleeves hang together. It looks as though someone meant to return for it.','Trong phác họa của cảnh sát, áo nằm ngang bụi kim tước, lớp lót tránh được gai. Hai tay áo buông cùng phía. Cách đặt ấy trông như người để áo định quay lại lấy.'),S('me','It suggests a deliberate pause. It does not tell us why he stopped.','Nó gợi việc chủ động dừng lại. Chưa cho biết vì sao ông ấy dừng.')],again:[N('The sketch suggests a carefully placed coat, not one ripped away and flung aside. It cannot tell you why it was left there.','Phác họa gợi rằng áo được đặt cẩn thận, không phải bị giật ra rồi ném đi. Nó không cho biết vì sao áo được để lại đó.')]},{id:'exhibits',r:[43,70,28,10],inspectR:[17,65,63,20],clue:true,label:T('Read the scene inventory','Đọc danh mục hiện trường'),then:[N('The constable has set out the inventory on a clean board. Each object has its own number. Beside the red scarf is a short candle; beside that, a narrow instrument in a protective case.','Cảnh sát đặt danh mục lên tấm bảng sạch. Mỗi đồ vật có một số riêng. Cạnh khăn đỏ là mẩu nến ngắn; cạnh đó là dụng cụ mảnh trong hộp bảo vệ.'),S('reed','Not the tool I would choose to defend myself on a moor.','Không phải dụng cụ tôi sẽ chọn để tự vệ ngoài đồng hoang.'),S('me','Nor a reason to assume he came to defend himself. We need its ordinary use.','Cũng chưa phải lý do để cho rằng ông ấy đến đây nhằm tự vệ. Ta cần biết công dụng thường của nó.'),N('The numbered sketch places the coat on the gorse before the items were collected. You copy the arrangement, keeping the constable’s observations separate from your own.','Phác họa đánh số ghi áo nằm trên bụi kim tước trước khi đồ vật được thu gom. Bạn chép lại bố trí, giữ riêng điều cảnh sát quan sát với điều mình thấy.'),{item:'p3_site'}],again:[N('A candle, a fine instrument, a scarf. The inventory says where they were, not what Greaves intended.','Nến, dụng cụ mảnh, khăn. Danh mục nói chúng ở đâu, không nói Greaves định làm gì.')]}]}
 }}},
 nodes:{p3c2_open:[{title:{ch:2,en:'The Moor’s Two Trails',vi:'Hai dấu vết trên đồng hoang'}},{bg:'p3_moor'},{hide:'*'},{cp:'p3c2_start'},N('Late on Monday, the heather holds the last warmth of the afternoon. Beyond the stable wall, sound spreads differently: a gate closes behind you, then there is only wind and the complaint of a distant rook.','Chiều muộn thứ Hai, thạch nam còn giữ chút hơi ấm cuối ngày. Ngoài tường trại, âm thanh lan khác đi: cổng khép sau lưng, rồi chỉ còn gió và tiếng quạ kêu xa.'),{show:'reed',at:'l'},{if:s=>s.f.p3_first==='records',then:[S('reed','The office has been secured. Nobody can improve the accounts while we are out.','Văn phòng đã được giữ nguyên. Không ai có thể sửa cho sổ sách đẹp hơn trong lúc ta đi vắng.')],else:[S('reed','The constable has kept the sightseers on the road. Their theories arrived before we did.','Cảnh sát giữ người hiếu kỳ ở ngoài đường. Giả thuyết của họ đến trước cả ta.')]},N('A constable leads you to the edge of the cordon. The body has been removed. He points out the place where Greaves was found.','Một cảnh sát dẫn bạn đến mép dây giới hạn. Thi thể đã được chuyển đi. Anh chỉ chỗ Greaves được tìm thấy.'),{place:'p3c2_ground'},{bg:'p3_moor'},N('Beyond the hollow, the hoof marks vanish on stone and return at a shallow wet crossing. You wait for Reed to finish her drawing before taking a longer step over it.','Bên kia hõm, dấu móng mất trên đá rồi hiện lại ở chỗ nước nông. Bạn chờ Reed vẽ xong mới bước dài qua.'),N('A second set of marks approaches from the direction of Greybank: broad boots, one edge worn unevenly. At the crossing they turn. From there, horse and boots travel together towards the same stable.','Một hàng dấu khác từ phía Greybank tiến tới: giày rộng, một mép mòn không đều. Đến chỗ nước, chúng đổi hướng. Từ đó, dấu ngựa và giày cùng đi về trại ấy.'),S('reed','Someone came out, met the horse, and went back with it.','Có người đi ra, gặp ngựa, rồi cùng nó quay lại.'),S('me','That is the sequence in the ground we can see. The meeting comes after the horse leaves the hollow.','Đó là trình tự trên đoạn đất ta nhìn được. Cuộc gặp diễn ra sau khi ngựa rời hõm.'),{item:'p3_joining_tracks'},
 {reconstruct:{id:'p3_route_sequence',title:T('Follow the visible trail','Theo dấu vết nhìn thấy'),prompt:T('Place the three observed stages in order. Use the crossing, not a guess about the people.','Xếp ba chặng đã quan sát theo thứ tự. Dựa vào chỗ dấu vết giao nhau, không đoán về con người.'),cards:[{id:'joined',label:T('Horse and boots head towards Greybank','Ngựa và giày cùng đi về Greybank'),detail:T('The paired marks leave the wet crossing.','Hai hàng dấu rời chỗ nước.')},{id:'alone',label:T('The horse leaves the hollow alone','Ngựa rời hõm đất một mình'),detail:T('No accompanying boots in the continuous muddy patch.','Không có giày đi kèm trong đoạn bùn liền mạch.')},{id:'meeting',label:T('Boot marks approach and turn','Dấu giày tiến tới rồi đổi hướng'),detail:T('The boots come from Greybank and meet the hoof trail.','Dấu giày từ Greybank đến gặp dấu móng.')}],slots:[{id:'first',label:T('First visible stage','Chặng nhìn thấy đầu tiên'),accept:['alone']},{id:'second',label:T('At the crossing','Tại chỗ nước'),accept:['meeting']},{id:'third',label:T('Beyond the crossing','Sau chỗ nước'),accept:['joined']}],hint:[T('Begin at the hollow. Follow the direction of the hoof marks.','Bắt đầu ở hõm đất. Theo hướng dấu móng.'),T('The boots approach a horse that has already left the hollow.','Dấu giày tiến đến con ngựa đã rời khỏi hõm.'),T('Horse alone → boots join → horse and boots return together.','Ngựa đi một mình → dấu giày nhập vào → ngựa và giày cùng quay về.')],fail:T('Check where the two trails first meet. No evidence places these boots beside Greaves.','Xem lại chỗ hai dấu vết gặp nhau lần đầu. Chưa có bằng chứng đặt đôi giày này bên Greaves.'),ok:[{item:'p3_route'},{set:{p3_route_checked:true}}]}},
 {cp:'p3c2_route'},{bg:'p3_dorn_yard'},{show:'dorn',at:'r'},N('Greybank’s yard is smaller than Wycliffe’s, better swept. The wet trail ends at raked sand by the gate. Dorn stands beyond it in broad boots. A resemblance, still to be tested.','Sân Greybank nhỏ hơn sân Wycliffe, được quét kỹ hơn. Dấu ướt dừng ở dải cát đã cào bên cổng. Dorn đứng phía bên kia, đi giày rộng. Có nét giống, còn cần kiểm tra.'),S('dorn','Visitors use the road.','Khách đi đường lớn.','concerned'),S('me','The horse did not. We are following its route.','Con ngựa không đi đường lớn. Chúng tôi đang theo đường nó đi.'),N('Dorn looks past you towards the moor. The movement lasts only a second.','Dorn nhìn qua bạn về phía đồng hoang. Động tác chỉ kéo dài một giây.'),{choice:[C('Explain the tracks and ask him to preserve the yard.','Giải thích dấu vết và đề nghị giữ nguyên sân.',[{set:{p3_dorn_approach:'quiet'}},S('me','A horse came this way with a person. Please leave the sand as it is. We shall return with someone who can identify the animal.','Một con ngựa cùng người đi về phía này. Xin để nguyên cát. Chúng tôi sẽ trở lại với người nhận dạng được con vật.'),S('dorn','You have a very tidy way of asking to search my stable.','Ông khéo nói thật, đến chuyện xin khám chuồng cũng nghe đâu ra đấy.'),S('me','I have asked you to preserve a yard. I will make the next request separately.','Tôi đề nghị ông giữ nguyên sân. Yêu cầu tiếp theo tôi sẽ nêu sau.')]),C('Ask the constable to keep watch while you verify the evidence.','Nhờ cảnh sát trông chừng trong lúc bạn xác minh bằng chứng.',[{set:{p3_dorn_approach:'watched'}},S('me','I am not accusing you of a death. I am asking the constable to keep this gate in view until the trail is checked.','Tôi không buộc ông gây ra cái chết. Tôi đề nghị cảnh sát theo dõi cổng này cho đến khi dấu vết được kiểm tra.'),N('Dorn takes the distinction badly, but he hears it. A constable remains on the public path when you leave.','Dorn không vui với sự phân biệt ấy, nhưng đã nghe rõ. Một cảnh sát ở lại trên lối công cộng khi bạn đi.')])]},S('dorn','There is no horse of hers in my yard.','Trong sân tôi không có ngựa của bà ấy.'),N('He closes the gate on the word “yard”. The stable door behind him remains shut. Reed waits until you are beyond his hearing.','Ông đóng cổng ngay sau chữ “sân”. Cửa chuồng phía sau vẫn khép. Reed chờ đến khi hai người ra khỏi tầm nghe của ông.'),S('reed','That was an answer with a fence around it.','Câu trả lời ấy có hàng rào bao quanh.'),S('me','Then we shall attend to the part behind the fence. With evidence, and the proper person beside us.','Vậy ta sẽ chú ý phần sau hàng rào. Có bằng chứng, và người có thẩm quyền đi cùng.'),
 N('Returning, you find a shepherd lifting the cordon with his crook. He sees your face and stops. Has the stranger in the red scarf been caught? Quill has been questioned, you tell him. His face falls.', 'Trở về, bạn gặp người chăn cừu dùng gậy nâng dây giới hạn. Thấy mặt bạn, ông dừng lại. Người lạ đeo khăn đỏ đã bị bắt chưa? Bạn bảo Quill đã được hỏi chuyện. Mặt ông xịu xuống.'),S('reed','By the time we reach the village, you will have arrested somebody in the retelling.','Đến lúc ta tới làng, qua miệng người kể, anh đã bắt được ai đó rồi.'),S('me','Then walk slowly. Let the rumour arrive without us.','Vậy đi chậm thôi. Để lời đồn tới mà không có ta.'),N('Reed smiles and notes the shepherd’s question in the margin. Rumour already clings to that scarf. Far behind, Greybank’s gate is a thin grey bar across the field.','Reed mỉm cười, ghi câu hỏi của người chăn cừu vào lề. Lời đồn đã bám lấy chiếc khăn ấy. Xa phía sau, cổng Greybank thành vạch xám mảnh ngang cánh đồng.'),
 {bg:'p3_yard'},{hide:'*'},N('At Wycliffe’s gate, a messenger hands you the examining doctor’s note. His bicycle lamp is already lit. You read by it while Reed holds the page flat against the wind.','Tại cổng Wycliffe, người đưa tin trao ghi chú của bác sĩ khám nghiệm. Đèn xe đạp của anh đã sáng. Bạn đọc nhờ ánh đèn trong lúc Reed giữ phẳng giấy trước gió.'),{read:'p3_examination'},{item:'p3_head_report'},S('reed','A heavy impact, and a separate cut. Why was he down there with that instrument?','Một vết do va đập mạnh, thêm một vết cắt. Vì sao ông ấy lại xuống đó mang theo dụng cụ ấy?'),N('You fold the doctor’s note into the file’s second section. The horse’s route stays in the first. Still separate questions.','Bạn gấp ghi chú của bác sĩ vào mục thứ hai của hồ sơ. Đường đi của ngựa vẫn ở mục đầu. Vẫn là hai câu hỏi riêng.'),{end:'p3c2_end'}]},
 flow:[{ch:2,row:0,id:'p3c2_start',kind:'cp',label:T('Read the ground','Đọc dấu đất')},{ch:2,row:1,id:'p3c2_route',kind:'cp',label:T('Two stages of the trail','Hai chặng dấu vết')},{ch:2,row:2,id:'p3c2_end',kind:'end',label:T('A closed stable door','Cánh cửa chuồng khép kín')}],
 recap:[{ch:2,t:T('The horse left the hollow before another person joined its trail towards Greybank. The doctor records a heavy blunt injury with a curved outline, without identifying what struck Greaves.','Ngựa đã rời hõm trước khi một người khác nhập vào đường đi về Greybank. Bác sĩ ghi nhận vết thương do va đập mạnh bằng vật tày, có đường viền cong, chưa xác định vật gây thương tích cho Greaves.')}],
 endings:{p3c2_end:{ch:2,title:T('A Gate, Not an Answer','Một cánh cổng, chưa phải lời giải'),chapterClose:T('Monday evening · the route has two stages','Tối thứ Hai · đường đi có hai chặng'),nextObjective:T('Return to the stable accounts. Establish what Moss would normally notice.','Trở lại lời kể tại trại. Xác định điều Moss thường nhận ra.'),sum:T('The trail reaches Greybank after the hollow. Finding someone who hid a horse may not mean finding a murderer.','Dấu vết đến Greybank sau khi rời hõm. Tìm được người giấu ngựa có thể chưa phải tìm được kẻ giết người.'),text:T('Back at the yard, Moss has heard the gate.','Về đến sân, Moss đã nghe tiếng cổng.'),next:'p3c3_open',nextTitle:T('What the Dog Did Not Do','Điều con chó đã không làm')}}
});})();
/* Part III, chapter 3: absence needs a baseline and an observer. */
(()=>{'use strict';
const T=(en,vi)=>({en,vi}),N=(en,vi)=>({n:T(en,vi)}),S=(say,en,vi,face)=>({say,en,vi,...(face?{face}:{})}),C=(en,vi,then)=>({en,vi,silent:true,then});
const I=(kind,en,vi,a,b,who='',artAlias='paper')=>({icon:'doc',keep:true,kind,recordType:kind,chapter:3,name:T(en,vi),desc:T(a,b),brief:T(a,b),sourceLabel:T(who?'Account checked at the stable':'Vale · witnessed comparison',who?'Lời kể đã hỏi tại trại':'Vale · trực tiếp đối chiếu'),who,artAlias});
const chapter=d=>{const documents={"p3_quill_account": "p3_quill_statement"};for(const[id,docId]of Object.entries(documents)){const doc=d.docs?.[docId],it=d.items?.[id];if(doc&&it)it.document={title:doc.title,text:T(doc.lines.map(x=>x.en).join('\n\n'),doc.lines.map(x=>x.vi).join('\n\n'))};}for(const it of Object.values(d.items||{})){if(it.recordType==='document'&&!it.document)it.document={title:it.name,text:it.desc,note:T('Case record · written account','Hồ sơ vụ án · ghi chép bằng văn bản')};}StoryEngine.chapter(d);};
chapter({
items:{
p3_dog_baseline:I('observation','Moss’s ordinary reaction','Phản ứng thường của Moss','Moss barks at an unfamiliar messenger but settles when Ben approaches. Ben says Greaves was also familiar to the dog. This is a tendency, not an infallible test.','Moss sủa người đưa tin lạ nhưng bình tĩnh khi Ben đến gần. Ben nói Greaves cũng quen con chó. Đây là phản ứng thường gặp, không phải phép thử luôn đúng.'),
p3_night_silence:I('testimony','An awake dog, no alarm','Chó còn thức, không báo động','Nora was awake in the adjoining care room after one in the morning. She saw Moss look towards the stable and heard its outer door close, but heard no bark. She could not identify the person by the door.','Nora còn thức trong phòng chăm sóc sát bên sau một giờ sáng. Cô thấy Moss nhìn về chuồng, nghe cửa ngoài khép, nhưng không nghe sủa. Cô không nhận ra người bên cửa.','nora'),
p3_quill_account:I('document','Quill’s limited admission','Lời thừa nhận có giới hạn của Quill','Quill admits seeking inside racing information. He says he lost his scarf while running from Moss. An inn record supports his return before midnight; it does not account for all his later movements.','Quill thừa nhận tìm tin nội bộ cuộc đua. Ông nói mình làm mất khăn khi chạy khỏi Moss. Sổ quán trọ là căn cứ cho việc ông về trước nửa đêm, nhưng không cho biết ông đã làm gì trong toàn bộ thời gian sau đó.'),
p3_greaves_late:I('testimony','Greaves after midnight','Greaves sau nửa đêm','Nora says she saw Greaves leave his house carrying a lantern after the clock struck one. She did not follow him onto the moor.','Nora nói thấy Greaves rời nhà mang đèn sau khi đồng hồ điểm một giờ sáng. Cô không theo ông ra đồng hoang.','nora'),
p3_familiar:I('inference','A familiar visitor is possible','Có thể là người quen','The observed baseline and Nora’s account fit someone familiar entering the stable. They do not identify a person or exclude every other explanation.','Phản ứng thường đã quan sát và lời Nora phù hợp với khả năng người quen vào chuồng. Chúng không xác định một người, cũng không loại hết cách giải thích khác.'),
p3_record_corrected:I('document','A corrected first report','Báo cáo đầu đã sửa','Ben’s missing hours are recorded as an involuntary collapse, not proof of cooperation. The report separates the disappearance from the death.','Những giờ Ben không nhớ được ghi là cơn lịm đi ngoài ý muốn, không phải bằng chứng thông đồng. Báo cáo giữ riêng việc mất tích và cái chết.')},
docs:{p3_quill_statement:{paper:'letter',title:T('The constable’s summary: Miles Quill','Tóm tắt của cảnh sát: Miles Quill'),lines:[T('Quill admits offering money for private racing information. He says he lost his scarf while running from the dog and denies entering the stable.','Quill thừa nhận đưa tiền để lấy tin riêng về cuộc đua. Ông nói làm mất khăn khi chạy khỏi chó, phủ nhận việc vào chuồng.'),T('The innkeeper entered his return in the ledger before midnight. The record supports that arrival, not continuous observation of his room.','Chủ quán trọ ghi ông về trước nửa đêm vào sổ. Ghi chép này chỉ cho biết lần về đó, chứ không có nghĩa căn phòng được theo dõi liên tục.')]}},
places:{p3c3_yard_walk:{name:T('The yard, in daylight','Sân trại lúc ban ngày'),goal:T('Observe Moss with a stranger and ask Nora what she heard that night.','Quan sát Moss gặp người lạ và hỏi Nora đêm ấy cô nghe thấy gì.'),start:'yard',ring:['yard','stall'],need:s=>s.has('p3_dog_baseline')&&s.has('p3_night_silence'),progress:s=>[Number(s.has('p3_dog_baseline'))+Number(s.has('p3_night_silence')),2],leave:false,done:T('Compare the two reactions','Đối chiếu hai phản ứng'),views:{
yard:{img:'p3_yard',name:T('Moss’s corner','Góc của Moss'),zones:[{id:'dog',r:[41,52,17,10],inspectR:[36,46,30,18],clue:true,label:T('Watch the messenger enter','Quan sát người đưa tin đi vào'),then:[N('A new messenger opens the gate with his elbow, both hands full of letters. Moss gets up and barks twice. The young man stops so suddenly that the letters slide against his chin.','Một người đưa tin mới dùng khuỷu tay mở cổng, hai tay đầy thư. Moss đứng dậy sủa hai tiếng. Anh dừng đột ngột đến nỗi xấp thư trượt lên cằm.'),S('ben','Moss. Leave him his wages.','Moss. Để yên cho người ta kiếm sống.'),N('Ben takes the letters. Moss leans against his leg, then noses the empty hand. The unfamiliar visitor and familiar worker have received different welcomes.','Ben nhận thư. Moss tựa vào chân anh, rồi hích mũi vào bàn tay trống. Người khách lạ và người làm đã quen mặt được đón tiếp khác nhau.'),S('me','Would he know Greaves?','Nó có quen Greaves không?'),S('ben','Better than it knows me. Mr Greaves fed him first when he was a pup. He knows Lady Wycliffe and Nora too.','Còn quen hơn tôi. Ông Greaves là người đầu tiên cho nó ăn hồi còn bé. Nó cũng quen phu nhân Wycliffe và Nora.'),S('me','And strangers always make him bark?','Người lạ luôn khiến nó sủa à?'),S('ben','Usually. Not always. He is a dog, not the bell on the gate.','Thường là vậy. Không phải luôn. Nó là chó, không phải chuông cổng.'),{item:'p3_dog_baseline'}],again:[N('The contrast was visible. Its limits matter too: Moss does not bark at every stranger on every occasion.','Sự khác biệt đã nhìn thấy rõ. Giới hạn cũng quan trọng: Moss không sủa mọi người lạ trong mọi lần gặp.')]}],people:[{who:'nora',r:[63,30,29,65],talk:'p3c3_nora'}]},
stall:{img:'p3_stable',name:T('The stable passage','Lối đi trong chuồng'),zones:[{id:'hatch',r:[68,50,13,10],inspectR:[56,42,29,21],clue:false,label:T('Check how far the door can be heard','Kiểm tra tiếng cửa vọng đến đâu'),then:[N('With Nora back in the care room and the window open a little as it was that night, you close the stable’s outer door once. She raises a hand at the window: she heard it clearly.','Nora trở lại phòng chăm sóc, mở hé cửa sổ như đêm ấy. Bạn khép cửa ngoài của chuồng một lần. Cô giơ tay bên cửa sổ: cô nghe rõ.'),S('reed','The weather still belongs in the account.','Thời tiết vẫn phải được ghi trong lời kể.')],again:[N('From the care room, with the window partly open, the door can be heard. Wind still matters.','Trong phòng chăm sóc, khi cửa sổ mở hé, có thể nghe tiếng cửa chuồng. Gió vẫn có thể ảnh hưởng.')]}]}}}},
talks:{p3c3_nora:{with:'nora',hello:[N('Nora is brushing dried mud from her bag. She stops when you ask about Sunday night, but leaves the brush in her hand.','Nora đang chải bùn khô khỏi túi. Cô dừng khi bạn hỏi về tối Chủ nhật, nhưng vẫn cầm bàn chải.')],topics:[
{id:'position',label:T('Ask where she was and what she heard','Hỏi cô ở đâu và nghe thấy gì'),then:[S('nora','In the care room beside the yard. A pony was restless. The window was open a little after the rain eased.','Trong phòng chăm sóc cạnh sân. Một con ngựa nhỏ bồn chồn. Cửa sổ mở hé sau khi mưa bớt.'),S('me','Were you awake when the stable door closed?','Cô còn thức lúc cửa chuồng khép chứ?'),S('nora','Yes. The clock had struck one. I heard the latch and saw Moss lift his head towards the passage. He did not bark.','Có. Đồng hồ đã điểm một giờ. Tôi nghe chốt, thấy Moss ngẩng đầu về lối đi. Nó không sủa.'),S('me','Could you see who was there?','Cô thấy ai ở đó không?'),S('nora','Not a face. A light moved, then disappeared behind the doorpost. I ought to have looked again.','Không thấy mặt. Có ánh đèn di chuyển rồi khuất sau cột cửa. Lẽ ra tôi nên nhìn lại.','concerned'),S('me','You were looking after a sick animal. We need what you saw, not what you now feel you ought to have done.','Cô đang chăm con vật ốm. Ta cần biết cô đã thấy gì, không phải điều bây giờ cô nghĩ mình lẽ ra nên làm.'),{item:'p3_night_silence'}]},
{id:'greaves',label:T('Ask whether she saw Greaves himself','Hỏi cô có thấy chính Greaves không'),then:[S('nora','Earlier, a little after one, outside his own door. He had a lantern. He pulled the door to rather than slamming it.','Trước đó, sau một giờ sáng một lúc, ngoài cửa nhà ông ấy. Ông mang đèn. Ông kéo cửa khép lại thay vì đóng mạnh.'),S('me','Did you see where he went?','Cô thấy ông đi đâu không?'),S('nora','Towards the stable. I turned back to the pony before he reached it. That is the last time I saw him alive.','Về phía chuồng. Tôi quay lại con ngựa nhỏ trước khi ông tới nơi. Đó là lần cuối tôi thấy ông còn sống.'),{item:'p3_greaves_late'}]},
{id:'welfare',label:T('Ask about the other animals','Hỏi những con vật khác'),then:[S('nora','The pony will recover. Three sheep in the paddock are lame. Greaves said he had dealt with it, but I have asked the surgeon to examine them this afternoon.','Con ngựa nhỏ sẽ khỏe lại. Ba con cừu ngoài bãi khập khiễng. Greaves nói đã xử lý, nhưng tôi đã nhờ bác sĩ thú y khám cho chúng chiều nay.'),N('You ask her to keep the notes. You do not make her abandon the animals to fetch them immediately.','Bạn nhờ cô giữ ghi chép. Bạn không bắt cô bỏ đàn vật nuôi để đi lấy ngay.')]}],bye:[N('She puts the brush away. Its little cloud of dust hangs in the light after her hand has stopped.','Cô cất bàn chải. Đám bụi nhỏ vẫn lơ lửng trong ánh sáng sau khi tay cô đã dừng.')]}}
,nodes:{p3c3_open:[{title:{ch:3,en:'What the Dog Did Not Do',vi:'Điều con chó đã không làm'}},{bg:'p3_yard'},{hide:'*'},{cp:'p3c3_start'},N('Tuesday morning brings dry flags in the yard and no horse in the stall. Moss sleeps with one ear folded inside out. Reed holds a bowl of tea which Ben has apologised for three times.','Sáng thứ Ba, những phiến đá sân đã khô, chuồng vẫn không có ngựa. Moss ngủ, một tai gập ngược. Reed cầm bát trà mà Ben đã xin lỗi đến ba lần.'),{show:'reed',at:'l'},S('reed','The cups are holding things the constable wishes to keep. I would rather drink from this than from a clue.','Cốc đang đựng những thứ cảnh sát muốn giữ. Tôi thà uống bằng bát này còn hơn uống từ một manh mối.'),N('The constable has left a record of Quill’s interview. Quill admits trying to buy inside information. A worse reputation, still no witnessed crime.','Viên cảnh sát để lại biên bản hỏi Quill. Quill thừa nhận tìm mua tin nội bộ. Danh tiếng xấu thêm, vẫn chưa có tội ác nào được chứng kiến.'),{read:'p3_quill_statement'},{item:'p3_quill_account'},S('me','The scarf needs an explanation. It cannot provide its own.','Chiếc khăn cần được giải thích. Nó không tự giải thích được.'),{place:'p3c3_yard_walk'},
{if:s=>!s.has('p3_greaves_late'),then:[S('nora','One other thing. I saw Greaves leave his house with a lantern after one. I looked back to the pony before he reached the stable.','Còn một việc. Tôi thấy Greaves rời nhà mang đèn sau một giờ sáng. Tôi quay lại con ngựa nhỏ trước khi ông tới chuồng.'),{item:'p3_greaves_late'}]},
{caseboard:{q:T('What can the dog’s reaction add to the account?','Phản ứng của con chó bổ sung được gì vào lời kể?'),cards:['p3_dog_baseline','p3_night_silence','p3_quill_account','p3_meal'],focus:{recent:['p3_dog_baseline','p3_night_silence','p3_quill_account'],case:['p3_dog_baseline','p3_night_silence'],question:['p3_dog_baseline','p3_night_silence']},need:1,links:[{a:'p3_dog_baseline',b:'p3_night_silence',label:T('An awake dog that usually challenges strangers gave no alarm. A familiar visitor fits, but is not uniquely identified.','Con chó còn thức, thường báo người lạ, lại không sủa. Khả năng người quen phù hợp, nhưng chưa xác định duy nhất một người.'),set:{p3_dog_link:true}}],hint:T('Connect the usual reaction with the witnessed reaction that night.','Nối phản ứng thường ngày với phản ứng được chứng kiến đêm đó.'),fail:[S('reed','The dog question needs its normal behaviour and a witness close enough to notice.','Câu hỏi về chó cần phản ứng thường ngày và người chứng kiến đủ gần để nhận ra.')],ok:[{item:'p3_familiar'}]}},
N('Before you enter the office, Ben asks whether Moss is in trouble. He says it awkwardly, as if he knows a grown man ought to have a larger question.','Trước khi bạn vào văn phòng, Ben hỏi Moss có bị trách phạt không. Anh hỏi ngập ngừng, như biết người lớn nên đặt câu hỏi to tát hơn.'),S('me','For behaving like a dog? No.','Vì xử sự như một con chó à? Không.'),S('ben','Mr Greaves used to say that a quiet animal was a well-trained animal.','Ông Greaves từng nói con vật yên tiếng là con vật được dạy tốt.'),S('me','Sometimes it is. Sometimes it simply knows the person at the door. That is not the animal’s fault.','Đôi lúc đúng. Đôi lúc nó chỉ quen người ở cửa. Đó không phải lỗi của con vật.'),N('Ben bends to untwist the dog’s collar. Moss submits with the patient look of a creature who has been discussed all morning and would prefer lunch.','Ben cúi xuống sửa dây cổ chó bị xoắn. Moss ngoan ngoãn chịu, mang vẻ kiên nhẫn của con vật bị bàn tán suốt sáng và muốn được ăn trưa hơn.'),
{bg:'p3_office'},{hide:'*'},{show:'elin',at:'r'},N('Lady Wycliffe has put the press inquiries in one pile and the letters to Greaves’s widow in another. She moves a sporting newspaper off a chair before inviting you to sit.','Phu nhân Wycliffe xếp thư báo chí hỏi tin thành một chồng, thư gửi góa phụ Greaves thành chồng khác. Bà nhấc tờ báo thể thao khỏi ghế rồi mời bạn ngồi.'),S('elin','The paper has decided that Larkin slept while an accomplice took the horse. Can you contradict it?','Báo đã quyết định Larkin ngủ trong lúc đồng bọn lấy ngựa. Ông bác được không?'),S('me','I can correct what the evidence contradicts. I cannot certify every action he ever took.','Tôi có thể sửa điều trái với bằng chứng. Tôi không thể chứng nhận mọi việc anh ấy từng làm.'),
{present:{title:T('The first report','Báo cáo đầu'),goal:T('Replace the unsupported claim with the doctor’s finding. Then sign the corrected account.','Thay nhận định thiếu căn cứ bằng kết quả của bác sĩ. Sau đó ký bản đã sửa.'),segs:[{t:T('Ember Star’s whereabouts are not yet confirmed.','Chưa xác nhận Ember Star đang ở đâu.'),bad:false},{t:T('Larkin chose to sleep through his watch, helping the horse’s removal.','Larkin cố ý ngủ trong ca trực, tiếp tay đưa ngựa đi.'),bad:true,evidence:'p3_meal',fix:T('Larkin collapsed after a sedating substance was added to his supper; the responsible person is unconfirmed.','Larkin lịm đi sau khi bữa tối bị cho chất gây buồn ngủ; chưa xác định người gây ra việc đó.'),ok:[N('The new sentence takes more room. Lady Wycliffe moves the newspaper farther from the report.','Câu mới dài hơn. Phu nhân Wycliffe đẩy tờ báo xa bản báo cáo thêm chút nữa.')]},{t:T('The horse trail leads towards Greybank after leaving the hollow.','Dấu ngựa đi về Greybank sau khi rời hõm đất.'),bad:false}],sign:T('Sign the corrected report','Ký báo cáo đã sửa'),wrong:[S('reed','That sentence can stand. The claim about Ben’s deliberate choice cannot.','Câu ấy có thể giữ. Nhận định Ben cố ý chọn ngủ thì không.')],noEvidence:[S('reed','Use the finding about the supper and his condition.','Dùng kết quả về bữa tối và tình trạng của anh ấy.')]}},{item:'p3_record_corrected'},{cp:'p3c3_report'},
S('elin','And Dorn? His horse stands to gain if mine does not run.','Còn Dorn? Ngựa của ông ta có lợi nếu ngựa tôi không chạy.'),{choice:[C('Keep the public statement to the trail and the search.','Chỉ công bố dấu vết và việc tìm kiếm.',[{set:{p3_public_claim:'limited'}},S('me','His interest warrants inquiry. The tracks show a later meeting near his stable, not his presence where Greaves died.','Lợi ích ấy là lý do để tìm hiểu thêm. Dấu vết cho thấy cuộc gặp về sau gần trại ông ấy, chưa cho thấy ông ấy ở nơi Greaves chết.')]),C('Name Dorn as the suspected killer as well as the horse thief.','Nêu Dorn là người bị nghi giết người lẫn lấy ngựa.',[{set:{p3_public_claim:'accuse'}},S('me','I suspect Dorn took the horse and killed Greaves. You may say that I am pursuing him.','Tôi nghi Dorn lấy ngựa và giết Greaves. Bà có thể nói tôi đang theo hướng đó.'),S('reed','Then the record must also say our trail reaches him after the horse leaves the hollow.','Vậy hồ sơ cũng phải ghi dấu vết dẫn tới ông ấy sau khi con ngựa rời hõm.'),N('She writes the limitation beneath your statement. Lady Wycliffe reads both lines before setting it aside.','Cô ghi giới hạn dưới phát biểu của bạn. Phu nhân Wycliffe đọc cả hai dòng rồi đặt sang bên.')])]},
N('Outside, Ben is cleaning the unused bridle. You hand him the corrected copy. He reads the sentence about the supper twice, lips moving on the second reading.','Ngoài kia, Ben đang lau bộ dây cương chưa dùng. Bạn đưa anh bản đính chính. Anh đọc câu về bữa tối hai lần, môi mấp máy ở lần thứ hai.'),S('ben','Can my mother have this one?','Tôi gửi bản này cho mẹ được không?'),S('me','This one is yours.','Bản này là của anh.'),N('Ben folds the paper, careful not to get grease on it. Behind him, the stall is still empty. One false accusation has gone.','Ben cẩn thận gấp giấy, tránh làm dính dầu mỡ. Sau lưng anh, chuồng vẫn trống. Một lời buộc tội sai đã được gỡ bỏ.'),{end:'p3c3_end'}]},
flow:[{ch:3,row:0,id:'p3c3_start',kind:'cp',label:T('An ordinary reaction','Phản ứng thường ngày')},{ch:3,row:1,id:'p3c3_report',kind:'cp',label:T('A corrected report','Báo cáo đã sửa')},{ch:3,row:2,id:'p3c3_end',kind:'end',label:T('Room for another explanation','Chỗ cho lời giải thích khác')}],
recap:[{ch:3,t:T('Moss’s silence fits a familiar visitor but names no one. Greaves was seen with a lantern. You corrected the unsupported allegation against Ben.','Sự im lặng của Moss phù hợp với người quen nhưng không nêu tên ai. Greaves được thấy mang đèn. Bạn sửa lời buộc tội thiếu căn cứ nhằm vào Ben.')}],
endings:{p3c3_end:{ch:3,title:T('A Quiet Yard','Sân trại yên tiếng'),chapterClose:T('Tuesday morning · the first report corrected','Sáng thứ Ba · đã sửa báo cáo đầu'),nextObjective:T('Examine Greaves’s papers and ask Nora about the instrument and lame sheep.','Xem giấy tờ của Greaves, hỏi Nora về dụng cụ và những con cừu khập khiễng.'),sum:T('The dog’s silence changes the possibilities. It does not appoint a culprit.','Sự im lặng của con chó thay đổi những khả năng cần xem xét. Nó không chỉ định thủ phạm.'),text:T('The private papers are ready to be read.','Giấy tờ riêng đã sẵn để xem.'),next:'p3c4_open',nextTitle:T('The Trainer’s Other Life','Cuộc đời khác của người huấn luyện')}}
});})();
/* Part III, chapter 4: a private debt is a motive; a plan needs separate evidence. */
(()=>{'use strict';
const T=(en,vi)=>({en,vi}),N=(en,vi)=>({n:T(en,vi)}),S=(say,en,vi,face)=>({say,en,vi,...(face?{face}:{})}),C=(en,vi,then)=>({en,vi,silent:true,then});
const I=(kind,en,vi,a,b,who='',artAlias='paper')=>({icon:'doc',keep:true,kind,recordType:kind,chapter:4,name:T(en,vi),desc:T(a,b),brief:T(a,b),sourceLabel:T(who?'Nora · report and care records':'Vale and Reed · documents examined',who?'Nora · báo cáo và sổ chăm sóc':'Vale và Reed · đã xem giấy tờ'),who,artAlias});
const billLines=[T('Draper’s bill · A. Denham — account carried forward. Balance outstanding: forty-three pounds. Payment requested before Wednesday.','Hóa đơn cửa hàng vải · A. Denham — khoản nợ chuyển sang kỳ này. Số tiền còn thiếu: bốn mươi ba bảng. Đề nghị trả trước thứ Tư.'),T('Delivery instruction on the reverse: leave with Thomas Greaves, Wycliffe stable.','Chỉ dẫn giao hàng ở mặt sau: giao cho Thomas Greaves, trại Wycliffe.')];
const ledgerLines=[T('E.S. unable to start — private settlement due after declaration.','E.S. không thể xuất phát — thanh toán riêng sau khi công bố.'),T('Handwriting comparison: the joined letters in “start” match Greaves’s routine training entries. No payer or agreed sum is recorded on this page.','Đối chiếu chữ viết: các nét nối trong chữ “start” khớp ghi chép huấn luyện thường ngày của Greaves. Trang này không ghi người trả hay số tiền đã thỏa thuận.')];
const chapter=d=>{const documents={"p3_bill": "p3_bill_doc", "p3_private_ledger": "p3_ledger_doc", "p3_flock": "p3_flock_doc"};for(const[id,docId]of Object.entries(documents)){const doc=d.docs?.[docId],it=d.items?.[id];if(doc&&it)it.document={title:doc.title,text:T(doc.lines.map(x=>x.en).join('\n\n'),doc.lines.map(x=>x.vi).join('\n\n'))};}for(const it of Object.values(d.items||{})){if(it.recordType==='document'&&!it.document)it.document={title:it.name,text:it.desc,note:T('Case record · written account','Hồ sơ vụ án · ghi chép bằng văn bản')};}StoryEngine.chapter(d);};
chapter({
items:{
p3_bill:{...I('document','A bill under another name','Hóa đơn mang tên khác','A large unpaid draper’s account uses A. Denham, but its delivery instruction names Thomas Greaves at Wycliffe. Confirmation from the shop is still pending.','Khoản nợ lớn chưa trả ở cửa hàng vải mang tên A. Denham, nhưng chỉ dẫn giao hàng ghi Thomas Greaves tại Wycliffe. Vẫn đang chờ cửa hàng xác nhận.'),document:{title:T('The outstanding account','Khoản tiền còn nợ'),text:T(billLines.map(x=>x.en).join('\n\n'),billLines.map(x=>x.vi).join('\n\n')),note:T('Read the reverse as well as the printed name.','Đọc mặt sau cùng với tên in ở mặt trước.')}},
p3_private_ledger:{...I('document','An entry about not starting','Dòng ghi về việc không xuất phát','Greaves’s private ledger anticipates a settlement if E.S. cannot start. His handwriting is checked against ordinary training entries. The entry does not name the other party.','Sổ riêng của Greaves dự tính khoản thanh toán nếu E.S. không thể xuất phát. Chữ được đối chiếu với ghi chép huấn luyện thường ngày. Dòng ghi không nêu bên còn lại.'),document:{title:T('A private ledger entry','Dòng trong sổ riêng'),text:T(ledgerLines.map(x=>x.en).join('\n\n'),ledgerLines.map(x=>x.vi).join('\n\n'))}},
p3_instrument:I('observation','An instrument for precise work','Dụng cụ cho việc cần độ chính xác','Nora identifies the recovered instrument as a fine surgical blade. It is ill-suited to defending against an attacker and was not needed for an ordinary night check.','Nora nhận ra dụng cụ thu được là lưỡi dao phẫu thuật mảnh. Nó không phù hợp để chống người tấn công và không cần cho lần kiểm tra đêm thông thường.','nora','p3_instrument'),
p3_flock:I('document','The surgeon’s report on the sheep','Báo cáo thú y về đàn cừu','The surgeon records similar small injuries on three sheep, unlike ordinary fence abrasions. The care book places them under Greaves’s sole charge when the trouble began. The report does not establish his intention; the sheep are being treated.','Bác sĩ thú y ghi nhận ba con cừu có những vết thương nhỏ tương tự, không giống vết trầy thông thường do hàng rào. Sổ chăm sóc ghi chúng do riêng Greaves phụ trách khi vấn đề bắt đầu. Báo cáo chưa xác định ý định của ông; đàn cừu đang được điều trị.','nora'),
p3_plan:I('inference','A plan against the horse','Kế hoạch nhằm vào con ngựa','The private ledger, financial pressure and prepared instrument support a plan to prevent Ember Star from racing. The sheep report supports preparation; no single item proves the whole plan.','Sổ riêng, sức ép tiền bạc và dụng cụ mang sẵn ủng hộ kế hoạch ngăn Ember Star đua. Báo cáo đàn cừu ủng hộ việc chuẩn bị; không món nào riêng lẻ chứng minh cả kế hoạch.'),
p3_cause:I('inference','A likely fatal reaction','Phản ứng có thể gây chết người','The accounts and familiar access support Greaves taking the horse onto the moor. His equipment, the hoof marks and the medical finding support a fatal kick when the horse reacted. The precise final seconds were unwitnessed.','Lời kể và việc ra vào quen thuộc ủng hộ khả năng Greaves đưa ngựa ra đồng hoang. Dụng cụ, dấu móng và kết quả khám nghiệm ủng hộ việc ông bị đá chết khi ngựa phản ứng. Không ai chứng kiến chính xác những giây cuối.')},
docs:{p3_bill_doc:{paper:'letter',title:T('The outstanding account · both sides','Khoản tiền còn nợ · hai mặt'),lines:billLines},p3_ledger_doc:{paper:'letter',title:T('A page from the private ledger','Trang sổ riêng'),lines:ledgerLines},p3_flock_doc:{paper:'letter',title:T('The veterinary surgeon’s note','Ghi chú của bác sĩ thú y'),lines:[T('Three sheep have similar small injuries which do not resemble ordinary abrasions from the paddock fence. Their condition is being treated.','Ba con cừu có vết thương nhỏ tương tự, không giống vết trầy thông thường do hàng rào bãi chăn. Chúng đang được điều trị.'),T('The care register places these animals under Greaves alone during the period in which the trouble began. I cannot state his intention from the injuries alone.','Sổ chăm sóc ghi các con vật này do riêng Greaves phụ trách trong thời gian vấn đề bắt đầu. Chỉ từ vết thương, tôi không thể nói ông định làm gì.')]}},
nodes:{p3c4_open:[{title:{ch:4,en:'The Trainer’s Other Life',vi:'Cuộc đời khác của người huấn luyện'}},{bg:'p3_office'},{hide:'*'},{cp:'p3c4_start'},N('Tuesday afternoon. The office smells of paper, saddle soap and a lunch nobody finished. Greaves’s widow has given the constable permission to examine his work papers. Her own letters remain tied in a separate bundle.','Chiều thứ Ba. Văn phòng có mùi giấy, xà phòng lau yên và bữa trưa chưa ai ăn hết. Góa phụ Greaves đã cho cảnh sát xem giấy tờ công việc của chồng. Thư riêng của bà vẫn buộc thành gói khác.'),{show:'reed',at:'l'},S('reed','We do not need to read her grief to understand his accounts.','Ta không cần đọc nỗi đau của bà ấy để hiểu sổ sách của ông.'),N('You put the bundle aside without loosening its string. Under the training book is a folded bill. A different name is printed at the top; familiar instructions are written on the back.','Bạn đặt gói sang bên, không nới dây. Dưới sổ huấn luyện là hóa đơn gấp lại. Đầu tờ in tên khác; phía sau có chỉ dẫn quen thuộc.'),
{explore:{goal:T('Read both sides of the bill and the relevant private ledger entry.','Đọc hai mặt hóa đơn và dòng liên quan trong sổ riêng.'),need:2,done:T('Ask Nora about the recovered instrument','Hỏi Nora về dụng cụ thu được'),spots:[
{id:'bill',x:82,y:60,r:[67,55,30,11],inspectR:[62,51,38,19],clue:true,label:T('Turn over the folded bill','Lật hóa đơn gấp lại'),then:[{read:'p3_bill_doc'},N('Reed lays a blank card beneath the amount. You can compare it with the staff book’s monthly wage without listing private purchases in the public report.','Reed đặt thẻ trắng dưới số tiền. Bạn có thể so với một tháng lương trong sổ nhân viên mà không liệt kê các món mua riêng trong báo cáo công khai.'),S('reed','Enough to trouble a salary. Not enough, by itself, to accuse a man of anything.','Đủ khiến người sống bằng lương lo lắng. Riêng nó chưa đủ buộc tội ai.'),{item:'p3_bill'}],again:[{read:'p3_bill_doc'}]},
{id:'ledger',x:26,y:58,r:[7,53,39,12],inspectR:[0,49,56,19],clue:true,label:T('Compare the ledger handwriting','So chữ trong sổ'),then:[{read:'p3_ledger_doc'},N('Reed checks the word “start” against the training book, then notes the matching joins. Lady Wycliffe identifies the private ledger as the one Greaves kept in the locked drawer.','Reed đối chiếu chữ “start” với sổ huấn luyện, rồi ghi lại những nét nối khớp nhau. Phu nhân Wycliffe nhận ra sổ riêng này là cuốn Greaves giữ trong ngăn khóa.'),S('me','A possible payment if the horse he trains cannot start. That connects the financial pressure to the race.','Có thể được trả tiền nếu con ngựa ông huấn luyện không thể xuất phát. Như vậy sức ép tiền bạc đã gắn với cuộc đua.'),{item:'p3_private_ledger'}],again:[{read:'p3_ledger_doc'}]},
{id:'letters',x:60,y:65,r:[45,61,30,9],inspectR:[39,58,42,17],clue:false,label:T('Leave the family letters tied','Giữ nguyên gói thư gia đình'),then:[N('You check the string is still tied. The relevant papers already lie on the table. Privacy alone is no reason to open this bundle.','Bạn kiểm tra dây vẫn buộc. Giấy tờ liên quan đã ở trên bàn. Sự riêng tư không phải lý do để mở gói này.')],again:[N('The bundle remains closed.','Gói thư vẫn khép.')]}]}},
{bg:'p3_yard'},{hide:'*'},{show:'nora',at:'r'},N('Nora meets you beside the wash trough. The recovered instrument remains in its case; she asks you to keep it there while she reads the label.','Nora gặp bạn cạnh máng rửa. Dụng cụ thu được vẫn trong hộp; cô đề nghị bạn cứ để nguyên trong lúc cô đọc nhãn.'),S('nora','Fine surgery. No defence against a stick, and no use for checking whether a horse has water.','Dùng cho phẫu thuật tinh vi. Không chống được gậy, cũng chẳng cần để kiểm tra ngựa còn nước hay không.'),S('me','Could there have been an innocent reason to bring it?','Có thể có lý do vô hại để mang nó không?'),S('nora','There could. The question is whether it fits the rest. I was not asked to treat Ember Star that night.','Có thể. Câu hỏi là lý do ấy có khớp những điều còn lại không. Đêm đó tôi không được yêu cầu chữa cho Ember Star.'),{item:'p3_instrument'},N('She hands you a second note. There is dried grass caught under the clip. The surgeon has finished examining the sheep.','Cô đưa tờ ghi chú thứ hai. Cỏ khô mắc dưới kẹp. Bác sĩ thú y đã khám xong đàn cừu.'),{read:'p3_flock_doc'},{item:'p3_flock'},S('nora','I have put them in the sheltered pen. Whatever you decide to call this, they still need feeding.','Tôi đã đưa chúng vào ô có mái che. Dù ông gọi chuyện này là gì, chúng vẫn cần được cho ăn.','concerned'),N('You wait while Nora washes her hands. Reed lays the copied accounts beside the surgeon’s note, leaving space for your conclusions.','Bạn chờ Nora rửa tay. Reed đặt bản chép sổ sách cạnh ghi chú của bác sĩ thú y, chừa chỗ cho những kết luận của bạn.'),
{caseboard:{q:T('Which records support a plan, and which supply only pressure?','Hồ sơ nào ủng hộ một kế hoạch, hồ sơ nào chỉ cho thấy sức ép?'),cards:['p3_bill','p3_flock','p3_head_report','p3_quill_account','p3_instrument','p3_private_ledger'],focus:{recent:['p3_bill','p3_private_ledger','p3_instrument','p3_flock','p3_head_report'],case:['p3_bill','p3_private_ledger','p3_instrument','p3_flock'],question:['p3_bill','p3_private_ledger','p3_instrument','p3_flock']},need:2,links:[{a:'p3_bill',b:'p3_private_ledger',label:T('Debt gives pressure; the private entry connects expected payment to Ember Star not starting.','Nợ tạo sức ép; dòng sổ riêng nối khoản tiền dự tính với việc Ember Star không xuất phát.'),set:{p3_finance_link:true}},{a:'p3_instrument',b:'p3_flock',label:T('The carried instrument and similar injuries support deliberate preparation, alongside the care record.','Dụng cụ mang theo và các vết thương tương tự, cùng sổ chăm sóc, ủng hộ việc chuẩn bị có chủ ý.'),set:{p3_preparation_link:true}}],hint:T('Make one link about money and the race. Make another about the tool and the independent care report.','Tạo một liên hệ về tiền và cuộc đua. Tạo liên hệ khác giữa dụng cụ và báo cáo chăm sóc độc lập.'),fail:[S('reed','The scarf does not explain these papers. Keep the money question separate from the preparation question.','Chiếc khăn không giải thích các giấy tờ này. Giữ câu hỏi tiền bạc riêng với câu hỏi chuẩn bị.')],ok:[{item:'p3_plan'}]}},
{choice:[C('Ask Nora what can be done for the animals now.','Hỏi Nora bây giờ có thể làm gì cho các con vật.',[S('me','Before we return to the papers: what do you need?','Trước khi quay lại giấy tờ: cô cần gì?'),S('nora','A clean pen, time, and somebody who will write down a problem when it is small. We have the first two.','Một ô chuồng sạch, thời gian, và người chịu ghi lại vấn đề từ khi nó còn nhỏ. Hai thứ đầu đã có.'),N('You ask the constable to return the care book as soon as he copies it. Nora needs those records to treat the animals.','Bạn nhờ viên cảnh sát trả sổ chăm sóc ngay khi chép xong. Nora cần những ghi chép ấy để chữa cho các con vật.'),{set:{p3_aftercare:'records'}}]),C('Ask whether anyone raised the problem before the disappearance.','Hỏi trước lúc mất ngựa có ai báo vấn đề chưa.',[S('nora','I wrote “not improving” in the book on Friday. Greaves drew a line through it and wrote “attended to”. I let the ink settle the argument.','Tôi ghi “không đỡ” trong sổ hôm thứ Sáu. Greaves gạch đi, viết “đã xử lý”. Tôi để mực kết thúc cuộc tranh luận.'),S('me','Did you agree with him?','Cô có đồng ý với ông ấy không?'),S('nora','I agreed that he was my employer’s trainer and I was the assistant. That was the mistake.','Tôi chấp nhận rằng ông ấy là người huấn luyện của chủ tôi, còn tôi chỉ là trợ lý. Đó mới là sai lầm.'),N('You ask her to preserve both entries. A correction should not make the earlier warning disappear.','Bạn nhờ cô giữ cả hai dòng. Một lời sửa không nên khiến cảnh báo trước đó biến mất.'),{set:{p3_aftercare:'warning'}}])]},
N('A cart of fresh straw reaches the far gate. Nora raises a hand. Seeing the instrument case, the driver stops his question. She directs him where to unload; work resumes.','Xe chở rơm mới tới cổng xa. Nora giơ tay. Thấy hộp dụng cụ, người đánh xe thôi hỏi. Cô chỉ chỗ dỡ rơm; công việc tiếp tục.'),S('reed','We shall need a copy of the surgeon’s report for Mrs Greaves as well. She should not learn it first from a headline.','Ta cũng cần bản sao báo cáo thú y cho bà Greaves. Bà ấy không nên biết lần đầu qua tiêu đề báo.'),N('You ask Lady Wycliffe to arrange that conversation privately. It will not make the finding gentler. It may at least stop it arriving as a stranger’s entertainment.','Bạn nhờ phu nhân Wycliffe thu xếp nói riêng chuyện ấy. Việc đó không khiến kết quả bớt đau. Ít nhất nó có thể tránh để tin đến như chuyện mua vui của người ngoài.'),
{bg:'p3_office'},{hide:'*'},{show:'elin',at:'r'},N('Lady Wycliffe reads the copied entry without sitting. Outside the window a groom pours clean water into the same bucket you saw yesterday. The small ordinary sound continues through her silence.','Phu nhân Wycliffe đứng đọc dòng chép lại. Ngoài cửa sổ, người chăm ngựa đổ nước sạch vào chiếc xô bạn thấy hôm qua. Âm thanh nhỏ thường ngày tiếp tục trong lúc bà im lặng.'),S('elin','He taught that horse to trust him.','Ông ấy dạy con ngựa tin mình.','concerned'),S('me','That may be how he led it out quietly. The papers and instrument point to a plan to stop it racing. The curved injury and hoof marks suggest how that plan could have ended.','Đó có thể là cách ông dẫn nó ra êm thấm. Giấy tờ và dụng cụ hướng đến kế hoạch ngăn nó đua. Vết thương có đường viền cong cùng dấu móng gợi ra cách kế hoạch ấy có thể đã kết thúc.'),S('elin','You think the horse struck him.','Ông nghĩ con ngựa đá ông ấy.'),S('me','A sudden reaction fits the injury and ground. His exact last movement remains unknown.','Phản ứng bất ngờ phù hợp với vết thương và dấu đất. Động tác cuối chính xác của ông vẫn chưa rõ.'),{item:'p3_cause'},{cp:'p3c4_findings'},N('The shop can confirm the alias by tomorrow morning. Reed offers to send the inquiry now. The constable is ready to go to Greybank once you decide what takes priority.','Cửa hàng có thể xác nhận tên khác vào sáng mai. Reed đề nghị gửi yêu cầu ngay. Cảnh sát sẵn sàng đến Greybank khi bạn quyết định việc ưu tiên.'),S('reed','Registration closes tomorrow morning. If you visit the shopkeeper before Dorn, we miss it. I can get written confirmation while you recover the horse.','Sáng mai hết hạn đăng ký. Nếu anh gặp chủ cửa hàng trước Dorn, ta sẽ lỡ hạn. Tôi có thể lấy xác nhận bằng văn bản trong lúc anh tìm lại ngựa.'),
{choice:[C('Visit Dorn with Nora; let Reed obtain the written confirmation.','Đến Dorn cùng Nora; để Reed lấy xác nhận bằng văn bản.',[{set:{p3_priority:'both'}},S('me','Two tasks, two people. I have occasionally found that arrangement useful.','Hai việc, hai người. Thỉnh thoảng tôi thấy cách ấy hữu ích.'),S('reed','I shall remember you said so.','Tôi sẽ nhớ lời anh nói.')]),C('Verify the shop account in person first, accepting that the race deadline will be missed.','Đích thân xác minh khoản nợ ở cửa hàng trước, chấp nhận lỡ hạn cuộc đua.',[{set:{p3_priority:'explanation'}},S('me','I want the account checked in person. Ask the constable to keep Greybank’s gate under observation. We accept the missed deadline.','Tôi muốn trực tiếp kiểm tra khoản nợ ở cửa hàng. Nhờ cảnh sát tiếp tục theo dõi cổng Greybank. Ta chấp nhận lỡ hạn.'),S('elin','I would have preferred the other order. But you have told me the cost before spending it.','Tôi muốn thứ tự khác hơn. Nhưng ông đã nói cái giá trước khi bắt tôi trả.')]),C('Prioritise recovery; leave the cause of death open for a further inquiry.','Ưu tiên tìm lại ngựa; để nguyên nhân cái chết cho cuộc điều tra tiếp.',[{set:{p3_priority:'recovery'}},S('me','Recover the horse first. I will submit the evidence on the death without signing a final explanation yet.','Tìm lại ngựa trước. Tôi sẽ nộp bằng chứng về cái chết, chưa ký lời giải thích cuối.'),S('elin','Then label the unfinished part honestly.','Vậy hãy ghi rõ phần chưa xong.')])]},
N('Reed copies your decision on a separate page. She leaves a space beneath it for the return time and puts the addressed inquiry beside the lamp.','Reed chép quyết định lên trang riêng. Cô để chỗ trống bên dưới cho giờ trở lại, đặt thư hỏi đã ghi địa chỉ cạnh đèn.'),N('As you leave, Lady Wycliffe returns the family letters to the drawer. The training book stays on the desk. Neither part of his life erased.','Khi bạn ra ngoài, phu nhân Wycliffe cất thư gia đình lại vào ngăn kéo. Sổ huấn luyện vẫn trên bàn. Không phần nào trong đời ông bị xóa bỏ.'),{end:'p3c4_end'}]},
flow:[{ch:4,row:0,id:'p3c4_start',kind:'cp',label:T('The private papers','Giấy tờ riêng')},{ch:4,row:1,id:'p3c4_findings',kind:'cp',label:T('Choose the morning’s priority','Chọn ưu tiên sáng mai')},{ch:4,row:2,id:'p3c4_end',kind:'end',label:T('Two tasks arranged','Đã sắp xếp hai việc')}],
recap:[{ch:4,t:T('Greaves’s papers and equipment support a plan against Ember Star. Together with the trail and curved injury, they support a fatal kick. You chose the order of recovery and further verification.','Giấy tờ và dụng cụ của Greaves ủng hộ kế hoạch nhằm vào Ember Star. Kết hợp với dấu vết trên đất và vết thương có đường viền cong, chúng ủng hộ khả năng ông bị ngựa đá chết. Bạn đã chọn thứ tự tìm ngựa và xác minh thêm.')}],
endings:{p3c4_end:{ch:4,title:T('The Cost of an Order','Cái giá của thứ tự'),chapterClose:T('Tuesday afternoon · the next steps are agreed','Chiều thứ Ba · đã thống nhất các bước tiếp'),nextObjective:T('Verify the horse at Greybank and make your final report. The chosen schedule determines the race deadline.','Xác minh con ngựa tại Greybank rồi lập báo cáo cuối. Lịch đã chọn quyết định có kịp hạn cuộc đua không.'),sum:T('A troubling plan has emerged from separate records. Recovering the horse remains a task of its own.','Một kế hoạch đáng ngại đã hiện ra từ các hồ sơ riêng. Tìm lại ngựa vẫn là một việc cần làm.'),text:T('The final visit is arranged.','Cuộc gặp cuối đã được thu xếp.'),next:'p3c5_open',nextTitle:T('Before the Starting Bell','Trước tiếng chuông xuất phát')}}
});})();
/* Part III, chapter 5: recovery and explanation receive separate outcomes. */
(()=>{'use strict';
const T=(en,vi)=>({en,vi}),N=(en,vi)=>({n:T(en,vi)}),S=(say,en,vi,face)=>({say,en,vi,...(face?{face}:{})}),C=(en,vi,then)=>({en,vi,silent:true,then});
const I=(kind,en,vi,a,b,who='',artAlias='paper')=>({icon:'doc',keep:true,kind,recordType:kind,chapter:5,name:T(en,vi),desc:T(a,b),brief:T(a,b),sourceLabel:T(who?'Recorded account':'Vale and Nora · direct check',who?'Lời kể đã ghi':'Vale và Nora · kiểm tra trực tiếp'),who,artAlias});
const close=(en,vi)=>N(en,vi);
const chapter=d=>{const documents={};for(const[id,docId]of Object.entries(documents)){const doc=d.docs?.[docId],it=d.items?.[id];if(doc&&it)it.document={title:doc.title,text:T(doc.lines.map(x=>x.en).join('\n\n'),doc.lines.map(x=>x.vi).join('\n\n'))};}for(const it of Object.values(d.items||{})){if(it.recordType==='document'&&!it.document)it.document={title:it.name,text:it.desc,note:T('Case record · written account','Hồ sơ vụ án · ghi chép bằng văn bản')};}StoryEngine.chapter(d);};
chapter({
items:{
p3_shop_confirmation:{...I('document','The account confirmed','Khoản nợ đã được xác nhận','The shopkeeper confirms that Thomas Greaves used A. Denham’s account and owed the amount on the recovered bill. No statement identifies the unnamed party in the racing ledger.','Chủ cửa hàng xác nhận Thomas Greaves ghi nợ dưới tên A. Denham và còn nợ số tiền trên hóa đơn thu được. Không lời xác nhận nào nêu bên chưa rõ danh tính trong sổ ghi chép về cuộc đua.'),document:{title:T('Written confirmation from the shop','Xác nhận bằng văn bản từ cửa hàng'),text:T('Thomas Greaves used the account entered as A. Denham. The outstanding amount matches the bill. We cannot identify any racing associate from our accounts.','Thomas Greaves ghi nợ dưới tên A. Denham. Số tiền chưa trả khớp hóa đơn. Sổ của chúng tôi không xác định được người có quan hệ làm ăn với ông ấy trong giới đua ngựa.')}},
p3_dorn_account:I('testimony','Dorn’s admission','Lời thừa nhận của Dorn','Dorn admits finding the loose horse near the wet crossing at dawn and hiding it at Greybank to keep it out of the race. He denies seeing Greaves in the hollow. His admission matches the later part of the visible trail.','Dorn thừa nhận tìm thấy ngựa đi lạc gần chỗ nước lúc rạng sáng, giấu tại Greybank để nó không đua. Ông phủ nhận thấy Greaves trong hõm. Lời nhận khớp phần sau của dấu vết nhìn thấy.','dorn'),
p3_star_mark:I('observation','The forehead star','Đốm trắng trên trán','Nora cleans the mud from the bay’s forehead and finds the small white star described before the search. Colour alone is not the whole identification.','Nora lau bùn trên trán ngựa nâu, thấy đốm trắng nhỏ đã được mô tả trước khi tìm. Riêng màu sắc chưa phải toàn bộ việc nhận dạng.','','p3_horse'),
p3_sock_mark:I('observation','The left hind sock','Mảng trắng chân sau trái','The white marking is on the left hind leg, as recorded on Nora’s dated care card.','Mảng trắng nằm ở chân sau trái, đúng phiếu chăm sóc có ghi ngày của Nora.','','p3_horse'),
p3_shoe_match:I('observation','The farrier’s repair','Chỗ sửa của thợ đóng móng','Nora and the farrier compare the near fore shoe with the dated repair record. Its shape and repaired edge match, alongside the horse’s markings.','Nora và thợ đóng móng đối chiếu móng sắt chân trước trái với ghi chép sửa chữa có ngày. Hình dạng và mép đã sửa khớp, cùng các đặc điểm nhận dạng của ngựa.','','p3_shoe'),
p3_recovered:I('observation','Ember Star recovered','Đã tìm lại Ember Star','The horse at Greybank matches the independent markings and repair record. Nora and the farrier confirm the identification; the constable records its return to Wycliffe.','Ngựa tại Greybank khớp các đặc điểm và ghi chép sửa móng độc lập. Nora cùng thợ đóng móng xác nhận; cảnh sát ghi việc trả về cho Wycliffe.','','p3_horse'),
p3_final_report:I('document','Two questions answered','Hai câu hỏi đã có lời giải','The horse is recovered. Dorn admits later concealment; Greaves’s plan and the medical evidence support a fatal kick by the horse. The final seconds were unwitnessed. Who dosed Ben’s supper and how the scarf reached the hollow remain unconfirmed.','Đã tìm lại ngựa. Dorn thừa nhận giấu nó sau đó; kế hoạch của Greaves và bằng chứng khám nghiệm ủng hộ việc ông bị ngựa đá chết. Không ai chứng kiến những giây cuối. Chưa xác định ai bỏ chất gây buồn ngủ vào bữa tối của Ben hay chiếc khăn đã đến hõm đất bằng cách nào.'),
p3_recovery_report:I('document','Recovery, with the death left open','Tìm lại ngựa, để ngỏ cái chết','Ember Star is returned and Dorn’s concealment is recorded. Vale submits the death evidence for further inquiry without signing a final explanation.','Ember Star được trả lại, việc Dorn giấu ngựa được ghi nhận. Vale nộp bằng chứng về cái chết để điều tra tiếp, chưa ký lời giải thích cuối.'),
p3_late_report:I('document','A supported report after the deadline','Báo cáo có căn cứ sau hạn chót','Ember Star is recovered after registration closes. The death and later concealment receive separate supported explanations. Who dosed Ben’s supper and how the scarf reached the hollow remain unconfirmed. The delay follows the chosen investigation order.','Ember Star được tìm lại sau khi hết hạn đăng ký. Cái chết và việc giấu ngựa sau đó có lời giải thích riêng được hỗ trợ bằng chứng. Chưa xác định ai bỏ chất gây buồn ngủ vào bữa tối của Ben hay chiếc khăn đã đến hõm đất bằng cách nào. Sự chậm trễ do thứ tự điều tra đã chọn.'),
p3_disputed_report:I('document','An accusation with an unresolved contradiction','Lời buộc tội còn mâu thuẫn','Vale publicly accuses Dorn of killing Greaves despite a trail which puts the documented encounter after the horse left the hollow. The constable accepts evidence of concealment but will not certify murder.','Vale công khai buộc Dorn giết Greaves, dù dấu vết đặt cuộc gặp đã ghi nhận sau khi ngựa rời hõm. Cảnh sát nhận bằng chứng giấu ngựa nhưng không xác nhận tội giết người.')},
nodes:{
p3c5_open:[{title:{ch:5,en:'Before the Starting Bell',vi:'Trước tiếng chuông xuất phát'}},{bg:'p3_dorn_yard'},{hide:'*'},{cp:'p3c5_start'},
{if:s=>s.f.p3_priority==='explanation',then:[N('Wednesday, late morning. The shopkeeper has identified Greaves’s account in person and signed your copy. You reach Greybank after race registration has closed—the cost of your chosen order.','Sáng muộn thứ Tư. Chủ cửa hàng đã trực tiếp xác nhận khoản nợ của Greaves và ký bản sao của bạn. Bạn đến Greybank sau hạn đăng ký đua—cái giá của thứ tự đã chọn.'),{set:{p3_on_time:false}}],else:[N('Wednesday, early morning. Reed’s written confirmation arrives with the first post. You reach Greybank with Nora and the constable while there is still time to return the horse before registration closes.','Sáng sớm thứ Tư. Xác nhận bằng văn bản Reed xin được đến trong chuyến thư đầu. Bạn cùng Nora và cảnh sát tới Greybank khi vẫn đủ giờ đưa ngựa về trước hạn đăng ký.'),{set:{p3_on_time:true}}]},
{item:'p3_shop_confirmation'},{show:'dorn',at:'r'},N('Nora has brought the farrier who repaired Ember Star’s shoe. Dorn has not raked the sand again. The constable points from the gate to the wet crossing and asks him one plain question.','Nora đã đưa người thợ sửa móng sắt cho Ember Star đến cùng. Dorn chưa cào cát lần nữa. Cảnh sát chỉ từ cổng ra chỗ nước và hỏi ông một câu thẳng.'),{if:s=>s.f.p3_public_claim==='accuse',then:[S('dorn','They say you have called me a killer. You had better be able to tell one wrong from another.','Họ nói ông gọi tôi là kẻ giết người. Tốt hơn là ông phân biệt nổi việc sai này với việc sai khác.','concerned')],else:[S('dorn','You have brought the right people to make this inconvenient.','Ông đưa đúng người đến để chuyện này thành rắc rối.','concerned')]},S('me','We have followed a horse to this gate. Where is it?','Chúng tôi theo dấu ngựa đến cổng này. Nó ở đâu?'),N('Dorn opens the stable door. A bay horse shifts in the shade behind it. Nora says its stable name softly; one ear turns towards her before the head does.','Dorn mở cửa chuồng. Một con ngựa nâu cựa mình trong bóng râm phía sau. Nora khẽ gọi tên thường gọi của nó; một tai hướng về cô trước khi đầu quay theo.'),S('dorn','I found it loose by the crossing at dawn. I knew what it was. I put it away where nobody would find it before the race.','Tôi thấy nó đi lạc cạnh chỗ nước lúc rạng sáng. Tôi biết là ngựa nào. Tôi cất nó vào nơi không ai tìm được trước cuộc đua.'),S('me','And Greaves?','Còn Greaves?'),S('dorn','I did not see him. The horse came alone. Look at the tracks you followed.','Tôi không thấy ông ấy. Ngựa đến một mình. Cứ xem dấu vết ông đã theo.'),N('The constable records Dorn’s admission: it explains the horse’s absence, not the events in the hollow before their meeting.','Viên cảnh sát ghi lời nhận của Dorn: giải thích việc ngựa không về, chưa giải thích chuyện trong hõm trước cuộc gặp của họ.'),{item:'p3_dorn_account'},
N('Nora leads the animal into the open. She dampens a cloth at the trough and wipes the dried mud from its forehead. A small white star emerges where the card says it should be.','Nora dắt con vật ra ngoài. Cô làm ẩm khăn ở máng rồi lau bùn khô trên trán nó. Đốm trắng nhỏ hiện ra đúng nơi phiếu ghi.'),{prop:{id:'ember',art:'p3_horse',at:[49,65],w:74,ar:1.5,fade:'in',ms:600,wait:true}},{hide:'*'},
{explore:{goal:T('Check the forehead, left hind leg and recorded shoe repair before confirming the horse.','Kiểm tra trán, chân sau trái và chỗ sửa móng đã ghi trước khi xác nhận con ngựa.'),need:3,done:T('Confirm the identification','Xác nhận nhận dạng'),spots:[
{id:'forehead',x:75,y:52,r:[70,48,10,10],inspectR:[64,46,19,18],clue:true,label:T('Compare the white star','So đốm trắng'),then:[N('The star is small and uneven, not a broad blaze. Nora checks it against the sketch made before the disappearance. You turn the card so its left and right do not become the viewer’s left and right.','Đốm trắng nhỏ, không đều, không phải vệt rộng. Nora so với phác họa có từ trước khi mất ngựa. Bạn xoay phiếu để trái phải của con vật không bị nhầm với trái phải người nhìn.'),{item:'p3_star_mark'}],again:[N('The small star matches the earlier sketch. The other markings still matter.','Đốm nhỏ khớp phác họa trước đó. Những đặc điểm còn lại vẫn quan trọng.')]},
{id:'sock',x:28,y:76,r:[25,73,8,9],inspectR:[20,69,17,15],clue:true,label:T('Check the left hind marking','Xem mảng trắng chân sau trái'),then:[N('Nora walks round rather than asking the horse to turn in the narrow gate. The white sock is on the left hind leg. The opposite hind leg has no matching white patch.','Nora đi vòng, không bắt ngựa xoay giữa cổng hẹp. Mảng trắng nằm ở chân sau trái. Chân sau đối diện không có mảng trắng tương tự.'),{item:'p3_sock_mark'}],again:[N('Left hind leg, as recorded.','Chân sau trái, đúng ghi chép.')]},
{id:'shoe',x:58,y:80,r:[54,76,10,7],inspectR:[50,70,22,15],clue:true,label:T('Let the farrier check the repair','Để thợ đóng móng kiểm tra chỗ sửa'),then:[N('The farrier supports the foot while Nora reads the date and description. He recognises his repair on the outside edge. He checks the rest of the shoe before agreeing; a single nick would not have satisfied him.','Thợ đóng móng đỡ chân trong lúc Nora đọc ngày và mô tả. Ông nhận ra chỗ mình sửa ở mép ngoài. Ông kiểm tra phần móng sắt còn lại rồi mới đồng ý; chỉ một vết khía thì chưa đủ.'),S('nora','The shape and repaired edge both match the earlier record.','Hình dạng và mép đã sửa đều khớp ghi chép trước.','smiling'),{item:'p3_shoe_match'}],again:[N('The repair is confirmed alongside the markings, not in their place.','Chỗ sửa được xác nhận cùng các đặc điểm, không thay thế chúng.')]}]}},
{item:'p3_recovered'},{set:{p3_horse_recovered:true}},{cp:'p3c5_recovered'},N('Nora and the farrier confirm Ember Star’s identity. The constable handles the return; Dorn signs a record of where he kept the horse. Nora checks its movement before anyone discusses racing.','Nora và thợ đóng móng xác nhận đúng là Ember Star. Viên cảnh sát phụ trách bàn giao; Dorn ký biên bản về nơi giữ ngựa. Nora kiểm dáng đi trước khi ai bàn chuyện đua.'),S('nora','No injury that would prevent him running, subject to the course surgeon’s check. That is a health finding, not permission to forget what happened.','Không có chấn thương ngăn nó chạy, còn phải qua bác sĩ thú y trường đua kiểm tra. Đây là nhận định sức khỏe, không phải cho phép quên chuyện đã xảy ra.'),
{choice:[C('Report the supported explanation of the death and the separate concealment.','Báo lời giải thích có căn cứ về cái chết và việc giấu ngựa riêng biệt.',[{go:'p3c5_supported'}]),C('Report recovery now; leave the death open for further examination.','Báo việc tìm lại ngựa trước; để cái chết cho điều tra tiếp.',[{go:'p3c5_recovery_route'}]),C('Accuse Dorn of the death as well as concealment.','Buộc Dorn gây ra cái chết lẫn giấu ngựa.',[{go:'p3c5_accuse'}])]}],
p3c5_supported:[{if:s=>s.f.p3_public_claim==='accuse',then:[S('me','I named Dorn as the suspected killer. The evidence does not support that statement. I withdraw it in the same public record.','Tôi đã nêu Dorn là người bị nghi giết người. Bằng chứng không ủng hộ phát biểu đó. Tôi rút lại ngay trong hồ sơ công khai ấy.'),N('Reed gives the correction its own date and signature. It is not hidden in a cleaner copy of the old page.','Reed ghi ngày và chữ ký riêng cho lời đính chính. Nó không bị giấu trong bản chép sạch của trang cũ.')]},
S('me','Greaves knew the horse and the dog. His ledger anticipated payment if Ember Star could not start. His access and plan also make him a plausible suspect in dosing Ben’s supper, though no witness identifies who added the sedative.','Greaves quen con ngựa và con chó. Sổ riêng của ông dự tính được trả tiền nếu Ember Star không thể xuất phát. Việc ông ra vào được trại cùng kế hoạch ấy cũng khiến ta có lý do nghi ông đã bỏ chất gây buồn ngủ vào bữa tối của Ben, dù chưa có lời chứng xác định người làm việc đó.'),S('me','The light, instrument, hoof marks and curved injury together support a fatal kick when the horse reacted. The final seconds were unwitnessed. Dorn’s later concealment is a separate act, supported by his admission and the trail.','Đèn, dụng cụ, dấu móng và vết thương có đường viền cong kết hợp lại ủng hộ khả năng Greaves bị đá chết khi ngựa phản ứng. Không ai chứng kiến những giây cuối. Việc Dorn giấu ngựa sau đó là hành vi riêng, được lời nhận và dấu vết ủng hộ.'),S('dorn','So you are letting me off?','Vậy ông bỏ qua cho tôi?'),S('me','No. Your admission settles the concealment. As for the scarf, Greaves may have picked it up if Quill dropped it as he claims. We cannot trace its transfer or establish its use.','Không. Lời nhận của ông đã xác định việc giấu ngựa. Còn chiếc khăn, có thể Greaves đã nhặt được nếu Quill làm rơi như ông ta kể. Ta chưa biết nó đã qua tay ai, cũng chưa xác định được nó có được dùng vào việc gì không.'),
{if:s=>s.f.p3_on_time,then:[{go:'p3c5_true_route'}],else:[{go:'p3c5_late_route'}]}],
p3c5_true_route:[{prop:{id:'ember',off:true,ms:200}},{bg:'p3_finish'},{hide:'*'},N('At the course, the surgeon examines Ember Star before the clerk accepts the papers. Ben waits at the horse’s shoulder. The clerk stamps the entry; Ben shuts his eyes for a breath, then remembers the reins.','Tại trường đua, bác sĩ thú y khám Ember Star trước khi nhân viên nhận giấy. Ben đợi cạnh vai ngựa. Người ấy đóng dấu đăng ký; Ben nhắm mắt một hơi rồi nhớ đến dây cương.'),{prop:{id:'ember_course',art:'p3_horse',at:[49,66],w:70,ar:1.5,fade:'in',ms:600}},S('elin','You found him.','Ông tìm được nó rồi.','smiling'),S('me','Nora and the farrier made sure we had found the right one.','Nora và thợ đóng móng bảo đảm ta tìm đúng con.'),N('Later, a thin, bright starting bell reaches the enclosure. You watch beside Reed at the rail. Ember Star finishes first. The cheering reaches you a moment later.','Sau đó, tiếng chuông xuất phát mảnh, trong vọng tới khu chuẩn bị. Bạn đứng xem cạnh Reed bên hàng rào. Ember Star về nhất. Tiếng reo đến tai bạn một thoáng sau.'),N('Lady Wycliffe accepts the cup, offering no verdict on Greaves. She grants Ben the rest of the day off, remembers he will not leave the horse, and gives him tomorrow instead.','Phu nhân Wycliffe nhận cúp, không phán xét Greaves. Bà cho Ben nghỉ hết ngày, nhớ ra anh sẽ không rời ngựa, rồi đổi thành ngày mai.'),{item:'p3_final_report'},{set:{p3_ending:'true',p3_true:true,p3_death_resolved:true}},close('That evening, Reed ties both sections with one ribbon. Two questions, separate answers. On the train home, you leave the newspaper folded and watch the fields pass.','Tối đó, Reed buộc hai mục bằng một sợi dây. Hai câu hỏi, hai lời giải riêng. Trên tàu về, bạn để báo gấp nguyên, nhìn cánh đồng trôi qua.'),{end:'p3c5_true'}],
p3c5_late_route:[{prop:{id:'ember',off:true,ms:200}},{bg:'p3_finish'},{hide:'*'},N('The clerk points to the closed register. The deadline stands. Lady Wycliffe withdraws the entry; the delay was never the horse’s fault.','Nhân viên chỉ cuốn sổ đăng ký đã đóng. Hạn chót không đổi. Phu nhân Wycliffe rút đăng ký; sự chậm trễ đâu phải lỗi con ngựa.'),S('elin','You warned me. I still wish we had come sooner.','Ông đã báo trước. Tôi vẫn ước ta đến sớm hơn.','concerned'),S('me','So do I. The order was mine. It will be in the report.','Tôi cũng vậy. Tôi đã chọn thứ tự. Báo cáo sẽ ghi rõ.'),N('Ben leads Ember Star past the enclosure instead of into it. A cheer rises from the far side of the course. The horse turns one ear, then follows him towards the waiting box.','Ben dắt Ember Star đi qua khu chuẩn bị thay vì vào trong. Tiếng reo nổi lên phía xa trường đua. Ngựa xoay một tai, rồi đi theo anh về xe chở đang đợi.'),{item:'p3_late_report'},{set:{p3_ending:'late',p3_true:false,p3_death_resolved:true}},close('Reed files the supported explanation beside the missed entry. The horse is home and the death is accounted for; the race remains something this investigation did not save.','Reed cất lời giải thích có căn cứ cạnh tờ đăng ký bị lỡ. Ngựa đã về, cái chết đã được lý giải; cuộc đua vẫn là điều cuộc điều tra này không cứu được.'),{end:'p3c5_late'}],
p3c5_recovery_route:[{if:s=>s.f.p3_public_claim==='accuse',then:[S('me','My earlier public suspicion of Dorn’s part in the death went beyond the evidence. It is withdrawn. His admitted concealment remains.','Trước đó tôi đã công khai nghi Dorn có liên quan đến cái chết. Nhận định ấy vượt quá bằng chứng, và tôi rút lại. Lời ông thừa nhận giấu ngựa vẫn được giữ trong hồ sơ.')]},S('me','I can certify the recovery and record Dorn’s admission. I am submitting the evidence on Greaves’s death for further examination, without signing a final cause.','Tôi có thể xác nhận đã tìm lại ngựa và ghi lời nhận của Dorn. Tôi nộp bằng chứng về cái chết của Greaves để xem xét tiếp, chưa ký xác nhận nguyên nhân cuối cùng.'),{prop:{id:'ember',off:true,ms:200}},{bg:'p3_yard'},{hide:'*'},N('Ben opens the stall door wide enough for both of them. Ember Star lowers his head to the bucket that has waited since Monday. Ben watches him drink as if the water itself were news.','Ben mở cửa chuồng đủ rộng cho cả hai. Ember Star cúi đầu xuống chiếc xô đợi từ thứ Hai. Ben nhìn nó uống như thể chính nước cũng là tin mới.'),{if:s=>s.f.p3_on_time,then:[S('nora','The course surgeon has time to examine him. What happens next belongs to that examination, not this unfinished file.','Bác sĩ thú y trường đua còn đủ giờ khám nó. Chuyện tiếp theo tùy kết quả đó, không tùy hồ sơ chưa xong này.')],else:[S('elin','The entry has closed. At least the stall is no longer empty.','Đã hết hạn đăng ký. Ít nhất chuồng không còn trống.') ]},S('reed','I have left the second heading open. The papers are there for whoever continues.','Tôi để mục thứ hai mở. Giấy tờ đã sẵn cho người điều tra tiếp.'),{item:'p3_recovery_report'},{set:{p3_ending:'recovery',p3_true:false,p3_death_resolved:false}},close('You sign the return receipt. Beside it, the death inquiry still carries a question mark.','Bạn ký biên nhận trả ngựa. Bên cạnh, cuộc điều tra cái chết vẫn còn dấu hỏi.'),{end:'p3c5_recovery'}],
p3c5_accuse:[S('me','Dorn killed Greaves and then hid the horse. His admission settles both matters.','Dorn giết Greaves rồi giấu ngựa. Lời nhận của ông giải quyết cả hai việc.'),S('reed','It settles the hiding. Our trail shows the horse leaving the hollow before the meeting near Greybank. The medical finding points elsewhere. You can still separate the claims.','Nó giải quyết việc giấu ngựa. Dấu vết cho thấy ngựa rời hõm trước khi gặp người gần Greybank. Kết quả khám nghiệm chỉ hướng khác. Anh vẫn có thể tách hai nhận định.'),{choice:[C('Correct the accusation and give the supported account.','Sửa lời buộc tội, đưa lời giải thích có căn cứ.',[{set:{p3_public_claim:'accuse'}},{go:'p3c5_supported'}]),C('Maintain the accusation in the public report.','Giữ lời buộc tội trong báo cáo công khai.',[{go:'p3c5_wrong_route'}])]}],
p3c5_wrong_route:[N('The constable accepts the horse evidence but refuses to sign a murder allegation. Dorn will answer for concealment; another charge still needs its own proof.','Viên cảnh sát nhận chứng cứ về ngựa nhưng từ chối ký nhận cáo buộc giết người. Dorn sẽ phải giải trình việc giấu ngựa; tội khác vẫn cần chứng cứ riêng.'),S('dorn','I hid it. Write that as large as you like. You do not get the other crime for free.','Tôi giấu nó. Ông muốn viết to đến đâu cũng được. Ông không được tiện thể gán thêm tội kia.','resolute'),{prop:{id:'ember',off:true,ms:200}},{bg:'p3_office'},{hide:'*'},N('A newspaper prints your name beside the accusation. Reed lays its headline next to the copied trail. The two do not agree more closely because they share a desk.','Một tờ báo in tên bạn cạnh lời buộc tội. Reed đặt tiêu đề bên bản chép dấu vết. Hai thứ không khớp nhau hơn chỉ vì nằm chung bàn.'),S('reed','The horse has been returned. I have recorded that. I have also recorded why the other claim was not accepted.','Ngựa đã được trả. Tôi đã ghi việc đó. Tôi cũng ghi vì sao nhận định kia không được chấp nhận.'),{item:'p3_disputed_report'},{set:{p3_ending:'accusation',p3_true:false,p3_death_resolved:false}},close('You close the cover with the contradiction still inside. The file can be reopened; for now, the most confident sentence in it is the one least supported.','Bạn gấp bìa, mâu thuẫn vẫn nằm trong. Hồ sơ có thể mở lại; lúc này, câu tự tin nhất cũng là câu ít căn cứ nhất.'),{end:'p3c5_accusation'}]
},
flow:[{ch:5,row:0,id:'p3c5_start',kind:'cp',label:T('Greybank’s door opens','Cửa Greybank mở')},{ch:5,row:1,id:'p3c5_recovered',kind:'cp',label:T('The horse identified','Đã nhận dạng ngựa')},{ch:5,row:2,id:'p3c5_true',kind:'end',label:T('Two questions answered','Hai câu hỏi đã giải')},{ch:5,row:2,id:'p3c5_recovery',kind:'end',label:T('A horse, an open file','Con ngựa về, hồ sơ mở')},{ch:5,row:2,id:'p3c5_late',kind:'end',label:T('After the bell','Sau tiếng chuông')},{ch:5,row:2,id:'p3c5_accusation',kind:'end',label:T('The wrong headline','Tiêu đề sai')}],
recap:[{ch:5,t:T('Nora and the farrier identified Ember Star at Greybank. Dorn admitted concealing the loose horse after finding it near the crossing.','Nora cùng thợ đóng móng nhận ra Ember Star tại Greybank. Dorn thừa nhận giấu ngựa đi lạc sau khi thấy nó gần chỗ nước.')},{ch:5,if:s=>s.f.p3_death_resolved,t:T('Your final report separated Greaves’s supported plan and likely fatal kick from Dorn’s later concealment.','Báo cáo cuối tách kế hoạch có căn cứ của Greaves cùng cú đá chí mạng được hỗ trợ bằng chứng khỏi việc Dorn giấu ngựa sau đó.')}],
endings:{
p3c5_true:{ch:5,final:true,title:T('Two Questions Answered','Hai câu hỏi đã có lời giải'),chapterClose:T('Wednesday evening · recovery and explanation recorded','Tối thứ Tư · đã ghi việc tìm lại và lời giải'),sum:T('TRUE ENDING · Ember Star is recovered in time. Greaves’s death and Dorn’s concealment receive separate, supported explanations.','TRUE ENDING · Ember Star được tìm lại kịp giờ. Cái chết của Greaves và việc Dorn giấu ngựa có lời giải riêng được hỗ trợ bằng chứng.'),text:T('The horse is home; Ben keeps the corrected report. The file records both the supported explanation and the questions still open.','Ngựa đã trở về; Ben giữ bản báo cáo đính chính. Hồ sơ ghi lại lời giải có căn cứ cùng những câu hỏi còn để ngỏ.')},
p3c5_recovery:{ch:5,final:true,title:T('A Horse, an Open File','Con ngựa trở về, hồ sơ để mở'),chapterClose:T('Wednesday · the horse returned, the death inquiry open','Thứ Tư · ngựa đã về, điều tra cái chết còn mở'),sum:T('RECOVERY ENDING · You return Ember Star and record Dorn’s admission. You leave the cause of death for a further inquiry.','KẾT TÌM LẠI NGỰA · Bạn đưa Ember Star về, ghi lời nhận của Dorn. Nguyên nhân cái chết được để lại cho cuộc điều tra tiếp.'),text:T('Ember Star is home. The evidence on Greaves’s death remains with the constable for the next inquiry.','Ember Star đã trở về. Bằng chứng về cái chết của Greaves được để lại cho cảnh sát tiếp tục điều tra.')},
p3c5_late:{ch:5,final:true,title:T('After the Bell','Sau tiếng chuông'),chapterClose:T('Wednesday · the deadline missed, the account completed','Thứ Tư · lỡ hạn chót, hoàn tất lời giải'),sum:T('EXPLANATION ENDING · You recover the horse and support the account of the death, but your chosen order misses race registration.','KẾT LỜI GIẢI · Bạn tìm lại ngựa, đưa lời giải cái chết có căn cứ, nhưng thứ tự đã chọn khiến lỡ hạn đăng ký đua.'),text:T('The horse is safe at Wycliffe. The supported account goes into the file beside the missed race entry.','Ngựa đã an toàn ở Wycliffe. Lời giải có căn cứ được cất vào hồ sơ cạnh tờ đăng ký lỡ hạn.')},
p3c5_accusation:{ch:5,final:true,title:T('The Wrong Man in the Headline','Sai người trong tiêu đề'),chapterClose:T('Wednesday · the recovery stands, the accusation is disputed','Thứ Tư · xác nhận tìm lại ngựa, tranh chấp lời buộc tội'),sum:T('DISPUTED REPORT ENDING · Dorn’s concealment is established. You insist it also proves a killing, despite the contrary sequence and the medical finding.','KẾT BÁO CÁO BỊ BÁC · Đã xác định Dorn giấu ngựa. Bạn khăng khăng điều đó chứng minh giết người, bất chấp trình tự trái lại và kết quả khám nghiệm.'),text:T('The horse has been returned. The constable records Dorn’s concealment but leaves the unsupported murder charge unsigned.','Ngựa đã được trả lại. Cảnh sát ghi nhận việc Dorn giấu ngựa, nhưng không ký xác nhận cáo buộc giết người thiếu căn cứ.')}
}
});})();
