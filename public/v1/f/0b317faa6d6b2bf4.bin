    const height = wide ? Math.max(current.stable ? 100 : 140, Math.min(plane.h * (current.bodyHeight || .4), current.stable ? root.clientHeight * Math.max(.44, current.bodyHeight || 0) : Infinity, groupHeight, floor - safeTop))
