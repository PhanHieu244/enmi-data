  const capable=!!(navigator.mediaDevices?.getUserMedia&&globalThis.MediaRecorder);
  const sh=E.ui.sheet('Listen & speak · Nghe và nói theo',`<div class="vd-practice"><p class="se-mute">From your current route · Lấy từ tuyến bạn đã đọc</p><div class="vd-practice-quote" lang="en">${esc(line.text)}</div><details ${E.G().set.tr?'open':''}><summary>Meaning · Nghĩa tiếng Việt</summary><p lang="vi">${esc(line.vi||'')}</p></details><div class="se-row"><button class="se-btn" data-hear>Listen · Nghe</button><button class="se-btn" data-slow>Slower · Nghe chậm</button></div>${word?`<details class="vd-fill"><summary>Fill the missing word · Điền từ còn thiếu</summary><p lang="en">${esc(line.text.slice(0,word.index))}<b>______</b>${esc(line.text.slice(word.index+word[0].length))}</p><label class="se-fl">Your answer · Câu trả lời<input class="se-in" data-answer autocomplete="off" autocapitalize="none" spellcheck="false" inputmode="text"></label><div class="se-row"><button class="se-btn pri" data-check>Check · Kiểm tra</button><button class="se-btn" data-show>Show word · Xem từ</button></div><p data-feedback role="status"></p></details>`:''}<div class="vd-practice-record"><h3>Say it yourself · Tự nói lại</h3><p class="se-mute">Listen, say the line, then compare your recording. This practice has no automatic score.<span class="vd-vi">Nghe, nói lại rồi tự so với câu mẫu. Phần luyện này không chấm điểm tự động.</span></p>${globalThis.Enmi?.shadow?'<button class="se-btn wide" data-shadow>Practise with Enmi · Luyện nói trong Enmi</button>':''}<button class="se-btn wide" data-record ${capable?'':'disabled'}>Record my voice · Thu giọng của tôi</button><p data-record-status class="se-mute" role="status">${capable?'Microphone is used only after you tap Record. The clip stays in this session. · Chỉ bật mic khi bạn bấm Thu; bản thu chỉ nằm trong phiên này.':'Recording is unavailable in this browser context. You can still listen and speak aloud. · Ngữ cảnh trình duyệt này chưa hỗ trợ thu; bạn vẫn có thể nghe và nói theo.'}</p><audio data-audio controls hidden></audio></div><div class="se-row"><button class="se-btn" data-prev ${index?'':'disabled'}>← Newer · Mới hơn</button><button class="se-btn" data-next ${index<lines.length-1?'':'disabled'}>Earlier · Trước đó →</button></div></div>`,'tall');
  const say=slow=>E.say(line.text,line.who,{force:true,lang:'en',slow});
  sh.querySelector('[data-hear]').onclick=()=>say(false);sh.querySelector('[data-slow]').onclick=()=>say(true);
  if(word){const feedback=sh.querySelector('[data-feedback]');const check=()=>{const a=sh.querySelector('[data-answer]').value.trim().toLowerCase();feedback.textContent=a===word[0].toLowerCase()?'✓ Correct. Read the whole sentence once more. · Đúng. Hãy đọc lại cả câu.':'Try again. You can listen to the line. · Thử lại; bạn có thể nghe câu mẫu.';};sh.querySelector('[data-check]').onclick=check;sh.querySelector('[data-answer]').onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();check();}};sh.querySelector('[data-show]').onclick=()=>{feedback.textContent=word[0]+(E.S().words?.[word[0].toLowerCase()]?.vi?' — '+E.S().words[word[0].toLowerCase()].vi:'');};}
  const stopStream=()=>{stream?.getTracks().forEach(t=>t.stop());stream=null;};
  const stop=()=>{clearTimeout(recordTimer);if(recorder?.state==='recording')recorder.stop();else stopStream();};
  const rec=sh.querySelector('[data-record]'),status=sh.querySelector('[data-record-status]');
