// Tranh Táº M (SVG) theo scenes.<id>.kind khi chÆ°a cÃ³ áº£nh tháº­t â€” cÃ³ áº£nh trong art.css thÃ¬ tá»± Ä‘Ã¨ lÃªn.
(() => {
  const svg = (bg1, bg2, body) => `<svg viewBox="0 0 576 1024" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${bg1}"/><stop offset="1" stop-color="${bg2}"/></linearGradient></defs><rect width="576" height="1024" fill="url(#g)"/>${body}</svg>`;
  const shelves = (x, w, c) => Array.from({ length: 7 }, (_, i) => `<rect x="${x}" y="${180 + i * 90}" width="${w}" height="8" fill="${c}"/>` + Array.from({ length: Math.floor(w / 22) }, (_, j) => `<rect x="${x + 4 + j * 22}" y="${130 + i * 90 + (j % 3) * 6}" width="16" height="${50 - (j % 3) * 6}" fill="${c}" opacity="${0.4 + (j % 4) * 0.12}"/>`).join("")).join("");
  const win = (x, y, w, h) => `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="#1d3a44"/><path d="M${x + w / 2} ${y}v${h}M${x} ${y + h / 2}h${w}" stroke="#0b1418" stroke-width="6"/>` + Array.from({ length: 9 }, (_, i) => `<path d="M${x + 8 + i * (w / 9)} ${y + 6}l-6 ${h - 12}" stroke="#7fb3c0" stroke-width="1.2" opacity=".35"/>`).join("");
  globalThis.TIQ_ART = {
    causeway: svg("#2a4650", "#0d1a1f", `<path d="M0 640 Q288 600 576 640V1024H0z" fill="#16313a"/><path d="M250 1024 L282 660 L300 660 L330 1024z" fill="#3a4a4c"/><path d="M330 600 Q380 470 470 500 Q540 520 576 560V640H300z" fill="#0f1d22"/><rect x="410" y="440" width="70" height="60" fill="#0f1d22"/><path d="M405 440l40-36 40 36z" fill="#0f1d22"/><rect x="430" y="458" width="12" height="14" fill="#e2b86b" opacity=".85"/><rect width="576" height="1024" fill="#c9d6d8" opacity=".08"/>`),
    hall: svg("#2c2420", "#120d0b", `<path d="M120 1024 L330 380 L360 380 L380 1024z" fill="#3b2b22"/>${Array.from({ length: 12 }, (_, i) => `<rect x="${150 + i * 18}" y="${960 - i * 50}" width="${200 - i * 6}" height="10" fill="#4a362a"/>`).join("")}<rect x="60" y="220" width="90" height="120" fill="#4a3a2e" stroke="#7a5f45" stroke-width="6"/><rect x="430" y="260" width="90" height="120" fill="#4a3a2e" stroke="#7a5f45" stroke-width="6"/><circle cx="500" cy="520" r="14" fill="#e2b86b" opacity=".7"/>`),
    dining: svg("#2e2219", "#110b08", `${win(200, 150, 180, 260)}<rect x="60" y="640" width="456" height="40" fill="#4b3424"/><rect x="80" y="680" width="20" height="200" fill="#3a281c"/><rect x="476" y="680" width="20" height="200" fill="#3a281c"/>${[150, 230, 310, 390].map(x => `<rect x="${x}" y="590" width="6" height="50" fill="#e8dcc0"/><ellipse cx="${x + 3}" cy="582" rx="6" ry="12" fill="#f2b84b"/>`).join("")}<rect x="250" y="520" width="80" height="120" fill="#3a281c" opacity=".7"/>`),
    bedroom: svg("#1d2a33", "#0b1116", `${win(320, 160, 180, 280)}<rect x="40" y="700" width="330" height="120" fill="#2b3a44"/><rect x="40" y="660" width="90" height="60" fill="#3a4a54"/>${shelves(40, 220, "#33434d").slice(0, 2000)}<circle cx="430" cy="640" r="40" fill="#e2b86b" opacity=".18"/>`),
    study: svg("#1f2a2a", "#0a1010", `${win(330, 140, 170, 250)}${shelves(30, 260, "#2f3d3b")}<rect x="140" y="660" width="320" height="30" fill="#3a2a1e"/><rect x="230" y="610" width="90" height="50" fill="#222"/><ellipse cx="380" cy="652" rx="18" ry="8" fill="#ddd" opacity=".8"/><circle cx="470" cy="900" r="38" fill="none" stroke="#b08d4a" stroke-width="8"/><path d="M470 900l0-28" stroke="#b08d4a" stroke-width="5"/>`),
    library: svg("#2a1e18", "#0e0907", `${shelves(20, 536, "#3d2c21")}<rect x="200" y="780" width="176" height="160" fill="#1a110c"/><path d="M220 940 Q288 840 356 940z" fill="#e2702b" opacity=".75"/><path d="M250 940 Q288 880 326 940z" fill="#f2b84b" opacity=".8"/><rect x="420" y="760" width="110" height="160" rx="20" fill="#4a2e22"/>`),
    kitchen: svg("#26302a", "#0d110e", `${win(190, 160, 200, 230)}<rect x="0" y="700" width="576" height="40" fill="#3c4a40"/><rect x="0" y="740" width="576" height="284" fill="#1c241f"/><rect x="380" y="640" width="70" height="60" rx="20" fill="#5b6a60"/><path d="M288 0v120" stroke="#444" stroke-width="3"/><path d="M258 120h60l-14 30h-32z" fill="#e2b86b" opacity=".85"/>`),
    cliff: svg("#18252c", "#05090b", `<path d="M0 520 L260 560 L330 620 L380 1024 H0z" fill="#121a17"/><path d="M380 1024 L330 620 L576 700 V1024z" fill="#0e2630"/>${Array.from({ length: 30 }, (_, i) => `<path d="M${(i * 37) % 576} ${(i * 83) % 1024}l-14 60" stroke="#9fc4cf" stroke-width="1.4" opacity=".3"/>`).join("")}<path d="M330 820 q60 -30 120 0 t120 0" stroke="#d9eef2" stroke-width="3" fill="none" opacity=".4"/>`),
  };
})();
