// Enmi Story Engine — CÁC CƠ CHẾ (mỗi cơ chế = StoryEngine.def(tên, async ctx => …)). Truyện nào cũng dùng chung.
// ctx: st (bước) · s (trạng thái cho điều kiện) · push(...khoá) chạy mảng bước con (vd. push("choice", 2, "then")) ·
//      again() chạy lại chính bước này sau khi bước con xong (vòng lặp: khám phá, chọn lặp, giải đố) · key(...) khoá duy nhất của bước.
// Danh sách: bg show hide n think say · set add item drop truth word go if cp wait fx title · choice (giờ, khoá, trực giác, đồ vật, lặp) ·
//   explore (điểm nóng, dùng đồ lên cảnh, ghép đồ) · map (chọn hướng đi) · interpret (phiên dịch 2 chiều) · present (vạch lời khai sai) ·
//   listen (nghe không chữ) · quiz · lock (khoá số / chữ) · order (xếp thứ tự / dòng thời gian) · type (gõ câu trả lời) · review · end
(() => {
  const E = globalThis.StoryEngine, def = E.def, esc = E.esc, h = E.h;
  const T = k => E.ui.tr(k);
  const nat = t => E.nat(t), tgt = t => E.tgt(t);
  const pick = (arr) => arr[E.auto === "r" ? Math.floor(Math.random() * arr.length) : 0];
  const later = (fn, ms = 5) => setTimeout(fn, ms);
  // trộn ổn định theo khoá bước (tải lại không đổi thứ tự)
  const shuffle = (arr, seed) => { const a = arr.map((x, i) => [x, i]); let s = E.hash(seed); for (let i = a.length - 1; i > 0; i--) { s = (s * 1103515245 + 12345) >>> 0; const j = s % (i + 1); [a[i], a[j]] = [a[j], a[i]]; } return a; };
  const cond = (c, s) => (c == null ? true : typeof c === "function" ? !!c(s) : typeof c === "string" ? s.truth(c) || s.has(c) || !!s.f[c] : typeof c === "object" && !Array.isArray(c) ? Object.entries(c).every(([k, v]) => (+s.f[k] || 0) >= v) : !!c);
  const optText = o => ({ main: E.tgt(o), sub: E.sub(o) });
  const L = (o) => nat(o);
  const investigationText = t => E.ui.investigationText?.(t) ?? esc(nat(t));
  // nhãn kiểu câu (hỏi cung / giọng điệu): o.tag
  const TAGS = {
    open: { en: "Open question", vi: "Câu hỏi mở" }, lead: { en: "Leading", vi: "Dẫn dắt" }, press: { en: "Pressure", vi: "Gây sức ép" },
    kind: { en: "Kind", vi: "Đồng cảm" }, bluff: { en: "Bluff", vi: "Tố khống" }, polite: { en: "Polite", vi: "Lịch sự" }, direct: { en: "Direct", vi: "Thẳng" }, lie: { en: "Lie", vi: "Nói dối" },
  };

  // ───────── cảnh, nhân vật, lời ─────────
  // chờ ảnh nền mới sẵn sàng (≤ 450 ms) rồi mới chạy lời dẫn tiếp — không còn cảnh “nền cũ + chữ mới”
  def("bg", async ({ st }) => { await E.ui.scene(st.bg); });
  // face có thể là hàm theo trạng thái: face: s => (s.f.angry ? "cold" : "")
  def("show", async ({ st }) => E.ui.show(st.show, st.at, typeof st.face === "function" ? st.face(E.state()) || "" : st.face));
  def("hide", async ({ st }) => E.ui.hide(st.hide));
  def("n", async ({ st }) => { const t = E.narr(st.n); await E.ui.line({ kind: "n", ...t, on: st.on, pic: st.pic }); });
  def("think", async ({ st }) => { const t = E.narr(st.think); await E.ui.line({ kind: "think", ...t, on: st.on, pic: st.pic }); });
  def("say", async ({ st }) => {
    const who = st.say, ch = who === "me" ? null : E.S().chars[who];
    if (st.face && who !== "me" && E.R().cast[who]) E.ui.show(who, E.R().cast[who].at, st.face);
    // bạn nói tiếng mẹ đẻ với người cùng quê: say: "me", lang: "@N"
    const t = E.speech(st, who === "me" ? (st.lang ? { lang: st.lang } : null) : ch);
    await E.ui.line({ who, kind: "say", ...t, whisper: st.whisper, cls: st.phone ? "phone" : "", tag: st.phone ? "☎" : st.tag || "", pic: st.pic });
  });

  // ───────── trạng thái ─────────
  def("set", async ({ st }) => { for (const k in st.set) E.flag(k, st.set[k]); });
  def("add", async ({ st }) => { for (const k in st.add) E.add(k, st.add[k]); });
  def("item", async ({ st }) => {
    const R = E.R(); if (R.items.includes(st.item)) return;
    R.items.push(st.item);
    const it = E.S().items[st.item];
    // nhận vật mới: thông báo có ẢNH vật + mô tả ngắn (người dùng 29/10)
    if (!st.quiet) { E.ui.itemNotice(st.item); E.ui.dot(true); E.sfx("item"); E.haptic("LIGHT"); }
    E.emit("item", st.item);
  });
  def("drop", async ({ st }) => { const R = E.R(); R.items = R.items.filter(x => x !== st.drop); });
  def("truth", async ({ st }) => {
    const G = E.G(), R = E.R(), id = st.truth, t = E.S().truths?.[id];
    R.truths[id] = 1;
    if (G.truths[id]) return;
    G.truths[id] = Date.now(); E.save();
    E.ui.dot(true);
    E.ui.hideBox();
    E.sfx("truth"); E.haptic("HEAVY");
    await E.ui.card(`<div class="se-tc"><small>${T("newTruth")}</small><div class="se-tcn">${Object.keys(G.truths).length}<span>/${E.S().truthTotal || "?"}</span></div><b>${esc(nat(t?.name))}</b><p>${esc(nat(t?.text))}</p><i>${T("tapNext")}</i></div>`, 0, "truth");
  });
  def("word", async ({ st }) => { const G = E.G(); for (const w of [].concat(st.word)) G.words[w] ||= Date.now(); });
  def("go", async ({ st }) => E.jump(st.go));
  def("if", async (c) => { const ok = cond(c.st.if, c.s); if (ok && c.st.then) c.push("then"); else if (!ok && c.st.else) c.push("else"); if (ok && c.st.go) E.jump(c.st.go); });
  def("cp", async ({ st }) => E.cp(st.cp));
  def("wait", ({ st }) => new Promise(r => setTimeout(r, E.auto ? 1 : st.wait)));
  def("fx", async ({ st }) => (E.effect?.run ? E.effect.run(st.fx, st) : E.ui.fx(st.fx)));
  // gặp / biết tên 1 nhân vật (nhân vật reveal: "manual", hoặc biết tên trước khi bước ra): { meet: "<mã>" }
  def("meet", async ({ st }) => { for (const id of [].concat(st.meet)) E.meet(id, true); });
  // tranh minh hoạ khoảnh khắc lớn: { cg: "cg-sandal" } · { cg: null } = về cảnh
  def("cg", async ({ st }) => E.ui.cg(st.cg));
  // thẻ chương (viền điện ảnh, chữ hiện dần) / thẻ mốc thời gian ({ title } không có ch)
  def("title", async ({ st }) => {
    E.ui.hideBox(); E.ui.hide("*");
    const t = st.title;
    // vào chương mới: ghi chương trước đã xong + chụp lần chơi đầu chương (“Chơi chương N” ở màn tổng quan)
    if (t.ch) { E.R().ch = t.ch; E.chAt?.(t.ch); }
    E.sfx("title");
    await E.ui.card(t.ch
      ? `<div class="se-ct"><small>${esc(nat({ en: "Chapter " + t.ch, vi: "Chương " + t.ch }))}</small><b>${esc(tgt(t))}</b><em></em>${E.L !== E.N && tx2(t) ? `<i>${esc(tx2(t))}</i>` : ""}</div>`
      : `<div class="se-ct time"><b>${esc(tgt(t))}</b>${E.L !== E.N && tx2(t) ? `<i>${esc(tx2(t))}</i>` : ""}</div>`, t.ch ? 3600 : 2400, t.ch ? "chap" : "time");
  });
  const tx2 = t => E.sub(t);

  // NHÃN GIỌNG ĐIỆU của lựa chọn (engine 3, người dùng 30/10: “tag dẫn dắt, thẳng thắn… nhiều chỗ không hợp”):
  //   · truyện tự khai bộ nhãn của mình: story.tags = { warm: { en: "Warm", vi: "Ấm áp", c: "#f59e0b" }, cold: {…} } (chương thêm được) —
  //     ghi đè / bổ sung bộ có sẵn (open lead press kind bluff polite direct lie = bộ HỎI CUNG, chỉ hợp cảnh thẩm vấn)
  //   · story.tags = false → không hiện nhãn nào · nhãn ngay tại chỗ: tag: { en: "Sarcastic", vi: "Mỉa mai" }
  //   · lựa chọn HÀNH ĐỘNG “(…)” không hiện nhãn hỏi cung có sẵn (chỉ nhãn truyện tự khai) · mã nhãn không ai khai → không hiện (không lộ mã thô)
  const tagHtml = (t, act) => {
    const ST = E.S().tags;
    if (ST === false) return "";
    const own = typeof t === "object" ? t : ST?.[t];
    const def = own || (!act ? TAGS[t] : null);
    if (!def) return "";
    const c = def.c || def.color;
    return `<em class="se-tag${typeof t === "string" && !own ? " t-" + esc(t) : ""}"${c ? ` style="background:color-mix(in srgb, ${c} 22%, #fff);color:color-mix(in srgb, ${c} 70%, #000)"` : ""}>${esc(nat(def))}</em>`;
  };
  // tên chỉ số cho người chơi: story.stats.<mã> → nhãn thanh meter → mã viết hoa chữ đầu
  const statN = k => nat(E.S().stats?.[k] || E.R().meters?.[k]?.label || { en: k.charAt(0).toUpperCase() + k.slice(1) });
  // ───────── LỰA CHỌN: giờ · khoá (lockHint) · trực giác (need: id sự thật) · đồ vật (item) · lặp (loop + once) ─────────
  def("choice", (c) => new Promise(res => {
    const { st, s } = c, R = E.R(), G = E.G();
    c.resumeHere?.();
    // once nhớ theo vị trí bước — hoặc theo o.id (cùng 1 câu hỏi dùng ở nhiều chỗ, vd. then + again của 1 điểm khám xét)
    const onceK = (o, i) => (o.id ? "o:" + o.id : c.key(i));
    const list = [];
    st.choice.forEach((o, i) => {
      if (o.if && !cond(o.if, s)) return;
      if (o.once && R.used[onceK(o, i)]) return;
      if (o.item && !s.has(o.item)) return;
      let locked = false, why = "";
      // req = cần chỉ số ({ charm: 3 }) · cost = tốn ({ coins: 5 }) — thiếu thì khoá + ghi rõ cần gì (reqHide: true = ẩn hẳn)
      const lack = [...new Set([...Object.keys(o.req || {}), ...Object.keys(o.cost || {})])].map(k => [k, Math.max(o.req?.[k] || 0, o.cost?.[k] || 0)]).filter(([k, v]) => (+R.f[k] || 0) < v);
      if (lack.length) { if (o.reqHide) return; locked = true; why = lack.map(([k, v]) => nat({ en: `Needs ${statN(k)} ${v} (you have ${+R.f[k] || 0})`, vi: `Cần ${statN(k)} ${v} (bạn có ${+R.f[k] || 0})` })).join(" · "); }
      if (o.need) {
        const ok = typeof o.need === "string" ? !!G.truths[o.need] : cond(o.need, s);
        if (!ok) { if (o.lockHint) locked = true; else return; }
      }
      list.push({ o, i, locked, why });
    });
    const usable = list.filter(x => !x.locked);
    if (!usable.length && st.empty) { c.push("empty"); return res(); }
    // câu nhân vật vừa nói nhắc lại ở đầu bảng (đang trả lời ai, câu gì)
    const q = R.last && R.last.who && R.last.who !== "me" && R.log[R.log.length - 1]?.kind === "say" ? R.last : null;
    const qc = q && E.S().chars[q.who];
    // hộp lời nhường chỗ (câu vừa nói đã nhắc lại ở đầu bảng) — trừ khi câu cuối là lời dẫn / suy nghĩ (giữ làm ngữ cảnh)
    if (q || R.log[R.log.length - 1]?.who === "me") E.ui.hideBox();
    const box = E.ui.panel(`${q ? `<div class="se-q" style="--c:${qc?.color || "#aaa"}"><b>${esc(E.cname(qc, true))}</b><span>${E.words(q.text, q.lang)}</span></div>` : ""}${st.prompt ? `<div class="se-ask">${esc(L(st.prompt))}</div>` : ""}${st.timer ? `<div class="se-timer"><i style="animation-duration:${st.timer}s"></i></div>` : ""}<div class="se-chs">${list.map(({ o, i, locked, why }, k) => {
      const t = optText(o), act = /^\(/.test(t.main);
      const sub = t.sub ? `<small${E.G().set.tr || E.G().set.mode === "easy" ? "" : " hidden"}>${esc(t.sub)}</small>` : "";
      const tag = o.intuition ? `<em class="se-int">✦ ${T("intuition")}</em>` : o.item ? `<em class="se-itag">${E.ICON[E.S().items[o.item]?.icon] || E.ICON.box}</em>` : o.tag ? tagHtml(o.tag, act) : "";
      const hear = !act && !locked && !o.silent ? `<i class="se-hear" data-hear="${i}">${E.ICON.spk}</i>` : "";
      // huy hiệu chỉ số kiểu Disco Elysium: phương án mở nhờ chỉ số hiện “Tinh tế 3” · tốn tiền / sức hiện “−5 Xu”
      const badges = [...Object.entries(o.req || {}).map(([k, v]) => `<em class="se-req${locked ? "" : " ok"}">${esc(statN(k))} ${v}</em>`), ...Object.entries(o.cost || {}).map(([k, v]) => `<em class="se-cost">−${v} ${esc(statN(k))}</em>`)].join("");
      return `<button class="se-ch-b${act ? " act" : ""}${o.intuition ? " int" : ""}${locked ? " lock" : ""}" data-i="${i}" style="--k:${k}" ${locked ? "disabled" : ""}>${tag}${badges ? `<span class="se-badges">${badges}</span>` : ""}<span>${esc(t.main)}</span>${sub}${locked ? `<small class="se-lh">${E.ICON.lock}${esc(why || L(o.lockHint))}</small>` : ""}${hear}</button>`;
    }).join("")}</div>${!usable.length ? `<div class="se-hint" role="status">${esc(nat({ en: "No choices are available here.", vi: "Hiện không có lựa chọn nào khả dụng." }))}</div><button class="se-btn wide" data-empty>${T("cont")}</button>` : ""}`, "chs");
    E.sfx("open");
    let beat = null;
    if (st.timer && !E.auto) { E.ui.urgent(true); beat = setInterval(() => E.sfx("beat"), 1000); E.haptic("LIGHT"); }
    let tm = null, done = false;
    const live = () => !c.live || c.live();
    c.onCancel?.(() => { done = true; clearTimeout(tm); clearInterval(beat); res(); });
    const finish = async (o, i, instant = false) => {
      if (done || !live()) return; done = true; clearTimeout(tm); clearInterval(beat); E.ui.urgent(false);
      if (o) {
        // phương án được chọn sáng lên, phương án khác lùi ra
        const bt = box.querySelector(`[data-i="${i}"]`);
        bt?.classList.add("picked"); box.querySelectorAll(".se-ch-b").forEach(x => x !== bt && x.classList.add("off"));
        E.sfx("pick"); E.haptic("LIGHT");
        if (!E.auto && !instant) await new Promise(r => setTimeout(r, 380));
      }
      if (!live()) return res();
      c.resumeHere?.(false);
      E.ui.clear();
      if (o) {
        if (o.once) R.used[onceK(o, i)] = 1;
        for (const [k, v] of Object.entries(o.cost || {})) E.add(k, -v);
        // tone: kiểu trả lời → chỉ số tăng (story.tones = { tactful: "charm", clever: "smart" } hoặc { tactful: { charm: 1 } })
        const tn = o.tone && E.S().tones?.[o.tone]; if (tn) { if (typeof tn === "string") E.add(tn, 1); else for (const k in tn) E.add(k, tn[k]); }
        E.apply(o);
        if (o.loop === false || (st.loop && !o.once)) {} // vòng lặp kết thúc ở lựa chọn không có once
        else if (st.loop && !o.go) c.again();
        // Persist the chosen continuation before any optional voice/reading wait.
        if (o.go) E.jump(o.go);
        if (o.then) c.push("choice", i, "then");
        const t = optText(o);
        // NÓI THEO câu vừa chọn (như truyện nhập vai): app mở bảng micro, chấm từng từ — tắt ở màn tổng quan (Nói theo câu đã chọn)
        let said = false;
        if (!/^\(/.test(t.main) && !o.silent && E.G().set.shadow && globalThis.Enmi?.shadow && !E.auto) { E.hush(); said = !!(await globalThis.Enmi.shadow(t.main, { tr: t.sub }).catch(() => null))?.ok; }
        if (!live()) return res();
        if (!/^\(/.test(t.main) && !o.silent) await E.ui.line({ who: "me", kind: "say", main: t.main, sub: t.sub, lang: E.L, ...(said ? { speak: "" } : {}) });
        if (!live()) return res();

      } else if (st.timeout) c.push("timeout");
      res();
    };
    box.onclick = e => {
      if (done || !live()) return;
      if (e.target.closest("[data-empty]")) return finish(null);
      const hr = e.target.closest("[data-hear]");
      if (hr) { e.stopPropagation(); const o = st.choice[+hr.dataset.hear]; return E.say(optText(o).main, "me", { force: true, lang: E.L }); }
      const b = e.target.closest("[data-i]"); if (b && !b.disabled) finish(st.choice[+b.dataset.i], +b.dataset.i);
    };
    if (st.skipIfOne && usable.length === 1 && !usable[0].o.intuition) { const x = usable[0]; return void finish(x.o, x.i, true); }
    if (st.timer) tm = setTimeout(() => finish(null), st.timer * 1000);
    E.autoRun(() => { const x = pick(usable); x ? finish(x.o, x.i) : finish(null); });
  }));

  // ───────── KHÁM PHÁ: điểm nóng trên cảnh + túi đồ (dùng đồ lên điểm, ghép 2 đồ) ─────────
  // spot: { id, x, y, label, then, again, clue, dark, use: { <đồ>: [bước] }, if }  · story.combos: [{ a, b, make, then }]
  //   again = lần chạm sau (khác lần đầu — người dùng 29/10: chạm lại không được lặp nguyên cảnh): [bước] hoặc [[bước], [bước]…] (lần lượt).
  //     Không ghi again: điểm manh mối → 1 câu “đã xem rồi” · điểm khác (nói chuyện…) → chạy lại then.
  //   stuck = chạm lại chỗ cần đồ mà chưa dùng đồ (gợi ý rõ hơn lần đầu).
  //   dark = chỗ tối: chưa dùng đồ → cận cảnh tối om; dùng đồ → vùng sáng đèn pin.
  // TÚI ĐỒ (29/10, theo kiểu game phiêu lưu điểm-và-chạm): chạm 1 món = CẦM món đó (thẻ nhỏ hiện tên + mô tả ngay trong bảng, không toast);
  //   chạm món khác = ĐỔI sang món đó (trước: chạm món khác là GHÉP → người chơi muốn đổi đồ lại thành ghép). Ghép = nút “Ghép với…” rồi chạm món kia.
  //   Mọi phản hồi (không dùng được, không ghép được) hiện tại chỗ trong bảng.
  // ĐẾM MANH MỐI: đã tìm / tổng số điểm manh mối (không còn “3/3” khiến tưởng đã xong); đủ tối thiểu (need) mới bấm Xong được,
  //   còn chỗ chưa xem thì hỏi lại trước khi rời.
  def("explore", (c) => new Promise(res => {
    const { st } = c, X = st.explore, R = E.R(), S = E.S();
    const direct = !!S.detailExplore && !!E.vbox && !!E.ui.look;
    const imageId = X.img || R.scene || E.curImg?.();
    const detailKey = c.key(), details = direct ? (R.xpDetail ||= {}) : {};
    const detail = () => direct ? details[detailKey] : null;
    const region = sp => E.regionOf?.(imageId, sp.r)?.box || [Number(sp.x ?? 50) - 8, Number(sp.y ?? 50) - 8, 16, 16];
    // A visible edge can carry the glint while inspection frames the complete
    // object. Both authored rectangles remain in the same image coordinates.
    const inspection = sp => E.regionOf?.(imageId, sp.inspectR)?.box || region(sp);
    if (detail() && !X.spots.some(sp => sp.id === detail().id)) delete details[detailKey];
    if (detail()) detail().box = [...inspection(X.spots.find(sp => sp.id === detail().id))];
    c.resumeHere?.();
    S.nodes.__combo = (S.combos || []).map(k => k.then || []);
    S.nodes.__xp_seen = [{ think: X.seen || { en: "You've already checked this. Nothing new.", vi: "Chỗ này bạn xem kỹ rồi. Không có gì mới." } }];
    E.ui.hideBox(); E.ui.zoom(null);
    if (direct) E.ui.hide("*");
    const vis = id => R.used[c.key("v", id)];
    const spots = X.spots.filter(sp => !sp.if || cond(sp.if, c.s));
    const clues = spots.filter(sp => sp.clue);
    const found = () => clues.filter(sp => vis(sp.id)).length;
    const normalLayer = document.querySelector(".se-spots"), stage = document.querySelector(".se-stage"), rt = document.querySelector(".se");
    let layer = normalLayer, planeEl = null, backHost = null, ro = null, offPlane = null, offKey = null;
    const nm = id => esc(nat(S.items[id]?.name) || id);
    let sel = null, mode = "", msg = "", ask = false, over = false, bagOpen = false, goalOpen = false, firstDraw = true;
    const clean = () => { layer.onclick = normalLayer.onclick = null; layer.innerHTML = ""; normalLayer.style.bottom = normalLayer.style.top = ""; planeEl?.remove(); backHost?.remove(); ro?.disconnect(); offPlane?.(); offKey?.(); rt.classList.remove("xp-inspecting"); };
    c.onCancel?.(() => { over = true; clean(); res(); });
    const makePlane = () => {
      if (!direct) return true;
      const L = document.querySelector(".se-bgl.on"); if (!L || L.dataset.image !== imageId) return false;
      if (!planeEl?.isConnected || planeEl.parentElement !== L) {
        planeEl?.remove(); L.insertAdjacentHTML("beforeend", E.vbox(imageId, "", "zones xp-zones")); planeEl = L.querySelector(":scope > .xp-zones");
      }
      layer = planeEl.querySelector(".vbx");
      layer.onclick = e => { const b = e.target.closest("[data-sp]"); if (b) onSpot(b.dataset.sp); };
      if (!backHost) { backHost = h('<div class="se-xpnav"></div>'); rt.appendChild(backHost); backHost.onclick = () => backDetail(); }
      E.syncImagePlanes?.(L);
      return true;
    };
    const draw = () => {
      if (over || c.live?.() === false) return;
      if (!makePlane()) return;
      if (direct) E.ui.sceneProps?.(imageId, spots.filter(sp => typeof sp.art === "string").map(sp => ({ id: sp.id, art: sp.art, box: sp.artR ? E.regionOf(imageId, sp.artR)?.box || region(sp) : region(sp), rotate: sp.artRot, z: sp.z })));
      layer.innerHTML = spots.filter(sp => !detail() || sp.id === detail().id).map(sp => {
        const need = sp.use && R.used[c.key("t", sp.id)] && !R.used[c.key("u", sp.id)];
        if (direct) {
          const b = region(sp);
          return `<button class="pz${vis(sp.id) ? " seen" : ""}${need ? " need" : ""}${sel ? " aim" : ""}${sp.glint === false ? " ng" : ""}" data-sp="${esc(sp.id)}" data-zone-id="${esc(sp.id)}" data-seen="${vis(sp.id) ? "true" : "false"}" style="left:${b[0] + b[2] / 2}%;top:${b[1] + b[3] / 2}%;width:${b[2]}%;height:${b[3]}%;transform:translate(-50%,-50%);z-index:2" aria-label="${esc(L(sp.label))}${vis(sp.id) ? " · " + esc(nat({en:"examined",vi:"đã xem"})) : ""}"><span class="pz-l">${esc(L(sp.label))}</span></button>`;
        }
        return `<button class="se-spot${vis(sp.id) ? " seen" : ""}${need ? " need" : ""}${sp.clue ? " clue" : ""}${sel ? " aim" : ""}" data-sp="${sp.id}" style="left:${Math.max(10, Math.min(90, sp.x))}%;top:${Math.max(12, Math.min(64, sp.y))}%"><i></i><span>${esc(L(sp.label))}</span></button>`;
      }).join("");
      const n = found(), tot = clues.length, need = Math.min(X.need ?? 0, tot), ok = n >= need;
      const items = R.items.filter(id => id === sel || E.itemLive(id));
      const bag = items.map(id => `<button class="se-bi${sel === id ? " on" : ""}${mode && sel && sel !== id ? " pick" : ""}" data-it="${id}" aria-label="${nm(id)}">${E.itemArt(id, "sm")}</button>`).join("");
      const it = sel && S.items[sel];
      const card = it ? `<div class="se-hold"><span class="se-hia">${E.itemArt(sel, "sm")}</span><div><b>${nm(sel)}</b><small>${mode ? esc(nat({ en: "Now tap the item to combine it with.", vi: "Giờ chạm món muốn ghép cùng." })) : esc(nat({ en: "Tap a place in the scene to use it there.", vi: "Chạm vào một chỗ trên cảnh để dùng." }))}</small></div>
          <span class="se-hbtn">${(S.combos || []).length ? `<button class="se-btn sm${mode ? " on" : ""}" data-cmb>${esc(nat({ en: "Combine", vi: "Ghép" }))}</button>` : ""}<button class="se-ib sm" data-unsel aria-label="${T("close")}">${E.ICON.x}</button></span></div>` : "";
      const askHtml = ask ? `<div class="se-ask2"><b>${esc(nat({ en: `${tot - n} place${tot - n > 1 ? "s" : ""} not checked yet.`, vi: `Còn ${tot - n} chỗ chưa xem.` }))}</b><p>${esc(nat({ en: "Missing clues can make your deductions wrong. Leave anyway?", vi: "Thiếu manh mối có thể khiến bạn suy luận sai. Vẫn rời đi?" }))}</p><div class="se-row"><button class="se-btn" data-ask-no>${esc(nat({ en: "Keep searching", vi: "Xem tiếp" }))}</button><button class="se-btn pri" data-ask-yes>${esc(nat({ en: "Leave", vi: "Vẫn rời đi" }))}</button></div></div>` : "";
      if (direct) {
        rt.classList.toggle("xp-inspecting", !!detail());
        backHost.innerHTML = detail() ? `<button class="pl-detail-back" data-xp-back>${E.ICON.left}<span>${esc(nat({en:"Back",vi:"Lùi"}))}</span></button>` : "";
        const label = detail() ? X.spots.find(sp => sp.id === detail().id)?.label : S.scenes?.[imageId]?.name;
        const goal = detail() ? nat({en:"Tap the detail to inspect it again. Use Back to return to the scene.",vi:"Chạm chi tiết để xem lại. Bấm Lùi để trở về cảnh."}) : L(X.goal);
        const tag = detail() ? "div" : "button";
        E.ui.panel(`${askHtml || `<div class="pl-location"><span>${esc(nat(label) || "")}</span></div>${goalOpen && !detail() ? `<div class="pl-objective">${esc(goal)}</div>` : ""}${card}${msg ? `<div class="pl-msg" role="status">${msg}</div>` : ""}${items.length && (bagOpen || mode) ? `<div class="se-bag">${bag}</div>` : ""}<div class="pl-bar"><${tag} class="pl-goal compact"${detail() ? "" : ` data-xp-objective aria-expanded="${goalOpen}"`}><span>${esc(goal)}</span>${!detail() && tot ? `<b>${n}/${tot}</b>` : ""}${!detail() ? `<i aria-hidden="true">${E.ICON.down}</i>` : ""}</${tag}>${items.length ? `<button class="pl-ib${bagOpen ? " on" : ""}" data-xp-bag aria-expanded="${bagOpen}" aria-label="${esc(nat({en:"Bag",vi:"Túi đồ"}))}">${E.ICON.box}<i>${items.length}</i></button>` : ""}${!detail() && ok ? `<button class="se-btn pri pl-go" data-done>${esc(L(X.done) || T("cont"))}</button>` : ""}</div>`}`, "xp");
      } else E.ui.panel(`<div class="se-xg${sel || ask ? " one" : ""}"><span>${esc(L(X.goal))}</span>${tot ? `<b title="${esc(nat({ en: "Clues found", vi: "Manh mối đã tìm" }))}">${n}/${tot}</b>` : ""}</div>
        ${askHtml || `${card}${msg ? `<div class="se-xmsg">${msg}</div>` : ""}
        ${items.length ? `<div class="se-bagl">${esc(nat({ en: sel ? "Your bag — tap another item to switch" : "Your bag — tap an item to hold it", vi: sel ? "Túi đồ — chạm món khác để đổi" : "Túi đồ — chạm 1 món để cầm lên" }))}</div><div class="se-bag">${bag}</div>` : ""}
        <button class="se-btn pri wide${ok ? "" : " dim"}" data-done ${ok ? "" : "disabled"}>${ok ? esc(L(X.done) || T("cont")) : esc(nat({ en: `Find ${need - n} more clue${need - n > 1 ? "s" : ""}`, vi: `Cần thêm ${need - n} manh mối` }))}</button>`}`, "xp");
      fitSpots();
    };
    // các điểm nằm TRỌN phía trên bảng: cầm 1 món thì bảng cao lên (thẻ món + túi đồ) và từng che mất điểm ở thấp (người dùng 29/10, khỉ bấm bắt được)
    //   → co vùng điểm lại theo chiều cao bảng (đo offsetHeight — bảng đang trượt lên thì vị trí đo được chưa đúng)
    const lookDetail = (d, ms = 0) => {
      if (d.light) E.ui.zoom(d.box[0] + d.box[2] / 2, d.box[1] + d.box[3] / 2, d.light); else E.ui.zoom(null);
      E.ui.look(d.box, ms, true);
    };
    const fitSpots = (refocus = false) => {
      if (over || c.live?.() === false) return;
      if (direct) {
        const [iw, ih] = E.imgSize(imageId); rt.style.setProperty("--vale-scene-ar", String(iw / ih));
        E.ui.frame(imageId, spots.map(region), { top: 68, bottom: 105 }); E.syncImagePlanes?.();
        if (detail() && (firstDraw || refocus)) lookDetail(detail(), 0);
        firstDraw = false; return;
      }
      const p = document.querySelector(".se-ui .se-panel"), u = document.querySelector(".se-ui"), frameRoot = document.querySelector(".se");
      if (!p || !u || !frameRoot) return;
      const R0 = frameRoot.getBoundingClientRect(), tb = document.querySelector(".se-top")?.getBoundingClientRect();
      layer.style.bottom = Math.max(0, R0.bottom - u.getBoundingClientRect().bottom + p.offsetHeight + 8) + "px";
      // dưới thanh trên cùng (nút menu / sổ tay…) — vùng co lại thì 12 % chiều cao có thể lọt dưới thanh đó
      layer.style.top = tb && !document.querySelector(".se-top").hidden ? Math.max(0, tb.bottom - R0.top - 20) + "px" : "";
    };
    const finish = () => { if (over || c.live?.() === false) return; over = true; c.resumeHere?.(false); delete details[detailKey]; layer.innerHTML = ""; normalLayer.style.bottom = normalLayer.style.top = ""; backHost?.remove(); E.ui.clear(); E.ui.zoom(null); if (direct) E.ui.look(null, 350); res(); };
    const enterDetail = (sp, light) => {
      if (!direct || sp.inspect === false || sp.look === false) return;
      details[detailKey] = { id: sp.id, img: imageId, box: [...inspection(sp)], light };
      ask = false; lookDetail(detail(), 650);
    };
    const backDetail = () => {
      if (over || c.live?.() === false || !detail()) return;
      delete details[detailKey]; sel = null; mode = ""; msg = ""; bagOpen = false;
      E.ui.zoom(null); E.ui.look(null, 350); E.sfx("tap"); E.save(); draw();
    };
    // vào 1 điểm: cận cảnh chỗ đó (nền phóng vào điểm) rồi chạy các bước; xong các bước → khám phá chạy lại (again) và thu cận cảnh
    const runSpot = (sp, look, go) => { if (over || c.live?.() === false) return; over = true; c.resumeHere?.(false); layer.innerHTML = ""; normalLayer.style.bottom = normalLayer.style.top = ""; backHost?.remove(); E.ui.clear(); if (direct) { enterDetail(sp, look); E.syncImagePlanes?.(); if (detail()) lookDetail(detail(), 650); } else E.ui.zoom(sp.x, sp.y, look); c.again(); go(); res(); };
    const onSpot = id => {
      if (over || c.live?.() === false || (detail() && detail().id !== id) || !spots.some(sp => sp.id === id)) return;
      const i = X.spots.findIndex(s => s.id === id), sp = X.spots[i];
      if (direct && !detail()) enterDetail(sp, sp.dark ? (R.used[c.key("u", id)] ? "torch" : "dark") : "");
      if (sel) {
        const it = sel;
        // dùng đúng đồ = tìm ra manh mối của điểm này (điểm có `use` chỉ tính là đã tìm khi dùng đồ)
        // đã dùng đúng món này ở đây rồi → 1 câu “đã thử rồi”, không chạy lại cả cảnh
        if (sp.use?.[it] && R.used[c.key("ui", id, it)]) { sel = null; mode = ""; msg = esc(nat({ en: "You already tried that here.", vi: "Bạn đã thử món này ở đây rồi." })); return draw(); }
        if (sp.use?.[it]) R.used[c.key("ui", id, it)] = 1;
        if (sp.use?.[it]) { sel = null; mode = ""; msg = ""; R.used[c.key("v", id)] = 1; R.used[c.key("u", id)] = 1; return runSpot(sp, sp.dark ? "torch" : "", () => c.push("explore", "spots", i, "use", it)); }
        E.sfx("wrong");
        msg = esc(nat(X.noUse || { en: `${nat(S.items[it]?.name)} doesn't help at "${nat(sp.label)}".`, vi: `${nat(S.items[it]?.name)} không dùng được ở “${nat(sp.label)}”.` }));
        return draw();
      }
      const solved = !sp.use || R.used[c.key("u", id)];
      const n = (R.used[c.key("n", id)] = (+R.used[c.key("n", id)] || 0) + 1);
      const first = !vis(id) && !R.used[c.key("t", id)];
      if (solved) R.used[c.key("v", id)] = 1; else R.used[c.key("t", id)] = 1;
      msg = "";
      const look = sp.dark && !solved ? "dark" : sp.dark ? "torch" : "";
      // chạm lại chỗ CHƯA giải (vd. bậc thang tối, chưa dùng đèn pin) → stuck (gợi ý rõ hơn) hoặc lại then
      if (!first && !solved) return runSpot(sp, look, () => c.push("explore", "spots", i, sp.stuck ? "stuck" : "then"));
      if (!first && sp.again) return runSpot(sp, look, () => Array.isArray(sp.again[0]) ? c.push("explore", "spots", i, "again", (n - 2) % sp.again.length) : c.push("explore", "spots", i, "again"));
      if (!first && sp.clue && solved) return runSpot(sp, look, () => R.stack.push({ n: "__xp_seen", p: [], i: 0 }));
      if (sp.then) return runSpot(sp, look, () => c.push("explore", "spots", i, "then"));
      if (direct) E.save(); draw();
    };
    const onItem = id => {
      if (over || c.live?.() === false || !R.items.includes(id)) return;
      E.sfx("tap");
      if (mode && sel && sel !== id) {
        const a = sel, ci = (S.combos || []).findIndex(k => (k.a === a && k.b === id) || (k.b === a && k.a === id));
        mode = "";
        if (ci < 0) { msg = esc(nat({ en: `${nat(S.items[a]?.name)} and ${nat(S.items[id]?.name)} don't go together.`, vi: `${nat(S.items[a]?.name)} và ${nat(S.items[id]?.name)} không ghép được.` })); return draw(); }
        const k = S.combos[ci];
        if (R.used["cmb:" + ci]) { msg = esc(nat({ en: "You've already combined these.", vi: "Hai món này bạn ghép rồi." })); sel = null; return draw(); }
        R.used["cmb:" + ci] = 1;
        sel = null;
        if (k.make) { R.items = R.items.filter(x => x !== k.a && x !== k.b); R.items.push(k.make); sel = k.make; msg = `✓ ${esc(nat({ en: "New item:", vi: "Đồ mới:" }))} <b>${nm(k.make)}</b>`; E.sfx("item"); }
        if (k.then) { layer.innerHTML = ""; E.ui.clear(); c.again(); R.stack.push({ n: "__combo", p: [ci], i: 0 }); return res(); }
        return draw();
      }
      msg = ""; mode = "";
      sel = sel === id ? null : id;
      if (direct) bagOpen = false;
      draw();
    };
    layer.onclick = e => { const b = e.target.closest("[data-sp]"); if (b) onSpot(b.dataset.sp); };
    if (direct) {
      if (!detail()) E.ui.look(null, 0, true);
      const ready = E.curImg() === imageId ? E.ui.layerReady?.() : E.ui.scene(imageId, false);
      Promise.resolve(ready).then(() => { if (!over && c.live?.() !== false) draw(); });
      ro = globalThis.ResizeObserver ? new ResizeObserver(() => fitSpots(true)) : null; ro?.observe(stage);
      offPlane = E.on("image-plane", img => { if (img === imageId) fitSpots(true); });
      const onKey = e => { if (e.key === "Escape" && detail() && !document.querySelector(".se-sheet:not([hidden])")) { e.preventDefault(); backDetail(); } };
      addEventListener("keydown", onKey); offKey = () => removeEventListener("keydown", onKey);
    } else draw();
    document.querySelector(".se-ui").onclick = e => {
      if (over || c.live?.() === false) return;
      if (e.target.closest("[data-xp-objective]")) { goalOpen = !goalOpen; E.sfx("tap"); return draw(); }
      if (e.target.closest("[data-xp-bag]")) { bagOpen = !bagOpen; E.sfx("tap"); return draw(); }
      if (e.target.closest("[data-ask-yes]")) return finish();
      if (e.target.closest("[data-ask-no]")) { ask = false; E.sfx("tap"); return draw(); }
      if (e.target.closest("[data-done]")) { if (detail() || found() < Math.min(X.need ?? 0, clues.length)) return; if (found() < clues.length && !E.auto) { ask = true; sel = null; mode = ""; E.sfx("tap"); return draw(); } return finish(); }
      if (e.target.closest("[data-unsel]")) { sel = null; mode = ""; msg = ""; E.sfx("tap"); return draw(); }
      if (e.target.closest("[data-cmb]")) { mode = mode ? "" : "combine"; if (direct) bagOpen = !!mode; msg = ""; E.sfx("tap"); return draw(); }
      if (e.target.closest(".se-hia")) return sel && E.ui.itemView(sel);
      const it = e.target.closest("[data-it]"); if (it) onItem(it.dataset.it);
    };
    E.autoRun(() => {
      if (detail()) backDetail();
      // thử dùng đồ đúng chỗ → ghép đồ → xem điểm chưa xem
      const u = spots.find(sp => sp.use && !R.used[c.key("u", sp.id)] && Object.keys(sp.use).some(it => R.items.includes(it)));
      if (u) { sel = Object.keys(u.use).find(it => R.items.includes(it)); return onSpot(u.id); }
      const k = (S.combos || []).find(k => R.items.includes(k.a) && R.items.includes(k.b));
      if (k) { sel = k.a; mode = "combine"; return onItem(k.b); }
      const nx = spots.find(sp => !vis(sp.id) && !R.used[c.key("t", sp.id)]);
      nx ? onSpot(nx.id) : finish();
    });
  }));

  // ───────── SUY LUẬN: câu hỏi của vụ án → chọn 2 manh mối (đồ vật / ghi chú trong hồ sơ) → nối ─────────
  // { deduce: { q, a: [id, id] (không cần thứ tự) | [[id,id], [id,id]] (nhiều cặp đúng), hint, tries, ok, fail } }
  def("deduce", (c) => new Promise(res => {
    const D = c.st.deduce, R = E.R(), S = E.S();
    c.resumeHere?.();
    const pairs = Array.isArray(D.a[0]) ? D.a : [D.a];
    const available = () => pairs.find(p => p.length === 2 && p.every(id => R.items.includes(id)));
    let tries = 0, warned = !!available(), bad = false, done = false, tm = 0, query = "", showAll = !Array.isArray(D.cards), category = "all";
    const slot = [null, null], live = () => !c.live || c.live();
    // Search only the names/descriptions of owned clues, in every supplied language.
    // Updating the grid alone keeps the input, caret and mobile keyboard in place.
    const fold = text => String(text || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d").replace(/\s+/g, " ").trim();
    const textOf = value => typeof value === "string" ? value : Object.values(value || {}).filter(v => typeof v === "string").join(" ");
    const matching = () => {
      const words = fold(query).split(" ").filter(Boolean);
      const pool = showAll || words.length ? R.items : R.items.filter(id => D.cards.includes(id));
      return pool.filter(id => { const it = S.items[id], text = fold(textOf(it?.name) + " " + textOf(it?.desc)), group = E.evidenceMeta?.(id)?.group || (it?.kind === "testimony" ? "testimony" : "objects"); return (category === "all" || group === category) && words.every(word => text.includes(word)); });
    };
    const cards = ids => ids.map(id => `<button class="se-ddc${slot.includes(id) ? " on used" : ""}" data-c="${esc(id)}" aria-pressed="${slot.includes(id)}">${E.itemArt(id, "sm")}<b>${investigationText(S.items[id]?.name)}</b><small>${investigationText(S.items[id]?.brief || S.items[id]?.desc)}</small></button>`).join("");
    const searchStatus = count => nat(count ? { en: `${count} of ${R.items.length} clues`, vi: `${count}/${R.items.length} manh mối` } : { en: "No clues match. Try another name or description.", vi: "Không tìm thấy manh mối. Thử tên hoặc mô tả khác." });
    const filterCards = el => {
      const ids = matching();
      el.querySelector(".se-ddg").innerHTML = cards(ids);
      el.querySelector("[data-deduce-search-status]").textContent = searchStatus(ids.length);
      el.querySelector("[data-deduce-clear]").disabled = !query;
    };
    c.onCancel?.(() => { done = true; clearTimeout(tm); res(); });
    E.ui.hideBox();
    const head = () => `<div class="se-dd"><div class="se-ddh">${E.ICON.bulb}<small>${esc(nat({ en: "Deduction", vi: "Suy luận" }))}</small></div><b class="se-ddq">${investigationText(D.q)}</b>`;
    const nextK = () => slot.indexOf(null);
    const finish = (ok, delay = 0) => {
      if (done || !live()) return; done = true; c.resumeHere?.(false);
      if (ok ? D.ok : D.fail) c.push("deduce", ok ? "ok" : "fail");
      const go = () => { if (!live()) return res(); E.ui.clear(); res(); };
      if (delay && !E.auto) tm = setTimeout(go, delay); else go();
    };
    const draw = (msg = "") => {
      if (done || !live()) return;
      const left = D.tries ? Math.max(0, D.tries - tries) : 0, ids = matching();
      const el = !warned
        ? E.ui.panel(`${head()}</div><div class="se-ask2 warn"><b>${investigationText({ en: "You don't have enough clues to answer this for sure.", vi: "Bạn chưa đủ manh mối để trả lời chắc chắn." })}</b><p>${investigationText(D.missing || { en: "You may have missed something during the search.", vi: "Có thể bạn đã bỏ sót một chỗ khi khám xét." })}</p><div class="se-row"><button class="se-btn" data-skip>${esc(nat({ en: "Skip", vi: "Bỏ qua" }))}</button><button class="se-btn pri" data-try>${esc(nat({ en: "Try anyway", vi: "Vẫn thử" }))}</button></div></div>`, "deduce")
        : E.ui.panel(`${head()}<p class="se-mute">${investigationText({ en: "Drag or tap two clues into the slots. Check the pair, then confirm.", vi: "Kéo hoặc chạm để đặt hai manh mối vào ô. Xem lại cặp đã chọn rồi xác nhận." })}${D.tries ? ` · ${esc(nat({ en: `${left} tries left`, vi: `Còn ${left} lượt thử` }))}` : ""}</p></div>
        <div class="se-eq${bad ? " bad" : ""}">${[0, 1].map(k => { const id = slot[k]; return `<button class="se-eqs${id ? " on" : ""}${k === nextK() ? " next" : ""}" data-slot="${k}" aria-label="${esc(nat(id ? { en: `Remove ${nat(S.items[id]?.name)}`, vi: `Gỡ ${nat(S.items[id]?.name)}` } : { en: `Clue ${k + 1}`, vi: `Manh mối ${k + 1}` }))}">${id ? `${E.itemArt(id, "sm")}<b>${investigationText(S.items[id]?.name)}</b>` : `<small>${esc(nat({ en: `Clue ${k + 1}`, vi: `Manh mối ${k + 1}` }))}</small>`}</button>`; }).join("<b class='se-eqo'>+</b>")}<b class="se-eqo">→</b><span class="se-eqq">?</span></div>
        ${Array.isArray(D.cards) ? `<div class="se-deduce-focus"><span>${esc(nat(showAll ? { en: "All records from this route", vi: "Toàn bộ hồ sơ của lượt này" } : { en: "A few records to start with", vi: "Một nhóm hồ sơ để bắt đầu" }))}</span><button class="se-btn sm" data-deduce-scope aria-pressed="${showAll}">${esc(nat(showAll ? { en: "Focus", vi: "Thu gọn" } : { en: `All ${R.items.length} records`, vi: `Tất cả ${R.items.length} hồ sơ` }))}</button></div>` : ""}
        ${E.evidenceMeta ? `<div class="se-deduce-categories" role="group" aria-label="Evidence type · Loại chứng cứ">${[["all", { en: "All", vi: "Tất cả" }], ["objects", { en: "Objects / traces", vi: "Đồ vật / dấu vết" }], ["testimony", { en: "Testimony", vi: "Lời khai" }]].map(([id, label]) => `<button class="se-btn sm${category === id ? " on" : ""}" data-deduce-category="${id}" aria-pressed="${category === id}">${esc(nat(label))}</button>`).join("")}</div>` : ""}
        <div style="display:grid;gap:6px;margin:0 0 10px"><label class="se-mute" for="se-deduce-search" style="margin:0;font-size:13.5px">${esc(nat({ en: "Find evidence", vi: "Tìm bằng chứng" }))}</label><div class="se-row" style="margin:0;flex-wrap:nowrap"><input id="se-deduce-search" class="se-in" type="search" data-deduce-search autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" style="min-width:0;flex:1;min-height:44px;font-size:16px" placeholder="${esc(nat({ en: "Name or description · EN / VI", vi: "Tên hoặc mô tả · EN / VI" }))}" value="${esc(query)}"><button class="se-btn sm" data-deduce-clear style="flex:none;min-height:44px" ${query ? "" : "disabled"}>${esc(nat({ en: "Clear", vi: "Xóa" }))}</button></div><small class="se-mute" data-deduce-search-status role="status" aria-live="polite">${esc(searchStatus(ids.length))}</small></div>
        <div class="se-ddg">${cards(ids)}</div>
        ${msg}<button class="se-btn pri wide" data-deduce-confirm ${slot.every(Boolean) ? "" : "disabled"}>${esc(nat({ en: "Confirm connection", vi: "Xác nhận liên hệ" }))}</button>`, "deduce");
      el.onclick = e => {
        if (done || !live()) return;
        if (e.target.closest("[data-skip]")) return finish(false);
        if (e.target.closest("[data-try]")) { warned = true; E.sfx("tap"); return draw(); }
        if (E.dragged?.()) return;
        if (e.target.closest("[data-deduce-scope]")) { showAll = !showAll; E.sfx("tap"); return draw(); }
        const cat = e.target.closest("[data-deduce-category]"); if (cat) { category = cat.dataset.deduceCategory; el.querySelectorAll("[data-deduce-category]").forEach(b => { const on = b === cat; b.classList.toggle("on", on); b.setAttribute("aria-pressed", String(on)); }); filterCards(el); return; }
        if (e.target.closest("[data-deduce-clear]")) { query = ""; const input = el.querySelector("[data-deduce-search]"); input.value = ""; filterCards(el); input.focus({ preventScroll: true }); return; }
        if (e.target.closest("[data-deduce-confirm]")) return check();
        const sl = e.target.closest("[data-slot]"); if (sl && slot[+sl.dataset.slot]) { slot[+sl.dataset.slot] = null; E.sfx("tap"); return draw(); }
        const b = e.target.closest("[data-c]");
        if (b) { const id = b.dataset.c; if (slot.includes(id)) { slot[slot.indexOf(id)] = null; E.sfx("tap"); return draw(); } if (nextK() < 0) return; put(nextK(), id); }
      };
      el.oninput = e => { if (done || !live() || !e.target.matches("[data-deduce-search]")) return; query = e.target.value; filterCards(el); };
      el.onpointerdown = E.dragger?.({ src: "[data-c]", dst: "[data-slot]", drop: (a, d) => { if (!d || done || !live()) return; const k = +d.dataset.slot, id = a.dataset.c; if (slot.includes(id)) slot[slot.indexOf(id)] = null; put(k, id); } });
    };
    const put = (k, id) => { if (done || !live()) return; slot[k] = id; E.sfx("pick"); E.haptic("LIGHT"); draw(); };
    const check = () => {
      if (done || !live() || !slot.every(Boolean) || slot[0] === slot[1]) return;
      tries++;
      const ok = pairs.some(p => p.length === 2 && p.every(id => slot.includes(id)));
      if (ok) {
        E.ui.fx("solve"); E.sfx("solve"); E.haptic("MEDIUM"); E.add("deduced", 1);
        const q = document.querySelector(".se-eqq"); if (q) q.textContent = "✓";
        document.querySelector(".se-eq")?.classList.add("ok"); E.fxBurst?.(document.querySelector(".se-eq"), "#ffd166", 18);
        document.querySelectorAll(".se-ui button").forEach(b => b.disabled = true);
        return finish(true, 900);
      }
      E.ui.fx("shake"); E.sfx("wrong");
      if (D.tries && tries >= D.tries) return finish(false);
      slot[0] = slot[1] = null; bad = true; E.haptic("HEAVY");
      draw(`<div class="se-hint no" role="status">${investigationText({ en: "Those two don't explain it.", vi: "Hai manh mối đó không giải thích được." })}${D.hint ? `<p>${E.ICON.bulb}${investigationText(D.hint)}</p>` : ""}</div>`); bad = false;
    };
    draw();
    E.autoRun(() => { const p = available(); if (!p) return finish(false); slot[0] = p[0]; slot[1] = p[1]; check(); });
  }));

  // ───────── BẢN ĐỒ: chọn hướng đi / nơi đến ─────────
  // { map: { goal, img?, places: [{ id, x, y, label, desc, go | then, if, need, lockHint, once }] } }
  def("map", (c) => new Promise(res => {
    const { st, s } = c, M = st.map, R = E.R();
    c.resumeHere?.();
    E.ui.hideBox();
    const ps = (M.places || []).map((p, i) => ({ p, i })).filter(({ p }) => !p.if || cond(p.if, s)).filter(({ p, i }) => !(p.once && R.used[c.key(i)]));
    const usable = ps.filter(({ p }) => !p.need || cond(p.need, s));
    if (!usable.length) {
      let closed = false;
      const branch = Array.isArray(M.empty) ? "empty" : Array.isArray(M.fail) ? "fail" : null;
      const finish = () => {
        if (closed || c.live?.() === false) return;
        closed = true; c.resumeHere?.(false); E.ui.clear();
        if (branch) c.push("map", branch);
        res();
      };
      const empty = E.ui.panel(`<div class="se-ask" role="status">${esc(nat({ en: "No destination is available right now. You can continue without moving.", vi: "Hiện chưa có nơi nào có thể đến. Bạn có thể tiếp tục mà không di chuyển." }))}</div><button class="se-btn pri wide" data-unavailable>${T("cont")}</button>`, "map");
      empty.onclick = e => { if (e.target.closest("[data-unavailable]")) finish(); };
      c.onCancel?.(() => { closed = true; res(); });
      E.autoRun(finish);
      return;
    }
    const el = E.ui.panel(`<div class="se-map"${M.img ? ` style="background-image:url('${esc(M.img)}')"` : ""}>
      <div class="se-xg"><span>${esc(L(M.goal))}</span></div>
      ${ps.map(({ p, i }) => { const lock = p.need && !cond(p.need, s); const seen = R.used[c.key("v", i)]; return `<button class="se-pl${lock ? " lock" : ""}${seen ? " seen" : ""}" data-i="${i}" style="left:${p.x}%;top:${p.y}%" ${lock ? "disabled" : ""}><i></i><b>${esc(L(p.label))}</b>${p.desc ? `<small>${esc(L(p.desc))}</small>` : ""}${lock && p.lockHint ? `<small>${E.ICON.lock}${esc(L(p.lockHint))}</small>` : ""}</button>`; }).join("")}
    </div>`, "map");
    let done = false;
    const go = i => {
      if (done || c.live?.() === false) return; done = true; c.resumeHere?.(false);
      const p = M.places[i]; E.ui.clear(); R.used[c.key("v", i)] = 1; if (p.once) R.used[c.key(i)] = 1;
      E.apply(p);
      if (p.then) { if (M.loop) c.again(); c.push("map", "places", i, "then"); }
      if (p.go) E.jump(p.go);
      res();
    };
    el.onclick = e => { const b = e.target.closest("[data-i]"); if (b && !b.disabled) go(+b.dataset.i); };
    E.autoRun(() => { const x = pick(usable); go(x.i); });
  }));

  // NÚT GỐC | DỊCH dùng chung cho giấy tờ (sổ tay, biên bản, dòng thời gian): đổi cả trang sang bản dịch rồi đổi lại
  //   (người dùng 29/10: ghi sổ tay / ký biên bản không có chỗ bấm dịch). Nhớ lựa chọn ở G.set.docTr.
  const docTx = x => (x == null ? "" : E.tgt(x));
  const docTr = x => E.sub(x);
  const trSeg = (on, has = true) => (has ? `<span class="se-trs" role="group"><button data-trv="0" class="${on ? "" : "on"}">${esc(E.langName(E.L))}</button><button data-trv="1" class="${on ? "on" : ""}">${esc(E.langName(E.N))}</button></span>` : "");
  // chữ của 1 dòng: bản dịch (nếu đang bật và có) — kèm bản gốc nhỏ bên dưới để vẫn thấy chữ thật
  const docLine = (x, tr) => { const t = docTr(x); return tr && t ? `<span class="se-dl tr">${esc(t)}</span><small class="se-dlo">${esc(docTx(x))}</small>` : `<span class="se-dl">${esc(docTx(x))}</span>`; };
  E.doc = { tx: docTx, tr: docTr, seg: trSeg, line: docLine };

  // ───────── PHIÊN DỊCH / GHI SỔ: rec = ghi lời nhân chứng vào sổ tay · e2v = nghe tiếng học → nói lại bằng tiếng mẹ đẻ · v2e = ngược lại ─────────
  // { interpret: { dir: "rec"|"v2e"|"e2v", to, prompt, key, opts: [{ t: "…" | { en, vi }, acc: 0|1|2, set, add, then }], why } }
  def("interpret", (c) => new Promise(res => {
    const { st } = c, I = st.interpret, R = E.R(), G = E.G();
    const src = R.last || { text: "" };
    const outLang = I.dir === "e2v" ? E.N : E.L;
    const tOf = o => E.fill(typeof o.t === "string" ? o.t : o.t?.[outLang] ?? o.t?.en ?? "");
    const order = shuffle(I.opts, c.key());
    const hasTr = outLang === E.L && E.N !== E.L && (I.opts.some(o => docTr(o.t)) || src.sub);
    let tr = !!G.set.docTr && hasTr;
    E.ui.hideBox();
    const head = I.dir === "rec" ? nat({ en: "Write it in your notebook", vi: "Ghi vào sổ tay" }) : I.dir === "e2v" ? nat({ en: "Interpret into your language", vi: "Dịch cho người nghe" }) : nat({ en: "Interpret", vi: "Phiên dịch" });
    const draw = () => {
      const el = E.ui.panel(`<div class="se-int-h">${E.ICON.pen}<b>${esc(head)}</b>${trSeg(tr, hasTr)}${I.key ? `<em>${esc(L(I.prompt) || "")}</em>` : ""}</div>
        <blockquote class="se-src">${tr && src.sub ? `${esc(String(src.sub).replace(/\[\[|\]\]/g, ""))}<small class="se-dlo">${esc(String(src.text).replace(/\[\[|\]\]/g, ""))}</small>` : E.words(src.text, src.lang)}</blockquote>
        <div class="se-chs">${order.map(([o, i]) => { const t = tr ? docTr(o.t) : ""; return `<button class="se-ch-b tr" data-i="${i}"><span class="se-ln">${esc(t || tOf(o))}</span>${t ? `<small class="se-ln o">${esc(tOf(o))}</small>` : ""}</button>`; }).join("")}</div>`, "interp" + (I.key ? " key" : ""));
      return el;
    };
    let done = false;
    const go = async i => {
      if (done || c.live?.() === false) return; done = true;
      const o = I.opts[i], best = I.opts.reduce((a, b) => ((b.acc || 0) > (a.acc || 0) ? b : a));
      E.ui.clear();
      E.add("acc", o.acc || 0); E.add("accN", 2);
      R.notes.push({ ch: R.ch, dir: I.dir, src: src.text, srcLang: src.lang, pick: tOf(o), best: tOf(best), acc: o.acc || 0, why: I.why || null });
      E.apply(o);
      await E.ui.line({ who: "me", kind: "say", main: tOf(o), sub: outLang === E.L ? docTr(o.t) : "", lang: outLang, tag: I.dir === "rec" ? nat({ en: "notebook", vi: "sổ tay" }) : I.dir === "e2v" ? "→ " + E.cname(E.S().chars[I.to] || {}, true) : nat({ en: "interpreting", vi: "dịch" }), cls: I.dir === "rec" ? "note" : "interp" });
      if (c.live?.() === false) return res();
      if (G.set.mode === "easy" || E.auto) {
        const a = o.acc || 0, lab = a === 2 ? nat({ en: "Accurate", vi: "Chính xác" }) : a === 1 ? nat({ en: "Close", vi: "Gần đúng" }) : nat({ en: "Meaning changed", vi: "Lệch nghĩa" });
        if (!E.auto) await feedback(`<div class="se-fb a${a}"><b>${a === 2 ? "✓" : a === 1 ? "≈" : "✗"} ${esc(lab)}</b>${a < 2 ? `<p>${esc(nat({ en: "Better:", vi: "Nên dịch:" }))} <i>${esc(tOf(best))}</i></p>` : ""}${I.why ? `<p>${esc(L(I.why))}</p>` : ""}</div>`, c);
      } else E.sfx("page");
      if (c.live?.() === false) return res();
      if (o.then) c.push("interpret", "opts", i, "then");
      res();
    };
    draw();
    document.querySelector(".se-ui").onclick = e => {
      const v = e.target.closest("[data-trv]");
      if (v) { e.stopPropagation(); tr = v.dataset.trv === "1"; G.set.docTr = tr; E.save(); E.sfx("tap"); return draw(); }
      if (e.target.closest(".w")) return;
      const b = e.target.closest("[data-i]"); if (b) go(+b.dataset.i);
    };
    E.autoRun(() => go(pick(order)[1]));
  }));
  const feedback = (html, c) => new Promise(r => { let done = false; c?.onCancel?.(() => { done = true; r(); }); const el = E.ui.panel(`${html}<button class="se-btn pri wide" data-ok>${T("cont")}</button>`, "fbk"); el.onclick = e => { e.stopPropagation(); if (!done && c?.live?.() !== false && e.target.closest("[data-ok]")) { done = true; E.ui.clear(); r(); } }; });
  E.feedback = feedback;

  // ───────── VẠCH LỜI KHAI: chạm dòng sai → đưa bằng chứng; ký = kết thúc ─────────
  // { present: { title, goal, segs: [{ t: "…" | { en, vi }, fix, bad, evidence, ok, same }], sign, wrong, noEvidence } }
  // 29/10 (người dùng: khó hiểu, bấm nhầm là hội thoại chạy tiếp, không có chỗ dịch):
  //   3 bước hiện rõ ở đầu (chạm dòng sai → đưa bằng chứng → ký) · chạm dòng = ô bằng chứng mở NGAY dưới dòng đó (+ Huỷ) ·
  //   dòng đã sửa: chữ cũ gạch ngang + chữ mới · nút Gốc | Dịch đổi cả biên bản sang bản dịch · KÝ PHẢI XÁC NHẬN (ký rồi không sửa được).
  def("present", (c) => new Promise(res => {
    const { st, s } = c, P = st.present, R = E.R(), S = E.S(), G = E.G();
    E.ui.hideBox();
    const friendly = !!S.playability?.inlineEvidence;
    const saved = friendly ? ((R.presentUI ||= {})[c.key()] ||= {sel:-1, filter:'relevant', query:'', tried:{}, attempts:0,hints:0}) : null;
    let sel = saved?.sel ?? -1, ask = false, query = saved?.query || "", category = saved?.filter || "all", feedback = null;
    if (sel < -1 || sel >= P.segs.length || (sel >= 0 && R.used[c.key("fix",sel)])) sel = -1;
    if(friendly)c.resumeHere?.();
    const keep = () => { if(saved)Object.assign(saved,{sel,filter:category,query}); };
    const feedbackHTML=friendly?'<div class="v8-present-feedback" tabindex="-1" role="status" aria-live="polite" hidden></div>':'';
    const hasTr = E.N !== E.L && P.segs.some(g => docTr(g.t));
    let tr = !!G.set.docTr && hasTr;
    const fixed = i => R.used[c.key("fix", i)];
    const records = () => E.bag().slice().reverse();
    const foldRecord = t => String(t || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d");
    const recordText = t => typeof t === "string" ? t : Object.values(t || {}).filter(x => typeof x === "string").join(" ");
    const filterLabels = [
      ['relevant',{en:'Case shortlist',vi:'Nhóm liên quan'}],['all',{en:'All',vi:'Tất cả'}],
      ['objects',{en:'Objects / traces',vi:'Đồ vật / dấu vết'}],['testimony',{en:'Statements',vi:'Lời khai'}],
      ['recent',{en:'Newest 6',vi:'6 hồ sơ mới'}],['untried',{en:'Not tried',vi:'Chưa thử'}]
    ];
    const searchBox = () => `${friendly ? `<div class="v8-ev-filters" role="group" aria-label="Evidence filters · Bộ lọc chứng cứ">${filterLabels.map(([id,l])=>`<button class="se-btn sm${category===id?' on':''}" data-present-filter="${id}" aria-pressed="${category===id}">${esc(nat(l))}</button>`).join('')}</div>` : ''}<label class="se-present-search"><span>${esc(nat({en:"Find evidence · newest first",vi:"Tìm chứng cứ · mới nhất trước"}))}</span><input class="se-in" type="search" data-present-search autocomplete="off" spellcheck="false" value="${esc(query)}" placeholder="${esc(nat({en:"Name or description · EN / VI",vi:"Tên hoặc mô tả · EN / VI"}))}"></label><small data-present-count role="status" aria-live="polite"></small>`;
    const filterRecords = () => {
      const words = foldRecord(query).trim().split(/\s+/).filter(Boolean), els = [...document.querySelectorAll('.se-panel.present [data-ev],.se-panel.present [data-evd]')]; let shown = 0;
      const recent=records().slice(0,6), shortlist=P.shortlist?.filter(id=>R.items.includes(id)) || [];
      els.forEach(el => { const id=el.dataset.ev || el.dataset.evd,it=S.items[id],meta=E.evidenceMeta?.(id); const text = foldRecord(recordText(it?.name) + " " + recordText(it?.desc));
        const match=!friendly || category==='all' || (category==='relevant' ? !shortlist.length || shortlist.includes(id) : category==='recent' ? recent.includes(id) : category==='untried' ? !(saved?.tried[sel]||[]).includes(id) : meta?.group===category);
        el.hidden = !match || !words.every(w => text.includes(w));
        el.classList.toggle('v8-tried', !!saved?.tried[sel]?.includes(id));
        if (!el.hidden) shown++;
      });
      const status = document.querySelector('.se-panel.present [data-present-count]'); if (status) status.textContent = nat(shown ? {en:`${shown} of ${els.length} records. A shortlist is not an answer.`,vi:`${shown}/${els.length} hồ sơ. Nhóm liên quan không đồng nghĩa đáp án.`} : {en:"No matching records. Choose All or clear the search.",vi:"Không có hồ sơ phù hợp. Chọn Tất cả hoặc xóa từ tìm kiếm."});
      keep();
    };
    const inlineFeedback = (announce=false) => {
      const box=document.querySelector('.se-panel.present .v8-present-feedback');if(!box)return;
      if(!feedback){box.hidden=true;return;}box.hidden=false;box.dataset.good="false";
      const who=P.feedbackWho && S.chars[P.feedbackWho] ? E.cname(S.chars[P.feedbackWho],true) : 'Adrian Vale';
      box.innerHTML=`<b>${esc(who)}${P.feedbackWho?'':' · '+esc(nat({en:'Thinking',vi:'Suy nghĩ'}))}</b><p>${esc(nat(feedback))}</p><small>${esc(nat({en:'You are still checking the same statement. No scene has changed.',vi:'Vẫn đang đối chiếu lời khai này. Chưa chuyển cảnh.'}))}</small>`;
      if(announce){box.scrollIntoView({block:'nearest',behavior:'instant'});box.focus({preventScroll:true});}
    };
    const draw = () => {
      const step = ask ? 3 : sel >= 0 ? 2 : 1;
      const steps = [{ en: "Tap a wrong line", vi: "Chạm dòng sai" }, { en: "Show evidence", vi: "Đưa bằng chứng" }, { en: "Sign", vi: "Ký" }].map((t, k) => `<span class="${k + 1 === step ? "on" : ""}"><em>${k + 1}</em>${esc(nat(t))}</span>`).join("");
      E.ui.panel(`<div class="se-doc"><div class="se-doch">${E.ICON.doc}<b>${esc(L(P.title))}</b></div>
        ${P.goal || hasTr ? `<div class="se-dgoal"><span>${esc(L(P.goal) || "")}</span>${trSeg(tr, hasTr)}</div>` : ""}
        <div class="se-steps">${steps}</div>
        ${friendly?`<p class="v8-task-hint">${esc(nat({en:'Read a statement → choose it → compare one record. You may retry before signing.',vi:'Đọc lời khai → chọn câu cần kiểm tra → đối chiếu một hồ sơ. Có thể thử lại trước khi ký.'}))}</p>`:''}
        ${P.segs.map((g, i) => {
          if (fixed(i) && g.fix) return `<div class="se-seg-l fixed"><s>${esc(tr && docTr(g.t) ? docTr(g.t) : docTx(g.t))}</s>${docLine(g.fix, tr)}</div>`;
          const line = `<button class="se-seg-l${sel === i ? " on" : ""}" data-s="${i}">${docLine(g.t, tr)}</button>`;
          if (sel !== i) return line;
          return line + `<div class="se-ev">${feedbackHTML}<small>${esc(nat({ en: "Which evidence proves this line is wrong?", vi: "Bằng chứng nào cho thấy dòng này sai?" }))}</small>${searchBox()}<div class="se-bag">${records().map(id => `<button class="se-bi lg" data-ev="${id}">${E.itemArt(id, "md")}<small>${esc(nat(S.items[id]?.name))}</small></button>`).join("")}</div><button class="se-btn sm" data-cancel>${esc(nat({ en: "Cancel", vi: "Huỷ" }))}</button></div>`;
        }).join("")}
        </div>
        ${!ask && sel < 0 && !friendly ? `<div class="se-evt"><small>${esc(nat({ en: "Evidence — drag onto a false line", vi: "Bằng chứng — kéo thả lên dòng sai" }))}</small>${searchBox()}<div>${records().map(id => `<button class="se-evi" data-evd="${id}">${E.itemArt(id, "sm")}<b>${esc(nat(S.items[id]?.name))}</b></button>`).join("")}</div></div>` : ""}
        ${friendly && sel>=0 ? `<button class="se-btn sm v8-hint-btn" data-present-hint>${esc(nat({en:'Ask for a hint',vi:'Xin gợi ý'}))}</button>`:''}
        ${ask ? `<div class="se-ask2"><b>${esc(nat({ en: "Sign this statement?", vi: "Ký biên bản này?" }))}</b><p>${esc(nat({ en: "Once you sign, you can't change it.", vi: "Ký rồi thì không sửa được nữa." }))}</p><div class="se-row"><button class="se-btn" data-ask-no>${esc(nat({ en: "Read again", vi: "Đọc lại" }))}</button><button class="se-btn pri" data-ask-yes>${esc(L(P.sign) || nat({ en: "Sign", vi: "Ký tên" }))}</button></div></div>`
          : `<button class="se-btn wide" data-sign>${E.ICON.pen} ${esc(L(P.sign) || nat({ en: "Nothing else is wrong — sign it", vi: "Không còn chỗ sai — ký tên" }))}</button>`}`, "present");
      const input = document.querySelector('.se-panel.present [data-present-search]'); if (input) input.oninput = e => { query = e.target.value; filterRecords(); }; filterRecords(); inlineFeedback();
    };
    const after = (steps) => { E.ui.clear(); c.again(); steps(); res(); };
    const onEv = id => {
      const i = sel, g = P.segs[i]; if(!g)return;
      if(friendly && (!cond(g.bad,s) || (g.evidence && id!==g.evidence))){
        saved.attempts++;(saved.tried[i] ||= []);if(!saved.tried[i].includes(id))saved.tried[i].push(id);
        feedback=!cond(g.bad,s)?{en:'This sentence agrees with what we know. Let us check another claim before changing it.',vi:'Câu này phù hợp với điều ta đã biết. Hãy kiểm tra nhận định khác trước khi sửa.'}:{en:'This record does not directly contradict the selected sentence. Compare what it actually establishes, not just a shared name.',vi:'Hồ sơ này chưa trực tiếp bác được câu đang chọn. Hãy đối chiếu điều nó thực sự chứng minh, không chỉ tên người giống nhau.'};
        E.sfx('wrong');keep();filterRecords();inlineFeedback(true);E.save();return;
      }
      sel = -1;feedback=null;keep();
      if (!cond(g.bad, s)) return after(() => (g.same ? c.push("present", "segs", i, "same") : R.stack.push({ n: "__present_wrong", p: [], i: 0 })));
      if (g.evidence && id !== g.evidence) return after(() => R.stack.push({ n: "__present_noev", p: [], i: 0 }));
      R.used[c.key("fix", i)] = 1;
      E.ui.fx("objection");
      after(() => c.push("present", "segs", i, "ok"));
    };
    // lời “sai rồi” / “chưa đủ bằng chứng” dùng chung — gắn tạm vào nodes
    S.nodes.__present_wrong = P.wrong || [];
    S.nodes.__present_noev = P.noEvidence || [];
    draw();
    document.querySelector(".se-ui").onpointerdown = E.dragger?.({ src: "[data-evd]", dst: "[data-s]", drop: (a, d) => { if (!d) return; sel = +d.dataset.s; onEv(a.dataset.evd); } });
    document.querySelector(".se-ui").onclick = e => {
      const filter=e.target.closest('[data-present-filter]');if(filter){category=filter.dataset.presentFilter;keep();return draw();}
      if(e.target.closest('[data-present-hint]')){
        const g=P.segs[sel], list=cond(g?.bad,s)?P.noEvidence:P.wrong, line=list?.find(x=>x.say||x.think||x.n);
        feedback=P.hints?.length?P.hints[Math.min(saved.hints||0,P.hints.length-1)]:line?.en?{en:line.en,vi:line.vi}:line?.think||line?.n||{en:'Ask: who observed this, and what does that observation actually rule out?',vi:'Hãy hỏi: ai quan sát điều này, và quan sát ấy thực sự loại trừ được điều gì?'};
        saved.hints=(saved.hints||0)+1;E.save();return inlineFeedback(true);
      }
      const v = e.target.closest("[data-trv]");
      if (v) { tr = v.dataset.trv === "1"; G.set.docTr = tr; E.save(); E.sfx("tap"); return draw(); }
      if (e.target.closest("[data-ask-yes]")) { E.ui.clear(); return res(); }
      if (e.target.closest("[data-ask-no]")) { ask = false; E.sfx("tap"); return draw(); }
      if (e.target.closest("[data-sign]")) { ask = true; sel = -1; feedback=null;keep(); E.sfx("tap"); return draw(); }
      if (e.target.closest("[data-cancel]")) { sel = -1; feedback=null;keep(); E.sfx("tap"); return draw(); }
      if (E.dragged?.()) return;
      const ev = e.target.closest("[data-ev]"); if (ev) return onEv(ev.dataset.ev);
      const evd = e.target.closest("[data-evd]"); if (evd) { if (sel >= 0) return onEv(evd.dataset.evd); E.sfx("wrong"); const t = document.querySelector(".se-evt small"); if (t) { t.textContent = nat({ en: "First tap the line you think is false.", vi: "Chạm vào dòng bạn cho là sai trước đã." }); t.classList.add("warn"); } return; }
      if (e.target.closest(".w") && !e.target.closest("[data-s]")) return;
      const sg = e.target.closest("[data-s]"); if (sg) { sel = +sg.dataset.s === sel ? -1 : +sg.dataset.s; ask = false; feedback=null;keep(); E.sfx("tap"); return draw(); }
    };
    E.autoRun(() => {
      const i = P.segs.findIndex((g, k) => !fixed(k) && cond(g.bad, s));
      if (i < 0) { E.ui.clear(); return res(); }
      sel = i; onEv(P.segs[i].evidence || R.items[0]);
    });
  }));

  // ───────── NGHE (không chữ) + CÂU HỎI ─────────
  const qflow = (c, Q, withAudio) => new Promise(res => {
    const R = E.R();
    // busy = đang chấm 1 câu (bấm đáp án thứ 2 trong lúc chờ từng làm chấm 2 lần → 2 luồng cùng tới cuối, luồng thừa xoá bảng của bước SAU = kẹt)
    //   fin = đã xong bước (hẹn giờ phát âm thanh muộn không được vẽ lại bảng)
    let qi = 0, plays = 0, right = 0, streak = 0, busy = false, fin = false;
    const live = () => c.live?.() !== false;
    c.onCancel?.(() => { fin = true; res(); });
    const draw = (msg = "") => {
      if (fin || !live()) return;
      const q = Q.qs[qi];
      E.ui.panel(`${withAudio ? `<div class="se-au"><button class="se-play" data-play>${E.ICON.spk}</button><div><b>${esc(nat({ en: "Voice message", vi: "Tin nhắn thoại" }))}</b><small>${esc(nat({ en: "No text — listen carefully.", vi: "Không có chữ — nghe thật kỹ." }))} ${plays ? `· ${plays}×` : ""}</small></div><button class="se-btn sm" data-slow>${esc(nat({ en: "Slow", vi: "Chậm" }))}</button></div>` : ""}
        ${q ? `<div class="se-ask">${esc(L(q.q))}</div><div class="se-chs">${q.opts.map((o, i) => `<button class="se-ch-b" data-a="${i}"><span>${esc(E.tgt(o))}</span></button>`).join("")}</div>` : `<button class="se-btn pri wide" data-finish>${T("cont")}</button>`}
        ${msg}`, "listen");
    };
    const play = slow => { if (fin || !live()) return; plays++; draw(); const a = document.querySelector(".se-au"); a?.classList.add("on"); E.say(E.tgt(Q.audio), Q.who || "caller", { force: true, slow }).then(() => document.querySelector(".se-au")?.classList.remove("on")); };
    const answer = async i => {
      if (busy || fin || !live()) return; busy = true;
      const q = Q.qs[qi], ok = i === q.a;
      if (ok) { right++; streak++; E.apply(q); E.sfx("up"); E.haptic("LIGHT"); } else { streak = 0; E.sfx("wrong"); E.haptic("HEAVY"); }
      // reveal: false (thiếu dữ kiện thì sai là bình thường) → không bật xanh đáp án đúng khi trả lời sai
      const hide = !ok && (Q.reveal === false || q.reveal === false);
      document.querySelectorAll(".se-ui [data-a]").forEach((b, k) => b.classList.add(k === i ? (ok ? "ok" : "no") : k === q.a && !hide ? "ok" : "dim"));
      const hit = document.querySelectorAll(".se-ui [data-a]")[q.a];
      if (ok && streak >= 2) E.fxFloat?.(hit, nat({ en: `${streak} in a row!`, vi: `${streak} câu liền!` }), "#6fcf97"); else if (ok) E.fxBurst?.(hit, "#6fcf97", 8);
      await new Promise(r => setTimeout(r, E.auto ? 1 : 900));
      if (!live()) return res();
      qi++; busy = false;
      if (qi < Q.qs.length) return draw();
      busy = true;
      E.add("qRight", right); E.add("qN", Q.qs.length);
      if (E.auto) {}
      else if (withAudio) {
        // hết câu hỏi → hiện lời gốc + nghĩa (học từ chính đoạn vừa nghe)
        if (Q.reveal !== false) await feedback(`<div class="se-fb"><b>${right}/${Q.qs.length}</b><p class="se-tsc">${E.words(E.tgt(Q.audio), E.L)}</p>${Q.tr?.[E.N] ? `<p class="se-mute">${esc(Q.tr[E.N])}</p>` : ""}</div>`, c);
      } else if (!E.auto) await feedback(`<div class="se-fb"><b>${right}/${Q.qs.length}</b></div>`, c);
      // có pass → kết quả rẽ nhánh (đạt / trượt); không có → như cũ (chỉ ghi điểm)
      const pass = Q.pass ?? (Q.ok || Q.fail ? Q.qs.length : 0), won = right >= pass;
      if (pass) { E.flag(Q.key || "q_" + c.key(), right); await E.verdict?.(won, nat(won ? { en: "Well understood!", vi: "Hiểu chuẩn!" } : { en: "Missed some", vi: "Còn sót ý" })); }
      if (!live()) return res();
      fin = true; E.ui.clear();
      if (pass && (won ? Q.ok : Q.fail)) c.push(withAudio ? "listen" : "quiz", won ? "ok" : "fail");
      res();
    };
    draw();
    document.querySelector(".se-ui").onclick = e => {
      if (fin || !live()) return;
      if (e.target.closest("[data-finish]")) { fin = true; E.ui.clear(); return res(); }
      if (e.target.closest("[data-play]")) return play(false);
      if (e.target.closest("[data-slow]")) return play(true);
      const a = e.target.closest("[data-a]"); if (a && !a.classList.contains("ok") && !a.classList.contains("no")) answer(+a.dataset.a);
    };
    if (withAudio && !E.auto) setTimeout(() => play(false), 400);
    E.autoRun(() => { const tick = () => { if (fin || !live()) return; if (!Q.qs.length) { fin = true; E.ui.clear(); return res(); } if (qi < Q.qs.length) { if (!busy) answer(Q.qs[qi].a); setTimeout(tick, E.auto ? 10 : 1000); } }; tick(); });
  });
  def("listen", c => { E.ui.hideBox(); return qflow(c, c.st.listen, true); });
  def("quiz", c => { E.ui.hideBox(); return qflow(c, c.st.quiz, false); });

  // ───────── GIẢI ĐỐ: KHOÁ số / chữ (bánh xe) ─────────
  // { lock: { prompt, kind: "digits"|"letters"|[ký tự…], answer, hints: [..], ok, fail, giveUp } }
  def("lock", (c) => new Promise(res => {
    const K = c.st.lock;
    const set = Array.isArray(K.kind) ? K.kind : K.kind === "letters" ? "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("") : "0123456789".split("");
    const ans = Array.from(String(K.answer).toUpperCase());
    const cur = ans.map(() => 0);
    let tries = 0, hint = 0, entry = false, typed = "", busy = false, over = false;
    c.onCancel?.(() => { over = busy = true; res(); });
    E.ui.hideBox();
    const draw = (msg = "") => {
      const el = E.ui.panel(`<div class="se-ask">${esc(L(K.prompt))}</div>
        ${entry
          ? `<input class="se-in big" data-code autocomplete="off" autocapitalize="characters" spellcheck="false" inputmode="${set.every(x => /^\d$/.test(String(x))) ? "numeric" : "text"}" aria-label="${esc(nat({ en: "Enter the code", vi: "Nhập mã" }))}" value="${esc(typed)}">`
          : `<div class="se-lock">${cur.map((v, i) => `<div class="se-wh"><button data-u="${i}" aria-label="${esc(nat({ en: `Increase character ${i + 1}`, vi: `Tăng ký tự ${i + 1}` }))}">▲</button><b aria-live="polite">${esc(set[v])}</b><button data-d="${i}" aria-label="${esc(nat({ en: `Decrease character ${i + 1}`, vi: `Giảm ký tự ${i + 1}` }))}">▼</button></div>`).join("")}</div>`}
        <div class="se-lock-tools"><button class="se-btn sm" data-mode>${esc(nat(entry ? { en: "Use wheels", vi: "Dùng vòng xoay" } : { en: "Type code", vi: "Gõ mã" }))}</button><button class="se-btn sm" data-reset>${esc(nat({ en: "Reset", vi: "Đặt lại" }))}</button></div>
        <div class="se-row"><button class="se-btn pri" data-try>${esc(nat({ en: "Try", vi: "Thử" }))}</button>${K.hints?.length ? `<button class="se-btn" data-hint>${esc(nat({ en: "Hint", vi: "Gợi ý" }))} (${K.hints.length - hint})</button>` : ""}${K.giveUp && tries >= 3 ? `<button class="se-btn" data-give>${esc(nat({ en: "Give up", vi: "Bỏ qua" }))}</button>` : ""}</div>${msg}`, "lockp");
      const input = el.querySelector("[data-code]");
      if (input) {
        input.oninput = () => { typed = input.value; };
        input.onkeydown = e => { if (e.key === "Enter") { e.preventDefault(); check(); } };
        setTimeout(() => { if (!input.isConnected || over || c.live?.() === false) return; input.focus({ preventScroll: true }); input.setSelectionRange(input.value.length, input.value.length); }, 0);
      }
    };
    draw();
    const fin = (keys) => { if (over || c.live?.() === false) return; over = true; E.ui.clear(); if (keys) c.push("lock", keys); res(); };
    const check = async () => {
      if (busy || over || c.live?.() === false) return;
      const value = entry ? typed.trim().toUpperCase() : cur.map(v => String(set[v])).join("").toUpperCase();
      if (entry && Array.from(value).length !== ans.length) return draw(`<div class="se-hint no">${esc(nat({ en: `Enter all ${ans.length} characters.`, vi: `Nhập đủ ${ans.length} ký tự.` }))}</div>`);
      busy = true; tries++;
      if (value === ans.join("")) { E.ui.fx("solve"); await E.verdict?.(true, nat({ en: "Unlocked!", vi: "Đã mở!" })); return fin(K.ok ? "ok" : null); }
      E.ui.fx("shake");
      if (K.fail && tries === 1) { await E.verdict?.(false, nat({ en: "Locked", vi: "Không mở được" })); return fin("fail") || c.again(); }
      busy = false; draw(`<div class="se-hint no">${esc(nat({ en: "It doesn't open.", vi: "Không mở được." }))}</div>`);
    };
    document.querySelector(".se-ui").onclick = e => {
      if (busy || over || c.live?.() === false) return;
      const u = e.target.closest("[data-u]"), d = e.target.closest("[data-d]");
      if (u) { const i = +u.dataset.u; cur[i] = (cur[i] + 1) % set.length; typed = cur.map(v => set[v]).join(""); return draw(); }
      if (d) { const i = +d.dataset.d; cur[i] = (cur[i] - 1 + set.length) % set.length; typed = cur.map(v => set[v]).join(""); return draw(); }
      if (e.target.closest("[data-mode]")) {
        if (entry) {
          const chars = Array.from(typed.toUpperCase());
          if (chars.length === cur.length && chars.every(ch => set.some(x => String(x).toUpperCase() === ch))) {
            cur.splice(0, cur.length, ...chars.map(ch => set.findIndex(x => String(x).toUpperCase() === ch)));
          }
          entry = false;
        } else {
          typed = cur.map(v => set[v]).join("");
          entry = true;
        }
        return draw();
      }
      if (e.target.closest("[data-reset]")) { cur.fill(0); typed = ""; return draw(); }
      if (e.target.closest("[data-hint]") && hint < K.hints.length) { hint++; return draw(`<div class="se-hint">${K.hints.slice(0, hint).map(x => `<p>${E.ICON.bulb}${esc(L(x))}</p>`).join("")}</div>`); }
      if (e.target.closest("[data-give]")) { E.flag("gaveUp_" + c.key(), 1); return fin(K.giveUp ? "giveUp" : null); }
      if (e.target.closest("[data-try]")) check();
    };
    E.autoRun(() => { ans.forEach((ch, i) => (cur[i] = Math.max(0, set.findIndex(x => String(x).toUpperCase() === ch)))); document.querySelector("[data-try]")?.click(); });
  }));

  // ───────── XẾP THỨ TỰ (dòng thời gian, các bước, câu đảo) ─────────
  // { order: { prompt, items: [{ t: "…" | { en, vi }, tag? }] (đúng thứ tự), ok, fail, tries } }
  // 29/10 (người dùng): KÉO tay nắm ≡ để đổi chỗ, như sắp xếp kênh đăng ký trên YouTube (trước: chạm 2 ô để đổi chỗ) · nút Gốc | Dịch
  def("order", (c) => new Promise(res => {
    const O = c.st.order, G = E.G();
    let cur = shuffle(O.items, c.key()).map(([, i]) => i);
    if (cur.every((v, i) => v === i)) cur.reverse();
    let tries = 0, msg = "", selected = -1, busy = false, over = false;
    c.onCancel?.(() => { over = busy = true; res(); });
    const hasTr = E.N !== E.L && O.items.some(it => docTr(it.t));
    let tr = !!G.set.docTr && hasTr;
    E.ui.hideBox();
    const draw = () => {
      if (over || c.live?.() === false) return;
      const el = E.ui.panel(`<div class="se-ask se-askr"><span>${esc(L(O.prompt))}</span>${trSeg(tr, hasTr)}</div><p class="se-order-help">${esc(nat(selected < 0
        ? { en: "Tap an event, then its destination — or drag ≡.", vi: "Chạm một sự việc rồi chạm vị trí mới — hoặc kéo ≡." }
        : { en: "Now tap where to place it.", vi: "Giờ chạm vào vị trí muốn chuyển tới." }))}</p><div class="se-ord">${cur.map((k, p) => `<div class="se-oi${selected === p ? " selected" : ""}" data-p="${p}"><em>${O.items[k].tag ? esc(O.items[k].tag) : p + 1}</em><button class="se-oit" data-select="${p}" aria-pressed="${selected === p}">${docLine(O.items[k].t, tr)}</button><button class="se-oh" data-h="${p}" aria-label="${esc(nat({ en: "Drag to move", vi: "Kéo để đổi chỗ" }))}"><svg viewBox="0 0 24 24"><path d="M5 8h14M5 12h14M5 16h14"/></svg></button></div>`).join("")}</div>${msg}<button class="se-btn pri wide" data-chk>${esc(nat({ en: "Check", vi: "Kiểm tra" }))}</button>`, "orderp");
      bindDrag(el.querySelector(".se-ord"));
    };
    // kéo: hàng đang kéo đi theo ngón tay, các hàng khác dạt lên / xuống chừa chỗ; thả = chốt vị trí mới
    const bindDrag = list => {
      list.onpointerdown = e => {
        if (busy || over || c.live?.() === false) return;
        const hd = e.target.closest("[data-h]"); if (!hd) return;
        e.preventDefault();
        const rows = [...list.children], from = +hd.dataset.h, row = rows[from];
        const step = rows.length > 1 ? rows[1].offsetTop - rows[0].offsetTop : row.offsetHeight + 7;
        const y0 = e.clientY; let to = from;
        row.classList.add("drag"); E.haptic("LIGHT");
        try { hd.setPointerCapture(e.pointerId); } catch {}
        const move = ev => {
          const dy = Math.max(-from * step - 8, Math.min((rows.length - 1 - from) * step + 8, ev.clientY - y0));
          row.style.transform = `translateY(${dy}px) scale(1.03)`;
          const t = Math.max(0, Math.min(rows.length - 1, from + Math.round(dy / step)));
          if (t !== to) { to = t; E.haptic("LIGHT"); }
          rows.forEach((r, k) => { if (r !== row) r.style.transform = k > from && k <= to ? `translateY(${-step}px)` : k < from && k >= to ? `translateY(${step}px)` : ""; });
        };
        const cleanup = () => {
          hd.removeEventListener("pointermove", move); hd.removeEventListener("pointerup", up); hd.removeEventListener("pointercancel", cancel);
        };
        const up = () => {
          cleanup();
          if (to !== from) { const [x] = cur.splice(from, 1); cur.splice(to, 0, x); msg = ""; E.sfx("tap"); }
          selected = -1;
          draw();
        };
        const cancel = () => { cleanup(); draw(); };
        hd.addEventListener("pointermove", move); hd.addEventListener("pointerup", up); hd.addEventListener("pointercancel", cancel);
      };
    };
    draw();
    document.querySelector(".se-ui").onclick = async e => {
      if (busy || over || c.live?.() === false) return;
      const v = e.target.closest("[data-trv]");
      if (v) { tr = v.dataset.trv === "1"; G.set.docTr = tr; E.save(); E.sfx("tap"); return draw(); }
      const item = e.target.closest("[data-select]");
      if (item) {
        const target = +item.dataset.select;
        if (selected < 0) selected = target;
        else if (selected === target) selected = -1;
        else { const [x] = cur.splice(selected, 1); cur.splice(target, 0, x); selected = -1; msg = ""; E.sfx("tap"); }
        return draw();
      }
      if (e.target.closest("[data-chk]")) {
        busy = true; tries++;
        const wrong = cur.filter((k, p) => k !== p).length;
        if (!wrong) { E.ui.fx("solve"); await E.verdict?.(true, nat({ en: "Right order!", vi: "Đúng thứ tự!" })); if (over || c.live?.() === false) return; over = true; E.ui.clear(); E.add("puzzles", 1); if (O.ok) c.push("order", "ok"); return res(); }
        E.ui.fx("shake");
        if (O.tries && tries >= O.tries) { await E.verdict?.(false, nat({ en: "Out of tries", vi: "Hết lượt" })); if (over || c.live?.() === false) return; over = true; E.ui.clear(); if (O.fail) c.push("order", "fail"); return res(); }
        msg = `<div class="se-hint no">${esc(nat({ en: `${wrong} in the wrong place.`, vi: `${wrong} ô chưa đúng chỗ.` }))}${O.tries ? ` ${esc(nat({ en: `${O.tries - tries} tries left.`, vi: `Còn ${O.tries - tries} lần thử.` }))}` : ""}</div>`;
        busy = false; draw();
      }
    };
    E.autoRun(() => { cur = O.items.map((_, i) => i); draw(); document.querySelector("[data-chk]").click(); });
  }));

  // ───────── GÕ CHỮ (mật khẩu, tin nhắn, điền mẫu) — chấm mềm: sai 1 ký tự / từ vẫn nhận, báo chỗ sai ─────────
  // { type: { prompt, ph, accept: ["..."], near: true, ok, fail, tries, hint } }
  const lev = (a, b) => { const d = Array.from({ length: a.length + 1 }, (_, i) => [i]); for (let j = 1; j <= b.length; j++) d[0][j] = j; for (let i = 1; i <= a.length; i++) for (let j = 1; j <= b.length; j++) d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1)); return d[a.length][b.length]; };
  const norm = s => String(s).toLowerCase().replace(/[’']/g, "'").replace(/[^\p{L}\p{N}' ]+/gu, " ").replace(/\s+/g, " ").trim();
  def("type", (c) => new Promise(res => {
    const Y = c.st.type; let tries = 0, value = "", busy = false, over = false;
    c.onCancel?.(() => { over = busy = true; res(); });
    // đáp án cho bộ kiểm “khỉ bấm” (tools/games/_lib/story/cover.js) — gõ đúng để đi tiếp, không phải người chơi thấy
    globalThis.__seAns = Y.accept?.[0];
    E.ui.hideBox();
    const draw = (msg = "") => {
      const el = E.ui.panel(`<div class="se-ask">${esc(L(Y.prompt))}</div><input class="se-in big" data-in autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="${esc(L(Y.prompt))}" placeholder="${esc(L(Y.ph) || "")}" value="${esc(value)}">${msg}<button class="se-btn pri wide" data-ok>${esc(nat({ en: "Send", vi: "Gửi" }))}</button>`, "typep");
      const inp = el.querySelector("[data-in]");
      inp.oninput = () => { value = inp.value; };
      setTimeout(() => { if (!inp.isConnected || over || c.live?.() === false) return; inp.focus({ preventScroll: true }); inp.setSelectionRange(inp.value.length, inp.value.length); }, 50);
      inp.onkeydown = e => { if (e.key === "Enter") { e.preventDefault(); check(inp.value); } };
      el.querySelector("[data-ok]").onclick = () => check(inp.value);
    };
    const check = async v => {
      if (busy || over || c.live?.() === false) return; busy = true;
      value = String(v ?? "");
      tries++;
      const got = norm(v), acc = Y.accept.map(norm);
      const exact = acc.includes(got);
      const near = !exact && Y.near !== false && acc.some(a => lev(a, got) <= Math.max(1, Math.floor(a.length / 12)));
      E.flash?.(document.querySelector(".se-ui [data-in]"), exact || near);
      if (exact || near) {
        await E.verdict?.(true, nat({ en: "Correct!", vi: "Chính xác!" })); if (over || c.live?.() === false) return; over = true; E.ui.clear(); E.add("typed", 1);
        if (near) E.ui.toast(`${esc(nat({ en: "Almost! Correct spelling:", vi: "Gần đúng! Viết đúng là:" }))} <b>${esc(Y.accept[0])}</b>`, 3000);
        if (Y.ok) c.push("type", "ok"); return res();
      }
      E.ui.fx("shake");
      if (Y.tries && tries >= Y.tries) { await E.verdict?.(false, nat({ en: "Out of tries", vi: "Hết lượt" })); if (over || c.live?.() === false) return; over = true; E.ui.clear(); if (Y.fail) c.push("type", "fail"); return res(); }
      busy = false; draw(Y.hint && tries >= 2 ? `<div class="se-hint">${E.ICON.bulb}${esc(L(Y.hint))}</div>` : `<div class="se-hint no">${esc(nat({ en: "Not quite. Try again.", vi: "Chưa đúng. Thử lại." }))}</div>`);
    };
    draw();
    E.autoRun(() => check(Y.accept[0]));
  }));

  // ───────── XEM LẠI CÁCH DỊCH (cuối chương — Ruth nhận xét) ─────────
  def("review", (c) => new Promise(res => {
    const R = E.R(), notes = R.notes.filter(n => n.ch === R.ch);
    if (!notes.length || E.auto) return res();
    E.ui.hideBox();
    const pct = Math.round((notes.reduce((a, n) => a + n.acc, 0) / (notes.length * 2)) * 100);
    const el = E.ui.panel(`<div class="se-rv"><div class="se-rvh"><b>${esc(nat({ en: "Your translations", vi: "Các câu bạn đã dịch" }))}</b><span class="se-pct">${pct}%</span></div>
      ${notes.map(n => `<div class="se-rvi a${n.acc}"><blockquote>${esc(n.src)}</blockquote><p><em>${n.acc === 2 ? "✓" : n.acc === 1 ? "≈" : "✗"}</em> ${esc(n.pick)}</p>${n.acc < 2 ? `<p class="best">→ ${esc(n.best)}</p>` : ""}${n.why && n.acc < 2 ? `<p class="why">${esc(L(n.why))}</p>` : ""}</div>`).join("")}
      </div><button class="se-btn pri wide" data-ok>${T("cont")}</button>`, "review");
    el.onclick = e => { if (e.target.closest("[data-ok]")) { E.ui.clear(); res(); } };
  }));

  // ───────── KẾT THÚC CHƯƠNG / TRUYỆN ─────────
  def("end", (c) => new Promise(() => {
    const S = E.S(), G = E.G(), R = E.R(), id = c.st.end, en = S.endings?.[id] || {};
    const first = !G.endings[id];
    G.endings[id] = G.endings[id] || Date.now(); R.done = id;
    // tới kết thúc DẪN SANG chương sau (next) / kết thúc cuối / chương cuối đã ra = xong chương đó (mở khoá chương sau);
    //   kết thúc cụt giữa truyện (thua, không có next) không tính
    { const ch = en.ch ?? R.ch; if (en.next || en.final || !(S.chapters || []).some(c => c.ch > ch && !c.soon)) E.chDone?.(ch); }
    E.save();
    // kết thúc CHƯƠNG có next = node đầu chương sau → nút “Chơi tiếp”; không có next = kết thúc TRUYỆN
    // chơi thử (không lưu) → dừng ở cuối chương, không đi tiếp (Detroit)
    const nx = !E.explore && en.next && (S.nodes[en.next] || E.chapterOf(en.next)) ? en.next : null; // chương sau có thể chưa nạp (tải lần lượt)
    E.emit("end", id, !!nx);
    if (E.auto) { if (nx) { E.jump(nx); return E.play(); } document.title = "END:" + id; console.log("[story] END", id, JSON.stringify(R.f)); return; }
    E.ui.hideBox(); E.ui.hide("*");
    const notes = R.notes.filter(n => n.ch === (en.ch ?? R.ch));
    const pct = notes.length ? Math.round((notes.reduce((a, n) => a + n.acc, 0) / (notes.length * 2)) * 100) : null;
    const flow = (S.flow || []).filter(x => x.ch === (en.ch ?? R.ch));
    const opts = flow.filter(x => x.kind === "opt"), ends = flow.filter(x => x.kind === "end");
    const explored = opts.filter(x => G.opts[x.key + ":" + x.val]).length + ends.filter(x => G.endings[x.id]).length;
    const total = opts.length + ends.length;
    const el = E.ui.panel(`<div class="se-end">
      <small>${first ? esc(nat({ en: "NEW ENDING", vi: "KẾT THÚC MỚI" })) : esc(nat({ en: "ENDING", vi: "KẾT THÚC" }))}</small>
      <h2>${esc(tgt(en.title))}</h2>${E.L !== E.N && en.title?.[E.N] ? `<div class="se-mute">${esc(nat(en.title))}</div>` : ""}
      <p class="se-endt">${E.words(tgt(en.text), E.L)}</p>
      ${en.text?.[E.N] ? `<details><summary>${T("translate")}</summary>${esc(nat(en.text))}</details>` : ""}
      ${(() => { const l = E.recapList(en.ch ?? R.ch).filter(x => (x.ch ?? 0) === (en.ch ?? R.ch)); return l.length ? `<div class="se-recap box"><b>${esc(nat({ en: "What happened on your path", vi: "Chuyện trong nhánh của bạn" }))}</b>${l.map(x => `<p class="se-rcp">${esc(nat(x.t))}</p>`).join("")}</div>` : ""; })()}
      <div class="se-stats">
        ${pct != null ? `<div><b>${pct}%</b><small>${esc(nat({ en: "Translation accuracy", vi: "Độ chính xác khi dịch" }))}</small></div>` : ""}
        <div><b>${Object.keys(G.truths).length}/${S.truthTotal || "?"}</b><small>${T("truths")}</small></div>
        <div><b>${explored}/${total}</b><small>${esc(nat({ en: "Branches explored", vi: "Nhánh đã khám phá" }))}</small></div>
        <div><b>${Object.keys(G.words).length}</b><small>${T("words")}</small></div>
      </div>
      ${explored < total ? `<p class="se-tease">${esc(nat({ en: "Some choices are still unexplored. What happens if you choose differently?", vi: "Vẫn còn lựa chọn chưa khám phá. Nếu chọn khác đi thì sao?" }))}</p>` : ""}
      ${!nx && S.next && !en.final ? `<p class="se-next">${esc(nat(S.next))} — ${esc(nat({ en: "coming soon", vi: "sắp ra mắt" }))}</p>` : ""}
      ${en.final ? `<p class="se-next">${esc(nat({ en: "THE END", vi: "HẾT" }))}</p>` : ""}
      ${E.explore ? `<p class="se-next">${esc(nat({ en: "That was a trial run — your saved story hasn't changed.", vi: "Đây là lần chơi thử — tiến độ đã lưu của bạn không đổi." }))}</p>` : ""}
      <div class="se-col">${nx ? `<button class="se-btn pri" data-nx>${E.ICON.play} ${esc(nat(en.nextTitle || { en: "Continue", vi: "Chơi tiếp" }))}</button>` : ""}<button class="se-btn${nx ? "" : " pri"}" data-f>${T("flow")}</button><button class="se-btn" data-b>${T("notebook")}</button><button class="se-btn" data-t>${esc(nat({ en: "Title screen", vi: "Màn hình chính" }))}</button></div>
    </div>`, "full end");
    el.onclick = e => {
      if (e.target.closest("[data-f]")) E.ui.flowSheet();
      if (e.target.closest("[data-b]")) E.ui.book("truths");
      if (e.target.closest("[data-t]")) { E.stop(); E.ui.title(); }
      if (e.target.closest("[data-nx]")) { E.sfx("whoosh"); E.ui.clear(); R.done = null; E.jump(nx); E.save(); E.play(); }
    };
  }));
})();
// Enmi Story Engine — CƠ CHẾ MỞ RỘNG dựng sẵn (nạp sau mech.js). Truyện dùng bước nào thì bước đó chạy; không dùng = không ảnh hưởng.
// Mỗi cơ chế: StoryEngine.def(tên, ctx => Promise). Có chế độ tự chơi (E.auto) để autoplay.js kiểm hồi quy.
// Đặc tả đầy đủ + ví dụ: docs/story-engine/CO-CHE.md
//
// TRINH THÁM / HỒI HỘP
//   chat     nhắn tin điện thoại (tin đến lần lượt, có “đang gõ…”, chọn câu trả lời)
//   call     cuộc gọi đến (nghe / từ chối / để nhỡ khi hết giờ)
//   board    bảng manh mối: nối NHIỀU cặp manh mối → mỗi cặp đúng = 1 kết luận
//   compare  so 2 văn bản (băng gốc ↔ biên bản…): chạm dòng bị sửa
//   sneak    lẻn qua: mỗi đoạn chọn đường, rủi ro cộng vào thanh “tiếng động”, đầy = bị phát hiện
//   qte      bấm nhanh: tap (chạm liên tục) · seq (chạm đúng thứ tự) · hold (giữ đủ lâu)
//   whom     chọn 1 người (lưới chân dung): buộc tội, cứu ai, rủ ai…
//   note     ghi 1 dòng vào sổ ghi chép vụ án (tab Ghi chú)
// HẸN HÒ / TÌNH CẢM
//   gift     tặng quà: mỗi người thích / ghét khác nhau → phản ứng love · like · meh · hate, cộng thiện cảm
//   topics   chọn chủ đề nói chuyện (mỗi lượt 1 chủ đề, người kia thích / chán) → thiện cảm
//   date     lên lịch hẹn: chọn N hoạt động theo thứ tự → chạy lần lượt, chấm độ hợp
//   gallery  chọn 1 trong nhiều ẢNH (trang phục, món quà, căn phòng…) có gắn thẻ, so với điều người kia muốn
//   meter    thanh chỉ số luôn hiện (thiện cảm ♥, nghi ngờ, ôxy, thời gian…) · { meter: "<khoá>", off: true } để ẩn
// PHIÊU LƯU / NHẬP VAI / SINH TỒN / ĐỜI THƯỜNG
//   check    tung xúc xắc theo chỉ số (d6 / d20 + chỉ số ≥ độ khó) → ok / fail
//   shop     cửa hàng: tiền là 1 biến (vd. coins), mua đồ vào túi
//   schedule lên lịch tuần: mỗi ô chọn 1 hoạt động → cộng chỉ số, trừ tiền / sức
//   gauge    thanh trượt chọn mức (mạnh tay / nhẹ nhàng, bao nhiêu tiền…) → vùng kết quả
//   spin     vòng quay may mắn (kết quả định trước theo khoá bước — tải lại không đổi)
// HỌC TIẾNG (lồng vào truyện)
//   fill     điền từ vào chỗ trống (chọn từ đúng ngữ pháp)
//   memory   lật thẻ ghép cặp (từ ↔ nghĩa, người ↔ đồ vật…)
(() => {
  const E = globalThis.StoryEngine, def = E.def, esc = E.esc, h = E.h;
  const nat = t => E.nat(t), T = k => E.ui.tr(k);
  const later = (fn, ms = 5) => setTimeout(fn, ms);
  const pickAuto = arr => arr[E.auto === "r" ? Math.floor(Math.random() * arr.length) : 0];
  const tgtOr = o => E.tgt(o);
  const sub = o => E.sub(o);
  const cond = (c, s) => (c == null ? true : typeof c === "function" ? !!c(s) : typeof c === "string" ? s.truth(c) || s.has(c) || !!s.f[c] : typeof c === "object" && !Array.isArray(c) ? Object.entries(c).every(([k, v]) => (+s.f[k] || 0) >= v) : !!c);
  const seedRnd = key => { let x = E.hash(key) || 1; return () => ((x = (x * 1103515245 + 12345) >>> 0) % 10000) / 10000; };
  const cname = id => (id === "me" ? E.G().set.name : E.cname(E.S().chars[id] || {}, true));
  const color = id => (id === "me" ? "var(--se-me)" : E.S().chars[id]?.color || "#aaa");
  const face = id => `<span class="sp-av" style="--c:${color(id)}"><i class="im-${esc(id)}"></i><b>${esc((cname(id) || "?").charAt(0))}</b></span>`;
  const trOn = () => E.G().set.tr;
  const subHtml = o => { const s = sub(o); return s ? `<small class="sp-sub"${trOn() ? "" : " hidden"}>${esc(s)}</small>` : ""; };
  const ui = () => document.querySelector(".se-ui");
  // game feel: tia sáng nổ ra từ phần tử el (đúng = vàng/xanh, sai = đỏ) + chữ nổi bay lên (điểm, combo)
  const burst = (el, color = "#ffd166", n = 12) => {
    if (E.auto || !el) return;
    const r = el.getBoundingClientRect(), host = document.querySelector(".se-ui") || document.body, h = host.getBoundingClientRect();
    for (let i = 0; i < n; i++) {
      const p = document.createElement("i"), a = (i / n) * 6.283 + Math.random() * .5, d = 40 + Math.random() * 40;
      p.className = "se-pt"; p.style.cssText = `left:${r.left - h.left + r.width / 2}px;top:${r.top - h.top + r.height / 2}px;background:${color};--dx:${Math.cos(a) * d}px;--dy:${Math.sin(a) * d}px`;
      host.appendChild(p); setTimeout(() => p.remove(), 750);
    }
  };
  const floatTxt = (el, txt, color = "#ffd166") => {
    if (E.auto || !el) return;
    const r = el.getBoundingClientRect(), host = document.querySelector(".se-ui") || document.body, h = host.getBoundingClientRect();
    const t = document.createElement("b"); t.className = "se-fl"; t.textContent = txt;
    t.style.cssText = `left:${r.left - h.left + r.width / 2}px;top:${r.top - h.top}px;color:${color}`;
    host.appendChild(t); setTimeout(() => t.remove(), 900);
  };
  // xong 1 bước — CHỈ 1 LẦN mỗi bước (bấm 2 lần / hẹn giờ muộn gọi lại từng xoá bảng của bước SAU → kẹt; khỉ bấm của cover.js bắt được)
  const DONE = new WeakSet();
  const live = c => c?.live?.() !== false;
  // TÊN CHỈ SỐ cho người chơi (không lộ mã thô “courage”): story.stats.<mã> = { en, vi } → thanh chỉ số (meter) → mã viết hoa chữ đầu
  const WHEEL = ["#f2b84b", "#7fb2e5", "#ef7a6c", "#6fcf97", "#a78bfa", "#f472b6", "#22d3ee", "#fb923c"];
  const statName = k => nat(E.S().stats?.[k] || E.R().meters?.[k]?.label || { en: k.charAt(0).toUpperCase() + k.slice(1) });
  // biểu tượng: tên icon SVG của engine (E.ICON) — emoji truyện cũ ghi vào thì bỏ, dùng icon mặc định (người dùng không thích emoji)
  const icon = (name, dflt = "talk") => E.ICON[name] || E.ICON[dflt] || "";
  // kết luận THẮNG / THUA rõ ràng: biển lớn giữa màn (xanh ✓ / đỏ ✗) giữ ~1,2 giây trước khi sang bước sau (autoplay bỏ qua)
  const verdict = (ok, txt) => new Promise(r => {
    // gắn vào CẢ MÀN game (.se) — .se-ui chỉ cao bằng bảng đang mở nên biển bị cắt / không hiện
    const host = document.querySelector(".se") || ui(); if (E.auto || !host) return r();
    const d = document.createElement("div"); d.className = "se-verdict " + (ok ? "ok" : "no");
    d.innerHTML = `<i>${ok ? "✓" : "✗"}</i><b>${esc(txt || nat(ok ? { en: "Success!", vi: "Thành công!" } : { en: "Failed", vi: "Thất bại" }))}</b>`;
    host.appendChild(d); E.haptic(ok ? "MEDIUM" : "HEAVY");
    if (ok) { const i = d.querySelector("i"); ["#ffd166", "#6fcf97", "#7fb2e5", "#ff9ec7"].forEach((col, k) => setTimeout(() => burst(i, col, 10), k * 90)); }
    setTimeout(() => { d.remove(); r(); }, 1200);
  });
  E.verdict = verdict;
  // DIỄN BIẾN SAU mặc định (người dùng 30/10): truyện chưa viết phản ứng cho kết quả thì engine tự diễn 1 đoạn ngắn —
  //   nhân vật hiện ra nói 1 câu (có giọng) + dòng hệ quả (“Mia ♥ +3”) — để người chơi hiểu chuyện gì vừa xảy ra. Truyện có bước riêng thì dùng bước riêng.
  const aftermath = (who, line, note, fc) => new Promise(r => {
    if (E.auto) return r();
    if (who && who !== "me" && E.R().cast?.[who] && fc != null) E.ui.show(who, E.R().cast[who].at, fc);
    const el = E.ui.panel(`<div class="sp-after">${who ? face(who) : ""}<div class="lf-bub"><span>${esc(tgtOr(line))}</span>${subHtml(line)}</div></div>${note ? `<p class="sp-afn">${esc(note)}</p>` : ""}<button class="se-btn pri wide" data-ok>${T("cont")}</button>`, "after");
    if (who) E.say(tgtOr(line), who);
    el.onclick = e => { if (e.target.closest("[data-ok]")) { e.stopPropagation(); E.hush(); E.ui.clear(); r(); } };
  });
  E.aftermath = aftermath;
  const heart = (id, v) => `${cname(id)} ♥ ${v > 0 ? "+" : v < 0 ? "−" : "±"}${Math.abs(v)}`;
  // KÉO THẢ dùng chung: ui().onpointerdown = E.dragger({ src, dst, drop(srcEl, dstEl | null), ok(srcEl) })
  //   kéo > 8 px mới là kéo (chạm nhanh vẫn là click) · bóng theo ngón tay · ô thả đang trỏ có lớp .hov · E.dragged() = vừa thả xong (chặn click lỡ)
  let dragAt = 0, activeDrag = null;
  E.dragged = () => Date.now() - dragAt < 150;
  E.dragAt = () => { dragAt = Date.now(); };
  E.on("step", () => activeDrag?.());
  E.dragger = o => e => {
    const sEl = e.target.closest(o.src); if (activeDrag || !sEl || sEl.disabled || e.button > 0 || (o.ok && !o.ok(sEl))) return;
    const x0 = e.clientX, y0 = e.clientY, pid = e.pointerId; let ghost = null, over = null;
    const at = (x, y) => { const t = document.elementFromPoint(x, y)?.closest(o.dst); return t && t !== sEl ? t : null; };
    const cleanup = () => {
      document.removeEventListener("pointermove", mv); document.removeEventListener("pointerup", up); document.removeEventListener("pointercancel", up);
      ghost?.remove(); sEl.classList.remove("lifted"); over?.classList.remove("hov"); activeDrag = null;
    };
    const mv = ev => {
      if (ev.pointerId !== pid) return;
      if (!sEl.isConnected) return cleanup();
      if (!ghost) { if (Math.hypot(ev.clientX - x0, ev.clientY - y0) < 8) return; const r = sEl.getBoundingClientRect(); ghost = sEl.cloneNode(true); ghost.classList.add("se-ghost"); ghost.style.width = r.width + "px"; document.body.appendChild(ghost); sEl.classList.add("lifted"); E.haptic("LIGHT"); }
      ev.preventDefault(); ghost.style.left = ev.clientX + "px"; ghost.style.top = ev.clientY + "px";
      const t = at(ev.clientX, ev.clientY); if (t !== over) { over?.classList.remove("hov"); over = t; over?.classList.add("hov"); }
    };
    const up = ev => {
      if (ev.pointerId !== pid) return;
      const moved = !!ghost, target = ev.type === "pointercancel" ? null : at(ev.clientX, ev.clientY), connected = sEl.isConnected;
      cleanup(); if (!moved) return; dragAt = Date.now();
      // A cancelled gesture must not remove a card, gift, ingredient or planned stop.
      if (ev.type !== "pointercancel" && connected) o.drop(sEl, target);
    };
    activeDrag = cleanup;
    document.addEventListener("pointermove", mv, { passive: false }); document.addEventListener("pointerup", up); document.addEventListener("pointercancel", up);
  };
  // NHÁY ĐÚNG / SAI (người dùng 30/10): phần tử vừa trả lời sáng xanh / đỏ ~0,8 s cho dễ biết đúng hay sai
  E.flash = (el, ok, ms = 800) => { if (!el || E.auto) return; el.classList.remove("fx-ok", "fx-no"); void el.offsetWidth; el.classList.add(ok ? "fx-ok" : "fx-no"); setTimeout(() => el.classList.remove("fx-ok", "fx-no"), ms); };
  // cho cơ chế ở file khác (mech-life.js) dùng chung hiệu ứng
  E.fxBurst = burst; E.fxFloat = floatTxt;
  const done = (res, c, key, ...path) => { if (DONE.has(res)) return; DONE.add(res); if (live(c)) { E.ui.clear(); if (key) c.push(...path); } res(); };
  // A missing set of choices is not a successful play. Keep the original negative
  // branch contracts and allow authors to distinguish unavailable content with empty.
  const unavailable = (res, c, kind, message, branches) => {
    const spec = c.st[kind], branch = branches.find(k => Array.isArray(spec[k]));
    c.resumeHere?.(); E.ui.hideBox();
    const finish = () => {
      if (!live(c) || DONE.has(res)) return;
      c.resumeHere?.(false); done(res, c, branch && spec[branch], kind, branch);
    };
    const el = E.ui.panel(`<div class="se-ask" role="status">${esc(nat(message))}</div><button class="se-btn pri wide" data-unavailable>${T("cont")}</button>`, kind);
    el.onclick = e => { if (e.target.closest("[data-unavailable]")) finish(); };
    c.onCancel?.(() => { DONE.add(res); res(); });
    E.autoRun(finish);
  };

  // ═════════ CHAT — nhắn tin ═════════
  // { chat: { with: "ellie", msgs: [{ from: "ellie" | "me", en, vi, pic }], reply: [{ en, vi, set, add, then, if }], wait } }
  def("chat", c => new Promise(res => {
    const C = c.st.chat, R = E.R(), who = C.with;
    E.ui.hideBox();
    const log = (R.chats ||= {})[who] ||= [];
    let shown = [], seen = false;
    c.onCancel?.(() => { DONE.add(res); res(); });
    // tin cũ = tin TRƯỚC lần nhắn này (tin mới vừa gửi đã nằm trong shown — trước đây lấy cả log → tin mới hiện 2 lần)
    const base = log.length;
    const draw = (typing, opts) => {
      if (DONE.has(res) || !live(c)) return;
      E.ui.panel(`<div class="sp-phone"><div class="sp-ph">${face(who)}<b>${esc(cname(who))}</b><small>${esc(nat({ en: "online", vi: "đang hoạt động" }))}</small></div>
        <div class="sp-msgs">${[...log.slice(Math.max(0, base - 6), base).map(m => ({ ...m, old: 1 })), ...shown].map(m => `<div class="sp-m ${m.from === "me" ? "me" : m.from === "sys" ? "sys" : "them"}${m.old ? " old" : ""}">${m.pic ? `<i class="sp-mp im-${esc(m.pic)}"></i>` : ""}${E.words(tgtOr(m), E.L)}${subHtml(m)}</div>`).join("")}${!typing && shown.length && shown[shown.length - 1].from === "me" && seen ? `<small class="sp-seen">${esc(nat({ en: "Seen", vi: "Đã xem" }))}</small>` : ""}${typing ? `<div class="sp-m them typing"><i></i><i></i><i></i></div>` : ""}</div>
        ${opts ? `<div class="sp-rep">${opts.map(({ o, i }) => `<button class="se-ch-b" data-r="${i}"><span>${esc(tgtOr(o))}</span>${subHtml(o)}</button>`).join("")}</div>` : ""}</div>`, "chat");
      const m = document.querySelector(".sp-msgs"); if (m) m.scrollTop = m.scrollHeight;
    };
    (async () => {
      for (const m of C.msgs || []) {
        if (!live(c) || DONE.has(res)) return;
        if (m.from !== "me" && !E.auto) { draw(true); await new Promise(r => setTimeout(r, Math.min(1800, 500 + tgtOr(m).length * 22))); }
        if (!live(c) || DONE.has(res)) return;
        shown.push(m); log.push({ ...m }); E.sfx(m.from === "me" ? "tap" : "phone"); draw(false);
        if (!E.auto) await new Promise(r => setTimeout(r, 260));
      }
      if (!live(c) || DONE.has(res)) return;
      const opts = (C.reply || []).map((o, i) => ({ o, i })).filter(({ o }) => cond(o.if, c.s));
      if (!opts.length) { if (!E.auto) await new Promise(r => setTimeout(r, C.wait ?? 900)); return done(res, c); }
      draw(false, opts);
      if (C.ms && !E.auto) document.querySelector(".sp-rep")?.insertAdjacentHTML("beforebegin", `<div class="se-timer sp-rt"><i style="animation-duration:${C.ms / 1000}s"></i></div>`);
      let sent = false;
      const tmo = C.ms && !E.auto ? setTimeout(() => { if (sent || !live(c) || DONE.has(res)) return; sent = true; E.sfx("down"); E.flag((C.key || "chat_" + who) + "_missed", 1); shown.push({ from: "sys", en: "You didn't reply.", vi: "Bạn đã không trả lời." }); draw(false); setTimeout(() => done(res, c, C.timeout, "chat", "timeout"), 1100); }, C.ms) : 0;
      const go = i => { if (sent || !live(c) || DONE.has(res)) return; sent = true; clearTimeout(tmo); const o = C.reply[i]; shown.push({ from: "me", ...o }); log.push({ from: "me", en: o.en, [E.N]: o[E.N], [E.L]: o[E.L] }); draw(false); E.apply(o); E.sfx("tap"); if (!E.auto) setTimeout(() => { seen = true; if (!DONE.has(res) && live(c)) draw(false); }, 450); setTimeout(() => done(res, c, o.then, "chat", "reply", i, "then"), E.auto ? 1 : 1000); };
      ui().onclick = e => { const b = e.target.closest("[data-r]"); if (b) go(+b.dataset.r); };
      E.autoRun(() => go(pickAuto(opts).i));
    })();
  }));

  // ═════════ CALL — cuộc gọi đến ═════════
  // { call: { from: "ruth", ring: 8, accept: [bước], decline: [bước], missed: [bước] } }
  def("call", c => new Promise(res => {
    const C = c.st.call; E.ui.hideBox();
    E.ui.panel(`<div class="sp-call">${face(C.from)}<b>${esc(cname(C.from))}</b><small>${esc(nat({ en: "Incoming call…", vi: "Cuộc gọi đến…" }))}</small>
      <div class="sp-callb"><button class="sp-no" data-k="decline" aria-label="decline">✕</button><button class="sp-yes" data-k="accept" aria-label="accept">✆</button></div></div>`, "call");
    const ring = setInterval(() => E.sfx("phone"), 1400); E.sfx("phone"); E.haptic("MEDIUM");
    let fin = false;
    const go = k => { if (fin || !live(c)) return; fin = true; clearInterval(ring); clearTimeout(tm); const key = C[k] ? k : k === "missed" && C.decline ? "decline" : null; done(res, c, key, "call", key); };
    const tm = setTimeout(() => go("missed"), (C.ring || 10) * 1000);
    c.onCancel?.(() => { fin = true; clearInterval(ring); clearTimeout(tm); DONE.add(res); res(); });
    ui().onclick = e => { const b = e.target.closest("[data-k]"); if (b) go(b.dataset.k); };
    E.autoRun(() => go(E.auto === "r" && Math.random() < 0.3 ? "decline" : "accept"));
  }));

  // ═════════ METER — thanh chỉ số luôn hiện ═════════
  // { meter: { key: "mia", label: { en, vi }, max: 10, min: 0, icon: "♥", color: "#ff7aa8", invert } } · { meter: "mia", off: true }
  const HUD = () => { let el = document.querySelector(".sp-hud"); if (!el) { el = h(`<div class="sp-hud"></div>`); document.querySelector(".se")?.appendChild(el); } return el; };
  const drawHud = () => {
    const R = E.R(); if (!R) return;
    const ms = R.meters || {}, el = HUD();
    el.innerHTML = Object.entries(ms).map(([k, m]) => {
      const v = +R.f[k] || 0, pct = Math.max(0, Math.min(100, ((v - (m.min || 0)) / ((m.max || 10) - (m.min || 0))) * 100));
      return `<div class="sp-mt${m.invert && pct > 70 ? " hot" : ""}" style="--c:${m.color || "var(--se-ac)"}"><span>${esc(m.icon || "")}</span><b>${esc(nat(m.label))}</b><i><em style="width:${pct}%"></em></i><small>${v}</small></div>`;
    }).join("");
    el.hidden = !Object.keys(ms).length;
  };
  E.ui.hud = drawHud;
  def("meter", async ({ st }) => {
    const R = E.R(), m = st.meter; R.meters ||= {};
    if (typeof m === "string") { if (st.off) delete R.meters[m]; }
    else R.meters[m.key] = { label: m.label, max: m.max, min: m.min, icon: m.icon, color: m.color, invert: m.invert };
    drawHud();
  });
  E.on("step", () => { if (E.R()?.meters) drawHud(); });
  const add0 = E.add; E.add = (k, n) => { add0(k, n); if (E.R()?.meters?.[k]) drawHud(); };
  const restore0 = E.ui.restore; E.ui.restore = () => { restore0(); drawHud(); };

  // ═════════ LỜI KHAI làm manh mối ═════════
  // { quote: { id, who, en, vi } } · hoặc gắn vào câu thoại: { say: "rex", en: "I was home.", vi, quote: "rex_home" | true }
  //   → lưu vào R.quotes, thành thẻ “lời khai” trên bảng điều tra (mã thẻ q:<id>). story.quotes = { id: { who, en, vi } } khai sẵn cũng được.
  const quoteOf = id => E.R().quotes?.[id] || E.S().quotes?.[id];
  const addQuote = (id, q, quiet) => {
    const R = E.R(); R.quotes ||= {}; if (R.quotes[id]) return;
    R.quotes[id] = { who: q.who, en: q.en, [E.N]: q[E.N], [E.L]: q[E.L], vi: q.vi };
    if (!quiet && !E.auto) E.ui.toast(`${E.ICON.pen}<span><small>${esc(nat({ en: "Statement saved", vi: "Đã lưu lời khai" }))}</small>${esc(cname(q.who))}</span>`, 1800);
  };
  E.addQuote = addQuote;
  def("quote", async ({ st }) => { const q = typeof st.quote === "string" ? { id: st.quote, ...(E.S().quotes?.[st.quote] || {}) } : st.quote; addQuote(q.id, q, q.quiet); });
  E.side("quote", async (v, st) => { if (!st.say) return; const id = v === true ? "q" + E.hash(st.say + (st.en || "")) : v; addQuote(id, { who: st.say, en: st.en, vi: st.vi, [E.N]: st[E.N], [E.L]: st[E.L] }); });

  // ═════════ BOARD — bảng điều tra kiểu bảng vẽ ═════════
  // { board: { q, links: [{ id, ids: ["cap", "q:rex_home"] | a, b, label: { en, vi }, gives: ["receipt", "q:x"], then }], cards: [mã thêm], need, tries, hint, ok, fail } }
  // Thẻ = đồ vật trong túi · lời khai (q:<id>) · kết luận đã tìm (k:<id của link>, nối tiếp được). Khay dưới cuộn ngang, lọc theo loại.
  // Kéo thẻ từ khay lên bảng (chỗ tuỳ ý), kéo thẻ để sắp xếp · chạm thẻ = xem trước (Đưa lên / Bỏ xuống / Nối với…) · kéo từ ĐINH ĐỎ sang thẻ khác = nối dây.
  // Chỉ nối được 2 thẻ cùng thuộc 1 kết luận (sai = mất lượt nếu có tries). Kết luận ra khi MỌI thẻ của nó nối thành 1 cụm → thẻ kết luận mới + gives mở thêm manh mối.
  // Vị trí thẻ, dây, kết luận lưu theo bước (quay lại bảng vẫn y nguyên).
  // màu dây theo kết luận: đỏ · xanh dương · xanh lá · tím · cam · hồng (đủ tương phản trên nền bảng gỗ)
  const STR = ["#d63c32", "#2f6fdb", "#2f9e5b", "#8e5bd6", "#e07b1f", "#d6457f"];
  def("board", c => new Promise(res => {
    const B = c.st.board, R = E.R(), S = E.S();
    c.resumeHere?.();
    const idsOf = l => l.ids || [l.a, l.b];
    const lid = (l, i) => l.id || "L" + i;
    const st = (R.used[c.key("bd")] ||= { pos: {}, str: [], got: [] });
    const old = R.used[c.key("got")]; if (old && !st.got.length) st.got = String(old).split(",").filter(Boolean).map(Number);
    const need = B.need ?? B.links.length;
    let tab = st.tab || "all", pv = null, link = st.link || null, miss = st.miss || 0, msg = "", busy = false, ending = false;
    let dragCleanup = null, resultTimer = null, keyDown = null, focusAfterPreview = null;
    let lastPin = null, lastPinAt = 0;
    const persist = () => { st.tab = tab; st.link = link; st.miss = miss; E.save(); };
    c.onCancel?.(() => { ending = busy = true; clearTimeout(resultTimer); dragCleanup?.(true); if (keyDown) ui().removeEventListener("keydown", keyDown); DONE.add(res); res(); });
    E.ui.hideBox();
    const info = id => {
      if (id.startsWith("q:")) { const q = quoteOf(id.slice(2)); return q && { kind: "q", name: cname(q.who), text: q, who: q.who }; }
      if (id.startsWith("k:")) { const i = B.links.findIndex((l, k) => lid(l, k) === id.slice(2)); return i >= 0 && st.got.includes(i) && { kind: "k", name: nat({ en: "Conclusion", vi: "Kết luận" }), text: B.links[i].label }; }
      const it = S.items[id]; return it && R.items.includes(id) && { kind: "i", name: nat(it.name), desc: it.desc };
    };
    const pool = () => [...new Set([...R.items, ...Object.keys(R.quotes || {}).map(k => "q:" + k), ...(B.cards || []), ...st.got.map(i => "k:" + lid(B.links[i], i))])].filter(id => info(id));
    const onB = id => !!st.pos[id];
    const art = id => { const f = info(id); return f.kind === "i" ? E.itemArt(id, "sm") : f.kind === "q" ? `<span class="sp-qav">${face(f.who)}</span>` : `<span class="sp-kav">${E.ICON.bulb}</span>`; };
    const short = id => { const f = info(id); return f.kind === "i" ? esc(f.name) : `<b>${esc(f.name)}</b><small>${esc(tgtOr(f.text))}</small>`; };
    const W = 640, H = 520;
    const freeSpot = () => { const n = Object.keys(st.pos).length, col = n % 5, row = Math.floor(n / 5); return [24 + col * 120 + (row % 2) * 30, 30 + row * 110]; };
    const put = (id, xy) => { st.pos[id] = xy || freeSpot(); E.sfx("pick"); E.haptic("LIGHT"); persist(); };
    const draw = () => {
      if (!live(c) || ending) return;
      if (link && (!info(link) || !onB(link))) link = null;
      const active = document.activeElement, focusedPin = active?.dataset?.tack, focusedCard = active?.dataset?.cardOpen;
      const oldBoard = document.querySelector("[data-bw]"), oldTray = document.querySelector("[data-tray]"), oldPanel = document.querySelector(".se-panel.board");
      const scroll = oldBoard ? { left: oldBoard.scrollLeft, top: oldBoard.scrollTop, tray: oldTray?.scrollLeft || 0, panel: oldPanel?.scrollTop || 0 } : (st.scroll || { left: 0, top: 0, tray: 0, panel: 0 });
      st.scroll = scroll;
      const all = pool(), tray = all.filter(id => !onB(id) && (tab === "all" || info(id).kind === tab));
      const hl = B.hint !== false && miss >= 2 ? B.links.find((l, i) => !st.got.includes(i) && idsOf(l).every(id => info(id))) : null;
      E.ui.panel(`<div class="sp-bd3"><div class="se-ddh">${E.ICON.bulb}<small>${esc(nat({ en: "Case board", vi: "Bảng điều tra" }))}</small><span class="sp-pips2">${B.links.map((_, i) => `<i class="${st.got.includes(i) ? "on" : ""}"></i>`).join("")}</span></div>
        <b class="se-ddq">${esc(nat(B.q))}</b>
        <p class="se-mute sp-bdh" aria-live="polite">${esc(nat(link ? { en: `Connect “${info(link)?.name || ""}”: tap another red pin or card. Tap the selected pin again, or the empty board, to cancel.`, vi: `Nối “${info(link)?.name || ""}”: chạm ghim đỏ hoặc thẻ khác. Chạm lại ghim đã chọn, hoặc chỗ trống trên bảng, để hủy.` } : { en: "Tap a clue and choose Put on the board, or drag it up. Tap two red pins to connect them, or drag from a pin to another card. Tap a card to inspect it.", vi: "Chạm thẻ rồi chọn Đưa lên bảng, hoặc kéo thẻ lên. Chạm lần lượt hai ghim đỏ để nối, hoặc kéo từ ghim sang thẻ khác. Chạm thẻ để xem kỹ." }))}</p>
        <div class="sp-bw" data-bw><div class="sp-bc" data-bc style="width:${W}px;height:${H}px"><svg class="sp-str" data-str viewBox="0 0 ${W} ${H}" width="${W}" height="${H}"></svg>
          ${Object.entries(st.pos).filter(([id]) => info(id)).map(([id, [x, y]]) => `<div class="sp-card k-${info(id).kind}${link === id ? " on" : ""}${hl && idsOf(hl)[0] === id ? " hint" : ""}" data-bid="${esc(id)}" style="left:${x}px;top:${y}px;--r:${((E.hash(id) % 7) - 3) * 0.8}deg"><button type="button" class="sp-tack" data-tack="${esc(id)}" aria-label="${esc(nat({ en: `Connect from ${info(id).name}`, vi: `Nối từ ${info(id).name}` }))}" aria-pressed="${link === id}" style="width:44px;height:44px;min-width:44px;min-height:44px;top:-14px;margin-left:-22px;padding:0;border:0;background:transparent;box-shadow:none"><i aria-hidden="true" style="position:absolute;left:13px;top:13px;width:18px;height:18px;border-radius:50%;background:#d63c32;box-shadow:0 2px 3px rgba(0,0,0,.4);pointer-events:none"></i></button><button type="button" data-card-open="${esc(id)}" aria-label="${esc(nat({ en: `Inspect ${info(id).name}`, vi: `Xem kỹ ${info(id).name}` }))}" style="display:grid;justify-items:center;gap:3px;width:100%;padding:0;border:0;background:transparent;color:inherit;font:inherit;text-align:inherit;touch-action:none">${art(id)}<span class="sp-cn">${short(id)}</span></button></div>`).join("")}
          ${Object.keys(st.pos).length ? "" : `<p class="sp-bempty">${esc(nat({ en: "Tap a clue below to place it here, or drag it up", vi: "Chạm thẻ bên dưới để đưa lên bảng, hoặc kéo thẻ lên" }))}</p>`}</div></div>
        <div class="sp-trh"><span>${E.ICON.box}${esc(nat({ en: "Your clues — tap or drag onto the board", vi: "Manh mối — chạm hoặc kéo lên bảng" }))} · <b>${all.filter(id => !onB(id)).length}</b></span><div class="fx-seg sp-tabs">${[["all", { en: "All", vi: "Tất cả" }], ["i", { en: "Items", vi: "Đồ vật" }], ["q", { en: "Statements", vi: "Lời khai" }], ["k", { en: "Conclusions", vi: "Kết luận" }]].map(([k, t]) => `<button data-tab="${k}" class="${tab === k ? "on" : ""}">${esc(nat(t))}</button>`).join("")}</div></div>
        <div class="sp-tray" data-tray>${tray.map(id => `<button class="sp-tc k-${info(id).kind}" data-tid="${esc(id)}">${art(id)}<span class="sp-cn">${short(id)}</span></button>`).join("") || `<small class="se-mute">${esc(nat(all.length ? { en: "Everything is on the board.", vi: "Đã đưa hết lên bảng." } : { en: "No clues yet.", vi: "Chưa có manh mối." }))}</small>`}</div>
        ${msg}
        <div class="sp-bdl2">${B.links.map((l, i) => st.got.includes(i) ? `<div class="sp-con" data-kc="${i}" style="border-left-color:${STR[i % STR.length]}"><em style="color:${STR[i % STR.length]}">${i + 1}</em><span>${esc(nat(l.label))}</span></div>` : "").join("") || ""}${B.links.length - st.got.length ? `<div class="sp-con off"><em>?</em><span>${esc(nat({ en: `${B.links.length - st.got.length} conclusions still hidden`, vi: `Còn ${B.links.length - st.got.length} kết luận chưa tìm ra` }))}</span></div>` : ""}</div>
        <button class="se-btn wide${st.got.length >= need ? " pri" : " ghost"}" data-end>${esc(nat(st.got.length >= need ? { en: "Done", vi: "Xong" } : { en: "I can't find more — move on", vi: "Không tìm thêm được — đi tiếp" }))}</button>
        ${pv ? preview(pv) : ""}</div>`, "deduce board");
      strings(); msg = "";
      const bw = document.querySelector("[data-bw]"), tr = document.querySelector("[data-tray]"), panel = document.querySelector(".se-panel.board");
      if (bw) { bw.scrollLeft = scroll.left; bw.scrollTop = scroll.top; } if (tr) tr.scrollLeft = scroll.tray; if (panel) panel.scrollTop = scroll.panel;
      if (pv) document.querySelector("[data-pvon], [data-pvlink]")?.focus({ preventScroll: true });
      else { const sel = focusedPin ? `[data-tack="${CSS.escape(focusedPin)}"]` : (focusedCard || focusAfterPreview) ? `[data-card-open="${CSS.escape(focusedCard || focusAfterPreview)}"]` : null; if (sel) document.querySelector(sel)?.focus({ preventScroll: true }); focusAfterPreview = null; }
      persist();
    };
    // xem trước 1 thẻ: ảnh to, mô tả / lời khai (+ nghe lại) · nút theo chỗ thẻ đang nằm
    const preview = id => { const f = info(id); if (!f) return ""; const on = onB(id);
      return `<div class="sp-pv" data-pvbg><div class="sp-pvc k-${f.kind}"><button class="sp-pvx" data-pvx aria-label="close">${E.ICON.x}</button>
        <div class="sp-pva">${f.kind === "i" ? E.itemArt(id, "md") : f.kind === "q" ? face(f.who) : `<span class="sp-kav lg">${E.ICON.bulb}</span>`}</div>
        <b>${esc(f.name)}</b>${f.kind === "i" ? (f.desc ? `<p>${esc(nat(f.desc))}</p>` : "") : `<p class="sp-pvq">${E.words(tgtOr(f.text), E.L)}</p>${subHtml(f.text)}`}
        <div class="se-row">${f.kind === "q" ? `<button class="se-btn" data-pvsay>${E.ICON.spk} ${esc(nat({ en: "Listen", vi: "Nghe" }))}</button>` : ""}${on ? `<button class="se-btn" data-pvoff>${esc(nat({ en: "Take off the board", vi: "Bỏ khỏi bảng" }))}</button><button class="se-btn pri" data-pvlink>${esc(nat({ en: "Connect to…", vi: "Nối với…" }))}</button>` : `<button class="se-btn pri" data-pvon>${esc(nat({ en: "Put on the board", vi: "Đưa lên bảng" }))}</button>`}</div></div></div>`; };
    const strings = () => {
      const svg = document.querySelector("[data-str]"); if (!svg) return;
      const ctr = id => { const p = st.pos[id]; return p && [p[0] + 50, p[1] + 8]; };
      // mỗi kết luận 1 màu dây (người dùng 30/10: dây qua cùng 1 thẻ phải phân biệt được) · độ võng khác nhau theo kết luận để dây không chồng
      svg.innerHTML = st.str.map(k => { const [a, b] = k.split("|"), p = ctr(a), q = ctr(b); if (!p || !q) return ""; const li = linkOfStr(k), dx = q[0] - p[0], dy = q[1] - p[1], dist = Math.hypot(dx, dy) || 1, sag = Math.min(30, 6 + dist * 0.09) + (li % 3) * 4;
        // võng nhẹ như sợi chỉ: lệch vuông góc với đoạn nối (ngang → võng xuống, dọc → lệch sang bên), tỉ lệ với độ dài
        const nx = -dy / dist, ny = dx / dist, sgn = ny < 0 || (ny === 0 && li % 2) ? -1 : 1, cx = (p[0] + q[0]) / 2 + nx * sag * sgn, cy = (p[1] + q[1]) / 2 + ny * sag * sgn;
        return `<path style="stroke:${STR[li % STR.length]}" d="M${p[0]} ${p[1]} Q${cx.toFixed(1)} ${cy.toFixed(1)} ${q[0]} ${q[1]}"/>`; }).join("");
    };
    // dây a|b thuộc kết luận nào: ưu tiên kết luận đã tìm, rồi kết luận đầu tiên chứa cả 2 thẻ
    const linkOfStr = k => { const [a, b] = k.split("|"), has = l => idsOf(l).includes(a) && idsOf(l).includes(b); const f = B.links.findIndex((l, i) => st.got.includes(i) && has(l)); return Math.max(0, f >= 0 ? f : B.links.findIndex(has)); };
    const finish = async () => { if (ending || !live(c)) return; ending = busy = true; c.resumeHere?.(false); E.flag(B.key || "board_" + c.key(), st.got.length); const branch = st.got.length >= need ? "ok" : "fail"; if (B[branch]) c.push("board", branch); persist(); if (B.ok || B.fail) await verdict(st.got.length >= need); done(res, c, false); };
    // nối a–b: chỉ khi có kết luận chứa cả 2 · rồi xem kết luận nào đã đủ cụm
    const connect = (a, b) => {
      if (ending || !live(c)) return;
      link = null; if (!a || !b || a === b || !info(a) || !info(b) || !onB(a) || !onB(b)) return draw();
      const k = [a, b].sort().join("|");
      if (st.str.includes(k)) { msg = `<div class="se-hint">${esc(nat({ en: "Already connected.", vi: "Đã nối rồi." }))}</div>`; return draw(); }
      if (!B.links.some(l => idsOf(l).includes(a) && idsOf(l).includes(b))) {
        miss++; E.sfx("wrong"); E.haptic("HEAVY");
        if (B.tries && miss >= B.tries) return finish();
        msg = `<div class="se-hint no">${esc(nat({ en: "Those two don't connect.", vi: "Hai thứ này không liên quan." }))}${B.tries ? " " + esc(nat({ en: `${B.tries - miss} tries left.`, vi: `Còn ${B.tries - miss} lần.` })) : ""}</div>`;
        draw(); [a, b].forEach(id => document.querySelector(`[data-bid="${CSS.escape(id)}"]`)?.classList.add("bad")); return;
      }
      st.str.push(k); E.sfx("tap"); E.haptic("LIGHT");
      const fresh = [];
      B.links.forEach((l, i) => {
        if (st.got.includes(i)) return;
        const ids = idsOf(l); if (!ids.every(id => st.pos[id])) return;
        // cụm liên thông qua dây giữa các thẻ của kết luận này
        const seen = new Set([ids[0]]), q = [ids[0]];
        while (q.length) { const x = q.pop(); for (const s2 of st.str) { const [u, v] = s2.split("|"); const y = u === x ? v : v === x ? u : null; if (y && ids.includes(y) && !seen.has(y)) { seen.add(y); q.push(y); } } }
        if (ids.every(id => seen.has(id))) fresh.push(i);
      });
      if (!fresh.length) return draw();
      for (const i of fresh) { st.got.push(i); E.apply(B.links[i]); for (const g of B.links[i].gives || []) { if (g.startsWith("q:")) { const q = S.quotes?.[g.slice(2)]; if (q) addQuote(g.slice(2), q, true); } else if (!R.items.includes(g)) R.items.push(g); } }
      E.sfx("solve"); E.haptic("MEDIUM"); E.ui.fx("solve");
      const got1 = B.links[fresh[0]], gives = fresh.flatMap(i => B.links[i].gives || []);
      msg = `<div class="se-hint sp-new">${esc(nat({ en: "New conclusion", vi: "Kết luận mới" }))}: <b>${esc(nat(got1.label))}</b>${gives.length ? `<br>${esc(nat({ en: `+${gives.length} new clue(s) in your tray`, vi: `+${gives.length} manh mối mới trong khay` }))}` : ""}</div>`;
      draw(); burst(document.querySelector(`[data-bid="${CSS.escape(b)}"]`), "#e0523f", 16);
      const th = fresh.find(i => B.links[i].then);
      if (th != null || st.got.length >= B.links.length) { busy = true; if (th != null) { c.resumeHere?.(false); c.again(); c.push("board", "links", th, "then"); persist(); } resultTimer = setTimeout(() => { if (!live(c) || ending) return; if (th != null) { E.ui.clear(); return res(); } finish(); }, E.auto ? 0 : 1400); }
    };
    // con trỏ: kéo thẻ khay → bảng · kéo thẻ trên bảng = di chuyển · kéo từ đinh = dây (vẽ dây tạm theo ngón tay)
    ui().onpointerdown = e => {
      if (busy || pv || dragCleanup || !live(c)) return;
      const tack = e.target.closest("[data-tack]"), card = e.target.closest("[data-bid]"), tc = e.target.closest("[data-tid]");
      const el = tack || card || tc; if (!el || e.button > 0) return;
      const bc = document.querySelector("[data-bc]"), x0 = e.clientX, y0 = e.clientY, pointer = e.pointerId; let moved = false, ghost = null;
      const local = ev => { const r = bc.getBoundingClientRect(); return [ev.clientX - r.left, ev.clientY - r.top]; };
      const id = tack ? tack.dataset.tack : card ? card.dataset.bid : tc.dataset.tid, p0 = st.pos[id] && [...st.pos[id]];
      const mv = ev => {
        if (ev.pointerId !== pointer || !live(c)) return;
        if (!moved && Math.hypot(ev.clientX - x0, ev.clientY - y0) < 8) return; moved = true; ev.preventDefault();
        if (tack) { const p = st.pos[id], [x, y] = local(ev), svg = document.querySelector("[data-str]"); svg.querySelector(".tmp")?.remove(); svg.insertAdjacentHTML("beforeend", `<path class="tmp" d="M${p[0] + 50} ${p[1] + 8} L${x} ${y}"/>`); return; }
        if (card) { const [x, y] = local(ev); st.pos[id] = [Math.max(0, Math.min(W - 100, x - 50)), Math.max(0, Math.min(H - 90, y - 20))]; card.style.left = st.pos[id][0] + "px"; card.style.top = st.pos[id][1] + "px"; strings(); return; }
        if (!ghost) { ghost = tc.cloneNode(true); ghost.classList.add("se-ghost"); document.body.appendChild(ghost); tc.classList.add("lifted"); E.haptic("LIGHT"); }
        ghost.style.left = ev.clientX + "px"; ghost.style.top = ev.clientY + "px";
      };
      const up = ev => {
        if (ev.pointerId !== pointer) return;
        dragCleanup?.(false);
        if (!moved) return;
        E.dragAt?.();
        if (ev.type === "pointercancel" || !live(c)) { ghost?.remove(); tc?.classList.remove("lifted"); if (card && p0) st.pos[id] = p0; if (live(c)) draw(); return; }
        if (tack) { document.querySelector("[data-str] .tmp")?.remove(); const t = document.elementFromPoint(ev.clientX, ev.clientY)?.closest("[data-bid]"); return t ? connect(id, t.dataset.bid) : strings(); }
        if (card) return persist();
        ghost?.remove(); tc.classList.remove("lifted");
        const over = document.elementFromPoint(ev.clientX, ev.clientY)?.closest("[data-bw]");
        if (over) { const [x, y] = local(ev); put(id, [Math.max(0, Math.min(W - 100, x - 50)), Math.max(0, Math.min(H - 90, y - 20))]); } else if (p0) st.pos[id] = p0;
        draw();
      };
      dragCleanup = cancel => { document.removeEventListener("pointermove", mv); document.removeEventListener("pointerup", up); document.removeEventListener("pointercancel", up); dragCleanup = null; if (cancel) { ghost?.remove(); tc?.classList.remove("lifted"); document.querySelector("[data-str] .tmp")?.remove(); if (card && p0) st.pos[id] = p0; } };
      document.addEventListener("pointermove", mv, { passive: false }); document.addEventListener("pointerup", up); document.addEventListener("pointercancel", up);
    };
    ui().onclick = e => {
      if (busy || E.dragged() || !live(c)) return;
      const t = e.target;
      if (pv) {
        if (t.closest("[data-pvx]") || (t.closest("[data-pvbg]") && !t.closest(".sp-pvc"))) { focusAfterPreview = pv; pv = null; return draw(); }
        if (t.closest("[data-pvsay]")) { const f = info(pv); return E.say(tgtOr(f.text), f.who, { force: true }); }
        if (t.closest("[data-pvon]")) { put(pv); focusAfterPreview = pv; pv = null; return draw(); }
        if (t.closest("[data-pvoff]")) { delete st.pos[pv]; st.str = st.str.filter(k => !k.split("|").includes(pv)); pv = null; E.sfx("tap"); return draw(); }
        if (t.closest("[data-pvlink]")) { link = pv; pv = null; return draw(); }
        return;
      }
      const tb = t.closest("[data-tab]"); if (tb) { tab = tb.dataset.tab; E.sfx("tap"); return draw(); }
      const pin = t.closest("[data-tack]");
      if (pin) { const id = pin.dataset.tack, now = performance.now(); if (lastPin === id && now - lastPinAt < 280) return; lastPin = id; lastPinAt = now; if (link === id) { link = null; return draw(); } if (link) return connect(link, id); link = id; E.sfx("tap"); return draw(); }
      const card = t.closest("[data-bid]");
      if (card) { if (link) return connect(link, card.dataset.bid); pv = card.dataset.bid; E.sfx("page"); return draw(); }
      const tc = t.closest("[data-tid]"); if (tc) { pv = tc.dataset.tid; E.sfx("page"); return draw(); }
      if (link && t.closest("[data-bw]")) { link = null; return draw(); }
      if (t.closest("[data-end]")) finish();
    };
    keyDown = e => { if (e.repeat && (e.key === "Enter" || e.key === " ")) { e.preventDefault(); return; } if (e.key === "Escape" && (pv || link)) { e.preventDefault(); e.stopPropagation(); if (pv) focusAfterPreview = pv; pv = null; link = null; draw(); } };
    ui().addEventListener("keydown", keyDown);
    if (st.got.length >= B.links.length) return finish();
    draw();
    // tự chơi: đưa thẻ của từng kết luận lên bảng rồi nối lần lượt (kết luận mở ra thẻ mới thì làm tiếp)
    E.autoRun(function step() {
      if (DONE.has(res) || ending || !live(c)) return;
      const i = B.links.findIndex((l, k) => !st.got.includes(k) && idsOf(l).every(id => info(id)));
      if (i < 0) return finish();
      const ids = idsOf(B.links[i]); ids.forEach(id => st.pos[id] || (st.pos[id] = freeSpot()));
      busy = false; for (let k = 1; k < ids.length; k++) connect(ids[k - 1], ids[k]);
      if (!DONE.has(res) && !B.links[i].then) later(step);
    });
  }));

  // ═════════ COMPARE v2 — bắt lỗi biên bản: tìm đúng TỪ bị sửa ═════════
  // { compare: { title, left: { title: "Recording", lines: [{ en, vi }] }, right: { title: "Transcript", lines }, diffs: [dòng có sửa], tries: 3, listen, who, ok, fail } }
  // Mỗi dòng: bản GỐC ở trên (listen: true = chỉ nghe ▶, xem chữ mất 1 tim), bản SAO ở dưới — chạm vào TỪ bị sửa trong bản sao.
  // Từ bị sửa engine tự tìm (so từng từ với bản gốc); cụm sửa liền nhau = 1 lỗi. Dòng chỉ bị xoá bớt chữ → chạm cả dòng.
  // Đúng: đóng dấu đỏ, hiện chữ gốc ngay trên · sai: mất 1 tim. Tìm đủ = ok; hết tim / bấm Xong khi chưa đủ = fail.
  const cwords = t => String(t).split(/\s+/).filter(Boolean), ckey = w => w.toLowerCase().replace(/[^\p{L}\p{N}]/gu, "");
  const keepOf = (a, b) => {
    const m = a.length, n = b.length, d = Array.from({ length: m + 1 }, () => Array(n + 1).fill(0));
    for (let i = m - 1; i >= 0; i--) for (let j = n - 1; j >= 0; j--) d[i][j] = ckey(a[i]) === ckey(b[j]) ? d[i + 1][j + 1] + 1 : Math.max(d[i + 1][j], d[i][j + 1]);
    const keep = new Set(); let i = 0, j = 0;
    while (i < m && j < n) { if (ckey(a[i]) === ckey(b[j])) { keep.add(j); i++; j++; } else if (d[i + 1][j] >= d[i][j + 1]) i++; else j++; }
    return keep;
  };
  def("compare", c => new Promise(res => {
    const C = c.st.compare, hearts = C.tries ?? 3, who = C.who || "narr";
    const rows = C.right.lines.map((l, i) => {
      const org = C.left.lines[i] || "", cw = cwords(tgtOr(l)), keep = keepOf(cwords(tgtOr(org)), cw), hit = C.diffs.includes(i);
      const bad = cw.map((_, j) => hit && !keep.has(j));
      return { i, l, org, cw, bad, whole: hit && !bad.some(Boolean) };
    });
    const targets = []; rows.forEach(r => { if (r.whole) targets.push(r.i + ":-1"); else r.bad.forEach((b, j) => { if (b && !(j > 0 && r.bad[j - 1])) targets.push(r.i + ":" + j); }); });
    const tOf = (r, j) => { const R0 = rows[r]; if (R0.whole) return r + ":-1"; if (j < 0 || !R0.bad[j]) return null; while (j > 0 && R0.bad[j - 1]) j--; return r + ":" + j; };
    const found = new Set(), shown = new Set(), missW = new Set(); let wrong = 0, over = false;
    E.ui.hideBox();
    const rowHtml = r => {
      const lis = C.listen && !shown.has(r.i) && !rows[r.i].cw.every((_, j) => found.has(tOf(r.i, j)));
      const top = lis ? `<button class="sp-cplay" data-play="${r.i}">${E.ICON.spk}<span>${esc(nat({ en: "Listen", vi: "Nghe" }))}</span></button><button class="sp-cshow" data-show="${r.i}">${esc(nat({ en: "Show text (−1 ♥)", vi: "Xem chữ (−1 ♥)" }))}</button>`
        : `${C.listen ? `<button class="sp-cplay sm" data-play="${r.i}" aria-label="listen">${E.ICON.spk}</button>` : ""}<span>${esc(tgtOr(r.org))}</span>`;
      const doneLine = r.whole && found.has(r.i + ":-1");
      const words = r.cw.map((w, j) => { const t = tOf(r.i, j), f = t && found.has(t); return `<button class="sp-cw${f ? " hit" : ""}${missW.has(r.i + ":" + j) ? " miss" : ""}" data-w="${r.i}:${j}">${esc(w)}</button>`; }).join(" ");
      const anyHit = rows[r.i].cw.some((_, j) => { const t = tOf(r.i, j); return t && found.has(t); }) || doneLine;
      return `<div class="sp-crow${anyHit ? " fixed" : ""}"><div class="sp-corg"><em>${esc(nat(C.left.title || { en: "Original", vi: "Gốc" }))}</em>${top}</div>
        <div class="sp-ccpy${doneLine ? " hitline" : ""}" ${r.whole ? `data-line="${r.i}"` : ""}><em>${esc(nat(C.right.title || { en: "Copy", vi: "Bản sao" }))}</em><span>${words}</span>${anyHit ? `<i class="sp-stamp">${esc(nat({ en: "ALTERED", vi: "ĐÃ SỬA" }))}</i>` : ""}</div></div>`;
    };
    const draw = (msg = "") => E.ui.panel(`<div class="se-doc sp-cmp2"><div class="se-doch">${E.ICON.doc}<b>${esc(nat(C.title))}</b></div>
      <div class="sp-pips">${targets.map((_, k) => `<i class="${k < found.size ? "on" : ""}"></i>`).join("")}<b>${"♥".repeat(Math.max(0, hearts - wrong))}<s>${"♥".repeat(Math.min(hearts, wrong))}</s></b></div>
      <p class="se-mute sp-chelp">${esc(nat(C.listen ? { en: "Listen to the original, then tap the word in the copy that's different.", vi: "Nghe bản gốc rồi chạm vào từ bị sửa trong bản sao." } : { en: "Compare each pair. Tap the word in the copy that's different from the original.", vi: "So từng cặp. Chạm vào từ trong bản sao bị sửa khác bản gốc." }))}</p>
      <div class="sp-crows">${rows.map(rowHtml).join("")}</div></div>
      ${msg}<button class="se-btn pri wide" data-ok>${esc(nat(found.size >= targets.length ? { en: "Done", vi: "Xong" } : { en: `Done (${targets.length - found.size} left)`, vi: `Xong (còn ${targets.length - found.size} chỗ)` }))}</button>`, "present cmp");
    const fin = async () => { if (over) return; over = true; const ok = found.size >= targets.length; E.flag(C.key || "cmp_" + c.key(), found.size); await verdict(ok, nat(ok ? { en: "All changes found!", vi: "Tìm đủ chỗ bị sửa!" } : { en: "Missed some", vi: "Còn sót chỗ" })); done(res, c, ok ? C.ok : C.fail, "compare", ok ? "ok" : "fail"); };
    const lose = el => { wrong++; E.sfx("wrong"); E.haptic("HEAVY"); E.ui.fx("shake"); if (wrong >= hearts) return fin(), true; return false; };
    const hit = (t, el) => { found.add(t); E.sfx("solve"); E.haptic("MEDIUM"); E.ui.fx("objection"); draw(); burst(el && document.querySelector(`[data-w="${el}"]`) || document.querySelector(".sp-crows"), "#e0523f", 14); if (found.size >= targets.length) setTimeout(fin, E.auto ? 1 : 900); };
    ui().onclick = e => {
      if (over) return;
      const p = e.target.closest("[data-play]"); if (p) return E.say(tgtOr(rows[+p.dataset.play].org), who, { force: true, narr: who === "narr" });
      const sh = e.target.closest("[data-show]"); if (sh) { shown.add(+sh.dataset.show); E.sfx("page"); if (!lose()) draw(); return; }
      const w = e.target.closest("[data-w]");
      if (w) {
        const [r, j] = w.dataset.w.split(":").map(Number), t = tOf(r, j) || (rows[r].whole ? r + ":-1" : null);
        if (t && !found.has(t)) return hit(t, w.dataset.w);
        if (t) return;
        missW.add(w.dataset.w); if (!lose()) draw(`<div class="se-hint no">${esc(nat({ en: "That word matches the original.", vi: "Từ đó giống bản gốc." }))}</div>`); return;
      }
      if (e.target.closest("[data-ok]")) fin();
    };
    draw();
    E.autoRun(() => { targets.forEach(t => found.add(t)); fin(); });
  }));

  // ═════════ SNEAK — lẻn qua ═════════
  // { sneak: { goal, max: 6, key, rows: [{ t: { en, vi }, opts: [{ en, vi, risk: 0-3, then, set }] }], caught: [bước], ok: [bước] } }
  def("sneak", c => new Promise(res => {
    // trạng thái (đoạn đang đi, tiếng động) lưu theo khoá bước → chọn đường có bước con (then) thì NHƯỜNG cho bước con chạy, xong quay lại đúng đoạn
    const N = c.st.sneak, R = E.R(), sk = c.key("st");
    const st0 = R.used[sk] || { row: 0, noise: 0 };
    let { row, noise } = st0;
    const max = N.max || 6, rnd = seedRnd(c.key() + ":" + row + ":" + noise);
    E.ui.hideBox();
    const draw = (msg = "") => {
      const r = N.rows[row];
      E.ui.panel(`<div class="sp-sn"><div class="se-xg"><span>${esc(nat(N.goal))}</span><b>${row + 1}/${N.rows.length}</b></div>
        <div class="sp-noise${noise / max >= .66 ? " hi" : ""}"><small>${esc(nat({ en: "Noise — full means you're caught", vi: "Tiếng động — đầy là bị phát hiện" }))}</small><i><em style="width:${Math.min(100, (noise / max) * 100)}%"></em></i><b>${noise}/${max}</b></div>
        <p class="sp-snt">${esc(nat(r.t))}</p>${msg}
        <div class="se-chs">${r.opts.map((o, i) => { const k = Math.max(0, Math.min(3, o.risk || 0)); return `<button class="se-ch-b act" data-i="${i}"><span>${esc(nat(o))}</span>${N.showRisk ? `<small class="sp-risk r${k}">${esc(nat([{ en: "Safe", vi: "An toàn" }, { en: "Low risk", vi: "Rủi ro thấp" }, { en: "Risky", vi: "Rủi ro vừa" }, { en: "Very risky", vi: "Rủi ro cao" }][k]))}</small>` : ""}</button>`; }).join("")}</div></div>`, "sneak");
    };
    const finish = async key => { delete R.used[sk]; await verdict(key === "ok", nat(key === "ok" ? { en: "Slipped past!", vi: "Qua được rồi!" } : { en: "Caught!", vi: "Bị phát hiện!" })); done(res, c, !!N[key], "sneak", key); };
    const go = i => {
      const o = N.rows[row].opts[i], risk = o.risk || 0;
      // rủi ro: luôn +risk/2 (làm tròn lên), xui thì +1 nữa (xác suất theo rủi ro) — định trước theo khoá bước + vị trí
      const add = Math.ceil(risk / 2) + (rnd() < risk * 0.22 ? 1 : 0);
      noise += add; E.apply(o); E.sfx(add > 1 ? "wrong" : "steps");
      if (add > 1) E.ui.fx("pulse");
      if (noise >= max) { E.flag(N.key || "caught", 1); return finish("caught"); }
      const thenOf = row;
      row++;
      if (row >= N.rows.length && !o.then) { E.flag((N.key || "sneak") + "_noise", noise); return finish("ok"); }
      if (o.then) {
        // bước con chạy trước, rồi quay lại bước sneak này (row đã +1); hết đoạn → lần quay lại sẽ kết thúc ở “ok”
        R.used[sk] = { row, noise };
        E.ui.clear(); c.again(); c.push("sneak", "rows", thenOf, "opts", i, "then");
        return res();
      }
      R.used[sk] = { row, noise };
      draw(add > 1 ? `<div class="se-hint no">${esc(nat({ en: "Something creaked…", vi: "Có tiếng cót két…" }))}</div>` : "");
      if (add > 0) { const nz = document.querySelector(".sp-noise"); floatTxt(nz, "+" + add, add > 1 ? "#ef4444" : "#f2b84b"); if (add > 1) { nz.classList.add("bump"); E.ui.fx("shake"); E.haptic("HEAVY"); } }
      else burst(document.querySelector(".sp-snt"), "#6fcf97", 6);
    };
    if (row >= N.rows.length) { E.flag((N.key || "sneak") + "_noise", noise); return finish("ok"); }
    ui().onclick = e => { const b = e.target.closest("[data-i]"); if (b) go(+b.dataset.i); };
    draw();
    E.autoRun(() => { const r = N.rows[row]; const i = E.auto === "r" ? Math.floor(Math.random() * r.opts.length) : r.opts.reduce((b, o, k) => ((o.risk || 0) < (r.opts[b].risk || 0) ? k : b), 0); go(i); if (document.querySelector(".sp-sn") && E.auto) { const tick = () => { if (!document.querySelector(".sp-sn")) return; const r2 = N.rows[row]; if (!r2) return; go(E.auto === "r" ? Math.floor(Math.random() * r2.opts.length) : 0); setTimeout(tick, 5); }; setTimeout(tick, 5); } });
  }));


  // ═════════ QTE — bấm nhanh ═════════
  // { qte: { prompt, kind: "tap" | "seq" | "hold", n: 12, seq: ["←","↑","→"], ms: 5000, ok, fail } }
  def("qte", c => new Promise(res => {
    const Q = c.st.qte, kind = Q.kind || "tap", ms = Q.ms || 5000, need = Q.n || 12, holdMs = Q.hold || 1800;
    E.ui.hideBox(); E.ui.urgent(true);
    let cnt = 0, fin = false, holdT = 0, raf = 0, lastTap = 0;
    const t0 = performance.now();
    const seq = Q.seq || ["◀", "▲", "▶", "▼"].sort(() => 0.5 - Math.random()).slice(0, Q.n || 4);
    let pad = ["◀", "▲", "▼", "▶"]; const KEY = { ArrowLeft: "◀", ArrowUp: "▲", ArrowRight: "▶", ArrowDown: "▼" };
    // vẽ lại giữa chừng (seq) không được làm đồng hồ chạy lại từ đầu → trừ phần đã trôi qua
    const draw = () => E.ui.panel(`<div class="sp-qte"><div class="se-ask">${esc(nat(Q.prompt))}</div>
      <div class="se-timer"><i style="animation-duration:${ms / 1000}s;animation-delay:-${((performance.now() - t0) / 1000).toFixed(2)}s"></i></div><small class="sp-sec" data-sec>${Math.ceil(ms / 1000)}s</small>
      ${kind === "tap" ? `<button class="sp-qb ring" data-q style="--p:${cnt / need}"><b>${need - cnt}</b><small>${esc(nat({ en: "TAP!", vi: "CHẠM!" }))}</small></button>`
        : kind === "hold" ? `<button class="sp-qb ring hold" data-h style="--p:0"><b>${esc(nat({ en: "HOLD", vi: "GIỮ" }))}</b><small data-hs>${esc(nat({ en: "press and keep holding", vi: "nhấn và giữ chặt" }))}</small></button>`
        : `<div class="sp-seq">${seq.map((k, i) => `<span class="${i < cnt ? "on" : i === cnt ? "next" : ""}">${esc(k)}</span>`).join("")}</div><div class="sp-qpad">${pad.map(k => `<button data-s="${k}">${k}</button>`).join("")}</div>`}</div>`, "qte");
    const end = async (ok, why) => {
      if (fin || !live(c)) return; fin = true; clearTimeout(tm); clearInterval(iv); cancelAnimationFrame(raf); document.removeEventListener("keydown", key); E.ui.urgent(false); E.flag(Q.key || "qte_" + c.key(), ok ? 1 : 0);
      const b = document.querySelector(".sp-qb, .sp-seq");
      if (ok) { burst(b, "#5eead4", 18); E.sfx("solve"); E.haptic("MEDIUM"); E.ui.fx("punch"); } else { E.sfx("hit"); E.haptic("HEAVY"); E.ui.fx("redflash"); }
      await verdict(ok, ok ? 0 : why === "time" ? nat({ en: "Time's up!", vi: "Hết giờ!" }) : 0);
      done(res, c, ok ? Q.ok : Q.fail, "qte", ok ? "ok" : "fail");
    };
    const tm = setTimeout(() => end(false, "time"), ms);
    // đếm ngược số giây + đồng hồ chuyển đỏ khi còn dưới 1/3
    const iv = setInterval(() => {
      if (kind === "tap" && !Q.easy && cnt > 0 && !fin && performance.now() - lastTap > 350) { cnt = Math.max(0, cnt - (Q.decay ?? 0.35)); const q = document.querySelector("[data-q]"); if (q) { q.style.setProperty("--p", cnt / need); q.querySelector("b").textContent = Math.ceil(need - cnt); } }
      const left = Math.max(0, ms - (performance.now() - t0)), s = document.querySelector("[data-sec]"); if (s) { s.textContent = Math.ceil(left / 1000) + "s"; s.classList.toggle("low", left < ms / 3); } }, 200);
    const tapBtn = b => { b.classList.remove("pop"); void b.offsetWidth; b.classList.add("pop"); };
    const seqPress = k => {
      if (fin || !k) return;
      if (k === seq[cnt]) { cnt++; E.sfx("tap"); E.haptic("LIGHT"); if (!Q.easy) pad = pad.slice().sort(() => 0.5 - Math.random()); if (cnt >= seq.length) { draw(); return end(true); } draw(); burst(document.querySelector(".sp-seq span.on:last-of-type") || document.querySelector(".sp-seq"), "#5eead4", 6); }
      else { E.sfx("wrong"); E.haptic("HEAVY"); cnt = 0; draw(); const s = document.querySelector(".sp-seq"); s && s.classList.add("bad"); floatTxt(s, nat({ en: "Wrong — again!", vi: "Sai — làm lại!" }), "#ff6b5a"); }
    };
    const key = e => { if (kind === "seq" && KEY[e.key]) { e.preventDefault(); seqPress(KEY[e.key]); } };
    document.addEventListener("keydown", key);
    c.onCancel?.(() => { fin = true; clearTimeout(tm); clearInterval(iv); cancelAnimationFrame(raf); document.removeEventListener("keydown", key); DONE.add(res); res(); });
    draw();
    const el = ui();
    el.onclick = e => {
      if (fin || !live(c)) return;
      const q = e.target.closest("[data-q]");
      if (kind === "tap" && q) { cnt++; lastTap = performance.now(); E.sfx("tap"); E.haptic("LIGHT"); floatTxt(q, "+1", "#ffd166"); tapBtn(q); if (cnt >= need) { q.style.setProperty("--p", 1); return end(true); } q.style.setProperty("--p", cnt / need); q.querySelector("b").textContent = Math.ceil(need - cnt); }
      const s = e.target.closest("[data-s]"); if (kind === "seq" && s) seqPress(s.dataset.s);
    };
    if (kind === "hold") {
      const stop = early => {
        cancelAnimationFrame(raf); const b = el.querySelector("[data-h]");
        if (holdT && early && !fin) { E.sfx("wrong"); b && b.classList.add("bad"); const h = el.querySelector("[data-hs]"); if (h) h.textContent = nat({ en: "Too soon! Hold again", vi: "Buông sớm! Giữ lại nào" }); setTimeout(() => b && b.classList.remove("bad"), 400); }
        holdT = 0; if (b) { b.classList.remove("on"); b.style.setProperty("--p", 0); }
      };
      const loop = () => { const p = Math.min(1, (performance.now() - holdT) / holdMs), b = el.querySelector("[data-h]"); b && b.style.setProperty("--p", p); if (p >= 1) { holdT = 0; return end(true); } raf = requestAnimationFrame(loop); };
      el.onpointerdown = e => { const b = e.target.closest("[data-h]"); if (!b || holdT || fin) return; holdT = performance.now(); b.classList.add("on"); E.sfx("tap"); E.haptic("LIGHT"); loop(); };
      el.onpointerup = el.onpointercancel = () => stop(true);
    }
    E.autoRun(() => end(E.auto === "r" ? Math.random() < 0.7 : true));
  }));

  // ═════════ WHOM — chọn 1 người ═════════
  // { whom: { prompt, chars: ["tom", "owen"], then: { tom: [bước], owen: [bước] }, set: "accused" } }
  def("whom", c => new Promise(res => {
    const W = c.st.whom, list = W.chars.filter(id => !W.if?.[id] || cond(W.if[id], c.s));
    E.ui.hideBox();
    if (!list.length) return done(res, c, W.empty, "whom", "empty");
    E.ui.panel(`<div class="se-ask">${esc(nat(W.prompt))}</div><div class="sp-whom">${list.map(id => `<button data-w="${id}" style="--c:${color(id)}"><span class="sp-wp"><i class="im-${esc(id)}"></i></span><b>${esc(cname(id))}</b></button>`).join("")}</div>`, "whom");
    let lock = false, pend = null;
    const go = id => { if (!live(c) || DONE.has(res) || !list.includes(id)) return; if (W.set) E.flag(W.set, id); E.sfx("pick"); done(res, c, W.then?.[id], "whom", "then", id); };
    ui().onclick = e => {
      if (e.target.closest("[data-wno]")) { pend = null; E.sfx("tap"); document.querySelector(".sp-whom")?.classList.remove("chosen"); document.querySelectorAll(".sp-whom .sel").forEach(x => x.classList.remove("sel")); document.querySelector(".sp-wcf")?.remove(); return; }
      const yes = e.target.closest("[data-wyes]");
      const b = yes ? document.querySelector(`[data-w="${pend}"]`) : e.target.closest("[data-w]"); if (!b || lock) return;
      if (W.confirm && !yes) {
        pend = b.dataset.w; document.querySelectorAll(".sp-whom .sel").forEach(x => x.classList.remove("sel")); document.querySelector(".sp-whom")?.classList.add("chosen"); b.classList.add("sel"); E.sfx("pick"); E.haptic("LIGHT");
        document.querySelector(".sp-wcf")?.remove();
        b.closest(".se-panel").insertAdjacentHTML("beforeend", `<div class="sp-wcf"><b>${esc(nat(typeof W.confirm === "object" ? W.confirm : { en: "Are you sure? There’s no going back.", vi: "Chắc chưa? Không quay lại được đâu." }))}</b><div class="se-row"><button class="se-btn" data-wno>${esc(nat({ en: "Think again", vi: "Nghĩ lại" }))}</button><button class="se-btn pri" data-wyes>${esc(cname(pend))}</button></div></div>`);
        return;
      }
      lock = true; document.querySelector(".sp-wcf")?.remove();
      document.querySelector(".sp-whom")?.classList.add("chosen"); b.classList.add("sel"); burst(b, color(b.dataset.w), 10); E.haptic("LIGHT");
      setTimeout(() => go(b.dataset.w), E.auto ? 0 : 420);
    };
    E.autoRun(() => go(pickAuto(list)));
  }));

  // ═════════ NOTE — sổ ghi chép ═════════
  def("note", async ({ st }) => { const R = E.R(); (R.jot ||= []).push({ ch: R.ch, t: st.note }); if (!st.quiet) E.ui.toast(`${E.ICON.pen}<span><small>${esc(nat({ en: "Noted", vi: "Đã ghi chép" }))}</small><b>${esc(nat(st.note))}</b></span>`, 2400, "item"); E.ui.dot(true); });

  // ═════════ GIFT — tặng quà ═════════
  // { gift: { to: "mia", key: "mia", from: "bag" | [{ id, en, vi, pic }], likes: { <id>: 3 | 1 | 0 | -2 }, react: { love, like, meh, hate }, take: true } }
  def("gift", c => new Promise(res => {
    const G0 = c.st.gift, R = E.R(), S = E.S();
    const opts = Array.isArray(G0.from) ? G0.from : R.items.map(id => ({ id, ...S.items[id]?.name, item: 1 }));
    E.ui.hideBox();
    E.ui.panel(`<div class="se-ask">${esc(nat(G0.prompt || { en: "Choose a gift for " + cname(G0.to), vi: "Chọn quà tặng " + cname(G0.to) }))}</div>
      <div class="sp-gto" data-to>${face(G0.to)}<span>${esc(nat({ en: `Drag a gift to ${cname(G0.to)} — or tap it`, vi: `Kéo quà tới ${cname(G0.to)} — hoặc chạm vào quà` }))}</span></div>
      <div class="sp-gift">${opts.map((o, i) => `<button data-g="${i}">${o.item ? E.itemArt(o.id, "md") : o.pic ? `<span class="se-ia md"><i class="im-${esc(o.pic)}"></i></span>` : `<span class="sp-gi">${E.ICON.box}</span>`}<b>${esc(o.item ? nat(S.items[o.id]?.name) : nat(o))}</b></button>`).join("")}</div>
      ${G0.skip ? `<button class="se-btn wide" data-skip>${esc(nat(G0.skip))}</button>` : ""}`, "gift");
    let lock = false;
    const go = i => {
      if (lock) return; lock = true;
      const o = opts[i], v = G0.likes?.[o.id] ?? 0;
      const btn = document.querySelector('[data-g="' + i + '"]');
      if (btn && !E.auto) {
        document.querySelector(".sp-gift")?.classList.add("chosen"); btn.classList.add("sel");
        const em = nat(v >= 3 ? { en: "Loves it!", vi: "Rất thích!" } : v >= 1 ? { en: "Likes it", vi: "Thích" } : v >= 0 ? { en: "Hmm…", vi: "Ừm…" } : { en: "Hates it", vi: "Ghét" });
        burst(btn, v >= 1 ? "#ff7eb6" : "#8a8fa0", v >= 3 ? 18 : 8); floatTxt(btn, em + (v ? " ♥" + (v > 0 ? "+" : "") + v : ""), v >= 1 ? "#ff7eb6" : "#fca5a5");
        E.haptic(v >= 1 ? "MEDIUM" : "HEAVY");
        setTimeout(() => fin(o, v), 750); return;
      }
      fin(o, v);
    };
    const fin = async (o, v) => {
      const tier = v >= 3 ? "love" : v >= 1 ? "like" : v >= 0 ? "meh" : "hate";
      E.add(G0.key || G0.to, v);
      if (o.item && G0.take !== false) R.items = R.items.filter(x => x !== o.id);
      E.flag((G0.key || G0.to) + "_gift", o.id);
      E.sfx(v >= 1 ? "up" : "down"); if (v >= 3) E.effect.run("particles", { kind: "petals", ms: 3000 });
      const key = G0.react?.[tier] ? tier : null;
      if (!key) await aftermath(G0.to, { love: { en: "Oh wow… this is perfect. Thank you!", vi: "Ôi… cái này tuyệt quá. Cảm ơn nhé!" }, like: { en: "That's sweet of you. Thanks.", vi: "Dễ thương ghê. Cảm ơn nha." }, meh: { en: "Oh. Um… thanks.", vi: "À. Ừm… cảm ơn." }, hate: { en: "…Why would you give me this?", vi: "…Sao lại tặng mình cái này?" } }[tier], heart(G0.to, v), { love: "happy", like: "smile", meh: "", hate: "sad" }[tier]);
      done(res, c, key, "gift", "react", key);
    };
    ui().onpointerdown = E.dragger({ src: "[data-g]", dst: "[data-to]", drop: (a, b) => { if (b) go(+a.dataset.g); } });
    ui().onclick = e => { if (E.dragged()) return; const b = e.target.closest("[data-g]"); if (b) go(+b.dataset.g); if (e.target.closest("[data-skip]")) done(res, c); };
    if (!opts.length) return done(res, c);
    E.autoRun(() => go(E.auto === "r" ? Math.floor(Math.random() * opts.length) : 0));
  }));

  // ═════════ TOPICS — chọn chủ đề nói chuyện ═════════
  // { topics: { with: "mia", key: "mia", rounds: 3, list: [{ id, en, vi, score: 2 | 1 | 0 | -1, then }] , end } }
  def("topics", c => new Promise(res => {
    const P = c.st.topics, R = E.R(), usedK = c.key("used");
    const used = new Set((R.used[usedK] || "").split(",").filter(Boolean));
    const rounds = P.rounds || 3;
    if (used.size >= rounds) { delete R.used[usedK]; return done(res, c, P.end, "topics", "end"); }
    E.ui.hideBox();
    const left = P.list.filter(t => !used.has(t.id) && cond(t.if, c.s));
    E.ui.panel(`<div class="se-ask">${esc(nat(P.prompt || { en: "What do you talk about?", vi: "Bạn nói chuyện gì?" }))} <span class="sp-dots">${Array.from({ length: rounds }, (_, i) => `<i class="${i < used.size ? "on" : i === used.size ? "cur" : ""}"></i>`).join("")}</span></div>
      <div class="sp-top">${left.map(t => `<button data-t="${esc(t.id)}"><span>${icon(t.icon, "talk")}</span><b>${esc(nat(t))}</b></button>`).join("")}</div>`, "topics");
    const go = id => {
      const t = P.list.find(x => x.id === id); used.add(id); R.used[usedK] = [...used].join(",");
      const sc = t.score || 0;
      E.add(P.key || P.with, sc); E.sfx(sc > 0 ? "up" : sc < 0 ? "down" : "tap");
      const nxt = async () => { if (!t.then && P.with) await aftermath(P.with, sc > 0 ? { en: "Oh, I love talking about this!", vi: "Ôi, mình thích nói chuyện này lắm!" } : sc < 0 ? { en: "Hmm. Can we talk about something else?", vi: "Ừm. Nói chuyện khác được không?" } : { en: "Sure, I guess.", vi: "Ừ, cũng được." }, heart(P.key || P.with, sc), sc > 0 ? "happy" : sc < 0 ? "sad" : ""); E.ui.clear(); c.again(); if (t.then) c.push("topics", "list", P.list.indexOf(t), "then"); res(); };
      const b = document.querySelector('[data-t="' + id + '"]');
      if (!b || E.auto) return nxt();
      b.classList.add("sel"); document.querySelector(".sp-top")?.classList.add("chosen");
      floatTxt(b, sc ? "♥" + (sc > 0 ? "+" : "") + sc : "…", sc > 0 ? "#6fcf97" : sc < 0 ? "#fca5a5" : "#c9ced9"); if (sc > 0) burst(b, "#6fcf97", 10);
      setTimeout(nxt, 650);
    };
    let lk = false;
    ui().onclick = e => { const b = e.target.closest("[data-t]"); if (b && !lk) { lk = true; go(b.dataset.t); } };
    if (!left.length) { delete R.used[usedK]; return done(res, c, P.end, "topics", "end"); }
    E.autoRun(() => go(pickAuto(left).id));
  }));

  // ═════════ DATE — lên lịch hẹn ═════════
  // { date: { with, key, slots: 3, spots: [{ id, en, vi, pic, desc, score, then }], good: 5, great: [bước], ok: [bước], bad: [bước] } }
  def("date", c => new Promise(res => {
    const D = c.st.date;
    E.ui.hideBox();
    const n = D.slots ?? 3, available = new Set((D.spots || []).filter(s => cond(s.if, c.s)).map(s => s.id));
    if (!Number.isInteger(n) || n < 1 || available.size < n) return unavailable(res, c, "date", { en: "There are not enough available places to complete this plan. No outing has been booked.", vi: "Chưa có đủ địa điểm để hoàn thành kế hoạch này. Chưa có buổi đi chơi nào được sắp xếp." }, ["empty", "bad", "fail"]);
    const slot = Array(n).fill(null), nF = () => slot.filter(Boolean).length, nx = () => slot.indexOf(null);
    let pickd = [];
    const draw = () => E.ui.panel(`<div class="se-ask">${esc(nat(D.prompt || { en: "Plan the date", vi: "Lên kế hoạch buổi hẹn" }))}</div>
      <div class="sp-plan">${Array.from({ length: n }, (_, i) => { const s = D.spots.find(x => x.id === slot[i]); return `<div class="sp-slot${s ? " on" : ""}${!s && i === nx() ? " next" : ""}" data-slot="${i}"${s ? ` data-rm="${i}"` : ""}><em>${i + 1}</em><span>${s ? esc(nat(s)) : esc(nat(i === nx() ? { en: "Drop a place here", vi: "Thả 1 nơi vào đây" } : { en: "Later", vi: "Sau đó" }))}</span>${s ? "<u>×</u>" : ""}</div>`; }).join("")}</div>
      <p class="se-mute sp-sh">${esc(nat({ en: "Drag places into the plan · drag to swap · tap to remove", vi: "Kéo nơi vào lịch · kéo để đổi chỗ · chạm để gỡ" }))}</p>
      <div class="sp-spots">${D.spots.filter(s => !slot.includes(s.id) && cond(s.if, c.s)).map(s => `<button data-s="${esc(s.id)}">${s.pic ? `<i class="im-${esc(s.pic)}"></i>` : ""}<b>${esc(nat(s))}</b>${s.desc ? `<small>${esc(nat(s.desc))}</small>` : ""}</button>`).join("")}</div>
      <div class="se-row"><button class="se-btn" data-undo ${nF() ? "" : "disabled"}>${esc(nat({ en: "Undo last", vi: "Bỏ nơi cuối" }))}</button><button class="se-btn pri${nF() === n ? "" : " dim"}" data-go ${nF() === n ? "" : "disabled"}>${esc(nF() === n ? nat({ en: "Let's go", vi: "Đi thôi" }) : nat({ en: `${n - nF()} more to choose`, vi: `Chọn thêm ${n - nF()} nơi` }))}</button></div>`, "date");
    let ran = false;
    const run = async () => {
      if (ran || !live(c) || nF() !== n) return; ran = true; pickd = slot.filter(Boolean);
      const R = E.R();
      const score = pickd.reduce((a, id) => a + (D.spots.find(s => s.id === id).score || 0), 0);
      E.add(D.key || D.with, score); E.flag((D.key || D.with) + "_date", pickd.join(">"));
      const tier = score >= (D.great_at ?? (D.good ?? 4) + 2) && D.great ? "great" : score >= (D.good ?? 4) ? "ok" : "bad";
      E.ui.clear();
      if (!D[tier] && D.with) await aftermath(D.with, { great: { en: "Best day ever. Let's do this again.", vi: "Ngày tuyệt nhất luôn. Mình đi nữa nhé." }, ok: { en: "That was fun. Thanks for today.", vi: "Vui ghê. Cảm ơn vì hôm nay nhé." }, bad: { en: "Well… that was a day.", vi: "Chà… cũng là một ngày." } }[tier], heart(D.key || D.with, score), tier === "bad" ? "sad" : "happy");
      // chạy hoạt động theo đúng thứ tự đã chọn, rồi kết quả — xếp ngăn xếp ngược (cuối chạy trước bị đè)
      if (D[tier]) c.push("date", tier);
      for (const id of [...pickd].reverse()) { const i = D.spots.findIndex(s => s.id === id); if (D.spots[i].then) c.push("date", "spots", i, "then"); }
      void R; res();
    };
    ui().onclick = e => {
      if (E.dragged()) return;
      const s = e.target.closest("[data-s]"); if (s && nx() >= 0) return put(nx(), s.dataset.s);
      const rm = e.target.closest("[data-rm]"); if (rm) { slot[+rm.dataset.rm] = null; E.sfx("tap"); return draw(); }
      if (e.target.closest("[data-undo]")) { const k = slot.map((v, i) => v ? i : -1).filter(i => i >= 0).pop(); if (k >= 0) slot[k] = null; return draw(); }
      if (e.target.closest("[data-go]") && nF() === n) run();
    };
    const put = (i, id) => { slot[i] = id; E.sfx("pick"); E.haptic("LIGHT"); draw(); const sl = document.querySelectorAll(".sp-slot")[i]; sl?.classList.add("fill"); burst(sl, "#ff9ec7", 8); if (nF() === n) floatTxt(document.querySelector("[data-go]"), "♥", "#ff7eb6"); };
    // kéo: nơi → ô (ô có sẵn thì nơi cũ trả về danh sách) · ô → ô khác = đổi chỗ · ô → ra ngoài = gỡ
    ui().onpointerdown = E.dragger({ src: "[data-s], [data-rm]", dst: "[data-slot]", drop: (a, b) => {
      if (a.dataset.s != null) { if (b) put(+b.dataset.slot, a.dataset.s); return; }
      const from = +a.dataset.rm; if (!b) { slot[from] = null; E.sfx("tap"); return draw(); }
      const to = +b.dataset.slot; [slot[from], slot[to]] = [slot[to], slot[from]]; E.sfx("pick"); draw();
    } });
    draw();
    E.autoRun(() => { const pool = D.spots.filter(s => cond(s.if, c.s) && !slot.includes(s.id)).map(s => s.id); for (let i = 0; i < n && pool.length; i++) if (!slot[i]) slot[i] = pool.splice(E.auto === "r" ? Math.floor(Math.random() * pool.length) : 0, 1)[0]; run(); });
  }));

  // ═════════ GALLERY — chọn 1 ảnh (trang phục, quà, phòng…) ═════════
  // { gallery: { prompt, key, want: ["casual"], opts: [{ id, pic, en, vi, tags: [...], then }], match: [bước], miss: [bước] } }
  def("gallery", c => new Promise(res => {
    const P = c.st.gallery; let cur = 0;
    E.ui.hideBox();
    if (!P.opts?.length) return unavailable(res, c, "gallery", { en: "There are no pictures to choose from here. No selection has been made.", vi: "Ở đây chưa có ảnh để chọn. Bạn chưa chọn ảnh nào." }, ["empty", "miss", "fail"]);
    const draw = () => { const o = P.opts[cur]; E.ui.panel(`<div class="se-ask">${esc(nat(P.prompt))}</div>
      <div class="sp-gal"><button data-p="-1">‹</button><div class="sp-galc"><i class="im-${esc(o.pic || "")}"></i><b>${esc(nat(o))}</b>${o.desc ? `<small>${esc(nat(o.desc))}</small>` : ""}<em>${cur + 1}/${P.opts.length}</em></div><button data-p="1">›</button></div>
      <button class="se-btn pri wide" data-ok>${esc(nat({ en: "Choose this", vi: "Chọn cái này" }))}</button>`, "gallery"); };
    const go = () => {
      const o = P.opts[cur], hit = (P.want || []).filter(t => o.tags?.includes(t)).length;
      E.flag(P.key || "gallery", o.id); E.apply(o); if (P.score) E.add(P.score, hit);
      E.ui.clear();
      const k = P.want ? (hit ? "match" : "miss") : null;
      if (k && P[k]) c.push("gallery", k);
      if (o.then) c.push("gallery", "opts", cur, "then");
      res();
    };
    ui().onclick = e => { const p = e.target.closest("[data-p]"); if (p) { cur = (cur + +p.dataset.p + P.opts.length) % P.opts.length; E.sfx("page"); return draw(); } if (e.target.closest("[data-ok]")) go(); };
    draw();
    E.autoRun(() => { cur = E.auto === "r" ? Math.floor(Math.random() * P.opts.length) : 0; go(); });
  }));

  // ═════════ CHECK — tung xúc xắc theo chỉ số ═════════
  // { check: { stat: "courage", dc: 8, die: 6 | 20, label, ok, fail, bonus: { <đồ>: 2 } } }
  def("check", c => new Promise(res => {
    const K = c.st.check, R = E.R(), die = K.die || 6;
    const statV = +R.f[K.stat] || 0, bonus = Object.entries(K.bonus || {}).reduce((a, [it, n]) => a + (R.items.includes(it) || R.f[it] ? n : 0), 0);
    const roll = 1 + Math.floor(seedRnd(c.key() + ":" + (R.f.__checks = (R.f.__checks || 0) + 1))() * die);
    const total = roll + statV + bonus, ok = total >= K.dc;
    E.ui.hideBox();
    E.ui.panel(`<div class="sp-dice"><div class="se-ask">${esc(nat(K.label || { en: "Skill check", vi: "Thử thách" }))}</div><div class="sp-die" data-d>?</div>
      <p class="sp-dsum">${esc(nat({ en: "Dice", vi: "Xúc xắc" }))} <b data-r>?</b> + ${esc(K.statLabel ? nat(K.statLabel) : statName(K.stat))} ${statV}${bonus ? ` + ${esc(nat({ en: "items", vi: "đồ" }))} ${bonus}` : ""} = <b data-t>?</b></p><div class="sp-need"><i><em data-bar style="width:0"></em><u style="left:${Math.min(100, K.dc / (die + statV + bonus) * 100)}%"></u></i></div><p class="se-mute">${esc(nat({ en: `You need ${K.dc} or more.`, vi: `Cần đạt ${K.dc} trở lên.` }))}</p><button class="se-btn pri wide" data-roll="1">${esc(nat({ en: "Roll", vi: "Tung" }))}</button></div>`, "check");
    const fin = async () => { E.flag(K.key || "check_" + K.stat, ok ? 1 : 0); await verdict(ok); done(res, c, ok ? K.ok : K.fail, "check", ok ? "ok" : "fail"); };
    const doRoll = () => {
      const d = document.querySelector("[data-d]"); let k = 0; d.classList.add("roll");
      // xúc xắc chậm dần rồi mới dừng cho hồi hộp
      const step = () => {
        if (++k > 12) {
          d.classList.remove("roll"); d.textContent = roll; d.classList.add("land"); E.sfx("tap");
          document.querySelector("[data-r]").textContent = roll;
          setTimeout(() => {
            document.querySelector("[data-t]").textContent = total;
            const bar = document.querySelector("[data-bar]"); bar.style.width = Math.min(100, total / (die + statV + bonus) * 100) + "%"; bar.classList.add(ok ? "ok" : "no");
            setTimeout(() => {
              d.classList.add(ok ? "ok" : "no"); E.sfx(ok ? "solve" : "wrong"); E.haptic(ok ? "MEDIUM" : "HEAVY");
              if (ok) { burst(d, "#6fcf97", 16); if (roll === die) floatTxt(d, nat({ en: "MAX!", vi: "TỐI ĐA!" }), "#ffd166"); } else { E.ui.fx("shake"); if (total === K.dc - 1) floatTxt(d, nat({ en: "So close!", vi: "Suýt nữa!" }), "#f2b84b"); }
              const b = document.querySelector("[data-roll]"); if (!b) return; b.textContent = T("cont"); b.dataset.roll = ""; b.disabled = false; b.onclick = fin;
            }, 750);
          }, 500);
          return;
        }
        d.textContent = 1 + Math.floor(Math.random() * die); E.sfx("tap"); setTimeout(step, 50 + k * k * 3);
      };
      step();
    };
    ui().onclick = e => { const b = e.target.closest("[data-roll]"); if (b && b.dataset.roll === "1") { b.disabled = true; b.dataset.roll = "0"; doRoll(); } };
    E.autoRun(fin);
  }));

  // ═════════ SHOP — cửa hàng ═════════
  // { shop: { money: "coins", title, items: [{ id, price }], leave } } — đồ = mã trong story.items
  def("shop", c => new Promise(res => {
    const P = c.st.shop, R = E.R(), S = E.S(), cur = P.money || "coins";
    E.ui.hideBox();
    const draw = (msg = "") => E.ui.panel(`<div class="se-xg"><span>${esc(nat(P.title || { en: "Shop", vi: "Cửa hàng" }))}</span><b>${esc(statName(cur))} ${+R.f[cur] || 0}</b></div>
      <div class="sp-shop">${P.items.map(x => { const own = R.items.includes(x.id), poor = !own && (+R.f[cur] || 0) < x.price, d = S.items[x.id]?.desc; return `<button data-b="${x.id}" class="${own ? "own" : poor ? "poor" : "can"}" ${own ? "disabled" : ""}><span class="sp-sa">${E.itemArt(x.id, "md")}</span><b>${esc(nat(S.items[x.id]?.name))}</b>${d ? `<small class="sp-sd">${esc(nat(d))}</small>` : ""}<em class="sp-price">${own ? "✓ " + esc(nat({ en: "Owned", vi: "Đã có" })) : "● " + x.price}</em></button>`; }).join("")}</div>${msg}
      <button class="se-btn wide" data-x2>${esc(nat(P.leave || { en: "Leave", vi: "Rời đi" }))}</button>`, "shop");
    ui().onclick = e => {
      const b = e.target.closest("[data-b]");
      if (b) { const x = P.items.find(i => i.id === b.dataset.b); if ((+R.f[cur] || 0) < x.price) { E.sfx("wrong"); E.ui.fx("shake"); draw(`<div class="se-hint no">${esc(nat({ en: "Not enough money.", vi: "Không đủ tiền." }))}</div>`); return; } R.f[cur] -= x.price; R.items.push(x.id); E.sfx("item"); E.haptic("MEDIUM"); E.ui.dot(true); draw(); const nb = document.querySelector('[data-b="' + x.id + '"]'); burst(nb, "#ffd166", 14); floatTxt(nb, "−" + x.price, "#ffd166"); nb?.classList.add("got"); return; }
      if (e.target.closest("[data-x2]")) done(res, c);
    };
    draw();
    E.autoRun(() => { const x = P.items.find(i => (+R.f[cur] || 0) >= i.price && !R.items.includes(i.id)); if (x && E.auto === "r") { R.f[cur] -= x.price; R.items.push(x.id); } done(res, c); });
  }));

  // ═════════ SCHEDULE — lên lịch tuần ═════════
  // { schedule: { slots: [{ en, vi }…], acts: [{ id, en, vi, icon, gain: { stat: n }, cost: { coins: n } }], then } }
  const P0 = P => Array(P.slots.length).fill(null);
  def("schedule", c => new Promise(res => {
    const P = c.st.schedule;
    if (!P.slots?.length || !P.acts?.length) return unavailable(res, c, "schedule", { en: "There are no available activities or time slots for this schedule. No activities have been completed.", vi: "Lịch này chưa có hoạt động hoặc khung giờ khả dụng. Chưa có hoạt động nào được thực hiện." }, ["empty", "fail"]);
    const plan = P0(P), nF = () => plan.filter(Boolean).length, nxt = () => plan.indexOf(null);
    E.ui.hideBox();
    const tot = () => { const t = {}; for (const id of plan.filter(Boolean)) { const a = P.acts.find(x => x.id === id); for (const k in a.gain || {}) t[k] = (t[k] || 0) + a.gain[k]; for (const k in a.cost || {}) t[k] = (t[k] || 0) - a.cost[k]; } return t; };
    const draw = () => E.ui.panel(`<div class="se-ask">${esc(nat(P.prompt || { en: "Plan your week", vi: "Lên lịch cho tuần này" }))}</div>
      <div class="sp-plan">${P.slots.map((s, i) => { const a = P.acts.find(x => x.id === plan[i]); return `<button class="sp-slot${a ? " on" : ""}${!a && i === nxt() ? " next" : ""}" ${a ? `data-rm="${i}" data-slot="${i}" title="${esc(nat({ en: "Tap to remove", vi: "Chạm để gỡ" }))}"` : `data-slot="${i}"`}><em>${esc(nat(s))}</em><i>${a ? icon(a.icon, "clock") : i === nxt() ? "+" : ""}</i><span>${a ? esc(nat(a)) : ""}</span>${a ? "<u>×</u>" : ""}</button>`; }).join("")}</div>
      <p class="se-mute sp-sh">${esc(nat({ en: "Drag an activity into a slot · drag slots to swap · tap a slot to remove", vi: "Kéo hoạt động vào ô · kéo ô để đổi chỗ · chạm ô để gỡ" }))}</p>
      <div class="sp-sum">${Object.entries(tot()).map(([k, v]) => `<span class="${v < 0 ? "neg" : "pos"}">${esc(statName(k))} ${v > 0 ? "+" : ""}${v}</span>`).join("") || `<span>${esc(nat({ en: "Pick activities — see the total here", vi: "Chọn hoạt động — tổng hiện ở đây" }))}</span>`}</div>
      <div class="sp-top">${P.acts.map(a => `<button data-a2="${a.id}"><span>${icon(a.icon, "clock")}</span><b>${esc(nat(a))}</b><small>${[...Object.entries(a.gain || {}).map(([k, v]) => `${statName(k)} ${v > 0 ? "+" : ""}${v}`), ...Object.entries(a.cost || {}).map(([k, v]) => `${statName(k)} −${v}`)].join(" · ")}</small></button>`).join("")}</div>
      <div class="se-row"><button class="se-btn" data-undo ${nF() ? "" : "disabled"}>${esc(nat({ en: "Undo last", vi: "Bỏ ô cuối" }))}</button><button class="se-btn pri${nF() === P.slots.length ? "" : " dim"}" data-go ${nF() === P.slots.length ? "" : "disabled"}>${esc(nat({ en: "Start the week", vi: "Bắt đầu tuần" }))}</button></div>`, "sched");
    let ran = false;
    const run = async () => {
      if (ran) return; ran = true;
      for (const id of plan.filter(Boolean)) { const a = P.acts.find(x => x.id === id); for (const k in a.gain || {}) E.add(k, a.gain[k]); for (const k in a.cost || {}) E.add(k, -a.cost[k]); }
      E.flag(P.key || "week", plan.join(","));
      // acts[].day = cảnh truyện ĐẦY ĐỦ cho ngày đó (chạy lần lượt theo thứ tự ô, có thể chứa { event } — sự kiện ngẫu nhiên) → rồi mới tới then
      if (P.acts.some(a => a.day)) {
        if (DONE.has(res)) return; DONE.add(res); E.ui.clear();
        if (P.then) c.push("schedule", "then");
        for (let i = plan.length - 1; i >= 0; i--) { const ai = P.acts.findIndex(x => x.id === plan[i]); if (P.acts[ai]?.day) c.push("schedule", "acts", ai, "day"); }
        return res();
      }
      if (!E.auto && P.play !== false && P.acts.some(a => a.narr || a.img)) { ui().onpointerdown = null; await montage(); }
      done(res, c, P.then, "schedule", "then");
    };
    // ĐOẠN DIỄN TUẦN: lần lượt từng ô — thẻ ngày (ảnh im-<img> | icon) + lời dẫn + chỉ số cộng / trừ; chạm = sang ngày sau, tự sang sau ~3 s + độ dài lời dẫn, “Bỏ qua” = hết
    const montage = () => new Promise(r => {
      let i = 0, tm = 0, skip = false;
      const show = () => {
        clearTimeout(tm);
        if (skip || i >= plan.length) { ui().onclick = null; return r(); }
        const a = P.acts.find(x => x.id === plan[i]), d = [...Object.entries(a.gain || {}), ...Object.entries(a.cost || {}).map(([k, v]) => [k, -v])];
        E.ui.panel(`<div class="sp-week">
          <div class="sp-wk-d">${P.slots.map((s, k) => `<i class="${k < i ? "on" : k === i ? "cur" : ""}">${esc(nat(s))}</i>`).join("")}</div>
          <div class="sp-wk-c" data-next>${a.img ? `<span class="sp-wk-im im-${esc(a.img)}"></span>` : `<span class="sp-wk-ic">${icon(a.icon, "clock")}</span>`}
            <em>${esc(nat(P.slots[i]))} · ${esc(nat(a))}</em>
            ${a.narr ? `<p>${esc(tgtOr(a.narr))}</p>${subHtml(a.narr)}` : ""}
            <div class="sp-sum">${d.map(([k, v]) => `<span class="${v < 0 ? "neg" : "pos"}">${esc(statName(k))} ${v > 0 ? "+" : "−"}${Math.abs(v)}</span>`).join("")}</div></div>
          <div class="se-row"><button class="se-btn" data-skip>${esc(nat({ en: "Skip", vi: "Bỏ qua" }))}</button><button class="se-btn pri" data-next>${esc(nat(i === plan.length - 1 ? { en: "End of the week", vi: "Hết tuần" } : { en: "Next day", vi: "Ngày tiếp" }))}</button></div></div>`, "sched week");
        E.sfx("page");
        tm = setTimeout(() => { i++; show(); }, 3000 + (a.narr ? tgtOr(a.narr).length * 35 : 0));
      };
      ui().onclick = e => { if (e.target.closest("[data-skip]")) { skip = true; show(); } else if (e.target.closest("[data-next]")) { i++; E.sfx("tap"); show(); } };
      show();
    });
    const put = (i, id) => {
      plan[i] = id; E.sfx("pick"); E.haptic("LIGHT"); draw();
      const sl = document.querySelectorAll(".sp-slot")[i]; sl?.classList.add("fill"); burst(sl, "#7dd3fc", 8);
      if (nF() === P.slots.length) floatTxt(document.querySelector("[data-go]"), nat({ en: "Ready!", vi: "Sẵn sàng!" }), "#6fcf97");
    };
    // kéo thả: thẻ hoạt động → ô; ô → ô khác (đổi chỗ); thả ra ngoài ô = gỡ; chạm nhanh thì vẫn dùng như cũ
    ui().onpointerdown = e => {
      const act = e.target.closest("[data-a2]"), src = e.target.closest("[data-rm]");
      const el = act || src; if (!el || e.button > 0) return;
      const id = act ? act.dataset.a2 : plan[+src.dataset.rm], from = act ? -1 : +src.dataset.rm, x0 = e.clientX, y0 = e.clientY;
      let ghost = null, over = -1;
      const slotAt = (x, y) => { const t = document.elementFromPoint(x, y)?.closest("[data-slot]"); return t ? +t.dataset.slot : -1; };
      const mv = ev => {
        if (!ghost) {
          if (Math.hypot(ev.clientX - x0, ev.clientY - y0) < 9) return;
          ghost = el.cloneNode(true); ghost.className = "sp-ghost"; document.body.appendChild(ghost); el.classList.add("lifted");
        }
        ghost.style.left = ev.clientX + "px"; ghost.style.top = ev.clientY + "px";
        const o = slotAt(ev.clientX, ev.clientY);
        if (o !== over) { document.querySelectorAll(".sp-slot.hov").forEach(n => n.classList.remove("hov")); over = o; if (o >= 0) document.querySelectorAll(".sp-slot")[o]?.classList.add("hov"); }
      };
      const up = ev => {
        document.removeEventListener("pointermove", mv); document.removeEventListener("pointerup", up); document.removeEventListener("pointercancel", up);
        if (!ghost) return;
        ghost.remove(); el.classList.remove("lifted"); ui().dataset.dragged = "1"; setTimeout(() => ui() && delete ui().dataset.dragged, 60);
        const o = slotAt(ev.clientX, ev.clientY);
        if (from < 0) { if (o >= 0) put(o, id); else draw(); }
        else if (o >= 0 && o !== from) { const t = plan[o]; plan[o] = id; plan[from] = t || null; E.sfx("pick"); draw(); }
        else if (o < 0) { plan[from] = null; E.sfx("tap"); draw(); }
        else draw();
      };
      document.addEventListener("pointermove", mv); document.addEventListener("pointerup", up); document.addEventListener("pointercancel", up);
    };
    ui().onclick = e => {
      if (ui().dataset.dragged) return;
      const a = e.target.closest("[data-a2]"); if (a && nxt() >= 0) return put(nxt(), a.dataset.a2);
      const rm = e.target.closest("[data-rm]"); if (rm) { plan[+rm.dataset.rm] = null; E.sfx("tap"); E.haptic("LIGHT"); return draw(); }
      if (e.target.closest("[data-undo]")) { const k = plan.map((v, i) => v ? i : -1).filter(i => i >= 0).pop(); if (k >= 0) plan[k] = null; return draw(); }
      if (e.target.closest("[data-go]") && nF() === P.slots.length) run();
    };
    draw();
    E.autoRun(() => { for (let i = 0; i < plan.length; i++) if (!plan[i]) plan[i] = pickAuto(P.acts).id; run(); });
  }));

  // ═════════ GAUGE — thanh trượt chọn mức ═════════
  // { gauge: { prompt, min: 0, max: 100, step: 10, unit, key, zones: [{ to: 30, then }, { to: 70, then }, { to: 100, then }] } }
  def("gauge", c => new Promise(res => {
    const P = c.st.gauge, mn = P.min ?? 0, mx = P.max ?? 100, unit = P.unit || "", mid = Math.round((mn + mx) / 2), span = mx - mn || 1;
    // dải màu theo vùng: lạnh → nóng; khoảng nào thuộc vùng nào hiện luôn trên thanh để người chơi biết mình đang chọn gì
    const hue = i => Math.round(200 - (P.zones.length < 2 ? 0 : (i / (P.zones.length - 1)) * 200)), zi = v => { const k = P.zones.findIndex(z => v <= z.to); return k < 0 ? P.zones.length - 1 : k; };
    let from = mn; const bands = P.zones.map((z, i) => { const a = (from - mn) / span * 100, b = (Math.min(z.to, mx) - mn) / span * 100; from = z.to; return `hsl(${hue(i)} 70% 45%) ${a}% ${b}%`; }).join(",");
    E.ui.hideBox();
    E.ui.panel(`<div class="se-ask">${esc(nat(P.prompt))}</div><div class="sp-gauge"><b data-v>${mid}${esc(unit)}</b><small class="sp-gz" data-z></small>
      <div class="sp-gtrack" style="--bands:${bands}"><input type="range" min="${mn}" max="${mx}" step="${P.step || 1}" value="${mid}" data-r aria-label="${esc(nat(P.prompt))}"></div>
      <div class="sp-gl"><small>${esc(nat(P.lo || ""))}</small><small>${esc(nat(P.hi || ""))}</small></div></div><button class="se-btn pri wide" data-ok>${T("cont")}</button>`, "gauge");
    const r = document.querySelector("[data-r]"), vEl = document.querySelector("[data-v]"), zEl = document.querySelector("[data-z]");
    let last = -1;
    const upd = () => {
      const v = +r.value, k = zi(v), z = P.zones[k];
      vEl.textContent = v + unit; vEl.style.color = `hsl(${hue(k)} 80% 62%)`;
      if (zEl) zEl.textContent = z && z.label ? nat(z.label) : "";
      if (k !== last) { if (last >= 0) { E.sfx("tap"); E.haptic("LIGHT"); vEl.classList.remove("pop"); void vEl.offsetWidth; vEl.classList.add("pop"); } last = k; }
    };
    r.oninput = upd; upd();
    const go = v => { E.flag(P.key || "gauge", v); const k = zi(v); E.apply(P.zones[k]); done(res, c, P.zones[k]?.then, "gauge", "zones", k, "then"); };
    // moving: kim chạy qua lại, bấm DỪNG đúng lúc — càng nhanh càng khó
    let sweep = 0, locked = false;
    const okBtn = document.querySelector("[data-ok]");
    if (P.moving) {
      r.disabled = true; r.classList.add("auto"); okBtn.textContent = nat({ en: "STOP!", vi: "DỪNG!" });
      const sp = P.speed || 1.1, t1 = performance.now(), step = P.step || 1;
      const tick = () => { if (locked) return; const ph = ((performance.now() - t1) / 1000 * sp) % 2, x = ph < 1 ? ph : 2 - ph; r.value = Math.round((mn + x * span) / step) * step; upd(); sweep = requestAnimationFrame(tick); };
      tick();
    }
    ui().onclick = e => {
      if (!e.target.closest("[data-ok]") || locked) return;
      locked = true; cancelAnimationFrame(sweep); E.sfx("solve"); E.haptic("MEDIUM");
      if (P.moving) { vEl.classList.add("pop"); burst(vEl, "#ffd166", 12); setTimeout(() => go(+r.value), 650); } else go(+r.value);
    };
    E.autoRun(() => { locked = true; cancelAnimationFrame(sweep); go(E.auto === "r" ? mn + Math.floor(Math.random() * (mx - mn)) : +r.value)});
  }));

  // ═════════ SPIN — vòng quay may mắn ═════════
  // { spin: { prompt, key, opts: [{ en, vi, w: 1, then }] } } — kết quả định trước theo khoá bước (tải lại không đổi kết quả)
  def("spin", c => new Promise(res => {
    const P = c.st.spin;
    if (!P.opts?.length) return unavailable(res, c, "spin", { en: "This wheel has no available results. No spin or reward has been recorded.", vi: "Vòng quay này chưa có kết quả khả dụng. Chưa ghi nhận lượt quay hay phần thưởng nào." }, ["empty", "fail"]);
    const tot = P.opts.reduce((a, o) => a + (o.w || 1), 0);
    let r = seedRnd(c.key() + (E.R().f.__spins = (E.R().f.__spins || 0) + 1))() * tot, k = 0;
    while (r > (P.opts[k].w || 1)) { r -= P.opts[k].w || 1; k++; }
    E.ui.hideBox();
    const seg = 360 / P.opts.length;
    E.ui.panel(`<div class="se-ask">${esc(nat(P.prompt || { en: "Spin!", vi: "Quay!" }))}</div><div class="sp-wheel"><div class="sp-wh" data-w style="background:conic-gradient(${P.opts.map((o, i) => `${WHEEL[i % WHEEL.length]} ${i * seg}deg ${(i + 1) * seg}deg`).join(",")})">${P.opts.map((o, i) => `<span style="--r:${i * seg + seg / 2}deg">${i + 1}</span>`).join("")}</div><i class="sp-pin"></i></div><div class="sp-leg">${P.opts.map((o, i) => `<span><i style="background:${WHEEL[i % WHEEL.length]}">${i + 1}</i>${esc(nat(o))}</span>`).join("")}</div><button class="se-btn pri wide" data-go>${esc(nat({ en: "Spin", vi: "Quay" }))}</button>`, "spin");
    const fin = () => { E.flag(P.key || "spin", k); E.apply(P.opts[k]); done(res, c, P.opts[k].then, "spin", "opts", k, "then"); };
    ui().onclick = e => { const b = e.target.closest("[data-go]"); if (!b || b.dataset.done) return; b.dataset.done = 1; const w = document.querySelector("[data-w]"); w.style.transform = `rotate(${360 * 5 - (k * seg + seg / 2)}deg)`; E.sfx("whoosh"); setTimeout(() => { E.sfx("solve"); E.haptic("HEAVY"); burst(document.querySelector(".sp-wheel"), "#ffd166", 20); b.textContent = T("cont"); b.onclick = fin; }, 3200); };
    E.autoRun(fin);
  }));

  // ═════════ FILL — điền từ vào chỗ trống ═════════
  // { fill: { prompt, t: "I ___ him yesterday.", opts: ["saw", "see", "seen"], a: 0, why: { en, vi }, ok, fail } } — nhiều chỗ trống: t có nhiều ___, opts = [[…],[…]], a = [i, j]
  def("fill", c => new Promise(res => {
    const F = c.st.fill, multi = Array.isArray(F.opts[0]), opts = multi ? F.opts : [F.opts], ans = multi ? F.a : [F.a];
    const pick = opts.map(() => -1); let blank = 0, tries = 0, busy = false;
    c.onCancel?.(() => { busy = true; DONE.add(res); res(); });
    E.ui.hideBox();
    const draw = (msg = "") => {
      let k = 0;
      const sent = esc(tgtOr(F.t)).replace(/_{3,}/g, () => { const i = k++; return `<button class="sp-bl${blank === i ? " on" : ""}${pick[i] >= 0 ? " set" : ""}" data-b="${i}">${pick[i] >= 0 ? esc(opts[i][pick[i]]) : "____"}</button>`; });
      E.ui.panel(`<div class="se-ask">${esc(nat(F.prompt || { en: "Fill in the blank", vi: "Điền vào chỗ trống" }))}</div><p class="sp-fill">${sent}</p>${subHtml(F.t)}
        <div class="sp-wb">${opts[blank].map((w, i) => `<button data-o="${i}">${esc(w)}</button>`).join("")}</div>${msg}
        <button class="se-btn pri wide${pick.every(p => p >= 0) ? "" : " dim"}" data-ok ${pick.every(p => p >= 0) ? "" : "disabled"}>${esc(nat({ en: "Check", vi: "Kiểm tra" }))}</button>`, "fill");
    };
    const check = async () => {
      if (busy || DONE.has(res) || !live(c)) return; busy = true;
      tries++;
      const ok = pick.every((p, i) => p === ans[i]);
      E.add("fillN", 1); if (ok) E.add("fillOk", 1);
      E.flash(document.querySelector(".sp-fill"), ok); if (!E.auto) await new Promise(r => setTimeout(r, 450));
      if (!live(c) || DONE.has(res)) return;
      if (ok || tries >= (F.tries || 2)) {
        if (ok) { E.sfx("solve"); E.ui.fx("solve"); E.haptic("MEDIUM"); burst(document.querySelector(".sp-fill"), "#6fcf97", 16); } else E.sfx("wrong");
        await verdict(ok, nat(ok ? { en: "Correct!", vi: "Chính xác!" } : { en: "Wrong", vi: "Sai rồi" }));
        if (!live(c) || DONE.has(res)) return;
        if (!E.auto && (ok ? F.why : F.reveal !== false)) await E.feedback(`<div class="se-fb a${ok ? 2 : 0}"><b>${ok ? "✓" : "✗"} ${esc(tgtOr(F.t).replace(/_{3,}/g, (() => { let k = 0; return () => opts[k][ans[k++]]; })()))}</b>${F.why ? `<p>${esc(nat(F.why))}</p>` : ""}</div>`);
        return done(res, c, ok ? F.ok : F.fail, "fill", ok ? "ok" : "fail");
      }
      busy = false; E.sfx("wrong"); E.ui.fx("shake"); draw(`<div class="se-hint no">${esc(nat({ en: "Not quite — try again.", vi: "Chưa đúng — thử lại." }))}</div>`);
    };
    ui().onclick = e => {
      if (busy || DONE.has(res) || !live(c)) return;
      const b = e.target.closest("[data-b]"); if (b) { blank = +b.dataset.b; return draw(); }
      const o = e.target.closest("[data-o]"); if (o) { pick[blank] = +o.dataset.o; E.sfx("tap"); const nx = pick.findIndex(p => p < 0); if (nx >= 0) blank = nx; return draw(); }
      if (e.target.closest("[data-ok]") && pick.every(p => p >= 0)) check();
    };
    draw();
    E.autoRun(() => { ans.forEach((a, i) => (pick[i] = E.auto === "r" && Math.random() < 0.3 ? (a + 1) % opts[i].length : a)); tries = 9; check(); });
  }));

  // ═════════ MEMORY — lật thẻ ghép cặp ═════════
  // { memory: { prompt, pairs: [["harbour", "bến cảng"], …], moves: 0 (không giới hạn), ok, fail } }
  def("memory", c => new Promise(res => {
    const M = c.st.memory, rnd = seedRnd(c.key());
    const cards = M.pairs.flatMap((p, i) => [{ i, t: tgtOr(p[0]) }, { i, t: typeof p[1] === "string" ? p[1] : nat(p[1]) }]).map(x => [x, rnd()]).sort((a, b) => a[1] - b[1]).map(x => x[0]);
    // over = bước đã xong: hẹn giờ lật úp thẻ (650 ms) không được vẽ lại bảng đè lên bước sau
    const open = [], got = new Set(); let moves = 0, lock = false, over = false, fresh = -1, combo = 0, best = 0, score = 0; const t0 = Date.now(); let tick = null;
    c.onCancel?.(() => { over = true; clearInterval(tick); DONE.add(res); res(); });
    const clock = () => { const s = Math.floor((Date.now() - t0) / 1000); return Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0"); };
    E.ui.hideBox();
    const draw = () => over || !live(c) || E.ui.panel(`<div class="se-ask">${esc(nat(M.prompt || { en: "Match the pairs", vi: "Ghép các cặp" }))} <small class="se-mute">${moves}${M.moves ? "/" + M.moves : ""}</small></div>
      <div class="sp-stats"><span>${E.ICON.clock}<b data-clk>${clock()}</b></span><span class="${combo > 1 ? "hot" : ""}">×${combo}</span><span>★ ${score}</span></div>
      <div class="sp-mem">${cards.map((x, k) => `<button data-k="${k}" class="${got.has(x.i) ? "got" : open.includes(k) ? "open" : ""}${fresh === k ? " flip" : ""}" aria-label="${got.has(x.i) || open.includes(k) ? esc(x.t) : "?"}"><span>${got.has(x.i) || open.includes(k) ? esc(x.t) : "✦"}</span></button>`).join("")}</div>`, "memory");
    const fin = async ok => { if (over || !live(c)) return; over = true; clearInterval(tick); E.add("memScore", score); await verdict(ok, nat(ok ? { en: "All matched!", vi: "Ghép đủ rồi!" } : { en: "Out of moves", vi: "Hết lượt" })); done(res, c, ok ? M.ok : M.fail, "memory", ok ? "ok" : "fail"); };
    if (!E.auto) tick = setInterval(() => { const e = document.querySelector("[data-clk]"); if (e) e.textContent = clock(); else if (over) clearInterval(tick); }, 500);
    ui().onclick = e => {
      const b = e.target.closest("[data-k]"); if (!b || lock || over || !live(c)) return; const k = +b.dataset.k;
      if (open.includes(k) || got.has(cards[k].i)) return;
      open.push(k); fresh = k; E.sfx("page"); draw(); fresh = -1;
      if (open.length === 2) {
        moves++; lock = true;
        setTimeout(() => {
          if (over || !live(c)) return;
          const hit = cards[open[0]].i === cards[open[1]].i, bs = document.querySelectorAll(".sp-mem button");
          if (hit) { got.add(cards[open[0]].i); combo++; best = Math.max(best, combo); const gain = 10 * combo; score += gain; E.sfx("solve"); E.haptic("MEDIUM"); burst(bs[open[1]], "#6fcf97"); burst(bs[open[0]], "#6fcf97", 8); floatTxt(bs[open[1]], "+" + gain + (combo > 1 ? " ×" + combo : "")); }
          else { combo = 0; E.sfx("wrong"); }
          open.length = 0; lock = false; draw();
          if (got.size === M.pairs.length) return setTimeout(() => fin(true), 400);
          if (M.moves && moves >= M.moves) fin(false);
        }, 650);
      }
    };
    draw();
    E.autoRun(() => fin(true));
  }));

  // ═════════ REWIND — vòng lặp thời gian / trùng sinh ═════════
  // { rewind: { to: "morning", keep: ["knows_code", "agnes"], keepItems: ["key"], title: { en: "LOOP {n}", vi: "VÒNG {n}" }, max: 7, over: [bước khi hết vòng] } }
  // Xoá cờ / đồ / người đã gặp của vòng này (TRỪ keep / keepItems / mọi cờ bắt đầu bằng “k_” = kiến thức), tăng biến “loop”, hiện thẻ vòng mới,
  //   rồi nhảy về node `to`. Sự thật (truths) vốn giữ qua mọi lần chơi. Đồ “k_…” cũng được giữ.
  def("rewind", c => new Promise(res => {
    const W = c.st.rewind, R = E.R();
    const n = (+R.f.loop || 1) + 1;
    if (W.max && n > W.max) { if (W.over) c.push("rewind", "over"); return res(); }
    const keep = new Set(W.keep || []);
    const f = {};
    for (const k in R.f) if (keep.has(k) || k.startsWith("k_") || k.startsWith("__") || ["acc", "accN"].includes(k)) f[k] = R.f[k];
    f.loop = n;
    R.f = f;
    R.items = R.items.filter(id => (W.keepItems || []).includes(id) || id.startsWith("k_"));
    R.met = {}; R.cast = {}; R.used = {}; R.mood = null; R.cam = null; R.pic = null;
    if (R.meters) R.meters = {};
    E.ui.hide("*"); E.ui.clear(); E.ui.hud?.();
    E.effect.run("glitch"); E.sfx("whoosh");
    const t = W.title || { en: "LOOP {n}", vi: "VÒNG {n}" };
    E.ui.card(`<div class="se-ct time sp-loop"><small>${esc(nat({ en: "Again.", vi: "Lại nữa." }))}</small><b>${esc(nat(t).replace("{n}", n))}</b></div>`, 2600, "time").then(() => { if (live(c)) E.jump(W.to); res(); });
  }));

  // ═════════ CLOCK — giờ trong truyện (góc trên, cạnh thanh chỉ số) ═════════
  // { clock: "08:10" } · { clock: "21:00", warn: true } (đỏ, nhấp nháy) · { clock: null } (ẩn)
  def("clock", async ({ st }) => {
    const R = E.R(); R.clock = st.clock ? { t: st.clock, warn: !!st.warn } : null;
    let el = document.querySelector(".sp-clock");
    if (!el) { el = h(`<div class="sp-clock"></div>`); document.querySelector(".se")?.appendChild(el); }
    el.hidden = !R.clock; if (!R.clock) return;
    el.textContent = R.clock.t; el.classList.toggle("warn", R.clock.warn);
    el.classList.remove("tick"); void el.offsetWidth; el.classList.add("tick");
    E.sfx("clock");
  });
  const restore1 = E.ui.restore; E.ui.restore = () => { restore1(); const R = E.R(), el = document.querySelector(".sp-clock"); if (R?.clock) E.mech.clock({ st: { clock: R.clock.t, warn: R.clock.warn } }); else if (el) el.hidden = true; };

  // ═════════ Sổ tay: tab GHI CHÚ (note) — thêm vào Sổ tay khi có ghi chép ═════════
  E.on("boot", () => {
    const book0 = E.ui.book;
    E.ui.book = (tab) => {
      book0(tab);
      const R = E.R(); if (!R.jot?.length) return;
      const tabs = document.querySelector(".se-sheet .se-tabs"); if (!tabs || tabs.querySelector("[data-jot]")) return;
      const b = h(`<button class="se-tab" data-jot>${esc(nat({ en: "Notes", vi: "Ghi chú" }))}</button>`); tabs.appendChild(b);
      b.onclick = e => { e.stopPropagation(); tabs.querySelectorAll(".se-tab").forEach(x => x.classList.toggle("on", x === b)); document.querySelector(".se-bookb").innerHTML = R.jot.slice().reverse().map(j => `<div class="se-wd"><b>${j.ch ? esc(nat({ en: "Ch. " + j.ch, vi: "Ch. " + j.ch })) : "•"}</b><span>${esc(nat(j.t))}</span></div>`).join(""); E.sfx("tap"); };
    };
  });
})();
// Enmi Story Engine — CƠ CHẾ THEO THỂ LOẠI (nạp sau mech-plus.js). Truyện không dùng = không ảnh hưởng.
// Đặc tả + ví dụ: docs/story-engine/MECHANICS.md (mục “Genre mechanics”). Mỗi cơ chế có E.autoRun cho autoplay.js / cover.js.
//
//   theory   TRINH THÁM — dựng lại vụ án kiểu Golden Idol: điền từ (người / giờ / đồ vật / động cơ) vào các câu kết luận;
//            sai thì chỉ biết SỐ chỗ sai (khi ≤ near), không biết chỗ nào → phải suy luận, không đoán mò được
//   vibe     HẸN HÒ — cuộc trò chuyện nhiều lượt có nhịp: người kia nói, mình trả lời trong thời gian giới hạn (im lặng = ngượng),
//            thanh “cảm xúc” chạy theo từng câu, mặt nhân vật đổi theo, nói hợp liên tiếp = “ăn ý”; kết quả theo tổng điểm
//   serve    ĐỜI THƯỜNG — đứng quầy (quán cà phê, chợ, tiệm hoa…): khách gọi món bằng tiếng đang học (đọc hoặc chỉ NGHE),
//            chọn đúng món lên khay trước khi khách hết kiên nhẫn → tiền boa; sai thì thấy khách thật sự gọi gì (học từ)
(() => {
  const E = globalThis.StoryEngine, def = E.def, esc = E.esc;
  const nat = t => E.nat(t), tgt = o => E.tgt(o), sub = o => E.sub(o);
  const ui = () => document.querySelector(".se-ui");
  const pickAuto = arr => arr[E.auto === "r" ? Math.floor(Math.random() * arr.length) : 0];
  const cond = (c, s) => (c == null ? true : typeof c === "function" ? !!c(s) : typeof c === "string" ? s.truth(c) || s.has(c) || !!s.f[c] : typeof c === "object" && !Array.isArray(c) ? Object.entries(c).every(([k, v]) => (+s.f[k] || 0) >= v) : !!c);
  const subHtml = o => { const s = sub(o); return s ? `<small class="sp-sub"${E.G().set.tr ? "" : " hidden"}>${esc(s)}</small>` : ""; };
  const cname = id => (id === "me" ? E.G().set.name : E.cname(E.S().chars[id] || {}, true));
  const color = id => (id === "me" ? "var(--se-me)" : E.S().chars[id]?.color || "#aaa");
  // chân dung nhỏ có biểu cảm: ảnh im-<mã>-<mặt> đè lên im-<mã> (thiếu ảnh biểu cảm thì vẫn thấy mặt gốc)
  const face = (id, f) => `<span class="sp-av lf-av" style="--c:${color(id)}"><i class="im-${esc(id)}"></i>${f ? `<i class="im-${esc(id)}-${esc(f)}"></i>` : ""}<b>${esc((cname(id) || "?").charAt(0))}</b></span>`;
  const burst = (...a) => E.fxBurst?.(...a), floatTxt = (...a) => E.fxFloat?.(...a), verdict = (...a) => E.verdict?.(...a) || Promise.resolve();
  const wait = ms => new Promise(r => setTimeout(r, E.auto ? 0 : ms));
  // xong bước đúng 1 lần (hẹn giờ muộn / bấm đúp không được xoá bảng của bước SAU)
  const DONE = new WeakSet(), FINISHING = new WeakSet();
  const live = c => c?.live?.() !== false;
  const done = (res, c, key, ...path) => { if (DONE.has(res)) return; DONE.add(res); if (live(c)) { E.ui.clear(); if (key) c.push(...path); } res(); };
  // đổi mặt nhân vật đang đứng trên sân khấu (nếu có) — để cảm xúc thấy cả ở cảnh chứ không chỉ trong bảng
  // tên chỉ số cho người chơi (giống mech-plus): story.stats.<mã> → nhãn thanh chỉ số → mã viết hoa chữ đầu
  const statName = k => nat(E.S().stats?.[k] || E.R().meters?.[k]?.label || { en: k.charAt(0).toUpperCase() + k.slice(1) });
  const stageFace = (id, f) => { const R = E.R(); if (f != null && R.cast?.[id]) E.ui.show(id, R.cast[id].at, f); };

  // ═════════ THEORY — dựng lại vụ án (điền từ vào kết luận) ═════════
  // { theory: { title, lines: [{ en: "[who] met Tom at [when].", vi: "[who] gặp Tom lúc [when]." }],
  //     answer: { who: "owen", when: "t947" }, words: [{ id, en, vi, kind: "who" | "when" | …, if }],
  //     kinds: { who: { en: "Person", vi: "Người" } }, near: 2, tries: 0, giveUp: true, key, ok, fail } }
  // Chỗ trống [mã] trong câu; từ cùng `kind` với đáp án của chỗ trống thì mới thả vào được (thiếu kind = mọi từ).
  const BL = /\[(\w+)\](?!\])/g;
  def("theory", c => new Promise(res => {
    const T = c.st.theory, ans = T.answer || {}, near = T.near ?? 2;
    const words = (T.words || []).filter(w => cond(w.if, c.s)), W = id => (T.words || []).find(w => w.id === id);
    const slots = [...new Set(T.lines.flatMap(l => [...String(l.en || "").matchAll(BL)].map(m => m[1])))];
    const kindOf = b => W(ans[b])?.kind;
    const pick = {}; let act = slots[0], tries = 0, msg = "", over = false;
    E.ui.hideBox();
    const fillLine = (s, lang) => String(s || "").replace(BL, (m, b) => { const w = W(pick[b]); return w ? (lang === "n" ? nat(w) : tgt(w)) : "____"; });
    const chip = b => { const w = W(pick[b]); return `<button class="lf-bl${w ? " on" : ""}${act === b ? " act" : ""}" data-b="${esc(b)}">${w ? esc(tgt(w)) : esc(nat(T.kinds?.[kindOf(b)] || { en: "?", vi: "?" }))}</button>`; };
    const line = l => `<p class="lf-tl">${tgt(l).split(BL).map((x, i) => (i % 2 ? chip(x) : esc(x))).join("")}</p>${sub(l) ? `<small class="sp-sub"${E.G().set.tr ? "" : " hidden"}>${esc(fillLine(nat(l), "n"))}</small>` : ""}`;
    const full = () => slots.every(b => pick[b]);
    const draw = () => {
      const kinds = [...new Set(words.map(w => w.kind || ""))];
      const ak = act ? kindOf(act) : null;
      E.ui.panel(`<div class="lf-th"><div class="se-ddh">${E.ICON.bulb}<small>${esc(nat(T.title || { en: "What really happened?", vi: "Chuyện thật sự là gì?" }))}</small></div>
        <div class="lf-lines">${T.lines.map(line).join("")}</div>
        <p class="se-mute lf-help">${esc(nat(act ? { en: "Tap a word below to fill the highlighted blank.", vi: "Chạm 1 từ bên dưới để điền vào ô đang sáng." } : { en: "Tap a blank to change it.", vi: "Chạm 1 ô để đổi từ." }))}</p>
        <div class="lf-bank">${kinds.map(k => `<div class="lf-grp${ak && k && k !== ak ? " off" : ""}">${k && T.kinds?.[k] ? `<em>${esc(nat(T.kinds[k]))}</em>` : ""}<div>${words.filter(w => (w.kind || "") === k).map(w => { const used = Object.values(pick).includes(w.id); return `<button class="lf-w${used ? " used" : ""}" data-w="${esc(w.id)}"${ak && k && k !== ak ? " disabled" : ""}>${esc(tgt(w))}${sub(w) ? `<small>${esc(sub(w))}</small>` : ""}</button>`; }).join("")}</div></div>`).join("")}</div>
        ${msg}<div class="se-row">${T.giveUp !== false && tries >= 2 ? `<button class="se-btn" data-give>${esc(nat({ en: "I'm not sure — move on", vi: "Chưa chắc — đi tiếp" }))}</button>` : ""}<button class="se-btn pri${full() ? "" : " dim"}" data-chk ${full() ? "" : "disabled"}>${esc(nat({ en: "That's what happened", vi: "Chuyện là như vậy" }))}</button></div></div>`, "theory");
    };
    const nextEmpty = from => slots.find((b, i) => i > slots.indexOf(from) && !pick[b]) || slots.find(b => !pick[b]) || null;
    const fin = async ok => {
      if (over || !live(c)) return; over = true;
      E.flag(T.key || "theory_" + c.key(), ok ? 1 : 0); if (ok) E.add("puzzles", 1);
      await verdict(ok, nat(ok ? { en: "Case reconstructed!", vi: "Đã dựng lại vụ án!" } : { en: "Not solved", vi: "Chưa phá được" }));
      done(res, c, ok ? T.ok : T.fail, "theory", ok ? "ok" : "fail");
    };
    // kéo từ → ô trống (chỉ ô cùng loại); kéo ô đã điền → ô khác = đổi chỗ, ra ngoài = gỡ
    const fillB = (k, id) => { for (const x in pick) if (pick[x] === id) delete pick[x]; pick[k] = id; E.sfx("pick"); E.haptic("LIGHT"); msg = ""; act = nextEmpty(k); draw(); document.querySelector(`[data-b="${k}"]`)?.classList.add("pop"); };
    ui().onpointerdown = E.dragger?.({ src: "[data-w], .lf-bl.on", dst: "[data-b]", drop: (a, d) => {
      if (over || !live(c)) return;
      if (a.dataset.w) { if (!d) return; const k = d.dataset.b, w = W(a.dataset.w); if (kindOf(k) && w?.kind && w.kind !== kindOf(k)) { E.sfx("wrong"); d.classList.add("bad"); return; } return fillB(k, a.dataset.w); }
      const from = a.dataset.b; if (!d) { delete pick[from]; act = from; E.sfx("tap"); return draw(); }
      const to = d.dataset.b; if (kindOf(to) !== kindOf(from)) { E.sfx("wrong"); return; } [pick[from], pick[to]] = [pick[to], pick[from]]; if (!pick[from]) delete pick[from]; E.sfx("pick"); draw();
    } });
    ui().onclick = e => {
      if (over || !live(c)) return;
      if (E.dragged?.()) return;
      const b = e.target.closest("[data-b]");
      if (b) { const k = b.dataset.b; if (act === k && pick[k]) delete pick[k]; act = k; E.sfx("tap"); msg = ""; return draw(); }
      const w = e.target.closest("[data-w]");
      if (w && act) {
        for (const k in pick) if (pick[k] === w.dataset.w) delete pick[k];
        pick[act] = w.dataset.w; E.sfx("pick"); E.haptic("LIGHT"); msg = "";
        const was = act; act = nextEmpty(act); draw();
        const el = document.querySelector(`[data-b="${was}"]`); el?.classList.add("pop");
        return;
      }
      if (e.target.closest("[data-give]")) return fin(false);
      if (e.target.closest("[data-chk]") && full()) {
        tries++;
        const wrong = slots.filter(k => pick[k] !== ans[k]).length;
        E.flash?.(document.querySelector(".lf-lines"), !wrong);
        if (!wrong) { E.sfx("solve"); E.ui.fx("solve"); burst(document.querySelector(".lf-lines"), "#ffd166", 22); return fin(true); }
        E.sfx("wrong"); E.ui.fx("shake"); E.haptic("HEAVY");
        if (T.tries && tries >= T.tries) return fin(false);
        // Golden Idol: chỉ nói SỐ chỗ sai khi đã gần đúng — không nói chỗ nào
        msg = `<div class="se-hint no">${esc(nat(wrong <= near ? { en: wrong === 1 ? "One detail is wrong." : `${wrong} details are wrong.`, vi: `Còn ${wrong} chi tiết sai.` } : { en: "That doesn't add up yet.", vi: "Vẫn chưa khớp." }))}${T.tries ? ` ${esc(nat({ en: `${T.tries - tries} tries left.`, vi: `Còn ${T.tries - tries} lần.` }))}` : ""}</div>`;
        draw();
      }
    };
    draw();
    E.autoRun(() => { Object.assign(pick, ans); if (E.auto === "r" && Math.random() < 0.3 && slots.length) pick[slots[0]] = null; if (!full()) return fin(false); fin(true); });
  }));

  // ═════════ VIBE — trò chuyện có nhịp (hẹn hò, làm quen, xin việc…) ═════════
  // { vibe: { with: "mia", key: "mia", ms: 9000, goal: 4, great: 7,
  //     rounds: [{ line: { en, vi }, face: "smile", opts: [{ en, vi, v: 2, face: "blush", re: { en, vi }, set, add, if }] }],
  //     silence: { v: -1, face: "sad", re: { en, vi } }, great: [bước], ok: [bước], fail: [bước] } }
  // great/ok/fail: bước theo tổng; goal = ngưỡng ok, greatAt = ngưỡng great (mặc định goal + 3). ms: 0 = không giới hạn giờ.
  def("vibe", c => new Promise(res => {
    const V = c.st.vibe, who = V.with, key = V.key || who, ms = V.ms ?? 9000;
    const rounds = V.rounds.filter(r => cond(r.if, c.s)), goal = V.goal ?? Math.ceil(rounds.length * 1.2), greatAt = V.greatAt ?? goal + 3;
    const lo = -Math.max(3, rounds.length * 2), hi = Math.max(greatAt + 1, rounds.length * 2);
    let sum = 0, streak = 0, curFace = "";
    E.ui.hideBox();
    const pct = v => Math.max(0, Math.min(100, ((v - lo) / (hi - lo)) * 100));
    const bar = () => `<div class="lf-vb"><i><em style="width:${pct(sum)}%"></em><u style="left:${pct(goal)}%"></u><u class="g" style="left:${pct(greatAt)}%"></u></i><b>${esc(nat(sum >= greatAt ? { en: "Sparks", vi: "Rung động" } : sum >= goal ? { en: "Warm", vi: "Ấm áp" } : sum >= 0 ? { en: "Polite", vi: "Lịch sự" } : { en: "Awkward", vi: "Ngượng" }))}</b></div>`;
    const head = (k) => `<div class="lf-vh">${face(who, curFace)}<div><b>${esc(cname(who))}</b><span class="sp-dots">${rounds.map((_, i) => `<i class="${i < k ? "on" : i === k ? "cur" : ""}"></i>`).join("")}</span></div>${streak >= 2 ? `<em class="lf-sync">${esc(nat({ en: "In sync", vi: "Ăn ý" }))} ×${streak}</em>` : ""}</div>`;
    const bubble = (o, me) => `<div class="lf-bub${me ? " me" : ""}"><span>${E.words(tgt(o), E.L)}</span>${subHtml(o)}</div>`;
    const draw = (k, body) => E.ui.panel(`<div class="lf-vibe">${head(k)}${bar()}${body}</div>`, "vibe");
    const round = (k) => new Promise(r => {
      const R0 = rounds[k], opts = R0.opts.map((o, i) => ({ o, i })).filter(({ o }) => cond(o.if, c.s));
      if (!live(c)) return r();
      if (R0.face != null) { curFace = R0.face; stageFace(who, R0.face); }
      draw(k, `${bubble(R0.line)}${ms ? `<div class="se-timer lf-vt"><i style="animation-duration:${ms / 1000}s"></i></div>` : ""}
        <div class="se-chs">${opts.map(({ o, i }) => `<button class="se-ch-b" data-v="${i}"><span>${esc(tgt(o))}</span>${subHtml(o)}</button>`).join("")}</div>`);
      if (R0.line && !E.auto) E.say(tgt(R0.line), who);
      let fin = false;
      const pickIt = async i => {
        if (fin || !live(c)) return; fin = true; clearTimeout(tm); E.hush();
        const o = i < 0 ? { ...(V.silence || {}), v: V.silence?.v ?? -1, re: V.silence?.re } : R0.opts[i];
        const v = +o.v || 0; sum += v; E.add(key, v); E.apply(o);
        streak = v > 0 ? streak + 1 : 0;
        if (o.face != null) { curFace = o.face; stageFace(who, o.face); }
        E.sfx(v > 0 ? "up" : v < 0 ? "down" : "tap"); E.haptic(v < 0 ? "HEAVY" : "LIGHT");
        const mine = i < 0 ? `<div class="lf-bub me sil"><span>…</span></div>` : bubble(o, true);
        draw(k + 1, `${bubble(R0.line)}${mine}${o.re ? bubble(o.re) : ""}`);
        const b = document.querySelector(".lf-vb");
        floatTxt(b, v ? "♥" + (v > 0 ? "+" : "") + v : "…", v > 0 ? "#ff7eb6" : v < 0 ? "#fca5a5" : "#c9ced9");
        if (v >= 2) burst(b, "#ff7eb6", 12);
        if (o.re && !E.auto) await E.say(tgt(o.re), who);
        await wait(o.re ? 1100 + tgt(o.re).length * 25 : 700);
        r();
      };
      const tm = ms && !E.auto ? setTimeout(() => pickIt(-1), ms) : 0;
      ui().onclick = e => { const b = e.target.closest("[data-v]"); if (b) { b.classList.add("sel"); pickIt(+b.dataset.v); } };
      c.onCancel?.(() => { fin = true; clearTimeout(tm); r(); });
      if (!opts.length) return void pickIt(-1);
      E.autoRun(() => pickIt(pickAuto(opts).i));
    });
    (async () => {
      for (let k = 0; k < rounds.length; k++) { if (!live(c)) return res(); await round(k); }
      if (!live(c)) return res();
      const tier = sum >= greatAt && V.great ? "great" : sum >= goal ? "ok" : "fail";
      E.flag((V.key || who) + "_vibe", tier);
      await verdict(tier !== "fail", nat(tier === "great" ? { en: "Sparks flew!", vi: "Có rung động!" } : tier === "ok" ? { en: "That went well", vi: "Khá suôn sẻ" } : { en: "A bit awkward…", vi: "Hơi ngượng…" }));
      // không khai great → dùng ok · không khai gì cho mức này → câu kết mặc định của người kia (diễn biến sau)
      const key2 = V[tier] ? tier : tier === "great" && V.ok ? "ok" : null;
      if (!live(c)) return res();
      if (!key2) await E.aftermath?.(who, tier === "great" ? { en: "I really enjoyed this. Text me?", vi: "Mình thích lắm. Nhắn tin cho mình nhé?" } : tier === "ok" ? { en: "Nice talking to you.", vi: "Nói chuyện vui ghê." } : { en: "Anyway… I should go.", vi: "Thôi… mình phải đi rồi." }, `${cname(who)} ♥ ${sum >= 0 ? "+" : "−"}${Math.abs(sum)}`, tier === "fail" ? "sad" : "happy");
      done(res, c, key2, "vibe", key2);
    })();
  }));

  // ═════════ SERVE — đứng quầy phục vụ (luyện nghe / đọc tên món) ═════════
  // { serve: { title, money: "coins", menu: [{ id, en, vi, pic, icon }], listen: false, ms: 20000, need,
  //     orders: [{ who, line: { en, vi }, want: ["latte", "croissant"], tip: 2, re: { en, vi }, if }], ok, fail, key } }
  // listen: true = khách chỉ NÓI (bấm loa nghe lại), chữ ẩn tới khi bấm “Xem chữ” (mất boa). ms = kiên nhẫn mỗi khách (0 = vô hạn).
  def("serve", c => new Promise(res => {
    const P = c.st.serve, menu = P.menu, M = id => menu.find(m => m.id === id), cur = P.money || "coins";
    const R0 = E.R(), seen = (R0.ev ||= { n: {}, last: {}, t: 0, seed: (Date.now() % 1e9) | 0 }).n;
    let orders = P.orders.filter(o => cond(o.if, c.s) && !(o.once && seen["cust_" + (o.id || o.who)]));
    if (P.pick && orders.length > P.pick) { const r = seed(R0.ev.seed + c.key()); orders = orders.map(o => [o, r() / (o.w ?? 1)]).sort((x, y) => x[1] - y[1]).slice(0, P.pick).map(x => x[0]); }
    for (const o of orders) if (o.once) seen["cust_" + (o.id || o.who)] = 1;
    const need = P.need ?? Math.ceil(orders.length * 0.6), ms = P.ms ?? 20000;
    let k = 0, tray = [], served = 0, earned = 0, shown = !P.listen, t0 = 0, tm = 0, iv = 0, busy = false;
    c.onCancel?.(() => { busy = true; clearTimeout(tm); clearInterval(iv); DONE.add(res); res(); });
    E.ui.hideBox();
    const same = (a, b) => a.length === b.length && [...a].sort().join("|") === [...b].sort().join("|");
    const tile = m => m.pic ? `<i class="im-${esc(m.pic)}"></i>` : E.S().items?.[m.id] ? E.itemArt(m.id, "sm") : `<span class="lf-mi">${E.ICON[m.icon] || esc(tgt(m).charAt(0).toUpperCase())}</span>`;
    const draw = (msg = "") => {
      const O = orders[k];
      E.ui.panel(`<div class="lf-sv"><div class="se-xg"><span>${esc(nat(P.title || { en: "Behind the counter", vi: "Sau quầy" }))} · ${k + 1}/${orders.length}</span><b>${esc(statName(cur))} +${earned}</b></div>
        <div class="lf-cust">${face(O.who)}<div class="lf-bub"><span>${shown ? E.words(tgt(O.line), E.L) : `<i class="lf-wave"><b></b><b></b><b></b><b></b><b></b></i>`}</span>${shown ? subHtml(O.line) : ""}</div>
          <div class="lf-ctl"><button class="se-ib sm" data-hear aria-label="${esc(nat({ en: "Listen again", vi: "Nghe lại" }))}">${E.ICON.spk}</button>${shown ? "" : `<button class="se-btn sm" data-show>${esc(nat({ en: "Show text", vi: "Xem chữ" }))}</button>`}</div></div>
        ${ms ? `<div class="lf-pat"><i><em data-pat></em></i></div>` : ""}
        <div class="lf-tray">${tray.length ? tray.map((id, i) => `<button data-rm="${i}">${tile(M(id))}<b>${esc(tgt(M(id)))}</b><u>×</u></button>`).join("") : `<small class="se-mute">${esc(nat({ en: "Tray is empty — tap the menu to add", vi: "Khay trống — chạm thực đơn để thêm" }))}</small>`}</div>
        <div class="lf-menu">${menu.map(m => `<button data-mi="${esc(m.id)}">${tile(m)}<b>${esc(tgt(m))}</b>${sub(m) ? `<small>${esc(sub(m))}</small>` : ""}</button>`).join("")}</div>
        ${msg}<button class="se-btn pri wide${tray.length ? "" : " dim"}" data-serve ${tray.length ? "" : "disabled"}>${esc(nat({ en: "Serve", vi: "Phục vụ" }))}</button></div>`, "serve");
      tickPat();
    };
    const tickPat = () => { const e = document.querySelector("[data-pat]"); if (!e || !ms) return; const left = Math.max(0, 1 - (performance.now() - t0) / ms); e.style.width = left * 100 + "%"; e.classList.toggle("low", left < .3); };
    const hear = () => { const O = orders[k]; E.say(tgt(O.line), O.who, { force: true }); };
    const start = () => {
      tray = []; shown = !P.listen; busy = false; t0 = performance.now(); draw();
      if (!E.auto) { if (P.listen || E.G().set.vDlg) hear(); E.sfx("open"); }
      clearTimeout(tm); clearInterval(iv);
      if (ms && !E.auto) { tm = setTimeout(() => judge(true), ms); iv = setInterval(tickPat, 250); }
    };
    const judge = async (timeout) => {
      if (busy || !live(c) || DONE.has(res)) return; busy = true; clearTimeout(tm); clearInterval(iv); E.hush();
      const O = orders[k], ok = !timeout && same(tray, O.want);
      if (ok) {
        served++; const tip = (O.tip ?? 1) * (shown && P.listen ? 0 : 1); earned += tip; if (tip) E.add(cur, tip);
        E.sfx("solve"); E.haptic("MEDIUM"); burst(document.querySelector(".lf-tray"), "#ffd166", 14);
        floatTxt(document.querySelector(".lf-cust"), tip ? "+" + tip : nat({ en: "Thanks!", vi: "Cảm ơn!" }), "#ffd166");
        if (O.re && !E.auto) E.say(tgt(O.re), O.who);
        draw(`<div class="se-hint">${O.re ? esc(tgt(O.re)) : esc(nat({ en: "Perfect, thanks!", vi: "Chuẩn rồi, cảm ơn!" }))}</div>`);
      } else {
        E.sfx("wrong"); E.haptic("HEAVY"); E.ui.fx("shake"); shown = true;
        // học từ: hiện đúng món khách gọi
        draw(`<div class="se-hint no">${esc(nat(timeout ? { en: "The customer gave up and left.", vi: "Khách chờ lâu quá nên bỏ đi." } : { en: "That's not what they ordered.", vi: "Không đúng món khách gọi." }))}<br><b>${esc(nat({ en: "They wanted:", vi: "Khách gọi:" }))}</b> ${O.want.map(id => esc(tgt(M(id)))).join(" · ")}</div>`);
      }
      await wait(ok ? 1300 : 2600);
      if (!live(c)) return res();
      k++;
      if (k < orders.length) return start();
      const win = served >= need;
      E.flag(P.key || "serve_" + c.key(), served);
      await verdict(win, nat(win ? { en: `${served}/${orders.length} served`, vi: `Phục vụ ${served}/${orders.length}` } : { en: "Rough shift…", vi: "Ca làm vất vả…" }));
      done(res, c, win ? P.ok : P.fail, "serve", win ? "ok" : "fail");
    };
    // kéo món lên khay · kéo món trên khay ra ngoài = bỏ
    ui().onpointerdown = E.dragger?.({ src: "[data-mi], [data-rm]", dst: ".lf-tray", drop: (a, d) => {
      if (busy) return;
      if (a.dataset.mi) { if (d) { tray.push(a.dataset.mi); E.sfx("pick"); E.haptic("LIGHT"); draw(); const t = document.querySelectorAll(".lf-tray button"); t[t.length - 1]?.classList.add("pop"); } return; }
      if (!d) { tray.splice(+a.dataset.rm, 1); E.sfx("tap"); draw(); }
    } });
    ui().onclick = e => {
      if (busy || E.dragged?.()) return;
      const m = e.target.closest("[data-mi]"); if (m) { tray.push(m.dataset.mi); E.sfx("pick"); E.haptic("LIGHT"); draw(); const t = document.querySelectorAll(".lf-tray button"); t[t.length - 1]?.classList.add("pop"); return; }
      const r = e.target.closest("[data-rm]"); if (r) { tray.splice(+r.dataset.rm, 1); E.sfx("tap"); return draw(); }
      if (e.target.closest("[data-hear]")) return hear();
      if (e.target.closest("[data-show]")) { shown = true; E.sfx("page"); return draw(); }
      if (e.target.closest("[data-serve]") && tray.length) judge(false);
    };
    if (!orders.length) return done(res, c, P.fail, "serve", "fail");
    start();
    // tự chơi / lời giải của cover.js: phục vụ lần lượt từng khách (đang chấm thì chờ)
    E.autoRun(async () => {
      while (live(c) && !DONE.has(res) && orders[k]) {
        if (busy) { await new Promise(r => setTimeout(r, 60)); continue; }
        tray = E.auto === "r" && Math.random() < 0.25 ? [menu[0].id] : [...orders[k].want];
        await judge(false);
      }
    });
  }));
  // ═════════ PRESSURE — hỏi cung kiểu L.A. Noire (tin · nghi · vạch trần bằng chứng) ═════════
  // { pressure: { who: "owen", trust: 3, guard, key,
  //     claims: [{ t: { en, vi }, face, is: "true" | "doubt" | "lie", evidence: "cap", yes: { en, vi }, no: { en, vi }, yesFace, noFace, if }],
  //     ok: [bước — khai thật], fail: [bước — im lặng / đòi luật sư] } }
  // Mỗi lời khai: Tin (đúng là thật) · Nghi ngờ (có gì đó không ổn) · Nói dối (phải đưa ĐÚNG bằng chứng). Đúng với lời không thật → “bình tĩnh” −1;
  // sai → “chịu nói” −1. Bình tĩnh về 0 = nghi phạm vỡ, khai (ok) · chịu nói về 0 hoặc hết lời khai mà chưa vỡ = fail.
  def("pressure", c => new Promise(res => {
    const P = c.st.pressure, who = P.who, R = E.R(), S = E.S();
    const claims = P.claims.filter(x => cond(x.if, c.s));
    const maxG = P.guard ?? Math.max(1, claims.filter(x => x.is !== "true").length), maxT = P.trust ?? 3;
    let k = 0, guard = maxG, trust = maxT, right = 0, f0 = "", busy = false, picking = false;
    E.ui.hideBox();
    const pips = (n, max) => Array.from({ length: max }, (_, i) => `<i class="${i < n ? "on" : ""}"></i>`).join("");
    const bub = (o, me) => `<div class="lf-bub${me ? " me" : ""}"><span>${E.words(tgt(o), E.L)}</span>${subHtml(o)}</div>`;
    const draw = body => E.ui.panel(`<div class="lf-pr"><div class="lf-vh">${face(who, f0)}<div><b>${esc(cname(who))}</b><span class="sp-dots">${claims.map((_, i) => `<i class="${i < k ? "on" : i === k ? "cur" : ""}"></i>`).join("")}</span></div></div>
      <div class="lf-prm"><span>${esc(nat({ en: "Composure", vi: "Bình tĩnh" }))}<em class="g">${pips(guard, maxG)}</em></span><span>${esc(nat({ en: "Willing to talk", vi: "Còn chịu nói" }))}<em class="t">${pips(trust, maxT)}</em></span></div>${body}</div>`, "pressure");
    const ask = () => {
      const C = claims[k]; picking = false;
      if (C.face != null) { f0 = C.face; stageFace(who, C.face); }
      draw(`${bub(C.t)}<div class="lf-prb">
        <button class="se-btn" data-p="true">${esc(nat({ en: "Believe", vi: "Tin" }))}</button>
        <button class="se-btn" data-p="doubt">${esc(nat({ en: "Doubt", vi: "Nghi ngờ" }))}</button>
        <button class="se-btn pri" data-p="lie">${esc(nat({ en: "Lie — show proof", vi: "Nói dối — đưa bằng chứng" }))}</button></div>`);
      if (!E.auto) E.say(tgt(C.t), who);
    };
    const proof = () => {
      picking = true;
      draw(`${bub(claims[k].t)}<p class="se-ask">${esc(nat({ en: "Which evidence proves it?", vi: "Bằng chứng nào chứng minh?" }))}</p>
        <div class="se-ddg">${R.items.map(id => `<button class="se-ddc" data-ev="${esc(id)}">${E.itemArt(id, "sm")}<b>${esc(nat(S.items[id]?.name))}</b></button>`).join("") || `<p class="se-mute">${esc(nat({ en: "You have no evidence.", vi: "Bạn không có bằng chứng nào." }))}</p>`}</div>
        <button class="se-btn wide" data-back>${esc(nat({ en: "Back", vi: "Quay lại" }))}</button>`);
    };
    const finish = async ok => {
      E.flag(P.key || "press_" + who, right);
      await verdict(ok, nat(ok ? { en: `${cname(who)} cracks!`, vi: `${cname(who)} khai rồi!` } : { en: `${cname(who)} stops talking`, vi: `${cname(who)} im lặng` }));
      done(res, c, ok ? P.ok : P.fail, "pressure", ok ? "ok" : "fail");
    };
    const judge = async (pick, ev) => {
      if (busy || !live(c) || DONE.has(res)) return; busy = true; E.hush();
      const C = claims[k], ok = pick === C.is && (pick !== "lie" || ev === C.evidence);
      if (ok) { right++; if (C.is !== "true") guard--; } else trust--;
      const line = ok ? C.yes || (C.is === "true" ? { en: "Thank you.", vi: "Cảm ơn." } : C.is === "lie" ? { en: "…Where did you get that?", vi: "…Anh / chị lấy cái đó ở đâu?" } : { en: "I… I don't remember exactly.", vi: "Tôi… tôi không nhớ rõ." })
        : C.no || (pick === "lie" ? { en: "That proves nothing.", vi: "Cái đó chẳng chứng minh được gì." } : pick === "true" ? { en: "Good. So we're done here?", vi: "Tốt. Vậy xong rồi chứ?" } : { en: "You think I'm lying? Unbelievable.", vi: "Nghĩ tôi nói dối à? Không thể tin nổi." });
      const fc = ok ? C.yesFace : C.noFace; if (fc != null) { f0 = fc; stageFace(who, fc); }
      E.sfx(ok ? (C.is === "true" ? "tap" : "hit") : "wrong"); E.haptic(ok ? "MEDIUM" : "HEAVY"); if (ok && C.is === "lie") E.ui.fx("objection"); else if (!ok) E.ui.fx("shake");
      draw(`${bub(C.t)}${bub(line)}`);
      const m = document.querySelector(ok ? ".lf-prm .g" : ".lf-prm .t"); m?.classList.add("hit");
      floatTxt(m, ok ? (C.is === "true" ? "✓" : nat({ en: "Shaken", vi: "Lung lay" })) : nat({ en: "Wrong call", vi: "Nhầm rồi" }), ok ? "#ffd166" : "#fca5a5");
      if (!E.auto) await E.say(tgt(line), who);
      await wait(1100 + tgt(line).length * 22);
      if (!live(c)) return res();
      busy = false; k++;
      if (guard <= 0) return finish(true);
      if (trust <= 0 || k >= claims.length) return finish(false);
      ask();
    };
    ui().onclick = e => {
      if (busy) return;
      const p = e.target.closest("[data-p]"); if (p) { if (p.dataset.p === "lie") { E.sfx("open"); return proof(); } return judge(p.dataset.p); }
      const ev = e.target.closest("[data-ev]"); if (ev && picking) return judge("lie", ev.dataset.ev);
      if (e.target.closest("[data-back]")) { E.sfx("tap"); return ask(); }
    };
    if (!claims.length) return done(res, c, P.fail, "pressure", "fail");
    ask();
    E.autoRun(async () => { while (live(c) && !DONE.has(res) && claims[k]) { if (busy) { await new Promise(r => setTimeout(r, 40)); continue; } const C = claims[k]; await judge(E.auto === "r" && Math.random() < 0.25 ? "true" : C.is, C.evidence); } });
  }));

  // ═════════ TAIL — bám đuôi (giữ khoảng cách, đừng để bị phát hiện, đừng để mất dấu) ═════════
  // { tail: { who: "owen", ms: 18000, near: 22, far: 72, looks: 3, ok: [bước], spotted: [bước], lost: [bước] } }
  // Giữ nút = đi nhanh, thả = chậm lại. Gần quá (< near) → “nghi ngờ” tăng; xa quá (> far) → “mất dấu” tăng. Người đó quay lại nhìn (looks lần):
  // có cảnh báo “!” trước ~0,7 s — đang đi nhanh lúc họ nhìn = nghi ngờ tăng vọt. Đầy thanh nào thì thua kiểu đó; trụ hết giờ = ok.
  def("tail", c => new Promise(res => {
    const P = c.st.tail, who = P.who, ms = P.ms ?? 18000, near = P.near ?? 22, far = P.far ?? 72, nl = P.looks ?? 3;
    let x = 1; { let h = E.hash(c.key()) || 1; x = h; }
    const rnd = () => ((x = (x * 1103515245 + 12345) >>> 0) % 10000) / 10000;
    // lịch quay lại nhìn định trước theo khoá bước (tải lại không đổi)
    const looks = Array.from({ length: nl }, (_, i) => (ms * (i + 1)) / (nl + 1) + (rnd() - 0.5) * ms * 0.12).map(t => ({ t, warn: t - 700, end: t + 1100 }));
    let gap = 45, sus = 0, lost = 0, hold = false, t0 = 0, last = 0, raf = 0, over = false, phase = "";
    E.ui.hideBox();
    E.ui.panel(`<div class="lf-tl2"><div class="se-xg"><span>${esc(nat(P.goal || { en: `Follow ${cname(who)} — don't get seen`, vi: `Bám theo ${cname(who)} — đừng để bị thấy` }))}</span><b data-tt>${Math.ceil(ms / 1000)}s</b></div>
      <div class="lf-st"><div class="lf-zone" style="left:${near}%;width:${far - near}%"></div><span class="lf-me">${esc(nat({ en: "You", vi: "Bạn" }))}</span><span class="lf-tg" data-tg style="--c:${color(who)}">${face(who)}<b data-lk>!</b></span></div>
      <div class="lf-bars"><span>${esc(nat({ en: "Suspicion", vi: "Bị nghi" }))}<i><em data-sus></em></i></span><span>${esc(nat({ en: "Losing them", vi: "Mất dấu" }))}<i><em data-lost></em></i></span></div>
      <p class="se-mute lf-th2" data-msg>${esc(nat({ en: "Hold to walk faster, let go to slow down.", vi: "Giữ để đi nhanh, thả ra để chậm lại." }))}</p>
      <button class="lf-hold" data-hold>${esc(nat({ en: "HOLD — walk faster", vi: "GIỮ — đi nhanh" }))}</button></div>`, "tail");
    const $ = s => document.querySelector(s);
    const end = async kind => {
      if (over || !live(c)) return; over = true; cancelAnimationFrame(raf); document.removeEventListener("keydown", kd); document.removeEventListener("keyup", ku);
      E.flag(P.key || "tail_" + who, kind);
      if (kind === "ok") { E.sfx("solve"); E.haptic("MEDIUM"); } else { E.sfx("hit"); E.haptic("HEAVY"); E.ui.fx("redflash"); }
      await verdict(kind === "ok", nat(kind === "ok" ? { en: "Still on their trail", vi: "Vẫn bám được" } : kind === "spotted" ? { en: "Spotted!", vi: "Bị phát hiện!" } : { en: "Lost them", vi: "Mất dấu rồi" }));
      const k2 = P[kind] ? kind : kind !== "ok" && P.fail ? "fail" : null;
      done(res, c, k2, "tail", k2);
    };
    const frame = now => {
      if (over || !live(c)) return;
      const dt = Math.min(0.05, (now - last) / 1000), t = now - t0; last = now;
      // mục tiêu đi lúc nhanh lúc chậm (sóng + giật nhẹ); mình: giữ = 15, thả = 5
      const tv = 9 + 5 * Math.sin(t / 1300) + 3 * Math.sin(t / 470 + 1), mv = hold ? 15 : 5;
      gap = Math.max(2, Math.min(98, gap + (tv - mv) * dt * 2.4));
      const L = looks.find(l => t >= l.warn && t < l.end), watching = L && t >= L.t;
      phase = L ? (watching ? "look" : "warn") : "";
      if (gap < near) sus += dt * 34; else if (gap > far) lost += dt * 30; else { sus = Math.max(0, sus - dt * 6); lost = Math.max(0, lost - dt * 8); }
      if (watching && hold) sus += dt * 95;
      if (watching && gap < near + 10) sus += dt * 30;
      const tg = $("[data-tg]"); if (tg) { tg.style.left = gap + "%"; tg.classList.toggle("warn", phase === "warn"); tg.classList.toggle("look", phase === "look"); }
      const s1 = $("[data-sus]"), s2 = $("[data-lost]"); if (s1) s1.style.width = Math.min(100, sus) + "%"; if (s2) s2.style.width = Math.min(100, lost) + "%";
      const tt = $("[data-tt]"); if (tt) tt.textContent = Math.max(0, Math.ceil((ms - t) / 1000)) + "s";
      const msg = $("[data-msg]"); if (msg) { const m = phase === "look" ? nat({ en: "They're looking back — freeze!", vi: "Họ đang ngoái lại — đứng im!" }) : phase === "warn" ? nat({ en: "They're slowing down…", vi: "Họ chậm lại…" }) : gap < near ? nat({ en: "Too close!", vi: "Gần quá!" }) : gap > far ? nat({ en: "Too far — catch up!", vi: "Xa quá — bắt kịp!" }) : nat({ en: "Good distance.", vi: "Khoảng cách tốt." }); if (msg.textContent !== m) msg.textContent = m; msg.className = "se-mute lf-th2" + (phase || gap < near || gap > far ? " bad" : ""); }
      if (sus >= 100) return end("spotted");
      if (lost >= 100) return end("lost");
      if (t >= ms) return end("ok");
      raf = requestAnimationFrame(frame);
    };
    const on = v => { if (over || !live(c)) return; hold = v; $("[data-hold]")?.classList.toggle("on", v); if (v) E.haptic("LIGHT"); };
    ui().onpointerdown = e => { if (e.target.closest("[data-hold]")) { e.preventDefault(); on(true); } };
    ui().onpointerup = ui().onpointercancel = ui().onpointerleave = () => on(false);
    const kd = e => { if (e.code === "Space") { e.preventDefault(); on(true); } }, ku = e => { if (e.code === "Space") on(false); };
    document.addEventListener("keydown", kd); document.addEventListener("keyup", ku);
    c.onCancel?.(() => { over = true; cancelAnimationFrame(raf); document.removeEventListener("keydown", kd); document.removeEventListener("keyup", ku); DONE.add(res); res(); });
    if (!E.auto) { t0 = last = performance.now(); raf = requestAnimationFrame(frame); }
    E.autoRun(() => end(E.auto === "r" && Math.random() < 0.25 ? "spotted" : "ok"));
  }));

  // ═════════ COMPOSE — xếp chữ thành câu (học trật tự từ) ═════════
  // { compose: { t: { vi: "Tôi chưa từng đến đó." }, a: "I have never been there." | ["…", "…"], extra: ["ever", "went"], tries: 3, why, ok, fail, key, who } }
  // t = nghĩa (ngôn ngữ gốc); a = câu đúng (có thể nhiều cách); extra = chữ gây nhiễu. Sai → chỉ chữ đầu tiên lệch; hết lượt → hiện câu đúng.
  const words = s => String(s).replace(/[.!?]+$/, "").split(/\s+/).filter(Boolean);
  const nrm = s => String(s).toLowerCase().replace(/[’']/g, "'").replace(/[^\p{L}\p{N}' ]+/gu, " ").replace(/\s+/g, " ").trim();
  def("compose", c => new Promise(res => {
    const K = c.st.compose, acc = [].concat(typeof K.a === "object" && !Array.isArray(K.a) ? tgt(K.a) : K.a).map(a => typeof a === "string" ? a : tgt(a));
    let x = E.hash(c.key()) || 1; const rnd = () => ((x = (x * 1103515245 + 12345) >>> 0) % 10000) / 10000;
    const tiles = [...words(acc[0]), ...(K.extra || [])].map((w, i) => ({ w, i, r: rnd() })).sort((a, b) => a.r - b.r);
    let line = [], tries = 0, msg = "", bad = -1, over = false;
    E.ui.hideBox();
    const draw = () => E.ui.panel(`<div class="lf-cp"><div class="se-ask">${esc(nat(K.prompt || { en: "Say it in the language you're learning", vi: "Nói câu này bằng tiếng đang học" }))}</div>
      <p class="lf-cpt">${esc(nat(K.t))}</p>
      <div class="lf-cpl">${line.map((ti, p) => `<button class="lf-w on${p === bad ? " bad" : ""}" data-o="${p}">${esc(tiles[ti].w)}</button>`).join("") || `<small class="se-mute">${esc(nat({ en: "Tap the words in order", vi: "Chạm các chữ theo thứ tự" }))}</small>`}</div>
      <div class="lf-cpb">${tiles.map((t, k) => `<button class="lf-w${line.includes(k) ? " gone" : ""}" data-k="${k}" ${line.includes(k) ? "disabled" : ""}>${esc(t.w)}</button>`).join("")}</div>
      ${msg}<button class="se-btn pri wide${line.length ? "" : " dim"}" data-ok ${line.length ? "" : "disabled"}>${esc(nat({ en: "Check", vi: "Kiểm tra" }))}</button></div>`, "compose");
    const fin = async ok => {
      if (over || !live(c)) return; over = true;
      E.flag(K.key || "compose_" + c.key(), ok ? 1 : 0); if (ok) E.add("composed", 1);
      if (!E.auto) E.say(acc[0], K.who || "narr", { force: true, narr: !K.who });
      await verdict(ok, nat(ok ? { en: "Perfect sentence!", vi: "Câu chuẩn!" } : { en: "Not this time", vi: "Lần này chưa được" }));
      if (!live(c)) return;
      if (!E.auto && (ok ? K.why : K.reveal !== false)) await E.feedback(`<div class="se-fb a${ok ? 2 : 0}"><b>${esc(acc[0])}</b>${K.why ? `<p>${esc(nat(K.why))}</p>` : ""}</div>`);
      done(res, c, ok ? K.ok : K.fail, "compose", ok ? "ok" : "fail");
    };
    // kéo chữ vào câu (thả lên 1 chữ trong câu = chèn trước chữ đó) · kéo chữ trong câu để đổi vị trí · kéo ra ngoài = bỏ
    ui().onpointerdown = E.dragger?.({ src: "[data-k], [data-o]", dst: "[data-o], .lf-cpl", drop: (a, d) => {
      if (over || !live(c)) return;
      const fromLine = a.dataset.o != null, ti = fromLine ? line[+a.dataset.o] : +a.dataset.k;
      if (!d) { if (fromLine) { line.splice(+a.dataset.o, 1); E.sfx("tap"); draw(); } return; }
      if (fromLine) line.splice(+a.dataset.o, 1);
      let at = d.dataset.o != null ? +d.dataset.o : line.length; if (fromLine && d.dataset.o != null && +d.dataset.o > +a.dataset.o) at--;
      line.splice(Math.max(0, Math.min(line.length, at)), 0, ti); bad = -1; msg = ""; E.sfx("pick"); E.haptic("LIGHT"); draw();
    } });
    ui().onclick = e => {
      if (over || !live(c)) return;
      if (E.dragged?.()) return;
      const k = e.target.closest("[data-k]"); if (k) { line.push(+k.dataset.k); bad = -1; msg = ""; E.sfx("pick"); E.haptic("LIGHT"); return draw(); }
      const o = e.target.closest("[data-o]"); if (o) { line.splice(+o.dataset.o, 1); bad = -1; E.sfx("tap"); return draw(); }
      if (e.target.closest("[data-ok]") && line.length) {
        tries++;
        const got = line.map(i => tiles[i].w).join(" ");
        E.flash?.(document.querySelector(".lf-cpl"), acc.some(a => nrm(a) === nrm(got)));
        if (acc.some(a => nrm(a) === nrm(got))) { E.sfx("solve"); E.ui.fx("solve"); burst(document.querySelector(".lf-cpl"), "#6fcf97", 18); return fin(true); }
        // chữ đầu tiên lệch so với câu đúng gần nhất (cùng chữ đầu dài nhất)
        const gw = words(got).map(nrm), best = acc.map(a => words(a).map(nrm)).map(aw => { let p = 0; while (p < aw.length && aw[p] === gw[p]) p++; return p; });
        bad = Math.min(line.length - 1, Math.max(...best));
        E.sfx("wrong"); E.ui.fx("shake"); E.haptic("HEAVY");
        if (K.tries && tries >= K.tries) return fin(false);
        msg = `<div class="se-hint no">${esc(nat({ en: "Almost — check the highlighted word.", vi: "Gần đúng — xem lại chữ đang sáng." }))}${K.tries ? ` ${esc(nat({ en: `${K.tries - tries} tries left.`, vi: `Còn ${K.tries - tries} lần.` }))}` : ""}</div>`;
        draw();
      }
    };
    draw();
    E.autoRun(() => fin(!(E.auto === "r" && Math.random() < 0.25)));
  }));

  // ═════════ BARGAIN — mặc cả (chợ, tiệm đồ cũ, taxi…) ═════════
  // { bargain: { who: "vendor", item: { en, vi } | "<mã đồ vật>", ask: 40, floor: 26, money: "coins", patience: 3, give: "<mã đồ>",
  //     ok: [bước — mua được], fail: [bước — không mua] , key } }
  // floor = giá thấp nhất người bán chịu (người chơi không thấy). Mỗi lượt: kéo giá muốn trả + chọn CÁCH nói:
  //   lịch sự (ít mất kiên nhẫn, người bán giảm ít) · cứng rắn (giảm nhiều hơn, mất kiên nhẫn) · bỏ đi (đòn tâm lý: còn lời thì người bán gọi lại).
  // Trả ≥ floor = chốt. Trả quá thấp (< 70 % floor) = xúc phạm, mất 2 kiên nhẫn. Hết kiên nhẫn = người bán đuổi khéo.
  def("bargain", c => new Promise(res => {
    const B = c.st.bargain, who = B.who, R = E.R(), S = E.S(), cur = B.money || "coins";
    const item = typeof B.item === "string" ? S.items?.[B.item]?.name || { en: B.item } : B.item;
    const floor = B.floor ?? Math.round(B.ask * 0.65), lo = Math.max(1, Math.round(B.ask * 0.3));
    let price = B.ask, patience = B.patience ?? 3, offer = Math.round((lo + B.ask) / 2), line = B.hello || { en: `${tgt(item)}? %n. Best quality.`, vi: `${nat(item)}? %n. Hàng tốt nhất.` }, busy = false, f0 = "";
    E.ui.hideBox();
    const fmt = (o, n) => tgt(o).split("%n").join(n), fmtN = (o, n) => nat(o).split("%n").join(n);
    const bubble = o => `<div class="lf-bub"><span>${esc(fmt(o, price))}</span>${sub(o) ? `<small class="sp-sub"${E.G().set.tr ? "" : " hidden"}>${esc(fmtN(o, price))}</small>` : ""}</div>`;
    const money = () => +R.f[cur] || 0;
    const draw = (msg = "") => {
      offer = Math.min(offer, price);
      E.ui.panel(`<div class="lf-bg"><div class="lf-vh">${face(who, f0)}<div><b>${esc(cname(who))}</b><span class="lf-pat2">${Array.from({ length: B.patience ?? 3 }, (_, i) => `<i class="${i < patience ? "on" : ""}"></i>`).join("")}</span></div><em class="lf-tag">${esc(nat(item))}</em></div>
        ${bubble(line)}
        <div class="lf-pr2"><span>${esc(nat({ en: "Their price", vi: "Họ đòi" }))} <b>${price}</b></span><span>${esc(nat({ en: "You have", vi: "Bạn có" }))} <b>${money()}</b> ${esc(statName(cur))}</span></div>
        <div class="sp-gauge"><b data-of>${offer}</b><input type="range" min="${lo}" max="${price}" step="1" value="${offer}" data-r aria-label="${esc(nat({ en: "Your offer", vi: "Giá bạn trả" }))}"></div>
        ${msg}<div class="lf-bt">
          <button class="se-ch-b" data-t="polite"><span>${esc(fmt({ en: "Could you do %n?", vi: "%n được không ạ?" }, offer))}</span><small>${esc(nat({ en: "Polite", vi: "Lịch sự" }))}</small></button>
          <button class="se-ch-b" data-t="firm"><span>${esc(fmt({ en: "%n. That's my final offer.", vi: "%n. Giá chót đấy." }, offer))}</span><small>${esc(nat({ en: "Firm", vi: "Cứng rắn" }))}</small></button>
          <button class="se-ch-b" data-t="walk"><span>${esc(tgt({ en: "Never mind. I'll look elsewhere.", vi: "Thôi, tôi xem chỗ khác." }))}</span><small>${esc(nat({ en: "Walk away", vi: "Bỏ đi" }))}</small></button></div>
        <button class="se-btn pri wide" data-deal ${money() >= price ? "" : "disabled"}>${esc(nat({ en: `Deal — pay ${price}`, vi: `Chốt — trả ${price}` }))}</button></div>`, "bargain");
      const r = document.querySelector("[data-r]"); if (r) r.oninput = () => { offer = +r.value; document.querySelector("[data-of]").textContent = offer; document.querySelectorAll("[data-t] span").forEach((s, i) => { if (i < 2) s.textContent = fmt(i ? { en: "%n. That's my final offer.", vi: "%n. Giá chót đấy." } : { en: "Could you do %n?", vi: "%n được không ạ?" }, offer); }); };
    };
    const say = async (o, fc) => { line = o; if (fc != null) { f0 = fc; stageFace(who, fc); } draw(); if (!E.auto) await E.say(fmt(o, price), who); };
    const buy = async p => {
      busy = true; price = p; E.add(cur, -p); if (B.give && !R.items.includes(B.give)) R.items.push(B.give);
      E.flag(B.key || "bargain_" + c.key(), p); E.sfx("item"); E.haptic("MEDIUM");
      const saved = Math.round((1 - p / B.ask) * 100);
      await say({ en: "Deal. Pleasure doing business.", vi: "Chốt. Rất vui được bán." }, "smile");
      burst(document.querySelector(".lf-pr2"), "#ffd166", 16);
      await verdict(true, nat(saved > 0 ? { en: `Bought for ${p} — saved ${saved}%`, vi: `Mua được ${p} — bớt ${saved}%` } : { en: `Bought for ${p}`, vi: `Mua được ${p}` }));
      done(res, c, B.ok, "bargain", "ok");
    };
    const leave = async () => { busy = true; E.flag(B.key || "bargain_" + c.key(), 0); await verdict(false, nat({ en: "No deal", vi: "Không mua được" })); done(res, c, B.fail, "bargain", "fail"); };
    const turn = async t => {
      if (busy) return; busy = true;
      if (t === "walk") {
        if (price > floor * 1.12) { price = Math.max(floor, Math.round(price * 0.85)); E.sfx("up"); await say({ en: "Wait, wait! For you… %n.", vi: "Khoan, khoan! Với bạn thì… %n." }, "worried"); busy = false; return; }
        await say({ en: "Suit yourself.", vi: "Tuỳ bạn." }, "sad"); return leave();
      }
      if (offer >= floor) { if (money() < offer) { busy = false; return draw(`<div class="se-hint no">${esc(nat({ en: "You can't afford that.", vi: "Bạn không đủ tiền." }))}</div>`); } return buy(offer); }
      const insult = offer < floor * 0.7;
      patience -= insult ? 2 : t === "firm" ? 1 : 0;
      if (patience <= 0) { E.sfx("down"); E.haptic("HEAVY"); await say({ en: "Enough. I'm not selling to you.", vi: "Đủ rồi. Tôi không bán cho bạn nữa." }, "angry"); return leave(); }
      // người bán nhượng: cứng rắn → về gần floor hơn; sát floor + cứng rắn → về đúng floor
      const k = t === "firm" ? 0.45 : 0.25;
      price = t === "firm" && offer >= floor * 0.9 ? floor : Math.max(floor, Math.round(price - (price - Math.max(offer, floor)) * k));
      E.sfx(insult ? "wrong" : "tap"); if (insult) E.ui.fx("shake");
      floatTxt(document.querySelector(".lf-pr2"), insult ? nat({ en: "Insulted!", vi: "Phật ý!" }) : "−" + Math.max(0, B.ask - price), insult ? "#fca5a5" : "#ffd166");
      await say(insult ? { en: "Is that a joke? %n.", vi: "Đùa à? %n." } : t === "firm" ? { en: "You drive a hard bargain. %n.", vi: "Bạn mặc cả ghê thật. %n." } : { en: "Hmm… I can do %n.", vi: "Ừm… %n thì được." }, insult ? "angry" : "");
      busy = false;
    };
    ui().onclick = e => {
      const t = e.target.closest("[data-t]"); if (t) return turn(t.dataset.t);
      if (e.target.closest("[data-deal]") && !busy && money() >= price) buy(price);
    };
    draw(); if (!E.auto) E.say(fmt(line, price), who);
    E.autoRun(() => { if (E.auto === "r" && Math.random() < 0.25) return leave(); if (money() >= floor) buy(floor); else leave(); });
  }));
  // ─── dùng chung cho nhóm dưới: số ngẫu nhiên định trước theo khoá bước · xáo · kết thúc ok / fail có biển ───
  const seed = key => { let x = E.hash(key) || 1; return () => ((x = (x * 1103515245 + 12345) >>> 0) % 10000) / 10000; };
  const shuf = (arr, key) => { const r = seed(key); return arr.map(v => [v, r()]).sort((a, b) => a[1] - b[1]).map(v => v[0]); };
  const finish = async (res, c, name, ok, txt, val) => {
    if (DONE.has(res) || FINISHING.has(res) || !live(c)) return; FINISHING.add(res);
    const S0 = c.st[name]; E.flag(S0.key || name + "_" + c.key(), val ?? (ok ? 1 : 0));
    await verdict(ok, txt ? nat(txt) : undefined);
    done(res, c, ok ? S0.ok : S0.fail, name, ok ? "ok" : "fail");
  };
  const L = o => (o == null ? "" : typeof o === "string" ? o : tgt(o));

  // ═════════ CIPHER — giải mật mã dịch chữ (Caesar) ═════════
  // { cipher: { plain: "THE KEY IS UNDER THE MAT", shift: 3, hint: { en: "Count the candles", vi }, tr: { vi: "Chìa khoá dưới thảm" }, ok, fail } }
  // Người chơi xoay vòng chữ (◀ ▶ / kéo) — bản giải hiện ngay theo độ xoay; đúng độ xoay thì chữ khoá lại sáng lên.
  def("cipher", c => new Promise(res => {
    const C = c.st.cipher, A = "ABCDEFGHIJKLMNOPQRSTUVWXYZ", plain = String(C.plain).toUpperCase(), sh = ((C.shift ?? 3) % 26 + 26) % 26;
    const rot = (s, n) => s.replace(/[A-Z]/g, ch => A[(A.indexOf(ch) + n + 26) % 26]);
    const code = rot(plain, sh);
    let off = 0, over = false;
    E.ui.hideBox();
    const draw = () => {
      const dec = rot(code, -off), ok = off === sh;
      E.ui.panel(`<div class="lf-ci"><div class="se-ask">${esc(nat(C.prompt || { en: "Crack the code", vi: "Giải mật mã" }))}</div>
        <p class="lf-cic">${esc(code)}</p>
        <div class="lf-ciw"><button class="se-ib" data-d="-1" aria-label="−">◀</button><div class="lf-cir"><b>A → ${A[(26 - off) % 26]}</b><small>${esc(nat({ en: "shift", vi: "dịch" }))} ${off}</small></div><button class="se-ib" data-d="1" aria-label="+">▶</button></div>
        <input type="range" min="0" max="25" value="${off}" data-r aria-label="shift">
        <p class="lf-cid${ok ? " ok" : ""}">${esc(dec)}</p>
        ${ok && C.tr ? `<small class="sp-sub">${esc(nat(C.tr))}</small>` : ""}
        ${C.hint ? `<p class="se-hint">${E.ICON.bulb}${esc(nat(C.hint))}</p>` : ""}</div>`, "cipher");
      const r = document.querySelector("[data-r]"); if (r) r.oninput = () => { off = +r.value; E.sfx("tap"); draw(); check(); };
    };
    const check = () => { if (off !== sh || over) return; over = true; E.sfx("solve"); E.haptic("MEDIUM"); burst(document.querySelector(".lf-cid"), "#6fcf97", 18); if (!E.auto) E.say(plain.toLowerCase(), "narr", { force: true, narr: true }); setTimeout(() => finish(res, c, "cipher", true, { en: "Decoded!", vi: "Giải được rồi!" }), E.auto ? 0 : 1400); };
    ui().onclick = e => { const d = e.target.closest("[data-d]"); if (d && !over) { off = (off + +d.dataset.d + 26) % 26; E.sfx("tap"); E.haptic("LIGHT"); draw(); check(); } };
    draw();
    E.autoRun(() => { off = sh; check(); });
  }));

  // ═════════ EAVESDROP — nghe lén: chạm “Ghi lại” đúng lúc câu quan trọng vang lên ═════════
  // { eavesdrop: { title, lines: [{ who, en, vi, key: true }], need: 2, slips: 2, ok, fail } }
  // Câu hiện lần lượt (có giọng đọc), mỗi câu chỉ ghi được khi đang nói. Ghi câu quan trọng = +1 · ghi câu thừa = 1 lần “lỡ tay” (quá slips = trượt).
  def("eavesdrop", c => new Promise(res => {
    const V = c.st.eavesdrop, lines = V.lines.filter(l => cond(l.if, c.s)), need = V.need ?? lines.filter(l => l.key).length, slips = V.slips ?? 2;
    let k = -1, got = 0, bad = 0; const noted = new Set();
    E.ui.hideBox();
    const draw = () => E.ui.panel(`<div class="lf-ea"><div class="se-xg"><span>${esc(nat(V.title || { en: "Listen in — note what matters", vi: "Nghe lén — ghi lại điều quan trọng" }))}</span><b>${got}/${need}</b></div>
      <div class="lf-eal">${lines.slice(0, k + 1).map((l, i) => `<div class="lf-eai${i === k ? " now" : ""}${noted.has(i) ? (l.key ? " hit" : " miss") : ""}"><em style="color:${color(l.who)}">${esc(cname(l.who))}</em><span>${E.words(L(l), E.L)}</span>${subHtml(l)}</div>`).join("")}</div>
      <button class="lf-hold" data-note ${k >= 0 && !noted.has(k) ? "" : "disabled"}>${E.ICON.pen} ${esc(nat({ en: "Note that!", vi: "Ghi lại!" }))}</button></div>`, "eaves");
    const next = async () => {
      if (!live(c) || DONE.has(res) || FINISHING.has(res)) return;
      k++;
      if (k >= lines.length) return finish(res, c, "eavesdrop", got >= need && bad <= slips, got >= need && bad <= slips ? { en: "Got the key details", vi: "Nắm được chi tiết chính" } : { en: "You missed something", vi: "Bạn bỏ lỡ gì đó" }, got);
      draw(); const el = document.querySelector(".lf-eal"); if (el) el.scrollTop = el.scrollHeight;
      const l = lines[k];
      if (!E.auto) await Promise.all([E.say(L(l), l.who), wait(1700 + L(l).length * 45)]);
      next();
    };
    ui().onclick = e => {
      if (!live(c) || FINISHING.has(res) || !e.target.closest("[data-note]") || k < 0 || k >= lines.length || noted.has(k)) return;
      noted.add(k); const ok = !!lines[k].key; if (ok) got++; else bad++;
      E.sfx(ok ? "up" : "wrong"); E.haptic(ok ? "MEDIUM" : "HEAVY"); draw();
      floatTxt(document.querySelector(".lf-eai.now"), ok ? nat({ en: "Noted!", vi: "Đã ghi!" }) : nat({ en: "Not important", vi: "Không quan trọng" }), ok ? "#6fcf97" : "#fca5a5");
    };
    next();
    E.autoRun(() => {});
  }));

  // ═════════ LINEUP — nhận dạng theo lời nhân chứng (đọc hiểu mô tả) ═════════
  // { lineup: { who: "witness", desc: { en: "Tall, glasses, a red cap.", vi }, people: [{ id, name, pic, traits: [{ en, vi }] }], a: "id", tries: 2, ok, fail } }
  def("lineup", c => new Promise(res => {
    const P = c.st.lineup; let tries = 0, over = false; const out = new Set();
    E.ui.hideBox();
    const nm = p => p.name ? L(p.name) : cname(p.id);
    const draw = (msg = "") => E.ui.panel(`<div class="lf-lu">${P.who ? `<div class="lf-cust">${face(P.who)}<div class="lf-bub"><span>${E.words(L(P.desc), E.L)}</span>${subHtml(P.desc)}</div></div>` : `<div class="lf-bub"><span>${E.words(L(P.desc), E.L)}</span>${subHtml(P.desc)}</div>`}
      <div class="lf-lug">${P.people.map(p => `<button class="lf-lup${out.has(p.id) ? " out" : ""}" data-p="${esc(p.id)}" ${out.has(p.id) ? "disabled" : ""}>${p.pic ? `<span class="sp-av" style="--c:#888"><i class="im-${esc(p.pic)}"></i></span>` : face(p.id)}<b>${esc(nm(p))}</b><span class="lf-tr">${(p.traits || []).map(t => `<i>${esc(L(t))}</i>`).join("")}</span></button>`).join("")}</div>
      ${msg}</div>`, "lineup");
    const pick = id => {
      if (over) return; tries++;
      E.flash?.(document.querySelector(`[data-p="${id}"]`), id === P.a);
      if (id === P.a) { over = true; E.sfx("solve"); burst(document.querySelector(`[data-p="${id}"]`), "#6fcf97", 16); return finish(res, c, "lineup", true, { en: "That's them!", vi: "Chính là người đó!" }); }
      out.add(id); E.sfx("wrong"); E.ui.fx("shake"); E.haptic("HEAVY");
      if (P.tries && tries >= P.tries) { over = true; return finish(res, c, "lineup", false, { en: "Wrong person", vi: "Nhận nhầm người" }); }
      draw(`<div class="se-hint no">${esc(nat({ en: "That doesn't match the description. Read it again.", vi: "Không khớp lời mô tả. Đọc lại nhé." }))}</div>`);
    };
    ui().onclick = e => { const b = e.target.closest("[data-p]"); if (b) pick(b.dataset.p); };
    draw(); if (P.who && !E.auto) E.say(L(P.desc), P.who);
    // tự chơi: có thể chọn nhầm 1 lần (thử nhánh sai) rồi chọn đúng
    E.autoRun(() => { const w = P.people.find(p => p.id !== P.a)?.id; if (E.auto === "r" && w && Math.random() < 0.3) pick(w); pick(P.a); });
  }));

  // ═════════ HEARTBEAT — giữ bình tĩnh theo nhịp tim (tỏ tình, phỏng vấn, đối mặt) ═════════
  // { heartbeat: { prompt, beats: 8, bpm: 70, need: 5, ok, fail } } — chạm đúng lúc vòng co về tâm; trượt = tim đập nhanh hơn (khó hơn)
  def("heartbeat", c => new Promise(res => {
    const H = c.st.heartbeat, total = H.beats ?? 8, need = H.need ?? Math.ceil(total * 0.6);
    let bpm = H.bpm ?? 70, n = 0, good = 0, t0 = 0, per = 60000 / bpm, raf = 0, over = false, tapped = false;
    c.onCancel?.(() => { over = true; cancelAnimationFrame(raf); DONE.add(res); res(); });
    E.ui.hideBox();
    E.ui.panel(`<div class="lf-hb"><div class="se-ask">${esc(nat(H.prompt || { en: "Breathe. Tap with your heartbeat.", vi: "Hít thở. Chạm theo nhịp tim." }))}</div>
      <button class="lf-hbb" data-tap><i data-ring></i><b>♥</b></button>
      <div class="lf-hbs"><span>${esc(nat({ en: "Steady", vi: "Đều nhịp" }))} <b data-g>0</b>/${need}</span><span><b data-bpm>${bpm}</b> bpm</span></div></div>`, "heartbeat");
    const $ = s => document.querySelector(s);
    const beat = () => { n++; tapped = false; t0 = performance.now(); if (n > total) return end(); };
    const end = () => { if (over || !live(c)) return; over = true; cancelAnimationFrame(raf); const ok = good >= need; finish(res, c, "heartbeat", ok, ok ? { en: "Calm and steady", vi: "Bình tĩnh rồi" } : { en: "Your heart is racing", vi: "Tim đập loạn" }, good); };
    const frame = now => { if (over || !live(c)) return; const p = (now - t0) / per; if (p >= 1) { if (!tapped) miss(); beat(); } const r = $("[data-ring]"); if (r) r.style.transform = `scale(${1.55 - Math.min(1, p) * 0.55})`; raf = requestAnimationFrame(frame); };
    const miss = () => { bpm = Math.min(150, bpm + 8); per = 60000 / bpm; const b = $("[data-bpm]"); if (b) b.textContent = bpm; E.haptic("HEAVY"); $(".lf-hbb")?.classList.add("bad"); setTimeout(() => $(".lf-hbb")?.classList.remove("bad"), 250); };
    ui().onpointerdown = e => {
      if (!e.target.closest("[data-tap]") || over || tapped) return; tapped = true;
      const p = (performance.now() - t0) / per, hit = p > 0.8 || p < 0.08;
      if (hit) { good++; bpm = Math.max(55, bpm - 3); per = 60000 / bpm; E.sfx("beat"); E.haptic("LIGHT"); const g = $("[data-g]"); if (g) g.textContent = good; floatTxt($(".lf-hbb"), "♥", "#ff7eb6"); if (good >= need && n >= total - 1) return end(); }
      else miss();
    };
    if (!E.auto) { beat(); raf = requestAnimationFrame(frame); }
    E.autoRun(() => { good = E.auto === "r" && Math.random() < 0.25 ? 0 : need; end(); });
  }));

  // ═════════ SWIPE — quẹt thẻ trái / phải (app hẹn hò, thật / giả, giữ / bỏ…) ═════════
  // { swipe: { prompt, left: { en: "Nope" }, right: { en: "Like" }, cards: [{ t: { en, vi }, title, pic, a: "right" | "left", right: { add, set }, left: { … } }], need, ok, fail, key } }
  // Có `a` = có đúng / sai (đếm điểm, need) · không có = chỉ ghi lựa chọn (flag <key>.<chỉ số> = "l" | "r") và áp add / set.
  def("swipe", c => new Promise(res => {
    const W = c.st.swipe, cards = W.cards.filter(x => cond(x.if, c.s)), scored = cards.some(x => x.a), need = W.need ?? Math.ceil(cards.filter(x => x.a).length * 0.7);
    let k = 0, right = 0, busy = false;
    E.ui.hideBox();
    if (!cards.length) return done(res, c, W.empty || W.then, "swipe", W.empty ? "empty" : "then");
    const draw = () => {
      const C = cards[k];
      E.ui.panel(`<div class="lf-sw"><div class="se-ask">${esc(nat(W.prompt || { en: "Swipe", vi: "Quẹt" }))} <small class="se-mute">${k + 1}/${cards.length}</small></div>
        <div class="lf-swd">${cards[k + 1] ? `<div class="lf-swc back"></div>` : ""}<div class="lf-swc" data-card>${C.pic ? `<i class="lf-swp im-${esc(C.pic)}"></i>` : ""}${C.title ? `<b>${esc(L(C.title))}</b>` : ""}<p>${E.words(L(C.t), E.L)}</p>${subHtml(C.t)}<em class="lf-swl">${esc(nat(W.left || { en: "No", vi: "Không" }))}</em><em class="lf-swr">${esc(nat(W.right || { en: "Yes", vi: "Có" }))}</em></div></div>
        <div class="se-row"><button class="se-btn" data-s="left">◀ ${esc(nat(W.left || { en: "No", vi: "Không" }))}</button><button class="se-btn pri" data-s="right">${esc(nat(W.right || { en: "Yes", vi: "Có" }))} ▶</button></div></div>`, "swipe");
      const card = document.querySelector("[data-card]"); if (!card) return;
      card.onpointerdown = e => {
        if (busy || !live(c)) return; const x0 = e.clientX; try { card.setPointerCapture(e.pointerId); } catch {}
        card.onpointermove = ev => { const dx = ev.clientX - x0; card.style.transform = `translateX(${dx}px) rotate(${dx / 18}deg)`; card.classList.toggle("l", dx < -40); card.classList.toggle("r", dx > 40); };
        card.onpointercancel = () => { card.onpointermove = card.onpointerup = card.onpointercancel = null; card.style.transform = ""; card.classList.remove("l", "r"); };
        card.onpointerup = ev => { card.onpointermove = card.onpointerup = null; const dx = ev.clientX - x0; if (Math.abs(dx) > 90) go(dx > 0 ? "right" : "left"); else { card.style.transform = ""; card.classList.remove("l", "r"); } };
      };
    };
    const go = async side => {
      if (busy || !live(c) || FINISHING.has(res) || DONE.has(res)) return; busy = true;
      const C = cards[k]; E.apply(C[side]); E.flag((W.key || "swipe") + "." + k, side[0]);
      const ok = !C.a || C.a === side; if (C.a && ok) right++;
      const card = document.querySelector("[data-card]"); if (card) { card.style.transition = "transform .3s, opacity .3s"; card.style.transform = `translateX(${side === "right" ? 420 : -420}px) rotate(${side === "right" ? 20 : -20}deg)`; card.style.opacity = "0"; }
      E.sfx(scored ? (ok ? "up" : "wrong") : "whoosh"); E.haptic(ok ? "LIGHT" : "HEAVY");
      if (scored) floatTxt(document.querySelector(".lf-swd"), ok ? "✓" : "✗", ok ? "#6fcf97" : "#fca5a5");
      await wait(320); if (!live(c)) return res(); k++; busy = false;
      if (k >= cards.length) return scored ? finish(res, c, "swipe", right >= need, { en: `${right}/${cards.filter(x => x.a).length} right`, vi: `Đúng ${right}/${cards.filter(x => x.a).length}` }, right) : done(res, c, W.then, "swipe", "then");
      draw();
    };
    ui().onclick = e => { const b = e.target.closest("[data-s]"); if (b) go(b.dataset.s); };
    draw();
    E.autoRun(async () => { while (live(c) && k < cards.length && !DONE.has(res)) { const C = cards[k]; await go(E.auto === "r" ? (Math.random() < 0.5 ? "left" : "right") : C.a || "right"); } });
  }));

  // ═════════ COOK — nấu ăn theo công thức (đọc hướng dẫn + thao tác) ═════════
  // { cook: { dish: { en, vi }, steps: [{ t: { en: "Crack two eggs.", vi }, act: "tap", n: 2 } | { t, act: "hold", zone: [70, 92] }
  //     | { t, act: "time", zone: [45, 60], speed } | { t, act: "pick", opts: [{ en: "salt" }, { en: "sugar" }], a: 0 }], need, ok, fail } }
  def("cook", c => new Promise(res => {
    const K = c.st.cook, steps = K.steps, need = K.need ?? Math.max(1, steps.length - 1);
    let k = 0, good = 0, raf = 0, busy = false;
    c.onCancel?.(() => { busy = true; cancelAnimationFrame(raf); DONE.add(res); res(); });
    E.ui.hideBox();
    if (!steps.length) return done(res, c, K.fail, "cook", "fail");
    const head = () => `<div class="se-xg"><span>${esc(nat(K.dish || { en: "Cooking", vi: "Nấu ăn" }))}</span><b>${"★".repeat(good)}${"☆".repeat(Math.max(0, steps.length - good))}</b></div><div class="lf-ckt"><em>${k + 1}/${steps.length}</em><p>${E.words(L(steps[k].t), E.L)}</p>${subHtml(steps[k].t)}</div>`;
    const stepDone = async ok => {
      if (busy || !live(c) || DONE.has(res)) return; busy = true; cancelAnimationFrame(raf);
      if (ok) { good++; E.sfx("solve"); E.haptic("MEDIUM"); burst(document.querySelector(".lf-ckt"), "#ffd166", 12); } else { E.sfx("wrong"); E.haptic("HEAVY"); E.ui.fx("shake"); }
      floatTxt(document.querySelector(".lf-ckt"), nat(ok ? { en: "Nice!", vi: "Khéo!" } : { en: "Oops…", vi: "Hỏng rồi…" }), ok ? "#ffd166" : "#fca5a5");
      await wait(800); if (!live(c)) return res(); k++; busy = false;
      if (k >= steps.length) return finish(res, c, "cook", good >= need, good >= need ? { en: "Delicious!", vi: "Ngon tuyệt!" } : { en: "Edible… barely", vi: "Ăn được… tạm" }, good);
      run();
    };
    const run = () => {
      const S0 = steps[k], act = S0.act || "tap";
      if (act === "tap") {
        let n = 0; const N = S0.n || 3;
        E.ui.panel(`<div class="lf-ck">${head()}<button class="sp-qb ring" data-ct style="--p:0"><b>${N}</b><small>${esc(nat({ en: "TAP", vi: "CHẠM" }))}</small></button></div>`, "cook");
        ui().onclick = e => { const b = e.target.closest("[data-ct]"); if (!b || busy) return; n++; E.sfx("tap"); E.haptic("LIGHT"); b.style.setProperty("--p", n / N); b.querySelector("b").textContent = N - n; if (n >= N) stepDone(true); };
      } else if (act === "pick") {
        E.ui.panel(`<div class="lf-ck">${head()}<div class="lf-menu">${S0.opts.map((o, i) => `<button data-cp="${i}"><b>${esc(L(o))}</b>${sub(o) ? `<small>${esc(sub(o))}</small>` : ""}</button>`).join("")}</div></div>`, "cook");
        ui().onclick = e => { const b = e.target.closest("[data-cp]"); if (b) stepDone(+b.dataset.cp === (S0.a ?? 0)); };
      } else {
        // hold: giữ để đầy, thả trong vùng xanh · time: kim chạy, bấm trong vùng xanh
        const [z0, z1] = S0.zone || (act === "hold" ? [70, 92] : [42, 58]);
        E.ui.panel(`<div class="lf-ck">${head()}<div class="lf-ckm"><i style="left:${z0}%;width:${z1 - z0}%"></i><em data-nd></em></div><button class="lf-hold" data-ch>${esc(nat(act === "hold" ? { en: "HOLD — release in the green", vi: "GIỮ — thả ở vùng xanh" } : { en: "NOW!", vi: "NGAY!" }))}</button></div>`, "cook");
        let v = 0, holding = false, t1 = performance.now(), last = t1; const sp = S0.speed || 1;
        const nd = () => document.querySelector("[data-nd]");
        const frame = now => { if (busy || !live(c)) return; const dt = (now - last) / 1000; last = now; if (act === "hold") { if (holding) v = Math.min(100, v + dt * 55 * sp); if (v >= 100) return stepDone(false); } else { const ph = ((now - t1) / 1000 * 0.9 * sp) % 2; v = (ph < 1 ? ph : 2 - ph) * 100; } const e = nd(); if (e) e.style.left = v + "%"; raf = requestAnimationFrame(frame); };
        if (!E.auto) raf = requestAnimationFrame(frame);
        if (act === "hold") { ui().onpointerdown = e => { if (e.target.closest("[data-ch]")) { holding = true; E.haptic("LIGHT"); } }; ui().onpointercancel = () => { holding = false; v = 0; const e = nd(); if (e) e.style.left = "0%"; }; ui().onpointerup = () => { if (holding) { holding = false; ui().onpointerdown = null; stepDone(v >= z0 && v <= z1); } }; }
        else ui().onclick = e => { if (e.target.closest("[data-ch]")) stepDone(v >= z0 && v <= z1); };
      }
    };
    run();
    E.autoRun(async () => { while (live(c) && k < steps.length && !DONE.has(res)) { if (busy) { await new Promise(r => setTimeout(r, 40)); continue; } await stepDone(!(E.auto === "r" && Math.random() < 0.25)); } });
  }));

  // ═════════ BUDGET — đi chợ với ngân sách (đủ nhu cầu, không vượt tiền) ═════════
  // { budget: { money: 20 | "coins", spend: true, list: [{ id, en, vi, price, tags: ["food"] }], need: { food: 2, drink: 1 }, needName: { food: { en, vi } }, ok, fail, key } }
  def("budget", c => new Promise(res => {
    const B = c.st.budget, R = E.R(), cap = typeof B.money === "string" ? +R.f[B.money] || 0 : B.money ?? 20, cart = new Set();
    let paid = false;
    E.ui.hideBox();
    const total = () => [...cart].reduce((a, id) => a + B.list.find(x => x.id === id).price, 0);
    const have = t => [...cart].filter(id => B.list.find(x => x.id === id).tags?.includes(t)).length;
    const met = () => Object.entries(B.need || {}).every(([t, n]) => have(t) >= n);
    const draw = (msg = "") => {
      const tot = total(), over = tot > cap;
      E.ui.panel(`<div class="lf-bu"><div class="se-xg"><span>${esc(nat(B.title || { en: "Shopping list", vi: "Danh sách đi chợ" }))}</span><b class="${over ? "no" : ""}">${tot} / ${cap}</b></div>
        <div class="lf-bun">${Object.entries(B.need || {}).map(([t, n]) => `<span class="${have(t) >= n ? "ok" : ""}">${have(t) >= n ? "✓" : "○"} ${esc(nat(B.needName?.[t] || { en: t }))} ${have(t)}/${n}</span>`).join("")}</div>
        <div class="lf-menu">${B.list.map(x => `<button data-bi="${esc(x.id)}" class="${cart.has(x.id) ? "on" : ""}"><b>${esc(L(x))}</b>${sub(x) ? `<small>${esc(sub(x))}</small>` : ""}<em class="sp-price">${x.price}</em></button>`).join("")}</div>
        ${msg}<button class="se-btn pri wide${!over && cart.size ? "" : " dim"}" data-pay ${!over && cart.size ? "" : "disabled"}>${esc(nat(over ? { en: "Over budget", vi: "Vượt ngân sách" } : { en: "Check out", vi: "Thanh toán" }))}</button></div>`, "budget");
    };
    const pay = () => { if (paid || !live(c)) return; paid = true; const ok = met() && total() <= cap; if (B.spend !== false && typeof B.money === "string") E.add(B.money, -total()); E.flag((B.key || "budget") + "_items", [...cart].join(",")); finish(res, c, "budget", ok, ok ? { en: `Everything you need — ${cap - total()} left`, vi: `Đủ hết — còn dư ${cap - total()}` } : { en: "You forgot something", vi: "Bạn quên mua thứ cần thiết" }, total()); };
    ui().onclick = e => {
      if (paid || !live(c)) return;
      const b = e.target.closest("[data-bi]"); if (b) { const id = b.dataset.bi; cart.has(id) ? cart.delete(id) : cart.add(id); E.sfx(cart.has(id) ? "pick" : "tap"); E.haptic("LIGHT"); return draw(); }
      if (e.target.closest("[data-pay]") && total() <= cap && cart.size) pay();
    };
    draw();
    // tự chơi: tham lam rẻ nhất cho mỗi nhu cầu
    E.autoRun(() => { for (const [t, n] of Object.entries(B.need || {})) B.list.filter(x => x.tags?.includes(t)).sort((a, b) => a.price - b.price).slice(0, n).forEach(x => cart.add(x.id)); pay(); });
  }));

  // ═════════ SORT — phân loại thẻ vào ngăn (hộp thư, bằng chứng liên quan / không, đồ giữ / bỏ…) ═════════
  // { sort: { prompt, bins: [{ id: "work", en, vi }], cards: [{ t: { en, vi }, bin: "work" }], ms: 0, need, ok, fail } }
  def("sort", c => new Promise(res => {
    const P = c.st.sort, cards = shuf(P.cards.filter(x => cond(x.if, c.s)), c.key()), need = P.need ?? Math.ceil(cards.length * 0.7);
    let k = 0, right = 0, streak = 0, busy = false;
    E.ui.hideBox();
    if (!cards.length) return done(res, c, P.empty || P.ok, "sort", P.empty ? "empty" : "ok");
    const draw = () => E.ui.panel(`<div class="lf-so"><div class="se-ask">${esc(nat(P.prompt || { en: "Sort them", vi: "Phân loại" }))} <small class="se-mute">${k + 1}/${cards.length}</small></div>
      <div class="lf-soc" data-card><p>${E.words(L(cards[k].t), E.L)}</p>${subHtml(cards[k].t)}</div>
      <div class="lf-sob" style="--n:${P.bins.length}">${P.bins.map(b => `<button data-bn="${esc(b.id)}"><b>${esc(L(b))}</b>${sub(b) ? `<small>${esc(sub(b))}</small>` : ""}</button>`).join("")}</div>
      ${streak >= 3 ? `<p class="lf-sync">${esc(nat({ en: "Streak", vi: "Chuỗi" }))} ×${streak}</p>` : ""}</div>`, "sort");
    const go = async id => {
      if (busy || !live(c) || FINISHING.has(res) || DONE.has(res)) return; busy = true;
      const ok = cards[k].bin === id; if (ok) { right++; streak++; } else streak = 0;
      const b = document.querySelector(`[data-bn="${id}"]`); b?.classList.add(ok ? "ok" : "no");
      E.sfx(ok ? "up" : "wrong"); E.haptic(ok ? "LIGHT" : "HEAVY"); if (!ok) { const r = document.querySelector(`[data-bn="${cards[k].bin}"]`); r?.classList.add("ok"); }
      await wait(ok ? 350 : 900); if (!live(c)) return res(); k++; busy = false;
      if (k >= cards.length) return finish(res, c, "sort", right >= need, { en: `${right}/${cards.length} sorted right`, vi: `Đúng ${right}/${cards.length}` }, right);
      draw();
    };
    ui().onclick = e => { const b = e.target.closest("[data-bn]"); if (b) go(b.dataset.bn); };
    draw();
    E.autoRun(async () => { while (live(c) && k < cards.length && !DONE.has(res)) await go(E.auto === "r" && Math.random() < 0.25 ? P.bins[0].id : cards[k].bin); });
  }));

  // ═════════ ROUTE — đi theo lời chỉ đường (trái / phải / thẳng) trên bản đồ ô phố ═════════
  // { route: { w: 5, h: 5, start: [0, 4], dir: "N", goal: [3, 1], marks: [{ at: [3, 1], en: "bank", vi: "ngân hàng" }], line: { en: "Go straight, then turn right at the café…", vi }, who, tries: 2, ok, fail } }
  // Nút: đi thẳng 1 ô · rẽ trái · rẽ phải · “Tới rồi”. Lời chỉ đường bằng tiếng đang học (có giọng đọc).
  def("route", c => new Promise(res => {
    const P = c.st.route, w = P.w || 5, h = P.h || 5, D = ["N", "E", "S", "W"], mv = { N: [0, -1], E: [1, 0], S: [0, 1], W: [-1, 0] };
    let pos = [...P.start], dir = D.indexOf(P.dir || "N"), path = [P.start.join(",")], tries = 0;
    E.ui.hideBox();
    const markAt = (x, y) => (P.marks || []).find(m => m.at[0] === x && m.at[1] === y);
    const draw = (msg = "") => E.ui.panel(`<div class="lf-ro"><div class="lf-cust">${P.who ? face(P.who) : ""}<div class="lf-bub"><span>${E.words(L(P.line), E.L)}</span>${subHtml(P.line)}</div>${P.who || P.line ? `<button class="se-ib sm" data-hear aria-label="listen">${E.ICON.spk}</button>` : ""}</div>
      <div class="lf-rog" style="--w:${w}">${Array.from({ length: w * h }, (_, i) => { const x = i % w, y = Math.floor(i / w), m = markAt(x, y), me = pos[0] === x && pos[1] === y; return `<i class="${path.includes(x + "," + y) ? "on" : ""}${me ? " me" : ""}">${me ? `<b style="transform:rotate(${dir * 90}deg)">▲</b>` : m ? `<small>${esc(L(m))}</small>` : ""}</i>`; }).join("")}</div>
      ${msg}<div class="lf-roc"><button class="se-btn" data-m="l">↰ ${esc(nat({ en: "Left", vi: "Trái" }))}</button><button class="se-btn" data-m="f">↑ ${esc(nat({ en: "Straight", vi: "Thẳng" }))}</button><button class="se-btn" data-m="r">${esc(nat({ en: "Right", vi: "Phải" }))} ↱</button></div>
      <div class="se-row"><button class="se-btn" data-m="x">${esc(nat({ en: "Start over", vi: "Đi lại" }))}</button><button class="se-btn pri" data-m="here">${esc(nat({ en: "I'm here", vi: "Tới rồi" }))}</button></div></div>`, "route");
    const reset = () => { pos = [...P.start]; dir = D.indexOf(P.dir || "N"); path = [P.start.join(",")]; };
    const here = () => {
      tries++;
      if (pos[0] === P.goal[0] && pos[1] === P.goal[1]) { E.sfx("solve"); burst(document.querySelector(".lf-rog .me"), "#6fcf97", 16); return finish(res, c, "route", true, { en: "You found it!", vi: "Tìm thấy rồi!" }); }
      E.sfx("wrong"); E.ui.fx("shake");
      if (P.tries && tries >= P.tries) return finish(res, c, "route", false, { en: "Lost", vi: "Lạc đường" });
      reset(); draw(`<div class="se-hint no">${esc(nat({ en: "This isn't the place. Listen again and start over.", vi: "Không phải chỗ này. Nghe lại rồi đi lại nhé." }))}</div>`);
    };
    // data-m ở đây là nút trong bảng — closest() dừng ở nút trước khi chạm khung gốc .se[data-m] (luôn kiểm trong .se-panel)
    ui().onclick = e => {
      if (e.target.closest("[data-hear]")) return E.say(L(P.line), P.who || "narr", { force: true, narr: !P.who });
      const b = e.target.closest(".se-panel [data-m]"); if (!b) return; const m = b.dataset.m;
      if (m === "l") dir = (dir + 3) % 4; else if (m === "r") dir = (dir + 1) % 4;
      else if (m === "f") { const [dx, dy] = mv[D[dir]], nx = pos[0] + dx, ny = pos[1] + dy; if (nx < 0 || ny < 0 || nx >= w || ny >= h) { E.sfx("wrong"); return; } pos = [nx, ny]; path.push(pos.join(",")); }
      else if (m === "x") reset(); else if (m === "here") return here();
      E.sfx("tap"); E.haptic("LIGHT"); draw();
    };
    draw(); if (!E.auto) E.say(L(P.line), P.who || "narr", { force: true, narr: !P.who });
    E.autoRun(() => { pos = [...P.goal]; here(); });
  }));

  // ═════════ SCRAMBLE — xếp lại chữ cái thành từ ═════════
  // { scramble: { words: [{ w: "harbour", hint: { vi: "bến cảng" } }], ms: 0, need, ok, fail } }
  def("scramble", c => new Promise(res => {
    const P = c.st.scramble, ws = P.words, need = P.need ?? ws.length;
    let k = 0, got = 0, line = [], tiles = [], busy = false;
    E.ui.hideBox();
    if (!ws.length) return done(res, c, P.empty || P.ok, "scramble", P.empty ? "empty" : "ok");
    const deal = () => { const w = ws[k].w.toUpperCase(); tiles = shuf(Array.from(w), c.key() + k); if (tiles.join("") === w) tiles.reverse(); line = []; };
    const draw = () => E.ui.panel(`<div class="lf-sc"><div class="se-ask">${esc(nat(P.prompt || { en: "Unscramble the word", vi: "Xếp lại thành từ" }))} <small class="se-mute">${k + 1}/${ws.length}</small></div>
      ${ws[k].hint ? `<p class="lf-cpt">${esc(nat(ws[k].hint))}</p>` : ""}
      <div class="lf-scl">${Array.from(ws[k].w).map((_, i) => `<i>${line[i] != null ? esc(tiles[line[i]]) : ""}</i>`).join("")}</div>
      <div class="lf-cpb">${tiles.map((t, i) => `<button class="lf-w${line.includes(i) ? " gone" : ""}" data-k="${i}" ${line.includes(i) ? "disabled" : ""}>${esc(t)}</button>`).join("")}</div>
      <div class="se-row"><button class="se-btn" data-back>${esc(nat({ en: "Undo", vi: "Xoá chữ" }))}</button><button class="se-btn" data-skip>${esc(nat({ en: "Skip", vi: "Bỏ qua" }))}</button></div></div>`, "scramble");
    const nextW = async ok => {
      if (busy || !live(c) || FINISHING.has(res) || DONE.has(res)) return; busy = true;
      if (ok) { got++; E.sfx("solve"); burst(document.querySelector(".lf-scl"), "#6fcf97", 14); if (!E.auto) E.say(ws[k].w, "narr", { force: true, narr: true }); } else E.sfx("down");
      await wait(ok ? 700 : 300); if (!live(c)) return res(); k++;
      if (k >= ws.length) return finish(res, c, "scramble", got >= need, { en: `${got}/${ws.length} words`, vi: `${got}/${ws.length} từ` }, got);
      busy = false; deal(); draw();
    };
    ui().onclick = e => {
      if (busy || !live(c) || FINISHING.has(res) || DONE.has(res)) return;
      const t = e.target.closest("[data-k]");
      if (t) { line.push(+t.dataset.k); E.sfx("pick"); draw(); if (line.length === tiles.length) { const g = line.map(i => tiles[i]).join(""); if (g === ws[k].w.toUpperCase()) return nextW(true); E.sfx("wrong"); E.ui.fx("shake"); E.haptic("HEAVY"); line = []; setTimeout(draw, 250); } return; }
      if (e.target.closest("[data-back]")) { line.pop(); return draw(); }
      if (e.target.closest("[data-skip]")) nextW(false);
    };
    deal(); draw();
    E.autoRun(async () => { while (live(c) && k < ws.length && !DONE.has(res)) await nextW(!(E.auto === "r" && Math.random() < 0.25)); });
  }));

  // ═════════ MATCH — nối 2 cột (từ ↔ nghĩa, người ↔ lời khai, câu hỏi ↔ câu trả lời) ═════════
  // { match: { prompt, pairs: [["pier", { vi: "cầu tàu" }], [{ en: "Who?" }, { en: "Tom." }]], slips: 2, ok, fail } }
  def("match", c => new Promise(res => {
    const P = c.st.match, n = P.pairs.length, lt = shuf(P.pairs.map((_, i) => i), c.key() + "l"), rt = shuf(P.pairs.map((_, i) => i), c.key() + "r");
    const got = new Set(); let sel = -1, miss = 0, flash = -1;
    // cả 2 cột hiện chữ tiếng đang học (học từ); nghĩa / bản dịch nhỏ bên dưới khi bật Dịch
    const lab = o => (typeof o === "string" ? esc(o) : `${esc(L(o))}${sub(o) ? `<small>${esc(sub(o))}</small>` : ""}`);
    E.ui.hideBox();
    const draw = () => E.ui.panel(`<div class="lf-ma"><div class="se-ask">${esc(nat(P.prompt || { en: "Match them up", vi: "Nối cho đúng" }))} <small class="se-mute">${got.size}/${n}</small></div>
      <div class="lf-mag"><div>${lt.map(i => `<button class="lf-w${got.has(i) ? " used" : ""}${sel === i ? " act" : ""}" data-l="${i}" ${got.has(i) ? "disabled" : ""}>${lab(P.pairs[i][0])}</button>`).join("")}</div>
      <div>${rt.map(i => `<button class="lf-w${got.has(i) ? " used" : ""}${flash === i ? " bad" : ""}" data-r="${i}" ${got.has(i) ? "disabled" : ""}>${lab(P.pairs[i][1])}</button>`).join("")}</div></div>
      ${P.slips != null ? `<p class="se-mute">${esc(nat({ en: "Mistakes", vi: "Lỗi" }))} ${miss}/${P.slips}</p>` : ""}</div>`, "match");
    ui().onclick = e => {
      const l = e.target.closest("[data-l]"); if (l) { sel = +l.dataset.l; flash = -1; E.sfx("tap"); return draw(); }
      const r = e.target.closest("[data-r]"); if (!r || sel < 0) return;
      const i = +r.dataset.r;
      if (i === sel) { got.add(i); sel = -1; E.sfx("up"); E.haptic("LIGHT"); draw(); burst(document.querySelector(`[data-r="${i}"]`), "#6fcf97", 8); if (got.size === n) finish(res, c, "match", true, { en: "All matched!", vi: "Nối đủ rồi!" }, miss); return; }
      miss++; flash = i; E.sfx("wrong"); E.haptic("HEAVY"); draw();
      if (P.slips != null && miss > P.slips) finish(res, c, "match", false, { en: "Too many mistakes", vi: "Sai nhiều quá" }, miss);
    };
    draw();
    E.autoRun(() => finish(res, c, "match", !(E.auto === "r" && Math.random() < 0.2), null, 0));
  }));

  // ═════════ DEFUSE — gỡ bom theo sổ hướng dẫn (đọc hiểu dưới áp lực thời gian) ═════════
  // { defuse: { ms: 40000, wires: ["red", "blue", "red", "yellow"], manual: [{ en: "If there is more than one red wire, cut the last red wire.", vi }], a: 2, ok, fail } }
  const WIRE = { red: "#d64545", blue: "#3d7be0", yellow: "#e8c33a", white: "#e8e4da", black: "#2a2a2a", green: "#3aa864" };
  const WNAME = { red: { en: "red", vi: "đỏ" }, blue: { en: "blue", vi: "xanh dương" }, yellow: { en: "yellow", vi: "vàng" }, white: { en: "white", vi: "trắng" }, black: { en: "black", vi: "đen" }, green: { en: "green", vi: "xanh lá" } };
  def("defuse", c => new Promise(res => {
    const P = c.st.defuse, ms = P.ms ?? 40000, t0 = performance.now(); let over = false, iv = 0;
    c.onCancel?.(() => { over = true; clearInterval(iv); DONE.add(res); res(); });
    E.ui.hideBox(); E.ui.urgent(true);
    E.ui.panel(`<div class="lf-df"><div class="lf-dfh"><b data-dt>${Math.ceil(ms / 1000)}</b><small>${esc(nat({ en: "seconds", vi: "giây" }))}</small></div>
      <div class="lf-dfw">${P.wires.map((w, i) => `<button data-wi="${i}" style="--wc:${WIRE[w] || w}" aria-label="${esc(L(WNAME[w] || { en: w }))}"><i></i><small>${i + 1}</small></button>`).join("")}</div>
      <div class="lf-dfm"><em>${esc(nat({ en: "Manual", vi: "Sổ hướng dẫn" }))}</em>${P.manual.map(m => `<p>${E.words(L(m), E.L)}</p>${subHtml(m)}`).join("")}</div></div>`, "defuse");
    const end = async ok => {
      if (over || !live(c)) return; over = true; clearInterval(iv); E.ui.urgent(false);
      if (ok) { E.sfx("solve"); E.haptic("MEDIUM"); } else { E.sfx("hit"); E.haptic("HEAVY"); E.ui.fx("redflash"); E.ui.fx("shake"); }
      finish(res, c, "defuse", ok, ok ? { en: "Defused!", vi: "Gỡ được rồi!" } : { en: "BOOM", vi: "BÙM" });
    };
    iv = setInterval(() => { const left = ms - (performance.now() - t0), d = document.querySelector("[data-dt]"); if (d) { d.textContent = Math.max(0, Math.ceil(left / 1000)); d.classList.toggle("low", left < 10000); } if (left <= 0) end(false); else if (left < 10000) E.sfx("tap"); }, 1000);
    ui().onclick = e => { const b = e.target.closest("[data-wi]"); if (!b || over) return; b.classList.add("cut"); end(+b.dataset.wi === P.a); };
    E.autoRun(() => end(!(E.auto === "r" && Math.random() < 0.25)));
  }));

  // ═════════ TUNE — dò sóng radio / bộ đàm: tới đúng tần số thì tiếng rè tan, nghe được tin nhắn ═════════
  // { tune: { at: 91.4, min: 87, max: 108, who, msg: { en, vi }, ms: 0, ok, fail } }
  def("tune", c => new Promise(res => {
    const P = c.st.tune, mn = P.min ?? 87, mx = P.max ?? 108, at = P.at, rnd = seed(c.key());
    let f = +(mn + (mx - mn) * (0.15 + rnd() * 0.2)).toFixed(1), over = false;
    const text = L(P.msg), noise = Array.from(text).map(() => rnd());
    E.ui.hideBox();
    const draw = () => {
      const d = Math.abs(f - at), clear = Math.max(0, 1 - d / 3), sig = Math.round(clear * 5);
      const shown = Array.from(text).map((ch, i) => (ch === " " || noise[i] < clear * 1.05 ? ch : "░")).join("");
      E.ui.panel(`<div class="lf-tu"><div class="se-ask">${esc(nat(P.prompt || { en: "Find the signal", vi: "Dò tìm sóng" }))}</div>
        <div class="lf-tuf"><b>${f.toFixed(1)}</b><small>MHz</small><span class="lf-tus">${Array.from({ length: 5 }, (_, i) => `<i class="${i < sig ? "on" : ""}" style="height:${6 + i * 4}px"></i>`).join("")}</span></div>
        <input type="range" min="${mn}" max="${mx}" step="0.1" value="${f}" data-r aria-label="MHz">
        <div class="lf-bub lf-tum${d < 0.25 ? " ok" : ""}"><span>${esc(shown)}</span>${d < 0.25 ? subHtml(P.msg) : ""}</div></div>`, "tune");
      const r = document.querySelector("[data-r]"); if (r) r.oninput = () => { f = +(+r.value).toFixed(1); const q = document.querySelector(".lf-tuf b"); draw(); if (Math.abs(f - at) < 0.25) lock(); else if (q) E.haptic(Math.abs(f - at) < 1 ? "MEDIUM" : "LIGHT"); };
    };
    const lock = async () => {
      if (over) return; over = true; E.sfx("solve"); E.haptic("HEAVY");
      if (!E.auto) await E.say(text, P.who || "narr", { force: true, narr: !P.who });
      await wait(900);
      finish(res, c, "tune", true, { en: "Signal found", vi: "Bắt được sóng" });
    };
    draw();
    E.autoRun(() => { f = at; lock(); });
  }));
  // ═════════ EVENT — sự kiện ngẫu nhiên (đời thường: đang làm thì có chuyện xảy ra) ═════════
  // story.events = { cafe: [{ id: "cat", w: 2, once: true, if, max, cool, then: [bước — cảnh truyện đầy đủ] }, …] } (chương cũng khai được)
  // Bước: { event: "cafe" } · { event: { pool: "cafe" | [danh sách tại chỗ], chance: 0.5, else: [bước] } }
  //   chance = xác suất có sự kiện · w = trọng số · once = chỉ 1 lần mỗi lượt chơi · max = tối đa N lần · cool = phải cách N lần gieo mới lặp lại
  //   if = điều kiện. Sự kiện chạy như cảnh thường rồi QUAY VỀ đúng chỗ cũ; trong sự kiện lại có { event } = sự kiện lồng nhau.
  //   Kết quả định trước theo hạt giống của lượt chơi (tải lại không đổi, chơi lượt mới thì khác). Cờ ev_<id> = số lần đã xảy ra.
  def("event", async c => {
    const V = typeof c.st.event === "string" ? { pool: c.st.event } : c.st.event, R = E.R();
    const inline = Array.isArray(V.pool), list = inline ? V.pool : E.S().events?.[V.pool] || [];
    const ev = (R.ev ||= { n: {}, last: {}, t: 0, seed: (Date.now() % 1e9) | 0 });
    const rnd = seed(ev.seed + ":" + c.key() + ":" + ev.t), t = ev.t++;
    const ok = (e, i) => { const id = e.id || i; return cond(e.if, c.s) && !(e.once && ev.n[id]) && !(e.max && (ev.n[id] || 0) >= e.max) && !(e.cool && ev.last[id] != null && t - ev.last[id] <= e.cool); };
    const elig = list.map((e, i) => [e, i]).filter(([e, i]) => ok(e, i));
    if (!elig.length || rnd() >= (V.chance ?? 1)) { if (V.else) c.push("event", "else"); return; }
    let r = rnd() * elig.reduce((a, [e]) => a + (e.w ?? 1), 0), pick = elig[0];
    for (const x of elig) { r -= x[0].w ?? 1; if (r <= 0) { pick = x; break; } }
    const [e, i] = pick, id = e.id || i;
    ev.n[id] = (ev.n[id] || 0) + 1; ev.last[id] = t; E.flag("ev_" + id, ev.n[id]);
    if (e.go) return E.jump(e.go);
    if (!e.then) return;
    if (inline) c.push("event", "pool", i, "then");
    else R.stack.push({ n: "@events", p: [V.pool, i, "then"], i: 0 });
  });

  // ═════════ GUESS — đoán từ kiểu Wordle (mật khẩu, tên bài hát, món cô ấy thích…) ═════════
  // { guess: { word: "VINYL", tries: 6, hint: { en, vi }, words: ["SOCKS", …] (gợi ý bàn phím không cần), ok, fail } }
  // Xanh = đúng chữ đúng chỗ · vàng = có chữ nhưng sai chỗ · xám = không có. Chỉ nhận đúng số chữ.
  def("guess", c => new Promise(res => {
    const G0 = c.st.guess, W = String(G0.word).toUpperCase(), n = W.length, max = G0.tries ?? 5, rows = []; let cur = "", over = false, shake = false, judging = false;
    const KB = ["QWERTYUIOP", "ASDFGHJKL", "ZXCVBNM"];
    E.ui.hideBox();
    const score = g => { const r = Array(n).fill("x"), left = {}; for (let i = 0; i < n; i++) if (g[i] === W[i]) r[i] = "g"; else left[W[i]] = (left[W[i]] || 0) + 1; for (let i = 0; i < n; i++) if (r[i] !== "g" && left[g[i]]) { r[i] = "y"; left[g[i]]--; } return r; };
    const keyState = ch => { let st = ""; for (const g of rows) { const sc = score(g); for (let i = 0; i < n; i++) if (g[i] === ch) { if (sc[i] === "g") return "g"; if (sc[i] === "y") st = "y"; else if (!st) st = "x"; } } return st; };
    const draw = (msg = "") => E.ui.panel(`<div class="lf-gs"><div class="se-ask">${esc(nat(G0.prompt || { en: `Guess the ${n}-letter word`, vi: `Đoán từ ${n} chữ cái` }))}</div>
      ${G0.hint ? `<p class="se-hint">${E.ICON.bulb}${esc(nat(G0.hint))}</p>` : ""}
      <p class="lf-gsl"><span><i class="g"></i>${esc(nat({ en: "right letter, right place", vi: "đúng chữ, đúng chỗ" }))}</span><span><i class="y"></i>${esc(nat({ en: "in the word, wrong place", vi: "có trong từ, sai chỗ" }))}</span><span><i class="x"></i>${esc(nat({ en: "not in the word", vi: "không có" }))}</span></p>
      <div class="lf-gsg${shake ? " bad" : ""}" style="--n:${n}">${Array.from({ length: Math.min(max, rows.length + 1) }, (_, r) => { const g = rows[r] || (r === rows.length ? cur.padEnd(n) : " ".repeat(n)), sc = rows[r] ? score(rows[r]) : null; return Array.from(g).map((ch, i) => `<i class="${sc ? sc[i] : ch.trim() ? "t" : ""}">${esc(ch.trim())}</i>`).join(""); }).join("")}</div>
      <small class="se-mute lf-gsn">${esc(nat({ en: `${max - rows.length} tries left`, vi: `Còn ${max - rows.length} lượt đoán` }))}</small>
      ${msg}<div class="lf-kb">${KB.map((row, ri) => `<div>${ri === 2 ? `<button data-k="⏎" class="wide">${esc(nat({ en: "Enter", vi: "Gửi" }))}</button>` : ""}${Array.from(row).map(ch => `<button data-k="${ch}" class="${keyState(ch)}">${ch}</button>`).join("")}${ri === 2 ? `<button data-k="⌫" class="wide" aria-label="delete">⌫</button>` : ""}</div>`).join("")}</div></div>`, "guess");
    const fin = async ok => { if (over || !live(c)) return; over = true; document.removeEventListener("keydown", kd); E.flag(G0.key || "guess_" + c.key(), ok ? rows.length : 0); if (!E.auto) E.say(W.toLowerCase(), "narr", { force: true, narr: true }); await verdict(ok, ok ? nat({ en: `${W} — in ${rows.length}!`, vi: `${W} — ${rows.length} lần!` }) : W); done(res, c, ok ? G0.ok : G0.fail, "guess", ok ? "ok" : "fail"); };
    const press = k => {
      if (over || judging || !live(c)) return;
      if (k === "⌫") { cur = cur.slice(0, -1); return draw(); }
      if (k === "⏎") {
        if (cur.length < n) { shake = true; E.sfx("wrong"); draw(`<div class="se-hint no">${esc(nat({ en: `Type ${n} letters.`, vi: `Gõ đủ ${n} chữ.` }))}</div>`); shake = false; return; }
        rows.push(cur); cur = ""; E.sfx(rows[rows.length - 1] === W ? "solve" : "page"); E.haptic("LIGHT"); draw();
        if (rows[rows.length - 1] === W) { judging = true; burst(document.querySelector(".lf-gsg"), "#6fcf97", 18); return setTimeout(() => fin(true), E.auto ? 0 : 700); }
        if (rows.length >= max) { judging = true; return setTimeout(() => fin(false), E.auto ? 0 : 500); }
        return;
      }
      if (cur.length < n && /^[A-Z]$/.test(k)) { cur += k; E.sfx("tap"); draw(); }
    };
    const kd = e => { const k = e.key === "Enter" ? "⏎" : e.key === "Backspace" ? "⌫" : e.key.length === 1 ? e.key.toUpperCase() : ""; if (k) { e.preventDefault(); press(k); } };
    document.addEventListener("keydown", kd);
    c.onCancel?.(() => { over = true; document.removeEventListener("keydown", kd); DONE.add(res); res(); });
    ui().onclick = e => { const b = e.target.closest("[data-k]"); if (b) press(b.dataset.k); };
    draw();
    E.autoRun(() => { if (E.auto === "r" && Math.random() < 0.25) { rows.push(...Array(max).fill("Z".repeat(n))); return fin(false); } rows.push(W); fin(true); });
  }));

  // ═════════ PACK — xếp đồ vào túi theo lời dặn (đọc hiểu) ═════════
  // { pack: { note: { en: "Bring something warm, something to read and snacks for two.", vi }, who, slots: 4,
  //     items: [{ id, en, vi, icon, pic, tags: ["warm"] }], need: { warm: 1, read: 1, snack: 2 }, ok, fail } }
  def("pack", c => new Promise(res => {
    const P = c.st.pack, slots = P.slots ?? 4, bag = [];
    let over = false;
    E.ui.hideBox();
    const it = id => P.items.find(x => x.id === id);
    const met = () => Object.entries(P.need || {}).every(([t, n]) => bag.filter(id => it(id).tags?.includes(t)).length >= n);
    const tile = x => x.pic ? `<i class="im-${esc(x.pic)}"></i>` : `<span class="lf-mi">${E.ICON[x.icon] || esc(tgt(x).charAt(0).toUpperCase())}</span>`;
    const draw = (msg = "") => E.ui.panel(`<div class="lf-pk">${P.who ? `<div class="lf-cust">${face(P.who)}<div class="lf-bub"><span>${E.words(tgt(P.note), E.L)}</span>${subHtml(P.note)}</div></div>` : `<div class="lf-cpt">${E.words(tgt(P.note), E.L)}${subHtml(P.note)}</div>`}
      <div class="lf-bag" data-bag>${Array.from({ length: slots }, (_, i) => bag[i] ? `<button data-out="${i}">${tile(it(bag[i]))}<b>${esc(tgt(it(bag[i])))}</b></button>` : `<i></i>`).join("")}<small>${bag.length}/${slots}</small></div>
      <div class="lf-menu">${P.items.filter(x => !bag.includes(x.id)).map(x => `<button data-mi="${esc(x.id)}">${tile(x)}<b>${esc(tgt(x))}</b>${sub(x) ? `<small>${esc(sub(x))}</small>` : ""}</button>`).join("")}</div>
      ${msg}<button class="se-btn pri wide${bag.length ? "" : " dim"}" data-go ${bag.length ? "" : "disabled"}>${esc(nat({ en: "Zip the bag", vi: "Kéo khoá túi" }))}</button></div>`, "pack");
    const add = id => { if (over || !live(c) || bag.includes(id)) return; if (bag.length >= slots) { E.sfx("wrong"); return draw(`<div class="se-hint no">${esc(nat({ en: "The bag is full — take something out.", vi: "Túi đầy rồi — bỏ bớt ra." }))}</div>`); } bag.push(id); E.sfx("pick"); E.haptic("LIGHT"); draw(); };
    const fin = async () => { if (over || !live(c)) return; over = true; const ok = met(); E.flag(P.key || "pack_" + c.key(), bag.join(",")); for (const id of bag) E.apply(it(id)); await verdict(ok, nat(ok ? { en: "Packed and ready!", vi: "Xếp xong, sẵn sàng!" } : { en: "You forgot something…", vi: "Hình như quên gì đó…" })); done(res, c, ok ? P.ok : P.fail, "pack", ok ? "ok" : "fail"); };
    ui().onpointerdown = E.dragger?.({ src: "[data-mi], [data-out]", dst: "[data-bag]", drop: (a, d) => { if (a.dataset.mi) { if (d) add(a.dataset.mi); return; } if (!d) { bag.splice(+a.dataset.out, 1); E.sfx("tap"); draw(); } } });
    ui().onclick = e => {
      if (over || !live(c)) return;
      if (E.dragged?.()) return;
      const m = e.target.closest("[data-mi]"); if (m) return add(m.dataset.mi);
      const o = e.target.closest("[data-out]"); if (o) { bag.splice(+o.dataset.out, 1); E.sfx("tap"); return draw(); }
      if (e.target.closest("[data-go]") && bag.length) fin();
    };
    draw(); if (P.who && !E.auto) E.say(tgt(P.note), P.who);
    E.autoRun(() => { for (const [t, n] of Object.entries(P.need || {})) P.items.filter(x => x.tags?.includes(t) && !bag.includes(x.id)).slice(0, n).forEach(x => bag.length < slots && bag.push(x.id)); fin(); });
  }));

  // ═════════ RHYTHM — nhảy / đánh trống theo nhịp (buổi hẹn nhạc sống, lễ hội, tập nhảy) ═════════
  // { rhythm: { prompt, bpm: 96, beats: 16, lanes: 3, need: 0.6, ok, fail } } — nốt rơi xuống, chạm làn đúng lúc nốt chạm vạch
  def("rhythm", c => new Promise(res => {
    const P = c.st.rhythm, bpm = P.bpm ?? 96, nb = P.beats ?? 16, lanes = P.lanes ?? 3, per = 60000 / bpm, fall = per * 3, rnd = seed(c.key());
    const notes = Array.from({ length: nb }, (_, i) => ({ t: per * (i + 2) + (rnd() < 0.2 ? per / 2 : 0), l: Math.floor(rnd() * lanes), hit: 0 }));
    let t0 = 0, raf = 0, over = false, good = 0, combo = 0, best = 0, beat = 0;
    c.onCancel?.(() => { over = true; cancelAnimationFrame(raf); DONE.add(res); res(); });
    E.ui.hideBox();
    E.ui.panel(`<div class="lf-rh"><div class="se-ask">${esc(nat(P.prompt || { en: "Feel the beat!", vi: "Bắt nhịp nào!" }))}</div>
      <div class="lf-rhs"><span>${esc(nat({ en: "Combo", vi: "Combo" }))} <b data-cb>0</b></span><span>${esc(nat({ en: "Hits", vi: "Trúng" }))} <b data-gd>0</b>/${nb}</span></div>
      <div class="lf-rhf" style="--l:${lanes}" data-f>${Array.from({ length: lanes }, (_, l) => `<div class="lf-rhl" data-l="${l}"></div>`).join("")}<i class="lf-rhline"></i></div>
      <div class="lf-rhb" style="--l:${lanes}">${Array.from({ length: lanes }, (_, l) => `<button data-lane="${l}" aria-label="lane ${l + 1}"></button>`).join("")}</div></div>`, "rhythm");
    const field = () => document.querySelector("[data-f]");
    const end = () => { if (over || !live(c)) return; over = true; cancelAnimationFrame(raf); const ok = good >= Math.ceil(nb * (P.need ?? 0.6)); E.flag(P.key || "rhythm_" + c.key(), good); finish(res, c, "rhythm", ok, ok ? { en: `Nailed it! Best combo ${best}`, vi: `Chuẩn nhịp! Combo cao nhất ${best}` } : { en: "Out of step…", vi: "Lệch nhịp rồi…" }, good); };
    const frame = now => {
      if (over || !live(c)) return; const t = now - t0, f = field(); if (!f) return;
      const h = f.clientHeight;
      f.querySelectorAll(".lf-note").forEach(n => n.remove());
      for (const n of notes) { if (n.hit) continue; const dt = n.t - t; if (dt < -180) { n.hit = -1; combo = 0; const cb = document.querySelector("[data-cb]"); if (cb) cb.textContent = 0; continue; } if (dt > fall) continue; const y = h * (1 - dt / fall) - 12; f.querySelector(`[data-l="${n.l}"]`)?.insertAdjacentHTML("beforeend", `<i class="lf-note" style="top:${y}px"></i>`); }
      const b = Math.floor(t / per); if (b !== beat) { beat = b; f.classList.remove("pulse"); void f.offsetWidth; f.classList.add("pulse"); }
      if (!notes.length || t > notes[notes.length - 1].t + 600) return end();
      raf = requestAnimationFrame(frame);
    };
    ui().onpointerdown = e => {
      const b = e.target.closest("[data-lane]"); if (!b || over) return; e.preventDefault();
      const l = +b.dataset.lane, t = performance.now() - t0, n = notes.find(x => !x.hit && x.l === l && Math.abs(x.t - t) < 160);
      b.classList.remove("hit", "miss"); void b.offsetWidth;
      if (n) { n.hit = 1; good++; combo++; best = Math.max(best, combo); b.classList.add("hit"); E.sfx("beat"); E.haptic("LIGHT"); if (combo % 5 === 0) floatTxt(b, "×" + combo, "#ffd166"); }
      else { combo = 0; b.classList.add("miss"); }
      const cb = document.querySelector("[data-cb]"), gd = document.querySelector("[data-gd]"); if (cb) cb.textContent = combo; if (gd) gd.textContent = good;
    };
    if (!E.auto) { t0 = performance.now(); raf = requestAnimationFrame(frame); }
    E.autoRun(() => { good = E.auto === "r" && Math.random() < 0.25 ? 0 : nb; best = good; end(); });
  }));

  // ═════════ HUD — tim / chỉ số / tiền luôn hiện (đời thường, hẹn hò…) ═════════
  // story.hud = ["coins", "charm", "smart", "mia"] (cả truyện) · bước { hud: [...] } đổi danh sách · { hud: false } tắt
  // Chip góc trên (dưới thanh công cụ): nhân vật = ♥ + tên · chỉ số = tên + số. Chạm → bảng “Chỉ số”: mọi story.stats (thanh theo max),
  // thiện cảm từng người đã gặp, tiền. Chỉ số trong story.stats có thể khai { en, vi, max: 10, icon: "<tên E.ICON>" }.
  const hudKeys = () => { const R = E.R(); const k = R && R.hud !== undefined ? R.hud : E.S()?.hud; return Array.isArray(k) ? k : []; };
  const isChar = k => E.S().chars?.[k] && !E.S().stats?.[k];
  const val = k => +E.R().f[k] || 0;
  let hudLast = {};
  // nút CHỈ SỐ tròn ngay dưới nút menu (người dùng 30/10: dải chip nhìn thô) — chỉ số đổi thì nút nảy + chấm báo; bấm = bảng chỉ số
  // icon chỉ số thường gặp (story.stats.<mã>.icon = tên) — thêm vào E.ICON nếu chưa có
  Object.assign(E.ICON, Object.fromEntries(Object.entries({
    coin: "<svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"M12 8v8M9.5 10.5c0-1 1-1.5 2.5-1.5s2.5.6 2.5 1.6c0 2.4-5 1.2-5 3.6 0 1 1 1.8 2.5 1.8s2.5-.6 2.5-1.5\"/></svg>",
    gym: "<svg viewBox=\"0 0 24 24\"><path d=\"M4 9v6M7 7v10M17 7v10M20 9v6M7 12h10\"/></svg>",
    star: "<svg viewBox=\"0 0 24 24\"><path d=\"M12 4l2.4 5 5.4.6-4 3.7 1.1 5.3L12 16l-4.9 2.6 1.1-5.3-4-3.7 5.4-.6z\"/></svg>",
    heart: "<svg viewBox=\"0 0 24 24\"><path d=\"M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z\"/></svg>",
    smile: "<svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"M9 14c1.5 1.5 4.5 1.5 6 0M9.5 10h.01M14.5 10h.01\"/></svg>",
  }).filter(([k]) => !E.ICON[k])));
  const IC_ME = `<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>`;
  const IC_STATS = `<svg viewBox="0 0 24 24"><path d="M5 20V11M12 20V5M19 20v-6"/></svg>`;
  const drawHud2 = () => {
    if (!E.R()) return;
    const keys = hudKeys(), host = document.querySelector(".se"); if (!host) return;
    let el = host.querySelector(".lf-hud");
    const on = keys.length || (E.S().profile && E.R().hud !== false && !(Array.isArray(E.R().hud) && !E.R().hud.length && E.R().hudOff));
    if (!on) { el?.remove(); return; }
    if (!el) { el = document.createElement("button"); el.className = "lf-hud"; el.setAttribute("aria-label", nat({ en: "Profile", vi: "Cá nhân" })); el.innerHTML = IC_ME + "<i></i>"; el.onclick = e => { e.stopPropagation(); el.classList.remove("new"); E.sfx("open"); openStats(); }; host.appendChild(el); }
    const changed = keys.some(k => hudLast[k] != null && hudLast[k] !== val(k));
    if (changed) { el.classList.add("new"); el.classList.remove("bump"); void el.offsetWidth; el.classList.add("bump"); }
    hudLast = Object.fromEntries(keys.map(k => [k, val(k)]));
  };
  const openStats = () => {
    const S = E.S(), R = E.R(), keys = hudKeys();
    const stats = [...new Set([...keys.filter(k => !isChar(k)), ...Object.keys(S.stats || {})])];
    const people = [...new Set([...keys.filter(isChar), ...Object.keys(S.chars || {}).filter(id => id !== "me" && R.met?.[id] && R.f[id] != null)])];
    const card = k => { const st = S.stats?.[k] || {}, v = val(k), max = st.max, ic = st.icon && E.ICON[st.icon] ? E.ICON[st.icon] : IC_STATS;
      return `<div class="lf-sc2"><span class="lf-sci">${ic}</span><div><small>${esc(statName(k))}</small><b>${v}${max ? `<em>/${max}</em>` : ""}</b>${max ? `<i><u style="width:${Math.max(0, Math.min(100, (v / max) * 100))}%"></u></i>` : ""}</div></div>`; };
    const person = id => { const v = val(id), max = S.chars[id].max || 10, h = Math.max(0, Math.min(5, Math.round((v / max) * 5)));
      return `<div class="lf-pp2">${face(id)}<b>${esc(cname(id))}</b><span class="lf-hearts" style="--c:${color(id)}">${"♥".repeat(h)}<s>${"♥".repeat(5 - h)}</s></span><em>${v}</em></div>`; };
    // story.profile = { role: { en, vi } | (s) => …, lines: [{ label: { en, vi }, value: { en, vi } | (s) => chữ | số, if }], bag: true }
    const P = S.profile || {}, st = E.state(), txt = v => (typeof v === "function" ? v(st) : v), show = v => { const x = txt(v); return x == null ? "" : typeof x === "object" ? nat(x) : String(x); };
    const lines = (P.lines || []).filter(l => cond(l.if, st)).map(l => `<div class="lf-pl"><span>${esc(show(l.label))}</span><b>${esc(show(l.value))}</b></div>`).join("");
    // TAB (người dùng 30/10): Tổng quan · Chỉ số · Tình cảm · Đồ đạc · Trang phục — tab nào không có gì thì ẩn;
    //   story.profile.tabs = [{ id, label: { en, vi }, html: (s) => chuỗi HTML }] thêm tab riêng của truyện
    const bagHtml = R.items.length ? `<div class="lf-bagl">${R.items.map(id => `<span>${E.itemArt(id, "sm")}<small>${esc(nat(S.items[id]?.name))}</small>${S.items[id]?.desc ? `<em>${esc(nat(S.items[id].desc))}</em>` : ""}</span>`).join("")}</div>` : "";
    const head = `<div class="lf-meh">${E.meImg() ? `<span class="lf-mepic"><i class="im-${esc(E.meImg())}"></i></span>` : face("me")}<div><b>${esc(E.G().set.name || nat({ en: "You", vi: "Bạn" }))}</b>${P.role ? `<small>${esc(show(P.role))}</small>` : ""}${curOutfit() && S.outfits?.[curOutfit()] ? `<small class="lf-wearing">${esc(nat({ en: "Wearing", vi: "Đang mặc" }))}: <b>${esc(nat(S.outfits[curOutfit()]))}</b></small>` : ""}</div></div>`;
    const T = [
      ["me", { en: "Overview", vi: "Tổng quan" }, () => head + (lines ? `<div class="lf-pls">${lines}</div>` : "") + (stats.length ? `<div class="lf-scg mini">${stats.slice(0, 4).map(card).join("")}</div>` : "")],
      ["stats", { en: "Stats", vi: "Chỉ số" }, () => stats.length ? `<div class="lf-scg">${stats.map(card).join("")}</div>` : ""],
      ["people", { en: "People", vi: "Tình cảm" }, () => people.map(person).join("")],
      ["bag", { en: "Items", vi: "Đồ đạc" }, () => P.bag !== false ? bagHtml : ""],
      ["wear", { en: "Outfits", vi: "Trang phục" }, () => P.wardrobe !== false && outfits().length > 1 ? (canWear() ? `<p class="se-mute">${esc(nat({ en: "Tap an outfit to wear it.", vi: "Chạm 1 bộ để mặc." }))}</p>` : `<p class="se-hint lf-wlock">${E.ICON.lock}${esc(lockWhy())}</p>`) + `<div class="${canWear() ? "" : "lf-wdoff"}">${wardHtml(outfits(), curOutfit())}</div>` : ""],
      ...(P.tabs || []).filter(t => cond(t.if, st)).map(t => [t.id, t.label, () => t.html(st)]),
    ].map(([id, label, fn]) => [id, label, fn()]).filter(([id, , html]) => id === "me" || html);
    let tab = openStats.tab && T.some(t => t[0] === openStats.tab) ? openStats.tab : "me";
    const body = () => `<div class="lf-pt">${T.length > 1 ? `<div class="lf-ptabs">${T.map(([id, label]) => `<button data-pt="${id}" class="${id === tab ? "on" : ""}">${esc(nat(label))}</button>`).join("")}</div>` : ""}<div class="lf-sts">${T.find(t => t[0] === tab)[2]}</div></div>`;
    const sh = E.ui.sheet(nat({ en: "Profile", vi: "Cá nhân" }), body(), "tall");
    const showTab = () => sh.querySelector(".lf-ptabs .on")?.scrollIntoView({ inline: "center", block: "nearest" }); showTab();
    sh.onclick = e => {
      if (e.target.closest("[data-x]")) return E.ui.closeSheet();
      const t = e.target.closest("[data-pt]"); if (t) { openStats.tab = tab = t.dataset.pt; E.sfx("page"); sh.querySelector(".se-shb").innerHTML = body(); showTab(); return; }
      const b = e.target.closest("[data-wear]"); if (b && !canWear()) { E.sfx("wrong"); return; }
      if (b) { wear(b.dataset.wear); E.sfx("pick"); E.haptic("LIGHT"); openStats.tab = "wear"; openStats(); }
    };
  };
  E.ui.stats = openStats;

  // ═════════ TRANG PHỤC — nhân vật chính mặc gì (ảnh đổi theo) ═════════
  // story.outfits = { casual: { en, vi, img: "me-casual", tags: ["casual"], if }, suit: { … } } · story.me.outfit = bộ mặc lúc đầu
  // Bước { wear: "suit" } = mặc ngay · { wardrobe: { prompt, opts: [mã…], want: ["formal"], score: "mia", match, miss, then } } = tự chọn (có chấm hợp dịp)
  // Bảng Cá nhân có nút “Thay đồ” khi story.profile.wardrobe !== false và có ≥ 2 bộ mở khoá. Cờ outfit = mã bộ đang mặc (dùng trong if).
  const outfits = () => Object.entries(E.S().outfits || {}).filter(([, o]) => cond(o.if, E.state()));
  const curOutfit = () => E.R()?.f.outfit || E.S().me?.outfit || outfits()[0]?.[0];
  E.meImg = () => E.S().outfits?.[curOutfit()]?.img || E.S().me?.img;
  // được thay đồ trong bảng Cá nhân không: không khoá (R.wearLock) + profile.wardrobe (true / điều kiện / hàm) cho phép
  const canWear = () => !E.R()?.wearLock && cond(E.S().profile?.wardrobe ?? true, E.state());
  const lockWhy = () => { const w = E.R()?.wearLock; return w && typeof w === "object" ? nat(w) : nat({ en: "You've already picked today's outfit.", vi: "Hôm nay đã chọn đồ rồi." }); };
  def("wearLock", async ({ st }) => { E.R().wearLock = st.wearLock === false ? null : st.wearLock === true ? 1 : st.wearLock; });
  // sang mốc mới (ngày / chương) = mở khoá thay đồ
  E.on("step", type => { if (type === "cp" && E.R()?.wearLock) E.R().wearLock = null; });
  const wear = id => { if (!E.S().outfits?.[id]) return; E.flag("outfit", id); drawHud2(); };
  def("wear", async ({ st }) => { wear(st.wear); if (!st.quiet && !E.auto) E.ui.toast(`${E.ICON.box}<span><small>${esc(nat({ en: "Now wearing", vi: "Đang mặc" }))}</small>${esc(nat(E.S().outfits[st.wear] || {}))}</span>`, 1800); });
  const wardHtml = (list, sel) => `<div class="lf-wd">${list.map(([id, o]) => `<button class="lf-wdi${id === sel ? " on" : ""}" data-wear="${esc(id)}">${o.img ? `<i class="im-${esc(o.img)}"></i>` : `<span class="lf-mi">${E.ICON.box}</span>`}<b>${esc(nat(o))}</b>${id === curOutfit() ? `<small>${esc(nat({ en: "Wearing", vi: "Đang mặc" }))}</small>` : ""}</button>`).join("")}</div>`;
  def("wardrobe", c => new Promise(res => {
    const W = c.st.wardrobe, list = outfits().filter(([id]) => !W.opts || W.opts.includes(id));
    if (!list.length) return done(res, c, W.empty, "wardrobe", "empty");
    let sel = list.some(([id]) => id === curOutfit()) ? curOutfit() : list[0][0];
    E.ui.hideBox();
    const draw = () => E.ui.panel(`<div class="lf-wdp"><div class="se-ask">${esc(nat(W.prompt || { en: "What will you wear?", vi: "Bạn mặc gì?" }))}</div>
      <div class="lf-wdv">${E.S().outfits?.[sel]?.img ? `<i class="im-${esc(E.S().outfits[sel].img)}"></i>` : face("me")}</div>
      ${wardHtml(list, sel)}<button class="se-btn pri wide" data-ok>${esc(nat({ en: "Wear this", vi: "Mặc bộ này" }))}</button></div>`, "wardrobe");
    ui().onclick = e => {
      const b = e.target.closest("[data-wear]"); if (b) { sel = b.dataset.wear; E.sfx("pick"); E.haptic("LIGHT"); return draw(); }
      if (e.target.closest("[data-ok]")) go(sel);
    };
    const go = async id => {
      if (DONE.has(res) || !live(c) || !list.some(([key]) => key === id)) return;
      wear(id); const o = E.S().outfits[id] || {};
      // đồ chọn cho dịp này = đồ hôm nay: khoá thay trong bảng Cá nhân tới mốc kế tiếp (lock: false để không khoá)
      if (W.lock !== false) E.R().wearLock = W.lockWhy || 1;
      let k = "then";
      if (W.want) { const hit = (o.tags || []).some(t => W.want.includes(t)); if (W.score) E.add(W.score, hit ? 1 : -1); k = hit ? "match" : "miss"; }
      done(res, c, W[k], "wardrobe", k);
    };
    draw();
    E.autoRun(() => go(pickAuto(list)?.[0] || sel));
  }));
  def("hud", async ({ st }) => { const R = E.R(); R.hud = st.hud === false ? [] : [].concat(st.hud); R.hudOff = st.hud === false; drawHud2(); });
  E.on("step", () => drawHud2());
  const flag0 = E.flag; E.flag = (k, v) => { const r = flag0(k, v); try { if (hudKeys().includes(k)) setTimeout(drawHud2, 0); } catch {} return r; };

  // ═════════ CẢM GIÁC GAME dùng chung (mọi màn, mọi truyện) ═════════
  // 1) chỉ số người chơi thấy được đổi (story.stats · thanh meter) → chip nổi giữa trên “Mia ♥ +2” / “Can đảm +1”
  //    (gộp các lần đổi cùng lúc; tự chơi thì bỏ). Biến nội bộ (puzzles, fillN…) không hiện.
  // thiện cảm nhân vật đã có thông báo “… sẽ nhớ điều này” của core → không hiện chip trùng (trừ khi có thanh meter riêng)
  const visible = k => E.S()?.stats?.[k] || E.R()?.meters?.[k];
  let chipQ = {}, chipT = 0;
  const flushChips = () => {
    const host = document.querySelector(".se"); if (!host) { chipQ = {}; return; }
    const box = host.querySelector(".fx-chips") || host.appendChild(Object.assign(document.createElement("div"), { className: "fx-chips" }));
    for (const [k, v] of Object.entries(chipQ)) {
      if (!v) continue;
      const ch = E.S().chars?.[k] && !E.S().stats?.[k], el = document.createElement("b");
      el.className = "fx-chip " + (v > 0 ? "up" : "down"); el.textContent = `${ch ? cname(k) + " ♥" : statName(k)} ${v > 0 ? "+" : "−"}${Math.abs(v)}`;
      box.appendChild(el); setTimeout(() => el.remove(), 2300);
    }
    chipQ = {};
  };
  const add0 = E.add;
  E.add = (k, n) => { const r = add0(k, n); try { if (!E.auto && +n && visible(k)) { chipQ[k] = (chipQ[k] || 0) + +n; clearTimeout(chipT); chipT = setTimeout(flushChips, 140); } } catch {} try { if (hudKeys().includes(k)) setTimeout(drawHud2, 0); } catch {} return r; };
  // 2) nhấn mọi nút trong game: rung nhẹ (nút lún xuống ở ui.css)
  document.addEventListener("pointerdown", e => { const b = e.target.closest?.(".se button"); if (b && !b.disabled && !E.auto) E.haptic("LIGHT"); }, true);
})();
// Enmi Story Engine 3 — SÂN KHẤU (nạp sau mech-plus.js). Lời dẫn luôn “nhìn vào” một thứ; vật phẩm hiện ra tận mắt.
// Đặc tả: docs/story-engine/MECHANICS.md mục “Engine 3”. Tóm tắt:
//   VÙNG ẢNH   StoryEngine.regions({ "<ảnh>": { size: [w, h], r: { sign: [x, y, w, h] | { box, shape, fx, label, maxScale } } } })
//              (sinh tự động từ art.json → regions.js bởi art-css.js; truyện cũng ghi tay được ở scenes.<cảnh>.regions)
//              x, y, w, h = % của ẢNH (không phải màn hình) → luôn khớp vật trên ảnh dù màn hình dài / ngắn.
//              maxScale: trần zoom riêng cho look vào vùng này, 1…6; mặc định 3.2, không đổi cảnh rộng.
//   look       { look: "sign" } máy quay trượt + phóng tới vùng của ảnh đang hiện · { look: null } lùi ra · gắn vào bất kỳ bước nào: { n: {…}, look: "posts" }
//   scene      khoá phụ { n: {…}, scene: "yard" } đổi địa điểm thật; giữ diễn viên native, dọn đạo cụ cũ, cập nhật tên/giờ
//   shot       { shot: "act-ring" } khung hình cho lời dẫn (toàn màn, chuyển nhanh, trôi nhẹ) · { shot: null } về cảnh · cũng là khoá phụ
//   prop       đạo cụ chuyển động trên ảnh: { prop: { id: "car", art: "it-car", at: [x, y, w], to: [x, y], ms: 1600, rot, fade, wait } } · { prop: { id: "car", off: true } }
//   motion     metadata của n/think/say hoặc bước riêng: { id, ms, tracks, actors, backdrop } · Skip/Replay chỉ hình · lưu khung cuối
//   item       nhận đồ = vật HIỆN RA giữa màn (từ đúng chỗ nó nằm nếu vừa chạm vùng), lật mặt sau (items.<mã>.sides), đọc (items.<mã>.doc) → bay vào túi
//   read       { read: "note" } (đọc giấy tờ của đồ vật) · { read: { paper, hand, title, lines: [{ en, vi, s }] } } · docs.<mã> dùng chung
//   slow       khoá phụ cho lựa chọn: { choice: […], timer: 6, slow: true } — chậm lại kiểu Detroit (màu nhạt, viền tối, tiếng tim)
//   Nhân vật: thở nhẹ khi đứng · chớp mắt nếu có ảnh im-<mã>[-<mặt>]-blink · đổi biểu cảm mờ chéo.
//   Chưa có ảnh: ?art=wire (hoặc Cài đặt dev) → khung dây hiện tên ảnh + các vùng — soát bố cục trước khi vẽ.
(() => {
  const E = globalThis.StoryEngine, def = E.def, esc = E.esc, h = E.h;
  const nat = t => E.nat(t);
  const investigationText = t => E.ui.investigationText?.(t) ?? esc(nat(t));
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const root = () => $(".se");
  const Q = new URLSearchParams(location.search);
  E.wire = Q.get("art") === "wire";
  const cond = (c, s) => (c == null ? true : typeof c === "function" ? !!c(s) : typeof c === "string" ? s.truth(c) || s.has(c) || !!s.f[c] : typeof c === "object" && !Array.isArray(c) ? Object.entries(c).every(([k, v]) => (+s.f[k] || 0) >= v) : !!c);
  E.cond = cond;
  const T = (en, vi) => nat({ en, vi });

  // ═════════ VÙNG ẢNH ═════════
  const REG = {};
  E.regions = o => { for (const k in o) { const a = REG[k] || {}; REG[k] = { ...a, ...o[k], r: { ...(a.r || {}), ...(o[k].r || {}) } }; } };
  E.regionsAll = REG;
  const normR = a => (!a ? null : Array.isArray(a) ? { box: a } : a.box ? a : null);
  // vùng của 1 ảnh: regions.js → scenes.<ảnh>.regions → views của địa điểm (khai báo tại chỗ)
  E.regionOf = (img, name) => {
    if (Array.isArray(name)) return { box: name };
    if (name && typeof name === "object") return normR(name);
    return normR(REG[img]?.r?.[name] ?? E.S()?.scenes?.[img]?.regions?.[name] ?? LOCAL[img]?.[name]);
  };
  const LOCAL = {}; // vùng khai báo trong view của place (regions: {…}) → đăng ký khi vẽ view
  E.regionsOf = img => ({ ...(E.S()?.scenes?.[img]?.regions || {}), ...(LOCAL[img] || {}), ...(REG[img]?.r || {}) });
  const naturalSizes = new Map(), imageLoads = new Map();
  let visualTransition = null, resetCamera = null;
  E.imgSize = img => naturalSizes.get(img) || REG[img]?.size || E.S()?.scenes?.[img]?.size || [576, 1024];
  E.curImg = () => (E.ui.bgKey?.() || "").slice(2);
  // One physical image plane is shared by the bitmap, effects, actors and hit regions.
  // Percentages always refer to that plane, including cover crops and resized stages.
  const actionFor = img => root()?.classList.contains("action-framed") && E.R()?.actionFrame && img === E.curImg() ? E.R().actionFrame : null;
  E.fit = (img = E.curImg()) => actionFor(img) ? "contain" : REG[img]?.fit || E.S()?.scenes?.[img]?.fit || E.S()?.fit || "contain";
  E.coverBox = img => {
    const st = $(".se-stage"); if (!st) return { x: 0, y: 0, w: 1, h: 1 };
    if (actionFor(img)) return actionPlane(img, st);
    const W = st.clientWidth, H = st.clientHeight, [iw, ih] = E.imgSize(img), sc = (E.fit(img) === "cover" ? Math.max : Math.min)(W / iw, H / ih);
    const f = E._frame && E._frame.img === img ? E._frame : { dx: 0, dy: 0 };
    return { x: (W - iw * sc) / 2 + f.dx, y: (H - ih * sc) / 2 + f.dy, w: iw * sc, h: ih * sc };
  };
  E.syncImagePlanes = layer => {
    const layers = layer ? [layer] : $$(".se-bgl[data-image]");
    for (const L of layers) {
      // Hold the outgoing image's own framing while the new view is prepared.
      if (visualTransition?.outgoing === L) continue;
      const img = L.dataset.image; if (!img) continue;
      const b = E.coverBox(img), fit = E.fit(img), [iw, ih] = E.imgSize(img);
      if(b.action){
        L.dataset.actionFrame="true";
        const a=b.action.area,left=Math.max(0,a.left-b.x),right=Math.min(b.w,a.right-b.x),top=Math.max(0,a.top-b.y),bottom=Math.min(b.h,a.bottom-b.y);
        for(const[k,v]of Object.entries({l:left,r:right,t:top,b:bottom,fx:Math.min(8,Math.max(1,(right-left)/12)),fy:Math.min(8,Math.max(1,(bottom-top)/12))}))L.style.setProperty("--af-"+k,v+"px");
      }else delete L.dataset.actionFrame;
      L.style.setProperty("--ar", String(iw / ih)); L.dataset.fit = fit;
      L.style.setProperty("--image-x", b.x + "px"); L.style.setProperty("--image-y", b.y + "px");
      L.style.setProperty("--image-w", b.w + "px"); L.style.setProperty("--image-h", b.h + "px");
      for (const el of L.querySelectorAll(":scope > .ii, .vbx")) {
        Object.assign(el.style, { left: b.x + "px", top: b.y + "px", right: "auto", bottom: "auto", width: b.w + "px", height: b.h + "px", margin: "0", transform: "none" });
        if (el.classList.contains("ii")) { el.style.backgroundSize = "100% 100%"; el.style.backgroundPosition = "center"; }
      }
      const ii = L.querySelector(":scope > .ii[class*='im-']"), bd = L.querySelector(":scope > .bd");
