  const popupDraw=()=>{
   const host=shell.querySelector('.cb4-popover');host.hidden=!popup;shell.querySelector('[data-hint]').setAttribute('aria-expanded',String(popup==='hint'));if(!popup){host.innerHTML='';return;}
