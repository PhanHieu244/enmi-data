  E.vbox = (img, inner = "", cls = "") => { const [w, hh] = E.imgSize(img); return `<div class="vbw ${cls}"><div class="vbx" style="--ar:${(w / hh).toFixed(4)}">${inner}</div></div>`; };
  const pct = b => `left:${b[0]}%;top:${b[1]}%;width:${b[2]}%;height:${b[3]}%`;
