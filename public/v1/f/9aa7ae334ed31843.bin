      else if (ii && !bd) L.insertAdjacentHTML("afterbegin", `<div class="bd ${ii.className.replace(/\bii\b/, "").trim()}"></div>`);
      for (const sprite of L.querySelectorAll(".pp.full .pp-i > .ii")) E.fitSprite?.(sprite);
    }
  };
  E._layerHook = (L, key) => {
