          });
        }
        const layer = $(".se-bgl.on");
        for (const t of tracks) { if (t.remove) { t.el?.remove(); propEl(layer, t.id)?.remove(); delete (R.props || {})[t.id]; } else { (R.props ||= {})[t.id] = { ...t.final }; t.el = renderProp(t.id, t.final, layer, img); } }
