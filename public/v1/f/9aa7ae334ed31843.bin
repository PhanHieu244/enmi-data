        if (index !== t.frameIndex) {
          const frame = t.frames[index]; propArt(t.el, frame.art, index > 0);
          t.el.style.aspectRatio = String(frame.ar); t.el.style.zIndex = String(frame.z);
          t.frameIndex = index;
        }
      }
