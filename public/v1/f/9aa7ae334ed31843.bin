  ];

  function install() {
    if (!enabled()) return;
    const S = E.S();
    S.visualContinuity = true;
    for (const [node, path, who, show, clearInspection] of entrances) {
      const st = at(S, node, path);
      if (!st || !(st.n || st.say || st.think)) continue;
      st.valePresence = { ...(st.valePresence || {}), show };
      // A companion answers while a detail inspection is suspended. The
      // native explore handler retains xpDetail and restores it on return.
      if (clearInspection) { st.look = null; st.actionFrame = null; }
      if (who && st.n) st.on = who;
      // Motion side-effects run before the later presence side. Opt in only
      // these explicitly authored entrances so an existing expression cue can
      // act on the same actor from its first frame.
      for (const a of st.motion?.actors || []) {
        if (show.some(x => x.id === a.id) && !a.hide) a.show = true;
      }
    }
    for (const [node, path, who] of focus) {
      const st = at(S, node, path); if (st?.n) st.on = who;
    }
    // The gate action is over before Reed comments; the return walk really
    // moves back onto the moor. Keeping the shot here hid every later speaker.
    const gateReply = at(S, 'p3c2_open', [26]);
    if (gateReply) {
      delete gateReply.shot;
      gateReply.scene = 'p3_dorn_gate_closed'; gateReply.look = null;
      gateReply.valePresence = { ...gateReply.valePresence, hide: ['dorn'] };
    }
    const returnWalk = at(S, 'p3c2_open', [28]);
    if (returnWalk) { delete returnWalk.shot; returnWalk.scene = 'p3_moor'; returnWalk.look = null; }
  }

  E.side('valePresence', async p => {
    if (!enabled() || !p) return;
    const a = context();
    for (const id of p.hide || []) E.ui.hide(id);
    for (const c of p.show || []) {
      if (!a?.present.includes(c.id) || a.remote?.[c.id] || !E.S().chars[c.id]) continue;
      const old = E.R().cast?.[c.id];
      E.ui.show(c.id, old?.at || c.at || 'l', c.face === undefined ? old?.face || '' : c.face);
    }
  });

  function restoreFocus() {
    const root = q('.se');
    if (root && enabled()) { root.dataset.stage = E.S().stage || 'focus'; root.classList.remove('v9-narration'); }
  }
  let layoutFrame = 0;
  function frameNarration() {
    cancelAnimationFrame(layoutFrame);
    layoutFrame = requestAnimationFrame(() => {
      const root = q('.se'), box = q('.se-box');
      if (!root?.classList.contains('v9-narration') || !box || box.hidden) return;
      const rr = root.getBoundingClientRect();
      const bars = [q('.se-top'), q('.v8-contextbar')].filter(el => el && !el.hidden && getComputedStyle(el).display !== 'none');
      const top = Math.max(0, ...bars.map(el => el.getBoundingClientRect().bottom - rr.top)) + 8;
      root.style.setProperty('--v9-cast-top', top + 'px');
      // The dialogue's entrance translates its paint box for a few frames.
      // Use its stable layout top so the final text cannot cover the portrait.
      const boxTop = box.offsetParent === root ? box.offsetTop : box.getBoundingClientRect().top - rr.top;
      const bottom = Math.max(0, root.clientHeight - boxTop) + 6;
      root.style.setProperty('--v9-cast-bottom', bottom + 'px');
      const a = context(), ids = new Set((a?.present || []).filter(id => !a.remote?.[id]));
      const cast = [...root.querySelectorAll('.se-ch')].filter(el => E.R().cast?.[el.dataset.id] && ids.has(el.dataset.id) && !el.classList.contains('out'));
      const slots = {1:[50],2:[28,72],3:[18,50,82],4:[12,38,62,88]}[Math.min(4,cast.length)] || [];
      cast.forEach((el,i) => { el.style.setProperty('--v9-left',(slots[i] ?? 50)+'%'); el.style.setProperty('--v9-width',(cast.length<2?90:cast.length===2?54:cast.length===3?36:25)+'%'); });
    });
  }
  const originalLine = E.ui.line;
  E.ui.line = line => {
    if (enabled()) {
      const R = E.R(), a = context(), root = q('.se');
      const present = new Set((a?.present || []).filter(id => !a?.remote?.[id]));
      // Place exploration clears native sprites, including a companion who
      // may speak inside a named topic. The talk handler also hides its owner
      // before the farewell branch. Restore only an explicitly present live
      // conversation speaker, never a quoted/remote voice or baked action.
      const who = line.who;
      if ((line.kind || 'say') === 'say' && who && who !== 'me' &&
          a?.conversationWith && present.has(who) && E.S().chars[who] &&
          !R.shot && !R.cg && !R.actionFrame &&
          (!R.cast?.[who] || !root?.querySelector('.se-ch[data-id="' + CSS.escape(who) + '"]'))) {
        const active = V.active;
        const step = active ? E.walk({n: active.n, p: JSON.parse(active.p)})?.[active.i] : null;
        E.ui.show(who, R.cast?.[who]?.at || (who === a.conversationWith ? 'c' : 'l'), step?.face || R.cast?.[who]?.face || '');
      }
      for (const el of root?.querySelectorAll('.se-ch') || []) {
        el.classList.toggle('v9-out-of-scene', !!a && !present.has(el.dataset.id));
      }
      const wide = !R.shot && !R.cg && !R.look && !R.actionFrame && !R.vw;
      const ensemble = a && wide && !line.on && /^(n|think)$/.test(line.kind) &&
        Object.keys(R.cast || {}).some(id => present.has(id));
      if (root) {
        root.dataset.stage = ensemble ? 'ensemble' : E.S().stage || 'focus';
        root.classList.toggle('v9-narration', !!a && wide && /^(n|think)$/.test(line.kind) && Object.keys(R.cast || {}).some(id => present.has(id)));
      }
    }
    const pending = originalLine(line); frameNarration(); return pending;
  };

  E.on('boot', () => {
    if (!enabled()) return;
    const style = document.createElement('style');
    style.dataset.valeContinuity = 'v09';
    style.textContent = `
      .se.vd .se-ch.v9-out-of-scene{visibility:hidden!important;pointer-events:none!important}
      .se.vd.v9-narration .se-chars{top:var(--v9-cast-top,140px);bottom:var(--v9-cast-bottom,250px)}
      .se.vd.v9-narration .se-chars .se-ch{height:100%;bottom:0;transform:translateX(-50%)!important;transform-origin:50% 100%}
      .se.vd.v9-narration[data-stage="ensemble"] .se-chars .se-ch{left:var(--v9-left,50%)!important;width:var(--v9-width,70%)!important;max-width:none;filter:brightness(.94) saturate(.98)}
      @media(max-height:660px) and (max-aspect-ratio:1/1){
        .se.vd.v9-narration .se-box{max-height:min(50dvh,calc(100dvh - var(--v9-cast-top,140px) - 176px))}
      }`;
    document.head.append(style);
    const resize = new ResizeObserver(frameNarration);
    for (const el of [q('.se'), q('.se-box'), q('.se-top'), q('.v8-contextbar')]) if (el) resize.observe(el);
    install(); queueMicrotask(install);
  });
  E.on('chapter', () => { install(); queueMicrotask(install); });
  E.on('step', type => { if (!/^(n|think)$/.test(type)) restoreFocus(); });
  E.on('end', restoreFocus);
  const reset = E.ui.reset;
  E.ui.reset = (...args) => { restoreFocus(); return reset(...args); };
  V.v9Continuity = () => ({ enabled: enabled(), stage: q('.se')?.dataset.stage,
    context: context(), authoredAnchors: entrances.length + focus.length });
})();
/* Vale 0.9.1 · authored Part I actions.
 * Presentation metadata only: no new spoken line, branch, item or array index.
 * Poses are matched derivatives of Reed's original full-body reference.
 */
(() => {
  'use strict';
  const E = StoryEngine, V = ValeDemo;
  const enabled = () => ['vale-dossiers-p1c1-v01', 'vale-dossiers-chapter1-demo03'].includes(E.S()?.id);
  const at = (node, path) => path.reduce((value, key) => value?.[key], E.S().nodes?.[node]);
  const patch = (node, path, values) => {
    const step = at(node, path);
    if (step) Object.assign(step, values);
    return step;
  };
  const notebook = 'p1-v091-reed-notebook', visitor = 'p1-v091-masked-exit';
  const celiaStep = 'p1-v091-celia-step', passenger = 'p1-v091-cab-passenger';
  const vestryActors = ['p1-v091-vestry-reed', 'p1-v091-vestry-celia', 'p1-v091-vestry-hart'];
  const noteFrame = () => ({ focus: 'p1-v091-notebook-focus', context: 'p1-v091-notebook-context', zoom: 1.25 });
  const doorFrame = () => ({ focus: 'p1-v091-door-focus', context: 'p1-v091-door-context', zoom: 1.25 });
  const studyImage = () => ['study', 'study_clear', 'study_by_lamp'].includes(E.R()?.scene) ? E.R().scene : 'study_clear';
  const noteTrack = (frames, at = [50, 52]) => ({ id: notebook, art: frames[0].art, at, w: 62, ar: 2 / 3, z: 3, frames });
  function removeOn(step, ids) {
    if (!step) return;
    step.valePhysical = { ...step.valePhysical,
      remove: [...new Set([...(step.valePhysical?.remove || []), ...ids])] };
  }
  function returnAt(node, path, ids = [notebook]) {
    const step = patch(node, path, { shot: null, look: null, actionFrame: null });
    removeOn(step, ids);
  }
  function stageNotebook(node, path, motion, scene = studyImage) {
    const step = patch(node, path, { look: null, on: 'reed', actionFrame: noteFrame(), motion });
    if (!step) return;
    // Use the actual room's letter state. A held letter must not reappear on
    // the desk just because this is a close view of Reed's notebook.
    Object.defineProperty(step, 'shot', { configurable: true, enumerable: true, get: scene });
    step.valePresence = { ...step.valePresence, show: [{ id: 'reed', at: 'l' }] };
    removeOn(step, [visitor]);
  }
  function install() {
    if (!enabled()) return;
    E.regions(Object.fromEntries(['study', 'study_clear', 'study_by_lamp'].map(image => [image, {
      size: [941, 1672], r: {
        'p1-v091-notebook-context': [20, 23, 60, 42],
        'p1-v091-notebook-focus': [32, 34, 36, 24]
      }
    }])));
    E.regions({ study_door: { size: [941, 1672], r: {
      'p1-v091-door-context': [29, 20, 57, 55],
      'p1-v091-door-focus': [38, 22, 40, 37]
    } } });
    E.regions(Object.fromEntries([['c5_door', [1024, 1536]], ['c5_study', [941, 1672]], ['c6_study', [941, 1672]]].map(([image, size]) => [image, {
      size, r: {
        'p1-v091-notebook-context': [20, 23, 60, 42],
        'p1-v091-notebook-focus': [32, 34, 36, 24]
      }
    }])));
    E.regions({
      c2_front_day: { size: [1024, 1536], r: { 'p1-v091-front-context': [28, 22, 46, 40], 'p1-v091-front-focus': [36, 27, 26, 28] } },
      c3_vestry: { size: [1024, 1536], r: { 'p1-v091-vestry-context': [9, 30, 82, 50], 'p1-v091-vestry-focus': [20, 39, 60, 33] } },
      c4_parlour: { size: [1024, 1536], r: { 'p1-v091-return-context': [61, 24, 38, 49], 'p1-v091-return-focus': [68, 32, 29, 32] } },
      c5_corner: { size: [1024, 1536], r: { 'p1-v091-cab-context': [36, 30, 45, 28], 'p1-v091-cab-focus': [48, 34, 29, 20] } }
    });
    E.regions({ c6_room: { size: [1024, 1536], r: {
      'p1-v091-notebook-context': [20, 23, 60, 42],
      'p1-v091-notebook-focus': [32, 34, 36, 24]
    } } });

    // This is the same nearby driver and horse seen on the cab route. The
    // glance is temporary: he turns back to the horse, without being named,
    // met, questioned or added to the present conversational cast.
    // The place step runs again after its nested inspection. Reset the shot
    // there as well as the visible layer so a save cannot retain the old cue.
    patch('c1_departure', [9], { shot: null, look: null, actionFrame: null });
    patch('c1_departure', [9, 'place', 'views', 'cab', 'zones', 0, 'then', 0], {
      shot: 'act-finn-care', look: null,
      actionFrame: { focus: 'p1-action-focus', context: 'p1-action-context', zoom: 1.3 },
      motion: { id: 'p1-v091-cab-driver-glance', ms: 2300, backdrop: { frames: [
        { offset: 0, art: 'act-finn-care' },
        { offset: .32, art: 'act-finn-turn' },
        { offset: .72, art: 'act-finn-care' },
        { offset: 1, art: 'act-finn-care' }
      ] } }
    });

    // A named-place inspection clears the conversational cast. Reed is
    // physically beside Vale here; the shared presence side validates that
    // authored context before restoring her native speaker portrait.
    const directoryReply = E.S().places?.c2_lane?.views?.rank?.zones?.[0]?.then?.[1];
    if (directoryReply?.say === 'reed') {
      directoryReply.look = null;
      directoryReply.valePresence = { ...directoryReply.valePresence, show: [{ id: 'reed', at: 'l' }] };
    }

    // Two original standing states show the mask's return at the doorway.
    // Reversing the seated unmasking plates here would put him back in the
    // chair. The foreground track is the sole visible Matthias in this shot.
    patch('c1_terms', [4], {
      shot: 'study_door', look: null, actionFrame: doorFrame(),
      motion: { id: 'p1-v091-mask-at-door', ms: 2100, tracks: [{
        id: visitor, art: 'matthias-unmasked', at: [57, 51], w: 48, ar: 2 / 3, z: 3,
        frames: [
          { offset: 0, art: 'matthias-unmasked', opacity: 1 },
          { offset: .52, art: 'matthias-entry-full' },
          { offset: 1, art: 'matthias-entry-full' }
        ]
      }] }
    });
    returnAt('c1_terms', [8], [visitor]);

    // The notebook is already open in the prose. Show the writing pose at
    // entry instead of inventing an extra close/open cycle. The following
    // turn and closure are real changes of the held notebook's visible state.
    for (const [index, id] of [[6, 'p1-v091-notebook-columns'], [18, 'p1-v091-notebook-admission']]) {
      stageNotebook('c1_account', [index], {
        id, ms: 1600, sounds: [{ at: .12, cue: 'pen_write' }],
        tracks: [noteTrack([
          { offset: 0, art: 'reed-writing-v091', opacity: 0 },
          { offset: .18, art: 'reed-writing-v091', opacity: 1 },
          { offset: 1, art: 'reed-writing-v091', opacity: 1 }
        ])]
      });
      returnAt('c1_account', [index + 1]);
    }
    stageNotebook('c1_review', [0], {
      id: 'p1-v091-notebook-turned', ms: 1900,
      tracks: [noteTrack([
        { offset: 0, art: 'reed-writing-v091' },
        { offset: .48, art: 'reed-offer-notebook-v091' },
        { offset: 1, art: 'reed-offer-notebook-v091' }
      ])]
    });
    returnAt('c1_review', [1]);
    stageNotebook('c1_terms', [9], {
      id: 'p1-v091-notebook-closed', ms: 1800, sounds: [{ at: .52, cue: 'paper_fold' }],
      tracks: [noteTrack([
        { offset: 0, art: 'reed-writing-v091' },
        { offset: .55, art: 'reed-full' },
        { offset: 1, art: 'reed-full' }
      ])]
    });
    returnAt('c1_terms', [10]);

    // Celia pauses on the top step. The coat/gloves come from her original
    // full-body sprite; the motion only establishes her physical entrance.
    // Naming her still belongs to the untouched meet step that follows.
    patch('c2_call', [1], {
      shot: 'c2_front_day', look: null, on: 'celia',
      actionFrame: { focus: 'p1-v091-front-focus', context: 'p1-v091-front-context', zoom: 1.15 },
      valePresence: { show: [{ id: 'celia', at: 'r' }] },
      motion: { id: 'p1-v091-celia-top-step', ms: 1900, tracks: [{
        id: celiaStep, art: 'celia-full', at: [50, 38.5], w: 24, ar: 2 / 3, z: 3,
        frames: [
          { offset: 0, at: [50, 38.5], w: 24, opacity: 0 },
          { offset: .22, opacity: 1 },
          { offset: .75, at: [50, 41], w: 27, opacity: 1 },
          { offset: 1, at: [50, 41], w: 27, opacity: 1 }
        ]
      }] }
    });
    returnAt('c2_call', [2], [celiaStep]);

    // The envelope is held openly after the glove search, then tucked under
    // Hart's arm. Both plates share the same doorway and closed contents.
    patch('c2_call', [14], {
      shot: 'act-hart-envelope-gloves', look: 'p1-contact',
      actionFrame: { focus: 'p1-action-focus', context: 'p1-action-context', zoom: 1.25 },
      motion: { id: 'p1-v091-envelope-under-arm', ms: 1700, backdrop: { frames: [
        { offset: 0, art: 'act-hart-envelope-gloves' },
        { offset: .55, art: 'act-hart-envelope-tucked' },
        { offset: 1, art: 'act-hart-envelope-tucked' }
      ] } }
    });
    returnAt('c2_call', [15], []);

    // Hart briefly goes to settle the clerk's fee and returns to the same
    // group. Celia and Reed remain in the vestry; there is no invented clerk
    // or Bell cutaway, payment prop, new evidence or new conversation.
    patch('c3_open', [33], {
      shot: 'c3_vestry', look: null, on: 'hart',
      actionFrame: { focus: 'p1-v091-vestry-focus', context: 'p1-v091-vestry-context', zoom: 1.1 },
      motion: { id: 'p1-v091-hart-leaves-and-returns', ms: 3200, tracks: [
        { id: vestryActors[0], art: 'reed-full', at: [23, 65], w: 55, ar: 2 / 3, z: 2,
          frames: [{ offset: 0, opacity: 1 }, { offset: 1, opacity: 1 }] },
        { id: vestryActors[1], art: 'celia-full', at: [76, 65], w: 55, ar: 2 / 3, z: 2,
          frames: [{ offset: 0, opacity: 1 }, { offset: 1, opacity: 1 }] },
        { id: vestryActors[2], art: 'hart-full', at: [49, 65], w: 55, ar: 2 / 3, z: 3,
          frames: [
            { offset: 0, at: [49, 65], opacity: 1 },
            { offset: .32, at: [115, 65], opacity: 0 },
            { offset: .6, at: [115, 65], opacity: 0 },
            { offset: .93, at: [49, 65], opacity: 1 },
            { offset: 1, at: [49, 65], opacity: 1 }
          ] }
      ] }
    });
    returnAt('c3_open', [34], vestryActors);

    // The hall door is at the right edge of this exact parlour painting.
    // Reed remains outside on this route; this entrance represents Celia only.
    patch('c4_alarm_explore', [2], {
      shot: 'c4_parlour', look: null, on: 'celia',
      actionFrame: { focus: 'p1-v091-return-focus', context: 'p1-v091-return-context', zoom: 1.15 },
      valePresence: { show: [{ id: 'celia', at: 'r' }] },
      motion: { id: 'p1-v091-celia-returns', ms: 2000, tracks: [{
        id: celiaStep, art: 'celia-full', at: [97, 40], w: 25, ar: 2 / 3, z: 3,
        frames: [
          { offset: 0, at: [97, 40], w: 25, opacity: 0 },
          { offset: .2, opacity: 1 },
          { offset: .8, at: [84, 51], w: 38, opacity: 1 },
          { offset: 1, at: [84, 51], w: 38, opacity: 1 }
        ]
      }] }
    });
    returnAt('c4_alarm_explore', [3], [celiaStep]);

    // Match the visible cab door, then remove the silhouette after boarding.
    // This is the anonymous passer-by, not a new sighting of named Celia.
    patch('c5_follow', [1], {
      shot: 'c5_corner', look: null,
      actionFrame: { focus: 'p1-v091-cab-focus', context: 'p1-v091-cab-context', zoom: 1.2 },
      motion: { id: 'p1-v091-passenger-boards', ms: 2600, tracks: [{
        id: passenger, art: 'c5_walker-full', at: [44, 47], w: 18, ar: 2 / 3, z: 3, remove: true,
        frames: [
          { offset: 0, at: [44, 47], w: 18, opacity: 1 },
          { offset: .55, at: [60, 42], w: 11, opacity: 1 },
          { offset: .75, at: [62, 40], w: 10, opacity: 1 },
          { offset: .9, at: [62, 40], w: 10, opacity: 0 },
          { offset: 1, opacity: 0 }
        ]
      }] }
    });
    returnAt('c5_follow', [2], [passenger]);

    // These anchors explicitly describe Reed writing in the running record.
    // Keep her in the actual scene; never reassign Vale's writing to Reed.
    for (const cue of [
      { node: 'c5_open', path: [13, 'choice', 2, 'then', 1], next: [13, 'choice', 2, 'then', 2], image: 'c5_door', id: 'p1-v091-greeting-recorded' },
      { node: 'c5_desk', path: [5, 'present', 'segs', 1, 'ok', 1], next: [6], image: 'c5_study', id: 'p1-v091-claim-struck-through' },
      { node: 'c5_plan', path: [2, 'choice', 0, 'then', 2], next: [3], image: 'c5_study', id: 'p1-v091-unknown-name-marked' },
      { node: 'c5_plan', path: [2, 'choice', 2, 'then', 3], next: [3], image: 'c5_study', id: 'p1-v091-accusation-recorded' },
      { node: 'c6_truth', path: [0, 'then', 1], next: [1], image: 'c6_room', id: 'p1-v091-accusation-corrected' },
      { node: 'c6_truth', path: [3], next: [4], image: 'c6_room', id: 'p1-v091-no-more-men-recorded' },
      { node: 'c6_delivery', path: [2, 'choice', 0, 'then', 2], next: [3], image: 'c6_study', id: 'p1-v091-method-recorded' }
    ]) {
      stageNotebook(cue.node, cue.path, {
        id: cue.id, ms: 1700,
        tracks: [noteTrack([
          { offset: 0, art: 'reed-writing-v091', opacity: 0 },
          { offset: .2, art: 'reed-writing-v091', opacity: 1 },
          { offset: 1, art: 'reed-writing-v091', opacity: 1 }
        ], ['c5_door', 'c6_room'].includes(cue.image) ? [50, 55] : [50, 52])]
      }, () => cue.image);
      returnAt(cue.node, cue.next);
    }
    // The presentation mechanism re-enters its parent after the correction
    // reaction. Clear the notebook there before its native paper view returns.
    returnAt('c5_desk', [5]);
    // She opens the notebook here but has not begun correcting the accusation.
    // No pen sound or altered words are added to the original narration.
    stageNotebook('c6_visit', [0, 'then', 1], {
      id: 'p1-v091-correction-space-opened', ms: 1900,
      tracks: [noteTrack([
        { offset: 0, art: 'reed-full' },
        { offset: .52, art: 'reed-writing-v091' },
        { offset: 1, art: 'reed-writing-v091' }
      ])]
    }, () => 'c6_study');
    returnAt('c6_visit', [1]);
  }
  E.on('boot', () => { install(); queueMicrotask(install); });
  E.on('chapter', () => { install(); queueMicrotask(install); });
  V.v091P1Actions = () => ({ enabled: enabled(), notebookProp: notebook, visitorProp: visitor });
})();
/* Vale 0.9.1 — specific, witnessed actions in Parts II and III.
 * Presentation metadata only: no prose, choices, grants, arrays or save paths
 * change. A writing/tea pose illustrates the action; it is not a hand rig.
 * Existing location plates and original object art remain the source of truth.
 */
(() => {
  'use strict';
  const E = StoryEngine;
  const enabled = () => /^vale-dossiers-part[23]-v01$/.test(E.S()?.id || '');
  const at = (S, node, path) => path.reduce((v, k) => v?.[k], S.nodes?.[node]);
  const patch = (S, node, path, values) => {
    const st = at(S, node, path); if (st) Object.assign(st, values);
  };
  const reedProp = 'v091-reed-action23';
  const actionProps = [reedProp, ...['rusk', 'lydia', 'ruth', 'owen'].map(id => 'v091-stage-' + id), 'v091-ben-ember'];
  const remove = ids => {
    const R = E.R();
    for (const id of ids || []) {
      if (!id.startsWith('v091-')) continue;
      if (R.props) delete R.props[id];
      for (const el of document.querySelectorAll('.prp')) if (el.dataset.p === id) el.remove();
    }
  };
  E.side('valeActions23', async value => { if (enabled() && value) remove(value.remove); });

  const holdPose = (id, art, place, ms = 850) => ({
    id, ms,
    tracks: [{ id: reedProp, art, ...place, z: 4,
      frames: [{ offset: 0, opacity: 0 }, { offset: .3, opacity: 1 }, { offset: 1, opacity: 1 }] }]
  });
  const returnFromAction = (S, node, path, values = {}) => patch(S, node, path, {
    shot: null, look: null, actionFrame: null,
    valeActions23: { remove: actionProps }, ...values
  });
  const placeSpeaker = (S, place, view, zone, index, who, position = 'l') => {
    const st = S.places?.[place]?.views?.[view]?.zones?.[zone]?.then?.[index];
    if (st?.say !== who) return;
    // place() deliberately clears R.cast. These authored companion replies
    // need staging of their own; a name in narration does not grant presence.
    st.valePresence = { ...(st.valePresence || {}), show: [{ id: who, at: position }] };
    st.look = null; st.actionFrame = null;
  };

  // These bounds protect Reed's face, both hands and the actual notebook.
  // The neutral object insert uses the closed-case source, never the blade.
  E.regions({
    'evidence-p3_case_closed': { size: [1280, 1280], r: {
      v091_case_clasp: [36, 49, 23, 20], v091_closed_case: [0, 28, 100, 55]
    } },
    p3_stable: { r: {
      v091_empty_stall: [40, 27, 35, 25], v091_stall_context: [27, 16, 67, 49]
    } }
  });

  function writer(S, node, index, scene, id) {
    patch(S, node, Array.isArray(index) ? index : [index], {
      shot: scene, look: [48, 35, 20, 13], on: 'reed',
      actionFrame: { focus: [48, 35, 20, 13], context: [28, 15, 43, 33], zoom: 1.3 },
      motion: holdPose(id, 'reed-writing-v091', { at: [46, 54], w: 80, ar: 2 / 3 })
    });
  }

  // Blocking uses a whole original cutout. It depicts an entrance/exit, not
  // invented arm joints, a reversed walk cycle, or a new character costume.
  function blocking(S, node, path, scene, id, people, options = {}) {
    const st = at(S, node, path); if (!st) return;
    if (options.relocate) { delete st.shot; st.scene = scene; }
    else { delete st.scene; st.shot = scene; }
    const hide = [...new Set([...(options.hide || []), ...people.filter(p => p.exit).map(p => p.who)])];
    Object.assign(st, {
      look: options.focus || [30, 23, 43, 31],
      actionFrame: { focus: options.focus || [30, 23, 43, 31], context: options.context || [4, 17, 92, 43], zoom: 1.3 },
      motion: { id, ms: options.ms || 1600,
        actors: hide.map(id => ({ id, hide: true })),
        tracks: people.map(p => ({ id: 'v091-stage-' + p.who, art: p.art || p.who + '-full', at: p.from, w: p.w || 70, ar: 2 / 3, z: p.z || 4,
          frames: [{ offset: 0, at: p.from, opacity: p.exit || p.stay ? 1 : 0 },
            { offset: .18, opacity: 1 }, { offset: .82, at: p.to || p.from, opacity: 1 },
            { offset: 1, at: p.to || p.from, opacity: p.exit ? 0 : 1 }], ...(p.exit ? { remove: true } : {}) })) }
    });
  }

  function expanded(S) {
    if (S.id === 'vale-dossiers-part2-v01') {
      blocking(S, 'p2c3_open', [4], 'p2_corridor', 'p2-v091-rusk-blocks-door',
        [{ who: 'rusk', from: [99, 53], to: [78, 53], w: 64 }],
        { focus: [65, 24, 30, 32], context: [48, 19, 52, 44] });
      returnFromAction(S, 'p2c3_open', [5]);
      blocking(S, 'p2c3_open', [35], 'p2_corridor', 'p2-v091-lydia-waits-with-ruth',
        [{ who: 'lydia', from: [57, 54], to: [-24, 54], exit: true }]);
      returnFromAction(S, 'p2c3_open', [36]);

      // The drawing remains a record. Nothing reaches into or changes the vent.
      writer(S, 'p2c4_open', [12, 'explore', 'spots', 1, 'then', 2], 'p2_room', 'p2-v091-mark-both-vent-ends');
      returnFromAction(S, 'p2c4_open', [12, 'explore', 'spots', 1, 'then', 3]);
      blocking(S, 'p2c4_open', [28], 'p2_corridor', 'p2-v091-hale-joins-sketch',
        [{ who: 'owen', from: [8, 54], to: [50, 54] }]);
      returnFromAction(S, 'p2c4_open', [29]);
      writer(S, 'p2c4_open', [33, 'choice', 1, 'then', 1], 'p2_corridor', 'p2-v091-preserve-pencil-correction');
      returnFromAction(S, 'p2c4_open', [34]);
      blocking(S, 'p2c4_open', [37], 'p2_room', 'p2-v091-lydia-returns-to-plan',
        [{ who: 'lydia', art: 'lydia-resolute', from: [110, 54], to: [63, 54] }]);
      returnFromAction(S, 'p2c4_open', [38], { valePresence: { show: [{ id: 'lydia', at: 'r', face: 'resolute' }] } });
      blocking(S, 'p2c4_open', [40], 'p2_room', 'p2-v091-lydia-ruth-leave-room',
        [{ who: 'ruth', from: [66, 56], to: [130, 56], w: 58, exit: true },
          { who: 'lydia', art: 'lydia-calm', from: [40, 56], to: [117, 56], w: 58, exit: true }]);
      returnFromAction(S, 'p2c4_open', [41]);

      blocking(S, 'p2c5_withdraw', [6], 'p2_house_evening', 'p2-v091-witnesses-leave-safely',
        [{ who: 'ruth', from: [41, 56], to: [-30, 58], w: 58, exit: true },
          { who: 'lydia', art: 'lydia-resolute', from: [65, 56], to: [-12, 58], w: 58, exit: true }]);
      returnFromAction(S, 'p2c5_withdraw', [7]);
      blocking(S, 'p2c5_intervene', [5], 'p2_house_evening', 'p2-v091-rusk-returns-to-witnesses',
        [{ who: 'rusk', from: [108, 54], to: [65, 54] }]);
      returnFromAction(S, 'p2c5_intervene', [6]);
      blocking(S, 'p2c5_intervene', [13], 'p2_house_evening', 'p2-v091-lydia-leaves-front-door',
        [{ who: 'lydia', art: 'lydia-resolute', from: [65, 54], to: [-24, 58], exit: true }]);
      returnFromAction(S, 'p2c5_intervene', [14]);

      // The original full-Reed master is the closed-notebook endpoint. No
      // loose medical sheet or handwriting is fabricated over the source art.
      patch(S, 'p2c6_overreach', [4], {
        shot: 'p2_house_dawn', look: [47, 35, 24, 15],
        actionFrame: { focus: [47, 35, 24, 15], context: [28, 15, 43, 34], zoom: 1.3 },
        motion: { id: 'p2-v091-notebook-closed-on-overreach', ms: 1350, actors: [{ id: 'lydia', hide: true }, { id: 'ruth', hide: true }],
          tracks: [{ id: reedProp, art: 'reed-offer-notebook-v091', at: [46, 54], w: 80, ar: 2 / 3, z: 4,
            frames: [{ offset: 0 }, { offset: .55, art: 'reed-full' }, { offset: 1, art: 'reed-full' }] }] }
      });
      returnFromAction(S, 'p2c6_overreach', [5]);
      // The corridor relocation was already authored in the v0.6 layout. Keep
      // it as a real scene while Lydia passes Rusk, then leaves the frame.
      blocking(S, 'p2c6_intervention', [3], 'p2_corridor_dawn', 'p2-v091-lydia-passes-study',
        [{ who: 'rusk', from: [84, 53], w: 56, stay: true, z: 3 },
          { who: 'lydia', art: 'lydia-calm', from: [59, 55], to: [-25, 55], exit: true }],
        { relocate: true, hide: ['reed', 'lydia', 'ruth', 'rusk'], focus: [51, 26, 40, 30], context: [4, 18, 94, 43] });
      returnFromAction(S, 'p2c6_intervention', [4]);
      patch(S, 'p2c6_intervention', [6], { on: 'reed', valePresence: { show: [{ id: 'reed', at: 'l' }] } });
    } else {
      writer(S, 'p3c2_open', 31, 'p3_moor', 'p3-v091-shepherd-question-in-margin');
      returnFromAction(S, 'p3c2_open', [32]);
      writer(S, 'p3c4_open', [8, 'explore', 'spots', 1, 'then', 1], 'p3_office', 'p3-v091-handwriting-comparison-notes');
      returnFromAction(S, 'p3c4_open', [8, 'explore', 'spots', 1, 'then', 2]);
      writer(S, 'p3c5_supported', [0, 'then', 1], 'p3_dorn_open', 'p3-v091-date-the-public-correction');
      returnFromAction(S, 'p3c5_supported', [1], { valePresence: { show: [{ id: 'reed', at: 'l' }] } });

      const recovery = at(S, 'p3c5_recovery_route', [5]);
      if (recovery) {
        delete recovery.scene;
        Object.assign(recovery, { shot: 'p3_stable', look: [12, 46, 30, 31],
          actionFrame: { focus: [12, 46, 30, 31], context: [12, 28, 76, 51], zoom: 1.25 },
          motion: { id: 'p3-v091-stall-open-horse-home', ms: 1800,
            backdrop: { frames: [{ offset: 0, art: 'p3_stable' }, { offset: .5, art: 'p3_stable_return' }, { offset: 1, art: 'p3_stable_return' }] } } });
      }
      // The horse remains in the opened stall after this action. Returning to
      // the old empty-stall plate here would undo the physical outcome.
      for (const branch of ['then', 'else']) {
        const next = at(S, 'p3c5_recovery_route', [6, branch, 0]);
        if (next) { delete next.shot; Object.assign(next, { scene: 'p3_stable_return', look: null, actionFrame: null, valeActions23: { remove: actionProps } }); }
      }
      // One derived composite owns the lead rope and both silhouettes. Replace
      // the older solitary-horse prop, including when resuming a v0.9 save.
      patch(S, 'p3c5_late_route', [6], {
        shot: 'p3_finish', clearProps: true, look: [47, 38, 45, 28],
        actionFrame: { focus: [47, 38, 45, 28], context: [5, 31, 95, 42], zoom: 1.25 },
        motion: { id: 'p3-v091-ben-leads-ember-past-course', ms: 1900,
          actors: [{ id: 'ben', hide: true }],
          tracks: [{ id: 'v091-ben-ember', art: 'p3_ben_leading_ember_v091', at: [47, 55], w: 90, ar: 1.5, z: 4,
            frames: [{ offset: 0, at: [43, 55], opacity: 0 }, { offset: .15, opacity: 1 }, { offset: 1, at: [55, 55], opacity: 1 }] }] }
      });
      returnFromAction(S, 'p3c5_late_route', [7]);
    }
  }

  function install() {
    if (!enabled()) return;
    const S = E.S();
    if (S.id === 'vale-dossiers-part2-v01') {
      placeSpeaker(S, 'p2c2_house', 'yard', 0, 1, 'reed');
      placeSpeaker(S, 'p2c2_house', 'corridor', 0, 1, 'lydia', 'r');
      placeSpeaker(S, 'p2c2_house', 'room', 1, 0, 'lydia', 'r');
      // Tea is in her hands on the narrated beat, not first revealed later.
      patch(S, 'p2c1_open', [28], {
        shot: 'study', look: [48, 58, 30, 17], on: 'reed',
        actionFrame: { focus: [48, 58, 30, 17], context: [14, 25, 72, 60], zoom: 1.3 },
        motion: holdPose('p2-v091-reed-brings-tea', 'reed-tea', { at: [50, 54], w: 72, ar: 2 / 3 })
      });
      returnFromAction(S, 'p2c1_open', [29]);
      writer(S, 'p2c5_observe', 9, 'p2_corridor_night', 'p2-v091-separate-witness-notes');
      // The next step only sets existing story flags; cleanup is a side effect,
      // so the subsequent branch enters with its own original scene/cast.
      returnFromAction(S, 'p2c5_observe', [10]);
    } else {
      placeSpeaker(S, 'p3c2_ground', 'path', 0, 1, 'reed');
      placeSpeaker(S, 'p3c2_ground', 'hollow', 1, 1, 'reed');
      placeSpeaker(S, 'p3c3_yard_walk', 'yard', 0, 1, 'ben', 'r');
      placeSpeaker(S, 'p3c3_yard_walk', 'stall', 0, 1, 'reed');
      // Later dog replies already have Ben in the original Ben+Moss action
      // composite. Do not place a second native Ben over that same person.
      // The boy has no canonical sprite. Show the stall he reacts to, using
      // its exact original pixels; do not invent a substitute child/gesture.
      patch(S, 'p3c1_open', [12], {
        shot: 'p3_stable', look: 'v091_empty_stall',
        actionFrame: { focus: 'v091_empty_stall', context: 'v091_stall_context', zoom: 1.25 }
      });
      returnFromAction(S, 'p3c1_open', [13]);
      writer(S, 'p3c1_open', 24, 'p3_yard', 'p3-v091-two-investigation-headings');
      returnFromAction(S, 'p3c1_open', [25]);
      writer(S, 'p3c2_open', 10, 'p3_moor', 'p3-v091-record-the-crossing');
      returnFromAction(S, 'p3c2_open', [11]);

      // Keep the existing sleeping dog at its authored world coordinates.
      // Both the bowl and the sleeping dog belong to this opening narration.
      patch(S, 'p3c3_open', [4], {
        shot: 'p3_yard_morning_clean', look: [27, 53, 34, 17],
        actionFrame: { focus: [27, 53, 34, 17], context: [0, 32, 67, 48], zoom: 1.3 },
        motion: {
          id: 'p3-v091-reed-tea-and-sleeping-moss', ms: 850,
          tracks: [
            { id: 'moss', art: 'p3_moss_sleep', at: [50.7, 57.2], w: 20, ar: 2, z: 3,
              frames: [{ offset: 0 }, { offset: 1 }] },
            { id: reedProp, art: 'reed-tea', at: [24, 56], w: 48, ar: 2 / 3, z: 4,
              frames: [{ offset: 0, opacity: 0 }, { offset: .3, opacity: 1 }, { offset: 1 }] }
          ]
        }
      });
      returnFromAction(S, 'p3c3_open', [5], { face: 'tea' });

      // An explicit evidence insert keeps the instrument inside its case.
      // It does not claim to animate Nora's eyes or reveal an unreadable label.
      patch(S, 'p3c4_open', [12], {
        shot: 'evidence-p3_case_closed', look: 'v091_case_clasp',
        actionFrame: { focus: 'v091_case_clasp', context: 'v091_closed_case', zoom: 1.15 }
      });
      returnFromAction(S, 'p3c4_open', [13]);
    }
    expanded(S);
  }

  // Part-specific layouts register later. The second application runs after
  // those overlays without depending on prose or changing authored paths.
  E.on('boot', () => { install(); queueMicrotask(install); });
  E.on('chapter', () => { install(); queueMicrotask(install); });
})();
