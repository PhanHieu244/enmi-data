  }));
  // nút quay / lùi nằm GIỮA màn (ngoài bảng dưới)
  const navEl = () => { let n = $(".se-plnav"); if (!n) { n = h(`<div class="se-plnav"></div>`); $(".se")?.appendChild(n); } return n; };
