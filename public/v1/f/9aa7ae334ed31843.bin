for(const[n,p]of[
 ['c1_open',[15,'place','views','desk','zones',1,'then',1]],
 ['c3_open',[29]],['c4_disguise',[10]],['c5_return',[4]],
 ['c6_truth',[6]],['c6_delivery',[1]]
])patch(S,n,p,{actionFrame:actionFrame()});
}
E.on('boot',()=>{if(!isP1())return;apply();letter();observer?.disconnect();observer=new MutationObserver(queue);observer.observe(q('.se'),{childList:true,subtree:true});queueMicrotask(apply);queue();});E.on('chapter',()=>{if(isP1()){apply();queueMicrotask(apply);}});E.on('step',(type,st)=>{if(!isP1())return;if(type==='explore'){if(st===E.S().nodes.c5_follow?.[2])st.explore.img=E.R().f.p1_cab_departed?'c5_corner_departed':'c5_corner';if(st===E.S().nodes.c6_terms?.[9]){st.explore.img='parlour-terms';const p=st.explore.spots.find(p=>p.id==='packet');if(p)Object.assign(p,{art:'celia-holding',artR:[18,28,39,39],r:[32,36,12,10],inspectR:[20,26,38,35],x:38,y:41});}}queue();});E.on('line',queue);
})();
/* Current-run records, shared by the native casebook and investigation board. */
(() => {
 const E=StoryEngine,V=ValeDemo,{esc}=E;
 const nativeArt=E.itemArt,nativeView=E.ui.itemView,nativeNotice=E.ui.itemNotice;
 const fold=t=>String(t||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d');
 const text=t=>typeof t==='string'?t:Object.values(t||{}).filter(v=>typeof v==='string').join(' ');
 const label={object:{en:'Object / document',vi:'Đồ vật / tài liệu'},testimony:{en:'Testimony',vi:'Lời khai'},observation:{en:'Observed detail',vi:'Chi tiết quan sát'},inference:{en:'Conclusion',vi:'Suy luận'}};
 const artAliases={letter:'letter',paper:'paper',newspaper:'newspaper',photograph:'photo',portrait:'portrait',invitation:'letter',agreement:'agreement',parcel:'parcel',register:'register',pin:'pin',coat:'coat',receipt:'paper',cab:'cab',gate:'gate'};
 V.recordText=t=>E.ui.investigationText(t);
 // Opt in without changing the native engine's default language policy. Keep
 // semantic text nodes alive when translation changes; never redraw a puzzle.
 E.ui.investigationText=t=>{
  const main=E.tgt(t),sub=E.sub(t);
  return `<span class="vd-investigation-copy"><span class="vd-investigation-main" lang="${esc(E.L)}">${esc(main)}</span>${sub?`<span class="vd-investigation-sub" lang="${esc(E.N)}"${E.G().set.tr?'':' hidden'}>${esc(sub)}</span>`:''}</span>`;
 };
 const setTr=E.ui.setTr;
 E.ui.setTr=(...args)=>{const result=setTr(...args);document.querySelectorAll('.vd-investigation-sub').forEach(el=>{el.hidden=!E.G().set.tr;});return result;};
 E.ui.itemNotice=id=>{
  const result=nativeNotice(id),it=E.S()?.items?.[id];if(it&&!E.auto)document.querySelectorAll('.se-item-receipt[data-record-id]').forEach(el=>{if(el.dataset.recordId===id){const title=el.querySelector(':scope>span>b');if(title)title.innerHTML=E.ui.investigationText(it.name);}});return result;
 };
 E.evidenceMeta=id=>{
  const it=E.S()?.items?.[id]||{},raw=it.recordType||it.kind||'observation';
  const type=raw==='document'?'object':['object','testimony','inference','observation'].includes(raw)?raw:'observation';
  const who=it.who||'',portrait=who==='matthias'&&E.known(who)?'matthias-unmasked':who;
  return {type,group:type==='testimony'?'testimony':type==='inference'?'inference':'objects',who,chapter:+it.chapter||+(id.match(/^c(\d)_/)?.[1])||1,art:type==='testimony'&&portrait?'im-'+portrait:id==='visitor_observed'?'im-wren_door':'im-evidence-'+(artAliases[it.artAlias]||it.artAlias||'paper'),brief:it.brief||it.desc,sourceLabel:it.sourceLabel||it.source||label[type]};
 };
 E.itemArt=(id,cls='')=>{
  const it=E.S()?.items?.[id];if(!it)return nativeArt(id,cls);
  const m=E.evidenceMeta(id);
  return `<span class="se-ia vd-record-art ${esc(cls)} is-${m.type}" aria-hidden="true"><i class="${esc(m.art)}"></i>${m.type==='testimony'?'<span class="vd-quote-mark">“</span>':m.type==='inference'?'<span class="vd-inference-mark">∴</span>':''}</span>`;
 };
 E.ui.itemView=id=>{
  nativeView(id);const it=E.S()?.items?.[id],v=V.q('.se-iv');if(!it||!v)return;
  const m=E.evidenceMeta(id),card=v.querySelector('.se-ivc'),heading=card.querySelector(':scope>b'),desc=card.querySelector(':scope>p');
  v.classList.add('vd-record-detail');v.setAttribute('role','dialog');v.setAttribute('aria-modal','true');v.setAttribute('aria-label',E.tgt(it.name));
  heading.innerHTML=E.ui.investigationText(it.name);desc.innerHTML=E.ui.investigationText(it.desc);
  heading.insertAdjacentHTML('beforebegin',`<span class="vd-record-kind is-${m.type}">${E.ui.investigationText(label[m.type])}</span>`);
  desc.insertAdjacentHTML('afterend',`<p class="vd-record-source">${E.ui.investigationText(m.sourceLabel)}</p>${m.type==='testimony'?`<p class="vd-record-note">${E.ui.investigationText({en:'An account to check against other evidence.',vi:'Lời kể cần được đối chiếu với chứng cứ khác.'})}</p>`:''}`);
  const hint=card.querySelector(':scope>small');if(hint)hint.remove();
  const close=document.createElement('button');close.className='se-ib vd-record-close';close.dataset.vdClose='';close.setAttribute('aria-label','Back to records · Về hồ sơ');close.innerHTML='×';card.prepend(close);
  const click=v.onclick;
  v.onclick=e=>{if(e.target===v||e.target.closest('[data-vd-close],[data-cw],[data-cwi],.se-cwl'))click?.(e);};
  v.onkeydown=e=>{if(e.key==='Escape'){e.preventDefault();close.click();}};
  close.focus({preventScroll:true});
 };
 const mountRecords=panel=>{
  const R=E.R(),S=E.S(),ids=R.items.filter(id=>S.items[id]),groups=[...new Set(ids.map(id=>E.evidenceMeta(id).chapter))].sort((a,b)=>b-a);
  const state=V.recordBrowser||={filter:'all',query:''};
  panel.classList.add('vd-record-browser');
  const card=id=>{const it=S.items[id],m=E.evidenceMeta(id);return `<button class="vd-record-card" data-it="${esc(id)}" data-record-group="${m.group}" data-record-search="${esc(fold(text(it.name)+' '+text(it.desc)+' '+text(m.sourceLabel)))}">${E.itemArt(id)}<span class="vd-record-copy"><span class="vd-record-kind is-${m.type}">${esc(E.nat(label[m.type]))}</span><b>${V.recordText(it.name)}</b><span class="vd-record-brief">${V.recordText(m.brief)}</span><small>${V.recordText(m.sourceLabel)}</small></span></button>`;};
  panel.innerHTML=`<div class="vd-record-controls"><div class="vd-record-filters" role="group" aria-label="Record type · Loại hồ sơ">${[['all','All','Tất cả'],['objects','Objects & traces','Đồ vật / dấu vết'],['testimony','Testimony','Lời khai']].map(([id,en,vi])=>`<button class="se-btn sm" data-record-filter="${id}" aria-pressed="false"><span>${en}</span><small>${vi}</small></button>`).join('')}</div><label class="vd-record-search"><span>Search records · Tìm hồ sơ</span><input class="se-in" type="search" autocomplete="off" placeholder="Name, detail or source · Tên, chi tiết, nguồn" value="${esc(state.query)}"></label><p class="vd-record-count" role="status" aria-live="polite"></p></div><div class="vd-record-groups">${groups.map((ch,i)=>`<details class="vd-record-chapter" data-record-chapter="${ch}" ${i===0?'open':''}><summary>Chapter ${ch} · Chương ${ch}<small></small></summary><div class="vd-record-list">${ids.filter(id=>E.evidenceMeta(id).chapter===ch).map(card).join('')}</div></details>`).join('')}</div><p class="vd-record-empty" hidden>No matching records.<span class="vd-vi">Không có hồ sơ phù hợp. Thử đổi bộ lọc hoặc từ tìm kiếm.</span></p>`;
  const apply=()=>{
   const words=fold(state.query).trim().split(/\s+/).filter(Boolean);let shown=0;
   panel.querySelectorAll('[data-record-group]').forEach(el=>{const visible=(state.filter==='all'||el.dataset.recordGroup===state.filter)&&words.every(w=>el.dataset.recordSearch.includes(w));el.hidden=!visible;if(visible)shown++;});
   panel.querySelectorAll('[data-record-chapter]').forEach(el=>{const count=[...el.querySelectorAll('[data-it]')].filter(e=>!e.hidden).length;el.hidden=!count;el.querySelector('summary small').textContent=count?String(count):'';if(state.query.trim())el.open=true;});
   panel.querySelectorAll('[data-record-filter]').forEach(b=>{const on=b.dataset.recordFilter===state.filter;b.classList.toggle('on',on);b.setAttribute('aria-pressed',String(on));});
   panel.querySelector('.vd-record-count').textContent=`${shown} / ${ids.length} records · hồ sơ`;
   panel.querySelector('.vd-record-empty').hidden=shown>0;
  };
  panel.addEventListener('click',e=>{const b=e.target.closest('[data-record-filter]');if(b){state.filter=b.dataset.recordFilter;apply();E.sfx('tap');}});
  panel.querySelector('input').oninput=e=>{state.query=e.target.value;apply();};apply();
 };
 const mountConclusions=panel=>{
  const R=E.R(),S=E.S(),earned=Object.values(R.caseConclusions||{}),inferred=R.items.filter(id=>S.items[id]&&E.evidenceMeta(id).type==='inference'),ending=R.done&&S.endings[R.done]?.final?S.endings[R.done]:null;
  panel.classList.add('vd-conclusions');
  panel.innerHTML=(ending?`<article class="vd-case-resolution"><small>CASE OUTCOME · KẾT QUẢ VỤ ÁN</small><h3>${V.recordText(ending.title)}</h3><p>${V.recordText(ending.sum)}</p></article>`:'')+`<p class="se-mute">Conclusions as recorded at each chapter. Later evidence may settle an earlier open question.<span class="vd-vi">Suy luận được giữ theo thời điểm từng chương. Chứng cứ về sau có thể giải đáp điều trước đó còn bỏ ngỏ.</span></p>`+earned.map(c=>`<article class="vd-conclusion"><small>Recorded in Chapter ${+c.chapter||1} · Ghi ở Chương ${+c.chapter||1}</small><h3>${V.recordText(c.label)}</h3><div>${(c.sources||[]).filter(id=>R.items.includes(id)&&S.items[id]).map(id=>`<button class="se-btn sm" data-it="${esc(id)}">${E.itemArt(id,'sm')}<span>${V.recordText(S.items[id].name)}</span></button>`).join('')}</div></article>`).join('')+inferred.map(id=>`<button class="vd-record-card" data-it="${esc(id)}">${E.itemArt(id)}<span class="vd-record-copy"><small>Recorded in Chapter ${E.evidenceMeta(id).chapter} · Ghi ở Chương ${E.evidenceMeta(id).chapter}</small><b>${V.recordText(S.items[id].name)}</b><span>${V.recordText(E.evidenceMeta(id).brief)}</span></span></button>`).join('')+(!earned.length&&!inferred.length?'<p>No conclusions yet.<span class="vd-vi">Chưa có suy luận được ghi lại.</span></p>':'');
 };
 E.on('bookTab',({tab,panel,first})=>{if(!first)return;if(tab==='items')mountRecords(panel);else if(tab==='truths'&&!Object.keys(E.S().truths||{}).length)mountConclusions(panel);});
})();
/* Keep Enmi's original portrait overview; only add story-specific copy/actions. */
(() => {
 const E=StoryEngine,V=ValeDemo;
 V.decorateTitle=()=>{const panel=V.q('.se-panel.ov'),body=V.q('.se-ovb');if(!body)return;
  const meta=V.caseMeta(),has=E.hasRun(),blurb=body.querySelector('.se-ovd');
  if(blurb)blurb.innerHTML=V.bi(E.S().tagline||{en:'Investigate at your own pace.',vi:'Điều tra theo nhịp của bạn.'});
  const coverTitle=panel.querySelector('.se-ovt');if(coverTitle)coverTitle.insertAdjacentHTML('afterbegin',`<em>PART ${meta.part} · THE VALE DOSSIERS · 0.9.1</em>`);
  const me=body.querySelector('[data-mebox]');if(me)me.innerHTML='<div class="vd-mobile-intro"><b>You are Adrian Vale · Bạn là thám tử Adrian Vale</b><small>Male protagonist · Nhân vật nam, tên cố định</small><p>Observe, question and draw your own conclusions.<span class="vd-vi">Trực tiếp quan sát, hỏi chuyện và tự suy luận.</span></p></div>';
  // Native collection counts include intermediate chapter outcomes. Keep its
  // history/action intact and distinguish it from the four final case endings.
  const outcomes=body.querySelector('.se-ovend1>span>b');if(outcomes)outcomes.textContent=E.nat({en:'Chapter & case outcomes',vi:'Kết chương và kết vụ án'});
  body.querySelector('.se-ovn')?.remove();
  const start=body.querySelector('[data-go="new"]');if(start)start.innerHTML=has?'Begin again · Chơi lại':'Begin investigation · Bắt đầu điều tra';
  const cont=body.querySelector('[data-go="cont"]');if(cont)cont.innerHTML='Continue · Tiếp tục điều tra';
  body.insertAdjacentHTML('beforeend',`<div class="vd-title-links"><button class="se-btn" data-vd="guide">How to play · Cách chơi</button><button class="se-btn" data-vd="settings">Settings · Cài đặt</button><button class="se-btn" data-vd="routebook">Routes · Sơ đồ nhánh</button><button class="se-btn" data-vd="credits">Sources · Nguồn</button></div><p class="se-mute">${V.demoOnly?'Chapter 1 demo · 3 chapter outcomes<span class="vd-vi">Demo Chương 1 · 3 kết chương</span>':`Part ${meta.part} · ${meta.chapters} chapters · ${meta.endings} case endings<span class="vd-vi">Phần ${meta.part} · ${meta.chapters} chương · ${meta.endings} kết toàn vụ án</span>`}</p>`);
  panel.addEventListener('click',e=>{const a=e.target.closest('[data-vd]')?.dataset.vd;if(a){e.stopImmediatePropagation();V[a]?.();return;}if(e.target.closest('[data-go="new"]')){e.stopImmediatePropagation();has?V.restart():V.start();}},true);
 };
})();
/* Physical sound direction; no prose/branch/array changes. */
(() => {'use strict';const E=StoryEngine;
const cues={
'p1-c1-note-first':[[.18,'paper_open']], 'p1-c1-note-again':[[.20,'paper_slide']], 'p1-c1-note-set-down':[[.6,'paper_down']],
'p1-c1-remove-mask':[[.34,'cloth_move']], 'p1-c1-retainer-set-aside':[[.05,'coin_purse'],[.55,'cloth_move']], 'p1-c1-gloves-observed':[[.5,'cloth_move']], 'p1-c1-finn-cab-departs':[[.35,'horse_steps']],
'p1-c1-door-chain-opens':[[.30,'chain_latch'],[.45,'door_move']], 'p1-c1-door-wait':[[.60,'door_move']], 'p1-c1-invitation-handover':[[.20,'door_move'],[.48,'paper_fold']], 'p1-c1-door-final-close':[[.60,'door_move']],
'p1-c3-register-signed':[[.08,'pen_write']], 'p1-c4-frame-revealed':[[.25,'cabinet_slide']], 'p1-c4-frame-protected':[[.25,'cabinet_slide']], 'p1-c4-panel-closed':[[.65,'wood_down']], 'p1-c4-panel-returned':[[.65,'wood_down']], 'p1-c4-panel-taken':[[.35,'cabinet_slide'],[.75,'cloth_move']],
'p1-c5-cab-departs':[[.32,'horse_steps']], 'p1-c5-bell-receives-frame':[[.23,'chain_latch'],[.55,'frame_slide']], 'p1-c6-photo-face-down':[[.56,'wood_down']], 'p1-c6-photo-into-case':[[.55,'cloth_move']], 'p1-c6-empty-recess':[[.22,'cabinet_slide'],[.78,'wood_down']],
'p2-v06-correspondence-set-down':[[.8,'paper_down']], 'p2-v06-shutter-test':[[.27,'wood_down'],[.76,'door_move']], 'p2-v06-carrier-heel':[[.5,'frame_slide']],
'p3-v06-outer-gate':[[.40,'gate_latch']], 'p3-v06-observed-bark':[[.38,'dog_bark'],[.66,'dog_bark']], 'p3-v06-door-sound-check':[[.28,'door_move']], 'p3-v06-private-letters-stored':[[.48,'cabinet_slide']], 'p3-v06-horse-forehead':[[.5,'cloth_move']]};
// Stable authored paths: shortening or translating a line must never silence it.
// A motion's timed sounds take precedence over the fallback line-level foley.
const passageCues={
 'vale-dossiers-p1c1-v01':[
  [['nodes','c1_terms',3,'choice',0,'then',0],'pen_write'],
  [['nodes','c1_terms',3,'choice',0,'then',3],'pen_write'],
  [['nodes','c1_open',15,'place','views','desk','zones',1,'then',2],'paper_fold'],
  [['nodes','c1_open',15,'place','views','window','zones',0,'then',1],'cloth_move'],
  [['nodes','c1_open',15,'place','views','door','zones',0,'then',1],'paper_fold'],
  [['nodes','c5_possession',3,'then',1,'choice',1,'then',3],'paper_fold']
 ],
 'vale-dossiers-part2-v01':[
  [['nodes','p2c1_open',17],'paper_open'],
  [['nodes','p2c1_open',32],'paper_slide'],
  [['nodes','p2c6_open',14],'paper_fold']
 ],
 'vale-dossiers-part3-v01':[
  [['nodes','p3c4_open',17],'paper_slide'],
  [['nodes','p3c5_true_route',7],'bell_soft']
 ]
};
passageCues['vale-dossiers-chapter1-demo03']=passageCues['vale-dossiers-p1c1-v01'];
const at=(value,path)=>path.reduce((v,key)=>v?.[key],value);
function walk(v,fn){if(!v||typeof v!=='object')return;fn(v);for(const[k,x]of Object.entries(v))if(!['motion','interrogation'].includes(k))walk(x,fn);}
function apply(){const S=E.S();if(!S?.id?.startsWith('vale-dossiers'))return;const g=E.G().set;if(!Number.isFinite(g.ambLevel))g.ambLevel=.65;if(!Number.isFinite(g.sfxLevel))g.sfxLevel=.70;
 for(const[id,sc]of Object.entries(S.scenes||{}))if(sc.amb==='rain'&&(['study','hall','room'].includes(sc.kind)||id==='carriage'))sc.amb='rainInside';
 for(const tree of[S.nodes,S.places,S.talks])walk(tree,st=>{const list=cues[st.motion?.id];if(list)st.motion.sounds=list.map(([at,cue])=>({at,cue}));});
 for(const[path,cue]of passageCues[S.id]||[]){const st=at(S,path);if(!st)continue;if(st.motion?.sounds?.length){if(st.foley===cue)delete st.foley;}else st.foley=cue;}
 E.sound.refresh?.();}
const later=()=>queueMicrotask(apply);E.on('boot',later);E.on('chapter',later);
})();
/* Vale 0.8 authored context/outcome metadata. Story indices and voice keys are preserved. */
globalThis.ValeV8Config = {"contexts":{"c1_open":[{"at":0,"present":["reed"],"objective":{"en":"Open and read the letter before the visitor arrives.","vi":"Mở và đọc thư trước khi vị khách đến."}}],"c1_departure":[{"at":0,"present":["reed"]}],"c1_observe":[{"at":0,"present":["reed"]}],"c2_open":[{"at":0,"present":["reed"]}],"c3_board":[{"at":0,"present":["reed"]}],"c4_open":[{"at":0,"present":["reed"]}],"c4_exit":[{"at":0,"present":["reed"]}],"c5_open":[{"at":0,"present":["reed"]},{"at":4,"present":["reed","c5_walker"],"beat":{"en":"Back at your own doorway. A passer-by greets you; you do not yet know who it is.","vi":"Về đến cửa nhà mình. Một người đi đường chào bạn; bạn chưa biết danh tính người đó."}},{"at":9,"present":["reed"],"beat":{"en":"The passer-by has moved on. Reed remains beside you at your doorway.","vi":"Người đi đường đã đi tiếp. Reed vẫn ở cạnh bạn bên cửa nhà."}}],"c5_follow":[{"at":0,"present":["reed"]}],"c5_desk":[{"at":0,"present":["reed"]}],"c5_possession":[{"at":0,"present":["reed"]}],"c5_return":[{"at":0,"present":["bell"],"beat":{"en":"At Wren House, returning the photograph to Mrs Bell. Reed is waiting back at your rooms.","vi":"Tại nhà Wren, trả ảnh cho bà Bell. Reed đang đợi ở văn phòng của bạn."}},{"at":11,"present":["reed"],"beat":{"en":"Back at your rooms. The receipt, not a new conversation with Celia, is what you bring to Reed.","vi":"Trở lại văn phòng. Bạn mang biên nhận cho Reed, không phải lời kể về cuộc gặp Celia."}}],"c5_plan":[{"at":0,"present":["reed"]}],"c5_close":[{"at":0,"present":["reed"]}],"c1_account":[{"at":0,"present":["reed","matthias"]}],"c1_questions":[{"at":0,"present":["reed","matthias"]}],"c1_review":[{"at":0,"present":["reed","matthias"]}],"c1_arrival":[{"at":0,"present":["reed"]},{"at":1,"present":["reed","matthias"],"beat":{"en":"A visitor at the doorway. Reed stays beside the notebook.","vi":"Một vị khách xuất hiện ở cửa. Reed vẫn ở bên cuốn sổ."}}],"c1_terms":[{"at":0,"present":["reed","matthias"]},{"at":8,"present":["reed"],"beat":{"en":"The client has left. You and Reed prepare to investigate.","vi":"Khách hàng đã rời đi. Bạn và Reed chuẩn bị điều tra."}}],"c1_neighbourhood":[{"at":0,"present":["reed"]},{"at":2,"present":["reed","finn"],"beat":{"en":"You approach the cab driver; Wren House remains across the street.","vi":"Bạn đến gần người đánh xe; nhà Wren vẫn ở bên kia đường."}}],"c1_direct":[{"at":0,"present":["reed"]},{"at":4,"present":["reed","bell"],"beat":{"en":"The housekeeper answers from behind the chained door. You are still outside.","vi":"Quản gia đáp lời sau cánh cửa cài xích. Bạn vẫn ở bên ngoài."}}],"c2_call":[{"at":0,"present":["reed","bell"]},{"at":1,"present":["reed","celia"]},{"at":8,"present":["reed","celia","hart"],"beat":{"en":"Hart steps out of the hall. Finn answers him from his cab outside.","vi":"Hart từ hành lang bước ra. Finn đáp lời từ xe ngựa bên ngoài."}},{"at":12,"present":["reed","celia","hart"],"beat":{"en":"You remain at the front steps. Finn answers from his cab out in the street.","vi":"Bạn vẫn ở bậc cửa trước. Finn đáp từ xe ngựa ngoài đường."}},{"at":19,"present":["reed"]}],"c3_open":[{"at":0,"present":["reed","finn"]},{"at":9,"present":["reed","celia","hart","c3_clerk"],"beat":{"en":"Inside the chapel. Reed stays with you as the couple prepares.","vi":"Trong nhà nguyện. Reed đi cùng bạn khi đôi nam nữ chuẩn bị."}},{"at":26,"present":["reed","celia","hart"]},{"at":48,"present":["reed"]}],"c4_open_visit":[{"at":0,"present":["reed","bell"]},{"at":3,"present":["reed","celia","hart"],"beat":{"en":"You have been invited into the parlour; Hart joins the discussion.","vi":"Bạn được mời vào phòng khách; Hart cùng tham gia trao đổi."}}],"c4_open_explore":[{"at":0,"present":["reed","celia","hart"]}],"c4_disguise":[{"at":0,"present":["reed"]},{"at":2,"present":["celia"],"beat":{"en":"Outside Wren House. Reed is following the agreed plan from the street.","vi":"Ngoài nhà Wren. Reed đang thực hiện kế hoạch từ ngoài phố."}},{"at":6,"present":["celia","bell"],"beat":{"en":"Inside the parlour. Reed is outside, not beside your chair.","vi":"Trong phòng khách. Reed ở ngoài phố, không đứng cạnh ghế của bạn."}}],"c4_alarm_explore":[{"at":0,"present":[],"beat":{"en":"The room is briefly unattended. Reed remains outside.","vi":"Phòng tạm thời vắng người. Reed vẫn ở bên ngoài."}},{"at":2,"present":["celia"],"beat":{"en":"Celia returns before you leave the chair.","vi":"Celia quay lại trước khi bạn đứng dậy."}}],"c6_open":[{"at":0,"present":["reed","matthias"]}],"c6_truth":[{"at":0,"present":["reed","matthias"]}],"c6_open_file":[{"at":0,"present":["reed","matthias","bell"]},{"at":3,"present":["reed"],"beat":{"en":"Back at your rooms. The unsupported recommendation remains in your file.","vi":"Trở lại văn phòng. Nhận định chưa đủ căn cứ vẫn còn trong hồ sơ."}}],"c6_delivery":[{"at":0,"present":["reed","matthias"]}],"c6_visit":[{"at":0,"present":["reed","matthias"]},{"at":4,"present":["reed","matthias","bell"]}],"c6_terms":[{"at":0,"present":["reed","matthias"]},{"at":4,"present":["reed","matthias","celia","hart","c3_clerk"],"beat":{"en":"At Wren House for the agreement. Pike is present as the independent witness and keeper of the sealed packet.","vi":"Đến nhà Wren ký thỏa thuận. Pike là người làm chứng độc lập, nhận giữ gói niêm phong."}},{"at":17,"present":["reed"],"beat":{"en":"Back at your desk after the signing. The agreement and receipt close this route.","vi":"Về bàn làm việc sau buổi ký. Thỏa thuận và biên nhận khép lại tuyến này."}}],"p2c1_open":[{"at":0,"present":["reed"]},{"at":9,"present":["reed","lydia"]}],"p2c2_open":[{"at":0,"present":["reed","lydia"]}],"p2c3_open":[{"at":0,"present":["reed","lydia","rusk"]},{"at":19,"present":["reed","lydia"],"beat":{"en":"You have stepped back into the corridor. Rusk stays in his study.","vi":"Bạn đã trở ra hành lang. Rusk ở lại phòng làm việc."}},{"at":35,"present":["reed"],"beat":{"en":"Lydia goes to wait with Ruth. You and Reed prepare to inspect Alice’s old room.","vi":"Lydia đi chờ cùng Ruth. Bạn và Reed chuẩn bị khám phòng cũ của Alice."}}],"p2c4_open":[{"at":0,"present":["reed","lydia"]},{"at":11,"present":["reed"],"beat":{"en":"You inspect the bedroom. Lydia waits with Ruth in the corridor.","vi":"Bạn khám phòng ngủ. Lydia chờ cùng Ruth ngoài hành lang."}},{"at":13,"present":["reed","ruth"]},{"at":21,"present":["reed"]},{"at":25,"present":["reed","owen"]},{"at":34,"present":["reed"]},{"at":37,"present":["reed","lydia"]},{"at":40,"present":["reed"]}],"p2c5_open":[{"at":0,"present":["reed"]},{"at":9,"present":["reed","lydia"]}],"p2c5_watch":[{"at":0,"present":["reed","lydia"]},{"at":8,"present":[],"beat":{"en":"You watch the empty room. Reed and the constable are nearby; Lydia is elsewhere, safe.","vi":"Bạn canh căn phòng trống. Reed và cảnh sát ở gần; Lydia được bảo vệ ở nơi khác."}}],"p2c5_observe":[{"at":0,"present":[]},{"at":1,"present":[],"beat":{"en":"You retreat into the corridor and call Reed.","vi":"Bạn lùi ra hành lang, gọi Reed."}},{"at":3,"present":["reed"],"beat":{"en":"Reed returns with the constable. Stay outside the room.","vi":"Reed trở lại cùng cảnh sát. Mọi người đứng ngoài phòng."}},{"at":6,"present":["reed","rusk"]}],"p2c5_withdraw":[{"at":0,"present":["reed","lydia","ruth"]},{"at":6,"present":["reed"]}],"p2c5_intervene":[{"at":0,"present":["reed","lydia","ruth"]},{"at":5,"present":["reed","lydia","ruth","rusk"]},{"at":13,"present":["reed","ruth","rusk"],"beat":{"en":"Lydia leaves through the front door with her own key. The complaint stays on record.","vi":"Lydia rời đi qua cửa trước, giữ chìa khóa của mình. Lời trình bày đã được ghi vào hồ sơ."}}],"p2c5_close":[{"at":0,"present":["reed"],"beat":{"en":"Lydia and Ruth are safe elsewhere. You and Reed finish the night’s record.","vi":"Lydia và Ruth đã an toàn ở nơi khác. Bạn và Reed hoàn tất hồ sơ buổi tối."}}],"p2c6_open":[{"at":0,"present":["reed","lydia","ruth"]}],"p2c6_report":[{"at":0,"present":["reed","lydia","ruth"]}],"p2c6_caution":[{"at":0,"present":["reed","lydia","ruth"]}],"p2c6_true":[{"at":0,"present":["reed","lydia","ruth"]}],"p2c6_overreach":[{"at":0,"present":["reed","lydia","ruth"]},{"at":4,"present":["reed"],"beat":{"en":"Lydia leaves safely with Ruth. Reed closes the file while the conclusion remains disputed.","vi":"Lydia rời đi an toàn cùng Ruth. Reed khép hồ sơ; kết luận vẫn bị chất vấn."}}],"p2c6_after_true":[{"at":0,"present":["reed"],"beat":{"en":"Two weeks later, back at Vale’s rooms. Lydia’s words arrive by letter.","vi":"Hai tuần sau, tại văn phòng Vale. Lời của Lydia đến qua thư."}}],"p2c6_safe":[{"at":0,"present":["reed","lydia","ruth"]},{"at":5,"present":["reed"]}],"p2c6_intervention":[{"at":0,"present":["reed","lydia","ruth"]},{"at":3,"present":["reed","lydia","ruth","rusk"]},{"at":4,"present":["reed"]}],"p3c1_open":[{"at":0,"present":["reed"]},{"at":7,"present":["reed","elin"]},{"at":17,"present":["reed","ben","nora"]},{"at":22,"present":["reed"]}],"p3c2_open":[{"at":0,"present":["reed"]},{"at":17,"present":["reed","dorn"],"beat":{"en":"The trail has brought you to Dorn’s yard. This is a new conversation, not proof of guilt.","vi":"Dấu vết đưa bạn đến sân của Dorn. Đây là cuộc hỏi chuyện mới, chưa phải bằng chứng có tội."}},{"at":26,"present":["reed"]},{"at":32,"present":["reed"]}],"p3c3_open":[{"at":0,"present":["reed","ben"]},{"at":11,"present":["reed","ben","nora"],"beat":{"en":"In the stable yard: compare the observations before entering the office.","vi":"Trong sân trại: đối chiếu điều quan sát được trước khi vào văn phòng."}},{"at":14,"present":["reed","ben"]},{"at":19,"present":["reed","elin"],"beat":{"en":"Inside the office with Lady Wycliffe. Ben is waiting outside.","vi":"Vào văn phòng cùng phu nhân Wycliffe. Ben đang đợi bên ngoài."}},{"at":30,"present":["reed","ben"],"beat":{"en":"Back outside in the yard. You give Ben the corrected report.","vi":"Trở ra sân. Bạn đưa Ben báo cáo đã đính chính."}}],"p3c4_open":[{"at":0,"present":["reed"]},{"at":9,"present":["reed","nora"]},{"at":27,"present":["reed","elin"],"beat":{"en":"Back in the office. You must now choose how to divide the morning’s work.","vi":"Trở vào văn phòng. Bạn cần chọn cách phân chia công việc sáng mai."}}],"p3c5_open":[{"at":0,"present":["nora","dorn"],"beat":{"en":"At Greybank with Nora and the constable. Reed may be working on the documents elsewhere.","vi":"Tại Greybank cùng Nora và cảnh sát. Reed có thể đang xử lý giấy tờ ở nơi khác."}}],"p3c5_supported":[{"at":0,"present":["nora","dorn"]}],"p3c5_accuse":[{"at":0,"present":["nora","dorn"]},{"at":1,"present":["reed","nora","dorn"],"beat":{"en":"Reed joins the discussion before you commit to the final report.","vi":"Reed tham gia trao đổi trước khi bạn chốt báo cáo cuối."}}],"p3c5_true_route":[{"at":0,"present":["nora","elin","ben"]},{"at":7,"present":["reed","elin","ben"]},{"at":11,"present":["reed"]}],"p3c5_late_route":[{"at":0,"present":["elin","ben"]},{"at":9,"present":["reed"]}],"p3c5_recovery_route":[{"at":0,"present":["nora","dorn"]},{"at":3,"present":["ben"],"beat":{"en":"Back in the stable yard with Ben and the recovered horse.","vi":"Trở lại sân trại cùng Ben và con ngựa đã tìm được."}},{"at":6,"present":["ben"]},{"at":7,"present":["reed","ben"],"beat":{"en":"Reed joins the close of the investigation, keeping the death inquiry open.","vi":"Reed tham gia tổng kết, để cuộc điều tra cái chết tiếp tục."}}],"p3c5_wrong_route":[{"at":0,"present":["nora","dorn"]},{"at":3,"present":["reed"]}]},"beats":{"c1_review":[0,"Compare the client’s accusation with what he actually witnessed. A claim is not yet a fact.","Đối chiếu lời buộc tội với điều khách hàng thực sự biết. Lời khai chưa phải sự thật."],"c5_desk":[3,"Check one sentence at a time. Keep the greeting separate from the stranger’s unconfirmed identity.","Kiểm tra từng câu. Tách lời chào bạn nghe được khỏi danh tính chưa được xác nhận."],"c4_open":[7,"The next decision changes your method and its consequences, not just the wording of your reply.","Quyết định sắp tới đổi cách điều tra và hậu quả, không chỉ đổi cách trả lời."],"p3c4_open":[37,"The deadline is part of the choice. Delegating, verifying in person and recovering first lead to different outcomes.","Hạn chót là một phần lựa chọn. Phân công, tự đi xác minh và ưu tiên tìm ngựa có thể dẫn tới các kết khác nhau."]},"endings":{"c6_true":["true","TRUE ENDING","Kết chân thực","You verified the final evidence and limited the report to what it supports.","Bạn xác minh chứng cứ cuối cùng và chỉ báo cáo điều có căn cứ."],"c6_settlement":["good","GOOD ENDING","Kết thỏa thuận","You chose a witnessed agreement rather than treating recovery as the only solution.","Bạn chọn thỏa thuận có người chứng kiến, thay vì xem lấy lại ảnh là cách giải quyết duy nhất."],"c6_client":["mixed","MIXED ENDING","Kết được–mất","The photograph was delivered, but the means of obtaining it remain part of the result.","Ảnh đã được giao, nhưng cách lấy ảnh vẫn là một phần kết quả."],"c6_unresolved":["bad","BAD ENDING","Kết bất lợi","You maintained an accusation beyond the evidence after having a chance to revise it.","Bạn giữ lời buộc tội vượt quá chứng cứ dù có cơ hội sửa."],"p2_true":["true","TRUE ENDING","Kết chân thực","The night route was observed and the report keeps the earlier death open for inquiry.","Đường vào trong đêm được quan sát; báo cáo vẫn để cái chết trước đó tiếp tục được điều tra."],"p2_safe":["good","GOOD ENDING","Rút đi an toàn","You protected Lydia without claiming to have observed the unobserved method.","Bạn bảo vệ Lydia mà không khẳng định đã chứng kiến phương thức chưa được quan sát."],"p2_intervention_end":["good","GOOD ENDING","Can thiệp bảo vệ","You prevented the arrangement openly. Protection succeeded; the method remains unproved.","Bạn công khai ngăn việc sắp xếp. Đã bảo vệ được người; phương thức chưa được chứng minh."],"p2_overreach":["bad","BAD ENDING","Báo cáo vượt chứng cứ","Lydia is safe, but you kept a stronger conclusion than the evidence supports.","Lydia an toàn, nhưng bạn giữ kết luận mạnh hơn điều chứng cứ xác lập."],"p3c5_true":["true","TRUE ENDING","Kết chân thực","The horse returned in time, and the two incidents received separate supported explanations.","Ngựa về kịp hạn; hai sự việc có lời giải riêng, được chứng cứ hỗ trợ."],"p3c5_recovery":["open","OPEN ENDING","Tìm lại ngựa, hồ sơ mở","You recovered the horse and deliberately left the death inquiry open.","Bạn tìm lại ngựa và chủ động để cuộc điều tra cái chết tiếp tục."],"p3c5_late":["mixed","MIXED ENDING","Có lời giải, lỡ hạn","Your chosen order secured the explanation but missed the registration deadline.","Thứ tự công việc bạn chọn giúp xác minh lời giải nhưng lỡ hạn đăng ký."],"p3c5_accusation":["bad","BAD ENDING","Buộc tội thiếu căn cứ","You treated concealment as proof of a killing despite contrary evidence.","Bạn coi giấu ngựa là bằng chứng giết người bất chấp chứng cứ trái lại."]},"motions":[["c1_review",0,"reed","","concerned","r"],["c1_terms",0,"matthias","unmasked","resolute","l"],["c2_call",6,"celia","","smiling","c"],["c3_open",44,"celia","smiling","resolute","c"],["c4_open",7,"reed","","concerned","c"],["c4_open_visit",6,"hart","","smiling","r"],["c4_exit",7,"reed","concerned","","c"],["c5_desk",3,"reed","","concerned","c"],["c6_truth",1,"reed","concerned","smiling","r"],["p2c2_open",17,"lydia","","calm","c"],["p2c3_open",21,"lydia","","resolute","r"],["p2c4_open",18,"ruth","","","c"],["p2c5_withdraw",6,"reed","concerned","","l"],["p2c6_after_true",7,"reed","","smiling","c"],["p2c6_overreach",0,"reed","","concerned","l"],["p3c3_open",18,"ben","","calm","c"],["p3c3_open",33,"ben","calm","relieved","c"],["p3c4_open",30,"elin","","concerned","c"],["p3c5_open",14,"dorn","","uneasy","r"],["p3c5_recovery_route",5,"ben","calm","relieved","c"],["p3c5_wrong_route",5,"reed","","concerned","c"]],"remote":{"p2c3_open:25":{"rusk":{"en":"Rusk — at the study doorway","vi":"Rusk — ở cửa phòng làm việc"}},"p2c6_open:7":{"rusk":{"en":"Rusk — supervised nearby","vi":"Rusk — đang được giám sát gần đó"}},"c2_call:13":{"finn":{"en":"Finn — from his cab in the street","vi":"Finn — từ xe ngựa ngoài đường"}}},"hints":{"c5_desk":[{"en":"Separate three questions: what you saw, whether someone knew your name, and whether you knew their identity.","vi":"Tách ba câu hỏi: bạn đã thấy gì, có ai biết tên bạn không, và bạn đã biết danh tính họ chưa."},{"en":"A greeting can establish that your name was spoken. It cannot, on its own, establish who the speaker really was.","vi":"Lời chào xác lập rằng tên bạn đã được gọi. Chỉ riêng nó chưa xác lập người nói thực sự là ai."}],"p3c3_open":[{"en":"Separate falling asleep from choosing to sleep. Which observation speaks to the cause, rather than the suspicion?","vi":"Tách việc ngủ thiếp đi khỏi cố ý ngủ. Quan sát nào nói về nguyên nhân, thay vì chỉ là nghi ngờ?"},{"en":"A medical finding can challenge a claim about voluntary behaviour. It does not automatically identify who caused the condition.","vi":"Kết quả khám có thể bác nhận định về hành vi tự nguyện. Nó không tự động chỉ ra ai đã gây tình trạng ấy."}]}};
/* Vale 0.8: opt-in UX on the original Enmi player. No story arrays or save IDs change.
 * Context is authored, not inferred from camera visibility. Route journal records
 * events from this run only. Existing saves get a labelled reconstructed prefix.
 */
(() => {
'use strict';
const E=StoryEngine,V=ValeDemo,C=ValeV8Config,q=s=>document.querySelector(s),esc=E.esc;
const nat=t=>E.nat(t), copy=t=>V.recordText?V.recordText(t):esc(nat(t));
const fid=x=>x.id||(x.kind==='opt'?x.key+':'+x.val:'');
const part=()=>V.caseMeta().part;
const currentFrame=()=>[...(E.R()?.stack||[])].reverse().find(f=>C.contexts[f.n]);
const motionOK=()=>!E.auto&&E.G().set.motion!=='reduced'&&(E.G().set.motion==='full'||!matchMedia('(prefers-reduced-motion: reduce)').matches);
const name=id=>id==='me'?'Adrian Vale':E.S().chars[id]?E.cname(E.S().chars[id],true):id;
let context=null,beat=null,lastSection='',lastRun=null,lastSpeaker='',lastBeat='',bar=null;
const outcome=id=>{const a=C.endings[id];return a?{kind:a[0],label:a[1],vi:a[2],reason:{en:a[3],vi:a[4]}}:null;};
V.outcomeInfo=outcome;
function seedJournal(){
 const R=E.R(),S=E.S();if(R.v8route)return R.v8route;
 const prefix=(S.flow||[]).filter(x=>x.kind==='cp'?R.passed?.[x.id]:x.kind==='opt'?R.f[x.key]===x.val:R.chapterEnds?.[x.ch]===x.id||R.done===x.id);
 R.v8route=prefix.map(x=>({id:fid(x),ch:x.ch,scene:x.scene||R.scene,reconstructed:true}));return R.v8route;
}
function record(x){
 if(!x)return;const R=E.R(),a=seedJournal(),id=fid(x),previous=a.at(-1);
 if(previous?.id===id&&previous?.ch===x.ch)return;
 // First encounter after a legacy save may already be in its reconstructed prefix.
 if(a.some(z=>z.id===id&&z.reconstructed))return;
 a.push({id,ch:x.ch??R.ch,scene:x.scene||R.scene});
}
function sceneFor(S,x){
 if(x.scene&&S.scenes[x.scene])return x.scene;
 let found=null;
 for(const steps of Object.values(S.nodes||{})){
  let scene=null;
  for(const st of steps){if(st.bg)scene=st.bg;if(st.scene)scene=st.scene;if(st.cp===x.id){found=scene;break;}}
  if(found)break;
 }
 const byPart=part()==='I'?['','study','c2_lane_day','c3_chapel','c4_study','c5_study','c6_study']:part()==='II'?['','study','p2_house','p2_study','p2_room','p2_house_evening','p2_house_dawn']:['','p3_yard','p3_moor','p3_office','p3_office','p3_dorn_yard'];
 return found||byPart[x.ch]||S.titleScene||Object.keys(S.scenes)[0];
}
function extraFlow(S){
 const add=(ch,row,key,vals)=>{for(const [val,en,vi]of vals){if(!S.flow.some(x=>x.kind==='opt'&&x.key===key&&x.val===val))S.flow.push({ch,row,kind:'opt',key,val,label:{en,vi}});}};
 if(part()==='II'){
  add(1,.5,'p2_approach',[['safety','Arrange safety first','Thu xếp an toàn trước'],['together','Visit together','Cùng đến thăm']]);
  add(2,.5,'p2_first_question',[['repairs','Ask about repairs','Hỏi về sửa chữa'],['papers','Read the papers first','Đọc giấy tờ trước']]);
  add(5,.5,'p2_plan_choice',[['watch','Watch with safeguards','Canh phòng có bảo vệ'],['withdraw','Leave safely','Rời đi an toàn'],['intervene','Intervene openly','Can thiệp công khai']]);
 }
 if(part()==='III'){
  add(1,.5,'p3_first',[['ground','Follow the ground','Đọc dấu vết trên đất'],['records','Preserve the records','Giữ hồ sơ trước']]);
  add(2,1.5,'p3_dorn_approach',[['quiet','Request cooperation','Đề nghị hợp tác'],['watched','Ask for a watch','Nhờ canh chừng']]);
  add(3,1.5,'p3_public_claim',[['limited','Keep the report limited','Giới hạn nội dung báo cáo'],['accuse','Make a public accusation','Công khai buộc tội']]);
  add(4,1.5,'p3_priority',[['both','Divide the work','Phân công hai việc'],['explanation','Verify in person first','Tự xác minh trước'],['recovery','Recover the horse first','Tìm ngựa trước']]);
 }
 // Only choices already loaded are visible in the source lazy-loading build.
 S.flow=S.flow.filter(x=>x.kind!=='opt'||S.chapters.some(c=>c.ch===x.ch)&&Object.values(S.nodes).some(a=>JSON.stringify(a).includes('"'+x.key+'"')));
 for(const x of S.flow){x.scene=sceneFor(S,x);if(x.id==='c6_start')x.to=['c6_house','c6_settlement','c6_client'];if(x.id==='c6_house')x.to=['c6_true','c6_unresolved'];}
}
function install(){
 const S=E.S();if(!S||!/^vale-dossiers/.test(S.id))return;
 S.playability={...(S.playability||{}),inlineEvidence:true};
 extraFlow(S);
 const p1=S.nodes.c5_desk?.find(s=>s.present)?.present;
 if(p1){p1.shortlist=['c5_greeting','c5_description','c5_follow','c3_cuff','c3_name_trace','c4_photo_seen'];p1.feedbackWho='reed';p1.hints=C.hints.c5_desk;}
 const p3=S.nodes.p3c3_open?.find(s=>s.present)?.present;
 if(p3){p3.shortlist=['p3_meal','p3_last_seen','p3_night_silence','p3_dog_baseline','p3_quill_account','p3_tracks'];p3.feedbackWho='reed';p3.hints=C.hints.p3c3_open;}
 for(const [n,i,who,from,to,at]of C.motions){const st=S.nodes[n]?.[i];if(!st||!st.n||st.motion)continue;
  if(to&&!E.hasArt('im-'+who+'-'+to))continue;
  // No show:true: a camera cut must not conjure an absent character.
  st.motion={id:'vale08-'+n+'-'+i,ms:1200,actors:[{id:who,at,frames:[{offset:0,face:from},{offset:.6,face:to},{offset:1,face:to}]}]};
 }
}
function activeTalk(){
 // Presence follows the actual named/inline conversation owner, never a
 // quoted name or a stale last-speaker label from the surrounding scene.
 const S=E.S(),resolve=spec=>typeof spec==='string'?S.talks?.[spec]:spec;
 for(const frame of [...(E.R()?.stack||[])].reverse()){
  if(frame.n==='@talks'){
   const talk=resolve(S.talks?.[frame.p?.[0]]);
   if(talk?.with&&S.chars[talk.with])return talk;
  }
  let value=frame.n[0]==='@'?S[frame.n.slice(1)]:S.nodes[frame.n];
  for(const key of frame.p||[]){
   value=value?.[key];
   if(key==='talk'){
    const talk=resolve(value);
    if(talk?.with&&S.chars[talk.with])return talk;
   }
  }
 }
 const a=V.active;
 if(a?.type==='talk'){
  const st=E.walk({n:a.n,p:JSON.parse(a.p)})?.[a.i],talk=resolve(st?.talk);
  if(talk?.with&&S.chars[talk.with])return talk;
 }
 return null;
}
function activeContext(){
 const f=currentFrame();if(!f)return null;
 const i=Number.isInteger(f.p?.[0])?f.p[0]:Math.max(0,f.i-1),entries=C.contexts[f.n],a=[...entries].reverse().find(x=>x.at<=i)||entries[0];
 const present=[...a.present];
 const backInside=f.n==='p2c3_open'&&i===25&&f.p?.[1]==='then'&&E.R().scene==='p2_study';
 if(backInside&&!present.includes('rusk'))present.push('rusk');
 if(f.n==='p3c5_recovery_route'&&i===6){const who=E.R().f.p3_on_time?'nora':'elin';if(!present.includes(who))present.push(who);}
 if(f.n==='p3c5_supported'&&E.R().f.p3_public_claim==='accuse'&&!present.includes('reed'))present.push('reed');
 const remote={...(C.remote?.[f.n+':'+i]||{})},talk=activeTalk();
 // The optional follow-up actually returns to the study. The other branch
 // stays in the corridor and keeps Rusk's doorway/offstage label.
 if(backInside)delete remote.rusk;
 if(f.n==='c5_open'&&i===13&&f.p?.[1]==='choice'&&f.p?.[2]===1){
  remote.c5_walker={en:'Passer-by — farther down the street',vi:'Người đi đường — từ phía cuối phố'};
 }
 if(talk&&!remote[talk.with]&&!present.includes(talk.with))present.push(talk.with);
 return{...a,...(backInside?{beat:{en:'Back inside the study for the agreed follow-up. Rusk is here with you, Reed and Lydia.',vi:'Trở vào phòng làm việc để hỏi thêm như đã thống nhất. Rusk ở đây cùng bạn, Reed và Lydia.'}}:{}),present,node:f.n,index:i,section:f.n+':'+a.at+(backInside?':study-return':''),remote,conversationWith:talk?.with||null};
}
const statedGoal=spec=>{
 if(!spec||typeof spec!=='object')return null;
 for(const key of ['goal','prompt','q']){const value=spec[key];if(value&&typeof value!=='function')return value;}
 return null;
};
function mechanicGoal(st){
 for(const kind of ['place','explore','talk']){
  let spec=st?.[kind];
  if(typeof spec==='string')spec=E.S()[kind==='talk'?'talks':'places']?.[spec];
  const goal=statedGoal(spec);if(goal)return goal;
 }
 return null;
}
function inheritedObjective(){
 // A line inside an inspection or conversation keeps the current activity's
 // goal. Follow inline paths and shared @places/@talks without revealing a
 // later chapter summary while the player is still examining a detail.
 const S=E.S();
 for(const f of [...(E.R().stack||[])].reverse()){
  let value=f.n[0]==='@'?S[f.n.slice(1)]:S.nodes[f.n];const owners=[];
  for(const [i,key]of f.p.entries()){
   value=value?.[key];
   if(['place','explore','talk'].includes(key)||(i===0&&['@places','@talks'].includes(f.n)))owners.push(value);
  }
  for(const owner of owners.reverse()){const goal=statedGoal(owner);if(goal)return goal;}
  const goal=mechanicGoal(E.walk(f)?.[Math.max(0,f.i-1)]);if(goal)return goal;
 }
 return null;
}
function objective(){
 const R=E.R(),a=V.active,type=a?.type,st=a?E.walk({n:a.n,p:JSON.parse(a.p)})?.[a.i]:null;
 const own=statedGoal(st?.[type])||statedGoal(st)||mechanicGoal(st);
 if(own)return own;
 const inherited=inheritedObjective();if(inherited)return inherited;
 const tasks={place:{en:'Explore the scene. Inspect a detail, then use Back before moving on.',vi:'Khám cảnh. Chạm chi tiết để xem; dùng Lùi trước khi đi tiếp.'},explore:{en:'Inspect the marked details; leaving early may preserve unanswered questions.',vi:'Khám các điểm được đánh dấu; rời sớm có thể để lại câu hỏi chưa giải.'},present:{en:'Check a statement, narrow the records, then present one contradiction.',vi:'Chọn lời khai, lọc hồ sơ, rồi đưa một chứng cứ trực tiếp mâu thuẫn.'},caseboard:{en:'Connect two records that support one conclusion. A shared name is not enough.',vi:'Nối hai hồ sơ cùng hỗ trợ một kết luận. Trùng tên chưa đủ.'},board:{en:'Compare the records and build only supported connections.',vi:'Đối chiếu hồ sơ và chỉ nối những liên hệ có căn cứ.'},reconstruct:{en:'Arrange the known events. Keep observation separate from assumption.',vi:'Sắp xếp những sự kiện đã biết. Tách quan sát khỏi giả định.'},deduce:{en:'Choose the records that jointly support the proposed conclusion.',vi:'Chọn các hồ sơ cùng hỗ trợ cho kết luận đang xét.'},choice:{en:'Choose your next question or action. Read any stated consequence first.',vi:'Chọn câu hỏi hoặc hành động. Đọc hệ quả được nêu trước khi quyết định.'}};
 return tasks[type]||activeContext()?.objective||E.S().chapters.find(c=>c.ch===R.ch)?.sum||E.S().me?.goal;
}
function syncContext(){
 if(!bar)return;const R=E.R(),active=activeContext(),mode=q('.se')?.dataset.m;
 bar.hidden=!active||mode==='ov'||!!q('.se-end')||!!R.done;
 if(!active)return;context=active;
 const ids=[...new Set(['me',...active.present,...(lastSpeaker&&lastSpeaker!=='me'&&E.S().chars[lastSpeaker]?[lastSpeaker]:[])])];
 // Speaker is labelled separately if not in the authored on-location group.
 const present=['me',...active.present].map(name).join(' · '),speaking=lastSpeaker&&lastSpeaker!=='me'&&!active.present.includes(lastSpeaker)?name(lastSpeaker):'';
 bar.querySelector('.v8-presence').textContent=nat({en:'With you: ',vi:'Có mặt: '})+present+(speaking?' · '+(active.remote?.[lastSpeaker]?nat(active.remote[lastSpeaker]):nat({en:'Speaking: ',vi:'Đang nói: '})+speaking):'');
 bar.querySelector('.v8-mission').textContent=nat(objective())||'';
 if(active.section!==lastSection){lastSection=active.section;beat=active.beat||null;lastBeat=active.section;}
 const custom=C.beats[active.node];if(custom&&active.index===custom[0]){beat={en:custom[1],vi:custom[2]};lastBeat=active.node+':custom';}
 bar.dataset.mode=V.active?.type||'read';
 const location=E.S().scenes[R.scene]||{};bar.title=[nat(location.name),nat(location.time),present].filter(Boolean).join(' · ');
 const cue=bar.querySelector('.v8-cue');cue.textContent=beat?nat(beat):'';cue.hidden=!beat;

}
V.sceneBrief=()=>{
 const S=E.S(),R=E.R(),a=activeContext(),sc=S.scenes[R.scene]||{},present=['me',...(a?.present||[])];
 const sh=E.ui.sheet(nat({en:'Scene & objective',vi:'Bối cảnh & mục tiêu'}),`<div class="v8-brief"><small>${esc(nat(sc.time)||'')}</small><h3>${esc(nat(sc.name)||nat({en:'Current scene',vi:'Cảnh hiện tại'}))}</h3><p class="v8-context-note">${copy(beat||{en:'Continue from the current conversation. This panel does not move the story forward.',vi:'Tiếp tục từ cuộc trò chuyện hiện tại. Mở bảng này không làm truyện chuyển bước.'})}</p><h4>${esc(nat({en:'Present in this scene',vi:'Những người có mặt'}))}</h4><div class="v8-cast-list">${present.map(id=>`<span>${esc(name(id))}</span>`).join('')}</div><h4>${esc(nat({en:'What to do next',vi:'Việc cần làm'}))}</h4><p>${copy(objective())}</p><button class="se-btn pri wide" data-v8-resume>${esc(nat({en:'Return to the same moment',vi:'Trở lại đúng đoạn đang chơi'}))}</button></div>`,'tall');
 sh.querySelector('[data-v8-resume]').onclick=()=>E.ui.closeSheet();
};
function routeSheet(ch){
 if(q('.se')?.dataset.m==='ov')Object.assign(E.R(),V.clone(V.snapshot()));
 const R=E.R(),S=E.S(),chapters=S.chapters,cur=ch||R.ch||1,journal=seedJournal(),done=R.chapterEnds?.[cur]||((S.endings[R.done]?.ch===cur)?R.done:null);
 const trace=journal.filter(x=>x.ch===cur).map(x=>({...x,def:S.flow.find(f=>fid(f)===x.id&&f.ch===cur)})).filter(x=>x.def);
 const count=S.flow.filter(x=>x.ch===cur).length;
 const sh=E.ui.sheet(nat({en:'Your route',vi:'Tuyến đã chơi'}),`<div class="v8-route-tabs" role="group" aria-label="Chapters">${chapters.map(c=>`<button class="se-btn sm${cur===c.ch?' on':''}" data-v8-ch="${c.ch}" aria-pressed="${cur===c.ch}">${c.ch}</button>`).join('')}</div><p class="v8-route-status">${done?esc(nat({en:'CHAPTER COMPLETE — this route is finished.',vi:'ĐÃ XONG CHƯƠNG — tuyến này đã hoàn tất.'})):esc(nat({en:'Current journey — only events from this run.',vi:'Hành trình hiện tại — chỉ các sự kiện của lượt này.'}))}</p><p class="se-mute">${esc(nat({en:'Other branches are alternatives, not missing tasks. Discovery percentage is not story completion.',vi:'Nhánh khác là lựa chọn thay thế, không phải nhiệm vụ còn thiếu. Tỉ lệ khám phá không phải tiến độ hoàn thành truyện.'}))}</p><div class="v8-journey">${trace.map((x,i)=>{const f=x.def,label=f.kind==='end'?S.endings[f.id]?.title:f.label;return`<article class="v8-route-card" data-route-id="${esc(x.id)}"><span class="v8-route-number">${i+1}</span><span class="v8-route-art" aria-hidden="true"><i class="im-${esc(x.scene||f.scene)}"></i></span><div><small>${esc(nat(f.kind==='end'?{en:'Outcome',vi:'Kết quả'}:f.kind==='opt'?{en:'Your choice',vi:'Lựa chọn của bạn'}:{en:'Checkpoint',vi:'Mốc đã đến'}))}</small><b>${copy(label)}</b>${x.reconstructed?`<em>${esc(nat({en:'Recovered from previous save',vi:'Khôi phục từ bản lưu cũ'}))}</em>`:''}${f.kind==='cp'?`<button class="se-btn sm" data-v8-replay="${esc(f.id)}">${esc(nat({en:'Replay this checkpoint',vi:'Chơi lại mốc này'}))}</button>`:''}</div></article>`;}).join('')||`<p>${esc(nat({en:'No events recorded in this chapter yet.',vi:'Chưa ghi nhận sự kiện ở chương này.'}))}</p>`}</div><button class="se-btn wide" data-v8-all>${esc(nat({en:'View all branches (unvisited details stay hidden)',vi:'Xem mọi nhánh (ẩn nội dung chưa khám phá)'}))}</button>`,'tall v8-routes');
 sh.onclick=e=>{if(e.target.closest('[data-x]')){E.ui.closeSheet();return;}const c=e.target.closest('[data-v8-ch]');if(c)return routeSheet(+c.dataset.v8Ch);if(e.target.closest('[data-v8-all]')){V.nativeFlow(cur);const body=q('.se-sheet .fx-body');body?.insertAdjacentHTML('afterbegin',`<p class="v8-map-note">${esc(nat({en:'Dim nodes are alternative routes. A direct line may bypass an optional scene.',vi:'Nút mờ là tuyến thay thế. Đường nối thẳng có thể bỏ qua một cảnh không bắt buộc.'}))}</p>`);return;}
 const b=e.target.closest('[data-v8-replay]');if(b){V.nativeFlow(cur);const el=[...document.querySelectorAll('.fx-body .fx-n')].find(el=>{const idx=q('.fx-body')._idx;return idx?.[+el.dataset.n]?.id===b.dataset.v8Replay;});el?.click();}
 };
 return sh;
}
function decorateEnding(id){
 const el=q('.se-end'),end=E.S().endings[id];if(!el||!end||el.querySelector('.v8-ending-badge'))return;
 const info=outcome(id),badge=document.createElement('div');badge.className='v8-ending-badge '+(info?.kind||'chapter');badge.setAttribute('role','status');badge.innerHTML=`<b>${esc(info?.label||'CHAPTER COMPLETE')}</b><span>${esc(info?.vi||'Hoàn thành chương — chưa phải kết toàn vụ')}</span>`;
 const heading=el.querySelector('h2');(heading||el.firstElementChild)?.before(badge);
 const why=document.createElement('section');why.className='v8-ending-why';why.innerHTML=`<h3>${esc(nat({en:'Why this outcome?',vi:'Vì sao đạt kết quả này?'}))}</h3><p>${copy(info?.reason||end.sum||end.chapterClose)}</p><button class="se-btn wide" data-v8-end-route>${esc(nat({en:'Review the route you actually took',vi:'Xem lại đúng tuyến vừa đi'}))}</button>${info&&info.kind!=='true'?`<small>${esc(nat({en:'This is a valid ending, not a broken path. Replay an unlocked checkpoint to explore another outcome.',vi:'Đây là một kết thúc hợp lệ, không phải đường đi bị lỗi. Chơi lại mốc đã mở để khám phá kết khác.'}))}</small>`:''}`;
 el.querySelector('.se-col')?.before(why);why.querySelector('[data-v8-end-route]').onclick=()=>routeSheet(end.ch);
}
E.on('boot',()=>{
 install();queueMicrotask(install);
 const root=q('.se');root.classList.add('v8');V.routebook=routeSheet;
 bar=document.createElement('button');bar.type='button';bar.className='v8-contextbar';bar.dataset.stageObstruction='top';bar.hidden=true;bar.setAttribute('aria-label','Scene, characters and objective · Bối cảnh, nhân vật và mục tiêu');
 bar.innerHTML='<span class="v8-context-icon">◈</span><span class="v8-context-copy"><span class="v8-presence"></span><span class="v8-mission"></span><span class="v8-cue" hidden></span></span><span class="v8-context-more">ⓘ</span>';
 root.append(bar);bar.onclick=e=>{e.stopPropagation();V.sceneBrief();};
 // The existing HUD observer keeps --vale-toolbar-height and --vale-hud-height accurate.
 const mo=new MutationObserver(()=>{bar.hidden=!activeContext()||root.dataset.m==='ov'||!!q('.se-end');});mo.observe(q('.se-ui'),{childList:true});
 const originalGuide=V.guide;V.guide=()=>{originalGuide();q('.vd-guide')?.insertAdjacentHTML('afterbegin',`<div class="v8-first-loop"><b>${esc(nat({en:'Your first investigation',vi:'Vòng điều tra đầu tiên'}))}</b><p>${esc(nat({en:'Read → inspect → ask → compare → choose → review the chapter outcome. Tap the ◈ strip whenever the scene or your goal is unclear.',vi:'Đọc → khám → hỏi → đối chiếu → chọn → xem kết chương. Chạm thanh ◈ bất cứ lúc nào chưa rõ bối cảnh hoặc mục tiêu.'}))}</p></div>`);};
 // A single settings toggle for the extra guide, without resetting other preferences.
 const settings=V.settings;V.settings=()=>{settings();const body=q('.se-sheet .se-shb');if(!body)return;body.insertAdjacentHTML('beforeend',`<button class="se-btn wide" data-v8-brief>${esc(nat({en:'Scene, characters & objective',vi:'Bối cảnh, nhân vật & mục tiêu'}))}</button><button class="se-btn wide" data-v8-guide-toggle>${esc(nat({en:'Scene guide: ',vi:'Thanh dẫn cảnh: '}))}${E.G().set.v8Guide===false?'OFF':'ON'}</button>`);body.querySelector('[data-v8-brief]').onclick=()=>V.sceneBrief();body.querySelector('[data-v8-guide-toggle]').onclick=()=>{E.G().set.v8Guide=E.G().set.v8Guide===false;root.classList.toggle('v8-guide-off',E.G().set.v8Guide===false);E.save();V.settings();};};
 root.classList.toggle('v8-guide-off',E.G().set.v8Guide===false);
});
E.on('chapter',()=>{install();queueMicrotask(install);});
E.on('step',(type,st)=>{
 const R=E.R();if(lastRun!==R){lastRun=R;context=null;beat=null;lastSection='';lastSpeaker='';lastBeat='';}
 lastSpeaker='';
 if(type==='cp')record(E.S().flow.find(x=>x.kind==='cp'&&x.id===st.cp));
 queueMicrotask(syncContext);
});
E.on('branch',(k,v)=>record(E.S().flow.find(x=>x.kind==='opt'&&x.key===k&&x.val===v)));
E.on('line',line=>{lastSpeaker=line.who||'';queueMicrotask(()=>{
 syncContext();if(!motionOK())return;
 const el=lastSpeaker&&q('.se-ch[data-id="'+lastSpeaker+'"] .se-tagn');
 if(el)el.animate([{opacity:.55},{opacity:1}],{duration:320,easing:'ease-out'});
});});
E.on('end',id=>{record(E.S().flow.find(x=>x.kind==='end'&&x.id===id));E.save();if(!E.auto)queueMicrotask(()=>decorateEnding(id));});
V.v8Debug=()=>({context:activeContext(),beat,route:E.R().v8route||[],outcome:outcome(E.R().done)});
})();
/* Vale 0.9: authored staging and wide narration, using the existing cast/art.
 * No text, branch arrays, evidence grants, or saved interpreter paths change.
 * Presence comes from Vale 0.8's authored context, never a name in narration.
 */
(() => {
  'use strict';
  const E = StoryEngine, V = ValeDemo, q = s => document.querySelector(s);
  const enabled = () => /^vale-dossiers(?:-|$)/.test(E.S()?.id || '');
  const context = () => V.v8Debug?.().context;
  const at = (S, node, path) => path.reduce((v, k) => v?.[k], S.nodes?.[node]);
  const actor = (id, at = 'l', face) => ({ id, at, ...(face === undefined ? {} : { face }) });

  // Exact authoring anchors. A show on the narrated entrance also repairs a
  // resumed save at that line; the following dialogue does not invent anyone.
  const entrances = [
    ['c1_open', [3], 'reed', [actor('reed')]],
    ['c1_open', [9], 'reed', [actor('reed')]],
    ['c1_open', [15, 'place', 'views', 'desk', 'zones', 0, 'then', 2], null, [actor('reed')]],
    ['c1_open', [15, 'place', 'views', 'desk', 'zones', 1, 'then', 2], 'reed', [actor('reed')]],
    ['c1_open', [15, 'place', 'views', 'desk', 'zones', 1, 'then', 3], null, [actor('reed')]],
    ['c1_open', [15, 'place', 'views', 'desk', 'zones', 2, 'then', 2], null, [actor('reed')]],
    ['c1_arrival', [6], 'reed', [actor('reed')]],
    ['c1_terms', [9], 'reed', [actor('reed')]],
    ['c1_terms', [13], 'reed', [actor('reed')]],
    ['c1_departure', [4], 'reed', [actor('reed')]],
    ['c1_departure', [5], null, [actor('reed')]],
    ['c1_departure', [7], null, [actor('reed')]],
    ['c1_observe', [1], 'reed', [actor('reed')]],
    ['c1_observe', [3], null, [actor('reed')]],
    ['c1_observe', [7], null, [actor('reed')]],
    ['c1_direct', [2], null, [actor('reed')]],
    ['c1_neighbourhood', [15], null, [actor('reed')]],
    ['c1_neighbourhood', [20], null, [actor('reed')]],
    ['c2_call', [20], null, [actor('reed')]],
    ['c2_call', [23], 'reed', [actor('reed')]],
    ['c3_open', [49], 'reed', [actor('reed')]],
    ['c3_open', [50], null, [actor('reed')]],
    ['c3_board', [6], 'reed', [actor('reed')]],
    ['c3_open', [12, 'choice', 1, 'then', 2], null, [actor('reed')]],
    ['c4_open_explore', [0, 'explore', 'spots', 0, 'then', 2], null, [actor('hart', 'r')], true],
