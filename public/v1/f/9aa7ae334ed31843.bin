 const fold=t=>String(t||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d'),unique=a=>[...new Set(a)],clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
 const WIDTH=148,HEIGHT=170;
