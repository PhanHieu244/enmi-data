.vd:is(.pl-inspecting,.xp-inspecting) .pz:not(.ng):not(.wg){--dot:5px;--ring:12px}
.vd:is(.pl-inspecting,.xp-inspecting) .pz:not(.ng):not(.wg)::before{box-shadow:0 0 3px #ffe3a557;opacity:.5}
.vd:is(.pl-inspecting,.xp-inspecting) .pz:not(.ng):not(.wg)::after{border-width:1px;opacity:.4}

/* On a short landscape screen, a portrait scene keeps its complete composition;
   the existing controls use the adjacent column. No blurred image-edge strip. */
@media(min-width:600px) and (max-height:500px){
 .vd:is([data-m="pl"],[data-m="xp"]){--vale-scene-width:min(52%,calc(100dvh * var(--vale-scene-ar,.563)))}
 .vd:is([data-m="pl"],[data-m="xp"])>.se-stage,.vd[data-m="pl"]>.se-plnav,.vd[data-m="xp"]>.se-xpnav{width:var(--vale-scene-width);right:auto}
 .vd:is([data-m="pl"],[data-m="xp"])>.se-ui{left:var(--vale-scene-width)}
 .vd:is([data-m="pl"],[data-m="xp"]) .se-panel:is(.pl,.xp){padding-inline:12px;max-height:calc(100dvh - 72px);background:linear-gradient(180deg,#13201bef,#101814);border-left:1px solid #d0c2a41c}
 .vd:is([data-m="pl"],[data-m="xp"]) .pl-goal{font-size:12px;line-height:1.4}
 .vd .pl-detail-back{left:50%;top:auto;bottom:max(12px,env(safe-area-inset-bottom,0px));padding-inline:12px}
 .vd .pp-n{font-size:10px;max-width:120px}
}
/* Receiving an object is a blocking authored step: its close action must remain
   reachable in a short landscape viewport, including long evidence descriptions. */
@media(max-height:500px){
 .vd .se-rev{padding:12px}
 .vd .rv-c{width:100%;max-height:calc(100dvh - 24px);grid-template-columns:minmax(100px,.72fr) minmax(0,1fr);grid-template-rows:auto auto minmax(0,1fr) auto auto;column-gap:16px;row-gap:6px;align-items:center}
 .vd .rv-st{grid-column:1;grid-row:1 / 6;width:100%;max-width:190px;align-self:center;justify-self:center}
 .vd .rv-k,.vd .rv-n,.vd .rv-d,.vd .rv-b,.vd .rv-tap{grid-column:2;max-width:100%}
 .vd .rv-k{grid-row:1;font-size:10px;letter-spacing:.12em}
 .vd .rv-n{grid-row:2;font-size:18px;line-height:1.25}
 .vd .rv-d{grid-row:3;max-height:27dvh;overflow-y:auto;overscroll-behavior:contain;font-size:14px;line-height:1.45;padding-inline:3px;-webkit-overflow-scrolling:touch}
 .vd .rv-b{grid-row:4;margin:0;gap:4px}
 .vd .rv-b:empty{display:none}
 .vd .rv-b .se-btn{min-height:44px;padding:7px 10px;font-size:12px}
 .vd .rv-tap{grid-row:5;min-height:44px;margin:0;padding:9px 8px!important;animation:none;background:#d6b8781f!important;border-radius:12px;color:#e8d8b5}
}
@media(prefers-reduced-motion:reduce){
 .vd .se-bgl,.vd .se-bgw{transition:none!important;animation:none!important}
 .vd .pz:not(.ng):not(.wg)::before{animation:none;opacity:.8}
 .vd .pz:not(.ng):not(.wg)::after{animation:none;opacity:.3;transform:scale(1.4)}
}
/* Vale 0.4 · touch-first case board. No global engine or native-board overrides. */
.se-panel.caseboard:has(.cb4-root){position:fixed;inset:0;margin:auto;width:100%;max-width:680px;height:100vh;height:100dvh;max-height:100dvh;padding:max(61px,calc(env(safe-area-inset-top,0px) + 53px)) 9px max(7px,env(safe-area-inset-bottom,0px));overflow:hidden;background:linear-gradient(160deg,#203034,#10191b 65%);border:0;border-radius:0;box-sizing:border-box}
.cb4-root{position:relative;display:flex;flex-direction:column;height:100%;min-height:0;gap:6px;color:#eee8d7;font-family:var(--se-sans,system-ui,sans-serif);font-size:13px;text-align:left}
.cb4-root *{box-sizing:border-box}.cb4-root button{font:inherit;-webkit-tap-highlight-color:transparent;cursor:pointer}.cb4-root button:disabled{cursor:default;opacity:.4}.cb4-root button:focus-visible{outline:3px solid #f2ce7d;outline-offset:2px}.cb4-root svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex:none}.cb4-root [hidden]{display:none!important}
.cb4-head{flex:none;min-width:0;padding-right:43px}.cb4-eyebrow{display:flex;align-items:center;justify-content:space-between;min-height:27px;color:#cfb980;font-size:10px;font-weight:700;letter-spacing:.16em}.cb4-progress{display:flex;align-items:center;gap:6px;min-width:58px;min-height:30px;padding:3px 8px;color:#ead9ad;background:#ffffff08;border:1px solid #cebb8140;border-radius:7px;letter-spacing:0}.cb4-progress svg{width:15px;height:15px}.cb4-head h2{margin:3px 0 2px;max-height:94px;overflow:auto;font-family:Georgia,serif;font-size:14px;font-weight:400;line-height:1.4;color:#f2eee4}.cb4-head h2>small{display:block;margin-top:3px;color:#c6cfca;font:12px/1.4 var(--se-sans,system-ui,sans-serif)}
.cb4-toolbar{display:flex;align-items:center;gap:5px;flex:none}.cb4-modes{display:flex;flex:1;min-width:0;padding:3px;border:1px solid #85958b45;background:#0d17198f;border-radius:10px}.cb4-modes button{display:flex;align-items:center;justify-content:center;gap:5px;min-height:38px;flex:1;padding:4px 6px;color:#bfcac5;background:transparent;border:0;border-radius:7px;font-size:11px;white-space:nowrap}.cb4-modes button[aria-pressed=true]{color:#243331;background:#ddc486;box-shadow:0 2px 9px #0003}.cb4-modes svg{width:17px;height:17px}.cb4-icon{position:relative;display:inline-flex;align-items:center;justify-content:center;width:42px;min-width:42px;height:44px;padding:8px;color:#d6dfd9;background:#e3eee908;border:1px solid #899e9255;border-radius:9px}.cb4-icon:hover{background:#e3eee912}.cb4-icon.active{color:#eed18b;border-color:#ceb475}.cb4-icon>b{position:absolute;right:3px;top:1px;min-width:14px;height:14px;padding:0 2px;border-radius:6px;background:#c6b37d;color:#203232;font-size:9px;font-weight:750;line-height:14px}.cb4-icon svg{width:19px;height:19px}.cb4-scope{flex:none;margin:0 2px;min-height:15px;color:#b4c0b8;font-size:10px;line-height:15px}
.cb4-viewport{position:relative;flex:1;min-height:90px;overflow:hidden;border:7px solid #4b3a29;border-radius:9px;background-color:#6e5238;background-image:radial-gradient(#cbb58c2b .8px,transparent 1px),radial-gradient(#261c152a .8px,transparent 1px),linear-gradient(133deg,#8d6e4844,#362a1e55);background-size:7px 7px,11px 11px,100% 100%;background-position:0 0,3px 5px,0 0;box-shadow:inset 0 0 32px #20160d7a,0 1px 0 #b3925e4f,0 8px 20px #0003;touch-action:none;isolation:isolate;overscroll-behavior:contain}.cb4-world{position:absolute;top:0;left:0;transform-origin:0 0;will-change:transform}.cb4-cards{position:absolute;inset:0;z-index:2}.cb4-empty{position:absolute;top:38%;left:15%;right:15%;text-align:center;color:#fff3d6;font-size:14px;pointer-events:none}
.cb4-card{position:absolute;width:148px;height:170px;color:#2f3b38;background:linear-gradient(135deg,#f6efd9,#e9dfc5);border:1px solid #c5b288;border-radius:2px;box-shadow:2px 4px 8px #21190c66;isolation:isolate;user-select:none;-webkit-user-select:none;touch-action:none}.cb4-card:after{position:absolute;top:-6px;right:9px;width:34px;height:12px;background:#ead8a185;box-shadow:0 1px 1px #725e3a18;content:'';transform:rotate(7deg);pointer-events:none}.cb4-card.testimony{background:linear-gradient(135deg,#edf1dc,#d7dfcc);border-color:#adba9c}.cb4-card.inference{background:linear-gradient(135deg,#f0dfad,#d9c285);border-color:#c0a76a}.cb4-card.selected,.cb4-card.link-target{outline:3px solid #f4cc6a;outline-offset:3px;z-index:3}.cb4-card.dragging{z-index:10;box-shadow:4px 10px 20px #20160b88}.cb4-select{display:flex;flex-direction:column;align-items:stretch;width:100%;height:138px;padding:13px 9px 4px;text-align:left;color:inherit;background:none;border:0;border-radius:0;touch-action:none}.cb4-art{display:flex;align-items:center;justify-content:center;height:44px;min-height:44px;margin-bottom:4px;overflow:hidden}.cb4-art .se-ia{display:block;width:60px!important;height:43px!important;min-width:60px;border:0!important;background-color:transparent!important;box-shadow:none!important}.cb4-art img{width:100%;height:100%;object-fit:contain}.cb4-kind{display:block;flex:none;margin-bottom:3px;color:#656654;font-size:8px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.cb4-select>b{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;min-height:16px;max-height:32px;font-family:Georgia,serif;font-size:13px;font-weight:700;line-height:16px}.cb4-brief{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;margin-top:4px;color:#5e6559;font-size:9px;line-height:12px}.cb4-pin{position:absolute;top:-19px;left:calc(50% - 22px);display:flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;background:transparent;border:0;z-index:5;touch-action:none}.cb4-pin i{display:block;width:12px;height:12px;border-radius:50%;background:radial-gradient(circle at 33% 25%,#f3ada0 0,#aa4f3e 38%,#562b24 75%);box-shadow:1px 3px 2px #2d1c1688,0 0 0 1px #613525}.cb4-pin[aria-pressed=true] i{background:radial-gradient(circle at 33% 25%,#fff6ca,#dfb448 45%,#927429 75%)}.cb4-read{position:absolute;bottom:0;left:0;display:flex;align-items:center;justify-content:center;gap:5px;width:100%;height:31px;padding:4px;color:#526055;background:#fff5;border:0;border-top:1px solid #a9ab913f;font-size:10px!important}.cb4-read svg{width:13px;height:13px}.cb4-record-icon{display:grid;place-items:center;width:44px;height:40px;color:#756439}.cb4-record-icon svg{width:27px;height:27px}.cb4-record-avatar{position:relative;display:grid;place-items:center;width:44px;height:44px;overflow:hidden;border-radius:50%;background:#718d7940;color:#596c54}.cb4-record-avatar>i{position:absolute;inset:0;background-size:cover;background-position:center}.cb4-record-avatar>b{position:relative;font:34px Georgia,serif;text-shadow:0 1px 1px #fff7}.cb4-wires{position:absolute;top:0;left:0;overflow:visible;pointer-events:none;z-index:4}.cb4-wires g{stroke:var(--wire);fill:var(--wire);filter:drop-shadow(0 1px 1px #211a15cc)}.cb4-wires path{fill:none;stroke-width:3.2;stroke-linecap:round}.cb4-wires circle{stroke:#f2e7cc;stroke-width:1}
.cb4-zoom{position:absolute;right:6px;bottom:5px;z-index:12;display:flex;align-items:center;gap:2px;padding:3px 4px;background:#152122e8;border:1px solid #c4ad7855;border-radius:10px;box-shadow:0 2px 6px #0003;touch-action:manipulation}.cb4-zoom .cb4-icon{width:36px;min-width:36px;height:38px;padding:7px;border:0;background:transparent}.cb4-zoom small{min-width:31px;text-align:center;color:#c9cbbd;font-size:9px}.cb4-popover{position:absolute;z-index:20;top:7px;left:7px;right:7px;max-height:min(72%,340px);overflow:auto;padding:0 12px 12px;color:#263b37;background:#f1e9d5;border:1px solid #b8a77d;border-radius:7px;box-shadow:0 7px 25px #1c170c66;touch-action:pan-y}.cb4-popover>header{position:sticky;top:0;display:flex;align-items:center;justify-content:space-between;min-height:42px;margin-bottom:5px;background:#f1e9d5;border-bottom:1px solid #b3aa8d55;font-size:12px}.cb4-popover .cb4-icon{width:36px;min-width:36px;height:36px;padding:8px;color:#425851;background:none;border:0}.cb4-hint{font-size:13px;line-height:1.6}.cb4-hint>small,.cb4-conclusion small{display:block;margin-top:5px;color:#536258;font-size:12px;line-height:1.5}.cb4-conclusion{display:flex;align-items:flex-start;gap:7px;padding:9px 0;border-bottom:1px solid #bbb19255;font-size:12px;line-height:1.5}.cb4-conclusion:last-child{border:0}.cb4-conclusion>b{padding-top:1px;color:#537447}.cb4-conclusion>b svg{width:16px;height:16px}.cb4-popover>p{font-size:12px;line-height:1.5}
.cb4-footer{flex:none;min-height:68px}.cb4-status{height:30px;margin:1px 2px 4px;overflow:auto;color:#c1cec5;font-size:11px;line-height:1.35}.cb4-status.wrong{color:#f0b2a3}.cb4-status.success{color:#c6dbad}.cb4-footer>div{display:flex;align-items:center;gap:6px}.cb4-footer .cb4-icon{width:40px;min-width:40px;height:40px}.cb4-finish{display:flex;align-items:center;justify-content:center;gap:7px;min-height:40px;max-width:calc(100% - 92px);margin-left:auto;padding:6px 13px;color:#d1dbd4;background:#293c3d;border:1px solid #8a9c8d77;border-radius:8px;font-size:12px!important}.cb4-finish.ready{color:#243632;background:linear-gradient(145deg,#ead7a0,#cfb779);border-color:#f3dba1}.cb4-finish svg{width:16px;height:16px}
.cb4-drawer{position:absolute;bottom:0;left:0;right:0;z-index:25;display:flex;flex-direction:column;height:min(76%,600px);min-height:230px;padding:10px 10px 5px;color:#e8e9df;background:#152629fa;border:1px solid #c4b57e88;border-radius:14px 14px 6px 6px;box-shadow:0 -10px 36px #0008;backdrop-filter:blur(12px)}.cb4-drawer>header{display:flex;align-items:center;justify-content:space-between;flex:none;min-height:40px;margin-bottom:5px}.cb4-drawer h3{margin:0;font:19px Georgia,serif}.cb4-drawer h3 small{margin-left:6px;color:#b3c3b7;font:10px var(--se-sans,system-ui,sans-serif)}.cb4-drawer>header .cb4-icon{width:38px;min-width:38px;height:38px;border:0;background:transparent}.cb4-drawer-tabs{display:flex;flex:none;gap:4px}.cb4-drawer-tabs>button{min-width:0;min-height:39px;flex:1;padding:4px;color:#c0cdc3;background:#ffffff06;border:1px solid #9bb09e38;border-radius:7px;font-size:10px;line-height:1.25}.cb4-drawer-tabs>button[aria-pressed=true]{color:#f4dfab;border-color:#ddc78a;background:#c4ac7019}.cb4-search{display:flex;flex:none;align-items:center;gap:4px;margin-top:8px}.cb4-search input{width:100%;min-width:0;height:42px;padding:7px 10px;color:#f3f0e5;background:#0b1719;border:1px solid #889e8b77;border-radius:7px;font:16px var(--se-sans,system-ui,sans-serif)}.cb4-search input::placeholder{color:#8daba0;font-size:12px}.cb4-search .cb4-icon{width:37px;min-width:37px;height:40px;border:0}.cb4-drawer-scope{display:flex;align-items:center;justify-content:space-between;flex:none;min-height:26px;margin:4px 0;color:#b9c8be;font-size:10px}.cb4-drawer-scope button{padding:5px 8px;color:#e5ce90;background:none;border:0;text-decoration:underline;font-size:11px}.cb4-drawer-list{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;touch-action:pan-y}.cb4-drawer-record{display:flex;align-items:center;gap:5px;padding:5px 1px;border-top:1px solid #c1c9ae20}.cb4-drawer-read{display:flex;align-items:center;gap:9px;flex:1;min-width:0;padding:4px 0;color:inherit;background:transparent;border:0;text-align:left}.cb4-drawer-read>.se-ia,.cb4-drawer-read>.cb4-record-icon,.cb4-drawer-read>.cb4-record-avatar{flex:none;width:44px!important;height:48px!important;min-width:44px}.cb4-drawer-read>span:last-child{display:block;min-width:0}.cb4-drawer-read small{display:block;margin-bottom:3px;color:#a9b9a9;font-size:9px}.cb4-drawer-read b{display:block;color:#e8e7d8;font-size:12px;line-height:1.35}.cb4-drawer-read em{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;margin-top:3px;color:#aebdb1;font-size:10px;font-style:normal;line-height:1.35}.cb4-drawer-record.testimony .cb4-drawer-read small{color:#aacbc0}.cb4-drawer-record.inference .cb4-drawer-read small{color:#dac48e}.cb4-drawer-record>.cb4-icon{width:37px;min-width:37px;height:42px;border:0}.cb4-no-results{padding:15px 8px;font-size:13px;line-height:1.6;color:#c6cdbf}
.cb4-record-detail{color:var(--se-text,#e9e6dc);font-size:14px;line-height:1.65}.cb4-record-large{display:flex;align-items:center;justify-content:center;height:145px;margin-bottom:12px;padding:10px;background:#a1b2a80c;border-radius:9px}.cb4-record-large .se-ia{width:120px!important;height:120px!important}.cb4-record-large .cb4-record-icon,.cb4-record-large .cb4-record-avatar{width:110px;height:110px}.cb4-record-large .cb4-record-icon svg{width:64px;height:64px}.cb4-record-large .cb4-record-avatar>b{font-size:80px}.cb4-record-detail>small{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#a6bcad}.cb4-record-detail h3{margin:7px 0 14px;font:24px/1.3 Georgia,serif}.cb4-record-detail h3 small,.cb4-record-detail>div>small,.cb4-record-detail p>small{display:block;margin-top:6px;font:12px/1.6 var(--se-sans,system-ui,sans-serif);color:#aabfb0}.cb4-record-detail .se-btn{margin-top:9px}.cb4-record-detail .se-btn svg{width:16px;height:16px;vertical-align:middle;fill:none;stroke:currentColor;stroke-width:1.7}.cb4-record-source{font-size:12px;color:#acbeb2}
@media(max-width:370px){.cb4-modes button{gap:3px;padding:4px;font-size:10px}.cb4-modes svg{width:15px;height:15px}.cb4-toolbar>.cb4-icon{width:38px;min-width:38px}.cb4-head h2{font-size:13px}.cb4-head h2>small{font-size:11px}.cb4-toolbar{gap:4px}}
@media(max-height:680px){.cb4-root{gap:4px}.cb4-head h2{max-height:68px;font-size:12px}.cb4-head h2>small{font-size:10px;line-height:1.35}.cb4-toolbar>.cb4-icon{height:40px}.cb4-modes button{min-height:34px}.cb4-footer{min-height:62px}.cb4-status{height:27px;font-size:10px}.cb4-viewport{border-width:5px}}
@media(max-height:470px) and (min-width:600px){.se-panel.caseboard:has(.cb4-root){max-width:100%;padding:54px 12px 6px}.cb4-root{display:grid;grid-template-columns:32% 1fr;grid-template-rows:auto auto 1fr auto;gap:7px 10px}.cb4-head{grid-column:1;grid-row:1}.cb4-head h2{max-height:99px}.cb4-toolbar{grid-column:1;grid-row:2;flex-wrap:wrap;justify-content:center}.cb4-modes{flex-basis:100%}.cb4-toolbar>.cb4-icon{flex:1;min-height:35px;height:35px}.cb4-scope{grid-column:1;grid-row:3}.cb4-footer{grid-column:1;grid-row:4}.cb4-footer .cb4-icon{width:34px;min-width:34px}.cb4-finish{padding:6px 8px;font-size:10px!important;max-width:calc(100% - 80px)}.cb4-viewport{grid-column:2;grid-row:1/5}.cb4-drawer{left:33%;height:100%;max-height:none;border-radius:10px}}
@media(prefers-reduced-motion:reduce){.cb4-root *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

/* 0.5 — quieter brass/glass controls, consistent touch targets. Board rules,
   coordinates, cards and wire behavior are unchanged. */
.se-panel.caseboard:has(.cb4-root){padding-top:max(61px,calc(var(--vale-toolbar-height,55px) + 6px))}
.cb4-modes{padding:2px;border-color:#adc0b34d;border-radius:13px;background:#0e1d1dde;box-shadow:inset 0 1px 3px #0003}
.cb4-modes button{min-height:44px;border-radius:10px;color:#bfcec2;line-height:1.15;white-space:normal;transition:background .16s,color .16s,box-shadow .16s}
.cb4-modes button[aria-pressed=true]{background:linear-gradient(150deg,#e0d1a8,#c7b88b);color:#263b32;box-shadow:0 2px 5px #0003,inset 0 1px 0 #fff5}
.cb4-modes button:active{background:#b8b492;color:#193128}
.cb4-icon{width:44px;min-width:44px;height:44px;min-height:44px;padding:10px;border-color:#a7bbac4d;border-radius:12px;color:#d4e1d7;background:linear-gradient(150deg,#c6d7c80d,#6c907807);box-shadow:inset 0 1px 0 #fff06;transition:background .16s,border-color .16s,transform .16s}
.cb4-icon:hover,.cb4-icon[aria-expanded=true]{background:#b6c9b51b;border-color:#c6c29a80}
.cb4-icon:active{background:#b4c19d30;transform:translateY(1px)}
.cb4-icon.active{color:#ecdaa1;border-color:#cfbd83;background:#bfa86a18}
.cb4-icon>b{top:2px;right:2px;min-width:14px;height:14px;font-size:9px;line-height:14px;border-radius:6px;background:#d0c5a0;color:#263b32;box-shadow:0 0 0 2px #1c2b2a}
.cb4-progress{min-height:44px;padding:6px 9px;border-radius:10px;background:#c8bd8910;border-color:#c9bc7e45;white-space:nowrap}
.cb4-progress:hover{background:#c8bd8920}
.cb4-zoom{gap:1px;padding:3px;border-radius:14px;background:#10231eea;border-color:#b7ab794f;box-shadow:0 3px 10px #0004}
.cb4-zoom .cb4-icon,.cb4-popover .cb4-icon,.cb4-footer .cb4-icon,.cb4-drawer>header .cb4-icon,.cb4-drawer-record>.cb4-icon,.cb4-search .cb4-icon{width:44px;min-width:44px;height:44px;min-height:44px}
.cb4-zoom .cb4-icon{padding:11px;border:0;background:transparent;box-shadow:none}
.cb4-zoom .cb4-icon:active{background:#ccd4a522}
.cb4-finish{min-height:44px;max-width:calc(100% - 100px);padding:8px 13px;border-radius:12px;background:#233d32;border-color:#a8bba36b;color:#d5e0d2;line-height:1.25;font-weight:650!important;transition:background .16s,transform .16s}
.cb4-finish.ready{color:#243b2d;background:linear-gradient(150deg,#e2d7af,#c7bb90);border-color:#dfcf9e;box-shadow:0 2px 8px #0003,inset 0 1px 0 #fff4}
.cb4-finish:active:not(:disabled){transform:translateY(1px);filter:brightness(.95)}
.cb4-drawer-tabs>button{min-height:44px;border-radius:9px}
.cb4-drawer-tabs>button[aria-pressed=true]{color:#f0dfac;border-color:#c4b579;background:#b6a96b24;box-shadow:inset 0 1px 0 #fff08}
.cb4-drawer-scope button{min-height:44px;padding:7px 8px}
.cb4-read{height:44px;border-top-color:#a2ac9666;background:#fff4;font-size:11px!important;line-height:1.2}
.cb4-read:hover{background:#fff8}
.cb4-read svg{width:15px;height:15px}
.cb4-select{height:126px;padding-top:12px;overflow:hidden}
.cb4-art{height:35px;min-height:35px;margin-bottom:3px}
.cb4-art .se-ia{height:35px!important}
.cb4-brief{margin-top:3px}
@media(max-width:370px){.cb4-toolbar{gap:4px}.cb4-toolbar>.cb4-icon{width:44px;min-width:44px;height:44px}.cb4-modes button{font-size:10px;padding:4px 3px;gap:3px}.cb4-modes svg{width:15px;height:15px}.cb4-finish{padding-inline:9px;font-size:11px!important}}
@media(max-height:680px){.cb4-toolbar>.cb4-icon,.cb4-modes button{min-height:44px;height:44px}.cb4-footer{min-height:78px}}
@media(max-height:470px) and (min-width:600px){.cb4-head h2{max-height:58px}.cb4-toolbar{gap:4px}.cb4-toolbar>.cb4-icon{height:44px;min-height:44px;min-width:44px}.cb4-footer .cb4-icon{width:44px;min-width:44px}.cb4-finish{max-width:calc(100% - 100px);min-height:44px;padding:6px 8px}.cb4-footer{min-height:78px}}

/* 0.9.3 — keep tools beside the work, never over a record or its pin. */
.cb4-head{padding-right:0}
.cb4-toolbar .cb4-tool{flex-direction:column;gap:2px;padding:4px 2px}
.cb4-toolbar .cb4-tool>svg{width:17px;height:17px}
.cb4-toolbar .cb4-tool>span{font-size:9px;line-height:12px;white-space:nowrap}
.cb4-view-tools{display:flex;flex:none;align-items:center;justify-content:space-between;gap:6px;padding:2px 4px;background:#0d1c1bd9;border:1px solid #a7bbac35;border-radius:10px}
.cb4-view-tools .cb4-zoom{position:static;gap:3px;padding:0;background:none;border:0;box-shadow:none}
.cb4-view-tools .cb4-zoom small{font-size:10px;min-width:35px}
.cb4-footer .cb4-finish{max-width:calc(100% - 52px)}
.cb4-wires .cb4-wire-preview{stroke:#f7df94;stroke-width:3;stroke-dasharray:6 5;fill:none;filter:drop-shadow(0 1px 1px #211a15cc)}
.cb4-drawer-scope{gap:8px;margin:7px 0;font-size:11px}
.cb4-drawer-scope select{min-width:0;flex:1;min-height:44px;padding:5px 8px;font:13px var(--se-sans,system-ui,sans-serif);color:#e8e7d8;background:#142421;border:1px solid #a7bbac65;border-radius:7px}
.cb4-popover:has(.cb4-attempt-records){max-height:calc(100% - 14px)}
.cb4-attempt-records{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-bottom:9px}
.cb4-attempt-records>button{display:flex;align-items:center;gap:5px;min-height:44px;padding:6px;text-align:left;color:#263b37;background:#fff8;border:1px solid #8b937b75;border-radius:6px;font-size:11px;line-height:1.35}
.cb4-attempt-records svg{width:15px;height:15px}
.cb4-text-button{display:block;min-height:44px;margin-top:8px;padding:8px 10px;color:#263b37;background:#d9d1b8;border:1px solid #9aa185;border-radius:7px;font-size:12px!important;line-height:1.35}
.vd .se-panel.deduce [data-deduce-hint]{flex:0 0 auto;padding-inline:10px}
.vd .se-panel.deduce [data-deduce-more-hint]{display:block;margin-top:6px;min-height:44px}
.vd .se-panel.deduce .se-deduce-footer>.se-hint{max-height:30dvh;overflow:auto;overscroll-behavior:contain}
@media(max-height:470px) and (min-width:600px){.cb4-head h2{max-height:64px}.cb4-view-tools{grid-column:1;grid-row:3}.cb4-root:has(.cb4-view-tools:not([hidden])) .cb4-modes{display:none}.cb4-scope{display:none}.cb4-viewport{grid-row:1/5}}
/* Build 0.4: native phone interface, persistent records and restrained motion. */
.vd .se-tools .se-autob{order:-10;position:static;inset:auto;margin:0 auto 0 0;flex:0 0 auto;min-width:44px;max-width:120px}
.vd .se-tools .se-more{margin-left:0;flex:none}
.vd .se-chi .ii{mask-image:linear-gradient(to bottom,#000 0 88%,transparent 100%);-webkit-mask-image:linear-gradient(to bottom,#000 0 88%,transparent 100%)}
.vd .se-bookpane[hidden],.vd .vd-record-card[hidden],.vd .vd-record-chapter[hidden],.vd .vd-record-empty[hidden]{display:none!important}
.vd .vd-casebook .se-tabs{position:sticky;top:-20px;z-index:3;background:#172323;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:2px;padding-block:6px;margin-top:-8px}
.vd .vd-casebook .se-tab{display:flex;flex-direction:column;gap:3px;justify-content:center;min-height:52px;padding:5px 2px;font-size:12px;white-space:normal}
.vd .vd-casebook .se-tab small{font-size:10px;font-weight:400;opacity:.7}
.vd-record-controls{display:grid;gap:10px;padding:4px 0 12px}
.vd-record-filters{display:grid;grid-template-columns:.8fr 1.4fr 1fr;gap:5px}
.vd-record-filters button{min-width:0;display:flex;flex-direction:column;gap:3px;min-height:45px;padding:6px 4px;font-size:11px}
.vd-record-filters small{font-size:10px;opacity:.72;font-weight:400}
.vd-record-search{display:grid;gap:5px;font-size:11px;color:#bdc7c1}
.vd-record-search input{min-width:0;width:100%;font-size:16px;min-height:44px}
.vd-record-count{margin:0;font-size:11px;color:#a2b6b3}
.vd-record-chapter{border-top:1px solid #c9b88228;margin-block:4px 12px}
.vd-record-chapter>summary{padding:14px 2px;font-size:12px;color:#d6c491;cursor:pointer;list-style-position:inside}
.vd-record-chapter>summary small{float:right;min-width:24px;text-align:center;border:1px solid #d6c49144;border-radius:12px;font-size:10px}
.vd-record-list{display:grid;gap:8px}
.vd-record-card{width:100%;display:flex;align-items:flex-start;gap:11px;padding:12px 10px;border:1px solid #d6c49122;border-radius:12px;background:#ffffff04;color:#e1e5df;text-align:left;font:inherit;cursor:pointer;min-height:68px}
.vd-record-card:focus-visible{outline:2px solid #e2c484;outline-offset:2px}
.vd-record-copy{display:grid;gap:5px;min-width:0;flex:1}
.vd-record-copy>b{font-size:13px;line-height:1.45;font-weight:600}
.vd-record-copy .vd-vi{font-size:.92em;line-height:1.4;margin-top:3px;opacity:.74}
.vd-record-brief{font-size:12px;line-height:1.5;color:#bdcac5}
.vd-record-copy>small{font-size:10px;line-height:1.45;color:#93aaa7}
.vd-record-kind{font-size:9px;letter-spacing:.05em;line-height:1.4;text-transform:uppercase;color:#d8c183}
.vd-record-kind.is-testimony{color:#b7a2cc}.vd-record-kind.is-inference{color:#91beb3}
.vd .se-ia.vd-record-art{position:relative;display:block;flex:0 0 56px;width:56px;height:62px;background:#d5ccae;border:1px solid #d6c49144;border-radius:7px;overflow:hidden;box-shadow:0 3px 8px #0005}
.vd .se-ia.vd-record-art i{position:absolute;inset:0;display:block;background-size:cover;background-position:center;background-repeat:no-repeat}
.vd .se-ia.vd-record-art.is-testimony{background:#344242;border-color:#b7a2cc66}
.vd .se-ia.vd-record-art.is-testimony i{background-position:center 8%;background-size:130% auto}
.vd .se-ia.vd-record-art.sm{width:42px;height:48px;flex-basis:42px}
.vd .se-ia.vd-record-art.lg{width:150px;height:168px;flex-basis:168px;align-self:center;border-radius:10px}
.vd .se-ia.vd-record-art.lg.is-testimony i{background-size:125% auto}
.vd-quote-mark,.vd-inference-mark{position:absolute;right:2px;bottom:0;display:grid;place-items:center;width:23px;height:23px;border-radius:50%;background:#273133e8;color:#e0c9ef;font:24px Georgia,serif}
.vd-inference-mark{color:#bce5d9;font-size:17px}
.vd .vd-record-detail .se-ivc{position:relative;max-height:86dvh;overflow:auto;overscroll-behavior:contain;display:flex;flex-direction:column;gap:12px;padding:24px 20px;max-width:390px;text-align:left;background:#172120;border:1px solid #d6c49155;border-radius:18px;box-shadow:0 16px 70px #0009;align-items:stretch}
.vd .se-ia.vd-record-art.is-testimony i:is(.im-celia,.im-hart,.im-c3_clerk){background-size:230% auto;background-position:50% 0}
.vd-record-detail .se-ivc>b{font-size:21px;padding-top:5px;line-height:1.35}
.vd-record-detail .se-ivc>b .vd-vi{font-size:15px;font-weight:400;margin-top:6px}
.vd-record-detail .se-ivc>p{line-height:1.7;margin:0}
.vd .vd-record-close{position:absolute;top:6px;right:6px;width:44px;height:44px;min-height:44px;font-size:26px;background:#162626d9}
.vd-record-source{font-size:12px;color:#9ab8b0}.vd-record-note{font-size:11px;color:#c5b39c;border-top:1px solid #ffffff19;padding-top:10px}
.vd-conclusion{padding:14px 0;border-bottom:1px solid #d6c49124}
.vd-conclusion>small{font-size:10px;color:#a4b7b1}.vd-conclusion h3{font-size:15px;line-height:1.6;font-weight:500}
.vd-conclusion>div{display:grid;gap:7px}.vd-conclusion .se-btn{display:flex;align-items:center;gap:9px;text-align:left;white-space:normal;min-height:52px}
.vd-settings-quick{display:grid;gap:10px;padding-bottom:16px;margin-bottom:8px;border-bottom:1px solid #d6c49133}
.vd-settings-links{display:grid;grid-template-columns:1fr 1fr;gap:8px}.vd-settings-links button{min-width:0;width:auto;white-space:normal;font-size:12px}
.vd-settings-quick>.se-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.vd-settings-quick>.se-row button{font-size:11px;white-space:normal;min-width:0}
.vd .vd-settings .se-ovo{min-height:55px}.vd .vd-settings .se-ovo small{line-height:1.5}
.vd .se-ct{animation:vd-title-arrive .8s ease-out both}.vd .se-ct>small{letter-spacing:.22em;animation:vd-title-line .75s .1s ease-out both}.vd .se-ct>b{animation:vd-title-line .9s .25s ease-out both}.vd .se-ct>i{animation:vd-title-line .75s .5s ease-out both}
.vd .se-ct>em{height:1px;width:min(200px,60vw);background:linear-gradient(90deg,transparent,#d6b878,transparent);transform-origin:center;animation:vd-title-rule 1s .3s ease-out both}
.vd .se-end>small,.vd .se-end>h2,.vd .se-end>p{animation:vd-title-line .65s ease-out both}
.vd-chapter-progress{display:flex;gap:5px;max-width:250px;margin:10px auto 22px}
.vd-chapter-progress i{height:3px;flex:1;border-radius:2px;background:#a9bab329}.vd-chapter-progress i.done{background:#d6b878}
.vd-chapter-close,.vd-next-objective{border:1px solid #cdb4762a;border-radius:14px;background:#14262288;padding:15px;text-align:left;margin:16px 0;font-size:14px;line-height:1.7}
.vd-next-objective>small{display:block;text-transform:uppercase;letter-spacing:.12em;color:#cdb476;font-size:10px;margin-bottom:8px}
@keyframes vd-title-arrive{from{opacity:0}to{opacity:1}}
@keyframes vd-title-line{from{opacity:0;transform:translateY(10px);filter:blur(3px)}to{opacity:1;transform:translateY(0);filter:blur(0)}}
@keyframes vd-title-rule{from{opacity:0;transform:scaleX(.2)}to{opacity:1;transform:scaleX(1)}}
@media(max-width:360px){.vd-record-card{gap:8px;padding:11px 8px}.vd .se-ia.vd-record-art{width:48px;height:56px;flex-basis:48px}.vd-record-copy>b{font-size:12px}.vd-record-brief{font-size:11px}.vd .vd-casebook .se-tabs{top:-14px}}
@media(prefers-reduced-motion:reduce){.vd .se-ct,.vd .se-ct>*,.vd .se-end>*{animation:none!important;filter:none!important;transform:none!important}}
.vd .se-deduce-focus{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:10px 0;font-size:11px;color:#b4c5bf}.vd .se-deduce-focus button{min-height:44px;flex:none;font-size:11px}
.vd .se-deduce-categories{display:flex;gap:5px;margin-bottom:12px}.vd .se-deduce-categories button{flex:1;min-width:0;min-height:44px;font-size:11px;padding:6px;white-space:normal}
.vd-case-resolution{border:1px solid #d6b87866;border-radius:12px;background:#d6b8780b;padding:16px;margin:4px 0 18px;line-height:1.65}.vd-case-resolution>small{font-size:10px;letter-spacing:.07em;color:#d6b878}.vd-case-resolution h3{font-size:18px;font-weight:500}.vd-case-resolution p{font-size:14px}
/* Substantive native investigation text follows Vale's EN/translation policy. */
.vd .vd-investigation-copy,.vd .vd-investigation-copy>span{display:block;min-width:0;width:auto;height:auto;background:none;border-radius:0;white-space:normal;overflow-wrap:anywhere;place-items:initial;color:inherit}
.vd .vd-investigation-sub{margin-top:4px;font-size:.88em;line-height:1.45;font-weight:400;opacity:.78;text-transform:none;letter-spacing:normal}
.vd .vd-investigation-sub[hidden]{display:none!important}
.vd .tk-t>span,.vd .tk-h>span{min-width:0}.vd .tk-h{flex-wrap:wrap}.vd .tk-h>b{flex:none}.vd .tk-h>span{flex:1 1 170px}
.vd .tk-t .vd-investigation-sub{color:inherit;opacity:.83}.vd .tk-f .se-btn{white-space:normal;min-width:0}
.vd .se-ddg{grid-template-columns:repeat(2,minmax(0,1fr))}.vd .se-ddc,.vd .se-eqs{min-width:0}
.vd .se-ddc>b,.vd .se-ddc>small,.vd .se-eqs>b{min-width:0;max-width:100%;width:100%}
.vd .se-ddq .vd-investigation-sub{font-family:var(--se-sans);font-size:14px;line-height:1.5}
.vd .se-eqs>b{font-size:12px;line-height:1.35;overflow-wrap:anywhere}
.vd .se-rev{overflow-y:auto;overscroll-behavior:contain}
.vd .rv-c{min-width:0;max-width:100%;margin-block:auto}
.vd .rv-n,.vd .rv-d{min-width:0;max-width:100%;overflow-wrap:anywhere}
.vd .rv-d{max-height:28dvh;overflow-y:auto;overscroll-behavior:contain;padding-inline:3px}
.vd .rv-n .vd-investigation-sub{font-size:15px;line-height:1.4}
.vd .vd-record-detail .se-ivc>b .vd-investigation-sub{font-size:15px;margin-top:6px}
.vd .vd-record-copy .vd-investigation-sub{font-size:.92em;line-height:1.4;margin-top:3px;opacity:.74}
.vd .vd-record-filters button{white-space:normal;overflow-wrap:anywhere}
.vd .vd-mobile-intro>b,.vd .vd-mobile-intro>small{display:block}.vd .vd-mobile-intro>small{margin:4px 0 8px;color:#b8c7c1}
/* Compact record receipts retain visible art and an explicit inspection affordance. */
.vd .se-t.receipt{padding:0;overflow:hidden;pointer-events:auto;background:#14282bf5;border:1px solid #bca77770;border-radius:13px}
.se-item-receipt{display:flex;align-items:center;gap:10px;width:100%;min-height:70px;padding:10px 12px;color:inherit;background:none;border:0;text-align:left;cursor:pointer;touch-action:manipulation}
.se-item-receipt>.se-ia{display:block;flex:none;width:48px;height:54px;min-width:48px;border:1px solid #d1b98150;border-radius:7px;overflow:hidden}
.se-item-receipt>span:not(.se-ia){flex:1;min-width:0}.se-item-receipt small,.se-item-receipt b,.se-item-receipt em{display:block}
.se-item-receipt small{font-size:10px;color:#c9b789;letter-spacing:.04em}.se-item-receipt b{margin-top:3px;font-size:13px;line-height:1.4}.se-item-receipt em{margin-top:3px;color:#b9c9c3;font:11px/1.4 var(--se-sans)}
.se-item-receipt>i{flex:none;width:19px;height:19px;color:#c9b789}.se-item-receipt svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.7}
.vd .rv-st .vd-record-art{display:block;width:100%;height:100%;border-radius:14px;border:1px solid #bca77755;background:#1b2b2a;overflow:hidden}
.vd .rv-st .vd-record-art>i{position:absolute;inset:0;display:block;background-repeat:no-repeat;background-position:center;background-size:contain}
.vd .rv-b{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}.vd .rv-b button{min-height:44px}
.vd .se-iv .rv-b{margin-top:16px;padding-top:12px;border-top:1px solid #bca77740}.vd .se-iv .rv-b button{flex:1}
.vd .se-read .rd-p{user-select:text;-webkit-user-select:text}.vd .se-read .rd-bar{gap:10px;padding-bottom:max(12px,env(safe-area-inset-bottom,0px))}
.vd .se-fixed-role{flex:none;font-size:11px;color:var(--se-mute)}
.vd .vd-voice-preview{margin-top:12px}.vd .vd-voice-preview .se-row{display:grid;grid-template-columns:1fr 1fr 44px;gap:8px}.vd .vd-voice-preview button{min-height:44px;display:flex;align-items:center;justify-content:center;gap:7px}.vd .vd-voice-preview button svg{width:17px;height:17px;flex:none}.vd .vd-voice-preview [data-voice-status]{min-height:1.4em;margin:8px 0 0;font-size:12px;line-height:1.45}
.vd .se-stat{transition:background .22s,border-color .22s,box-shadow .22s}.vd .se-stat.big{box-shadow:0 4px 16px #0002;border-color:#bca77766}
.vd .se-stat .st-l{animation:vale-location-arrive .36s ease-out}.vd .se-ct b{line-height:1.22;text-wrap:balance}.vd .se-ct i{line-height:1.5;text-wrap:balance}
/* Long location/time labels stay on two lines; tap their native button for full text. */
.vd .se-stat{min-height:44px}.vd .se-stat.big.has{height:44px;min-height:44px;padding:4px 8px}
.vd .se-stat .st-l{width:100%;min-width:0;gap:2px}
.vd .se-stat .st-n,.vd .se-stat .st-t{display:block;max-width:100%;width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-wrap:nowrap;text-align:center}
@keyframes vale-location-arrive{from{opacity:.3;transform:translateY(3px)}to{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){.vd .se-txt.ty .c{animation:none;opacity:1}.vd .se-stat,.vd .se-stat .st-l,.vd .se-ct *{animation:none!important;transition:none!important}.vd .se-ct b,.vd .se-ct i{opacity:1;transform:none}}
/* Keep inspection and dismissal visible on narrow phones; only long notes scroll. */
@media(max-width:600px) and (min-height:501px){
 .vd .se-rev{padding:max(12px,env(safe-area-inset-top,0px)) 16px max(12px,env(safe-area-inset-bottom,0px));overflow:hidden}
 .vd .se-rev .rv-c{width:min(100%,380px);max-height:calc(100dvh - 24px - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px));grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto auto minmax(0,1fr) auto auto;gap:7px;min-height:0}
 .vd .se-rev .rv-k{grid-row:1}
 .vd .se-rev .rv-st{grid-row:2;width:min(42vw,19dvh,170px);height:min(42vw,19dvh,170px);min-height:0;aspect-ratio:1}
 .vd .se-rev .rv-n{grid-row:3;font-size:clamp(18px,5.3vw,22px);line-height:1.25}
 .vd .se-rev .rv-d{grid-row:4;min-height:0;overflow-y:auto;overscroll-behavior:contain;padding:2px 5px}
 .vd .se-rev .rv-b{grid-row:5;gap:6px;margin:0}
 .vd .se-rev .rv-b:empty{display:none}
 .vd .se-rev .rv-b button{min-height:44px;padding:8px 14px}
 .vd .se-rev .rv-tap{grid-row:6;min-height:44px;margin:0;padding:10px 14px;animation:none;border:1px solid #bca77755;border-radius:12px;background:#17292ef5;color:#f1e5ca;font-size:14px}
}
/* Record discovery stays bounded and calm; long bilingual text alone scrolls. */
.vd .se-rev.compact-record{padding:max(16px,env(safe-area-inset-top,0px)) 16px max(16px,env(safe-area-inset-bottom,0px));overflow:hidden;animation-duration:.18s}
.vd .se-rev.compact-record.out{animation-duration:.16s}
.vd .compact-record .rv-bg{background:#061013b8}
.vd .compact-record.fresh .rv-bg::before{display:none}
.vd .compact-record .rv-c{width:min(100%,400px);max-width:100%;max-height:calc(100dvh - 32px - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px));min-height:0;margin:0;padding:18px;box-sizing:border-box;display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto auto minmax(0,1fr) auto auto;gap:9px;background:#132529;border:1px solid #bca77770;border-radius:18px;box-shadow:0 12px 40px #0005;text-align:center}
.vd .compact-record .rv-c>*{grid-column:1;max-width:100%}
.vd .compact-record .rv-k{grid-row:1;font-size:10px;line-height:1.4;letter-spacing:.12em}
.vd .compact-record .rv-st{grid-row:2;width:112px;height:112px;min-height:0;aspect-ratio:1;animation:none}
.vd .compact-record .rv-st .se-ia{border-radius:12px}
.vd .compact-record .rv-st .se-ia i{filter:drop-shadow(0 5px 8px #0004)}
.vd .compact-record .rv-n{grid-row:3;margin:0;font-size:19px;line-height:1.3}
.vd .compact-record .rv-n .vd-vi{font-size:14px;line-height:1.4}
.vd .compact-record .rv-copy{grid-row:4;display:grid;grid-template-rows:minmax(0,1fr) auto;min-height:0;width:100%;max-height:250px}
.vd .compact-record .rv-copy .rv-d{grid-row:1;grid-column:1}
.vd .compact-record .rv-d{min-height:0;max-height:230px;overflow-y:auto;overscroll-behavior:contain;margin:0;padding:2px 4px;font-size:14px;line-height:1.5;scrollbar-width:thin;scrollbar-color:#a89668 #132529}
.vd .compact-record .rv-scroll-hint{grid-row:2;grid-column:1;padding:4px 0 0;color:#d2bc88;font-size:10px;line-height:1.4}
.vd .compact-record .rv-d .vd-vi{font-size:12.5px;line-height:1.5}
.vd .compact-record .rv-b{grid-row:5;gap:8px;margin:0;display:flex;flex-wrap:wrap;justify-content:center}
.vd .compact-record .rv-b:empty{display:none}
.vd .compact-record .rv-b button{min-height:44px;padding:9px 15px}
.vd .compact-record .rv-tap{grid-row:6;width:100%;min-height:44px;margin:0;padding:10px 14px!important;border:1px solid #bca77770!important;border-radius:11px;background:#d6b8781f!important;color:#f1e5ca;font:600 14px/1.4 var(--se-sans);animation:none}
.vd .compact-record :is(button,.rv-d):focus-visible{outline:2px solid #e4ca8d;outline-offset:3px}
.vd .se-record-receipt-row{display:flex;align-items:stretch;width:100%}
.vd .se-record-receipt-row .se-item-receipt{flex:1;min-width:0;min-height:64px;padding:8px 4px 8px 10px;gap:8px}
.vd .se-record-receipt-row .se-item-receipt>.se-ia{width:38px;height:44px;min-width:38px}
.vd .se-record-receipt-row .se-item-receipt>i{display:none}
.vd .se-record-dismiss{flex:none;width:44px;min-height:44px;border:0;border-left:1px solid #bca77728;background:none;color:#dbc99f;font:24px/1 var(--se-sans);cursor:pointer;touch-action:manipulation}
@media(max-height:650px){.vd .compact-record .rv-c{padding:13px;gap:6px}.vd .compact-record .rv-st{width:84px;height:84px}.vd .compact-record .rv-n{font-size:17px}.vd .compact-record .rv-copy{max-height:min(37dvh,220px)}.vd .compact-record .rv-d{max-height:min(34dvh,200px)}}
@media(max-height:440px) and (min-width:601px){.vd .compact-record .rv-c{width:min(100%,680px);grid-template-columns:120px minmax(0,1fr);grid-template-rows:auto auto minmax(0,1fr) auto auto;column-gap:18px}.vd .compact-record .rv-c>*{grid-column:2}.vd .compact-record .rv-st{grid-column:1;grid-row:1 / 6;width:112px;height:112px}.vd .compact-record .rv-k{grid-row:1}.vd .compact-record .rv-n{grid-row:2}.vd .compact-record .rv-copy{grid-row:3}.vd .compact-record .rv-b{grid-row:4}.vd .compact-record .rv-tap{grid-row:5}}
@media(prefers-reduced-motion:reduce){.vd .se-rev.compact-record{animation:none}}

/* Showing a record is a deliberate two-step action, with searchable context. */
.vd .se-panel.tk:has(.tk-pick){max-height:calc(100dvh - 100px);overflow-y:auto;overscroll-behavior:contain;padding:14px}
.vd .tk-pick{display:grid;gap:10px;min-width:0}
.vd .v93-record-purpose{margin:0;font-size:13px;line-height:1.5;color:#d5ded8}
.vd .v93-record-search{display:grid;gap:6px;text-align:left;font-size:12px;color:#d4c296}
.vd .v93-record-search input{width:100%;min-height:44px;box-sizing:border-box}
.vd .v93-record-filters{display:flex;gap:6px;flex-wrap:wrap}
.vd .v93-record-filters button{flex:1;min-height:44px;padding:7px;font-size:11px}
.vd .v93-record-filters button.on{border-color:#d8bc7b;background:#d8bc7b20}
.vd [data-talk-count]{font-size:11px;line-height:1.4;color:#b9c8c1}
.vd .v93-record-list{display:grid;gap:8px;min-width:0;text-align:left}
.vd .v93-record-card{display:flex;align-items:flex-start;gap:10px;width:100%;min-width:0;min-height:76px;padding:10px;border:1px solid #aab6a74a;border-radius:11px;background:#172a2c;color:#eee7d5;text-align:left;cursor:pointer;touch-action:manipulation}
.vd .v93-record-card>.se-ia{flex:none;width:44px;height:50px}
.vd .v93-record-card>span:not(.se-ia){min-width:0;flex:1}
.vd .v93-record-card b{display:block;font-size:14px;line-height:1.4}
.vd .v93-record-card small{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;margin-top:6px;font-size:12px;line-height:1.45;color:#bccbc3}
.vd .v93-record-card .vd-vi{font-size:11.5px;line-height:1.4;margin-top:3px}
.vd .v93-record-card:focus-visible{outline:2px solid #e4c98a;outline-offset:2px}
.vd .v93-record-preview{display:grid;gap:12px;padding:13px;border:1px solid #bba77765;border-radius:13px;background:#172a2c;color:#eee7d5;text-align:left}
.vd .v93-record-preview-head{display:flex;align-items:center;gap:12px;min-width:0}
.vd .v93-record-preview-head>.se-ia{flex:none;width:64px;height:72px}
.vd .v93-record-preview-head>b{min-width:0;font-size:17px;line-height:1.4}
.vd .v93-record-preview-text{font-size:14px;line-height:1.55}
.vd .v93-record-preview-text .vd-vi{margin-top:10px;font-size:13px;line-height:1.55;color:#c2cec6}
.vd .v93-record-preview .se-row{display:flex;gap:8px;flex-wrap:wrap}
.vd .v93-record-preview .se-row>button{flex:1 1 110px;min-height:48px;white-space:normal;line-height:1.4;padding:9px 12px}
.vd .v93-record-preview>button{min-height:44px}
.vd .v93-comparison-focus{margin:0 0 12px;padding:10px 12px;border-left:3px solid #a5884b;background:#9b7f3f12;color:#594c35;font-size:14px;line-height:1.5;text-align:left}
.vd .present .v93-record-preview-text{max-height:none}
.vd .se-panel.present{scroll-padding-top:max(76px,calc(var(--sat,env(safe-area-inset-top,0px)) + 68px));scroll-padding-bottom:16px}
.vd .present .v93-record-preview>small{color:#d8c48c;font-weight:600}
.vd .present .v93-record-preview>[data-present-details]{color:#eee2be;border-color:#bba77780;background:#22383a}
.vd .present .v93-record-card.v8-tried{opacity:1;border-style:dashed}
.vd .present .v93-record-card.v8-tried::after{content:'↺';color:#c8b483;flex:none}
.vd .present .se-ev{padding:12px 0 0}
.vd .present .v8-present-feedback{animation:none;box-shadow:none}
.vd .present .se-steps span{font-size:10px;line-height:1.35}
.vd .present .v8-ev-filters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}
.vd .present .v8-ev-filters button{padding:7px;min-height:44px;font-size:11px}
.vd .pp.scenery{pointer-events:none;cursor:default}.vd .pp.scenery::after{opacity:.44}
/* Vale 0.8 additions: scoped to Vale. Existing vertical VN layout is retained. */
.v8 [hidden]{display:none!important}
.v8 button:focus-visible,.v8 input:focus-visible{outline:2px solid #f2d492;outline-offset:3px}
.v8-contextbar{position:absolute;z-index:23;top:calc(var(--vale-toolbar-height,58px) + 3px);left:12px;right:12px;display:flex;align-items:center;gap:9px;width:calc(100% - 24px);max-height:64px;min-height:48px;border:1px solid #d6b87855;border-radius:12px;padding:7px 11px;text-align:left;color:#e9e5d6;background:#101e20ed;box-shadow:0 3px 18px #0003;cursor:pointer;font:inherit;touch-action:manipulation}
.v8-context-copy{display:grid;gap:3px;min-width:0;flex:1}.v8-presence{font-size:11px;color:#dbc793;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.v8-mission{font-size:11px;line-height:1.35;color:#e1e6e2;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.v8-context-icon{font-size:21px;color:#d6b878}.v8-context-more{font-size:17px;color:#c1d5cf}
.v8-guide-off .v8-contextbar,.v8[data-m="ov"] .v8-contextbar,.v8:has(.se-end) .v8-contextbar,.v8:has(.se-ct) .v8-contextbar{display:none!important}
.v8-brief h3{margin:8px 0 16px;font-size:23px}.v8-brief h4{font-size:13px;color:#d6b878;margin:24px 0 10px}.v8-brief p{line-height:1.7}.v8-context-note,.v8-first-loop{padding:14px;background:#d6b8780c;border-left:3px solid #d6b878;border-radius:8px}.v8-cast-list{display:flex;flex-wrap:wrap;gap:7px}.v8-cast-list span{border:1px solid #9fb5ae44;border-radius:16px;padding:7px 12px;font-size:13px}
.v8-ev-filters{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}.v8-ev-filters .se-btn{min-height:44px;white-space:normal;font-size:12px;flex:1 1 28%;padding:8px}.v8-ev-filters .on{border-color:#dac080;background:#dac08021}.v8 .present .se-bag{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.v8 .present .se-bi{min-width:0;min-height:90px;max-width:100%;width:100%;border:1px solid #b4bca140;border-radius:10px;padding:10px}.v8 .present .se-bi small{overflow-wrap:anywhere;line-height:1.4}.v8 .present .v8-tried{opacity:.55;border-style:dashed}.v8-task-hint{font-size:12px;line-height:1.55;color:#b9c9c4;padding:10px 0}.v8-present-feedback{margin:12px 0;padding:13px;border:1px solid #cda66f88;border-left-width:4px;border-radius:10px;background:#493a262e;text-align:left;animation:v8-arrive .25s ease-out}.v8-present-feedback>b{display:block;font-size:12px;color:#e6c38e}.v8-present-feedback>p{font-size:14px;line-height:1.6;margin:7px 0}.v8-present-feedback>small{font-size:11px;color:#a9bdb6}.v8-hint-btn{margin:8px 0;min-height:44px}.v8 .present [data-sign]{margin-top:14px;min-height:48px}.v8 .present .se-seg-l{min-height:48px}.v8 .present .se-seg-l.on{box-shadow:inset 3px 0 #e3c178}.v8 .present [data-present-count]{display:block;line-height:1.5;margin:7px 0}
.v8-route-tabs{display:flex;gap:6px;flex-wrap:wrap}.v8-route-tabs button{min-height:44px;min-width:44px}.v8-route-status{font-size:13px;line-height:1.6;color:#dbc793}.v8-journey{position:relative;display:grid;gap:17px;margin:24px 0}.v8-journey:before{content:"";position:absolute;left:13px;top:20px;bottom:20px;width:2px;background:#c4ac7166}.v8-route-card{position:relative;display:grid;grid-template-columns:28px 70px minmax(0,1fr);gap:11px;align-items:start;min-width:0}.v8-route-number{position:relative;z-index:1;display:grid;place-items:center;background:#223331;color:#e6c88f;border:1px solid #e6c88f80;border-radius:50%;width:28px;height:28px;font-size:12px}.v8-route-art{height:86px;position:relative;overflow:hidden;border:1px solid #b8a36b44;border-radius:9px;background:#24312f}.v8-route-art i{position:absolute;inset:0;background-position:center;background-size:cover}.v8-route-card>div{display:grid;gap:7px;padding-bottom:5px;min-width:0}.v8-route-card small{font-size:10px;color:#a8b9b2;text-transform:uppercase;letter-spacing:.07em}.v8-route-card b{font-size:14px;line-height:1.5}.v8-route-card em{font-size:10px;color:#a6b8b0}.v8-route-card button{min-height:44px;justify-self:start;white-space:normal;text-align:left;font-size:11px}.v8-map-note{font-size:12px;line-height:1.5;color:#b8c9c3;background:#d6b87810;padding:10px}
.v8-ending-badge{display:flex;flex-direction:column;gap:6px;padding:15px 20px;border:1px solid #d6b87888;border-radius:12px;margin:12px auto 24px;background:#d6b87810;max-width:440px;animation:v8-arrive .5s ease-out}.v8-ending-badge b{font-size:21px;letter-spacing:.12em;color:#e5c98e}.v8-ending-badge span{font-size:13px;color:#d5dfd7}.v8-ending-badge.true{border-color:#82bfaa}.v8-ending-badge.true b{color:#9bddc3}.v8-ending-badge.bad{border-color:#d4998d}.v8-ending-badge.bad b{color:#e9aba0}.v8-ending-why{text-align:left;border:1px solid #d6b87833;background:#13262499;border-radius:14px;padding:16px;margin:18px 0}.v8-ending-why h3{font-size:13px;color:#d6b878}.v8-ending-why p{font-size:14px;line-height:1.6}.v8-ending-why>small{display:block;line-height:1.6;margin-top:12px;color:#a9bdb3}.v8-ending-why button{min-height:48px;white-space:normal}
.v8 .fx-n .fx-th{height:62px;min-height:62px}.v8 .fx-n .fx-th i{background-size:cover;background-position:center}.v8 .fx-wire path.now{stroke-width:3px}
@keyframes v8-arrive{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
@media(max-width:360px){.v8-contextbar{left:8px;right:8px;width:calc(100% - 16px);padding:6px 8px;gap:6px;max-height:58px}.v8-mission{font-size:10px}.v8-presence{font-size:10px}.v8-route-card{grid-template-columns:24px 56px minmax(0,1fr);gap:8px}.v8-route-art{height:76px}.v8-route-number{width:24px;height:24px}.v8-journey:before{left:11px}}
@media(min-aspect-ratio:11/10) and (max-height:560px){.v8-contextbar{left:8px;right:auto;width:calc(50% - 16px);max-height:56px}.v8-contextbar .v8-mission{-webkit-line-clamp:1}}
@media(prefers-reduced-motion:reduce){.v8-ending-badge,.v8-present-feedback{animation:none}}
.se-motion-reduced .v8-ending-badge,.se-motion-reduced .v8-present-feedback{animation:none}

/* Full-screen mechanics own their top space; the guide remains in the menu. */
.v8:has(.se-panel:not(.chs)) .v8-contextbar,.v8:has(.cb4-root) .v8-contextbar,.v8:has(.rc-root) .v8-contextbar{display:none!important}
.v8-cue{font-size:10px;line-height:1.3;color:#d9c693;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.v8-contextbar:has(.v8-cue:not([hidden])){max-height:78px}
.v8 .se-doc .v8-present-feedback{background:#fff8e9;color:#463a29;border-color:#a0733a}
.v8 .se-doc .v8-present-feedback>b{color:#785224}.v8 .se-doc .v8-present-feedback>small{color:#685c49}
.v8 .se-doc .v8-present-feedback:focus{outline:2px solid #7c6035;outline-offset:2px}
.v8 .v8-contextbar[data-mode="choice"] .v8-mission{font-weight:600}

/* Keep the speaking character visible below the persistent toolbar after a retry. */
.v8 .v8-present-feedback{scroll-margin-top:calc(var(--vale-toolbar-height,64px) + 14px);scroll-margin-bottom:14px}

/* 0.9.2: compact settings/help, preserving native mobile controls. */
.vd-settings-fold{margin:8px 0;border:1px solid #9fb5ae33;border-radius:12px;background:#ffffff03}
.vd-settings-fold>summary,.vd-help-detail>summary{min-height:48px;box-sizing:border-box;padding:12px 14px;font-size:15px;line-height:1.5;font-weight:650;cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:12px}
.vd-settings-fold>summary::-webkit-details-marker,.vd-help-detail>summary::-webkit-details-marker{display:none}
.vd-settings-fold>summary::after,.vd-help-detail>summary::after{content:'⌄';color:#d6b878;font-size:18px;flex:none}
.vd-settings-fold[open]>summary::after,.vd-help-detail[open]>summary::after{transform:rotate(180deg)}
.vd-settings-fold>summary:focus-visible,.vd-help-detail>summary:focus-visible{outline:2px solid #d6b878;outline-offset:2px;border-radius:10px}
.vd-settings-fold-body{padding:0 12px 12px}.vd-settings-fold-body>.se-og:first-child{border-top:0;margin-top:0;padding-top:0}
.vd-settings-support{display:flex;gap:8px;margin:12px 0 4px}.vd-settings-support>.se-btn{flex:1;min-width:0;min-height:44px;margin:0}
.vd-settings .vd-settings-quick{margin-bottom:12px}.vd-settings .vd-settings-quick>[data-resume]{min-height:44px}
.vd-help-steps{padding-left:22px;margin:12px 0}.vd-help-steps li{padding-left:2px;margin:9px 0;line-height:1.55}
.vd-help-detail{border-top:1px solid #9fb5ae33}.vd-help-detail>summary{padding-inline:0}
.vd-help-detail>p{line-height:1.6;margin:0 0 16px;color:#d0d6d2}.vd-guide>p{margin:8px 0 12px;line-height:1.55}

/* The player chooses when to read the scene objective; it stays folded across scenes. */
.vd .v8-contextbar{padding:0;gap:0;max-height:none;min-height:44px;cursor:default}
.vd .v93-context-toggle{display:flex;align-items:center;gap:8px;flex:1;min-width:0;min-height:44px;padding:8px 10px;border:0;background:none;color:inherit;text-align:left;font:inherit;cursor:pointer}
.vd .v93-context-label{display:none;font:600 12px/1.4 var(--se-sans);white-space:nowrap}
.vd .v93-context-chevron{flex:none;font-size:19px;line-height:1;transform:rotate(180deg)}
.vd .v8-contextbar .v8-context-more{flex:none;width:44px;min-height:44px;align-self:stretch;border:0;border-left:1px solid #d6b87830;background:none;cursor:pointer}
.vd .v8-contextbar.is-collapsed{left:12px;right:auto;width:auto;max-width:160px;max-height:44px;min-height:44px;box-shadow:none;background:#101e20eb}
.vd .v8-contextbar.is-collapsed .v93-context-label{display:block}
.vd .v8-contextbar.is-collapsed .v8-context-copy,.vd .v8-contextbar.is-collapsed .v8-context-more{display:none}
.vd .v8-contextbar.is-collapsed .v93-context-chevron{transform:none}
.vd .v8-contextbar .v8-cue{display:none}
/* 0.9.4: constant-size top icons; objective text is a temporary overlay.
   The overlay is deliberately outside measured HUD/scene-obstruction nodes. */
.vd.v94-hud .se-top>.se-stat{display:none!important}
.vd.v94-hud .se-top{min-height:44px}
.vd.v94-hud .se-top>.v8-contextbar{position:static!important;order:0;display:flex!important;flex:0 0 auto;gap:8px;align-items:center;width:auto!important;max-width:none;min-height:44px;max-height:44px;margin:0 auto 0 0;padding:0;border:0;border-radius:0;background:none;box-shadow:none}
.vd.v94-hud .se-top>.v8-contextbar[hidden],.vd.v94-hud[data-m="ov"] .se-top>.v8-contextbar{display:none!important}
.vd.v94-hud .v8-contextbar .v8-context-copy{display:none!important}
.vd.v94-hud .v8-contextbar :is(.v93-context-toggle,.v8-context-more){display:grid;place-items:center;flex:none;box-sizing:border-box;width:44px;min-width:44px;height:44px;min-height:44px;padding:10px;border:1px solid #d1bd8844;border-radius:13px;background:#0c171deb;color:#efe5ca;touch-action:manipulation;cursor:pointer}
.vd.v94-hud .v8-contextbar button[aria-expanded="true"]{border-color:#d1bd88;background:#24342f}
.vd.v94-hud .v8-contextbar button>svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.7}
.vd.v94-hud :is(.pl-goal[data-objective],.xp-goal[data-xp-objective],[data-xp-objective],.pl-objective){display:none!important;pointer-events:none!important}
.vd.v94-hud .se-scene-peek{width:44px;min-width:44px;min-height:44px;padding:10px;justify-content:center}
.vd.v94-hud .se-scene-peek>span{display:none!important}
.vd.v94-hud .v94-objective-notice{position:absolute;z-index:27;left:12px;top:calc(var(--vale-toolbar-height,64px) + 60px);display:flex;align-items:flex-start;gap:4px;width:min(360px,calc(100% - 24px));max-height:min(40dvh,240px);box-sizing:border-box;padding:4px 4px 4px 14px;border:1px solid #bba67575;border-radius:13px;background:#132528fa;color:#f2ead7;box-shadow:0 6px 24px #0004;pointer-events:auto;animation:v94-objective-in .16s ease-out}
.vd.v94-hud .v94-objective-notice[hidden]{display:none!important;pointer-events:none!important}
.vd.v94-hud .v94-objective-notice>div{flex:1;min-width:0;max-height:calc(min(40dvh,240px) - 10px);overflow:auto;padding:9px 0 10px}
.vd.v94-hud .v94-objective-notice small{display:block;color:#dbc58b;font-size:10px;font-weight:650;letter-spacing:.06em;text-transform:uppercase}
.vd.v94-hud .v94-objective-notice p{margin:6px 0 0;font-size:13px;line-height:1.5;overflow-wrap:anywhere}
.vd.v94-hud [data-objective-dismiss]{display:grid;place-items:center;flex:0 0 44px;width:44px;height:44px;min-height:44px;padding:12px;border:0;border-radius:9px;background:none;color:#e5d7b4;cursor:pointer;touch-action:manipulation}
.vd.v94-hud [data-objective-dismiss]>svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7}
.vd.v94-hud [data-objective-dismiss]:hover{background:#ead09a16}
@keyframes v94-objective-in{from{opacity:0;transform:translateY(-3px)}to{opacity:1;transform:none}}
@media(max-width:360px){.vd.v94-hud .v94-objective-notice{left:8px;width:calc(100% - 16px)}}
@media(prefers-reduced-motion:reduce){.vd.v94-hud .v94-objective-notice{animation:none}}
.vd.v94-hud.se-motion-reduced .v94-objective-notice{animation:none}
.vd .se-t.hint-notice{padding:0;pointer-events:auto;border:1px solid #bca77770;border-radius:12px;background:#14282bf7;overflow:hidden}
.vd .se-hint-notice{display:flex;align-items:stretch;color:#f1e7d0}
.vd .se-hint-notice>span{flex:1;min-width:0;padding:10px 12px;font-size:13px;line-height:1.45}
.vd .se-hint-notice small{display:block;margin-bottom:4px;color:#d1ba82;font-size:10px;text-transform:uppercase;letter-spacing:.08em}
.vd .se-hint-notice [data-dismiss-hint]{flex:none;width:44px;min-height:44px;border:0;border-left:1px solid #bca77730;background:none;color:#e6d2a1;font:24px/1 var(--se-sans);cursor:pointer}
/* Record arrivals have no lateral sweep from outside the scene. */
.vd .se-t.item.receipt{animation:none;transform:none}
/* Location at left, one menu at right; the folded objective sits beneath. */
.vd.v93-toolbar .se-top{z-index:26;gap:10px;min-height:44px;align-items:center;justify-content:space-between}
.vd.v93-toolbar .se-top>.se-stat{order:0;flex:0 1 auto;max-width:calc(100% - 92px);min-width:0;width:max-content;min-height:44px;margin-right:auto;padding:5px 12px;border-radius:13px;background:#0c171dde;backdrop-filter:none;-webkit-backdrop-filter:none;animation:none;box-shadow:none}
.vd.v93-toolbar .se-stat .st-l{max-width:100%;opacity:1;align-items:start;justify-items:start;gap:3px;transition:none}
.vd.v93-toolbar .se-stat :is(.st-n,.st-t){text-align:left;width:100%;font-size:12px;line-height:1.3;letter-spacing:.01em}
.vd.v93-toolbar .se-stat .st-t{font-size:10px;color:#dbc68e}
.vd.v93-toolbar .se-stat.has .sp-clock{display:none}
.vd.v93-toolbar .v93-quick-toggle{order:2;position:relative;display:flex;align-items:center;justify-content:center;gap:0;flex:none;width:44px;min-width:44px;height:44px;min-height:44px;padding:10px;border:1px solid #d1bd8844;border-radius:13px;background:#0c171deb;color:#efe5ca;font:600 12px/1.4 var(--se-sans);cursor:pointer;touch-action:manipulation}
.vd.v93-toolbar .v93-quick-toggle>svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7}
.vd.v93-toolbar .v93-quick-toggle[aria-expanded="true"]{border-color:#d1bd88;background:#24342f}
.vd.v93-toolbar .v93-menu-dot{position:absolute;top:6px;right:6px;width:5px;height:5px;border-radius:50%;background:#e2bf71}
.vd.v93-toolbar .se-grp.v93-quick-menu{position:absolute;z-index:1;right:12px;top:calc(100% + 3px);display:grid;gap:2px;width:min(236px,calc(100% - 24px));max-height:calc(100dvh - 92px);overflow:auto;margin:0;padding:6px;border:1px solid #d0b77b77;border-radius:14px;background:#132528;box-shadow:0 8px 26px #0005;backdrop-filter:none;-webkit-backdrop-filter:none;animation:v93-menu-in .14s ease-out}
.vd.v93-toolbar .v93-quick-menu>button{display:flex;align-items:center;justify-content:flex-start;gap:12px;width:100%;min-height:48px;height:auto;min-width:0;margin:0;padding:10px 12px;border:0;border-radius:9px;background:none;color:#eae6d6;text-align:left;font:500 14px/1.4 var(--se-sans);cursor:pointer}
.vd.v93-toolbar .v93-quick-menu>button:hover,.vd.v93-toolbar .v93-quick-menu>button:focus-visible{background:#ead09a16;outline:1px solid #d3bd8744;outline-offset:-1px}
.vd.v93-toolbar .v93-quick-menu>button svg{flex:none;width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7}
.vd.v93-toolbar .v93-quick-menu>button .v93-tool-label{flex:1;min-width:0;display:block}
.vd.v93-toolbar .v93-quick-menu>[data-quick-exit]{border-top:1px solid #d3bd8733;border-radius:0 0 9px 9px;margin-top:4px;padding-top:12px}
.vd.v93-toolbar .v93-quick-menu .se-dot{position:static;flex:none;order:3;width:6px;height:6px;margin-left:auto}
.vd.v93-toolbar .v93-quick-menu [data-a="trall"].on{background:#d1b3691a;color:#e4c687}
.vd.v93-toolbar .v93-menu-shield{position:absolute;inset:0;z-index:25;background:#02080b25;touch-action:none}
.vd.v93-toolbar.v93-menu-open :is(.se-motion-control,.se-scene-peek){visibility:hidden}
@keyframes v93-menu-in{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:none}}
@media(max-width:360px){.vd.v93-toolbar .se-top{gap:8px}.vd.v93-toolbar .se-top>.se-stat{max-width:calc(100% - 85px);padding:5px 9px}.vd.v93-toolbar .se-grp.v93-quick-menu{right:8px}}
@media(prefers-reduced-motion:reduce){.vd.v93-toolbar .se-grp.v93-quick-menu{animation:none}}

/* A temporary notification must never cover the open menu's native controls. */
.vd.v93-menu-open .se-toast{visibility:hidden;pointer-events:none}
.vd.v93-menu-open .se-toast .se-t{pointer-events:none}
/* Native choice cards, compact interview preparation. No full-screen replacement. */
.se-panel.chs.se-interrogation{display:flex;flex-direction:column;gap:8px;padding:12px 10px max(10px,env(safe-area-inset-bottom,0px));max-height:calc(100dvh - max(82px,calc(env(safe-area-inset-top,0px) + 70px)));overflow:hidden;background:linear-gradient(180deg,#131c20f2,#10161afa);border-top:1px solid #bda87755;border-radius:18px 18px 0 0}
.se-interrogation [hidden]{display:none!important}
.se-ig-head{flex:none;min-width:0;color:var(--se-fg)}
.se-ig-person{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:36px}
.se-ig-person>b{font:600 19px/1.3 var(--se-serif)}
.se-ig-help{flex:none;width:44px;height:44px;min-height:44px;padding:0;border:1px solid #acbdba55;border-radius:50%;background:#ffffff09;color:var(--se-fg);font:700 18px/1 var(--se-sans);cursor:pointer}
.se-ig-person .se-ig-help{margin-top:-5px;margin-bottom:-5px}
.se-ig-state{display:flex;gap:6px;flex-wrap:wrap;margin:1px 0 6px}
.se-ig-state>span{display:block;border-radius:20px;border:1px solid #d4b87844;background:#d4b87812;color:#dfd1b2;padding:3px 8px;font-size:11px;line-height:1.35}
.se-ig-reaction{font-size:13px;line-height:1.45;margin:5px 0 8px;color:#d7dfdd}
.se-ig-approaches{display:flex;gap:6px}
.se-ig-approaches>button{flex:1;min-width:0;min-height:44px;border:1px solid #a7b5b44d;background:#ffffff08;color:#e6e9e4;padding:6px;border-radius:12px;font-size:13px;line-height:1.3;font-weight:600;cursor:pointer}
.se-ig-approaches>button[aria-pressed=true]{border-color:var(--se-ac);background:#d8b97122;color:#f8dda1}
.se-ig-tools{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:44px}
.se-ig-tools>button{min-height:44px;border:0;background:transparent;padding:5px 2px;color:#b9c8c5;font-size:12px;text-align:left;cursor:pointer}
.se-ig-tools>button[aria-pressed=true]{color:#f6d78f;text-decoration:underline;text-underline-offset:4px}
.se-ig-count{font-size:11px;color:#a9b9b7}
.se-ig-helptext,.se-ig-empty{margin:5px 0 8px;font-size:13px;line-height:1.5;color:#cad4d1}
.se-ig-helptext{max-height:90px;overflow:auto;border-left:2px solid #d4b878;padding:5px 8px;white-space:pre-line}
.se-interrogation>.se-chs{flex:1;min-height:40px;overflow:auto;overscroll-behavior:contain;padding:3px 3px 8px;scrollbar-width:thin}
.se-interrogation .se-ch-b{flex:none;animation:none;min-height:52px}
.se-interrogation .se-ch-b>span{font-size:15px}
.se-interrogation .se-ch-b>small{font-size:12.5px}
.se-interrogation .se-ch-b.se-ig-prepared{outline:2px solid #e3c67e;outline-offset:1px;background:#fff2ca}
.se-ig-last{flex:none;font-size:12px;line-height:1.45;color:#c3d1ca}
.se-ig-last>summary{min-height:44px;display:flex;align-items:center;gap:7px;padding:5px 8px;cursor:pointer;border:1px solid #8b9e9344;border-radius:10px}
.se-ig-last>summary::before{content:'›';font-size:20px;line-height:1}
.se-ig-last[open]>summary::before{transform:rotate(90deg)}
.se-ig-last>.se-q{margin:6px 0;max-height:130px;overflow:auto}
.se-ig-exit{flex:none;border-top:1px solid #bda87733;padding-top:8px}
.se-ig-exit>.se-ch-b{width:100%;margin:0;background:#202c30;color:#edf0e9;box-shadow:none;border:1px solid #94a5a149;padding:9px 49px 9px 12px;border-radius:12px}
.se-ig-exit>.se-ch-b>small{color:#b5c4bf}
.se-ig-exit>.se-ch-b>.se-tag{display:none}
.se-ig-sheet .se-shb{display:flex;flex-direction:column;padding:0!important;overflow:hidden;min-height:0}
.se-ig-scroll{flex:1;min-height:40px;overflow:auto;overscroll-behavior:contain;padding:8px 16px 16px;scrollbar-width:thin}
.se-ig-sheet .se-ig-copy>span,.se-ig-sheet .se-ig-copy>small{display:block}
.se-ig-sheet .se-ig-copy>small{margin-top:5px;font-size:.86em;color:#b6c2be;line-height:1.5}
.se-ig-sheet [hidden]{display:none!important}
.se-ig-claim-select{display:block;font-size:12px;color:#b5c3bf}
.se-ig-claim-select>span{display:block;margin:0 0 5px}
.se-ig-claim-select select{display:block;width:100%;min-height:44px;border-radius:10px;border:1px solid #849b934d;background:#182321;color:#f1eee4;font:600 14px/1.3 var(--se-sans);padding:8px 10px}
.se-ig-quote{margin:12px 0 14px;border-left:2px solid #d6ba7c;background:#d6ba7c08;padding:10px 12px;font-size:15px;line-height:1.5}
.se-ig-quote cite{display:block;font-size:11px;color:#b7c3be;font-style:normal;margin-top:7px}
.se-ig-selected{border:1px solid #bfa87555;background:#bfa8750a;border-radius:12px;padding:12px;margin:0 0 14px}
.se-ig-checking{display:block;color:#c9b88b;font-size:11px;line-height:1.4;margin:0 0 8px}
.se-ig-record-title{display:flex;gap:10px;align-items:center;font-size:14px;line-height:1.4}
.se-ig-record-title>.se-ia{flex:none;width:42px;height:48px}
.se-ig-explanation{font-size:14px;line-height:1.55;margin:10px 0}
.se-ig-selected>.se-btn{min-height:44px;padding:6px 12px;font-size:12px}
.se-ig-follow{border-left:2px solid #80a898;padding:3px 10px;margin:10px 0 16px}
.se-ig-follow>small{font-size:11px;color:#accabf}
.se-ig-follow>p{font-size:14px;line-height:1.5;margin:5px 0!important}
.se-ig-inline-hint{border-left:2px solid var(--se-ac);background:#d4b87813;padding:10px;font-size:14px;line-height:1.5;margin:0 0 12px!important}
.se-ig-scroll>h3{font-size:13px!important;line-height:1.4;margin:12px 0 8px!important;color:#bccdc7}
.se-ig-record-list{display:flex;flex-direction:column;gap:7px}
.se-ig-record-list>button{display:flex;gap:10px;align-items:center;text-align:left;width:100%;min-height:60px;border:1px solid #81998f44;border-radius:12px;padding:9px;background:#16211ff0;color:#edf0e7;font:600 14px/1.4 var(--se-sans);cursor:pointer}
.se-ig-record-list>button[aria-pressed=true]{border-color:#d6ba7c;background:#d6ba7c18}
.se-ig-record-list>button>.se-ia{flex:none;width:36px;height:42px}
.se-ig-record-list>button>span:last-child{min-width:0;overflow-wrap:anywhere}
.se-ig-compare-foot{flex:none;display:flex;align-items:center;gap:8px;border-top:1px solid #a49c7d44;background:#101a18;padding:10px 12px max(10px,env(safe-area-inset-bottom,0px))}
.se-ig-compare-foot>.se-btn{display:flex;gap:6px;align-items:center;justify-content:center;min-height:44px;min-width:0;padding:7px 10px;font-size:13px;line-height:1.3}
.se-ig-compare-foot>.se-btn svg{width:18px;height:18px}
.se-ig-compare-foot>[data-ig-ask]{flex:1}
.se-ig-compare-foot>.se-btn:disabled{opacity:.6}
.se-interrogation button:focus-visible,.se-ig-sheet button:focus-visible,.se-ig-claim-select select:focus-visible{outline:2px solid #f4d994;outline-offset:2px}
@media(max-height:500px){.se-panel.chs.se-interrogation{max-height:calc(100dvh - 70px);gap:4px;padding-top:7px}.se-ig-head{display:grid;grid-template-columns:minmax(120px,.8fr) minmax(210px,1.2fr);gap:0 12px}.se-ig-person{grid-area:1/1}.se-ig-state{grid-area:2/1}.se-ig-reaction{grid-area:3/1/5/2;font-size:12px;margin:0}.se-ig-approaches{grid-area:1/2/3/3;align-self:center}.se-ig-tools{grid-area:3/2/5/3}.se-ig-helptext{grid-column:1/-1}.se-interrogation>.se-chs{max-height:130px}.se-ig-exit>.se-ch-b{padding-block:6px}.se-ig-exit>.se-ch-b>span{font-size:13px}.se-ig-exit>.se-ch-b>small{font-size:11px}}
@media(max-width:380px){.se-ig-state>span{font-size:10.5px}.se-ig-reaction{font-size:12px}.se-ig-approaches>button{font-size:12px}.se-ig-scroll{padding-inline:12px}}
@media(prefers-reduced-motion:reduce){.se-interrogation,.se-ig-sheet .se-shc{animation:none!important}.se-interrogation .se-ch-b{transition:none!important}}
/* Optional, non-punitive interview preparation on native choice.
   Native choice remains the only executor of once/cost/effects/voice/branches.
   This module sorts the questions and compares known records; it never guesses a lie. */
(() => {
  const E = globalThis.StoryEngine, esc = E.esc, original = E.mech.choice;
  const T = (en, vi) => ({ en, vi }), nat = t => E.nat(t);
  const read = (x, s) => typeof x === 'function' ? x(s) : x;
  const condition = (x, s) => x == null ? true : typeof x === 'function' ? !!x(s) : typeof x === 'string' ? !!s.f[x] || s.has(x) : !!x;
  const indexOf = (st, key) => Number.isInteger(key) ? key : st.choice.findIndex(o => o.id === key);
  const optionKey = (o, i) => o.id || String(i);
  const text = t => E.ui.investigationText ? E.ui.investigationText(t) : `<span class="se-ig-copy"><span lang="${esc(E.L)}">${esc(E.tgt(t))}</span>${E.sub(t) ? `<small data-ig-tr lang="${esc(E.N)}"${E.G().set.tr ? '' : ' hidden'}>${esc(E.sub(t))}</small>` : ''}</span>`;
  const labels = {
    calm: T('Calm', 'Nhẹ nhàng'), direct: T('Direct', 'Hỏi thẳng'),
    records: T('Records', 'Hồ sơ'), all: T('All questions', 'Mọi câu hỏi'),
    back: T('Back', 'Quay lại'), compare: T('Compare an account', 'Đối chiếu lời kể'),
    claim: T('One point to check', 'Một điều cần kiểm tra'),
    held: T('Records you have', 'Hồ sơ đang có'),
    ask: T('Review question', 'Xem câu hỏi'), asked: T('Already asked', 'Đã hỏi'),
    next: T('A question to follow up', 'Câu hỏi tiếp theo'),
    hint: T('A nudge', 'Gợi ý'), detail: T('Read the record', 'Đọc hồ sơ'),
    empty: T('You have no records to compare yet. You can return to the questions.', 'Bạn chưa có hồ sơ để đối chiếu. Có thể quay lại hỏi chuyện.'),
    filtered: T('No unanswered questions in this approach. Try another approach or show all questions.', 'Đã hỏi hết nhóm này. Bạn có thể đổi cách hỏi hoặc xem mọi câu hỏi.'),
    unknown: T('This record does not address that point. Choose another, or return to the questions.', 'Hồ sơ này chưa trả lời được điều đang kiểm tra. Bạn có thể chọn hồ sơ khác hoặc quay lại hỏi chuyện.'),
    help: T('Choose a way to ask, or compare one account with a record. You can change your mind before asking. These observations describe the exchange, not whether someone is lying.', 'Chọn cách hỏi, hoặc đối chiếu một lời kể với hồ sơ. Bạn có thể đổi ý trước khi hỏi. Phản hồi mô tả cuộc trò chuyện, không kết luận ai nói dối.'),
    observation: T('What changed in the exchange', 'Điều vừa thay đổi trong cuộc trò chuyện'),
    participation: T('Willingness to answer', 'Mức sẵn lòng trả lời'),
    tension: T('Observed tension', 'Vẻ căng thẳng quan sát được')
  };

  // Also usable by build tools/tests without starting an interaction.
  function validate(st, story = E.S()) {
    const errors = [], C = st?.interrogation, options = st?.choice || [];
    const validRef = ref => { const i = indexOf({ choice: options }, ref); return i >= 0 && i < options.length; };
    if (!C || typeof C !== 'object' || Array.isArray(C)) return ['interrogation needs an object'];
    if (!Array.isArray(st.choice)) return ['interrogation requires a native choice'];
    for (const k of ['approaches', 'always', 'claims', 'recordIds']) if (C[k] != null && !Array.isArray(C[k])) errors.push(k + ' needs an array');
    if (C.questions != null && (typeof C.questions !== 'object' || Array.isArray(C.questions))) errors.push('questions needs an object');
    if (errors.length) return errors;
    if (!C.id || typeof C.id !== 'string') errors.push('interrogation needs a stable id');
    if (C.who && !story?.chars?.[C.who]) errors.push('unknown interview character: ' + C.who);
    if (st.timer) errors.push('interrogation preparation cannot share a timed choice');
    const ids = new Set();
    for (const a of C.approaches || []) {
      if (!a || typeof a !== 'object' || Array.isArray(a)) { errors.push('approach needs an object'); continue; }
      if (!a.id || typeof a.id !== 'string' || ['all', 'records'].includes(a.id) || ids.has(a.id)) errors.push('approach id is missing, reserved or duplicated');
      ids.add(a?.id);
      if (!a?.label || !Array.isArray(a.questions) || !a.questions.length) errors.push('approach needs a label and questions');
      if (Array.isArray(a.questions)) for (const ref of a.questions) if (!validRef(ref)) errors.push('unknown approach question: ' + ref);
    }
    for (const id of C.recordIds || []) if (!story?.items?.[id]) errors.push('unknown interview record: ' + id);
    for (const ref of C.always || []) if (!validRef(ref)) errors.push('unknown always-visible question: ' + ref);
    for (const [ref, q] of Object.entries(C.questions || {})) {
      if (!validRef(ref)) errors.push('unknown reaction question: ' + ref);
      if (!q || typeof q !== 'object' || Array.isArray(q)) { errors.push('question reaction needs an object: ' + ref); continue; }
      if (q.reaction && q.complete == null) errors.push('reaction needs an explicit completion condition: ' + ref);
    }
    const claims = new Set();
    for (const claim of C.claims || []) {
      if (!claim || typeof claim !== 'object' || Array.isArray(claim)) { errors.push('claim needs an object'); continue; }
      if (!claim?.id || claims.has(claim.id)) errors.push('claim id is missing or duplicated');
      claims.add(claim?.id);
      if (!claim?.quote || !claim?.title) errors.push('claim needs a title and known words');
      if (claim.question != null && !validRef(claim.question)) errors.push('unknown follow-up question: ' + claim.question);
      if (claim.records != null && (typeof claim.records !== 'object' || Array.isArray(claim.records))) { errors.push('claim records needs an object'); continue; }
      for (const [id, result] of Object.entries(claim.records || {})) {
        if (!story?.items?.[id]) errors.push('unknown comparison record: ' + id);
        if (!result?.note) errors.push('comparison needs an explanation: ' + id);
      }
    }
    return errors;
  }
  E.interrogation = { validate };
  const setTr = E.ui.setTr;
  E.ui.setTr = (...args) => { const r = setTr(...args); document.querySelectorAll('[data-ig-tr]').forEach(el => { el.hidden = !E.G().set.tr; }); document.querySelectorAll('.se-ig-exit small:not(.se-lh)').forEach(el => { el.hidden = !E.G().set.tr && E.G().set.mode !== 'easy'; }); return r; };

  E.def('choice', c => {
    const C = c.st.interrogation;
    if (!C) return original(c);
    const errors = validate(c.st);
    if (errors.length) { console.warn('[story] interrogation metadata; using native choice', errors); return original(c); }
    const pending = original(c), box = document.querySelector('.se-ui > .se-panel.chs');
    // Native empty/skipIfOne/auto may already have moved on. Never intercept it.
    if (!box || (c.live && !c.live())) return pending;
    const R = E.R(), st = c.st, key = C.id, owner = c.key('interrogation');
    const runs = R.interrogations && typeof R.interrogations === 'object' && !Array.isArray(R.interrogations) ? R.interrogations : (R.interrogations = {});
    const old = runs[key], saved = runs[key] = old && typeof old === 'object' && !Array.isArray(old) ? old : {};
    saved.version = 1;
    saved.approach = (C.approaches || []).some(a => a.id === saved.approach) ? saved.approach : 'all';
    saved.history = Array.isArray(saved.history) ? saved.history.filter(x => C.questions?.[x]).slice(-12) : [];
    if (saved.pending) {
      const q = C.questions?.[saved.pending];
      if (q && condition(q.complete, E.state())) { saved.last = saved.pending; saved.history.push(saved.pending); saved.history = saved.history.slice(-12); }
      delete saved.pending;
    }
    if (!C.questions?.[saved.last]) delete saved.last;
    let disposed = false, selecting = false, sheet = null, suppressClose = false;
    const live = () => !disposed && !selecting && E.R() === R && (!c.live || c.live());
    const buttons = [...box.querySelectorAll('.se-chs > .se-ch-b[data-i]')];
    const buttonFor = ref => buttons.find(b => +b.dataset.i === indexOf(st, ref));
    const available = ref => { const b = buttonFor(ref); return b && !b.disabled && !b.classList.contains('off'); };
    const reaction = read(C.questions?.[saved.last]?.reaction, E.state()) || read(C.initial, E.state()) || {};
    const name = C.who ? E.cname(E.S().chars[C.who], true) : nat(C.title || T('Interview', 'Hỏi chuyện'));
    const head = E.h(`<div class="se-ig-head"><div class="se-ig-person"><b>${esc(name)}</b><button type="button" class="se-ig-help" data-ig-help aria-label="${esc(nat(labels.hint))}">?</button></div><div class="se-ig-state" aria-label="${esc(nat(labels.observation))}">${reaction.openness ? `<span title="${esc(nat(labels.participation))}">${esc(nat(reaction.openness))}</span>` : ''}${reaction.tension ? `<span title="${esc(nat(labels.tension))}">${esc(nat(reaction.tension))}</span>` : ''}</div>${reaction.note ? `<p class="se-ig-reaction" role="status">${esc(nat(reaction.note))}</p>` : ''}<div class="se-ig-approaches" role="group" aria-label="${esc(nat(T('Ways to ask', 'Cách hỏi')))}">${(C.approaches || []).map(a => `<button type="button" data-ig-approach="${esc(a.id)}" aria-pressed="false">${esc(nat(a.label))}</button>`).join('')}${C.claims?.length ? `<button type="button" data-ig-records>${esc(nat(labels.records))}</button>` : ''}</div><div class="se-ig-tools"><button type="button" data-ig-all aria-pressed="true">${esc(nat(labels.all))}</button><span class="se-ig-count" aria-live="polite"></span></div><p class="se-ig-helptext" hidden></p></div>`);
    box.classList.add('se-interrogation'); box.dataset.interrogation = key;
    // Keep the native last reply, including its dictionary words, in a compact
    // disclosure within the scrolling list rather than losing that VN feature.
    const lastQuote = box.querySelector(':scope > .se-q');
    box.querySelector(':scope > .se-ask')?.setAttribute('hidden', '');
    box.prepend(head);
    const list = box.querySelector('.se-chs'), empty = E.h('<p class="se-ig-empty" role="status" hidden></p>');
    if (lastQuote) {
      const last = E.h(`<details class="se-ig-last"><summary>${esc(nat(T('Last reply', 'Lời vừa nói')))}</summary></details>`);
      last.append(lastQuote); list.prepend(last);
    }
    empty.textContent = nat(labels.filtered); list.append(empty);
    const foot = E.h('<div class="se-ig-exit"></div>');
    for (const ref of C.always || []) { const b = buttonFor(ref); if (b) foot.append(b); }
    if (foot.children.length) box.append(foot);
    function applyApproach(reset = false) {
      const a = (C.approaches || []).find(x => x.id === saved.approach), wanted = a ? new Set(a.questions.map(ref => indexOf(st, ref))) : null;
      let count = 0;
      for (const b of buttons) {
        if (foot.contains(b)) continue;
        b.hidden = !!wanted && !wanted.has(+b.dataset.i);
        if (!b.hidden) count++;
      }
      for (const b of buttons) b.classList.toggle('se-ig-prepared', saved.prepared != null && +b.dataset.i === indexOf(st, saved.prepared));
      const prepared = saved.prepared != null && available(saved.prepared) ? buttonFor(saved.prepared) : null;
      if (prepared && !foot.contains(prepared)) list.prepend(prepared);
      empty.hidden = !!count;
      head.querySelectorAll('[data-ig-approach]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.igApproach === saved.approach)));
      head.querySelector('[data-ig-all]').setAttribute('aria-pressed', String(!a));
      head.querySelector('.se-ig-count').textContent = nat(T(`${count} remaining`, `Còn ${count} câu`));
      if (reset) list.scrollTop = 0;
    }
    function remember() { if (live()) E.save(); }
    function choose(ref) {
      if (!live() || !available(ref)) return;
      const b = buttonFor(ref);
      closeComparison();
      // The full wording must be visible before committing a question. A small
      // phone may have scrolled the comparison's preview out of sight.
      saved.approach = 'all'; saved.prepared = ref; applyApproach();
      b.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'instant' });
      b.focus({ preventScroll: true }); remember();
    }
    function closeComparison() {
      saved.view = 'questions';
      if (sheet && !sheet.hidden && sheet.dataset.igOwner === owner) E.ui.closeSheet();
      sheet = null;
    }
    function openComparison() {
      if (!live() || E.auto) return;
      const claims = (C.claims || []).filter(x => condition(x.if, E.state()));
      if (!claims.length) return;
      if (!claims.some(x => x.id === saved.claim)) saved.claim = claims[0].id;
      saved.view = 'records';
      sheet = E.ui.sheet(nat(labels.compare), '<div class="se-ig-scroll"></div><div class="se-ig-compare-foot"></div>', 'tall se-ig-sheet');
      sheet.dataset.igOwner = owner;
      sheet.onclose = () => { if (!suppressClose) { saved.view = 'questions'; remember(); } };
      const scroll = sheet.querySelector('.se-ig-scroll'), footer = sheet.querySelector('.se-ig-compare-foot');
      function draw(reset = false) {
        if (!live() || sheet.hidden || sheet.dataset.igOwner !== owner) return;
        const claim = claims.find(x => x.id === saved.claim), ids = R.items.filter(id => E.S().items[id] && (!C.recordIds || C.recordIds.includes(id)));
        if (!ids.includes(saved.record)) delete saved.record;
        const record = E.S().items[saved.record], outcome = record && claim.records?.[saved.record];
        const next = claim.question != null && st.choice[indexOf(st, claim.question)];
        scroll.innerHTML = `<label class="se-ig-claim-select"><span>${esc(nat(labels.claim))}</span><select aria-label="${esc(nat(labels.claim))}">${claims.map(x => `<option value="${esc(x.id)}"${x.id === claim.id ? ' selected' : ''}>${esc(nat(x.title))}</option>`).join('')}</select></label><blockquote class="se-ig-quote">${text(claim.quote)}${claim.source ? `<cite>${esc(nat(claim.source))}</cite>` : ''}</blockquote>${record ? `<article class="se-ig-selected"><div class="se-ig-record-title">${E.itemArt?.(saved.record, 'sm') || ''}<b>${text(record.name)}</b></div><div class="se-ig-explanation" role="status">${text(outcome?.note || claim.unrelated || labels.unknown)}</div><button type="button" class="se-btn" data-ig-read>${esc(nat(labels.detail))}</button></article>` : ''}${next && record ? `<div class="se-ig-follow"><small>${esc(nat(labels.next))}</small><p>${text(next)}</p></div>` : ''}<p class="se-ig-inline-hint" role="status" hidden></p><h3>${esc(nat(labels.held))}</h3><div class="se-ig-record-list">${ids.map(id => `<button type="button" data-ig-record="${esc(id)}" aria-pressed="${id === saved.record}">${E.itemArt?.(id, 'sm') || ''}<span>${text(E.S().items[id].name)}</span></button>`).join('')}</div>${!ids.length ? `<p class="se-ig-empty">${text(labels.empty)}</p>` : ''}`;
        scroll.querySelector('.se-ig-selected')?.prepend(E.h(`<small class="se-ig-checking">${esc(nat(claim.title))}</small>`));
        footer.innerHTML = `<button type="button" class="se-btn" data-ig-back>${E.ICON?.back || '‹'}<span>${esc(nat(labels.back))}</span></button><button type="button" class="se-ig-help" data-ig-hint aria-label="${esc(nat(labels.hint))}">?</button>${record && next ? `<button type="button" class="se-btn pri" data-ig-ask${available(claim.question) ? '' : ' disabled'}>${esc(nat(available(claim.question) ? labels.ask : labels.asked))}</button>` : ''}`;
        if (reset) scroll.scrollTop = 0;
        // A short landscape sheet cannot fit the claim and a whole result at
        // once. Put the newly selected record/explanation in the visible area.
        if (reset === 'record') {
          const selected = scroll.querySelector('.se-ig-selected');
          if (selected) scroll.scrollTop = Math.max(0, selected.getBoundingClientRect().top - scroll.getBoundingClientRect().top - 6);
        }
      }
      const change = e => {
        if (!live() || !e.target.matches('.se-ig-claim-select select')) return;
        saved.claim = e.target.value; delete saved.record; draw(true); remember();
      };
      sheet.addEventListener('change', change);
      const click = e => {
        if (!live()) return;
        const b = e.target.closest('button'); if (!b) return;
        if (b.hasAttribute('data-x')) return;
        const claim = claims.find(x => x.id === saved.claim);
        if (b.hasAttribute('data-ig-back')) { closeComparison(); remember(); }
        else if (b.dataset.igRecord) { saved.record = b.dataset.igRecord; draw('record'); remember(); }
        else if (b.hasAttribute('data-ig-read')) E.ui.itemView?.(saved.record);
        else if (b.hasAttribute('data-ig-ask')) choose(claim.question);
        else if (b.hasAttribute('data-ig-hint')) {
          const hint = scroll.querySelector('.se-ig-inline-hint');
          hint.innerHTML = text(claim.hint || C.hint || labels.help); hint.hidden = false;
          scroll.prepend(hint); scroll.scrollTop = 0;
        }
      };
      sheet.addEventListener('click', click);
      // A shared native sheet is reused; remove this session's handlers on close.
      const onclose = sheet.onclose, sh = sheet;
      sheet.onclose = () => { sh.removeEventListener('click', click); sh.removeEventListener('change', change); if (sh.dataset.igOwner === owner) delete sh.dataset.igOwner; if (sheet === sh) sheet = null; onclose?.(); };
      draw(saved.record ? 'record' : true); remember();
    }
    function capture(e) {
      if (!live() || e.target.closest('[data-hear]')) return;
      const b = e.target.closest('.se-ch-b[data-i]');
      if (!b || b.disabled || !box.contains(b)) return;
      const i = +b.dataset.i, ref = optionKey(st.choice[i], i);
      selecting = true;
      if (C.questions?.[ref]) saved.pending = ref;
      delete saved.prepared;
      saved.view = 'questions';
      // Do not prevent or re-dispatch: the native handler executes exactly once.
    }
    function controls(e) {
      if (!live()) return;
      const b = e.target.closest('button'); if (!b) return;
      if (b.dataset.igApproach) { saved.approach = b.dataset.igApproach; applyApproach(true); remember(); }
      else if (b.hasAttribute('data-ig-all')) { saved.approach = 'all'; applyApproach(true); remember(); }
      else if (b.hasAttribute('data-ig-records')) openComparison();
      else if (b.hasAttribute('data-ig-help')) {
        const p = head.querySelector('.se-ig-helptext'); p.textContent = [st.prompt, C.hint || labels.help].filter(Boolean).map(nat).join('\n\n'); p.hidden = !p.hidden;
      }
    }
    box.addEventListener('click', capture, true); head.addEventListener('click', controls);
    const clean = () => {
      if (disposed) return; disposed = true;
      box.removeEventListener('click', capture, true); head.removeEventListener('click', controls);
      if (sheet && !sheet.hidden && sheet.dataset.igOwner === owner) { suppressClose = true; E.ui.closeSheet(); }
    };
    (c.onExit || c.onCancel)?.(clean);
    applyApproach();
    if (saved.view === 'records') openComparison();
    return Promise.resolve(pending).finally(clean);
  });
})();
/* Original WebAudio foley. motion.sounds follows action progress. No external samples. */
(() => {'use strict';
const E=StoryEngine,cache=new Map(),active=new Set();
const recipes={
paper_open:[[0,.20,.22,'paper',1800],[.13,.29,.28,'paper',2400],[.38,.25,.15,'paper',1200]],
paper_fold:[[0,.27,.20,'paper',1600],[.20,.32,.18,'paper',2100]],paper_slide:[[0,.34,.16,'paper',1100]],paper_down:[[0,.16,.15,'paper',900],[.05,.08,.055,'wood',170]],
pen_write:[[0,.16,.09,'scratch',2500],[.18,.15,.08,'scratch',2000],[.37,.22,.08,'scratch',2300]],cloth_move:[[0,.42,.14,'cloth',450]],chain_latch:[[0,.12,.11,'metal',1550],[.13,.15,.09,'metal',2150]],
door_move:[[0,.39,.10,'cloth',250],[.32,.16,.09,'wood',130]],wood_down:[[0,.18,.12,'wood',150]],coin_purse:[[0,.20,.11,'cloth',400],[.06,.20,.07,'metal',2900]],frame_slide:[[0,.35,.12,'cloth',600],[.28,.13,.08,'wood',220]],
wax_press:[[0,.16,.08,'wood',210],[.12,.16,.07,'cloth',700]],cabinet_slide:[[0,.43,.12,'cloth',360],[.36,.16,.08,'wood',130]],gate_latch:[[0,.19,.09,'metal',850],[.17,.20,.12,'wood',110]],cup_down:[[0,.20,.07,'metal',1800]],
horse_steps:[[0,.12,.10,'wood',190],[.20,.11,.08,'wood',240],[.47,.11,.07,'wood',190],[.68,.11,.05,'wood',240]],dog_bark:[[0,.25,.12,'bark',145]],bell_soft:[[0,.9,.045,'metal',880]]};
function samples(a,key){
 const ck=a.sampleRate+':'+key;if(cache.has(ck))return cache.get(ck);
 const pulses=recipes[key],seconds=Math.max(...pulses.map(p=>p[0]+p[1]))+.025,b=a.createBuffer(1,Math.ceil(seconds*a.sampleRate),a.sampleRate),d=b.getChannelData(0);
 let seed=[...key].reduce((v,c)=>(v*31+c.charCodeAt(0))>>>0,29),low=0,previous=0;
 for(let i=0;i<d.length;i++){
  seed^=seed<<13;seed^=seed>>>17;seed^=seed<<5;
  const white=(seed>>>0)/2147483648-1,t=i/a.sampleRate;low=low*.93+white*.07;let value=0;
  for(const[start,dur,level,material,f]of pulses){
   const u=(t-start)/dur;if(u<0||u>1)continue;
   const env=Math.min(1,u/.06)*Math.pow(1-u,['wood','metal'].includes(material)?3:1.1);let texture;
   if(material==='paper')texture=(white-previous*.6)*(.35+.65*Math.abs(Math.sin((t-start)*f*.11)));
   else if(material==='scratch')texture=(white-low)*(.25+.75*Math.abs(Math.sin(t*92)));
   else if(material==='wood')texture=Math.sin(2*Math.PI*f*(t-start))*Math.exp(-u*8)+low*.4;
   else if(material==='metal')texture=(Math.sin(2*Math.PI*f*(t-start))+.4*Math.sin(2*Math.PI*f*2.71*(t-start)))*.5;
   else if(material==='bark'){const phase=2*Math.PI*(f*(t-start)-30*(t-start)**2);texture=(.44*Math.sin(phase)+.23*Math.sin(3*phase)+.12*Math.sin(5*phase)+white*.21)*Math.sin(Math.PI*u);}
   else texture=low*3;
   value+=texture*level*env;
  }
  previous=white;d[i]=Math.max(-.4,Math.min(.4,value));
 }
 cache.set(ck,b);return b;
}
function play(key){
 const a=E.sound.ctx();if(!a)return;
 const s=a.createBufferSource(),g=a.createGain();s.buffer=samples(a,key);g.gain.value=E.sound.level('sfx')*(E.voice?.busy ? .62 : 1);s.connect(g).connect(a.destination);let stopped=false;
 const h={cue:key,stop(seconds=.04){if(stopped)return;stopped=true;const t=a.currentTime;g.gain.cancelScheduledValues(t);g.gain.setTargetAtTime(.0001,t,Math.max(.003,seconds/3));try{s.stop(t+Math.max(.01,seconds));}catch{}}};
 active.add(h);s.onended=()=>{active.delete(h);try{s.disconnect();g.disconnect();}catch{}};s.start();E.emit('foley-play',{cue:key,duration:s.buffer.duration,gain:g.gain.value});return h;
}
for(const key of Object.keys(recipes))E.SFX[key]=()=>play(key);
E.sound.foleyCatalog=()=>Object.keys(recipes);
E.sound.stopFoley=()=>{for(const h of active)h.stop();};
E.sound.foleyState=()=>({active:[...active].map(h=>h.cue),cached:cache.size});
E.sound.foleySamples=key=>{const a=E.sound.ctx();return a&&recipes[key]?samples(a,key):null;};
E.side('foley',(v,st,c)=>{const cue=typeof v==='string'?v:v?.cue;if(!cue)return;const k=c.key('foley',cue),used=E.R().used||={};if(used[k]&&v?.repeat!==true)return;used[k]=true;const h=E.sfx(cue);c.onExit?.(()=>h?.stop?.(.04));});
E.on('boot',()=>E.sound.stopFoley());
document.addEventListener('visibilitychange',()=>{if(document.hidden)E.sound.stopFoley();});
})();
/* Story-scoped interface. The Enmi interpreter and save state remain authoritative. */
(() => {
  const E=StoryEngine, q=s=>document.querySelector(s), esc=E.esc;
  const clone=x=>JSON.parse(JSON.stringify(x));
  const V=globalThis.ValeDemo={q,esc,clone,version:'0.9.6',active:null,line:null,storage:true};
  V.caseMeta=()=>E.S().caseMeta||{part:'I',chapters:6,endings:4,source:'A Scandal in Bohemia',sourceUrl:'https://www.gutenberg.org/ebooks/1661'};
  V.bi=t=>`<span class="vd-en" lang="en">${esc(E.tgt(t))}</span>${E.sub(t)?`<span class="vd-vi" lang="vi">${esc(E.sub(t))}</span>`:''}`;
  V.labels={fact:['Observed fact','Dữ kiện quan sát'],testimony:['Testimony','Lời khai'],inference:['Inference','Suy luận']};
  V.kind=it=>it.kind==='observation'?'fact':it.kind||'fact';
  V.tag=it=>{const k=V.kind(it),l=V.labels[k]||V.labels.fact;return `<span class="vd-kind ${esc(k)}">${l[0]} · ${l[1]}</span>`;};
  V.key=()=> 'se.'+E.S().id;
  // Resolve the case's lazy chapter data before validating a saved nested path.
  V.prepareSave=async()=>{const n=Math.max(1,...(E.S().chapters||[]).map(c=>c.ch));if(!(await E.loadUpTo(n)))throw Error('Could not load chapter data · Chưa nạp được dữ liệu chương');};
  V.snapshot=()=>{
    if(q('.se')?.dataset.m==='ov'){try{const old=JSON.parse(localStorage.getItem(V.key()+'.r'));if(old?.stack)return old;}catch{}}
    return E.snapshot ? E.snapshot() : clone(E.R());
  };
  V.persist=()=>{const r=V.snapshot();E.save();if(E.explore)return r;try{localStorage.setItem(V.key()+'.r',JSON.stringify(r));localStorage.setItem(V.key()+'.g',JSON.stringify(E.G()));V.storage=true;}catch{V.storage=false;}return r;};
  V.start=()=>{V.active=null;V.line=null;E.ui.closeSheet();E.stop();E.ui.clear();E.ui.hide('*');q('.se-top').hidden=false;E.newRun();};
  V.home=()=>{V.persist();E.ui.closeSheet();E.stop();E.ui.title();};
  V.restart=()=>{const sh=E.ui.sheet('Start again · Chơi lại','<p>This replaces the current route. Unlocked chapter outcomes and vocabulary remain.</p><p class="vd-vi">Tuyến đang chơi sẽ bắt đầu lại. Kết chương đã mở và từ đã lưu vẫn được giữ.</p><button class="se-btn pri wide" data-restart>Start chapter 1 again · Chơi lại chương 1</button>');sh.querySelector('[data-restart]').onclick=V.start;};
  V.exportSave=()=>{const d={format:'vale-dossiers-save',version:1,story:E.S().id,exportedAt:new Date().toISOString(),global:clone(E.G()),run:V.persist()};const url=URL.createObjectURL(new Blob([JSON.stringify(d,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download='Vale_Dossiers_Save.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),30000);E.ui.toast('Save exported · Đã xuất bản lưu');};
  V.importSave=()=>{const input=document.createElement('input');input.type='file';input.accept='.json,application/json';input.onchange=async()=>{const file=input.files[0];if(!file)return;try{
    if(file.size>2000000)throw Error('Save file too large · Tệp quá lớn');const d=JSON.parse(await file.text());
    if(d.format!=='vale-dossiers-save'||d.version!==1||d.story!==E.S().id||!d.global?.set||!d.run?.f||!Array.isArray(d.run.stack)||!Array.isArray(d.run.items)||!Array.isArray(d.run.log))throw Error('Incompatible save · Bản lưu không tương thích');
    await V.prepareSave?.(d);
    if(!d.run.stack.every(f=>typeof f.n==='string'&&Array.isArray(f.p)&&Number.isInteger(f.i)&&f.i>=0&&Array.isArray(E.walk(f))&&f.i<=E.walk(f).length)||!d.run.items.every(id=>E.S().items[id]))throw Error('Unavailable scene or evidence · Cảnh hoặc chứng cứ không hợp lệ');
    const sh=E.ui.sheet('Load this save? · Nạp bản lưu?','<p>This replaces the current route in this browser.</p><p class="vd-vi">Bạn có thể xuất tiến độ hiện tại trước khi nạp.</p><div class="se-row"><button class="se-btn" data-export>Export current · Xuất hiện tại</button><button class="se-btn pri" data-load>Load save · Nạp</button></div>');sh.querySelector('[data-export]').onclick=V.exportSave;sh.querySelector('[data-load]').onclick=()=>{try{localStorage.setItem(V.key()+'.g',JSON.stringify(d.global));localStorage.setItem(V.key()+'.r',JSON.stringify(d.run));V.reloading=true;window.removeEventListener('beforeunload',V.unload);location.reload();}catch{E.ui.toast('Browser storage unavailable · Không thể lưu trên trình duyệt này');}};
  }catch(e){E.ui.toast(esc(e.message),5000);}};input.click();};
  V.update=()=>{const l=V.line,root=q('.se'),label=q('.vd-reader-label');if(!label)return;label.textContent=l?.kind==='think'?'YOUR THOUGHTS · SUY NGHĨ':l?.kind==='say'?'':'NARRATION · LỜI DẪN';label.hidden=l?.kind==='say';q('.se-txt').lang=l?.lang||E.L;q('.se-sub').lang=(l?.lang||E.L)===E.N?E.L:E.N;root.dataset.vdMask=E.R().f.matthias_masked===false?'off':'on';};
  V.unload=()=>{if(!V.reloading&&E.R()?.stack?.length)V.persist();};
  const initPreferences=()=>{const g=E.G().set;if(!g.vdNativeControls){
    Object.assign(g,{mode:'imm',speed:1,vDlg:true,vNarr:!!E.S().defaultNarration,shadow:true,sfx:true,amb:true,vdInitialized:true,vdNativeControls:true});
  }return g;};
  E.on('boot',()=>{E.S().recordReceipts=true;E.S().recordPresentation='compact';E.S().placeSwipe='direction';E.S().inspectionZoom=false;E.S().stableActionFraming=true;E.S().transientHints=true;E.S().collapsibleObjectives=true;V.wasLegacy=!!E.G().set.vdInitialized&&!E.G().set.vdNativeControls;const g=initPreferences();const root=q('.se');root.classList.add('vd');root.classList.toggle('vd-large',!!g.vdLarge);
    root.addEventListener('keydown',e=>{const word=e.target.closest?.('.w[data-w]');if(!word||e.repeat||e.altKey||e.ctrlKey||e.metaKey||!['Enter',' '].includes(e.key))return;e.preventDefault();e.stopPropagation();word.click();});
    const box=q('.se-box'),scroll=document.createElement('div');scroll.className='vd-dialogue-scroll';scroll.tabIndex=0;scroll.setAttribute('aria-label','Story text · Nội dung truyện');scroll.innerHTML='<p class="vd-reader-label"></p>';box.insertBefore(scroll,q('.se-txt'));scroll.append(q('.se-txt'),q('.se-sub'));
    // Keep native tap-to-read; suppress clicks produced by scrolling a long line.
    let press=null,moved=false;
    box.addEventListener('pointerdown',e=>{press=[e.clientX,e.clientY,scroll.scrollTop];moved=false;},{passive:true});
    box.addEventListener('pointermove',e=>{if(press&&(Math.abs(e.clientX-press[0])+Math.abs(e.clientY-press[1])>12||Math.abs(scroll.scrollTop-press[2])>3))moved=true;},{passive:true});
    box.addEventListener('pointercancel',()=>{press=null;moved=true;});
    box.addEventListener('click',e=>{if(moved){e.stopPropagation();moved=false;}press=null;},true);
    // A labelled native button keeps the interpreter's reveal-then-advance
    // behavior. Its click bubbles to core; no second advance handler is added.
    // Native Enter/Space is already excluded from the document shortcut.
    const oldMore=box.querySelector('.se-more'),more=document.createElement('button');
    more.type='button';more.className='se-more';more.innerHTML='<span></span>';
    oldMore?.replaceWith(more);
    const hint=document.createElement('div');hint.className='vd-scroll-hint';hint.hidden=true;
    hint.textContent=E.nat({en:'Scroll to read more ↓',vi:'Cuộn để đọc tiếp ↓'});
    hint.setAttribute('role','note');box.querySelector('.se-tools').before(hint);
    hint.addEventListener('click',e=>e.stopPropagation());
    let readerFrame=0;
    const syncReader=()=>{
      readerFrame=0;
      const done=box.classList.contains('done');
      const label=E.nat(done?{en:'Next',vi:'Tiếp'}:{en:'Show all',vi:'Hiện hết'});
      const fullLabel=E.nat(done?{en:'Next line',vi:'Câu tiếp'}:{en:'Show full line',vi:'Hiện hết câu'});
      if(more.firstChild.textContent!==label)more.firstChild.textContent=label;
      more.setAttribute('aria-label',fullLabel);more.title=fullLabel;
      // Measure without the hint's own height, so its appearance cannot create
