      hint.hidden=true;
      const remaining=scroll.scrollHeight-scroll.clientHeight-scroll.scrollTop;
      hint.hidden=box.hidden||!done||remaining<=2;
    };
    const scheduleReader=()=>{if(!readerFrame)readerFrame=requestAnimationFrame(syncReader);};
    const readerMutations=new MutationObserver(scheduleReader);
    readerMutations.observe(box,{attributes:true,attributeFilter:['class','hidden']});
    readerMutations.observe(scroll,{childList:true,subtree:true,characterData:true,attributes:true,attributeFilter:['hidden']});
    const readerSize=new ResizeObserver(scheduleReader);
    [scroll,q('.se-txt'),q('.se-sub')].forEach(el=>readerSize.observe(el));
    scroll.addEventListener('scroll',scheduleReader,{passive:true});
    addEventListener('resize',scheduleReader);scheduleReader();

    // The native Hint owns which zones are eligible. Fit only its temporary
    // captions; image coordinates and touch targets remain unchanged.
    const fitHintLabels=()=>{
      if(!matchMedia('(hover:none)').matches)return;
      const labels=[...root.querySelectorAll('.vbx:is(.hint1,.hint2) .pz:not(.seen):not([aria-hidden="true"]) .pz-l')].filter(el=>el.getClientRects().length);
      if(!labels.length)return;
      const rr=root.getBoundingClientRect(),top=q('.se-top').getBoundingClientRect().bottom+8;
      const hud=q('.se-panel.pl')?.getBoundingClientRect(),bottom=hud?hud.top-8:rr.bottom-8;
      const obstacles=[...root.querySelectorAll('.se-plnav button')].filter(el=>el.getClientRects().length).map(el=>el.getBoundingClientRect());
      for(const label of labels){
        label.style.removeProperty('--vd-hint-x');label.style.removeProperty('--vd-hint-y');
        const r=label.getBoundingClientRect(),scale=r.width/(label.offsetWidth||r.width)||1;
        const x=Math.max(rr.left+8,Math.min(r.left,rr.right-8-r.width));
        const clamp=y=>Math.max(top,Math.min(y,bottom-r.height));
        const candidates=[r.top,label.parentElement.getBoundingClientRect().bottom+8,...obstacles.flatMap(o=>[o.top-r.height-8,o.bottom+8])].map(clamp).sort((a,b)=>Math.abs(a-r.top)-Math.abs(b-r.top));
        const free=y=>!obstacles.some(o=>x<o.right+6&&x+r.width>o.left-6&&y<o.bottom+6&&y+r.height>o.top-6);
        const y=candidates.find(free)??clamp(r.top);
        label.style.setProperty('--vd-hint-x',((x-r.left)/scale)+'px');
        label.style.setProperty('--vd-hint-y',((y-r.top)/scale)+'px');
        obstacles.push({left:x,right:x+r.width,top:y,bottom:y+r.height});
      }
    };
    root.addEventListener('click',e=>{if(e.target.closest('[data-hint]'))requestAnimationFrame(fitHintLabels);});
    let hintResize=0;addEventListener('resize',()=>{clearTimeout(hintResize);hintResize=setTimeout(fitHintLabels,80);});

    const names={menu:'Menu · Cài đặt',trall:'EN / VI · Bật tắt bản dịch',log:'History · Lịch sử thoại',book:'Casebook · Sổ vụ án',flow:'Routes · Sơ đồ nhánh'};q('.se-top').querySelectorAll('[data-a]').forEach(b=>{if(names[b.dataset.a]){b.setAttribute('aria-label',names[b.dataset.a]);b.title=names[b.dataset.a];}});
    V.nativeFlow=E.ui.flowSheet;V.nativeMenu=E.ui.menu;V.nativeBook=E.ui.book;const title=E.ui.title;E.ui.title=()=>{title();V.decorateTitle();};E.ui.menu=()=>V.settings();E.ui.book=(...args)=>V.book(...args);E.ui.flowSheet=(...args)=>V.routebook(...args);window.addEventListener('beforeunload',V.unload);
    document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='hidden')V.unload();});
    try{localStorage.setItem(V.key()+'.probe','1');localStorage.removeItem(V.key()+'.probe');}catch{V.storage=false;}
  });
  E.on('step',(type)=>{initPreferences();const f=E.R().stack.at(-1);V.active=f?{type,n:f.n,p:JSON.stringify(f.p),i:f.i-1}:null;V.line=null;queueMicrotask(V.update);});
  E.on('line',line=>{V.line=line;queueMicrotask(()=>{V.update();const scroll=q('.vd-dialogue-scroll');if(scroll)scroll.scrollTop=0;q('.se-txt')?.querySelectorAll('.w[data-w]').forEach(word=>{word.tabIndex=0;word.setAttribute('role','button');word.setAttribute('aria-label','Look up '+word.dataset.w+' · Tra nghĩa');});});});E.on('end',()=>{V.active=null;});
})();
(() => {
 const E=StoryEngine,V=ValeDemo,{esc,bi}=V;
 V.guide=()=>{
  const t=v=>esc(E.nat(v)),more=(title,text)=>`<details class="vd-help-detail"><summary>${t(title)}</summary><p>${t(text)}</p></details>`;
  return E.ui.sheet(E.nat({en:'How to play',vi:'Cách chơi'}),`<div class="vd-guide"><p><b>${t({en:'You are detective Adrian Vale.',vi:'Bạn là thám tử Adrian Vale.'})}</b></p><ol class="vd-help-steps"><li><b>${t({en:'Read.',vi:'Đọc.'})}</b> ${t({en:'Tap once to reveal the line, again to continue. Scroll long passages.',vi:'Chạm để hiện hết câu; chạm tiếp để đọc tiếp. Cuộn nếu đoạn dài.'})}</li><li><b>${t({en:'Inspect and ask.',vi:'Khám và hỏi.'})}</b> ${t({en:'Tap a detail or person. Select an item, then tap its target; you can also drag the item there.',vi:'Chạm chi tiết hoặc nhân vật. Chọn vật phẩm rồi chạm nơi muốn dùng; cũng có thể kéo vật phẩm đến đó.'})}</li><li><b>${t({en:'Compare and choose.',vi:'Đối chiếu và chọn.'})}</b> ${t({en:'Read the question, compare your records, then check your answer.',vi:'Đọc câu hỏi, đối chiếu hồ sơ rồi kiểm tra câu trả lời.'})}</li></ol><p class="se-mute">${t({en:'Tap the target icon to recall your objective, the information icon for the scene, or the menu for your records and settings.',vi:'Bấm biểu tượng mục tiêu để xem việc cần làm, biểu tượng thông tin để xem bối cảnh, hoặc menu để mở hồ sơ và cài đặt.'})}</p>${more({en:'Exploration and conversations',vi:'Khám cảnh và hỏi chuyện'},{en:'Glints mark details you can investigate. Ordinary inspection returns directly to the current view; a real close-up has its own Back control. Swipe or use edge arrows to change views. Select an item and tap a target, or drag it onto the target. Ask for a hint when needed.',vi:'Điểm sáng đánh dấu chi tiết có thể khám. Xem xong trở lại ngay góc hiện tại; cảnh cận riêng mới có nút Lùi. Vuốt hoặc dùng mũi tên ở mép để đổi góc. Chọn vật phẩm rồi chạm mục tiêu, hoặc kéo vật phẩm vào đó. Cần hỗ trợ thì bấm Gợi ý.'})}${more({en:'Connecting the evidence',vi:'Nối chứng cứ'},{en:'On the case board, Move arranges cards. Connect lets you tap two cards or drag between their pins. Read each record before connecting; a shared name alone is not proof. Use Hint to narrow the list, open the records drawer for other clues, or undo a wire.',vi:'Trên bảng suy luận, Kéo để sắp xếp thẻ; Nối để chạm hai thẻ hoặc kéo giữa hai ghim. Đọc hồ sơ trước khi nối: trùng tên chưa đủ là chứng cứ. Dùng Gợi ý để thu hẹp danh sách, mở ngăn hồ sơ để tìm thêm hoặc gỡ dây nối.'})}${more({en:'Reading, sound and scene actions',vi:'Đọc, âm thanh và hành động'},{en:'Settings lets you change text size and speed, translation, and dialogue or narration voices. Tap a word to look it up. Scene actions can be skipped or replayed without repeating choices or rewards. Reduced motion shows their final pose. Speaking practice is only for dialogue choices. After you speak, the story continues; Skip uses the character voice.',vi:'Cài đặt có cỡ chữ, tốc độ chữ, bản dịch, giọng hội thoại và lời dẫn. Chạm từ để tra nghĩa. Có thể bỏ qua hoặc xem lại hành động, không lặp lựa chọn hay nhận thưởng; giảm chuyển động hiện tư thế cuối. Luyện nói chỉ áp dụng cho lựa chọn hội thoại. Nói xong thì truyện tiếp tục; bấm Bỏ qua để nghe giọng nhân vật.'})}${more({en:'Progress and other routes',vi:'Tiến độ và các nhánh khác'},{en:`Progress saves in this browser. Menu → Exit to overview keeps your place; Continue resumes it. Export a save to move devices. History and the casebook keep dialogue, records and vocabulary. This case has ${V.caseMeta().chapters} chapters and ${V.caseMeta().endings} endings; other branches are alternatives. Replay an unlocked checkpoint to try another route.`,vi:`Tiến độ tự lưu trên trình duyệt này. Menu → Thoát về tổng quan giữ nguyên đoạn đang chơi; bấm Tiếp tục để quay lại. Xuất bản lưu để chuyển máy. Lịch sử và sổ vụ án giữ thoại, hồ sơ, từ vựng. Phần này có ${V.caseMeta().chapters} chương và ${V.caseMeta().endings} kết; nhánh khác là lựa chọn thay thế. Chơi lại mốc đã mở để thử tuyến khác.`})}</div>`,'tall');
 };
 V.credits=()=>{const m=V.caseMeta();return E.ui.sheet('About this adaptation · Nguồn chuyển thể',`<p>Arthur Conan Doyle, <i>${esc(m.source)}</i>.</p><p>This adaptation uses newly written English dialogue, a close Vietnamese translation, new character names and additional branches.</p><p class="vd-vi">Game viết mới lời Anh, dịch sát sang tiếng Việt, đổi tên nhân vật và thêm nhánh; các vụ án độc lập. Khi nhắc chuyện cũ, truyện theo True Ending.</p><p><a href="${esc(m.sourceUrl)}" target="_blank" rel="noopener">Original source · Nguyên tác</a></p><hr><p>Enmi Story Engine 3.0.0 · Vale build ${esc(V.version)}. Artwork generated for this project.</p><p>${E.recHas()?'Includes synthesized English narration and character voices, generated with Kokoro-82M.':'Uses available device or Enmi voices.'}</p><p class="vd-vi">${E.recHas()?'Có giọng tổng hợp tiếng Anh cho lời dẫn và nhân vật; không phải diễn viên thu âm.':'Dùng giọng khả dụng của thiết bị hoặc Enmi.'} Có thể tắt lời dẫn, thoại hoặc ưu tiên giọng đọc sẵn trong Cài đặt.</p><p>Part ${m.part}: ${m.chapters} chapters, ${m.endings} case endings.</p>`,'tall');};
 V.dev=()=>E.ui.sheet('Development notebook · Tiến trình',`<p>Vale ${esc(V.version)} keeps the authored scene actions and improves mobile reading, settings, deduction progress and record receipts.</p><p class="vd-vi">Bản ${esc(V.version)} giữ các nhịp diễn đã bổ sung, làm rõ thao tác đọc trên điện thoại, thu gọn cài đặt, lưu lựa chọn suy luận và giảm xác nhận hồ sơ lặp.</p><p>Full validation scope and known limits are included in the release notes.</p>`,'tall');
 V.settings=()=>{const g=E.G().set;V.nativeMenu();const sh=V.q('.se-sheet'),body=sh.querySelector('.se-shb');
  sh.classList.add('vd-settings');
  const quick=document.createElement('div');quick.className='vd-settings-quick';quick.innerHTML=`<button class="se-btn pri wide" data-resume>${esc(E.nat(V.q('.se')?.dataset.m==='ov'?{en:'Close settings',vi:'Đóng cài đặt'}:{en:'Back to the story',vi:'Trở lại truyện'}))}</button><div class="vd-settings-links"></div><div class="se-row"><button class="se-btn" data-export>${esc(E.nat({en:'Export save',vi:'Xuất bản lưu'}))}</button><button class="se-btn" data-import>${esc(E.nat({en:'Import save',vi:'Nạp bản lưu'}))}</button></div>`;
  const links=quick.querySelector('.vd-settings-links');for(const sel of ['[data-home]','[data-rc]','[data-exit]']){const el=sh.querySelector(sel);if(el)links.append(el);}
  body.prepend(quick);quick.querySelector('[data-resume]').onclick=()=>E.ui.closeSheet();quick.querySelector('[data-export]').onclick=V.exportSave;quick.querySelector('[data-import]').onclick=V.importSave;
  const soundGroup=sh.querySelector('[data-ov="amb"]')?.closest('.se-og');
  if(soundGroup){
   const mix=document.createElement('div');mix.className='vd-audio-mix';
   mix.innerHTML=[['ambLevel','Background · Âm nền',.65],['sfxLevel','Actions · Tiếng động',.70]].map(([key,label,fallback])=>{const val=Math.round((Number.isFinite(g[key])?g[key]:fallback)*100);return `<label class="se-fl">${label} <output data-level-label="${key}">${val}%</output><input type="range" min="0" max="100" step="5" value="${val}" data-audio-level="${key}" aria-label="${label}" style="width:100%;min-height:44px;accent-color:#d6b878"></label>`;}).join('')+'<p class="se-mute">Background sound softens during speech. Indoor rain is quieter.<span class="vd-vi">Âm nền tự hạ khi có giọng đọc; mưa trong phòng nghe nhẹ hơn.</span></p>';
   soundGroup.append(mix);
   for(const input of mix.querySelectorAll('[data-audio-level]'))input.oninput=()=>{const key=input.dataset.audioLevel;g[key]=Number(input.value)/100;mix.querySelector(`[data-level-label="${key}"]`).textContent=input.value+'%';E.sound.refresh?.();if(key==='sfxLevel'&&!g[key])E.sound.stopFoley?.();V.persist();};
   // Register on the same body after the native options listener. A button
   // listener (even its microtask) can run before the delegated toggle.
   body.addEventListener('click',e=>{if(e.target.closest('[data-ov="sfx"]')&&!g.sfx)E.sound.stopFoley?.();});
  }
  const voiceGroup=sh.querySelector('[data-ov="vRec"]')?.closest('.se-og');
  if(voiceGroup){
   const sample=who=>{let found=null;const seen=new Set(),visit=v=>{if(found||!v||typeof v!=='object'||seen.has(v))return;seen.add(v);if(v.say===who&&!v.silent&&typeof(v.speak||v.en)==='string'){found=v.speak||v.en;return;}for(const x of Object.values(v))visit(x);};for(const node of Object.values(E.S().nodes||{}))visit(node);return found;};
   const samples={me:sample('me'),reed:sample('reed')},v=document.createElement('div');v.className='vd-voice-preview';
   v.innerHTML='<p class="se-mute" data-voice-note></p><div class="se-row"><button class="se-btn" data-voice-sample="me" aria-label="Preview Adrian Vale’s voice · Nghe thử giọng Vale">'+E.ICON.spk+' Vale</button><button class="se-btn" data-voice-sample="reed" aria-label="Preview Eleanor Reed’s voice · Nghe thử giọng Reed">'+E.ICON.spk+' Reed</button><button class="se-ib" data-voice-stop aria-label="Stop voice preview · Dừng nghe thử">'+E.ICON.x+'</button></div><p class="se-mute" role="status" aria-live="polite" data-voice-status></p>';
   voiceGroup.append(v);let preview=0,playing=false,activeSpeaker='';
   const status=v.querySelector('[data-voice-status]');
   const unlisten=E.on('voice-source',source=>{if(playing&&sh.isConnected&&source.speaker===activeSpeaker)status.textContent=E.nat(source.source==='recorded'?{en:'Playing this character’s supplied recording.',vi:'Đang nghe bản dựng sẵn của nhân vật.'}:{en:'Playing the available device or app voice.',vi:'Đang nghe giọng khả dụng của thiết bị hoặc ứng dụng.'});});
   const note=()=>{v.querySelector('[data-voice-note]').textContent=E.nat(g.vRec!==false?{en:'Preview the English character recordings. Vietnamese narration uses an available device or app voice.',vi:'Nghe thử giọng tiếng Anh riêng của nhân vật. Lời dẫn tiếng Việt dùng giọng có sẵn trên máy hoặc ứng dụng.'}:{en:'Device or app voices are selected. How distinct they sound depends on the available voices.',vi:'Đang dùng giọng trên máy hoặc ứng dụng. Mức phân biệt nhân vật phụ thuộc bộ giọng có sẵn.'});};note();
   // Run after the native delegated toggle on this same body. A button's
   // listener (including its microtask) can run before the bubbling handler.
   body.addEventListener('click',event=>{if(!event.target.closest('[data-ov="vRec"]'))return;if(playing){preview++;playing=false;E.hush();status.textContent=E.nat({en:'Preview stopped.',vi:'Đã dừng nghe thử.'});}note();});
   for(const b of v.querySelectorAll('[data-voice-sample]')){const who=b.dataset.voiceSample;b.disabled=!samples[who];b.onclick=async()=>{const token=++preview;activeSpeaker=who;playing=true;await E.say(samples[who],who,{force:true,lang:'en'});if(token===preview){playing=false;status.textContent=E.nat({en:'Preview finished.',vi:'Đã nghe xong.'});}};}
   v.querySelector('[data-voice-stop]').onclick=()=>{preview++;playing=false;E.hush();v.querySelector('[data-voice-status]').textContent=E.nat({en:'Preview stopped.',vi:'Đã dừng nghe thử.'});};
   const close=sh.onclose;sh.onclose=()=>{preview++;if(playing)E.hush();playing=false;unlisten();close?.();};
  }
  const extra=document.createElement('div');extra.className='vd-settings-extra';extra.innerHTML=`<div class="se-og"><h4>Comfort & practice · Đọc và luyện tập</h4><button class="se-ovo" role="switch" aria-checked="${!!g.vdLarge}" data-large><span><b>Larger text · Chữ lớn</b><small>Dialogue and translation · Hội thoại và bản dịch</small></span><i class="se-sw ${g.vdLarge?'on':''}"></i></button><button class="se-ovo" role="switch" aria-checked="${!!g.vdExploreAssist}" data-assist><span><b>Exploration list · Danh sách điểm chạm</b><small>Optional list of visible details and exits · Liệt kê chi tiết và lối đi đang nhìn thấy</small></span><i class="se-sw ${g.vdExploreAssist?'on':''}"></i></button><label class="se-fl">Voice speed · Tốc độ giọng đọc<select class="se-in" data-rate>${[.75,.9,1,1.15].map(x=>`<option value="${x}" ${Math.abs((g.vRate||1)-x)<.01?'selected':''}>${x}×</option>`).join('')}</select></label><button class="se-btn wide" data-practice>Listen & speak · Nghe và nói theo</button></div><div class="se-og"><h4>Help · Hướng dẫn</h4><p class="se-mute">${V.storage?'Tiến độ tự lưu trên trình duyệt này. Xuất bản lưu nếu muốn chuyển máy.':'Trình duyệt chưa cho phép tự lưu. Hãy xuất bản lưu để giữ tiến độ.'}</p><button class="se-btn wide" data-help>How to play · Cách chơi</button></div>`;
  body.insertBefore(extra,body.lastElementChild);
  extra.querySelector('[data-large]').onclick=e=>{g.vdLarge=!g.vdLarge;V.q('.se').classList.toggle('vd-large',g.vdLarge);const b=e.currentTarget;b.setAttribute('aria-checked',String(g.vdLarge));b.querySelector('.se-sw').classList.toggle('on',g.vdLarge);V.persist();};
  extra.querySelector('[data-assist]').onclick=e=>{g.vdExploreAssist=!g.vdExploreAssist;const b=e.currentTarget;b.setAttribute('aria-checked',String(g.vdExploreAssist));b.querySelector('.se-sw').classList.toggle('on',g.vdExploreAssist);V.persist();E.emit('exploreAssist',g.vdExploreAssist);};
  const motion=document.createElement('label');motion.className='se-fl';motion.innerHTML=`Scene motion · Hoạt ảnh cảnh<select class="se-in" data-motion><option value="auto">Follow device · Theo thiết bị</option><option value="full">Full motion · Đầy đủ</option><option value="reduced">Reduced motion · Giảm chuyển động</option></select><small class="se-mute">Short actions can be skipped or replayed. Reduced motion shows the final pose.<span class="vd-vi">Có thể bỏ qua hoặc xem lại hành động. Chế độ giảm chuyển động hiện ngay tư thế cuối.</span></small>`;extra.querySelector('[data-rate]').closest('label').before(motion);motion.querySelector('select').value=['full','reduced'].includes(g.motion)?g.motion:'auto';motion.querySelector('select').onchange=e=>{g.motion=e.target.value;E.ui.finishMotion?.();V.persist();};
  extra.querySelector('[data-rate]').onchange=e=>{g.vRate=+e.target.value;V.persist();};
  extra.querySelector('[data-help]').onclick=V.guide;extra.querySelector('[data-practice]').onclick=()=>V.practice?.();
  sh.querySelector('[data-home]').onclick=V.home;sh.querySelector('[data-new]').onclick=V.restart;
  // Keep the native controls and their listeners; fold secondary settings
  // into named sections instead of rebuilding a second settings system.
  const fold=(key,title,nodes)=>{const d=document.createElement('details');d.className='vd-settings-fold';d.dataset.settingsSection=key;d.innerHTML=`<summary>${esc(E.nat(title))}</summary><div class="vd-settings-fold-body"></div>`;const inner=d.lastElementChild;for(const node of nodes)if(node)inner.append(node);body.append(d);return inner;};
  const language=body.querySelector('button[data-m]')?.closest('.se-og'),text=body.querySelector('[data-sp]')?.closest('.se-og');
  const comfort=extra.firstElementChild,help=extra.lastElementChild,rate=comfort.querySelector('[data-rate]')?.closest('label'),practice=comfort.querySelector('[data-practice]'),speaking=body.querySelector('[data-ov="shadow"]')?.closest('.se-og');
  const restart=body.querySelector('[data-new]')?.parentElement,saveButtons=quick.querySelector('.se-row'),saveNote=help.querySelector('p');
  const support=document.createElement('div');support.className='vd-settings-support';const helpButton=help.querySelector('[data-help]');helpButton.textContent=E.nat({en:'How to play',vi:'Cách chơi'});practice.textContent=E.nat({en:'Listen and speak',vi:'Nghe và nói'});support.append(helpButton,practice);
  if(voiceGroup&&rate)voiceGroup.append(rate);comfort.querySelector('h4')?.remove();
  fold('reading',{en:'Reading and translation',vi:'Đọc và bản dịch'},[language,text]);
  fold('sound',{en:'Voices and sound',vi:'Giọng đọc và âm thanh'},[voiceGroup,soundGroup]);
  const display=fold('display',{en:'Display and guidance',vi:'Hiển thị và hỗ trợ'},[comfort]);display.dataset.v92Comfort='';
  if(speaking)fold('speaking',{en:'Speaking practice',vi:'Luyện nói'},[speaking]);
  const saves=fold('save',{en:'Saves and replay',vi:'Bản lưu và chơi lại'},[saveNote,saveButtons,restart]);if(!V.storage)saves.parentElement.open=true;
  extra.remove();body.append(support);
 };
 V.book=(tab='items')=>{V.nativeBook(tab);const sh=V.q('.se-sheet');sh.classList.add('vd-casebook');const labels={items:['Records','Hồ sơ'],truths:['Conclusions','Suy luận'],people:['People','Nhân vật'],words:['Words','Từ đã lưu']};sh.querySelectorAll('.se-tabs [data-tab]').forEach(b=>{const l=labels[b.dataset.tab];b.innerHTML=`<span>${l[0]}</span><small>${l[1]}</small>`;});
  const controls=document.createElement('div');controls.className='vd-book-extras';controls.innerHTML='<button class="se-btn wide" data-practice>Listen & speak · Nghe và nói theo</button>';sh.querySelector('.se-shb').append(controls);controls.querySelector('[data-practice]').onclick=()=>V.practice?.();
 };
 V.casebook=(tab='evidence',filter='all')=>{V.recordBrowser||={filter:'all',query:''};V.recordBrowser.filter=filter==='fact'?'objects':filter==='testimony'?'testimony':'all';V.book(tab==='evidence'?'items':tab);};
 V.routebook=(ch)=>{
  if(V.q('.se')?.dataset.m==='ov')Object.assign(E.R(),V.clone(V.snapshot()));
  V.nativeFlow(ch);
  const sheet=V.q('.se-sheet');
  return sheet;
 };

})();
/* Edition metadata belongs to the game, not to the shared interpreter. */
(() => {
 const E=StoryEngine,story=E.story;
 const cases={
  'vale-dossiers-p1c1-v01':{part:'I',chapters:6,endings:4,source:'A Scandal in Bohemia',sourceUrl:'https://www.gutenberg.org/ebooks/1661'},
  'vale-dossiers-part2-v01':{part:'II',chapters:6,endings:4,source:'The Adventure of the Speckled Band',sourceUrl:'https://www.gutenberg.org/ebooks/1661'},
  'vale-dossiers-part3-v01':{part:'III',chapters:5,endings:4,source:'Silver Blaze',sourceUrl:'https://www.gutenberg.org/ebooks/834'}
 };
 E.story=b=>story({...b,defaultNarration:true,caseMeta:cases[b.id]||b.caseMeta});
})();
/* A document's legible text is authored, never inferred from generated pixels. */
(() => {
 const E=StoryEngine;
 const T=(en,vi)=>({en,vi});
 const enrich=()=>{
  const S=E.S();if(!S)return;
  for(const it of Object.values(S.items||{}))if(it.document&&!it.doc){
   const d=it.document,t=d.text||d;
   it.doc={paper:'letter',hand:'print',title:d.title||it.name,lines:Array.isArray(t)?t:[t]};
  }
  if(S.items?.sealed_note)S.items.sealed_note.doc={paper:'letter',hand:'script',title:T('The unsigned appointment','Thư hẹn không ký tên'),lines:[T('At eight tonight, a gentleman will call on a matter of consequence. Please receive him alone.','Tám giờ tối nay, một quý ông sẽ đến vì một việc hệ trọng. Xin tiếp ông ấy riêng.'),T('Do not consider a covered face a sign of dishonour. The name is precisely what must remain unknown.','Xin đừng coi việc che mặt là dấu hiệu thiếu danh dự. Chính tên tuổi là điều cần được giữ kín.')]};
  if(S.items?.invitation)S.items.invitation.doc={paper:'card',hand:'script',title:T('The final line of the invitation','Dòng cuối trong thư mời'),lines:[T('Come to ask, not to collect.','Hãy đến để hỏi, đừng đến để lấy.'),T('C. Voss','C. Voss')]};
  if(S.items?.c6_letter&&S.docs){const key=E.R()?.f?.c4_route==='alarm'?'c6_letter_alarm':'c6_letter_open';if(S.docs[key])S.items.c6_letter.doc=S.docs[key];}
 };
 E.on('boot',enrich);E.on('chapter',enrich);E.on('item',enrich);
 const view=E.ui.itemView;E.ui.itemView=id=>{enrich();return view(id);};
 const reveal=E.ui.reveal;E.ui.reveal=(id,o)=>{enrich();return reveal(id,o);};
})();
(() => {
 const E=StoryEngine,V=ValeDemo;
 E.on('end',(id,hasNext)=>{if(E.auto)return;queueMicrotask(()=>{
  const el=V.q('.se-end'),ending=E.S().endings?.[id];if(!el||!ending)return;
  const ch=ending.ch||E.R().ch||1,totalCh=V.caseMeta().chapters||E.S().chapters.length;el.querySelector('small').textContent=ending.final?((ending.open||/unresolved|limited|overstated|partial/.test(id))?'CASE LEFT OPEN · VỤ ÁN CÒN BỎ NGỎ':'CASE OUTCOME · KẾT QUẢ VỤ ÁN'):`CHAPTER ${ch} COMPLETE · XONG CHƯƠNG ${ch}`;
  const progress=document.createElement('div');progress.className='vd-chapter-progress';progress.style.gridTemplateColumns=`repeat(${totalCh},1fr)`;progress.setAttribute('aria-label',`Chapter ${ch} of ${totalCh} · Chương ${ch} trên ${totalCh}`);progress.innerHTML=Array.from({length:totalCh},(_,i)=>`<i class="${i<ch?'done':''}"></i>`).join('');el.querySelector('small').after(progress);
  const anchor=el.querySelector('.se-stats')||el.querySelector('.se-col');
  if(ending.chapterClose&&anchor)anchor.insertAdjacentHTML('beforebegin',`<div class="vd-chapter-close">${(V.recordText||V.bi)(ending.chapterClose)}</div>`);
  if(ending.nextObjective&&hasNext&&anchor)anchor.insertAdjacentHTML('beforebegin',`<div class="vd-next-objective"><small>Next step · Bước tiếp theo</small>${(V.recordText||V.bi)(ending.nextObjective)}</div>`);
  const tr=el.querySelector('details');if(tr)tr.open=!!E.G().set.tr;
  const stats=el.querySelector('.se-stats');if(stats){const total=Object.keys(E.S().endings||{}).filter(k=>E.S().endings[k].ch===ch),unlocked=total.filter(k=>E.G().endings[k]).length;stats.innerHTML=`<div><b>${unlocked}/${total.length}</b><small>Outcomes · Kết chương</small></div><div><b>${E.R().items.length}</b><small>Records · Hồ sơ</small></div><div><b>${Object.keys(E.G().words).length}</b><small>Saved words · Từ đã lưu</small></div>`;}
  const recap=el.querySelector('.se-recap');if(recap)recap.innerHTML='<b>Your route · Tuyến bạn đã đi</b>'+E.recapList(ch).filter(x=>x.ch===ch).map(x=>'<p>'+V.bi(x.t)+'</p>').join('');
  if(V.demoOnly)el.querySelector('.se-col')?.insertAdjacentHTML('beforebegin','<p class="se-mute">End of the Chapter 1 demo. The complete Part I is included in the ZIP.<span class="vd-vi">Hết demo Chương 1. Bản đầy đủ Phần I nằm trong gói ZIP.</span></p>');
  if(!ending.final&&hasNext)el.querySelector('.se-col')?.insertAdjacentHTML('beforebegin','<p class="se-mute">Your choices and evidence carry into the next chapter.<span class="vd-vi">Lựa chọn và chứng cứ của bạn được giữ sang chương tiếp theo.</span></p>');
 });});
})();
/* Shared mobile measurements; scene controls follow the actual HUD, not vh guesses. */
(() => {
 const E=StoryEngine;
 const location=E.ui.loc;
 E.ui.loc=(...args)=>{
  location(...args);
  const status=document.querySelector('.se-stat');
  if(status){const full=[status.querySelector('.st-n')?.textContent,status.querySelector('.st-t')?.textContent].filter(Boolean).join(' · ');status.title=full;status.setAttribute('aria-label',full||E.nat({en:'Location',vi:'Địa điểm'}));}
 };
 const reveal=E.ui.reveal;
 E.ui.reveal=(id,options={})=>{
  const pending=reveal(id,options);
  if(options.fresh&&E.S()?.recordReceipts){
   const close=document.querySelector('.se-rev.fresh .rv-tap');
   if(close)close.textContent=E.nat({en:'Continue',vi:'Tiếp tục'});
  }
  return pending;
 };
 E.on('boot',()=>{
  const root=document.querySelector('.se'),top=root?.querySelector('.se-top'),ui=root?.querySelector('.se-ui');if(!root||!top||!ui)return;
  const status=top.querySelector('.se-stat');
  if(status)status.onclick=event=>{
   event.stopPropagation();
   const name=status.querySelector('.st-n')?.textContent,time=status.querySelector('.st-t')?.textContent;
   if(!name)return;
   E.ui.sheet(E.nat({en:'Location',vi:'Địa điểm'}),'<p><b>'+E.esc(name)+'</b></p>'+(time?'<p>'+E.esc(time)+'</p>':'')+'<button class="se-btn wide" data-location-back>'+E.esc(E.nat({en:'Back to the story',vi:'Trở lại truyện'}))+'</button>');
   document.querySelector('[data-location-back]').onclick=()=>E.ui.closeSheet();
  };
  let frame=0;
  const measure=()=>{cancelAnimationFrame(frame);frame=requestAnimationFrame(()=>{
   const rr=root.getBoundingClientRect(),tr=top.getBoundingClientRect(),ur=ui.getBoundingClientRect();
   const side=matchMedia('(min-aspect-ratio: 11/10) and (max-height: 560px)').matches;
   const bottom=!side&&ui.children.length&&ur.width>rr.width*.65?Math.max(0,rr.bottom-ur.top):0;
   root.style.setProperty('--vale-hud-height',Math.round(bottom)+'px');
   root.style.setProperty('--vale-toolbar-height',Math.ceil(tr.height+Math.max(0,tr.top-rr.top))+'px');
  });};
  const ro=new ResizeObserver(measure);ro.observe(top);ro.observe(ui);ro.observe(root);
  const mo=new MutationObserver(measure);mo.observe(ui,{childList:true,subtree:false});mo.observe(root,{attributes:true,attributeFilter:['data-m']});
  addEventListener('resize',measure);E.on('line',measure);E.on('step',measure);E.on('image-plane',measure);measure();
 });
})();
/* Ordinary client conversations use the native visual-novel question list.
   Advanced preparation/comparison remains opt-in through the engine's
   `interrogation` metadata, for a later confrontation that actually needs it.
   Do not reorder questions or replace their IDs, branches or once flags:
   older C1 saves must resume the same authored conversation. */
(() => {
  const E = StoryEngine;
  const install = () => {
    const S = E.S();
    if (S?.id !== 'vale-dossiers-p1c1-v01') return;
    const step = S.nodes?.c1_questions?.[0];
    if (step?.interrogation?.id === 'c1-matthias') delete step.interrogation;
  };
  E.on('boot', install);
  E.on('chapter', install);
})();
/* Optional practice using only lines the player has already encountered. */
(() => {
 const E=StoryEngine,V=ValeDemo,esc=E.esc;
 V.practice=(index=0)=>{
  const log=(E.R().log||[]).filter(x=>x.kind==='say'&&(x.lang==='en'||(x.lang==='vi'&&x.sub))).slice(-16).reverse();
  const lines=log.map(x=>({text:(x.lang==='en'?x.main:x.sub).replace(/\[\[|\]\]/g,''),vi:x.lang==='en'?x.sub:x.main,who:x.who}));
  if(!lines.length){E.ui.sheet('English practice · Luyện tiếng Anh','<p>Play a little further to practise the dialogue you have heard.</p><p class="vd-vi">Đọc thêm một chút để luyện lại chính những câu thoại bạn đã gặp.</p>');return;}
  index=Math.max(0,Math.min(index,lines.length-1));const line=lines[index];
  const candidates=[...line.text.matchAll(/\b[A-Za-z][A-Za-z'-]{3,}\b/g)].filter(m=>!['that','this','with','have','your','what','from','there','would','could','will','shall'].includes(m[0].toLowerCase()));
  const word=candidates.find(m=>E.S().words?.[m[0].toLowerCase()])||candidates[Math.floor(candidates.length/2)];
  let closed=false,recorder=null,stream=null,url=null,chunks=[],recordTimer=null;
  const capable=!!(navigator.mediaDevices?.getUserMedia&&globalThis.MediaRecorder);
  const sh=E.ui.sheet('Listen & speak · Nghe và nói theo',`<div class="vd-practice"><p class="se-mute">From your current route · Lấy từ tuyến bạn đã đọc</p><div class="vd-practice-quote" lang="en">${esc(line.text)}</div><details ${E.G().set.tr?'open':''}><summary>Meaning · Nghĩa tiếng Việt</summary><p lang="vi">${esc(line.vi||'')}</p></details><div class="se-row"><button class="se-btn" data-hear>Listen · Nghe</button><button class="se-btn" data-slow>Slower · Nghe chậm</button></div>${word?`<details class="vd-fill"><summary>Fill the missing word · Điền từ còn thiếu</summary><p lang="en">${esc(line.text.slice(0,word.index))}<b>______</b>${esc(line.text.slice(word.index+word[0].length))}</p><label class="se-fl">Your answer · Câu trả lời<input class="se-in" data-answer autocomplete="off" autocapitalize="none" spellcheck="false" inputmode="text"></label><div class="se-row"><button class="se-btn pri" data-check>Check · Kiểm tra</button><button class="se-btn" data-show>Show word · Xem từ</button></div><p data-feedback role="status"></p></details>`:''}<div class="vd-practice-record"><h3>Say it yourself · Tự nói lại</h3><p class="se-mute">Listen, say the line, then compare your recording. This practice has no automatic score.<span class="vd-vi">Nghe, nói lại rồi tự so với câu mẫu. Phần luyện này không chấm điểm tự động.</span></p>${globalThis.Enmi?.shadow?'<button class="se-btn wide" data-shadow>Practise with Enmi · Luyện nói trong Enmi</button>':''}<button class="se-btn wide" data-record ${capable?'':'disabled'}>Record my voice · Thu giọng của tôi</button><p data-record-status class="se-mute" role="status">${capable?'Microphone is used only after you tap Record. The clip stays in this session. · Chỉ bật mic khi bạn bấm Thu; bản thu chỉ nằm trong phiên này.':'Recording is unavailable in this browser context. You can still listen and speak aloud. · Ngữ cảnh trình duyệt này chưa hỗ trợ thu; bạn vẫn có thể nghe và nói theo.'}</p><audio data-audio controls hidden></audio></div><div class="se-row"><button class="se-btn" data-prev ${index?'':'disabled'}>← Newer · Mới hơn</button><button class="se-btn" data-next ${index<lines.length-1?'':'disabled'}>Earlier · Trước đó →</button></div></div>`,'tall');
  const say=slow=>E.say(line.text,line.who,{force:true,lang:'en',slow});
  sh.querySelector('[data-hear]').onclick=()=>say(false);sh.querySelector('[data-slow]').onclick=()=>say(true);
  if(word){const feedback=sh.querySelector('[data-feedback]');const check=()=>{const a=sh.querySelector('[data-answer]').value.trim().toLowerCase();feedback.textContent=a===word[0].toLowerCase()?'✓ Correct. Read the whole sentence once more. · Đúng. Hãy đọc lại cả câu.':'Try again. You can listen to the line. · Thử lại; bạn có thể nghe câu mẫu.';};sh.querySelector('[data-check]').onclick=check;sh.querySelector('[data-answer]').onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();check();}};sh.querySelector('[data-show]').onclick=()=>{feedback.textContent=word[0]+(E.S().words?.[word[0].toLowerCase()]?.vi?' — '+E.S().words[word[0].toLowerCase()].vi:'');};}
  const stopStream=()=>{stream?.getTracks().forEach(t=>t.stop());stream=null;};
  const stop=()=>{clearTimeout(recordTimer);if(recorder?.state==='recording')recorder.stop();else stopStream();};
  const rec=sh.querySelector('[data-record]'),status=sh.querySelector('[data-record-status]');
  rec.onclick=async()=>{if(recorder?.state==='recording'){stop();return;}rec.disabled=true;status.textContent='Requesting microphone… · Đang xin quyền dùng mic…';E.hush();
   try{stream=await navigator.mediaDevices.getUserMedia({audio:true});if(closed){stopStream();return;}chunks=[];recorder=new MediaRecorder(stream);recorder.ondataavailable=e=>{if(e.data.size)chunks.push(e.data);};recorder.onstop=()=>{stopStream();if(closed)return;if(url)URL.revokeObjectURL(url);url=URL.createObjectURL(new Blob(chunks,{type:recorder.mimeType||'audio/webm'}));const a=sh.querySelector('[data-audio]');a.src=url;a.hidden=false;rec.textContent='Record again · Thu lại';rec.disabled=false;status.textContent='Play your clip and compare with the original line. · Nghe bản thu và so với câu mẫu.';};recorder.start();rec.disabled=false;rec.textContent='Stop recording · Dừng thu';status.textContent='Recording… maximum 30 seconds. · Đang thu… tối đa 30 giây.';recordTimer=setTimeout(stop,30000);
   }catch{stopStream();if(!closed){rec.disabled=false;status.textContent='Microphone could not start. Check your browser permission, or practise aloud without recording. · Chưa mở được mic. Kiểm tra quyền trình duyệt hoặc luyện nói trực tiếp.';}}};
  const shadow=sh.querySelector('[data-shadow]');if(shadow)shadow.onclick=()=>globalThis.Enmi.shadow(line.text,{tr:line.vi});
  sh.querySelector('[data-prev]').onclick=()=>V.practice(index-1);sh.querySelector('[data-next]').onclick=()=>V.practice(index+1);
  const prev=sh.onclose;sh.onclose=()=>{closed=true;stop();stopStream();if(url)URL.revokeObjectURL(url);E.hush();prev?.();};
 };
})();
