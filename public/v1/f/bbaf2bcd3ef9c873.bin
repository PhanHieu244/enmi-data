    const entrances = [
      ['c2_call', [1], ['reed', 'celia']], ['c2_call', [8], ['reed', 'celia', 'hart']],
      ['c3_open', [11], ['reed', 'celia', 'hart', 'c3_clerk']], ['c3_open', [27], ['reed', 'celia', 'hart']],
      ['c4_open_visit', [1], ['reed', 'bell']], ['c4_open_visit', [6], ['reed', 'celia', 'hart']],
      ['c5_return', [1], ['bell']], ['c5_return', [12], ['reed']],
