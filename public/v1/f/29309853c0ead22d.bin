    if (!d || !root || R.shot || R.cg || R.look || R.actionFrame || R.vw && !readingStep) return;
    const present = new Set((context?.present || []).filter(id => !context.remote?.[id]));
    const actors = d.cast.filter(id => present.has(id) && R.cast?.[id])
