    ["nodes.p3c4_open.39.choice", [
      [false, "Visit Dorn with Nora; let Reed obtain the written confirmation."],
      [false, "Verify the shop account in person first, accepting that the race deadline will be missed."],
      [false, "Prioritise recovery; leave the cause of death open for a further inquiry."],
    ]],
    ["nodes.p3c5_open.25.choice", [
      [false, "Report the supported explanation of the death and the separate concealment."],
      [false, "Report recovery now; leave the death open for further examination."],
      [false, "Accuse Dorn of the death as well as concealment."],
    ]],
    ["nodes.p3c5_accuse.2.choice", [
      [false, "Correct the accusation and give the supported account."],
      [false, "Maintain the accusation in the public report."],
    ]],
  ];
  function install() {
    const S = E.S();
    if (!/^vale-dossiers(?:-|$)/.test(S?.id || '')) return;
    const audit = { options: 0, dialogue: 0, actions: 0, mismatches: [], unclassified: [] };
    for (const [path, expected] of authored) {
      const choices = path.split('.').reduce((value, key) => value?.[key], S);
      if (!choices) continue; // Chapters may arrive lazily.
      if (!Array.isArray(choices) || choices.length !== expected.length) {
        audit.mismatches.push(path); continue;
      }
      expected.forEach(([speech, text], i) => {
        const option = choices[i];
        if (option?.en !== text) { audit.mismatches.push(path + '.' + i); return; }
        option.speech = speech;
        audit.options++; audit[speech ? 'dialogue' : 'actions']++;
      });
    }
    const visit = (value, path) => {
      if (!value || typeof value !== 'object') return;
      if (Array.isArray(value.choice)) value.choice.forEach((option, i) => {
        if (typeof option.speech !== 'boolean') audit.unclassified.push(path + '.choice.' + i);
      });
      for (const [key, child] of Object.entries(value)) visit(child, path + '.' + key);
    };
    for (const key of ['nodes', 'places', 'talks']) visit(S[key], key);
    V.choiceSpeechAudit = audit;
    if (audit.mismatches.length || audit.unclassified.length)
      console.warn('[vale choices] Review authored speech metadata', audit);
  }
  E.on('boot', install);
  E.on('chapter', install);
})();
/* Vale 0.9.6 · authored spatial connections.
 * A view of another room is reached through its door, not by rotating an
 * implicit image carousel. Existing view IDs, clue/person arrays and saved
 * interpreter paths are retained. New portals are appended, never inserted.
 * Map coordinates describe connections only; they are not a measured plan.
 */
(() => {
  'use strict';
  const E = StoryEngine, V = ValeDemo;
  const T = (en, vi) => ({ en, vi });
  const enabled = () => /^vale-dossiers(?:-|$)/.test(E.S()?.id || '');
  const entries = new Map();
  const at = (S, path) => path.reduce((v, k) => v?.[k], S);

  function spatial(P, id, title) {
    if (!P?.views) return false;
    P.spatial = { ...P.spatial, title };
    entries.set(id, P);
    return true;
  }
  function view(P, id, space, x, y) {
    const v = P?.views?.[id];
    if (!v) return null;
    Object.assign(v, { space, map: { x, y }, left: null, right: null });
    return v;
  }
  function portal(v, id, to, label, kind, r) {
    if (!v) return;
    const value = { id, to, label, kind, r: [...r], clue: false, glint: true, look: false };
    const prior = (v.zones ||= []).find(z => z.id === id);
    if (prior) Object.assign(prior, value);
    else v.zones.push(value);
  }
  function route(v, id, to, label, kind = 'walk') {
    if (!v) return;
    const value = { id, to, label, kind };
    const prior = (v.routes ||= []).find(r => r.id === id);
    if (prior) Object.assign(prior, value);
    else v.routes.push(value);
  }
  function back(v, to, label, kind = 'exit') {
    if (v) Object.assign(v, { up: to, upKind: kind, upLabel: label });
  }
  function sameArea(P, id, title, space, order, positions) {
    if (!spatial(P, id, title)) return;
    for (let i = 0; i < order.length; i++) {
      const k = order[i], v = view(P, k, space, ...positions[k]);
      if (!v) continue;
      // The original three viewpoints are a rotation within the same area.
      // A two-view pair has only one real side in each view, never two aliases.
      v.left = order.length === 2 ? (i ? order[i - 1] : null) : order[(i + order.length - 1) % order.length];
      v.right = order.length === 2 ? (i ? null : order[i + 1]) : order[(i + 1) % order.length];
    }
  }
  function stable(P, id) {
    if (!spatial(P, id, T('Wycliffe · yard and stable', 'Wycliffe · sân và chuồng'))) return;
    const yard = view(P, 'yard', 'wycliffe-yard', 1, 1);
    const stall = view(P, 'stall', 'wycliffe-stable', 1, 2);
    // Use the right portion of the actual left opening. A broad doorway ROI
    // pulls cover framing left and clips Nora on a tall phone. The narrow ROI
    // retains the original camera/actor frame and gets the engine's 44px hit.
    portal(yard, 'v096_enter_stable', 'stall', T('Enter the stable', 'Vào chuồng ngựa'), 'enter', [28, 24, 8, 30]);
    // Inside, the far-left exterior door cannot share a tall cover frame with
    // the original latch on the right. The named return is the honest exit;
    // do not add an off-door hotspot or sacrifice an original clue to fit it.
    back(stall, 'yard', T('Back to the yard', 'Trở ra sân trại'));
  }

  function install() {
    if (!enabled()) return;
    const S = E.S();
    if (!['vale-dossiers-part2-v01', 'vale-dossiers-part3-v01'].includes(S.id)) {
      const study = at(S, ['nodes', 'c1_open', 15, 'place']);
      sameArea(study, 'c1_desk', T('Vale’s study · views', 'Phòng Vale · các góc nhìn'),
        'vale-study', ['desk', 'window', 'door'], { desk: [2, 1], window: [3, 2], door: [1, 2] });
      // This bitmap is viewed from inside the study, looking through its door.
      if (study?.views?.door) study.views.door.name = T('Door to the landing', 'Cửa ra chiếu nghỉ');
      const lane = at(S, ['nodes', 'c1_departure', 9, 'place']);
      sameArea(lane, 'c1_alder_walk', T('Alder Lane · views', 'Ngõ Alder · các góc nhìn'),
        'alder-lane-evening', ['cab', 'corner'], { cab: [1, 1], corner: [2, 1] });
      // v093 already migrates the obsolete playable front view to an in-place
      // door inspection. Retain its original definition for saved child paths.
      if (lane?.views?.front) {
        const legacy = view(lane, 'front', 'alder-lane-evening', 2, 2);
        back(legacy, 'corner', T('Back to the lane', 'Về ngõ Alder'), 'back');
      }
      sameArea(S.places?.c2_lane, 'c2_lane', T('Alder Lane · views', 'Ngõ Alder · các góc nhìn'),
        'alder-lane-day', ['front', 'rank', 'gate'], { front: [2, 1], rank: [3, 2], gate: [1, 2] });

      const church = S.places?.c3_church;
      if (spatial(church, 'c3_church', T('St Anselm’s · access', 'St Anselm · lối đi'))) {
        const court = view(church, 'court', 'st-anselm-courtyard', 1, 1);
        const door = view(church, 'door', 'st-anselm-threshold', 1, 2);
        // Original dialogue still takes place on the threshold; Celia invites
        // the player fully inside only after the original inspection/meeting.
        portal(court, 'v096_chapel_door', 'door', T('Approach the chapel door', 'Đến cửa gian lễ'), 'walk', [42, 33, 16, 20]);
        back(door, 'court', T('Back to the churchyard', 'Về sân nhà thờ'), 'back');
      }
    }
    if (S.id === 'vale-dossiers-part2-v01') {
      const house = S.places?.p2c2_house;
      if (spatial(house, 'p2c2_house', T('Blackthorn · access', 'Blackthorn · lối đi'))) {
        const yard = view(house, 'yard', 'blackthorn-courtyard', 1, 1);
        const corridor = view(house, 'corridor', 'blackthorn-west-corridor', 1, 2);
        const room = view(house, 'room', 'blackthorn-alice-room', 1, 3);
        portal(yard, 'v096_enter_house', 'corridor', T('Enter Blackthorn', 'Vào nhà Blackthorn'), 'enter', [76, 40, 11, 13]);
        portal(corridor, 'v096_enter_alice_room', 'room', T('Enter Alice’s former room', 'Vào phòng cũ của Alice'), 'enter', [50, 25, 14, 35]);
        back(corridor, 'yard', T('Go out to the courtyard', 'Ra sân trước'));
        back(room, 'corridor', T('Return to the corridor', 'Ra hành lang'));
        // Owen previously occupied the entire painted front door. Move only
        // his horizontal anchor to the cottage side; keep scale/feet intact.
        const owen = yard?.people?.find(p => p.who === 'owen');
        if (owen?.r) owen.r = [20, owen.r[1], owen.r[2], owen.r[3]];
        // Keep the existing observation on the visible broad path, clear of
        // Owen's foreground body. Its text, ID and saved child path stay put.
        const yardPath = yard?.zones?.find(z => z.id === 'yard_path');
        if (yardPath) yardPath.r = [50, 65, 24, 17];
        // The clue describes the order of all three doors. Its old rectangle
        // covered the open middle entrance; place it on the left door instead.
        const order = corridor?.zones?.find(z => z.id === 'door_order');
        if (order) order.r = [24, 33, 8, 26];
      }
    }
    if (S.id === 'vale-dossiers-part3-v01') {
      stable(S.places?.p3c1_stable_walk, 'p3c1_stable_walk');
      stable(S.places?.p3c3_yard_walk, 'p3c3_yard_walk');
      const ground = S.places?.p3c2_ground;
      if (spatial(ground, 'p3c2_ground', T('Moor · paths', 'Đồng hoang · lối đi'))) {
        // The preceding narration has already brought the player to the
        // cordon. start applies only when no saved PS.v exists for this place.
        ground.start = 'hollow';
        const path = view(ground, 'path', 'moor-drainage-path', 1, 1);
        const hollow = view(ground, 'hollow', 'moor-cordon-edge', 1, 2);
        // The cordon is not visible in the path painting. A named walking
        // route is honest; a glint on an arbitrary patch of heather is not.
        route(path, 'v096_walk_to_cordon', 'hollow', T('Walk to the edge of the hollow', 'Đi tới mép hõm đất'));
        back(hollow, 'path', T('Back to the drainage path', 'Về lối ven rãnh nước'), 'back');
        hollow.name = T('Edge of the hollow', 'Mép hõm đất');
      }
    }
  }
  function apply() {
    install();
    // Per-part layout hooks load after common plugins. Converge after those
    // hooks without changing any interpreter cursor or runtime progress.
    queueMicrotask(install);
  }
  E.on('boot', apply);
  E.on('chapter', apply);
  V.v096Spatial = () => ({
    version: '0.9.6',
    places: [...entries].filter(([, P]) => P.spatial).map(([id, P]) => ({
      id, start: P.start,
      views: Object.fromEntries(Object.entries(P.views).map(([key, v]) => [key, {
        space: v.space, map: v.map, left: v.left, right: v.right,
        up: v.up, upKind: v.upKind,
        portals: (v.zones || []).filter(z => z.id?.startsWith('v096_')).map(z => ({ id: z.id, to: z.to, kind: z.kind, r: z.r })),
        routes: (v.routes || []).map(r => ({ id: r.id, to: r.to, kind: r.kind }))
      }]))
    }))
  });
})();
/* Vale 0.9.6 · authored emotional continuity.
 * The original Lydia "calm" painting is visibly smiling. Composure during a
 * death report, a threat or safety planning is not a request for that smile.
 * Reuse the original serious full-body poses; keep prose, timing/IDs of old
 * cues, branching, rewards, arrays and save paths untouched.
 */
(() => {
  'use strict';
  const E = StoryEngine, V = ValeDemo;
  const enabled = () => E.S()?.id === 'vale-dossiers-part2-v01';
  const changes = new Map();
  const at = (S, path) => path.reduce((value, key) => value?.[key], S);
  const mark = (path, kind, reason) => changes.set(path.join('.'), { path: [...path], kind, reason });
  // A listener may be restored from an old save in the middle of somebody
  // else's question. Change only an existing Lydia, in her existing slot.
  // In particular this must not re-enter her after the talk's Leave hides her.
  E.side('valeEmotion096', value => {
    const old = E.R()?.cast?.lydia;
    if (!enabled() || value !== 'full' || !old || old.face === 'full') return;
    E.ui.show('lydia', old.at, 'full');
  });
  function listener(S, path) {
    const step = at(S, path);
    if (!step || !(step.say && step.say !== 'lydia' || step.choice || step.read || step.reconstruct)) return;
    step.valeEmotion096 = 'full';
    mark(path, 'report-listener', 'A resumed question/panel resets an already-present Lydia without spawning or moving her.');
  }
  function face(S, path, text, value) {
    const step = at(S, path);
    if (step?.say !== 'lydia' || step.en !== text) return;
    // "full" resolves the actual original full-body image and is truthy.
    // Empty-string face metadata is ignored by the engine's say handler.
    step.face = value;
    mark(path, 'line-expression', 'Explicit serious expression; no inherited smile.');
  }
  function reportPresence(S, path, text) {
    const step = at(S, path);
    if (step?.n?.en !== text) return;
    step.valePresence = { ...step.valePresence, show: [
      ...(step.valePresence?.show || []).filter(actor => actor.id !== 'lydia'),
      { id: 'lydia', face: 'full' }
    ] };
    mark(path, 'report-narration', 'A saved report narration restores the same serious present actor.');
  }
  function motionFace(S, path, owner, value) {
    const step = at(S, path), motion = step?.motion;
    if (motion?.id !== owner) return;
    step.motion = { ...motion, actors: (motion.actors || []).map(actor => actor.id !== 'lydia' ? actor : {
      ...actor, frames: (actor.frames || []).map(frame => frame.face === 'calm' ? { ...frame, face: value } : { ...frame })
    }) };
    mark(path, 'motion-expression', 'Composed/recovering does not use the smiling calm artwork.');
  }
  function trackArt(S, path, owner, art) {
    const step = at(S, path), motion = step?.motion;
    if (motion?.id !== owner) return;
    step.motion = { ...motion, tracks: (motion.tracks || []).map(track => track.id !== 'v091-stage-lydia' ? track : {
      ...track, art, frames: (track.frames || []).map(frame => frame.art === 'lydia-calm' ? { ...frame, art } : { ...frame })
    }) };
    mark(path, 'exit-track-expression', 'The departure retains a serious full-body pose.');
  }
  function install() {
    if (!enabled()) return;
    const S = E.S();
    const talk = S.talks?.p2c1_lydia;
    if (talk?.with === 'lydia') {
      const hello = talk.hello?.[0];
      if (hello?.en === 'Please ask one thing at a time. Everyone else seems to need the whole night in a single sentence.')
        face(S, ['talks', 'p2c1_lydia', 'hello', 0], hello.en, 'full');
      for (const [index, topic] of (talk.topics || []).entries())
        if (['night', 'words', 'today', 'sister'].includes(topic.id))
          for (const [lineIndex, line] of (topic.then || []).entries()) {
            if (line.say === 'lydia')
              face(S, ['talks', 'p2c1_lydia', 'topics', index, 'then', lineIndex], line.en, 'full');
            else if (line.say)
              listener(S, ['talks', 'p2c1_lydia', 'topics', index, 'then', lineIndex]);
          }
      listener(S, ['talks', 'p2c1_lydia', 'bye', 0]);
      // Saves can resume inside a topic without replaying its first line.
      // Each report statement, and its visible narrator response, declares
      // its own expression. Existing v0.9.5 saves need no cursor migration.
      reportPresence(S, ['talks', 'p2c1_lydia', 'topics', 0, 'then', 4],
        'Her thumb presses a crease into the glove. Reed writes the uncertainty down as carefully as the order of the three events.');
      // A smile belongs precisely to the narrated reminiscence. Its passing
      // is also authored: the endpoint, Skip, Replay and reload are serious.
      const memoryPath = ['talks', 'p2c1_lydia', 'topics', 3, 'then', 1];
      const memory = at(S, memoryPath);
      if (talk.topics?.[3]?.id === 'sister' &&
          memory?.n?.en === 'Lydia almost smiles. The expression passes without becoming an apology.' &&
          (!memory.motion || memory.motion.id === 'p2-v096-lydia-memory-smile')) {
        memory.motion = { id: 'p2-v096-lydia-memory-smile', ms: 1700, actors: [{
          id: 'lydia', frames: [
            { offset: 0, face: 'full' }, { offset: .2, face: 'calm' },
            { offset: .6, face: 'calm' }, { offset: 1, face: 'full' }
          ]
        }] };
        mark(memoryPath, 'authored-brief-smile', 'The text explicitly allows a brief memory smile and says it passes.');
      }
      face(S, ['talks', 'p2c1_lydia', 'topics', 3, 'then', 2],
        'Everyone asks how she died. Thank you for allowing her something else.', 'full');
      const parentPath = ['nodes', 'p2c1_open', 14], parent = at(S, parentPath);
      if (parent?.talk === 'p2c1_lydia') {
        parent.valePresence = { ...parent.valePresence, show: [
          ...(parent.valePresence?.show || []).filter(actor => actor.id !== 'lydia'),
          { id: 'lydia', face: 'full' }
        ] };
        mark(parentPath, 'topic-boundary', 'Returning to the report/topic picker clears a previous emotional beat.');
      }
    }
    for (const path of [[11], [15, 'then', 0], [18], [20], [22], [25], [27], [30], [31],
      [31, 'choice', 0, 'then', 1], [31, 'choice', 1, 'then', 1]])
      listener(S, ['nodes', 'p2c1_open', ...path]);
    for (const [path, text] of [
      [[12], 'My stepfather has told me to move into my sister’s room. Alice died there. Last night I heard the sound she used to ask me about.'],
      [[15, 'then', 1], 'I heard Alice cry out, opened my door, and saw her coming into the corridor. I reached her before she fell, then called for help. There was a whistle earlier and a metal sound I cannot place.'],
      [[16, 'then', 0], 'She said “speckled band”, or that is what I remember. She did not name anyone. I have never known what she meant.'],
      [[23], 'I asked. He said I could see for myself when it was finished.'],
      [[26], 'That is how it happened. The other sounds may fit around it. I wish I knew where.'],
      [[29], 'My aunt lives beyond the village. I could go there. But if I leave without asking what happened to Alice, I shall carry this room with me.']
    ]) face(S, ['nodes', 'p2c1_open', ...path], text, 'full');
    reportPresence(S, ['nodes', 'p2c1_open', 24],
      'You lay three slips beside the note. Lydia reads each before you move it. Separate what she knows from what six months of trying have not made clear.');
    reportPresence(S, ['nodes', 'p2c1_open', 28],
      'She looks towards the window. A milk cart rattles past; for the first time she follows an ordinary sound without shrinking from it. Reed brings the tea, giving her a moment before the next question.');
    face(S, ['nodes', 'p2c1_open', 19],
      'Yes. I brought it because I was afraid I would make his words sound worse than they were.', 'full');
    face(S, ['nodes', 'p2c1_open', 31, 'choice', 1, 'then', 2],
      'I can do that. It is easier to open a door when someone will be beside it.', 'resolute');
    face(S, ['nodes', 'p2c5_watch', 6],
      'I will wait. If I change my mind, Ruth and I leave for my aunt’s.', 'resolute');
    face(S, ['nodes', 'p2c6_intervention', 2],
      'For once, he had to say it where someone could remember it besides me.', 'resolute');
    for (const [node, index, owner, value] of [
      ['p2c1_open', 17, 'p2-v06-voluntary-note', 'full'],
      ['p2c2_open', 17, 'vale08-p2c2_open-17', 'full'],
      ['p2c3_open', 33, 'p2-v094-lydia-recovers-after-crash', 'full'],
      ['p2c5_watch', 5, 'p2-v06-safe-arrangement', 'resolute']
    ]) motionFace(S, ['nodes', node, index], owner, value);
    trackArt(S, ['nodes', 'p2c4_open', 40], 'p2-v091-lydia-ruth-leave-room', 'lydia-resolute');
    trackArt(S, ['nodes', 'p2c6_intervention', 3], 'p2-v091-lydia-passes-study', 'lydia-resolute');
  }
  // Part layouts can be registered after common plugins. Reapply only the
  // known authored expression anchors after that composed-data pass.
  E.on('boot', () => { install(); queueMicrotask(install); });
  E.on('chapter', () => { install(); queueMicrotask(install); });
  V.v096Emotions = () => ({ enabled: enabled(), changes: [...changes.values()],
    preservedSmile: 'talks.p2c1_lydia.topics.3.then.1',
    artPolicy: 'Original full-body assets only; calm is a smile, full/resolute are serious.' });
})();
/* Vale 0.9.7 · measured people and intentional close views.
