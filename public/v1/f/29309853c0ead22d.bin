        const st = steps?.[index], origin = notebookOrigins.get(st?.motion?.id);
        const prop = origin && R.props?.[origin.prop], face = prop && poseFaces[prop.art];
        if (!face || prop.img !== (R.shot || R.scene) || !st.motion.actors?.some(a => a.id === 'reed')) continue;
        if (R.cast?.reed) R.cast.reed = { ...R.cast.reed, face };
