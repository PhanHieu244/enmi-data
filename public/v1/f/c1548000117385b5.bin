          const foot = seated ? 1439 : current.stable ? poseFoot || feet[el.dataset.id] || 1520 : el.dataset.id === 'reed' ? 1505 : 1520;
          art.style.backgroundSize = `${1024 * scale}px ${1536 * scale}px`;
