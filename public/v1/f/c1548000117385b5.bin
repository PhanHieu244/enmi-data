(() => {
  'use strict';
  const E = StoryEngine, T = (en, vi) => ({ en, vi });
  const greeting = {
    prompt: T('What can the greeting and the passer-by’s appearance establish?', 'Lời chào và dáng vẻ người đi đường xác nhận được điều gì?'),
    nudge: T('Separate the name that was spoken from the identity of the person speaking.', 'Tách cái tên được gọi khỏi danh tính của người gọi.'),
    review: {
      text: T('These records do not establish the same point. Knowing Vale’s name and identifying the passer-by are separate questions.', 'Hai hồ sơ này chưa xác lập cùng một điều. Biết tên Vale và xác định người đi đường là hai câu hỏi riêng.'),
      with: [
        { id: 'c3_cuff', text: T('A pin or a familiar appearance can support a resemblance. It does not by itself identify the person who spoke.', 'Chiếc ghim hoặc dáng vẻ quen có thể cho thấy nét giống nhau. Riêng nó chưa xác định người đã lên tiếng.') },
        { id: 'c4_photo_seen', text: T('Seeing the photograph establishes where it was then. It does not identify the person who later greeted Vale.', 'Việc thấy bức ảnh xác nhận nó ở đâu lúc đó. Nó chưa xác định người chào Vale sau này.') }
      ]
    }
  };
  const rows = [
    { game: 'vale-dossiers-p1c1-v01', path: ['c1_review', 1, 'then', 0], kind: 'caseboard', fields: {
      prompt: T('What contradicts the claim that the photograph was stolen?', 'Điều gì mâu thuẫn với lời nói bức ảnh bị đánh cắp?'),
      nudge: T('Distinguish a present accusation from an account of how the photograph changed hands. Can both accounts be true?', 'Tách lời buộc tội hiện tại khỏi lời kể về cách bức ảnh đổi chủ. Hai lời kể có thể cùng đúng không?'),
      review: {
        text: T('This pair does not establish how Celia obtained the photograph. Urgency or a later warning cannot establish theft.', 'Cặp này chưa xác định Celia có bức ảnh bằng cách nào. Sự cấp bách hay lời cảnh báo về sau chưa chứng minh việc đánh cắp.'),
        with: [
          { id: 'watermark', text: T('A paper mark concerns the letter’s material. It cannot establish how the photograph changed hands.', 'Dấu giấy nói về chất liệu lá thư. Nó không xác định bức ảnh đã đổi chủ bằng cách nào.') },
          { id: 'press_cutting', text: T('The notice explains the deadline. It does not establish who gave or took the photograph.', 'Mẩu báo giải thích thời hạn. Nó chưa xác định ai đã trao hay lấy bức ảnh.') }
        ]
      }
    } },
    { game: 'vale-dossiers-p1c1-v01', path: ['c3_board', 1], kind: 'caseboard', fields: {
      prompt: T('What did Hart know, and what makes Celia’s warning urgent?', 'Hart đã biết gì, và vì sao lời cảnh báo của Celia trở nên cấp bách?'),
      nudge: T('Prior knowledge and the deadline are two separate points. Check each against a second source.', 'Điều đã biết trước và thời hạn là hai điểm riêng. Đối chiếu từng điểm với một nguồn khác.'),
      review: { text: T('These records do not verify either point together. Check what was known before the marriage, then the timing of the warning.', 'Hai hồ sơ này chưa cùng xác minh một điểm. Xét điều đã biết trước hôn lễ, rồi xét thời điểm của lời cảnh báo.') }
    } },
    { game: 'vale-dossiers-p1c1-v01', path: ['c5_desk', 6, 'then', 0], kind: 'caseboard', fields: greeting },
    { game: 'vale-dossiers-p1c1-v01', path: ['c5_desk', 6, 'else', 0], kind: 'caseboard', fields: greeting },
    { game: 'vale-dossiers-p1c1-v01', path: ['c6_visit', 11], kind: 'deduce', fields: {
      prompt: T('Which two records identify the person who greeted Vale?', 'Hai hồ sơ nào xác định người đã chào Vale?'),
      nudge: T('Look for an account of that encounter whose source can be checked. Resemblance alone is not identification.', 'Tìm lời kể về lần gặp ấy có nguồn kiểm chứng được. Chỉ giống dáng vẻ chưa đủ để xác định danh tính.'),
      review: {
        text: T('This pair does not identify the speaker. Clothes, departure timing or a separate portrait cannot alone establish who gave the greeting.', 'Cặp này chưa xác định người nói. Quần áo, giờ rời đi hay chân dung riêng chưa đủ để biết ai đã chào.'),
        with: [{ id: 'c3_name_trace', text: T('Knowing Vale’s name identifies the person being addressed. It does not by itself identify the speaker.', 'Biết tên Vale xác định người được gọi. Riêng điều đó chưa xác định người lên tiếng.') }]
      }
    } },
    { game: 'vale-dossiers-part2-v01', path: ['p2c3_open', 30], kind: 'caseboard', fields: {
      prompt: T('Do the room explanation and the money account fit the records?', 'Lời giải thích về phòng và tiền có khớp hồ sơ không?'),
      nudge: T('Test each explanation against another source before combining motive and action.', 'Kiểm từng lời giải thích bằng một nguồn khác trước khi ghép động cơ với hành vi.'),
      review: {
        text: T('These records do not check the same explanation against another source. Keep the room arrangements and financial pressure separate.', 'Hai hồ sơ này chưa kiểm cùng một lời giải thích bằng nguồn khác. Tách việc sắp xếp phòng khỏi sức ép tài chính.'),
        pairs: [{ ids: ['p2_order', 'p2_income'], text: T('An order and financial pressure may suggest a motive. Neither independently checks whether the repairs required the move.', 'Lệnh chuyển phòng và sức ép tiền bạc có thể gợi động cơ. Chúng chưa kiểm chứng việc sửa chữa có buộc phải chuyển phòng hay không.') }]
      }
    } },
    { game: 'vale-dossiers-part2-v01', path: ['p2c4_open', 36], kind: 'caseboard', fields: {
      prompt: T('Does a locked window rule out every route into this room?', 'Cửa sổ khóa có loại trừ mọi đường vào phòng này không?'),
      nudge: T('Separate a route that has been ruled out from a route that has not yet been checked.', 'Tách đường đã bị loại trừ khỏi đường chưa được kiểm tra.'),
      review: { text: T('This pair does not establish another route. A strange object or remembered phrase is not yet a traced connection between rooms.', 'Cặp này chưa xác lập một đường khác. Đồ vật lạ hay câu nói được nhớ lại chưa phải đường thông giữa hai phòng đã kiểm tra.') }
    } },
    { game: 'vale-dossiers-part2-v01', path: ['p2c6_open', 7, 'then', 8], kind: 'deduce', fields: {
      prompt: T('Which two records establish the route of the movement you saw?', 'Hai hồ sơ nào xác lập đường đi của chuyển động bạn đã thấy?'),
      nudge: T('Separate the movement witnessed that night from the physical connection between the rooms.', 'Tách chuyển động được chứng kiến trong đêm khỏi cấu trúc nối hai căn phòng.'),
      review: { text: T('Money or remembered words do not record a route. Connect what was seen moving with a checked feature of the rooms.', 'Tiền bạc hay lời được nhớ lại chưa ghi nhận đường đi. Đối chiếu chuyển động đã thấy với cấu trúc phòng đã kiểm tra.') }
    } },
    { game: 'vale-dossiers-part3-v01', path: ['p3c3_open', 13], kind: 'caseboard', fields: {
      prompt: T('How should we interpret Moss’s silence during the night?', 'Hiểu việc Moss im lặng trong đêm thế nào?'),
      nudge: T('Ask what the witness could hear and what that can reasonably exclude. Avoid naming someone from silence alone.', 'Xét điều nhân chứng nghe được và điều có thể loại trừ từ đó. Đừng chỉ từ sự im lặng mà nêu tên một người.'),
      review: { text: T('This pair does not establish what the silence means. A dispute or the supper does not show how Moss usually reacts to visitors.', 'Cặp này chưa xác lập ý nghĩa của sự im lặng. Tranh cãi hay bữa tối không cho biết Moss thường phản ứng với khách ra sao.') }
    } },
    { game: 'vale-dossiers-part3-v01', path: ['p3c4_open', 22], kind: 'caseboard', fields: {
      prompt: T('Separate financial pressure from evidence of a plan.', 'Tách sức ép tài chính khỏi dấu hiệu của một kế hoạch.'),
      nudge: T('Keep financial strain, a possible means and evidence of an act separate. Seek independent support for each link.', 'Tách khó khăn tiền bạc, phương tiện có thể dùng và bằng chứng hành vi. Tìm nguồn độc lập củng cố từng liên hệ.'),
      review: { text: T('Financial pressure alone does not establish an act. A possible use of a tool still needs support from an independent observation.', 'Sức ép tiền bạc chưa xác lập hành vi. Công dụng có thể có của dụng cụ vẫn cần một quan sát độc lập củng cố.') }
    } }
  ];
  const presentations = [
    { game: 'vale-dossiers-p1c1-v01', path: ['c5_desk', 5], focus: T('Does this record contradict the exact sentence, or only concern the same journey?', 'Hồ sơ bác bỏ chính câu này, hay chỉ cùng liên quan chuyến đi?'), segs: [
      T('Does the record contradict Vale having seen the joint photograph?', 'Hồ sơ có bác việc Vale đã thấy bức ảnh chụp chung không?'),
      T('Separate knowing Vale’s name from knowing the passer-by’s identity. What was actually said?', 'Tách việc biết tên Vale khỏi biết danh tính người đi đường. Câu nào đã thực sự được nói?'),
      T('Does this record reliably name the passer-by, or only describe an appearance?', 'Hồ sơ xác định đáng tin cậy người đi đường, hay chỉ mô tả dáng vẻ?')
    ] },
    { game: 'vale-dossiers-part3-v01', path: ['p3c3_open', 25], focus: T('Which part of the sentence goes beyond what the source actually establishes?', 'Phần nào của câu vượt quá điều nguồn tin thực sự xác lập?'), segs: [
      T('Does this record confirm where the horse is now?', 'Hồ sơ này có xác nhận hiện ngựa ở đâu không?'),
      T('Does the record establish why Larkin lost awareness, and whether he chose it?', 'Hồ sơ xác lập vì sao Larkin mất tỉnh táo, và anh có chủ ý làm vậy không?'),
      T('Does the record actually contradict the direction of the observed tracks?', 'Hồ sơ có thực sự bác hướng đi của dấu vết đã quan sát không?')
    ] }
  ];
  function install() {
    const S = E.S();
    for (const row of rows) if (row.game === S?.id) {
      const step = row.path.reduce((v, k) => v?.[k], S.nodes), mechanic = step?.[row.kind];
      if (mechanic?.q) Object.assign(mechanic, row.fields);
    }
    for (const row of presentations) if (row.game === S?.id) {
      const P = row.path.reduce((v, k) => v?.[k], S.nodes)?.present;
      if (!P || P.segs?.length !== row.segs.length) continue;
      P.focus = row.focus;
      P.segs.forEach((g, i) => { g.focus = row.segs[i]; });
    }
  }
  E.on('boot', install);
  E.on('chapter', install);
  globalThis.ValeReasoningV093 = Object.freeze({ anchors: rows.map(({ game, path, kind }) => ({ game, path, kind })), presentations: presentations.map(({ game, path }) => ({ game, path })) });
})();
/* A compact right-hand dropdown reuses the engine's real controls. */
(() => {
 'use strict';
 const E=StoryEngine,V=ValeDemo;
 E.on('boot',()=>{
  const root=document.querySelector('.se'),top=root?.querySelector('.se-top'),group=top?.querySelector('.se-grp'),settings=top?.querySelector('[data-a="menu"]');
  if(!root||!top||!group||!settings||top.querySelector('[data-quick-toggle]'))return;
  root.classList.add('v93-toolbar');
  group.classList.add('v93-quick-menu');group.dataset.quickMenu='';group.id='vale-quick-menu';group.hidden=true;
  group.setAttribute('role','group');group.setAttribute('aria-label',E.nat({en:'Game menu',vi:'Menu trò chơi'}));
  const labels={book:{en:'Casebook',vi:'Hồ sơ'},log:{en:'Dialogue history',vi:'Lịch sử thoại'},trall:{en:'Translation',vi:'Bản dịch'},flow:{en:'Your route',vi:'Tuyến đã chơi'},menu:{en:'Settings',vi:'Cài đặt'}};
  const buttons={};for(const button of [...top.querySelectorAll('[data-a]')]){
   const key=button.dataset.a;if(!labels[key])continue;buttons[key]=button;
   button.type='button';button.setAttribute('aria-label',E.nat(labels[key]));button.title=E.nat(labels[key]);
   const span=document.createElement('span');span.className='v93-tool-label';span.textContent=E.nat(labels[key]);button.append(span);
  }
  for(const key of ['book','log','trall','flow','menu'])if(buttons[key])group.append(buttons[key]);
  const toggle=document.createElement('button');toggle.type='button';toggle.className='v93-quick-toggle';toggle.dataset.quickToggle='';toggle.setAttribute('aria-controls',group.id);toggle.setAttribute('aria-expanded','false');toggle.setAttribute('aria-label',E.nat({en:'Open game menu',vi:'Mở menu trò chơi'}));toggle.title=toggle.getAttribute('aria-label');toggle.innerHTML=E.ICON.menu+'<i class="v93-menu-dot" hidden></i>';toggle.querySelector('svg')?.setAttribute('aria-hidden','true');
  top.append(toggle);
  const shield=document.createElement('div');shield.className='v93-menu-shield';shield.hidden=true;shield.setAttribute('aria-hidden','true');root.append(shield);
  let opened=false;
  const setOpen=(value,focus=false)=>{
   const next=!!value;if(next===opened)return;opened=next;group.hidden=!opened;shield.hidden=!opened;root.classList.toggle('v93-menu-open',opened);
   toggle.setAttribute('aria-expanded',String(opened));toggle.setAttribute('aria-label',E.nat(opened?{en:'Close game menu',vi:'Đóng menu trò chơi'}:{en:'Open game menu',vi:'Mở menu trò chơi'}));toggle.title=toggle.getAttribute('aria-label');
   if(opened){E.hush();buttons.trall?.setAttribute('aria-pressed',String(!!E.G().set.tr));if(focus)group.querySelector('button')?.focus({preventScroll:true});}
   else if(focus)toggle.focus({preventScroll:true});
   E.emit('quick-menu',opened);
  };
  V.closeQuickMenu=()=>setOpen(false);
  const leave=document.createElement('button');leave.type='button';leave.dataset.quickExit='';
  const leaveLabel=E.nat({en:'Exit to overview',vi:'Thoát về tổng quan'});leave.setAttribute('aria-label',leaveLabel);leave.title=leaveLabel;
  leave.innerHTML='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5H4v14h5M13 7l5 5-5 5M8 12h12"/></svg><span class="v93-tool-label">'+E.esc(leaveLabel)+'</span>';
  leave.onclick=e=>{e.preventDefault();e.stopPropagation();setOpen(false);V.dismissObjective?.();V.home();};group.append(leave);
  toggle.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();E.sfx('tap');setOpen(!opened,e.detail===0);});
  shield.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();setOpen(false,true);});
  // Close before the native delegated handler opens the real sheet or changes
  // translation. The original data-a buttons and their state stay intact.
  group.addEventListener('click',e=>{if(e.target.closest('[data-a]'))setOpen(false);});
  root.addEventListener('keydown',e=>{
   if(!opened)return;
   if(e.key==='Escape'){e.preventDefault();e.stopPropagation();setOpen(false,true);return;}
   if(!['ArrowDown','ArrowUp','Home','End'].includes(e.key))return;
   const all=[...group.querySelectorAll('button')].filter(b=>!b.disabled),i=all.indexOf(document.activeElement);
   e.preventDefault();const next=e.key==='Home'?0:e.key==='End'?all.length-1:e.key==='ArrowDown'?(i+1+all.length)%all.length:(i-1+all.length)%all.length;all[next]?.focus({preventScroll:true});
  });
  // On touch, blur can temporarily leave BODY active before click dispatch.
  // Hiding the touched control at that point retargets its click to the scene.
  // Close on an explicit keyboard focus transfer; pointer dismissal belongs
  // to the shield's completed click above.
  let tabTransfer=false;
  top.addEventListener('keydown',e=>{if(e.key==='Tab')tabTransfer=true;});
  top.addEventListener('pointerdown',()=>{tabTransfer=false;},true);
  top.addEventListener('focusout',e=>{
   if(tabTransfer&&e.relatedTarget&&!top.contains(e.relatedTarget))setOpen(false);
   tabTransfer=false;
  });
  const sourceDot=buttons.book?.querySelector('.se-dot'),menuDot=toggle.querySelector('.v93-menu-dot');
  const dot=()=>{if(menuDot&&sourceDot)menuDot.hidden=sourceDot.hidden;};if(sourceDot)new MutationObserver(dot).observe(sourceDot,{attributes:true,attributeFilter:['hidden']});dot();
  E.on('step',()=>setOpen(false));E.on('end',()=>setOpen(false));
  const reset=E.ui.reset;E.ui.reset=(...args)=>{setOpen(false);return reset(...args);};
 });
})();
/* Vale 0.9.4 · later-scene actions that stay with the cast.
 * Additive presentation metadata: no prose, array positions, choices, items,
 * conditions or authorial knowledge changes. Existing motions keep ownership.
 *
 * These cues use native actor faces/poses. They do not cut to an invented
 * close-up, move a standing cutout to pretend that a hand performs an action,
 * or add a second Reed. Native motion owns finish/replay/resume endpoints.
 * Direction maps the full Reed pose assets onto one stable floor baseline.
 */
(() => {
  'use strict';
  const E = StoryEngine, V = ValeDemo;
  const enabled = () => /^vale-dossiers(?:-|$)/.test(E.S()?.id || '');
  const at = (S, node, path) => path.reduce((v, k) => v?.[k], S.nodes?.[node]);
  const added = new Map();
  const normalized = new Map();
  const genericOwners = {
    'c2_call.6': 'vale08-c2_call-6',
    'p3c3_open.18': 'vale08-p3c3_open-18',
    'p3c4_open.30': 'vale08-p3c4_open-30'
  };
  const oldNotebookProps = ['p1-v091-reed-notebook', 'v091-reed-action23'];
  const poseFaces = { 'reed-full': 'full', 'reed-writing-v091': 'writing-v091',
    'reed-offer-notebook-v091': 'offer-notebook-v091' };

  function clean(ids) {
    const R = E.R();
    for (const id of ids || []) {
      if (!oldNotebookProps.includes(id) && !['moss', 'v094-ben-moss-collar'].includes(id)) continue;
      if (R.props) delete R.props[id];
      for (const el of document.querySelectorAll('.prp')) if (el.dataset.p === id) el.remove();
    }
  }
  E.side('valeActions094', async value => { if (enabled() && value) clean(value.remove); });

  function cue(S, node, path, motion) {
    const st = at(S, node, path);
    if (!st?.n) return;
    // Other authoring overlays run twice, including after lazy chapter loads.
    // Never overwrite an action owned by an earlier release or another cue.
    const owner = genericOwners[[node, ...path].join('.')];
    if (st.motion && st.motion.id !== motion.id) {
      if (st.motion.id !== owner) return;
      motion = { ...motion, id: owner };
      normalized.set(owner, { node, path: [...path], id: owner, kind: 'generic-to-authored' });
    }
    st.motion = motion;
    if (motion.id === owner) normalized.set(owner, { node, path: [...path], id: owner, kind: 'generic-to-authored' });
    else added.set(motion.id, { node, path: [...path], id: motion.id });
  }
  function directory(S, talk, path, id) {
    const st = path.reduce((v, k) => v?.[k], S.talks?.[talk]);
    if (!st?.n || st.motion && st.motion.id !== id) return;
    st.motion = { id, ms: 2300, actors: [{ id: 'reed', show: true, frames: [
      { offset: 0, face: 'directory-read-v094' },
      { offset: .64, face: 'directory-read-v094' },
      { offset: .82, face: 'directory-check-v094' },
      { offset: 1, face: 'directory-check-v094' }
    ] }] };
    added.set(id, { root: 'talks', node: talk, path: [...path], id });
  }

  function nativeNotebook(S, node, path) {
    const st = at(S, node, path), M = st?.motion;
    if (!M?.id || !M.id.includes('v091')) return;
    const track = M.tracks?.find(t => oldNotebookProps.includes(t.id));
    if (!track) return; // Already normalized, or another action owns this step.
    let art = track.art;
    const frames = [];
    for (const f of track.frames || []) {
      art = f.art || art;
      if (!poseFaces[art]) return;
      frames.push({ offset: f.offset, face: poseFaces[art] });
    }
    if (!frames.length) return;
    const next = { ...M, actors: [...(M.actors || []).filter(a => a.id !== 'reed'),
      { id: 'reed', show: true, frames }] };
    delete next.tracks;
    // The writing occurs in the current authored room. Return to that room
    // without recentering Reed in a shot, then re-entering her native slot.
    Object.defineProperty(st, 'shot', { configurable: true, enumerable: true, writable: true, value: null });
    st.look = null; st.actionFrame = null; st.motion = next;
    st.valeActions094 = { ...st.valeActions094,
      remove: [...new Set([...(st.valeActions094?.remove || []), ...oldNotebookProps])] };
    normalized.set(M.id, { node, path: [...path], id: M.id });
  }
  const reaction = (id, who, face, ms = 1250) => ({
    id, ms,
    actors: [{ id: who, show: true, frames: [
      { offset: 0 }, { offset: .64, face }, { offset: 1, face }
    ] }]
  });

  function install() {
    if (!enabled()) return;
    const S = E.S();
    if (['vale-dossiers-p1c1-v01', 'vale-dossiers-chapter1-demo03'].includes(S.id)) {
      // A brief smile is explicitly narrated. Keep the same feet and coat;
      // only the compatible original full-body expression changes.
      cue(S, 'c2_call', [6], {
        id: 'p1-v094-celia-brief-smile', ms: 1500,
        actors: [{ id: 'celia', show: true, frames: [
          { offset: 0 }, { offset: .18, face: 'smiling' },
          { offset: .66, face: 'smiling' }, { offset: 1, face: '' }
        ] }]
      });
      // Her smile is gone when she considers the named client. This supports
      // the existing resolute answer; it does not fake her glove or eye rig.
      cue(S, 'c2_call', [7, 'choice', 0, 'then', 2],
        reaction('p1-v094-celia-considers-client', 'celia', 'resolute', 1400));
      directory(S, 'c2_bell', ['topics', 0, 'then', 2], 'p1-v094-directory-bell-checked');
      directory(S, 'c2_finn', ['topics', 0, 'then', 1], 'p1-v094-directory-finn-checked');
      for (const [node, path] of [
        ['c1_terms', [9]],
        ['c5_open', [13, 'choice', 2, 'then', 1]],
        ['c5_desk', [5, 'present', 'segs', 1, 'ok', 1]],
        ['c5_plan', [2, 'choice', 0, 'then', 2]],
        ['c5_plan', [2, 'choice', 2, 'then', 3]],
        ['c6_truth', [0, 'then', 1]], ['c6_truth', [3]],
        ['c6_delivery', [2, 'choice', 0, 'then', 2]],
        ['c6_visit', [0, 'then', 1]]
      ]) nativeNotebook(S, node, path);
    }
    if (S.id === 'vale-dossiers-part2-v01') {
      cue(S, 'p2c3_open', [33],
        reaction('p2-v094-lydia-recovers-after-crash', 'lydia', 'calm', 1700));
      for (const branch of ['then', 'else']) {
        cue(S, 'p2c5_withdraw', [2, branch, 0],
          reaction('p2-v094-lydia-ready-to-leave-' + branch, 'lydia', 'resolute', 1500));
      }
      // Start with the dated record already open. She puts it away once;
      // resume and reduced motion keep the closed endpoint, never an extra
      // opening/closing cycle after the line has settled.
      cue(S, 'p2c5_close', [2, 'else', 0], {
        id: 'p2-v094-night-record-dated-and-put-away', ms: 2400,
        sounds: [{ at: .12, cue: 'pen_write' }, { at: .78, cue: 'paper_fold' }],
        actors: [{ id: 'reed', show: true, frames: [
          { offset: 0, face: 'writing-v091' },
          { offset: .64, face: 'writing-v091' },
          { offset: .82, face: 'full' }, { offset: 1, face: 'full' }
        ] }]
      });
      // An open blank record supports the unfilled reply. Do not invent a
      // response, write new words, or show a letter that has not arrived.
      cue(S, 'p2c6_safe', [7], {
        id: 'p2-v094-room-left-for-reply', ms: 1300,
        actors: [{ id: 'reed', show: true, frames: [
          { offset: 0, face: 'full' },
          { offset: .34, face: 'offer-notebook-v091' },
          { offset: 1, face: 'offer-notebook-v091' }
        ] }]
      });
      for (const [node, path] of [
        ['p2c4_open', [12, 'explore', 'spots', 1, 'then', 2]],
        ['p2c4_open', [33, 'choice', 1, 'then', 1]],
        ['p2c5_observe', [9]], ['p2c6_overreach', [4]]
      ]) nativeNotebook(S, node, path);
    }
    if (S.id === 'vale-dossiers-part3-v01') {
      // Let the original concerned expression arrive during the silent
      // reading, before her next line. No repeated entrance or camera zoom.
      cue(S, 'p3c4_open', [30],
        reaction('p3-v094-elin-reads-in-silence', 'elin', 'concerned', 1800));
      const collar = at(S, 'p3c3_open', [18]);
      cue(S, 'p3c3_open', [18], {
        id: 'p3-v094-ben-straightens-moss-collar', ms: 2400, peek: true,
        actors: [{ id: 'ben', hide: true }],
        tracks: [{ id: 'v094-ben-moss-collar', art: 'p3_ben_moss_collar_v094',
          at: [56.4, 50.6], w: 49, ar: 1.5, z: 4,
          frames: [{ offset: 0 }, { offset: .48 },
            { offset: .76, art: 'p3_ben_moss_collar_done_v094' },
            { offset: 1, art: 'p3_ben_moss_collar_done_v094' }] }]
      });
      if (['p3-v094-ben-straightens-moss-collar', 'vale08-p3c3_open-18'].includes(collar?.motion?.id)) {
        // The full composite owns both silhouettes. A deliberate action
        // composition keeps the dog and the actual hand/collar contact above
        // the reader; a background-sized prop behind native Reed hid them.
        collar.shot = 'p3_yard_morning_open'; collar.look = null;
        collar.actionFrame = { focus: [31, 39, 51, 24], context: [22, 33, 68, 34], zoom: 1.55 };
        collar.valePresence = { ...collar.valePresence,
          show: (collar.valePresence?.show || []).filter(a => a.id !== 'ben'),
          hide: [...new Set([...(collar.valePresence?.hide || []), 'ben'])] };
        collar.valeActions094 = { ...collar.valeActions094, remove: ['moss'] };
      }
      for (const [node, path] of [
        ['p3c1_open', [24]], ['p3c2_open', [10]], ['p3c2_open', [31]],
        ['p3c4_open', [8, 'explore', 'spots', 1, 'then', 1]],
        ['p3c5_supported', [0, 'then', 1]]
      ]) nativeNotebook(S, node, path);
    }
  }

  E.on('boot', () => { install(); queueMicrotask(install); });
  E.on('chapter', () => { install(); queueMicrotask(install); });
  V.v094Actions = () => ({ enabled: enabled(), cues: [...added.values()], normalized: [...normalized.values()] });
})();
/* Vale 0.9.5 · held objects and later hand actions.
 * Original text, branches, grants, step paths and existing motion IDs stay
 * intact. Native actor poses share their original floor and conversation
 * frame. These are two-pose cues, not simulated hand actions made by sliding
 * an entire cutout. The derived art is registered statically before boot.
 */
(() => {
  'use strict';
  const E = StoryEngine, V = ValeDemo;
  const enabled = () => /^vale-dossiers(?:-|$)/.test(E.S()?.id || '');
  const at = (S, root, node, path) => path.reduce((v, k) => v?.[k], S[root]?.[node]);
  const added = new Map(), refined = new Map();
  const textIs = (st, text) => st?.n?.en === text;

  function heldArt(st, who, art) {
    if (!st) return;
    // Direction profiles are shared by neighboring steps. Clone before
    // overriding a held object, otherwise it leaks into another scene.
    const direction = st.valeDirection;
    if (direction) st.valeDirection = { ...direction, fullArt: { ...direction.fullArt, [who]: art } };
    st.valeActionReading = true;
  }
  function cue(S, root, node, path, text, motion, owner = null) {
    const st = at(S, root, node, path);
    if (!textIs(st, text)) return null;
    // A missing owner can be normal before the later layout hook runs. The
    // queued install will see it. Never take over an unknown authored cue.
    if (owner ? st.motion?.id !== owner : st.motion && st.motion.id !== motion.id) return null;
    st.motion = motion;
    st.valeActionReading = true;
    (owner ? refined : added).set(motion.id, { root, node, path: [...path], id: motion.id });
    return st;
  }
  function walkLines(value, fn) {
    if (!value || typeof value !== 'object') return;
    if (value.n || value.say || value.think || value.choice) fn(value);
    for (const [key, child] of Object.entries(value)) {
      if (['motion', 'valeDirection', 'valePresence'].includes(key)) continue;
      if (child && typeof child === 'object') walkLines(child, fn);
    }
  }

  function install() {
    if (!enabled()) return;
    const S = E.S();
    if (S.id === 'vale-dossiers-part2-v01') {
      const night = cue(S, 'nodes', 'p2c5_close', [2, 'else', 0],
        'Reed dates each page and puts it away, leaving the missing observation blank. Tomorrow, you must decide what the file can honestly say.', {
          id: 'p2-v094-night-record-dated-and-put-away', ms: 2400,
          sounds: [{ at: .12, cue: 'pen_write' }],
          actors: [{ id: 'reed', show: true, frames: [
            { offset: 0, face: 'writing-v091' },
            { offset: .64, face: 'writing-v091' },
            { offset: .82, face: 'offer-notebook-v091' },
            { offset: 1, face: 'offer-notebook-v091' }
          ] }]
        }, 'p2-v094-night-record-dated-and-put-away');
      heldArt(night, 'reed', 'reed-offer-notebook-v091');
      const check = at(S, 'nodes', 'p2c5_close', [3]);
      if (night && textIs(check, 'Before closing the notebook, you check on everyone. Lydia is safe, Ruth beside her. You call Reed; she answers. For tonight, that matters as much as the evidence.')) {
        // The wording does not specify a bag or establish whose notebook the
        // next sentence refers to. Retain the visible open-record endpoint;
        // do not invent a stow, add a fold sound, or close it before this line.
        heldArt(check, 'reed', 'reed-offer-notebook-v091');
      }
    }
    if (S.id !== 'vale-dossiers-part3-v01') return;
    for (const [who, anchors] of Object.entries({
      nora: { 'nora-brush-contact-v095': 1502, 'nora-brush-paused-v095': 1505 },
      ben: { 'ben-report-open-v095': 1466, 'ben-report-folded-v095': 1466 }
    })) if (S.chars[who]) S.chars[who].bodyFeet = { ...S.chars[who].bodyFeet, ...anchors };

    const hello = cue(S, 'talks', 'p3c3_nora', ['hello', 0],
      'Nora is brushing dried mud from her bag. She stops when you ask about Sunday night, but leaves the brush in her hand.', {
        id: 'p3-v095-nora-brush-pause', ms: 2300,
        actors: [{ id: 'nora', show: true, frames: [
          { offset: 0, face: 'brush-contact-v095' },
          { offset: .52, face: 'brush-contact-v095' },
          { offset: .74, face: 'brush-paused-v095' },
          { offset: 1, face: 'brush-paused-v095' }
        ] }]
      });
    if (hello) {
      const talk = S.talks.p3c3_nora;
      for (const value of [talk.hello, talk.topics]) walkLines(value, st => {
        heldArt(st, 'nora', 'nora-brush-paused-v095');
        // The old concerned portrait has no brush. Keep the hand/object state
        // through the actual conversation instead of swapping it away.
        if (st.say === 'nora') st.face = 'brush-paused-v095';
      });
      const bye = talk.bye?.[0];
      if (textIs(bye, 'She puts the brush away. Its little cloud of dust hangs in the light after her hand has stopped.')) {
        heldArt(bye, 'nora', 'nora-full');
        bye.valePresence = { ...bye.valePresence, show: [
          ...(bye.valePresence?.show || []).filter(a => a.id !== 'nora'),
          { id: 'nora', face: '' }
        ] };
        // This is the correct brush-free endpoint. No claim is made that the
        // two brush poses animate a full stow or the lingering dust cloud.
      }
    }

    const receive = cue(S, 'nodes', 'p3c3_open', [30],
      'Outside, Ben is cleaning the unused bridle. You hand him the corrected copy. He reads the sentence about the supper twice, lips moving on the second reading.', {
        id: 'p3-v06-corrected-report', ms: 1500,
        actors: [{ id: 'elin', hide: true }, { id: 'reed', hide: true },
          { id: 'ben', show: true, at: 'c', frames: [
            { offset: 0, face: 'report-open-v095' },
            { offset: 1, face: 'report-open-v095' }
          ] }]
      }, 'p3-v06-corrected-report');
    if (receive) {
      // The existing layout owns the explicit return outside. Keep its scene
      // and cast transition; do not introduce a shot or a second camera move.
      for (const index of [30, 31, 32]) heldArt(at(S, 'nodes', 'p3c3_open', [index]), 'ben', 'ben-report-open-v095');
      const ask = at(S, 'nodes', 'p3c3_open', [31]);
      if (ask?.say === 'ben') ask.face = 'report-open-v095';
    }
    const fold = cue(S, 'nodes', 'p3c3_open', [33],
      'Ben folds the paper, careful not to get grease on it. Behind him, the stall is still empty. One false accusation has gone.', {
        id: 'vale08-p3c3_open-33', ms: 2200,
        sounds: [{ at: .64, cue: 'paper_fold' }],
        actors: [{ id: 'ben', show: true, frames: [
          { offset: 0, face: 'report-open-v095' },
          { offset: .5, face: 'report-open-v095' },
          { offset: .76, face: 'report-folded-v095' },
          { offset: 1, face: 'report-folded-v095' }
        ] }]
      }, 'vale08-p3c3_open-33');
    heldArt(fold, 'ben', 'ben-report-folded-v095');
  }

  // Some part layouts are registered after the common plugins. The queued
  // pass therefore applies to the final composed data, including lazy loads.
  E.on('boot', () => { install(); queueMicrotask(install); });
  E.on('chapter', () => { install(); queueMicrotask(install); });
  V.v095Actions = () => ({ enabled: enabled(), cues: [...added.values()], refined: [...refined.values()] });
})();
/* Vale 0.9.4 · authored choice semantics.
 * All 90 options across 39 choice containers are explicitly classified.
 * True means the printed sentence is the protagonist's actual dialogue.
 * False means an action, a topic/route decision, or writing a note; its
 * continuation contains any actual dialogue. Labels below are identity guards,
 * never replacement prose. Existing arrays, branches and save paths stay put.
 */
(() => {
  'use strict';
  const E = StoryEngine, V = ValeDemo;
  const authored = [
    ["nodes.c1_arrival.9.choice", [
      [true, "What can I call you for the next ten minutes?"],
