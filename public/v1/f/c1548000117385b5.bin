    if (active && q('.se')?.dataset.v097Frame === 'medium') E.ui.actionPeek?.(false);
  });
  E.on('visual-transition-prepared', clearGeometry);
  E.on('end', clearGeometry);
  const reset = E.ui.reset;
  E.ui.reset = (...args) => { clearGeometry(); return reset(...args); };
