        face(S, ['talks', 'p2c1_lydia', 'hello', 0], hello.en, 'full');
      for (const [index, topic] of (talk.topics || []).entries())
        if (['night', 'words', 'today', 'sister'].includes(topic.id))
          for (const [lineIndex, line] of (topic.then || []).entries()) {
