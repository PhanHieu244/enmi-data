      blocking(S, 'p2c4_open', [28], 'p2_corridor', 'p2-v091-hale-joins-sketch',
        [{ who: 'owen', from: [8, 54], to: [50, 54] }]);
      returnFromAction(S, 'p2c4_open', [29]);
