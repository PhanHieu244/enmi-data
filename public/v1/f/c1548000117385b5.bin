          const compatible = [...art.classList].some(c => c.startsWith('im-') && reedBodies.has(c.slice(3)));
          art.classList.toggle('v094-incompatible', !compatible && [...art.classList].some(c => c.startsWith('im-reed')));
        }
        if (wide) {
