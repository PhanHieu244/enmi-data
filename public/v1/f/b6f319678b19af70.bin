      cue.key = E.ui.bgKey(); cue.img = E.curImg();
      // Matching frames retain camera context. The image is changed by the
      // native two-buffer shot renderer, never by an opaque foreground prop.
      // chỉ giữ góc quay nếu ảnh mới CÓ vùng đó (ảnh cận → ảnh toàn cảnh thì thôi: shot() đã đưa camera về toàn cảnh, gọi look sẽ chỉ báo thiếu vùng)
      if(composition){setActionFrame(composition);R.look=cue.look;cue.actionFrame={...R.actionFrame};}else E.ui.look(cue.look && E.regionOf(E.curImg(), cue.look) ? cue.look : null, 0, true);
    };
    const setFace = (a, frame) => { const el = actorEl(a.id); if (R.cast?.[a.id] && el && (el.dataset.face !== (frame.face || "") || el.dataset.at !== frame.at)) E.ui.show(a.id, frame.at, frame.face || ""); };
    const clearAnimation = () => {
      cancelAnimationFrame(cue.raf); cue.raf = 0;
      for (const an of cue.anims) an.cancel(); cue.anims = [];
      for (const t of tracks) t.el?.querySelectorAll(".prp-frame-out").forEach(el => { el.getAnimations().forEach(a => a.cancel()); el.remove(); });
    };
    const positionControl = () => {
      const rt = root(), button = cue.button; if (!rt || !button) return;
      const bounds = rt.getBoundingClientRect(), top = $(".se-top"), box = $(".se-box");
      let y = top && !top.hidden ? top.getBoundingClientRect().bottom - bounds.top + 8 : 12;
      // Native games may keep Profile beneath the header. It is an essential
      // control, so the action affordance must sit below its actual rectangle.
      // Plugins can reserve a top-stage area (context/mission bars, profiles)
      // without coupling the engine to a particular game's CSS class.
      for (const el of $$(E.S()?.stableActionFraming?'[data-stage-obstruction="top"]':hudSelector)) if (shown(el)) y = Math.max(y, el.getBoundingClientRect().bottom - bounds.top + 8);
      const lane = $(".se-lane"), visibleNotice = lane && [...lane.children].some(n => n.textContent && getComputedStyle(n).opacity !== "0");
      if (visibleNotice && !E.S()?.stableActionFraming) y = Math.max(y, lane.getBoundingClientRect().bottom - bounds.top + 8);
      const br=shown(box)?box.getBoundingClientRect():null,stageBounds=$('.se-stage')?.getBoundingClientRect()||bounds;
      // Native actor actions can share the narrow stage beside a landscape
      // reader without using actionFrame. Place every control in that actual
      // stage, and measure its intended 44px hit area even while hidden.
      // Measuring a hidden button returned zero and toggled overlap each pass.
      let right=Math.min(bounds.right,stageBounds.right)-12;
      if(br&&br.left>stageBounds.left+68&&br.right>right-44&&br.top<bounds.top+y+44&&br.bottom>bounds.top+y)right=Math.min(right,br.left-12);
      const left=Math.max(bounds.left+12,stageBounds.left+12,right-44),hit={left,right:left+44};
      button.style.left=(left-bounds.left)+'px';button.style.right='auto';
      const ceiling = br&&hit.right>br.left&&hit.left<br.right ? br.top - bounds.top - 8 : Math.min(bounds.bottom,stageBounds.bottom)-bounds.top-12;
      button.hidden = reducedMotion() || stageBounds.width<68 || y + 44 > ceiling;
      button.style.top = y + "px";
    };
    cue.positionControl = positionControl;
    const updateControl = () => {
      if (E.auto || !cue.button) return;
      syncMotionPreference();
      const replay = !cue.running, label = T(replay ? "Replay action" : "Finish action", replay ? "Xem lại hành động" : "Xem hết hành động");
      cue.button.dataset.motionMode = replay ? "replay" : "skip";
      cue.button.setAttribute("aria-label", label); cue.button.title = label; cue.button.innerHTML = motionIcon(replay);
      positionControl();
    };
    const stopCueSounds = () => { for (const handle of cue.soundHandles) handle?.stop?.(0.04); cue.soundHandles = []; };
    cue.finish = (completed = false) => {
      if (cue.disposed) return;
      if (!completed) stopCueSounds();
      const same = E.R() === R && E.ui.bgKey() === cue.key;
      cue.running = false; clearAnimation();
      if (same) {
        if (backdrop) {
          swapBackdrop(backdrop.final);
          const finalKey = cue.key;
          Promise.resolve(E.ui.layerReady?.()).then(() => {
            if (E.R() !== R || E.ui.bgKey() !== finalKey) return;
            for (const id in R.props || {}) if (R.props[id].img === E.curImg()) renderProp(id, R.props[id]);
          });
        }
        const layer = $(".se-bgl.on");
        for (const t of tracks) { if (t.remove) { t.el?.remove(); propEl(layer, t.id)?.remove(); delete (R.props || {})[t.id]; } else { (R.props ||= {})[t.id] = { ...t.final }; t.el = renderProp(t.id, t.final, layer, img); } }
        for (const a of actors) setFace(a, a.final);
      }
      updateControl(); resolve();
    };
    cue.dispose = () => {
      if (cue.disposed) return;
      cue.finish(); cue.disposed = true; cue.observer?.disconnect(); cue.button?.remove();
      if (motionCurrent === cue) motionCurrent = null;
      syncScenePeek();
    };
    ctx.onExit?.(cue.dispose);
    (R.used ||= {})[markKey] = { final: true, img, backdropFinal: backdrop?.final.art, props: Object.fromEntries(tracks.map(t => [t.id, t.initial])), actors: Object.fromEntries(actors.map(a => [a.id, a.initial])) };
    // Save the endpoint with a resumable step marker before any asynchronous
    // visual work. Loading the line again paints that endpoint once.
    motionProjection(R, { ...cue, actors: [], backdrop: null });
    ctx.resumeHere?.(true); E.save();
    await Promise.all([E.ui.layerReady?.(), preloadMotionArt([
      ...tracks.flatMap(t => t.frames.map(f => f.art)),
      ...actors.flatMap(a => a.frames.map(f => f.face ? a.id + "-" + f.face : a.id)),
      ...(backdrop?.frames.map(f => f.art) || []),
    ])]);
    if (!valid()) { cue.dispose(); return; }
    if (!E.auto) {
      cue.button = h('<button type="button" class="se-motion-control"></button>'); root().appendChild(cue.button);
      cue.button.onclick = event => { event.stopPropagation(); if (!valid()) return cue.dispose(); if (cue.running) cue.finish(); else cue.start(); };
      cue.observer = new ResizeObserver(positionControl);
      [root(), $(".se-stage"), $(".se-top"), $(".se-box"), $(".se-lane"), ...$$('.lf-hud,[data-stage-obstruction="top"]')].filter(Boolean).forEach(el => cue.observer.observe(el));
    }
    const applyFrame = progress => {
      if (backdrop) {
        let index = 0; while (index + 1 < backdrop.frames.length && backdrop.frames[index + 1].offset <= progress) index++;
        if (index !== backdrop.frameIndex) { swapBackdrop(backdrop.frames[index]); backdrop.frameIndex = index; }
      }
      for (const t of tracks) {
        let index = 0; while (index + 1 < t.frames.length && t.frames[index + 1].offset <= progress) index++;
        if (index !== t.frameIndex) {
          const frame = t.frames[index]; propArt(t.el, frame.art, index > 0);
          t.el.style.aspectRatio = String(frame.ar); t.el.style.zIndex = String(frame.z);
          t.frameIndex = index;
        }
      }
      for (const a of actors) {
        let index = 0; while (index + 1 < a.frames.length && a.frames[index + 1].offset <= progress) index++;
        setFace(a, a.frames[index]); a.frameIndex = index;
      }
      // Physical cues follow the actual motion clock, including Replay. Skip,
      // reduced motion and a restored endpoint never play unheard past sounds.
      sounds.forEach((s, index) => {
        if (progress < s.at || cue.heard.has(index)) return;
        cue.heard.add(index); const handle = E.sfx(s.cue); if (handle) cue.soundHandles.push(handle);
        E.emit("motion-sound", { id: M.id || "cue", cue: s.cue, at: s.at, progress });
      });
    };
    cue.start = () => {
      if (!valid()) return cue.dispose();
      clearAnimation(); stopCueSounds(); cue.heard.clear(); cue.running = true; if (backdrop) backdrop.frameIndex = -1;
      const layer = $(".se-bgl.on");
      for (const t of tracks) {
        propAnimations.get(propEl(layer, t.id))?.();
        t.el = renderProp(t.id, t.frames[0], layer, img); t.frameIndex = -1;
      }
      if (reducedMotion() || !duration) { cue.finish(); return; }
      for (const t of tracks) cue.anims.push(t.el.animate(t.frames.map(f => ({ offset: f.offset, left: f.at[0] + "%", top: f.at[1] + "%", width: f.w + "%", transform: propTransform(f), opacity: f.opacity, easing: t.ease })), { duration, fill: "both" }));
      cue.startTime = performance.now(); applyFrame(0); updateControl();
      const tick = now => {
        if (!valid()) return cue.dispose();
        if (reducedMotion()) return cue.finish();
        const progress = Math.min(1, (now - cue.startTime) / duration);
        applyFrame(progress);
        if (progress >= 1) { cue.finish(true); E.save(); }
        else cue.raf = requestAnimationFrame(tick);
      };
      cue.raf = requestAnimationFrame(tick);
    };
    if (savedStart?.final && sameSavedImage) cue.finish(); else cue.start();
    if (standalone || M.wait) { E.autoRun?.(cue.finish); await promise; }
    ctx.resumeHere?.(false);
  }
  E.ui.finishMotion = () => { syncMotionPreference(); motionCurrent?.finish(); };
  E.ui.replayMotion = () => motionCurrent?.start?.();
  E.ui.motionState = () => motionCurrent ? { id: motionCurrent.ctx.st.motion?.id, running: motionCurrent.running, img: motionCurrent.img } : null;
  def("motion", c => playMotion(c.st.motion, c, true));
  E.side("motion",(m,st,c)=>c.type==="shot"&&st.actionFrame?undefined:playMotion(m,c));

  // ═════════ CHUYỂN ĐỘNG CHẬM khi chọn (Detroit) ═════════
  E.side("slow", async v => {
    if (!v || E.auto) return;
    const rt = root(); rt.classList.add("slowmo"); E.sfx("sting"); E.haptic("MEDIUM");
    let n = 0; const off = E.on("step", () => { if (++n > 1) { rt.classList.remove("slowmo"); off(); } });
  });

  // ═════════ VẬT PHẨM HIỆN RA ═════════
  // items.<mã>.sides = [{ t }, { art: "it-ring-in", t: { en, vi }, note, set, truth }] — mặt 0 = ảnh it-<mã>; lật lần đầu 1 mặt = áp set / ghi chú
  // items.<mã>.doc = { paper, hand, lines } → nút “Đọc”
  const sidesOf = id => { const it = E.S().items?.[id]; return it?.sides?.length ? it.sides : null; };
  const artOf = (id, k) => (k ? sidesOf(id)?.[k]?.art : E.S().items?.[id]?.recordArt) || "it-" + id;
  const bigArt = (id, k = 0) => { const it = E.S().items?.[id]; if (E.recordKind?.(id) === "inference") return E.inferenceArt("rv-a"); const a = artOf(id, k), real=E.artReal?.("im-"+a); if (!k && !real) return E.itemArt(id,"rv-a"); return `<span class="se-ia rv-a">${real?'':`<span class="ic">${E.ICON[it?.icon] || E.ICON.box}</span>`}<i class="im-${esc(a)}"></i></span>`; };
  const seeSide = (id, k) => {
    const R = E.R(), sd = sidesOf(id)?.[k]; if (!sd) return;
    const key = `side:${id}:${k}`; if (R.used[key]) return; R.used[key] = 1;
    E.apply(sd);
    if (sd.note) (R.jot ||= []).push({ ch: R.ch, t: sd.note });
    if (sd.truth && !E.G().truths[sd.truth]) { R.truths[sd.truth] = 1; E.G().truths[sd.truth] = Date.now(); E.ui.dot(true); E.ui.toast(`${E.ICON.bulb || ""}<span><small>${esc(T("Truth uncovered", "Sự thật mới"))}</small><b>${esc(nat(E.S().truths?.[sd.truth]?.name))}</b></span>`, 3000, "item"); }
    E.save();
  };
  // khung xem vật: dùng cho lúc nhận đồ (fresh) và khi mở từ túi / hồ sơ
  let cancelReveal = null;
  E.ui.cancelReveal = () => cancelReveal?.();
  E.ui.reveal = (id, o = {}) => new Promise(res => {
    const S = E.S(), it = S.items?.[id], rt = root(); if (!it || !rt) return res();
    cancelReveal?.();
    $(".se-rev", rt)?.remove();
    const sides = sidesOf(id), doc = it.doc || S.docs?.[id];
    const compact = S.recordPresentation === "compact", receipt = !!(o.fresh && o.receipt), run = E.R(), returnTo = document.activeElement;
    const timers = [], animations = [], readCleanup = [];
    let closed = false, busy = false, turning = false, reading = false;
    let k = 0;
    const v = h(`<div class="se-rev${o.fresh ? " fresh" : ""}${compact ? " compact-record" : ""}${receipt ? " receipt-notice" : ""}" role="dialog" aria-modal="true" aria-label="${esc(nat(it.name))}" tabindex="-1"><div class="rv-bg"></div><div class="rv-c">
      ${o.fresh ? `<small class="rv-k">${esc(E.recordKind?.(id)==="inference"?T("Conclusion recorded", "Đã ghi kết luận"):(it.recordType||it.kind)==="testimony"?T("Account recorded", "Đã ghi lời khai"):T("Added to records", "Đã thêm hồ sơ"))}</small>` : ""}
      <div class="rv-tools">${E.ui.readingToggle?.()||''}</div><div class="rv-st">${bigArt(id, 0)}</div>
      <b class="rv-n">${investigationText(it.name)}</b><div class="rv-copy"><p class="rv-d" tabindex="0">${investigationText(sides?.[0]?.t || it.desc)}</p>${compact ? `<small class="rv-scroll-hint" hidden>${esc(T("Scroll to read more ↓", "Cuộn để đọc tiếp ↓"))}</small>` : ""}</div>
      <div class="rv-b">${receipt ? `<button class="se-btn" data-receipt-open>${esc(T("View details", "Xem chi tiết"))}</button>` : ""}${sides ? `<button class="se-btn" data-turn>${E.ICON.flip || "↻"}<span>${esc(T("Turn over", "Lật lại"))}</span></button>` : ""}${doc ? `<button class="se-btn" data-read>${E.ICON.doc || ""}<span>${esc(T("Read", "Đọc"))}</span></button>` : ""}</div>
      <button class="rv-tap" type="button" aria-label="${esc(T("Close item and continue", "Đóng vật phẩm và tiếp tục"))}">${esc(o.fresh ? E.recordKind?.(id)==="inference" ? T("Continue", "Tiếp tục") : T("Tap to put it in your bag", "Chạm để cất vào túi") : T("Tap to close", "Chạm để đóng"))}</button></div></div>`);
    rt.appendChild(v);
    const receiptReading=E.ui.bindReading?.(v,{native:o.native});
    const live = () => !closed && v.isConnected && E.R() === run && (!o.context?.live || o.context.live());
    const settle = cancelled => {
      if (closed) return; closed = true;
      timers.forEach(clearTimeout); animations.forEach(a => a.cancel()); readCleanup.splice(0).forEach(fn => fn()); copyObserver?.disconnect();receiptReading?.dispose();
      v.remove(); if (cancelReveal === cancel) cancelReveal = null;
      if (!cancelled && returnTo?.isConnected) returnTo.focus?.({preventScroll:true});
      res();
    };
    const cancel = () => settle(true); cancelReveal = cancel;
    o.context?.onExit?.(cancel);
    const animate = (frames, options) => { const a = art.animate(frames, options); animations.push(a); return a; };
    const later = (fn, ms) => timers.push(setTimeout(() => { if (live()) fn(); else cancel(); }, ms));
    // bay ra từ chỗ vật nằm (vùng vừa chạm) → giữa màn
    const art = $(".rv-st", v);
    const description = $(".rv-d", v), scrollHint = $(".rv-scroll-hint", v);
    const syncCopy = () => { if (scrollHint && !closed) scrollHint.hidden = description.scrollHeight <= description.clientHeight + description.scrollTop + 3; };
    const copyObserver = compact && typeof ResizeObserver !== "undefined" ? new ResizeObserver(syncCopy) : null;
    copyObserver?.observe(description); description.onscroll = syncCopy;
    if (o.from && !E.auto && !compact && !reducedMotion()) { const b = art.getBoundingClientRect(), f = o.from; animate([{ transform: `translate(${f.x + f.w / 2 - (b.left + b.width / 2)}px,${f.y + f.h / 2 - (b.top + b.height / 2)}px) scale(${Math.max(.15, Math.min(1, f.w / b.width))})`, opacity: .4 }, { transform: "none", opacity: 1 }], { duration: 620, easing: "cubic-bezier(.2,.9,.25,1)" }); }
    if (o.fresh) { E.sfx("item"); E.haptic("LIGHT"); }
    const turn = async () => {
      if (!live() || busy || turning || !sides) return; turning = true;
      try {
        if (!reducedMotion() && !E.auto) await animate([{ transform: "rotateY(0)" }, { transform: "rotateY(90deg)" }], { duration: 140, easing: "ease-in" }).finished;
        if (!live()) return;
        k = (k + 1) % sides.length; seeSide(id, k);
        art.innerHTML = bigArt(id, k); $(".rv-d", v).innerHTML = investigationText(sides[k].t || it.desc);
        receiptReading?.refresh();description.scrollTop = 0; syncCopy();
        if (!reducedMotion() && !E.auto) await animate([{ transform: "rotateY(-90deg)" }, { transform: "rotateY(0)" }], { duration: 180, easing: "ease-out" }).finished;
        if (live()) E.sfx("page");
      } catch (e) { if (e.name !== "AbortError") console.warn("[story] item turn", e); }
      finally { turning = false; }
    };
    const close = () => {
      if (busy || !live()) return; busy = true;
      const exits = [];
      const bag = $(".se-top [data-a=book]", rt);
      if (o.fresh && bag && !E.auto && !compact && !reducedMotion()) {
        const a = art.getBoundingClientRect(), b = bag.getBoundingClientRect();
        exits.push(animate([{ transform: "none", opacity: 1 }, { transform: `translate(${b.left + b.width / 2 - (a.left + a.width / 2)}px,${b.top + b.height / 2 - (a.top + a.height / 2)}px) scale(.12)`, opacity: .2 }], { duration: 520, easing: "cubic-bezier(.5,0,.75,0)", fill: "forwards" }));
        later(() => { bag.classList.remove("got"); void bag.offsetWidth; bag.classList.add("got"); E.sfx("pick"); }, 480);
      }
      v.classList.add("out");
      if (E.auto || reducedMotion()) return settle(false);
      // The installed theme owns its actual exit duration. Await this view's
      // finite exit animations (plus its art flight), never a guessed160ms.
      // Removal happens before the item-step promise resolves and paints the
      // next dialogue/scene. Cancel/reset still settles immediately.
      void v.offsetWidth;
      exits.push(...(v.getAnimations?.() || []).filter(a => Number.isFinite(a.effect?.getComputedTiming().endTime)));
      Promise.allSettled([...new Set(exits)].map(a => a.finished)).then(() => { if (live()) settle(false); else cancel(); });
    };
    v.onclick = async e => {
      e.stopPropagation(); if (!live() || busy || reading) return;
      if (v.classList.contains('receipt-notice') && e.target.closest('[data-receipt-open],.rv-st,.rv-n,.rv-k')) {
        v.classList.remove('receipt-notice');
        v.querySelector('[data-receipt-open]')?.remove();
        receiptReading?.refresh(); syncCopy(); description.focus({preventScroll:true}); E.sfx('tap'); return;
      }
      if (e.target.closest("[data-turn]")) { e.stopPropagation(); return turn(); }
      if (e.target.closest("[data-read]")) { reading = true; v.hidden = true; await E.ui.read(id, { native:receiptReading?.native, live, onExit: fn => readCleanup.push(fn) }); reading = false; if (live()) { v.hidden = false; $("[data-read]", v)?.focus({preventScroll:true}); } return; }
      if (e.target.closest(".rv-tap") || (!o.fresh && e.target.closest(".rv-bg"))) close();
    };
    v.onkeydown = e => {
      if (e.key === "Escape") { e.preventDefault(); e.stopPropagation(); return close(); }
      if (e.key !== "Tab") return;
      const buttons = [...v.querySelectorAll("button,[tabindex='0']")].filter(b => !b.disabled && b.getClientRects().length), first = buttons[0], last = buttons.at(-1);
      if (e.shiftKey && (document.activeElement === first || document.activeElement === v)) { e.preventDefault(); last?.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first?.focus(); }
    };
    requestAnimationFrame(() => { if (live()) { syncCopy(); $(".rv-tap", v)?.focus({preventScroll:true}); } });
    // A request from the item detail belongs to this receipt. Never dispatch
    // a delayed click through the document: another item may have replaced it.
    if(o.turn)later(turn,0);
    if (E.auto) later(close, 5);
  });
  // nhận đồ: vật hiện ra (quiet = chỉ chấm đỏ ở túi). from: tên vùng trên ảnh đang hiện (vật bay ra từ đó)
  def("item", async c => {
    const { st } = c;
    const R = E.R(); if (R.items.includes(st.item)) return;
    R.items.push(st.item); E.save(); E.ui.dot(true); E.emit("item", st.item);
    if (st.quiet) return;
    const it=E.S().items?.[st.item];
    const receipt = !!(E.S().recordReceipts && E.recordKind?.(st.item)!=="inference" && (st.receipt === true || (it?.recordType||it?.kind)==="testimony"));
    let from = E._zoneRect || null;
    if (st.from) { const img = E.curImg(), r = E.regionOf(img, st.from); if (r) { const p = E.rectPx(img, r.box), sr = $(".se-stage").getBoundingClientRect(); from = { x: sr.left + p.x, y: sr.top + p.y, w: p.w, h: p.h }; } }
    E._zoneRect = null;
    E.ui.hideBox();
    await E.ui.reveal(st.item, { fresh: true, receipt, from, context:c });
  });
  // túi / hồ sơ: chạm 1 vật → khung xem có Lật / Đọc (thay khung cũ chỉ có ảnh + mô tả, giữ “Ghép với…”)
  const iv0 = E.ui.itemView;
  E.ui.itemView = id => {
    iv0(id);
    const it = E.S().items?.[id], v = $(".se-iv"); if (!v || !it) return;
    const doc = it.doc || E.S().docs?.[id];
    if (!sidesOf(id) && !doc) return;
    const row = h(`<div class="rv-b">${sidesOf(id) ? `<button class="se-btn" data-turn>${E.ICON.flip || "↻"}<span>${esc(T("Turn over", "Lật lại"))}</span></button>` : ""}${doc ? `<button class="se-btn" data-read>${E.ICON.doc || ""}<span>${esc(T("Read", "Đọc"))}</span></button>` : ""}</div>`);
    $(".se-ivc", v)?.insertBefore(row, $(".se-ivc > small", v));
    row.onclick = e => {
      e.stopPropagation();
      const native=v.dataset.readingLanguage==="native";
      if (e.target.closest("[data-read]")) return E.ui.read(id,{native});
      if (e.target.closest("[data-turn]")) { E.ui.releaseReading?.(v);v.remove(); E.ui.reveal(id,{turn:true,native}); }
    };
  };

  // ═════════ ĐỌC GIẤY TỜ (read) ═════════
  // doc: { paper: "note" | "letter" | "card" | "report" | "log" | "list" | "screen" | "sign" | "label", hand: "caps" | "script" | "type" | "print" | "marker",
  //        title: { en, vi }, art: "doc-x" (ảnh nền giấy tuỳ chọn), lines: [{ en, vi, s: "pencil" | "cross" | "stamp" | "small" | "big" | "red" | "faded" | "gap" }],
  //        note: { en, vi } (ghi vào sổ lần đọc đầu), set, mark: [chỉ số dòng quan trọng — sáng lên khi đọc lại] }
  // Chữ là CHỮ THẬT (không vẽ bằng AI) → sắc nét, chạm từ để tra; dòng dịch hiện theo nút Dịch / “Luôn dịch”.
  let cancelRead=null;
  E.ui.cancelRead=()=>cancelRead?.();
  E.documentOf=spec=>typeof spec==='string'?(E.S()?.items?.[spec]?.doc||E.S()?.docs?.[spec]):spec;
  E.ui.read = (spec, context) => new Promise(res => {
    const S = E.S(), R = E.R(), rt = root();
    const id = typeof spec === "string" ? spec : null;
    const d = E.documentOf(spec);
    if (!d || !rt || (context?.live&&!context.live())) return res();
    const returnTo=document.activeElement;
    const parentReading=returnTo?.closest?.('[data-reading-scope]');
    cancelRead?.();
    const key = "read:" + (id || E.hash?.(JSON.stringify(d).slice(0, 200)) || "x");
    const first = !R.used[key];
    if(!context?.preview){R.used[key] = 1;if (first) { E.apply(d); if (d.note) (R.jot ||= []).push({ ch: R.ch, t: d.note }); }}
    let tr = context?.native==null ? parentReading ? parentReading.dataset.readingLanguage==='native' : false : !!context.native;
    // Documents are reading surfaces. Long translated pages replace the
    // original in place; doubling every paragraph makes both harder to scan.
    // Word study remains available on the original-language page.
    const hasTranslation=(d.lines||[]).some(l=>!!E.sub(l))||!!E.sub(d.title);
    const compactTranslation=d.bilingual!==true&&((d.lines||[]).length>1||(d.lines||[]).some(l=>String(E.tgt(l)||'').length+String(E.sub(l)||'').length>140));
    const line = (l, i) => {
      if (l.s === "gap") return `<div class="dl gap"></div>`;
      const main = E.tgt(l), sub = E.sub(l);
      return `<div class="dl${l.s ? " " + l.s.split(" ").map(x => "s-" + x).join(" ") : ""}${(d.mark || []).includes(i) && !first ? " mk" : ""}"><span class="dm">${E.words(main, E.L)}</span>${sub ? `<small class="dt">${esc(sub.replace(/\[\[|\]\]/g, ""))}</small>` : ""}</div>`;
    };
    const v = h(`<div class="se-read${tr ? " tr" : ""}${compactTranslation?' rd-compact-translation':''}" role="dialog" aria-modal="true" aria-label="${esc(nat(d.title)||T("Document", "Tài liệu"))}" tabindex="-1"><div class="rd-bg"></div><div class="rd-tools">${hasTranslation?E.ui.translationButton(tr, 'data-tr'):''}</div>
      <div class="rd-scroll" tabindex="0" aria-label="${esc(T('Document text','Nội dung tài liệu'))}"><div class="rd-p p-${esc(d.paper || "note")} h-${esc(d.hand || "print")}">${d.art ? `<i class="rd-art im-${esc(d.art)}"></i>` : ""}
        ${d.title ? `<div class="rd-t">${esc(tr&&compactTranslation?E.sub(d.title)||E.tgt(d.title):E.tgt(d.title))}</div>` : ""}${d.readingNote?`<p class="rd-note">${esc(tr?E.sub(d.readingNote)||E.tgt(d.readingNote):E.tgt(d.readingNote))}</p>`:''}<div class="rd-l">${(d.lines || []).map(line).join("")}</div></div></div>
      <div class="rd-bar"><button class="se-btn pri" data-x>${esc(T("Done", "Xong"))}</button></div></div>`);
    rt.appendChild(v);
    E.sfx("page"); E.haptic("LIGHT");
    let settled=false,closing=false,closeTimer=0,autoTimer=0,focusFrame=0;
    const live=()=>!settled&&v.isConnected&&E.R()===R&&(!context?.live||context.live());
    const settle=cancelled=>{
      if(settled)return;settled=true;
      clearTimeout(closeTimer);clearTimeout(autoTimer);cancelAnimationFrame(focusFrame);
      E.ui.closeWordPop?.(v);v.onclick=null;v.onkeydown=null;v.remove();
      if(cancelRead===cancel)cancelRead=null;
      if(!cancelled&&E.R()===R&&(!context?.live||context.live())&&returnTo?.isConnected)returnTo.focus?.({preventScroll:true});
      res();
    };
    const cancel=()=>settle(true);cancelRead=cancel;
    const close=()=>{if(closing||settled)return;if(!live())return cancel();closing=true;v.classList.add('out');closeTimer=setTimeout(()=>settle(!live()),E.auto||reducedMotion()?0:260);};
    context?.onExit?.(cancel);
    v.onkeydown = e => { if (e.key === "Escape") { e.preventDefault(); e.stopPropagation(); return close(); } if (e.key === "Tab") { const bs=[...v.querySelectorAll('button,[tabindex="0"]')].filter(b=>!b.disabled&&b.getClientRects().length),first=bs[0],last=bs.at(-1); if (e.shiftKey && (document.activeElement===first || document.activeElement===v)) {e.preventDefault();last?.focus();} else if (!e.shiftKey && document.activeElement===last) {e.preventDefault();first?.focus();} } };
    focusFrame=requestAnimationFrame(() => { if (live()&&!closing) v.querySelector('[data-x]')?.focus({preventScroll:true}); });
    v.onclick = e => {
      if(!live()||closing)return;
      const w = e.target.closest(".w[data-w]"); if (w) return; // tra từ: bộ bắt chạm chung của engine xử lý
      if (e.target.closest("[data-tr]")) {
        e.stopPropagation();E.ui.closeWordPop?.(v);
        const lane=v.querySelector('.rd-scroll'),progress=lane.scrollTop/Math.max(1,lane.scrollHeight-lane.clientHeight);
        tr = !tr; v.classList.toggle("tr", tr);
        E.ui.updateTranslationButton(v.querySelector('[data-tr]'), tr);
        if(d.title&&compactTranslation)v.querySelector('.rd-t').textContent=tr?E.sub(d.title)||E.tgt(d.title):E.tgt(d.title);
        if(d.readingNote)v.querySelector('.rd-note').textContent=tr?E.sub(d.readingNote)||E.tgt(d.readingNote):E.tgt(d.readingNote);
        lane.scrollTop=progress*Math.max(0,lane.scrollHeight-lane.clientHeight);
        E.sfx("tap"); return;
      }
      if (e.target.closest("[data-x]") || e.target.closest(".rd-bg")) close();
    };
    if (E.auto) autoTimer=setTimeout(close, 5);
  });
  def("read", async c => { c.resumeHere?.(); E.ui.hideBox(); await E.ui.read(c.st.read,c); c.resumeHere?.(false); });

  // ═════════ NHÂN VẬT: đổi biểu cảm mờ chéo · chớp mắt ═════════
  const show0 = E.ui.show;
  E.ui.show = (id, at, face) => {
    syncMotionPreference();
    const previous=E.R()?.cast?.[id];
    if(adaptiveDialogue()&&previous){at=at??previous.at;face=face??previous.face;}
    if(!E.R()?.cast?.[id]&&!E.R()?.dialogueFrameLock)E.ui.dialogueFrame('full');
    // The resumed spoken line may still carry its starting expression. A
    // completed cue owns its endpoint until that line leaves the screen.
    const held = motionCurrent && !motionCurrent.disposed && !motionCurrent.running && motionCurrent.R === E.R() && motionCurrent.actors.find(a => a.id === id);
    if (held) { at = held.final.at; face = held.final.face; }
    const el = $(`.se-ch[data-id="${id}"]`);
    if (el && (el.dataset.face || "") !== (face || "") && !reducedMotion()) {
      el.querySelectorAll('.se-chi .fo,.se-chi .bk').forEach(old=>old.remove());
      const cur = el.classList.contains("hasf") ? el.querySelector(".ii.f") : el.querySelector(".ii.im-" + id);
      if (cur) { const g = cur.cloneNode(); g.className = cur.className.replace(/\bf\b/, "") + " fo"; el.querySelector(".se-chi").appendChild(g); setTimeout(() => g.remove(), 260); }
    }
    show0(id, at, face);
    const n = $(`.se-ch[data-id="${id}"]`); if (n && !n.style.getPropertyValue("--bd")) n.style.setProperty("--bd", (-Math.random() * 5).toFixed(2) + "s");
    scheduleDialogueLayout();
  };
  const hide0=E.ui.hide;E.ui.hide=(...args)=>{const result=hide0(...args);scheduleDialogueLayout();return result;};
  let blinkT = 0;
  const blink = () => {
    clearTimeout(blinkT);
    blinkT = setTimeout(blink, 2600 + Math.random() * 3600);
    if (reducedMotion() || document.hidden) return;
    for (const el of $$(".se-ch.on")) {
      if (Math.random() < .35) continue;
      const id = el.dataset.id, f = el.dataset.face, cls = `im-${id}${f && el.classList.contains("hasf") ? "-" + f : ""}-blink`;
      if (!E.hasArt(cls)) continue;
      let b = el.querySelector(".ii.bk"); if (!b) { b = h(`<div class="ii bk"></div>`); el.querySelector(".se-chi").appendChild(b); }
      b.className = "ii bk " + cls; b.classList.add("on"); setTimeout(() => b.classList.remove("on"), 130);
    }
  };
  E.on("boot", () => setTimeout(blink, 2000));

  // ═════════ khôi phục / dọn ═════════
  const restore0 = E.ui.restore;
  let restoreToken = 0;
  E.ui.restore = () => {
    E.ui.cancelRead?.();motionCurrent?.dispose(); cancelProps();
    const R = E.R(), look = R.look, inspection = savedInspectionFocus(R), action=savedActionFrame(R), token = ++restoreToken;
    restore0();
    E.ui.dialogueFrame(R.dialogueFrame||'full',R.dialogueFrameLock);
    if(action)setActionFrame(action,false);
    if (R.shot) { const s = R.shot; R.shot = null; E.ui.shot(s, { tr: "cut", restore: true }); }
    else if (R.scene) decorate(R.scene, !E.hasArt("im-" + R.scene));
    const key = E.ui.bgKey();
    // A restored bitmap may still be decoding. Adding props immediately would
    // attach them to the outgoing title/scene layer and make them disappear.
    return Promise.resolve(E.ui.layerReady?.()).then(() => {
      if (token !== restoreToken || E.R() !== R || E.ui.bgKey() !== key) return;
      if(action){setActionFrame(action);R.look=look;}else if (look) {
        if (inspection) E.ui.inspectionLook(look, 0, true); else lookTo(look, 0);
      }
      for (const id in R.props || {}) { const p = R.props[id]; if (p.img === E.curImg()) renderProp(id, p); }
    });
  };
  const reset0 = E.ui.reset;
  E.ui.reset = () => { clearDetailOverlay();clearDialogueLayout(true);setScenePeek(false);scenePeekButton?.remove();scenePeekButton=null;motionCurrent?.dispose(); cancelProps(); finishVisualTransition(); resetCamera = null; ++restoreToken; const R = E.R(), look = R?.look, lookSource = R?.lookSource, action=R?.actionFrame; E.ui.cancelRead?.();E.ui.cancelReveal?.(); reset0(); lookTo(null, 0, true); if (R) {R.look=look;if(lookSource)R.lookSource=lookSource;if(action)R.actionFrame=action;} const rt = root(); rt?.classList.remove("shot", "slowmo", "action-framed"); rt?.style.removeProperty("--action-scene-width"); $(".se-rev")?.remove(); $(".se-read")?.remove(); };
  const stopStage=E.stop;E.stop=(...args)=>{E.ui.cancelRead?.();E.ui.cancelReveal?.();clearDetailOverlay();clearDialogueLayout(true);return stopStage(...args);};
  // sang cảnh khác → đạo cụ của cảnh cũ không còn
  E.on("step", (type, st) => { if (type === "bg") { motionCurrent?.dispose(); cancelProps(); if (E.R()?.props) E.R().props = {}; } if((type==="place"||type==="explore")&&E.R()?.actionFrame)setActionFrame(null);motionCurrent?.positionControl?.(); });

  // icon thêm
  Object.assign(E.ICON, {
    flip: E.ICON.flip || `<svg viewBox="0 0 24 24"><path d="M4 12a8 8 0 0 1 14-5.3M20 4v5h-5M20 12a8 8 0 0 1-14 5.3M4 20v-5h5"/></svg>`,
    doc: E.ICON.doc || `<svg viewBox="0 0 24 24"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6"/></svg>`,
    left: `<svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg>`,
    right: `<svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>`,
    down: `<svg viewBox="0 0 24 24"><path d="M5 9l7 7 7-7"/></svg>`,
    hint: `<svg viewBox="0 0 24 24"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"/></svg>`,
    hand: `<svg viewBox="0 0 24 24"><path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V12M11 11V4.5a1.5 1.5 0 0 1 3 0V12M14 11.5V6a1.5 1.5 0 0 1 3 0v7.5c0 4-2.5 7.5-6.5 7.5-2.8 0-4.4-1.4-5.8-3.8L3 13.4a1.5 1.5 0 0 1 2.6-1.4L8 15"/></svg>`,
    talk: `<svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z"/></svg>`,
  });
})();

// ═════════ LÀN TRẠNG THÁI + LÀN THÔNG BÁO (engine 3 — người dùng 30/10: “thông báo, tên địa điểm, giờ dễ bị đè UI”) ═════════
// · Tên địa điểm + giờ nằm TRONG thanh trên (viên giữa, giữa nút menu và cụm nút) — đổi cảnh: viên nở ra (tên + giờ) ~3,6 giây rồi thu lại
//   chỉ còn giờ (nếu truyện có đồng hồ). Chạm viên = xem lại địa điểm. Không còn thẻ địa điểm nổi đè lên hình / thông báo.
// · Mọi thông báo (nhận đồ, “X sẽ nhớ”, nhân vật mới, toast) xếp chung 1 cột dưới thanh trên → không chồng lên nhau.
(() => {
  const E = globalThis.StoryEngine, h = E.h, $ = s => document.querySelector(s);
  let tmr = 0, cur = { n: "", t: "" };
  E.ui.loc = (name, time) => {
    const st = $(".se-stat"); if (!st) return;
    if (name != null) cur.n = name; if (time != null) cur.t = time;
    st.querySelector(".st-n").textContent = cur.n || "";
    st.querySelector(".st-t").textContent = cur.t || "";
    st.classList.add("big"); st.classList.toggle("has", !!cur.n);
    clearTimeout(tmr); tmr = setTimeout(() => st.classList.remove("big"), E.auto ? 1 : 3600);
  };
  E.on("boot", () => {
    const top = $(".se-top"), menu = top?.querySelector("[data-a=menu]");
    if (top && !top.querySelector(".se-stat")) {
      const st = h(`<button class="se-stat" aria-label="${E.esc(E.nat({ en: "Where am I", vi: "Đang ở đâu" }))}"><span class="st-l"><b class="st-n"></b><small class="st-t"></small></span><span class="sp-clock" hidden></span></button>`);
      menu ? menu.after(st) : top.prepend(st);
      st.onclick = e => { e.stopPropagation(); if (cur.n) E.ui.loc(); };
    }
    // nhãn lời suy nghĩ theo ngôn ngữ người chơi (CSS content đọc biến)
    document.querySelector(".se")?.classList.toggle("fit-cover", E.fit() === "cover");
    document.querySelector(".se")?.style.setProperty("--se-think-l", JSON.stringify(E.nat({ en: "You think", vi: "Bạn nghĩ" })));
    // “X sẽ nhớ” + nhân vật mới vào chung cột thông báo
    const tb = $(".se-toast"), mem = $(".se-mem");
    if (tb && mem && !$(".se-lane")) { const lane = h(`<div class="se-lane"></div>`); tb.before(lane); lane.append(mem, tb); }
  });
  // cảnh mới (core ghi vào .se-loc cũ) → chuyển sang viên trạng thái
  const sc = E.ui.scene;
  E.ui.scene = (id, keep) => {
    const loc = $(".se-loc"), before = loc?.dataset.n;
    const ready = sc(id, keep);
    if (loc && loc.dataset.n !== before && loc.classList.contains("in")) { loc.classList.remove("in"); const S = E.S().scenes[id] || {}; E.ui.loc(E.nat(S.name) || "", S.time ? E.nat(S.time) : (E.R().clock?.t || "")); }
    return ready;
  };
  // đồng hồ đổi → giờ trong viên cũng đổi
  E.on("step", type => { if (type === "clock") setTimeout(() => { const t = E.R().clock?.t; cur.t = t || cur.t; $(".se-stat")?.classList.toggle("clk", !!E.R().clock); }, 0); });
})();

// ═════════ HỘP LỜI kiểu visual novel: màu người nói · TỰ CHẠY (auto) ═════════
// · Bảng tên + viền trên hộp lời mang màu nhân vật đang nói (bạn = màu chủ đạo).
// · TỰ CHẠY (người dùng 30/10: bản đầu “chưa ổn”): chờ chữ hiện HẾT + giọng đọc XONG → đếm thời gian đọc (thanh mảnh trên hộp lời chạy hết)
//   → sang câu sau. Chạm màn = sang câu ngay (KHÔNG tắt tự chạy, như Ren'Py). Gặp lựa chọn / câu đố / thẻ sự thật / bảng / sổ tay → tự đứng chờ.
//   Tắt / bật: nút trên hộp lời (nhớ giữa các lần chơi).
(() => {
  const E = globalThis.StoryEngine, h = E.h, $ = s => document.querySelector(s), T = (en, vi) => E.nat({ en, vi });
  let seq = 0, tm = 0, voice = null;
  const box = () => $(".se-box");
  // giọng đọc của câu hiện tại (lời hội thoại / lời dẫn khi bật đọc lời dẫn) — tự chạy chờ đọc xong
  const say0 = E.say;
  E.say = (...a) => { const p = say0(...a); voice = p; return p; };
  const on = () => !!E.G()?.set.autoAdv;
  const busy = () => $(".se-sheet:not([hidden]), .se-rev, .se-read, .se-card:not([hidden]), .se-iv, .se-pop, [data-quick-menu]:not([hidden])");
  const bar = () => { let b = box()?.querySelector(".se-ap"); if (!b && box()) { b = h(`<i class="se-ap"></i>`); box().appendChild(b); } return b; };
  const stopBar = () => { const b = box()?.querySelector(".se-ap"); if (b) { b.style.transition = "none"; b.style.transform = "scaleX(0)"; } };
  const setAuto = v => { E.G().set.autoAdv = !!v; E.save(); $(".se-autob")?.classList.toggle("on", !!v); $(".se")?.classList.toggle("autoing", !!v); if (v) arm(); else { clearTimeout(tm); stopBar(); } };
  async function arm() {
    clearTimeout(tm); stopBar();
    const b = box(); if (!on() || !b || b.hidden || E.auto || E.ui.actionPeekState?.() || $("[data-quick-menu]:not([hidden])")) return;
    const my = seq, v = voice;
    // 1) chữ hiện hết (lớp done do core gắn)
    while (my === seq && !b.classList.contains("done")) await new Promise(r => setTimeout(r, 80));
    // 2) giọng đọc xong (tối đa 30 giây)
    let spoke = false;
    if (v) { const t0 = Date.now(); await Promise.race([v, new Promise(r => setTimeout(r, 30000))]); spoke = Date.now() - t0 > 300; }
    if (my !== seq || !on() || b.hidden) return;
    // 3) thời gian đọc: đã nghe giọng → nghỉ ngắn; không giọng → theo độ dài câu (kèm dòng dịch nếu đang hiện)
    const sp = Math.max(.7, E.G().set.speed || 1), n = (b.querySelector(".se-txt")?.textContent || "").length + (b.querySelector(".se-sub:not([hidden])")?.textContent || "").length * .5;
    const wait = (spoke ? 700 : Math.min(9000, 900 + n * 42)) / sp;
    const pb = bar(); pb.style.transition = "none"; pb.style.transform = "scaleX(0)"; void pb.offsetWidth;
    pb.style.transition = `transform ${wait}ms linear`; pb.style.transform = "scaleX(1)";
    const fire = () => {
      if (my !== seq || !on() || b.hidden) return;
      if (busy() || E.ui.actionPeekState?.()) { tm = setTimeout(fire, 400); return; }
      // Concise narration must not let Auto skip the physical action's end.
      // Manual advance/Skip stays native; reduced motion adds no extra wait.
      if (E.ui.motionState?.()?.running) { tm = setTimeout(fire, 120); return; }
      stopBar(); b.click();
    };
    tm = setTimeout(fire, wait);
  }
  E.on("line", d => {
    seq++; voice = null;
    const b = box(); if (!b) return;
    const ch = d.who === "me" ? null : E.S().chars[d.who];
    b.style.setProperty("--sc", d.kind !== "say" ? "transparent" : d.who === "me" ? "var(--se-ac)" : ch?.color || "#aaa");
    // E.say gọi NGAY SAU sự kiện line → đợi 1 nhịp mới bắt được lời hứa của giọng đọc
    setTimeout(arm, 0);
  });
  E.on("action-peek",active=>{seq++;clearTimeout(tm);stopBar();if(!active&&on())setTimeout(arm,0);});
  E.on("quick-menu",opened=>{seq++;clearTimeout(tm);stopBar();if(!opened&&on())setTimeout(arm,0);});
  E.on("boot", () => {
    const tools = $(".se-tools"); if (!tools || $(".se-autob")) return;
    const bt = h(`<button class="se-autob${on() ? " on" : ""}" aria-label="${E.esc(T("Auto", "Tự chạy"))}"><svg viewBox="0 0 24 24"><path d="M6 5l8 7-8 7zM14 5l8 7-8 7z"/></svg><span>${E.esc(T("Auto", "Tự chạy"))}</span></button>`);
    tools.querySelector(".se-more")?.before(bt);
    bt.addEventListener("click", e => { e.stopPropagation(); setAuto(!on()); E.sfx("tap"); if (on()) E.ui.toast(E.esc(T("Auto on — tap anywhere to skip ahead", "Đã bật tự chạy — chạm màn để sang câu nhanh")), 1600); });
    $(".se")?.classList.toggle("autoing", on());
  });
})();
// Enmi Story Engine 3 — ĐỊA ĐIỂM kiểu Rusty Lake + HỎI CHUYỆN tự chọn + ĐỒNG HỒ (nạp sau stage.js).
//
// { place: { id, name, goal, start, ring: [view…], views: { <view>: VIEW }, need, until, done, leave, by, late } }   hoặc { place: "<mã>" } → story.places.<mã>
//   VIEW  = { img: "<ảnh>" | s => "<ảnh>", up: "<view cha>" (= cận cảnh, có nút ▼), regions: { <vùng>: [x, y, w, h] }, zones: [ZONE], people: [PERSON], amb,
//             left / right: "<view>" | { to, need, if, cost } = chỗ lân cận bấm ◀ ▶ (quầy bar → sân sau → bốt điện thoại; null = không đi được) — không ghi = theo vòng ring,
//             name + loc: true = đổi tới view này thì viên trạng thái hiện tên chỗ mới,
//             fg: true | "<ảnh>" = lớp TIỀN CẢNH trong suốt (<ảnh>-fg) đè lên người / đồ (quầy che trước người đứng sau), fgZ }
//   P.spatial = { title? } opts into an explicit spatial graph: no implicit ring.
//   VIEW.space identifies one physical area; left/right may turn only within it.
//   VIEW.up = string | {to, kind, label, if, need, cost}; upKind/upLabel are aliases.
//   VIEW.routes = [{id,to,label,kind,if,need,cost}] for an entrance outside the image.
//   ZONE.kind / route.kind = enter | exit | walk | back | detail. Only explicit
//   detail navigation zooms. VIEW.map = {x:1..3,y:1..N} places a read-only map node.
//   THỨ TỰ LỚP (trước / sau): nền 0 · vùng + đồ vật ghép z 2 · người z 3 · tiền cảnh fgZ 5 — ghi z riêng cho từng vùng / người khi cần (đồ trên quầy trước người: z 4)
//   ZONE  = { id, r: "<vùng>" | [x, y, w, h], shape: "ellipse", label, hint,
//             to: "<view>"              chạm = sang view đó (cận cảnh: phóng vào từ chỗ chạm)
//             take: "<đồ>"              nhặt đồ (vật bay ra từ chỗ nó nằm) — vùng biến mất sau khi nhặt
//             then / again              bước khi chạm (máy quay tự nhìn vào vùng, trừ look: false) · clue: true = manh mối (đếm)
//             use: { <đồ>: [bước] }, stuck: [bước]   dùng đồ lên vùng · chạm khi chưa có đồ
//             need: điều kiện (chưa đủ → stuck) · if / hide: hiện / ẩn theo điều kiện · once: chạm 1 lần rồi thôi
//             widget: { type: "wipe" | "dial" | "switch", …, ok: [bước] }   câu đố ngay trên cảnh
//             art: "<ảnh PNG>"          ĐỒ VẬT GHÉP lên ảnh đúng khung vùng (take tự dùng it-<đồ> nếu có) → vật và chỗ chạm luôn trùng, dù nền AI vẽ lệch
//           z: thứ tự lớp · exit: true chạm = rời địa điểm (khi đủ manh mối) · cost: phút (đồng hồ) · glint: false = không loé }
//   PERSON = { who, r: [x, y, w, h] (khung đứng, chân chạm đáy khung), pose (ảnh toàn thân <mã>-full-<pose>), face, talk: TALK | "<mã talks>", if, z }
//            Người đứng TRONG cảnh dùng ảnh TOÀN THÂN (art.json chars.<mã>.full) — thiếu thì tạm dùng ảnh nửa người.
//   need: số manh mối tối thiểu | [mã vùng…] · until: điều kiện → tự rời khi đúng · leave: false = không cho rời trước khi đủ
//   by: "03:05" + late: [bước] → đồng hồ chạy qua giờ đó (do cost của vùng / câu hỏi) thì địa điểm đóng lại, chạy late
// Trạng thái địa điểm giữ suốt lần chơi (R.pl[id]) → quay lại vẫn ở đúng view, vật đã nhặt không còn.
//
// { talk: { with, face, hello: [bước] (lần đầu), topics: [{ id, label, need, if, once (mặc định true), then, cost, end, new }],
//           show: { <đồ>: [bước], "*": [bước] }, bye: [bước], prompt } }  hoặc { talk: "<mã>" } → story.talks.<mã>
//   Hỏi tự chọn kiểu Rusty Lake / Ace Attorney: chủ đề mở dần theo manh mối; đưa đồ cho xem; Rời đi.
//
// E.widget(tên, { html(z, st), bind(el, z, st, api) }) — thêm câu đố trên cảnh (api.ok() khi giải xong, api.redraw()).
(() => {
  const E = globalThis.StoryEngine, def = E.def, esc = E.esc, h = E.h;
  const nat = t => E.nat(t), T = (en, vi) => nat({ en, vi });
  // Optional game renderer for substantive investigative text. Chrome stays native.
  const investigationText = t => E.ui.readingText?.(t,{compact:true}) ?? E.ui.investigationText?.(t) ?? esc(nat(t));
  const inspectLook = (...args) => (E.ui.inspectionLook || E.ui.look)(...args);
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const cond = (c, s) => E.cond(c, s);
  const later = (f, ms = 5) => setTimeout(f, ms);

  // ═════════ ĐỒNG HỒ (phút tuyệt đối, không vòng qua nửa đêm) ═════════
  const toM = t => { const m = /^(\d{1,2}):(\d{2})/.exec(t || ""); return m ? +m[1] * 60 + +m[2] : null; };
  const fmt = m => { m = ((m % 1440) + 1440) % 1440; return String(Math.floor(m / 60)).padStart(2, "0") + ":" + String(m % 60).padStart(2, "0"); };
  E.time = {
    now: () => { const R = E.R(); if (R.clockM == null && R.clock?.t) R.clockM = toM(R.clock.t); return R.clockM; },
    add: (min, warnBy) => {
      const R = E.R(); if (!min || !R.clock) return;
      R.clockM = (E.time.now() ?? 0) + min;
      E.mech.clock({ st: { clock: fmt(R.clockM), warn: warnBy != null && warnBy - R.clockM <= 15 } });
    },
    abs: t => { const R = E.R(), now = E.time.now() ?? 0, m = toM(t); let a = now - (now % 1440) + m; if (a < now) a += 1440; return a; },
  };
  // { clock } đặt lại giờ → mốc tuyệt đối theo giờ mới
  E.on("step", type => { if (type === "clock") setTimeout(() => { const R = E.R(); R.clockM = R.clock ? toM(R.clock.t) : null; }, 0); });

  // ═════════ CÂU ĐỐ TRÊN CẢNH ═════════
  const WG = {};
  E.widget = (k, impl) => { WG[k] = impl; };
  E.widgets = WG;
  // LAU / CÀO (làm lại 30/10 — người dùng: “khó cào, hiệu ứng chưa đẹp”):
  //   · lớp phủ đọng hơi nước (mờ, hạt nước, sáng viền) hoặc bụi / sơn cào (w.look: "fog" | "dust" | "scratch")
  //   · cọ MỀM to (≥ 26 px, 22 % cạnh ngắn) nối liền giữa các điểm chạm (không lỗ chỗ khi miết nhanh) · vùng nhận miết rộng hơn khung 24 px
  //   · ~42 % sạch là đủ → phần còn lại tan dần + vệt sáng lướt qua + tiếng “xong” · chưa chạm 2 giây → bàn tay gợi ý miết qua lại
  E.widget("wipe", {
    html: (z, w) => `<canvas class="wg-wipe"></canvas><i class="wg-hand">${E.ICON.hand || ""}</i><b class="wg-tip">${esc(nat(w.tip || { en: "Rub to clear", vi: "Miết để lau" }))}</b>`,
    bind(el, z, w, api) {
      const cv = el.querySelector("canvas"), host = el.closest(".pz") || el;
      const W0 = Math.max(60, el.offsetWidth), H0 = Math.max(40, el.offsetHeight), dpr = Math.min(2, devicePixelRatio || 1);
      cv.width = W0 * dpr; cv.height = H0 * dpr;
      const x = cv.getContext("2d"); x.scale(dpr, dpr);
      const look = w.look || "fog";
      // lớp phủ
      const g = x.createLinearGradient(0, 0, W0, H0);
      if (look === "fog") { g.addColorStop(0, "rgba(214,226,232,.93)"); g.addColorStop(1, "rgba(176,192,202,.9)"); }
      else if (look === "dust") { g.addColorStop(0, "rgba(150,132,104,.95)"); g.addColorStop(1, "rgba(112,98,78,.95)"); }
      else { g.addColorStop(0, "rgba(196,196,200,.98)"); g.addColorStop(1, "rgba(150,150,158,.98)"); }
      x.fillStyle = g; x.fillRect(0, 0, W0, H0);
      for (let i = 0; i < (W0 * H0) / 90; i++) { // hạt nước / hạt bụi
        const r = Math.random() * (look === "fog" ? 2.6 : 1.4) + .4, px = Math.random() * W0, py = Math.random() * H0;
        x.fillStyle = look === "fog" ? `rgba(255,255,255,${.25 + Math.random() * .35})` : `rgba(0,0,0,${Math.random() * .18})`;
        x.beginPath(); x.arc(px, py, r, 0, 7); x.fill();
        if (look === "fog" && r > 2) { x.fillStyle = "rgba(90,110,125,.25)"; x.beginPath(); x.arc(px + .6, py + .8, r * .6, 0, 7); x.fill(); }
      }
      x.globalCompositeOperation = "destination-out";
      const R = Math.max(26, Math.min(W0, H0) * .22);
      const dab = (px, py) => { const rg = x.createRadialGradient(px, py, 0, px, py, R); rg.addColorStop(0, "rgba(0,0,0,1)"); rg.addColorStop(.6, "rgba(0,0,0,.85)"); rg.addColorStop(1, "rgba(0,0,0,0)"); x.fillStyle = rg; x.beginPath(); x.arc(px, py, R, 0, 7); x.fill(); };
      let last = null, done = false, n = 0, idle = 0;
      const pos = e => { const b = cv.getBoundingClientRect(); return [(e.clientX - b.left) * W0 / b.width, (e.clientY - b.top) * H0 / b.height]; };
      const stroke = e => {
        const [px, py] = pos(e);
        if (last) { const d = Math.hypot(px - last[0], py - last[1]), st = Math.max(1, Math.ceil(d / (R * .35))); for (let i = 1; i <= st; i++) dab(last[0] + (px - last[0]) * i / st, last[1] + (py - last[1]) * i / st); }
        else dab(px, py);
        last = [px, py];
        if (++n % 4 === 0) { check(); if (n % 12 === 0) E.haptic("LIGHT"); }
      };
      const check = () => {
        if (done) return;
        const d = x.getImageData(0, 0, cv.width, cv.height).data; let c = 0, t = 0;
        for (let i = 3; i < d.length; i += 4 * 9) { t++; if (d[i] < 60) c++; }
        const k = c / t; host.style.setProperty("--wp", k.toFixed(2));
        if (k > (w.need || .42)) finish();
      };
      const finish = () => {
        done = true; el.classList.add("clear"); E.sfx("solve"); E.haptic("MEDIUM");
        cv.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 650, easing: "ease-out", fill: "forwards" });
        setTimeout(() => api.ok(), E.auto ? 1 : 750);
      };
      // nhận miết cả khi ngón tay trượt ra ngoài khung một chút
      const onDown = e => { if (done) return; e.preventDefault(); e.stopPropagation(); el.classList.add("on"); try { cv.setPointerCapture(e.pointerId); } catch {} last = null; stroke(e); E.sfx("tap"); };
      cv.addEventListener("pointerdown", onDown);
      cv.addEventListener("pointermove", e => { if (el.classList.contains("on") && !done) stroke(e); });
      const up = () => { el.classList.remove("on"); last = null; check(); };
      cv.addEventListener("pointerup", up); cv.addEventListener("pointercancel", up);
      cv.addEventListener("click", e => e.stopPropagation());
      // gợi ý: chưa ai chạm sau 2 giây → bàn tay miết qua lại
      idle = setTimeout(() => !n && el.classList.add("hint"), 2000);
    },
    auto: (el, z, w, api) => api.ok(),
  });
  // KHOÁ SỐ ngay trên vật: { type: "dial", answer: "0601", kind: "digits" | "letters" } — chạm nửa trên / dưới bánh xe để đổi
  E.widget("dial", {
    html: (z, w) => `<div class="wg-dial">${[...String(w.answer)].map((_, i) => `<button data-d="${i}"><i>▲</i><b>${w.kind === "letters" ? "A" : "0"}</b><i>▼</i></button>`).join("")}</div>`,
    bind(el, z, w, api) {
      const set = w.kind === "letters" ? "ABCDEFGHIJKLMNOPQRSTUVWXYZ" : "0123456789", val = [...String(w.answer)].map(() => 0);
      el.querySelector(".wg-dial").onclick = e => {
        e.stopPropagation();
        const b = e.target.closest("[data-d]"); if (!b) return;
        const i = +b.dataset.d, up = e.clientY < b.getBoundingClientRect().top + b.offsetHeight / 2;
        val[i] = (val[i] + (up ? 1 : set.length - 1)) % set.length;
        b.querySelector("b").textContent = set[val[i]]; E.sfx("tap"); E.haptic("LIGHT");
        if (val.map(v => set[v]).join("") === String(w.answer).toUpperCase()) { E.sfx("solve"); el.classList.add("ok"); setTimeout(api.ok, 500); }
      };
    },
    auto: (el, z, w, api) => api.ok(),
  });
  // CÔNG TẮC: bật / tắt 1 cờ ngay (đèn, vòi nước…) — view đổi ảnh theo cờ (img: s => …); then (nếu có) chạy sau khi bật
  E.widget("switch", {
    html: () => ``,
    tap: (z, w, api) => { const R = E.R(); R.f[w.flag] = !R.f[w.flag]; E.sfx(w.sfx || "tap"); E.haptic("LIGHT"); if (R.f[w.flag] && w.ok) api.ok(); else api.redraw(true); },
  });

  // ═════════ ĐỊA ĐIỂM ═════════
  // người đứng trong cảnh / vùng có talk → sinh mảng bước con (đường dẫn ngăn xếp cố định khi tải lại)
  E.norm("views", P => {
    for (const v of Object.values(P.views || {})) {
      (v.people || []).forEach(p => { p.go = [{ talk: typeof p.talk === "string" ? p.talk : { with: p.who, ...(p.talk || {}) } }]; });
      (v.zones || []).forEach(z => { if (z.talk) z.go = [{ talk: typeof z.talk === "string" ? z.talk : { with: z.who, ...z.talk } }]; });
    }
  });
  const SIL = c => `<svg viewBox="0 0 200 300" preserveAspectRatio="xMidYMax meet"><path fill="${c}" fill-opacity=".55" d="M100 26c-26 0-43 20-43 47 0 20 9 36 23 44l-2 15c-36 8-60 30-65 70l-5 98h184l-5-98c-5-40-29-62-65-70l-2-15c14-8 23-24 23-44 0-27-17-47-43-47z"/></svg>`;
  const MAP_ICON = `<svg viewBox="0 0 24 24"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3zM9 3v15M15 6v15"/></svg>`;
  const DOOR_ICON = `<svg viewBox="0 0 24 24"><path d="M4 21V3h11v18M2 21h16M8 12h1M12 12h9m-3-3 3 3-3 3"/></svg>`;

  // One image rule for normal entry and a suspended place's saved child.
  const placeImage = (v, PS, R) => {
    const base = (typeof v.img === "function" ? v.img(E.state()) : v.img) || PS.v;
    const taken = (v.zones || []).filter(z => z.take && z.art === false && typeof z.r === "string" && (PS.took?.[z.take] || R.items.includes(z.take))).map(z => base + "--" + z.r).find(n => E.artReal("im-" + n));
    return taken || base;
  };
  const placeLayer = (v, viewId, img, tr, options = {}) => {
    if (v.regions || v.size || v.fit) E.regions({ [img]: { ...(v.regions ? { r: v.regions } : {}), ...(v.size ? { size: v.size } : {}), ...(v.fit ? { fit: v.fit } : {}) } });
    const has = E.hasArt("im-" + img);
    return E.ui.layer("v:" + img, `<div class="ph vph"><b>${esc(nat(v.name) || viewId)}</b></div>${has ? `<div class="ii im-${esc(img)}"></div>` : ""}${E.vbox(img, E.fxHtml(img) + E.wireHtml(img, !has || E.wire), "deco")}${E.vbox(img, "", "zones")}`, { tr, ...options });
  };
  const changesVisual = st => !!st && typeof st === "object" && (["bg", "scene", "shot", "cg", "look", "actionFrame"].some(key => Object.prototype.hasOwnProperty.call(st, key)) || !!st.motion?.backdrop);
  const branchChangesVisual = (value, seen = new Set()) => {
    if (!value || typeof value !== "object" || seen.has(value)) return false;
    seen.add(value);
    if (changesVisual(value)) return true;
    return Object.values(value).some(child => branchChangesVisual(child, seen));
  };
  const restorePlaceLayer = (v, viewId, PS) => {
    const R = E.R(), S = E.S(), img = placeImage(v, PS, R), sc = S.scenes?.[R.scene] || { kind: R.scene }, rt = $(".se");
    placeLayer(v, viewId, img, "cut");
    E.ui.frame(img, [...(v.zones || []).map(z => E.regionOf(img, z.r)?.box), ...(v.people || []).map(p => E.regionOf(img, p.r)?.box)], { top: 64, bottom: 150 });
    if (R.sceneProps?.img === img) E.ui.sceneProps?.(img);
    if (rt) {
      rt.dataset.scene = sc.kind || R.scene || "";
      $(".se-fx", rt).dataset.fx = sc.fx || (sc.rain ? "rain" : "");
      $(".se-fog", rt).classList.toggle("on", !!sc.fog);
    }
    E.amb(v.amb || sc.amb || (sc.rain ? "rain" : sc.fog ? "sea" : sc.kind === "court" ? "hall" : "room"));
    return true;
  };
  E.ui.restorePlaceView = () => {
    const R = E.R(), S = E.S(), vw = R.vw, PS = vw && R.pl?.[vw.pid];
    // Leaving a place keeps its last view behind an adjacent approach choice.
    // Restore that view on review completion/reload without reviving hotspots,
    // entry effects, visit counters or the previously finished narrative.
    const review = R.exploreReview, source = review?.source;
    if (["corridor", "choice"].includes(review?.phase) && source?.place && source.scene === R.scene && source.chapter === R.ch && !R.shot && !R.cg) {
      const step = E.exploreReview?.sourceStep(source), spec = step?.place, P = typeof spec === "string" ? S.places?.[spec] : spec;
      const savedPlace = R.pl?.[source.place.pid], view = savedPlace?.v === source.place.v && P?.views?.[source.place.v];
      if (view) return restorePlaceLayer(view, source.place.v, savedPlace);
    }
    if (!vw || !PS || PS.v !== vw.v || R.shot || R.cg || R.look || R.actionFrame || R.zoom) return false;
    // snapshot() supplies the actual resumable index. A live reading frame's
    // raw i points to the NEXT step and must not select that step's backdrop.
    const stack = E.snapshot().stack || [];
    for (let owner = stack.length - 2; owner >= 0; owner--) {
      const f = stack[owner], spec = E.walk(f)?.[f.i]?.place, named = typeof spec === "string";
      const P = named ? S.places?.[spec] : spec, v = P?.views?.[vw.v], child = stack[owner + 1];
      if (!P || typeof P !== "object" || !v) continue;
      const pid = P.id || (named ? spec : [f.n, ...f.p, f.i].join("."));
      const prefix = named ? [spec, "views", vw.v] : [...f.p, f.i, "place", "views", vw.v];
      if (pid !== vw.pid || child.n !== (named ? "@places" : f.n) || !prefix.every((key, i) => child.p?.[i] === key)) continue;
      for (const frame of stack.slice(owner + 1)) {
        const steps = E.walk(frame), st = steps?.[frame.i];
        if (!steps || !Number.isInteger(frame.i) || frame.i < 0 || frame.i > steps.length) return false;
        // A completed conditional may have moved the scene before this line.
        // Decline ambiguous histories instead of re-evaluating old conditions.
        if (steps.slice(0, frame.i).some(step => branchChangesVisual(step)) || changesVisual(st)) return false;
        const talk = frame.n === "@talks" ? S.talks?.[frame.p?.[0]] : typeof st?.talk === "string" ? S.talks?.[st.talk] : st?.talk;
        // Hello or a previously completed topic may already have relocated.
        // Such conversations retain the normal explicit-scene restore path.
        if (talk && branchChangesVisual(talk)) return false;
      }
      // Restore ambient presentation without calling scene(view), which would
      // overwrite the narrative return location. No live zones/people or visit
      // counters are recreated while the child is still reading.
      return restorePlaceLayer(v, vw.v, PS);
    }
    return false;
  };

  def("place", c => new Promise(res0 => {
    const S = E.S(), R = E.R();
    const ref = typeof c.st.place === "string" ? c.st.place : null;
    const P = ref ? S.places?.[ref] : c.st.place;
    if (!P) { console.warn("[story] place không có", c.st.place); return res0(); }
    if (!P.views || !Object.keys(P.views).length) { console.warn("[story] place has no views", ref); return res0(); }
    c.resumeHere?.();
    const pid = P.id || ref || c.key();
    const location = E.enterLocation(P.location || pid);
    const contextual = P.contextInventory ?? S.contextInventory;
    const itemCandidates = () => (contextual ? E.contextItems(location) : R.items.filter(E.itemLive)).filter(id => R.items.includes(id) && S.items[id]);
    const spatial = !!P.spatial;
    const PS = ((R.pl ||= {})[pid] ||= { v: P.start || Object.keys(P.views)[0], seen: {}, took: {}, vis: {}, hint: 0, solved: {}, n: {} });
    const direct = P.direct ?? S.exploreDirect ?? /^vale-dossiers/.test(S.id || "");
    const assist = () => !direct || !!E.G()?.set?.vdExploreAssist;
    if (PS.detail?.v !== PS.v) delete PS.detail;
    // With inspection magnification disabled, an ordinary hotspot is read in
    // place. There is no separate viewpoint to retreat from. Explicit focused
    // interactions can still opt into detail mode with inspect:true.
    if (PS.detail && S.inspectionZoom === false && !P.views[PS.v]?.zones?.some((z, i) => (z.id || String(i)) === PS.detail.id && z.inspect === true)) delete PS.detail;
    let done = false;
    const timers = new Set(), defer = (fn, ms) => { const id = setTimeout(() => { timers.delete(id); if (!done && c.live()) fn(); }, ms); timers.add(id); return id; };
    const stage = $(".se-stage"), uiHost = $(".se-ui");
    // Navigation sits above the actual HUD, including wrapped goals, bags and
    // translated text. Read layout height, not the panel's animated transform;
    // this measurement never feeds back into the scene/camera hit plane.
    const measureNav = () => {
      if (done || !c.live()) return;
      const nav = navEl(), a = nav.getBoundingClientRect(), b = uiHost?.getBoundingClientRect();
      // In a split landscape layout the HUD is beside the scene, not below it.
      const overlaps = b && Math.min(a.right, b.right) - Math.max(a.left, b.left) > 1;
      nav.style.setProperty("--place-ui-height", Math.ceil(overlaps ? uiHost.offsetHeight : 0) + "px");
    };
    let spatialSheet = null;
    let unhook = () => { E.cancelDrag?.(); if (spatialSheet && !spatialSheet.hidden && spatialSheet.classList.contains("pl-spatial-sheet")) E.ui.closeSheet(); spatialSheet = null; stage.onclick = stage.onpointerdown = stage.onpointerup = stage.onpointercancel = null; navEl().innerHTML = ""; navEl().onclick = null; navEl().style.removeProperty("--place-ui-height"); $(".se")?.classList.remove("pl-inspecting"); };
    const res = () => { if (done) return; done = true; unhook(); timers.forEach(clearTimeout); res0(); };
    c.onExit?.(() => { done = true; timers.forEach(clearTimeout); unhook(); });
    // chạy mảng bước con của địa điểm (khai báo tại chỗ → theo đường dẫn bước; story.places → node "@places")
    const run = keys => (ref ? R.stack.push({ n: "@places", p: [ref, ...keys], i: 0 }) : c.push("place", ...keys));
    const ring = P.ring || Object.keys(P.views).filter(k => !P.views[k].up);
    if (PS.by == null && P.by && R.clock) PS.by = E.time.abs(P.by);
    const VIEW = () => P.views[PS.v] || P.views[ring[0]];
    // ảnh của view · nhặt đồ xong → ảnh nền “đã nhặt” <ảnh>--<vùng> (gen-art tự sinh bằng Qwen-Edit xoá vật đó khỏi chính ảnh gốc → luôn khớp)
    const imgOf = v => placeImage(v, PS, R);
    const zid = (z, i) => z.id || String(i);
    const seenK = (z, i, v = PS.v) => v + "/" + zid(z, i);
    // Looking at a mechanism is not the same as finishing its useful actions.
    // Authored completion also reconciles saves from before an item-use gate.
    const exhausted = (z, i) => z.complete != null ? !!cond(z.complete, E.state()) : !!PS.seen[seenK(z, i)] && (!z.use && !z.widget || !!PS.solved[seenK(z, i)]);
    for (const [vk, v] of Object.entries(P.views)) for (const [i, z] of (v.zones || []).entries()) if (z.complete != null && cond(z.complete, E.state())) { PS.seen[seenK(z, i, vk)] = 1; PS.solved[seenK(z, i, vk)] = 1; }
    const zones = () => (VIEW().zones || []).map((z, i) => ({ z, i })).filter(({ z, i }) => (!z.if || cond(z.if, E.state())) && !(z.hide && cond(z.hide, E.state())) && !(z.take && (PS.took[z.take] || R.items.includes(z.take))) && !(z.once && PS.seen[seenK(z, i)]));
    const people = () => (VIEW().people || []).map((p, i) => ({ p, i })).filter(({ p }) => !p.if || cond(p.if, E.state()));
    const detail = () => direct && PS.detail?.v === PS.v ? PS.detail : null;
    // In direct exploration, a pure navigation region must not duplicate the
    // left/right control. Detail glints inspect; edge controls change views.
    // Keep non-adjacent doorways and regions with authored interactions intact.
    const redundantNav = z => direct && !(spatial && z.kind && z.kind !== "turn") && z.to && !z.then && !z.again && !z.use && !z.take && !z.widget && !z.talk && !z.need && !z.cost && [side(-1), side(1)].includes(z.to);
    const shownZones = () => zones().filter(({ z, i }) => (!detail() || zid(z, i) === detail().id) && !redundantNav(z));
    const targetStyle = box => direct ? `left:${box[0] + box[2] / 2}%;top:${box[1] + box[3] / 2}%;width:${box[2]}%;height:${box[3]}%;transform:translate(-50%,-50%)` : E.pctStyle(box);
    const artOf = z => typeof z.art === "string" ? z.art : z.take && z.art !== false && E.artReal("im-it-" + z.take) ? "it-" + z.take : "";
    const physicalProps = img => [...zones().map(({ z, i }) => ({ id: zid(z, i), art: artOf(z), box: E.regionOf(img, z.artR || z.r)?.box, rotate: z.artRot, z: z.z })), ...(VIEW().props || []).filter(p => !p.if || cond(p.if, E.state())).map(p => ({ id: p.id, art: p.art, box: E.regionOf(img, p.r)?.box, rotate: p.artRot, z: p.z }))].filter(p => p.art && p.box);
    // manh mối: vùng clue của mọi view
    const allClues = () => Object.entries(P.views).flatMap(([vk, v]) => (v.zones || []).map((z, i) => ({ vk, z, i })).filter(x => x.z.clue && (!x.z.if || cond(x.z.if, E.state()))));
    const found = () => allClues().filter(x => PS.seen[seenK(x.z, x.i, x.vk)]).length;
    // need: số manh mối · [mã vùng] · hàm điều kiện s => … (vd. đã nói chuyện đủ người) — progress: s => [đã, tổng] cho thanh dưới
    const needN = () => Array.isArray(P.need) ? P.need.length : typeof P.need === "function" ? 0 : Math.min(P.need ?? 0, allClues().length);
    const needOk = () => Array.isArray(P.need) ? P.need.every(id => Object.keys(PS.seen).some(k => k.endsWith("/" + id))) : typeof P.need === "function" ? !!P.need(E.state()) : found() >= needN();
    let hold = null, bagOpen = false, mapOpen = false, listOpen = false, goalOpen = false, viewBusy = false, paintN = 0, msg = "", ask = false;

    // ── ảnh nền của view (tr: kiểu chuyển)
    const paint = (tr = "cut", o = {}) => {
      const v = VIEW(), img = imgOf(v);
      const changed = placeLayer(v, PS.v, img, tr, o);
      if (direct) E.ui.sceneProps?.(img, physicalProps(img));
      PS.vis[PS.v] = 1;
      // mọi vùng chạm + người của view nằm trong phần màn thấy được (điện thoại dài / máy tính bảng / máy tính)
      E.ui.frame(img, [...(v.zones || []).map(z => E.regionOf(img, z.r)?.box), ...(v.people || []).map(pp => E.regionOf(img, pp.r)?.box)], { top: 64, bottom: 150 });
      if (v.amb) E.amb(v.amb);
      R.vw = { pid, v: PS.v };
      return changed;
    };
    // ── vùng + người (trong khung ảnh → khớp ảnh khi màn dài / ngắn) + nút quay / lùi + thanh dưới
    const draw = () => {
      if (done || !c.live()) return;
      const v = VIEW(), img = imgOf(v), L = $(".se-bgl.on .vbw.zones .vbx");
      const [iw, ih] = E.imgSize(img); $(".se")?.style.setProperty("--vale-scene-ar", String(iw / ih));
      $(".se")?.classList.toggle("pl-inspecting", !!detail());
      if (direct) E.ui.sceneProps?.(img, physicalProps(img));
      if (L) {
        const lt = v.light || P.light || E.S().light;
        L.style.setProperty("--vf", lt ? `brightness(${lt.b ?? 1}) saturate(${lt.s ?? 1}) sepia(${lt.warm ?? 0}) hue-rotate(${lt.cool ? -(lt.cool * 25) : 0}deg)` : "none");
        L.innerHTML = shownZones().map(({ z, i }, k) => {
          const r = E.regionOf(img, z.r); if (!r) { console.warn("[story] place: vùng không có", z.r, "trên", img); return ""; }
          const sk = seenK(z, i), sn = PS.seen[sk], complete = exhausted(z, i), w = z.widget, inl = w && WG[w.type]?.html && !PS.solved[sk];
          // ĐỒ VẬT GHÉP LÊN ẢNH (art): ảnh PNG riêng đặt đúng khung vùng → vật và chỗ chạm luôn trùng nhau, dù ảnh nền AI vẽ lệch
          // vật GHÉP lên nền (người dùng 30/10: “nổi lên tí cũng không sao, chủ yếu bố cục ổn”): art = ảnh PNG; nhặt được (take) có it-<đồ> → tự ghép.
          //   art: false = vật đã VẼ SẴN trong nền (nhặt xong engine đổi sang ảnh “đã nhặt” <ảnh>--<vùng>)
          const art = direct ? "" : artOf(z);
          return `<button class="pz${complete ? " seen" : ""}${hold ? " aim" : ""}${(r.shape || z.shape) === "ellipse" ? " el" : ""}${z.glint === false || (!direct && complete) || (direct && (z.to || z.exit)) ? " ng" : ""}${z.to ? " pz-nav" : ""}${z.exit ? " ex" : ""}${inl ? " wg" : ""}${art ? " ha" : ""}" data-z="${i}" data-zone-id="${esc(zid(z, i))}" data-seen="${sn ? "true" : "false"}" data-exhausted="${complete ? "true" : "false"}" style="${targetStyle(r.box)};z-index:${z.z ?? 2};--gd:${(0.8 + k * 2.1 + (E.hash(zid(z, i) + img) % 30) / 10).toFixed(1)}s" aria-label="${esc(nat(z.label) || zid(z, i))}${complete ? " · " + esc(T("examined", "đã xem")) : ""}">${art ? `<i class="pz-sh"></i><i class="pz-art ii im-${esc(art)}"${z.artRot ? ` style="transform:rotate(${z.artRot}deg)"` : ""}></i>` : ""}${inl ? `<div class="wg">${WG[w.type].html(z, w)}</div>` : ""}<span class="pz-l">${esc(nat(z.label) || "")}</span>${z.exit || (direct && z.to) ? `<em class="pz-x">${spatial && z.to && z.kind !== "detail" && z.kind !== "turn" ? (z.kind === "walk" ? E.ICON.shoe : DOOR_ICON) : E.ICON.right}</em>` : ""}</button>`;
        }).join("") + (detail() && S.inspectionZoom !== false ? [] : people()).map(({ p, i }) => {
          let r = E.regionOf(img, p.r) || { box: [30, 38, 40, 62] }, ch = S.chars[p.who] || {}, face = p.face ? `im-${p.who}-${p.face}` : "";
          // ảnh TOÀN THÂN (đầu tới chân) theo dáng: <mã>-full-<pose> → <mã>-full → ảnh nửa người cũ
          const full = [p.pose && `im-${p.who}-full-${p.pose}`, p.face && `im-${p.who}-full-${p.face}`, `im-${p.who}-full`].find(x => x && E.hasArt(x) && E.artReal?.(x));
          // chưa có ảnh toàn thân → ảnh NỬA NGƯỜI: kéo khung xuống CHẠM ĐÁY ảnh + mờ dần mép dưới → không lộ đường cắt ngang thân giữa cảnh
          if (!full) { const bx = r.box; r = { ...r, box: [bx[0], bx[1], bx[2], 100 - bx[1]] }; }
          const fresh = !R.used["tkh:" + p.who];
          return `<button class="pp${fresh ? " new" : ""}${full ? " full" : " half"}${detail() ? " scenery" : ""}" data-p="${i}" data-who="${esc(p.who)}"${detail() ? ' inert tabindex="-1" aria-hidden="true"' : ` aria-label="${esc(T("Talk to ", "Nói chuyện với ") + E.cname(ch, true))}"`} style="${E.pctStyle(r.box)};z-index:${p.z ?? 3};--c:${ch.color || "#aaa"}"><div class="pp-i${full ? " full" : ""}">${full ? "" : `<div class="ph">${SIL(ch.color || "#aaa")}</div>`}${full ? `<div class="ii ${full}"></div>` : `<div class="ii im-${p.who}"></div>${face && E.hasArt(face) ? `<div class="ii ${face}"></div>` : ""}`}</div>${detail() ? "" : `<span class="pp-n">${E.ICON.talk}<b>${esc(E.known(p.who) ? E.cname(ch, true) : (nat(ch.hint) || "").replace(/[.。]$/, "") || E.cname(ch, true))}</b></span>`}</button>`;
        }).join("") + (v.fg ? `<i class="vfg ii im-${esc(typeof v.fg === "string" ? v.fg : img + "-fg")}" style="z-index:${v.fgZ ?? 5}"></i>` : "");
        for (const { z, i } of shownZones()) { const w = z.widget; if (w && WG[w.type]?.bind && !PS.solved[seenK(z, i)]) { const el = L.querySelector(`[data-z="${i}"] .wg`); if (el) WG[w.type].bind(el, z, w, api(z, i)); } }
        for (const sprite of L.querySelectorAll(".pp.full .pp-i > .ii")) E.fitSprite?.(sprite);
      }
      const nb = side(-1), nb2 = side(1), back = !spatial && parentEdge();
      navEl().innerHTML = detail() ? `<button class="pl-detail-back" data-detail-back>${E.ICON.left}<span>${esc(T("Back", "Lùi"))}</span></button>` : `${nb || nb2 ? `${nb ? `<button class="pl-ar l" data-nav="-1" aria-label="${esc(T("Turn left", "Quay trái"))}">${E.ICON.left}</button>` : ""}${nb2 ? `<button class="pl-ar r" data-nav="1" aria-label="${esc(T("Turn right", "Quay phải"))}">${E.ICON.right}</button>` : ""}` : ""}${back ? `<button class="pl-back" data-up aria-label="${esc(T("Step back", "Lùi lại"))}">${E.ICON.down}</button>` : ""}`;
      hud();
    };
    const hud = () => {
      if (done || !c.live()) return;
      const items = itemCandidates();
      if (hold && !items.includes(hold)) hold = null;
      const pg = P.progress?.(E.state()), tot = pg ? pg[1] : allClues().length, n = pg ? pg[0] : found(), ok = needOk() || P.leave === true, it = hold && S.items[hold];
      const short = typeof P.need === "function" ? (needOk() ? 0 : Math.max(1, tot - n)) : Array.isArray(P.need) ? P.need.filter(id => !Object.keys(PS.seen).some(k => k.endsWith("/" + id))).length : Math.max(0, needN() - found());
      // Custom objective progress and unchecked physical clues are different counts.
      // A completed 2/2 objective must not produce a "0 places left" warning.
      const unchecked = Math.max(0, allClues().length - found());
      const askHtml = ask ? `<div class="pl-ask"><b>${esc(short ? T(`Find ${short} more clue${short > 1 ? "s" : ""} first?`, `Còn thiếu ${short} manh mối.`) : T(`${unchecked} clue-marked spot${unchecked > 1 ? "s" : ""} not checked yet.`, `Còn ${unchecked} điểm có manh mối chưa xem.`))}</b><p>${esc(short ? T("Missing clues can make your deductions wrong. Leave anyway?", "Thiếu manh mối có thể khiến bạn suy luận sai. Vẫn rời đi?") : T("You have what you need to continue. You can look around more, or leave now.", "Bạn đã đủ thông tin để đi tiếp. Có thể xem thêm hoặc rời đi ngay."))}</p><div class="se-row"><button class="se-btn" data-ask-no>${esc(T("Keep looking", "Xem tiếp"))}</button><button class="se-btn pri" data-ask-yes>${esc(T("Leave", "Rời đi"))}</button></div></div>` : "";
      const holdHtml = it ? `<div class="pl-hold"><button class="pl-hia" data-view data-held-item="${esc(hold)}" aria-label="${esc(T("Inspect or drag: ", "Xem hoặc kéo: ") + nat(it.name))}">${E.itemArt(hold, "sm")}</button><span><b>${esc(nat(it.name))}</b><small>${esc(T("Drag to a detail, or tap where to use it", "Kéo tới chi tiết, hoặc chạm chỗ muốn dùng"))}</small></span><button class="se-ib sm" data-unhold aria-label="${esc(T("Put away", "Cất đi"))}">${E.ICON.x}</button></div>` : "";
      const near = detail() ? [] : [...new Set([side(-1), side(1), parentEdge()?.to].filter(Boolean))];
      const routeHtml = mapOpen && assist() && !detail() ? `<div class="pl-routes" aria-label="${esc(T("Nearby places", "Chỗ lân cận"))}">${near.map(to => `<button class="se-btn sm" data-place-to="${esc(to)}">${esc(nat(P.views[to]?.name) || to)}${PS.vis[to] ? " ✓" : ""}</button>`).join("") || `<small>${esc(T("No adjoining view", "Không có góc nhìn kế bên"))}</small>`}</div>` : "";
      const doorways = spatial && !detail() ? routeEntries().map(({ edge, i }) => `<button class="se-btn sm" data-place-route="${i}"${edge.allowed ? "" : " disabled"}>${edge.allowed ? DOOR_ICON : E.ICON.lock}<span>${esc(nat(edge.label) || nat(P.views[edge.to]?.name) || edge.to)}</span></button>`).join("") : "";
      const doorHtml = doorways ? `<div class="pl-doorways" aria-label="${esc(T("Ways through", "Lối đi"))}">${doorways}</div>` : "";
      const targetsHtml = listOpen && assist() && !detail() ? `<div class="pl-targets" aria-label="${esc(T("Visible objects and people", "Đồ vật và người trong cảnh"))}">${zones().map(({z,i}) => `<button class="se-btn sm" data-place-z="${i}">${PS.seen[seenK(z,i)] ? "✓ " : ""}${esc(nat(z.label) || zid(z,i))}</button>`).join("")}${people().map(({p,i}) => `<button class="se-btn sm" data-place-p="${i}">${E.ICON.talk}${esc(E.cname(S.chars[p.who]))}</button>`).join("")}</div>` : "";
      const bag = bagOpen && items.length ? `${contextual ? `<small class="se-context-bag-label">${esc(T("Items in this location", "Đồ trong khu vực này"))}</small>` : ""}<div class="pl-bag">${items.map(id => `<button class="se-bi${hold === id ? " on" : ""}" data-it="${id}" aria-label="${esc(nat(S.items[id]?.name))}">${E.itemArt(id, "sm")}</button>`).join("")}</div>` : "";
      const goalText = detail() ? T("Tap the detail to inspect it again. Use Back to return to the scene.", "Chạm chi tiết để xem lại. Bấm Lùi để trở về cảnh.") : nat(E.ui.explorationObjective?.({place:pid}) || P.goal) || nat(P.name) || "";
      E.ui.setObjective?.({id:"place:" + pid, text:goalText});
      const goalTag = direct && !detail() ? "button" : "div";
      const back = spatial && !detail() && parentEdge();
      const backLabel = back && (nat(back.label) || T("Back to ", "Trở lại ") + nat(P.views[back.to]?.name || back.to));
      const backHtml = back ? `<button class="se-btn sm pl-spatial-back" data-up>${E.ICON.down}<span>${esc(backLabel)}</span></button>` : "";
      const goalHtml = `<${goalTag} class="pl-goal${direct ? " compact" : ""}"${goalTag === "button" ? ` type="button" data-objective aria-expanded="${goalOpen}" aria-label="${esc(T("Objective: ", "Mục tiêu: ") + goalText)}"` : ""}><span>${esc(S.collapsibleObjectives && goalTag === "button" ? T("Objective", "Mục tiêu") : goalText)}</span>${tot && !detail() ? `<b>${n}/${tot}</b>` : ""}${goalTag === "button" ? `<i aria-hidden="true">${E.ICON.down}</i>` : ""}</${goalTag}>`;
      E.ui.panel(`${askHtml || `<div class="pl-location"><span>${esc(nat(detail()?.label) || nat(VIEW().name) || nat(P.name) || "")}</span>${assist() && !detail() ? `<button class="se-btn sm" data-objects aria-expanded="${listOpen}">${esc(T("Objects", "Điểm chạm"))}</button>${!spatial && near.length ? `<button class="se-btn sm" data-scenes aria-expanded="${mapOpen}">${esc(T("Move", "Di chuyển"))}</button>` : ""}` : ""}</div>${routeHtml}${targetsHtml}${direct && goalOpen && !detail() ? `<div class="pl-objective" role="note">${esc(goalText)}</div>` : ""}${msg ? `<div class="pl-msg" role="status">${msg}</div>` : ""}${holdHtml}${bag}${doorHtml}
        <div class="pl-bar">${goalHtml}${backHtml}
          ${!detail() ? `<button class="pl-ib" data-hint aria-label="${esc(T("Hint", "Gợi ý"))}">${E.ICON.hint}</button>` : ""}
          ${spatial && !detail() ? `<button class="pl-ib" data-place-map aria-haspopup="dialog" aria-label="${esc(T("Area map", "Sơ đồ khu vực"))}">${MAP_ICON}</button>` : ""}
          ${items.length ? `<button class="pl-ib${bagOpen ? " on" : ""}${hold ? " hold" : ""}" data-bag aria-label="${esc(T("Bag", "Túi đồ"))}">${E.ICON.box}<i>${items.length}</i></button>` : ""}
          ${detail() || (P.leave === false && !ok) ? "" : `<button class="se-btn pri pl-go${ok ? "" : " dim"}" data-leave>${esc(nat(P.done) || T("Leave", "Rời đi"))}</button>`}</div>`}`, "pl");
      measureNav();
    };
    const api = (z, i) => ({
      live: () => !done && c.live(),
      defer,
      ok: () => { if (done || !c.live()) return; const k = seenK(z, i); if (PS.solved[k]) return; PS.solved[k] = 1; PS.seen[k] = 1; E.ui.fx("solve"); if (z.widget.ok) { leaveUI(); c.again(); run(["views", PS.v, "zones", i, "widget", "ok"]); res(); } else draw(); },
      redraw: repaint => { if (done || !c.live()) return; if (repaint) paintReady("still", { force: true }); else draw(); },
    });
    // Holding an item changes controls and dots only. It must not rebuild
    // people, reframe the background, or move the image-coordinate hit plane.
    const refreshTargets = () => $$(".se-bgl.on .pz[data-z]").forEach(el => el.classList.toggle("aim", !!hold));
    const refreshHold = () => { refreshTargets(); hud(); };
    // dọn giao diện địa điểm trước khi chạy bước con
    const leaveUI = () => { E.cancelDrag?.(); E.ui.setObjective?.(null); const L = $(".se-bgl.on .vbw.zones .vbx"); if (L) L.innerHTML = ""; navEl().innerHTML = ""; E.ui.clear(); };
    const finish = (eligible = true) => { if (done || !c.live()) return; delete PS.detail; leaveUI(); inspectLook(null, 400); R.vw = null; E.exploreReview?.leave(c, { place: { pid, v: PS.v } }, eligible); res(); };
    const rectOf = el => { const b = el?.getBoundingClientRect?.(); return b ? { x: b.left, y: b.top, w: b.width, h: b.height } : null; };
    const late = () => { if (PS.by != null && !PS.lateDone && E.time.now() >= PS.by && P.late) { PS.lateDone = 1; finish(false); run(["late"]); return true; } return false; };
    const spend = min => { if (min) E.time.add(min, PS.by); };

    const paintReady = (tr, o) => {
      viewBusy = true; const token = ++paintN; paint(tr, o);
      Promise.resolve(E.ui.layerReady?.()).then(() => {
        if (done || !c.live() || token !== paintN) return;
        viewBusy = false;
        const v = VIEW(), img = imgOf(v);
        E.ui.frame(img, [...(v.zones || []).map(z => E.regionOf(img, z.r)?.box), ...(v.people || []).map(p => E.regionOf(img, p.r)?.box)], {top:64,bottom:150});
        if (detail()) inspectLook(detail().box, 0, true);
        E.syncImagePlanes?.();
        draw();
      });
    };
    const goView = (to, tr, o) => { if (done || !c.live() || !P.views[to] || viewBusy) return; E.cancelDrag?.(); delete PS.detail; inspectLook(null, 0, true); const oldZones = $(".se-bgl.on .vbw.zones .vbx"); if (oldZones) oldZones.innerHTML = ""; E.ui.hide("*"); PS.v = to; mapOpen = listOpen = false; hold = null; bagOpen = false; msg = ""; ask = false; paintReady(tr, o); E.sfx(tr === "zin" || tr === "zout" ? "whoosh" : "steps"); E.haptic("LIGHT"); E.save(); };
    const enterDetail = (z, i) => {
      if (!direct || z.to || z.exit || z.look === false || z.inspect === false || S.inspectionZoom === false && z.inspect !== true || detail()) return;
      const r = E.regionOf(imgOf(VIEW()), z.inspectR || z.r); if (!r) return;
      PS.detail = { v: PS.v, id: zid(z, i), box: [...r.box], label: z.label };
