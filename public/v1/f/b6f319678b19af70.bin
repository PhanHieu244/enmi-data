        find_ta: { en: "Cross to Kellholm before the causeway closes. Find whoever signed 'T.A.'", vi: "Qua đảo Kellholm trước khi đường ngầm đóng. Tìm người ký “T.A.”" },
        wait_tom: { en: "Tom Ashby comes to The Lantern every night. Walk the island until he does.", vi: "Tối nào Tom Ashby cũng tới The Lantern. Đi một vòng đảo trong lúc chờ ông." },
        cottage: { en: "Tom's cottage, ten o'clock. Don't be late.", vi: "Nhà Tom, mười giờ tối. Đừng tới muộn." },
        c3_statement: { en: "Give Leo a complete account", vi: "Kể đầy đủ sự việc cho Leo" },
        c4_call: { en: "Find out why Tom left home", vi: "Tìm hiểu vì sao Tom rời nhà" },
        c4_callum: { en: "Ask Callum about the missing minutes", vi: "Hỏi Callum về quãng thời gian còn thiếu" },
        c5_account: { en: "Hear what happened in 2004", vi: "Nghe chuyện đã xảy ra năm 2004" },
        c5_map: { en: "Follow Tom's map", vi: "Lần theo bản đồ của Tom" },
        c5_return: { en: "Return to The Lantern", vi: "Trở lại The Lantern" },
        c6_lantern: { en: "Return to The Lantern. Separate what you know from what you suspect.", vi: "Trở lại The Lantern. Phân biệt điều đã biết với điều còn nghi ngờ." },
        c6_phone: { en: "Inspect the cellar phone. Check the time, direction and destination of the call.", vi: "Kiểm tra máy điện thoại dưới hầm. Đối chiếu giờ, chiều và số nhận cuộc gọi." },
        c6_nell: { en: "Find out where Nell went.", vi: "Tìm xem Nell đã đi đâu." },
        c6_reach: { en: "Reach the refuge box with someone who can help.", vi: "Tới chòi trú nạn cùng một người có thể giúp bạn." },
        c6_case: { en: "Question Nell. Present only evidence you can support.", vi: "Hỏi Nell. Chỉ đưa ra những chứng cứ có căn cứ." },
        c6_truth: { en: "Decide what to put on record. Your choice will stay with you.", vi: "Quyết định điều sẽ được ghi lại. Lựa chọn này sẽ ở lại với bạn." },
        c6_morning: { en: "Finish your statement and prepare to leave.", vi: "Hoàn tất lời khai và chuẩn bị rời đảo." },
      })[s.f.goal] || { en: "Find out what happened to your mother.", vi: "Tìm ra chuyện gì đã xảy ra với mẹ." } },
      { label: { en: "The causeway", vi: "Đường ngầm" }, value: s => s.truth("T7")
        ? { en: "Printed: 20:50–03:05 closed. Tom's readings suggest the road clears near 02:25 tonight; check the water.", vi: "Bảng in: đóng 20:50–03:05. Số đo của Tom cho thấy đêm nay đường có thể cạn gần 02:25; phải xem nước thực tế." }
        : { en: "Printed crossing times: closed 20:50–03:05. Check the actual water before crossing.", vi: "Giờ trên bảng in: đóng 20:50–03:05. Phải xem mực nước thực tế trước khi qua." } },
