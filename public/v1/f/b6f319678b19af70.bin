    // are evaluated: old saves receive the deterministic possible-source map.
    for (const node of Object.keys(S.nodes || {})) { const scope = mappedLocation(node); if (scope) entries.set(node, new Set([scope])); }
    for (const [id, spec] of Object.entries(S.places || {})) place(id, new Set(), ["@places", id]);
    for (let pass = 0; pass < Math.min(64, Object.keys(S.nodes || {}).length + 1); pass++) { changed = false; for (const [node, steps] of Object.entries(S.nodes || {})) sequence(steps, entries.get(node) || new Set(), [node]); if (!changed) break; }
    // Explicit source declarations resolve stories whose dynamic functions
    // choose a source which a static traversal cannot identify.
    for (const [id, locations] of Object.entries(S.itemSources || {})) { for (const set of sources.values()) set.delete(id); for (const location of asList(locations)) add(sources, E.locationOf(location), id); }
    for (const [scope, config] of Object.entries(S.locations || {})) { for (const id of asList(config.items)) add(sources, scope, id); for (const id of asList(config.uses)) add(uses, scope, id); }
    inventoryIndex = {sources, uses};
    inventoryStamp = Object.keys(S.nodes || {}).length + ":" + Object.keys(S.places || {}).length + ":" + JSON.stringify(S.locations || {}) + ":" + JSON.stringify(S.itemSources || {});
    return {sources:Object.fromEntries([...sources].map(([k,v])=>[k,[...v]])),uses:Object.fromEntries([...uses].map(([k,v])=>[k,[...v]]))};
  };
  function indexForInventory() { const stamp = Object.keys(S.nodes || {}).length + ":" + Object.keys(S.places || {}).length + ":" + JSON.stringify(S.locations || {}) + ":" + JSON.stringify(S.itemSources || {}); if (!inventoryIndex || inventoryStamp !== stamp) E.rebuildInventoryScopes(); return inventoryIndex; }
  E.noteItemOrigin = (id, scope = E.currentLocation()) => { if (!R || !S.items?.[id] || !scope) return; const origins = ((R.itemOrigins ||= {})[id] ||= []), location = E.locationOf(scope); if (!origins.includes(location)) origins.push(location); };
  const knownInventory = new WeakMap();
  E.syncItemOrigins = () => { if (!R || !Array.isArray(R.items)) return; const before = knownInventory.get(R); if (before) for (const id of R.items) if (!before.has(id)) E.noteItemOrigin(id); knownInventory.set(R, new Set(R.items)); };
  E.contextItems = (scope = E.currentLocation()) => {
    scope = E.locationOf(scope); const index = indexForInventory(), local = index.sources.get(scope) || new Set(), usable = new Set(index.uses.get(scope) || []);
    // Needed ingredients remain candidates even before their partner is found.
    for (let pass = 0; pass < (S.combos || []).length + 1; pass++) for (const [i, combo] of (S.combos || []).entries()) if (!R.used?.["cmb:" + i] && combo.make && usable.has(combo.make)) { usable.add(combo.a); usable.add(combo.b); }
    return R.items.filter(id => S.items?.[id] && (usable.has(id) || (R.itemOrigins?.[id]?.length ? R.itemOrigins[id].some(origin => E.locationOf(origin) === scope) : local.has(id))));
  };
  // A combine picker shares the location's plausible candidates. An older
  // selected item also brings its source location's records, so opening it in
  // the casebook does not reduce the choices to its correct partner alone.
  E.combineCandidates = (id, scope = E.currentLocation(), contextual = S.contextInventory) => {
    if (!R.items.includes(id) || !S.items?.[id]) return [];
    const owned = R.items.filter(other => other !== id && S.items?.[other]);
    if (!contextual) return owned;
    const locations = new Set([E.locationOf(scope)]), origins = R.itemOrigins?.[id];
    if (origins?.length) for (const origin of origins) locations.add(E.locationOf(origin));
    else for (const [origin, ids] of indexForInventory().sources) if (ids.has(id)) locations.add(origin);
    const candidates = new Set([...locations].flatMap(location => E.contextItems(location)));
    // Combinations work outside exploration too. Retain an owned unused
    // partner even when the current location has no use for the result yet.
    for (const [i, combo] of (S.combos || []).entries()) if (!R.used?.["cmb:" + i]) {
      const partner = combo.a === id ? combo.b : combo.b === id ? combo.a : null;
      if (owned.includes(partner)) candidates.add(partner);
    }
    return owned.filter(other => candidates.has(other));
  };
  E.on("item", id => E.noteItemOrigin(id));
  E.on("step", (type, st) => {
    E.syncItemOrigins();
    if (typeof st.bg === "string" || typeof st.scene === "string") E.enterLocation(st.bg || st.scene);
    if (type === "place") { const p = typeof st.place === "string" ? S.places?.[st.place] : st.place, f = R.stack?.at(-1); if (p) E.enterLocation(p.location || p.id || (typeof st.place === "string" ? st.place : [f?.n,...(f?.p||[]),(f?.i||1)-1].join('.'))); }
    if (type === "explore") E.enterLocation(st.explore.location || R.location || R.scene);
    if (type === "talk") { const k = typeof st.talk === "string" ? S.talks?.[st.talk] : st.talk; if (k?.location) E.enterLocation(k.location); }
  });
  E.on("chapter", () => { inventoryIndex = null; });
  const saveWithOrigins = E.save;
  E.save = (...args) => { E.syncItemOrigins(); return saveWithOrigins(...args); };
  // số cặp đồ đang ghép được (để nhắc “có thể ghép”, không nói cặp nào)
  E.canCombine = () => (S.combos || []).filter((k, i) => !R.used?.["cmb:" + i] && R.items.includes(k.a) && R.items.includes(k.b)).length;
  // GHÉP 2 món ở BẤT CỨ LÚC NÀO (Sổ tay → Đồ vật, không chỉ trong màn khám phá): ra đồ mới (make) ngay; cảnh đi kèm (then)
  //   chạy ngay sau bước đang diễn ra. → { ok, make } | { ok: false }
  E.combine = (a, b) => {
    if (a === b || !R.items.includes(a) || !R.items.includes(b) || !S.items?.[a] || !S.items?.[b]) return { ok: false };
    const ci = (S.combos || []).findIndex(k => (k.a === a && k.b === b) || (k.b === a && k.a === b));
    if (ci < 0 || R.used?.["cmb:" + ci]) return { ok: false, done: ci >= 0 };
    const k = S.combos[ci];
    (R.used ||= {})["cmb:" + ci] = 1;
    if (k.make) { R.items = R.items.filter(x => x !== k.a && x !== k.b); R.items.push(k.make); E.noteItemOrigin(k.make); }
    if (k.then) { S.nodes.__combo = (S.combos || []).map(x => x.then || []); R.stack.push({ n: "__combo", p: [ci], i: 0 }); }
    E.sfx("item"); E.save();
    return { ok: true, make: k.make, then: !!k.then };
  };
  E.ui_recapHtml = (list) => {
    let ch = -1, out = "";
    for (const x of list) {
      if ((x.ch ?? 0) !== ch) { ch = x.ch ?? 0; out += `<div class="se-rch">${ch ? esc(E.nat({ en: "Chapter " + ch, vi: "Chương " + ch })) : esc(E.nat({ en: "Prologue", vi: "Mở đầu" }))}</div>`; }
      out += `<p class="se-rcp">${esc(E.nat(x.t))}</p>`;
    }
    return out;
  };
  E.hasRun = () => {
    const saved = store.get(KEY + ".r", null);
    // Ending metadata may belong to a chapter that has not been loaded yet.
    // Validate the ID after resume loads that chapter, without erasing it.
    return !!saved?.stack?.length || (typeof saved?.done === "string" && !!saved.done);
  };

  // ───────── giọng đọc (tạm: speechSynthesis; sau: file âm thanh soạn sẵn ở st.audio / char.voice) ─────────
  const F_RE = /female|zira|susan|hazel|samantha|karen|moira|tessa|libby|sonia|aria|jenny|emma|amy|serena|victoria|fiona|kate|ava|allison|hoaimy|\blinh\b|\bmai\b|\ban\b/i;
  const M_RE = /\bmale|david|mark|george|daniel|james|ryan|guy|alex|fred|tom\b|oliver|arthur|thomas|brian|christopher|eric|namminh|nam\b/i;
  let VOICES = [];
  const loadVoices = () => { try { VOICES = speechSynthesis.getVoices(); } catch {} };
  try { loadVoices(); speechSynthesis.onvoiceschanged = loadVoices; } catch {}
  const hash = s => { let x = 7; for (const c of String(s)) x = (x * 31 + c.charCodeAt(0)) >>> 0; return x; };
  E.hash = hash;
  const deviceCast = new Map();
  const deviceVoiceId = v => [v.voiceURI || "", v.lang || "", v.name || ""].join("|");
  function voicePool(lang, g) {
    const base = String(lang || "en").toLowerCase().split("-")[0];
    const all = VOICES.filter(v => v.lang?.toLowerCase().split("-")[0] === base);
    if (!all.length) return null;
    const re = g === "F" ? F_RE : M_RE, other = g === "F" ? M_RE : F_RE;
    const pool = all.filter(v => re.test(v.name)).length ? all.filter(v => re.test(v.name)) : all.filter(v => !other.test(v.name)).length ? all.filter(v => !other.test(v.name)) : all;
    return pool.sort((a, b) => deviceVoiceId(a).localeCompare(deviceVoiceId(b)));
  }
  function assignDeviceVoice(lang, g, seed) {
    const base = String(lang || "en").toLowerCase().split("-")[0], pool = voicePool(base, g);
    if (!pool?.length) return null;
    const key = base + "|" + (g || "M") + "|" + seed;
    const held = pool.find(v => deviceVoiceId(v) === deviceCast.get(key));
    if (held) return held;
    // Use the available voices before sharing one. A hash alone can collide
    // even when the device has enough distinct voices for the current cast.
    const counts = new Map();
    for (const [k, id] of deviceCast) if (k.startsWith(base + "|") && k !== key) counts.set(id, (counts.get(id) || 0) + 1);
    const min = Math.min(...pool.map(v => counts.get(deviceVoiceId(v)) || 0));
    const free = pool.filter(v => (counts.get(deviceVoiceId(v)) || 0) === min);
    const gb = free.filter(v => /GB|UK|British/i.test(v.lang + v.name));
    const candidates = base === "en" && gb.length ? gb : free;
    const picked = candidates[hash(seed) % candidates.length];
    deviceCast.set(key, deviceVoiceId(picked));
    return picked;
  }
  function pickVoice(lang, g, seed) {
    // Reserve recurring leads first so scene order does not change their voice.
    assignDeviceVoice(lang, G?.set?.g || "M", "me");
    assignDeviceVoice(lang, "M", "narr");
    if (S?.chars?.reed) assignDeviceVoice(lang, S.chars.reed.g || "F", "reed");
    return assignDeviceVoice(lang, g, seed);
  }
  E.voice = { busy: false, source: null, speaker: "", language: "", name: "", key: null };
  E.voice.status = () => ({ busy: E.voice.busy, source: E.voice.source, speaker: E.voice.speaker, language: E.voice.language, name: E.voice.name, key: E.voice.key });
  const voiceSource = data => { Object.assign(E.voice, { name: "", key: null }, data, { busy: true }); E.duck?.(true); E.emit("voice-source", E.voice.status()); };
  // Trong app: câu thứ tiếng đang học đọc bằng GIỌNG CHUNG của app (Enmi.say — theo Cài đặt → Âm thanh: tự chọn / giọng AI / Giọng nam ·
  //   Giọng nữ riêng, như truyện nhập vai); nhân vật thứ 2 cùng giới = giọng thứ 2. Câu tiếng khác (lời dẫn tiếng mẹ đẻ…) hoặc app từ chối
  //   → giọng máy trong khung như cũ.
  const nthOf = who => { if (who === "me") return 1; const g = S.chars[who]?.g || "M"; const same = Object.keys(S.chars).filter(k => !S.chars[k].hideInBook && (S.chars[k].g || "M") === g); return same.indexOf(who) > 0 ? 2 : 1; };
  // GIỌNG ĐỌC SẴN (tools/games/_lib/story/voice.js → audio/*.mp3): art-css.js khai mỗi câu 1 lớp .au-<khoá>{background-image:url(audio/…)}
  //   (host Game SDK chỉ đổi đường dẫn trong HTML / CSS) → đọc url đã đổi qua getComputedStyle rồi phát. Khoá = băm(người nói | câu) như voice.js;
  //   lời "bạn" có 2 bản (me.F / me.M) theo giới tính người chơi. Chỉ thứ tiếng của bản ghi (S.voiceLang, mặc định en); tắt: Cài đặt → Giọng đọc sẵn.
  const recClean = t => String(t || "").replace(/\[\[|\]\]/g, "").replace(/\s+/g, " ").trim();
  E.recKey = (who, text) => hash(who + "|" + recClean(text)).toString(36);
  let probe = null, recAud = null, recHas = null;
  const recUrl = cls => {
    if (!probe) { probe = document.createElement("i"); probe.style.cssText = "position:absolute;width:0;height:0;overflow:hidden;pointer-events:none"; probe.hidden = true; document.body.append(probe); }
    probe.className = cls;
    const m = /url\(["']?(.*?)["']?\)/.exec(getComputedStyle(probe).backgroundImage || "");
    return m ? m[1] : null;
  };
  E.recHas = () => recHas ||= !!recUrl("au-has");
  const recPlay = (url, opts, done, generation) => {
    try { recAud?.pause(); } catch {}
    const a = recAud = new Audio(url);
    a.playbackRate = (opts.slow ? 0.75 : 1) * (G.set.vRate || 1);
    a.volume = opts.whisper ? 0.7 : 1;
    let fin = false; const end = ok => { if (fin) return; fin = true; if (generation === sayN) E.duck?.(false); done(ok); };
    E.duck?.(true);
